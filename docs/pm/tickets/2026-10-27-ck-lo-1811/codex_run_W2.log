+def stack(title, at, groups, calls, source=H):
+    return {"type": "stack", "at": at, "title": title, "range": source,
+            "unit": "TRIỆU", "keys": [{"k": "THẢO"}, {"k": "NAM"}, {"k": "QUỸ CHUNG"}],
+            "groups": groups, "calls": calls}
+
+def b6(at, months, calls):
+    groups = []
+    for m in months:
+        x = R["monthly_chart"][m - 1]
+        groups += [
+            {"k": f"50/50 T{m}", "vals": [x["equal"]["thao"], x["equal"]["nam"], 0], "at": at},
+            {"k": f"TỶ LỆ T{m}", "vals": [x["proportional"]["thao"], x["proportional"]["nam"], 0], "at": at},
+            {"k": f"QUỸ T{m}", "vals": [x["pool"]["thao"], x["pool"]["nam"], x["pool"]["common"]], "at": at},
+        ]
+    return stack("BA CÁCH CHIA · TÍCH LŨY", at, groups, calls)
+
+def photo(key, at, move):
+    s = {"type": "photo", "img": key, "at": at, "credit": False, "illus": "ẢNH MINH HỌA", "focus": [0.5, 0.18]}
+    s.update(move)
+    return s
+
+def bars(at, title, items, srcnote=H):
+    return {"type": "bars", "at": at, "title": title, "unit": "TRIỆU", "items": items, "srcnote": srcnote}
+
