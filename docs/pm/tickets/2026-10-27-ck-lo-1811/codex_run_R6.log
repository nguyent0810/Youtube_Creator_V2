import csv,datetime as dt
rows=[]
for fn in ['data/ck/vnindex_1d_2016_2018.csv','data/ck/vnindex_1d.csv']:
 with open(fn,encoding='utf-8-sig') as f:
  rows += [{**r,'date':dt.date.fromisoformat(r['time']),'close':float(r['close'])} for r in csv.DictReader(f)]
rows.sort(key=lambda x:x['date'])
# exact requested dates/min local monthly
for d in ['2018-04-09','2020-03-24','2022-01-06','2022-11-15','2025-04-09','2026-10-06']:
 r=next(x for x in rows if x['time']==d);print(d,r['close'])
# strategy B every daily portfolio, B buy 2018-4-9
initial=100_000_000; buy=next(x for x in rows if x['time']=='2018-04-09'); shares=initial/buy['close']
period=[r for r in rows if r['date']>=buy['date']]
vals=[(r['date'],shares*r['close']) for r in period]
minv=min(vals,key=lambda x:x[1]); print('lump end,min',vals[-1], minv, (minv[1]/initial-1)*100)
print('lump recovery',next((d for d,v in vals if v>=initial),None), sum(v<initial for d,v in vals)/21) # trading to months wrong
# DCA first available per month 2018-4 thru 2020-3 total funds; track first trade date month
purchases=[]
for y,m in [(y,m) for y in range(2018,2021) for m in range(1,13) if (y>2018 or m>=4) and (y<2020 or m<=3)]:
 r=next(r for r in rows if r['date'].year==y and r['date'].month==m)
 purchases.append(r)
shares2=sum((initial/24)/r['close'] for r in purchases)
vals2=[]
for r in [x for x in rows if x['date']>=purchases[0]['date']]:
 paid=sum(initial/24 for q in purchases if q['date']<=r['date'])
 vals2.append((r['date'],shares2*r['close'],paid))
# after full 100m comparable under 100 only after 2020-3
full=[x for x in vals2 if x[0]>=purchases[-1]['date']]
min2=min(full,key=lambda x:x[1]);print('dca first last',purchases[0]['date'],purchases[-1]['date']);print('dca end,min',full[-1],min2,(min2[1]/initial-1)*100);print('dca recovery',next((d for d,v,p in full if v>=initial),None))
# calendar distinct months under after fully funded
print('monthsunder lump',len(set((d.year,d.month) for d,v in vals if v<initial)));print('monthsunder dca full',len(set((d.year,d.month) for d,v,p in full if v<initial)))
# relevant annual close first/last
for y in range(2018,2027):
 yr=[x for x in rows if x['date'].year==y]
 print(y,yr[0]['close'],yr[-1]['close'])
