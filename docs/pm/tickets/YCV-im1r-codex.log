   {"type": "cards3d", "at": 1, "title": "VALL-E", "cards": [{"k": "MẪU GIỌNG", "v": "3 GIÂY", "at": [1, "VALL-E"]}, {"k": "TRẠNG THÁI", "v": "CHƯA MỞ CÔNG CHÚNG", "at": [1, "chưa"], "c": "acc"}]},
