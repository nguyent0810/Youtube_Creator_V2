+  {"type": "slam", "at": 2, "text": "0,70 KHÔNG PHẢI 70%", "sub": "KHÔNG PHẢI PHẦN TRĂM CÔNG VIỆC", "clip": "pexels:38410501", "veil": 0.64},
+  {"type": "board", "at": 3, "title": "CÁCH ILO TÍNH ĐIỂM", "nodes": [{"text": "từng việc nhỏ", "x": 0.28, "y": 0.5, "at": [3, "Mỗi"], "shape": "circle", "w": 440}, {"text": "chấm khả năng máy làm", "x": 0.55, "y": 0.5, "at": [3, "máy"], "c": "acc", "shape": "circle", "w": 520}, {"text": "lấy trung bình", "x": 0.8, "y": 0.5, "at": [3, "trung"], "shape": "circle", "w": 430}], "arrows": [{"from": 0, "to": 1, "at": [3, "chấm"]}, {"from": 1, "to": 2, "at": [3, "rồi"]}]},
   {"type": "counter", "at": 4, "to": 13, "suffix": " NGHỀ", "label": "MỨC TIẾP XÚC CAO NHẤT", "until": [4, "mười"], "sub": {"text": "PHẦN LỚN LÀ VIỆC VĂN PHÒNG", "at": [4, "văn"]}},
   {"type": "board", "at": 5, "title": "ILO: KẾT QUẢ DỄ XẢY RA HƠN", "nodes": [{"text": "công việc thay đổi", "x": 0.5, "y": 0.32, "at": [5, "công"], "c": "acc", "shape": "circle", "w": 600}, {"text": "không phải bị thay hàng loạt", "x": 0.5, "y": 0.68, "at": [5, "hàng"], "shape": "none", "w": 780}]},
   {"type": "kinetic", "at": 6, "items": [{"text": "ĐỨNG ĐẦU BẢNG", "at": 6}, {"text": "KHÔNG CÓ NGHĨA LÀ MẤT VIỆC", "at": [6, "mất"], "acc": true}], "clip": "pexels:16863222", "veil": 0.6}
