+  {"type": "counter", "at": 2, "to": 15, "suffix": " GIÂY", "label": "MẪU GIỌNG · MÔ HÌNH 2024", "until": [2, "mười"], "sub": {"text": "CHƯA PHÁT HÀNH RỘNG RÃI", "at": [2, "phát"]}},
   {"type": "kinetic", "at": 3, "items": [{"text": "GIỌNG QUEN", "at": 3}, {"text": "CHƯA CHẮC LÀ BẰNG CHỨNG", "at": [3, "bằng"], "acc": true}], "clip": "pexels:34337855", "veil": 0.62},
   {"type": "board", "at": 4, "title": "FBI KHUYÊN", "nodes": [{"text": "hạn chế công khai giọng", "x": 0.5, "y": 0.3, "at": [4, "FBI"], "shape": "none", "w": 780}, {"text": "để tài khoản riêng tư", "x": 0.5, "y": 0.66, "at": [4, "FBI"], "c": "acc", "shape": "circle", "w": 660}]},
