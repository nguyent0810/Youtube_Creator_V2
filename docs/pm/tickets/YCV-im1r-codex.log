+  {"type": "board", "at": 5, "title": "KHI CÓ CUỘC GỌI GẤP", "nodes": [{"text": "cúp máy", "x": 0.26, "y": 0.5, "at": [5, "cúp"], "shape": "circle", "w": 360}, {"text": "gọi lại", "x": 0.5, "y": 0.5, "at": [5, "gọi"], "c": "acc", "shape": "circle", "w": 360}, {"text": "số đã lưu", "x": 0.74, "y": 0.5, "at": [5, "lưu"], "shape": "circle", "w": 360}], "arrows": [{"from": 0, "to": 1, "at": [5, "tự"]}, {"from": 1, "to": 2, "at": [5, "đã"]}]},
