  "tags": ["nghề nhập liệu", "ilo", "ai và việc làm", "tự động hoá", "trí tuệ nhân tạo", "mind in the machine"],
  "kicker": "AI VÀ VIỆC LÀM",
  "sub": "ILO · 2025",
