+ "acc": ["đứng đầu", "không phẩy bảy", "đổi"],
  "lines": [
-  "Bạn làm nhập liệu: bảng 427 nghề của Tổ chức Lao động Quốc tế năm 2025 xếp nghề của bạn đứng đầu.",
+  "Nếu bạn làm nhập liệu, bảng 427 nghề của ILO năm 2025 xếp nghề của bạn đứng đầu.",
   "Đứng đầu về mức tiếp xúc với AI tạo sinh: điểm không phẩy bảy, thang từ không tới một.",
   "Điểm này không có nghĩa là AI làm được bảy mươi phần trăm việc của bạn.",
   "Mỗi việc nhỏ trong nghề được chấm xem máy làm được tới đâu, rồi lấy trung bình.",
   "Chỉ mười ba nghề ở mức cao nhất, phần lớn là việc văn phòng: đánh máy, kế toán sổ sách, tính lương.",
   "Theo ILO, kết quả dễ xảy ra hơn là công việc thay đổi, chứ không phải bị thay hàng loạt.",
-  "Đứng đầu bảng không có nghĩa là mất việc. Nó cho biết phần việc nào sẽ đổi trước."
+  "Đứng đầu bảng không báo trước một cuộc mất việc. Nó báo trước phần việc có thể đổi trước."
  ],
  "scenes": [
   {"type": "kinetic", "items": [{"text": "NHẬP LIỆU ĐỨNG ĐẦU", "at": 0, "acc": true}, {"text": "BẢNG 427 NGHỀ · ILO 2025", "at": [0, "2025"], "sm": true}], "clip": "pexels:34336609", "veil": 0.58},
