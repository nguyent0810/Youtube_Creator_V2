+"""Sinh spec và cảnh cho MIM Turing/Bombe; chỉ dùng ảnh PD đã kiểm giấy phép."""
+import json
+from pathlib import Path
+
+D = Path(__file__).resolve().parent
+CHAPTERS = [f"ch{i:02d}" for i in range(8)]
+
+SPEC = {
+ "title": "NGƯỜI GIẢI MÃ Ngoài Đời Thật: Alan Turing Và Bombe",
+ "channel": "MIM", "theme": "lab", "accent": "#f59e0b", "master": True, "endcard": 20, "autoTr": True, "beat2": True,
+ "say": {"alan": "A-lần", "turing": "Tu-rinh", "bletchley": "Blet-chờ-li", "bombe": "bom", "enigma": "ê-ních-ma", "gordon": "Go-đần", "welchman": "Ueo-chờ-man", "harold": "Ha-rồ", "keen": "Kin", "wrns": "rên", "pyry": "Pi-ri", "marian": "Ma-ri-an", "rejewski": "Rây-ép-xki"},
+ "imgs": {"turing16": "File:Alan Turing Aged 16.jpg"}, "chapters": CHAPTERS,
+ "youtube": {"titles": ["NGƯỜI GIẢI MÃ Ngoài Đời Thật: Alan Turing Và Bombe", "NGƯỜI GIẢI MÃ Ngoài Đời Thật: Alan Turing Năm 1940", "NGƯỜI GIẢI MÃ Ngoài Đời Thật: Cỗ Máy Bombe Của Turing"],
+ "summary": "Năm 1940, cỗ máy Bombe đầu tiên bắt đầu hoạt động tại Bletchley Park. Video theo sáu mắt xích làm nên nó: ý tưởng từ Ba Lan, thiết kế của Alan Turing và Gordon Welchman, kỹ thuật chế tạo, manh mối của người giải mã và đội vận hành.",
+ "more": ["Phim The Imitation Game chỉ được nhắc bằng lời và chữ. Video không dùng hình phim. Các chi tiết lịch sử được ghi trong nguồn nội bộ."],
+ "chapter_titles": {f"ch{i:02d}": t for i,t in enumerate(["Căn phòng nghe tiếng rơ-le","Mỗi sáng, khóa lại đổi","Món quà từ rừng Pyry","Bản vẽ không chỉ có một tên","Harold Keen biến bản vẽ thành máy","Người cho máy một điểm bắt đầu","Những người ngồi cạnh dãy máy","Chiếc khóa được lắp đủ"])},
+ "sources": ["https://www.gchq.gov.uk/information/the-pyry-forest-meeting", "https://bletchleypark.org.uk/wp-content/uploads/record_attachments/1839.pdf", "https://turingarchive.kings.cam.ac.uk/about-alan-turing"],
+ "hashtags": ["AlanTuring", "Enigma", "Bombe", "CôngNghệQuanhTa"], "tags": ["alan turing", "bombe", "enigma", "bletchley park", "mật mã", "lịch sử công nghệ"], "category": "28", "thumb": "t1.jpg", "playlist": "Công Nghệ Quanh Ta", "publish_at": "2026-11-23T13:00:00Z", "video_credits": ["Chân dung Alan Turing tuổi 16: Public Domain Mark 1.0, Wikimedia Commons."]},
+ "sources_internal": "Nguồn đã mở và đối chiếu: factcheck.md. Ảnh chân dung: Commons LicenseShortName Public domain / PDM 1.0, kiểm ngày 26/10/2026. Không dùng ảnh Bombe/Enigma do phần lớn tệp ứng viên mang CC BY-SA."
+}
+
+def main():
+ (D / "spec.json").write_text(json.dumps(SPEC, ensure_ascii=False, indent=1), encoding="utf-8")
+ for n in CHAPTERS:
