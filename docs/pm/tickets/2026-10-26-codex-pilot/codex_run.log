| CH03 | 28 | 349 | 1,7 | 1,9 |
| CH04 | 27 | 424 | 2,0 | 2,2 |
| CH05 | 30 | 432 | 2,1 | 2,3 |
| CH06 | 33 | 513 | 2,4 | 2,7 |
| CH07 | 31 | 379 | 1,8 | 2,1 |
| CH08 | 31 | 419 | 2,0 | 2,3 |
| CH09 | 34 | 504 | 2,4 | 2,6 |
| CH10 | 27 | 413 | 2,0 | 2,2 |
