def ledger(n,at): return {"type":"ledger","at":at,"title":LEDGER,"srcnote":"MỖI CHƯƠNG THÊM MỘT ĐƯỜNG","rows":[{"k":k,"v":v,"at":at} for k,v in ROWS[:n]]}
