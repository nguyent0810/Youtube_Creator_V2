+GEO={"boston":{"countries":["United States of America"],"context":["Canada","Mexico"],"bbox":[-71.22,42.25,-70.95,42.47],"pins":[{"name":"Cambridge, Massachusetts","lon":-71.1167,"lat":42.3770,"label":"HARVARD"}]}}
