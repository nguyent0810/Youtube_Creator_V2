    if kin: out["kin"]=[{"text":kin,"at":at,"acc":True}]
    return out
def broll(vid, at, text): return {"type":"broll","at":at,"vid":vid,"veil":.62,"illus":VM,"kin":[{"text":text,"at":at,"acc":True}]}
