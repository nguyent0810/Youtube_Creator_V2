+ timeline(a(1,"10000"),"yard",[("03.2004","10.000 ĐĂNG KÝ"),("05.2004","GẦN 100.000 NGƯỜI")]),
+ kinetic(a(2,"mạng"),"NGƯỜI BẠN MUỐN TÌM","CŨNG PHẢI Ở TRONG MẠNG"),
+ slam(a(3,"coursematch"),"COURSEMATCH","XEM BẠN BÈ HỌC LỚP NÀO"),
