+ print_scene("hall",a(1,"house"),"DANH BẠ HOUSE","ẢNH VÀ SỐ ĐIỆN THOẠI","GIỚI HẠN TRUY CẬP"),
+ kinetic(a(2,"ngăn"),"CÁC NGĂN RIÊNG","THÔNG TIN ĐÃ TỒN TẠI"),
