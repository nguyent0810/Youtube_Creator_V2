+ {"type":"map","at":a(3,"kirkland"),"geo":"boston","tag":"VỊ TRÍ GẦN ĐÚNG","pins":[{"name":"Harvard","at":a(3,"kirkland")}]},
+ photo("mark",a(4,"harvard"),"CỔNG VÀO","BAN ĐẦU CHỈ HARVARD"),
