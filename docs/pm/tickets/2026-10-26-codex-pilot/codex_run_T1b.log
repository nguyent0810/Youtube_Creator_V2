": "color", "illus": "ẢNH: VOA · 2018 · CÔNG CỘNG", "side": {"k": "SUSAN BENNETT", "h": "Chưa có\nchiếc điện thoại đó", "lines": [{"text": "Con trai: *Cameron* · theo CNN", "at": 30.48}]}, "t0": 27.24, "t1": 35.56}, {"type": "kinetic", "items": [{"text": "GIỌNG MẸ CẤT LÊN", "at": 36.26, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "104px", "left": "140px"}}, "em": "GIỌNG"}, {"text": "từ phần chỉ đường", "at": 38.15, "sm": true, "fx": "blur", "L": {"cls": "kC", "style": {"top": "407px", "fontSize": "58px", "left": "310px"}}}], "t0": 35.56, "t1": 40.2, "lay": "ladder"}, {"type": "slam", "text": "“MẸ, THÔI ĐI!”", "sub": "CAMERON BENNETT · THEO CNN", "t0": 40.2, "t1": 43.04, "at": 40.35, "fx": "outline"}, {"type": "kinetic", "items": [{"text": "LẦN ĐẦU NÓI CHUYỆN VỚI CHÍNH MÌNH", "at": 43.74, "acc": true, "fx": "flicker", "em": "CHUYỆN"}, {"text": "hơi hoảng · theo CNN", "at": 46.45, "sm": true, "fx": "rise"}], "t0": 43.04, "t1": 49.44, "lay": "stack"}, {"type": "quote", "dy": true, "text": "Choáng ngợp vì được góp phần vào một kỳ công công nghệ.", "by": "SUSAN BENNETT · THEO CNN, 2013", "lbl": "DIỄN Ý", "typeDur": 2.0, "t0": 49.44, "t1": 53.56, "at": 49.49}, {"type": "kinetic", "items": [{"text": "CHƯA BAO GIỜ QUÁT SIRI", "at": 53.96, "acc": true, "fx": "marker", "L": {"cls": "kC", "style": {"top": "770px", "fontSize": "85px"}}, "D": [{"kind": "bar", "style": {"top": "770px", "height": "90px"}, "at": 53.71}], "em": "CHƯA"}], "t0": 53.56, "t1": 56.44, "lay": "corner"}, {"type": "quote", "text": "But I never yell at her – very bad karma.", "by": "SUSAN BENNETT · CNN, 04.10.2013", "lbl": "TRÍCH DỊCH", "qline": 15, "t0": 56.44, "t1": 57.72, "at": 56.505, "typeDur": 0.911, "voiceAt": 56.44, "voiceEnd": 57.4, "radio": true}, {"type": "kinetic", "items": [{"text": "MỖI NGÀY BỊ CHỬI BAO NHIÊU LẦN?", "at": 58.12, "acc": true, "fx": "outline", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "67px", "left": "140px"}}, "em": "NHIÊU"}, {"text": "lời bà đùa · diễn ý theo CNN", "at": 57.72, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "358px", "fontSize": "58px", "left": "310px"}}}], "t0": 57.72, "t1": 62.0, "lay": "ladder"}, {"type": "source", "source": "APPLE NEWSROOM · 10.06.2013", "ref": "APPLE GIỚI THIỆU IOS 7", "snippet": "Siri [[có giọng nam và giọng nữ mới]]", "hlAt": 67.71, "seal": "DỊCH TỪ THÔNG CÁO", "sealAt": 68.835, "t0": 62.0, "t1": 69.76}, {"type": "ledger", "title": "THỜI CỦA MỘT GIỌNG NÓI", "srcnote": "CNN · 04.10.2013", "rows": [{"k": "2011", "v": "GIỌNG SIRI Ở MỸ · THEO CNN", "at": 69.76}, {"k": "IOS 7", "v": "GIỌNG MỚI · DẦN KHÉP LẠI", "at": 72.55}, {"k": "BÀ BENNETT", "v": "HƠI TIẾC · QUEN CÔNG NGHỆ ĐỔI", "at": 73.6}], "t0": 69.76, "t1": 78.92}, {"type": "question", "text": "Giọng mới được làm thế nào,\nvà vì sao nghe giống người hơn?", "t0": 78.92, "t1": 84.94}], "prog0": 0.70274, "prog1": 0.83676};
motion/hf/assets/long\ck-e2-quy-khan-cap\ch03\data.js:1:window.CASE = {"topic": "ck-e2-quy-khan-cap", "ch": "ch03", "dur": 73.3, "seed": 21886, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "Ô 03", "t": "MỖI THÁNG BAO NHIÊU?"}, "acc": ["quỹ", "khẩn", "cấp", "đệm", "thiết", "yếu", "tháng"], "lines": [{"text": "Ô thứ ba là ô duy nhất bạn điều khiển được ngay từ tháng này.", "start": 0.0, "end": 3.28, "words": [{"w": "Ô", "t": 0.1, "d": 0.14}, {"w": "thứ", "t": 0.24, "d": 0.145}, {"w": "ba", "t": 0.385, "d": 0.315}, {"w": "là", "t": 0.7, "d": 0.06}, {"w": "ô", "t": 0.76, "d": 0.19}, {"w": "duy", "t": 0.95, "d": 0.28}, {"w": "nhất", "t": 1.23, "d": 0.06}, {"w": "bạn", "t": 1.29, "d": 0.14}, {"w": "điều", "t": 1.43, "d": 0.295}, {"w": "khiển", "t": 1.725, "d": 0.19}, {"w": "được", "t": 1.915, "d": 0.125}, {"w": "ngay", "t": 2.04, "d": 0.25}, {"w": "từ", "t": 2.29, "d": 0.18}, {"w": "tháng", "t": 2.47, "d": 0.06}, {"w": "này.", "t": 2.53, "d": 0.325}]}, {"text": "Giả sử An để dành được một triệu rưỡi mỗi tháng.", "start": 4.08, "end": 6.88, "words": [{"w": "Giả", "t": 4.185, "d": 0.27}, {"w": "sử", "t": 4.455, "d": 0.195}, {"w": "An", "t": 4.65, "d": 0.205}, {"w": "để", "t": 4.855, "d": 0.19}, {"w": "dành", "t": 5.045, "d": 0.195}, {"w": "được", "t": 5.24, "d": 0.145}, {"w": "một", "t": 5.385, "d": 0.21}, {"w": "triệu", "t": 5.595, "d": 0.285}, {"w": "rưỡi", "t": 5.88, "d": 0.18}, {"w": "mỗi", "t": 6.06, "d": 0.195}, {"w": "tháng.", "t": 6.255, "d": 0.305}]}, {"text": "Hai mươi tư triệu chia cho một triệu rưỡi, là mười sáu tháng.", "start": 7.2, "end": 10.48, "words": [{"w": "Hai", "t": 7.3, "d": 0.265}, {"w": "mươi", "t": 7.565, "d": 0.17}, {"w": "tư", "t": 7.735, "d": 0.18}, {"w": "triệu", "t": 7.915, "d": 0.17}, {"w": "chia", "t": 8.085, "d": 0.305}, {"w": "cho", "t": 8.39, "d": 0.075}, {"w": "một", "t": 8.465, "d": 0.17}, {"w": "triệu", "t": 8.635, "d": 0.355}, {"w": "rưỡi,", "t": 8.99, "d": 0.145}, {"w": "là", "t": 9.135, "d": 0.22}, {"w": "mười", "t": 9.355, "d": 0.345}, {"w": "sáu", "t": 9.7, "d": 0.185}, {"w": "tháng.", "t": 9.885, "d": 0.27}]}, {"text": "Mười sáu tháng nghe thật dài.", "start": 11.48, "end": 13.16, "words": [{"w": "Mười", "t": 11.58, "d": 0.23}, {"w": "sáu", "t": 11.81, "d": 0.175}, {"w": "tháng", "t": 11.985, "d": 0.135}, {"w": "nghe", "t": 12.12, "d": 0.25}, {"w": "thật", "t": 12.37, "d": 0.125}, {"w": "dài.", "t": 12.495, "d": 0.28}]}, {"text": "Nhưng hãy nhìn những cột mốc dọc đường.", "start": 13.48, "end": 15.56, "words": [{"w": "Nhưng", "t": 13.585, "d": 0.155}, {"w": "hãy", "t": 13.74, "d": 0.16}, {"w": "nhìn", "t": 13.9, "d": 0.325}, {"w": "những", "t": 14.225, "d": 0.095}, {"w": "cột", "t": 14.32, "d": 0.16}, {"w": "mốc", "t": 14.48, "d": 0.2}, {"w": "dọc", "t": 14.68, "d": 0.265}, {"w": "đường.", "t": 14.945, "d": 0.275}]}, {"text": "Sau khoảng năm tháng, An đã có đủ một tháng thiết yếu.", "start": 15.88, "end": 19.0, "words": [{"w": "Sau", "t": 15.93, "d": 0.19}, {"w": "khoảng", "t": 16.12, "d": 0.15}, {"w": "năm", "t": 16.27, "d": 0.275}, {"w": "tháng,", "t": 16.545, "d": 0.42}, {"w": "An", "t": 16.965, "d": 0.055}, {"w": "đã", "t": 17.02, "d": 0.275}, {"w": "có", "t": 17.295, "d": 0.145}, {"w": "đủ", "t": 17.44, "d": 0.305}, {"w": "một", "t": 17.745, "d": 0.215}, {"w": "tháng", "t": 17.96, "d": 0.245}, {"w": "thiết", "t": 18.205, "d": 0.19}, {"w": "yếu.", "t": 18.395, "d": 0.26}]}, {"text": "Tức là một lần hỏng xe, một lần ốm nhẹ, không còn làm An chao đảo.", "start": 19.32, "end": 23.32, "words": [{"w": "Tức", "t": 19.375, "d": 0.11}, {"w": "là", "t": 19.485, "d": 0.275}, {"w": "một", "t": 19.76, "d": 0.215}, {"w": "lần", "t": 19.975, "d": 0.23}, {"w": "hỏng", "t": 20.205, "d": 0.08}, {"w": "xe,", "t": 20.285, "d": 0.385}, {"w": "một", "t": 20.67, "d": 0.24}, {"w": "lần", "t": 20.91, "d": 0.195}, {"w": "ốm", "t": 21.105, "d": 0.205}, {"w": "nhẹ,", "t": 21.31, "d": 0.345}, {"w": "không", "t": 21.655, "d": 0.075}, {"w": "còn", "t": 21.73, "d": 0.265}, {"w": "làm", "t": 21.995, "d": 0.315}, {"w": "An", "t": 22.31, "d": 0.07}, {"w": "chao", "t": 22.38, "d": 0.25}, {"w": "đảo.", "t": 22.63, "d": 0.32}]}, {"text": "Sau khoảng mười tháng, An có đủ tiền cho tờ hoá đơn mười lăm triệu ở đầu video.", "start": 24.32, "end": 28.64, "words": [{"w": "Sau", "t": 24.435, "d": 0.21}, {"w": "khoảng", "t": 24.645, "d": 0.15}, {"w": "mười", "t": 24.795, "d": 0.245}, {"w": "tháng,", "t": 25.04, "d": 0.37}, {"w": "An", "t": 25.41, "d": 0.1}, {"w": "có", "t": 25.51, "d": 0.235}, {"w": "đủ", "t": 25.745, "d": 0.3}, {"w": "tiền", "t": 26.045, "d": 0.06}, {"w": "cho", "t": 26.105, "d": 0.205}, {"w": "tờ", "t": 26.31, "d": 0.165}, {"w": "hoá", "t": 26.475, "d": 0.345}, {"w": "đơn", "t": 26.82, "d": 0.145}, {"w": "mười", "t": 26.965, "d": 0.225}, {"w": "lăm", "t": 27.19, "d": 0.21}, {"w": "triệu", "t": 27.4, "d": 0.08}, {"w": "ở", "t": 27.48, "d": 0.26}, {"w": "đầu", "t": 27.74, "d": 0.195}, {"w": "video.", "t": 27.935, "d": 0.36}]}, {"text": "Và tới tháng thứ mười sáu, tấm đệm ba tháng đã xong.", "start": 28.96, "end": 32.16, "words": [{"w": "Và", "t": 29.09, "d": 0.145}, {"w": "tới", "t": 29.235, "d": 0.17}, {"w": "tháng", "t": 29.405, "d": 0.205}, {"w": "thứ", "t": 29.61, "d": 0.385}, {"w": "mười", "t": 29.995, "d": 0.06}, {"w": "sáu,", "t": 30.055, "d": 0.42}, {"w": "tấm", "t": 30.475, "d": 0.075}, {"w": "đệm", "t": 30.55, "d": 0.315}, {"w": "ba", "t": 30.865, "d": 0.275}, {"w": "tháng", "t": 31.14, "d": 0.06}, {"w": "đã", "t": 31.2, "d": 0.345}, {"w": "xong.", "t": 31.545, "d": 0.245}]}, {"text": "Điều quan trọng là quỹ này không cần đầy mới có tác dụng.", "start": 33.16, "end": 36.04, "words": [{"w": "Điều", "t": 33.225, "d": 0.165}, {"w": "quan", "t": 33.39, "d": 0.175}, {"w": "trọng", "t": 33.565, "d": 0.165}, {"w": "là", "t": 33.73, "d": 0.265}, {"w": "quỹ", "t": 33.995, "d": 0.09}, {"w": "này", "t": 34.085, "d": 0.295}, {"w": "không", "t": 34.38, "d": 0.06}, {"w": "cần", "t": 34.44, "d": 0.185}, {"w": "đầy", "t": 34.625, "d": 0.205}, {"w": "mới", "t": 34.83, "d": 0.13}, {"w": "có", "t": 34.96, "d": 0.235}, {"w": "tác", "t": 35.195, "d": 0.165}, {"w": "dụng.", "t": 35.36, "d": 0.31}]}, {"text": "Mỗi tháng để vào, tấm đệm dày thêm một lớp.", "start": 36.36, "end": 39.0, "words": [{"w": "Mỗi", "t": 36.42, "d": 0.185}, {"w": "tháng", "t": 36.605, "d": 0.21}, {"w": "để", "t": 36.815, "d": 0.17}, {"w": "vào,", "t": 36.985, "d": 0.4}, {"w": "tấm", "t": 37.385, "d": 0.06}, {"w": "đệm", "t": 37.445, "d": 0.35}, {"w": "dày", "t": 37.795, "d": 0.105}, {"w": "thêm", "t": 37.9, "d": 0.22}, {"w": "một", "t": 38.12, "d": 0.265}, {"w": "lớp.", "t": 38.385, "d": 0.24}]}, {"text": "Một tấm đệm mỏng vẫn hơn hẳn mặt đất.", "start": 39.32, "end": 41.48, "words": [{"w": "Một", "t": 39.39, "d": 0.18}, {"w": "tấm", "t": 39.57, "d": 0.185}, {"w": "đệm", "t": 39.755, "d": 0.105}, {"w": "mỏng", "t": 39.86, "d": 0.315}, {"w": "vẫn", "t": 40.175, "d": 0.06}, {"w": "hơn", "t": 40.235, "d": 0.15}, {"w": "hẳn", "t": 40.385, "d": 0.235}, {"w": "mặt", "t": 40.62, "d": 0.18}, {"w": "đất.", "t": 40.8, "d": 0.295}]}, {"text": "Có một mẹo nhỏ mà nhiều người dùng.", "start": 42.48, "end": 44.48, "words": [{"w": "Có", "t": 42.535, "d": 0.25}, {"w": "một", "t": 42.785, "d": 0.18}, {"w": "mẹo", "t": 42.965, "d": 0.06}, {"w": "nhỏ", "t": 43.025, "d": 0.28}, {"w": "mà", "t": 43.305, "d": 0.165}, {"w": "nhiều", "t": 43.47, "d": 0.185}, {"w": "người", "t": 43.655, "d": 0.2}, {"w": "dùng.", "t": 43.855, "d": 0.215}]}, {"text": "Đừng để dành phần còn lại sau khi tiêu.", "start": 44.8, "end": 47.04, "words": [{"w": "Đừng", "t": 44.855, "d": 0.205}, {"w": "để", "t": 45.06, "d": 0.2}, {"w": "dành", "t": 45.26, "d": 0.205}, {"w": "phần", "t": 45.465, "d": 0.195}, {"w": "còn", "t": 45.66, "d": 0.06}, {"w": "lại", "t": 45.72, "d": 0.33}, {"w": "sau", "t": 46.05, "d": 0.09}, {"w": "khi", "t": 46.14, "d": 0.185}, {"w": "tiêu.", "t": 46.325, "d": 0.355}]}, {"text": "Hãy chuyển khoản ấy đi ngay trong ngày nhận lương, sang một tài khoản riêng.", "start": 47.36, "end": 51.04, "words": [{"w": "Hãy", "t": 47.43, "d": 0.145}, {"w": "chuyển", "t": 47.575, "d": 0.27}, {"w": "khoản", "t": 47.845, "d": 0.185}, {"w": "ấy", "t": 48.03, "d": 0.255}, {"w": "đi", "t": 48.285, "d": 0.155}, {"w": "ngay", "t": 48.44, "d": 0.17}, {"w": "trong", "t": 48.61, "d": 0.12}, {"w": "ngày", "t": 48.73, "d": 0.355}, {"w": "nhận", "t": 49.085, "d": 0.06}, {"w": "lương,", "t": 49.145, "d": 0.365}, {"w": "sang", "t": 49.51, "d": 0.125}, {"w": "một", "t": 49.635, "d": 0.36}, {"w": "tài", "t": 49.995, "d": 0.19}, {"w": "khoản", "t": 50.185, "d": 0.215}, {"w": "riêng.", "t": 50.4, "d": 0.235}]}, {"text": "Tiền không nằm trước mắt thì khó bị tiêu hơn.", "start": 51.36, "end": 53.68, "words": [{"w": "Tiền", "t": 51.415, "d": 0.17}, {"w": "không", "t": 51.585, "d": 0.22}, {"w": "nằm", "t": 51.805, "d": 0.155}, {"w": "trước", "t": 51.96, "d": 0.12}, {"w": "mắt", "t": 52.08, "d": 0.255}, {"w": "thì", "t": 52.335, "d": 0.21}, {"w": "khó", "t": 52.545, "d": 0.075}, {"w": "bị", "t": 52.62, "d": 0.34}, {"w": "tiêu", "t": 52.96, "d": 0.185}, {"w": "hơn.", "t": 53.145, "d": 0.22}]}, {"text": "Trả cho mình trước.", "start": 54.0, "end": 55.2, "words": [{"w": "Trả", "t": 54.12, "d": 0.2}, {"w": "cho", "t": 54.32, "d": 0.06}, {"w": "mình", "t": 54.38, "d": 0.295}, {"w": "trước.", "t": 54.675, "d": 0.2}]}, {"text": "Còn nếu An chỉ để được một triệu thì sao?", "start": 56.2, "end": 58.68, "words": [{"w": "Còn", "t": 56.27, "d": 0.095}, {"w": "nếu", "t": 56.365, "d": 0.275}, {"w": "An", "t": 56.64, "d": 0.195}, {"w": "chỉ", "t": 56.835, "d": 0.075}, {"w": "để", "t": 56.91, "d": 0.275}, {"w": "được", "t": 57.185, "d": 0.135}, {"w": "một", "t": 57.32, "d": 0.185}, {"w": "triệu", "t": 57.505, "d": 0.25}, {"w": "thì", "t": 57.755, "d": 0.215}, {"w": "sao?", "t": 57.97, "d": 0.215}]}, {"text": "Hai mươi tư tháng. Chậm hơn, nhưng vẫn tới.", "start": 59.28, "end": 61.84, "words": [{"w": "Hai", "t": 59.36, "d": 0.235}, {"w": "mươi", "t": 59.595, "d": 0.185}, {"w": "tư", "t": 59.78, "d": 0.265}, {"w": "tháng.", "t": 60.045, "d": 0.18}, {"w": "Chậm", "t": 60.225, "d": 0.17}, {"w": "hơn,", "t": 60.395, "d": 0.42}, {"w": "nhưng", "t": 60.815, "d": 0.255}, {"w": "vẫn", "t": 61.07, "d": 0.2}, {"w": "tới.", "t": 61.27, "d": 0.255}]}, {"text": "Và nếu chưa để được đồng nào? Khi ấy, việc đầu tiên là nhìn lại ô thứ nhất.", "start": 62.16, "end": 66.72, "words": [{"w": "Và", "t": 62.235, "d": 0.125}, {"w": "nếu", "t": 62.36, "d": 0.24}, {"w": "chưa", "t": 62.6, "d": 0.32}, {"w": "để", "t": 62.92, "d": 0.17}, {"w": "được", "t": 63.09, "d": 0.24}, {"w": "đồng", "t": 63.33, "d": 0.24}, {"w": "nào?", "t": 63.57, "d": 0.275}, {"w": "Khi", "t": 63.845, "d": 0.085}, {"w": "ấy,", "t": 63.93, "d": 0.515}, {"w": "việc", "t": 64.445, "d": 0.19}, {"w": "đầu", "t": 64.635, "d": 0.06}, {"w": "tiên", "t": 64.695, "d": 0.195}, {"w": "là", "t": 64.89, "d": 0.25}, {"w": "nhìn", "t": 65.14, "d": 0.205}, {"w": "lại", "t": 65.345, "d": 0.31}, {"w": "ô", "t": 65.655, "d": 0.205}, {"w": "thứ", "t": 65.86, "d": 0.185}, {"w": "nhất.", "t": 66.045, "d": 0.3}]}, {"text": "Nhưng nếu không có tấm đệm ấy, cái giá là bao nhiêu? Mình quay lại phiên bản thứ hai của An.", "start": 67.04, "end": 72.08, "words": [{"w": "Nhưng", "t": 67.105, "d": 0.165}, {"w": "nếu", "t": 67.27, "d": 0.185}, {"w": "không", "t": 67.455, "d": 0.325}, {"w": "có", "t": 67.78, "d": 0.185}, {"w": "tấm", "t": 67.965, "d": 0.135}, {"w": "đệm", "t": 68.1, "d": 0.295}, {"w": "ấy,", "t": 68.395, "d": 0.16}, {"w": "cái", "t": 68.555, "d": 0.29}, {"w": "giá", "t": 68.845, "d": 0.185}, {"w": "là", "t": 69.03, "d": 0.175}, {"w": "bao", "t": 69.205, "d": 0.19}, {"w": "nhiêu?", "t": 69.395, "d": 0.44}, {"w": "Mình", "t": 69.835, "d": 0.06}, {"w": "quay", "t": 69.895, "d": 0.265}, {"w": "lại", "t": 70.16, "d": 0.28}, {"w": "phiên", "t": 70.44, "d": 0.1}, {"w": "bản", "t": 70.54, "d": 0.205}, {"w": "