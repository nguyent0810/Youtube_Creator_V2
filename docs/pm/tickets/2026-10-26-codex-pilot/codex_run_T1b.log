"flicker", "em": "HÌNH:"}, {"text": "cùng lúc ở Bộ chỉ huy Không quân Chiến lược + Trung tâm Chỉ huy Quân sự Quốc gia", "at": 14.72, "sm": true, "fx": "rise"}], "label": {"k": "PHÒNG CHỈ HUY NORAD", "v": "ẢNH BỘ QUỐC PHÒNG MỸ · BOB SIMONS", "at": 10.64}, "t0": 10.64, "t1": 20.08}, {"type": "source", "source": "NATIONAL SECURITY ARCHIVE · EBB 371 · 01.03.2012", "ref": "“THE 3 A.M. PHONE CALL: FALSE MISSILE ATTACK WARNING INCIDENTS, 1979–1980”", "snippet": "…awakened on 9 November 1979, to be told that [[NORAD … was reporting a Soviet missile attack]].", "hlAt": 29.84, "seal": "HỒ SƠ GIẢI MẬT · DẪN HỒI KÝ R. GATES (1996)", "sealAt": 26.23, "t0": 20.08, "t1": 34.96}, {"type": "counter", "from": 0, "to": 250, "suffix": " TÊN LỬA", "until": 36.61, "label": "CUỘC GỌI THỨ NHẤT · THEO HỒI KÝ", "sub": {"text": "QUA NSA EBB 371", "at": 34.96}, "t0": 34.96, "t1": 38.4, "at": 35.160000000000004}, {"type": "slam", "text": "2.200 TÊN LỬA", "sub": "CUỘC GỌI THỨ HAI · “TẤN CÔNG TOÀN DIỆN” · THEO HỒI KÝ", "t0": 38.4, "t1": 43.08, "at": 38.55, "fx": "slice"}, {"type": "kinetic", "items": [{"text": "3–7 PHÚT ĐỂ TỔNG THỐNG QUYẾT ĐỊNH", "at": 43.78, "acc": true, "fx": "outline", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "63px", "left": "140px"}}, "em": "3–7"}, {"text": "không đánh thức vợ · theo hồi ký R. Gates", "at": 46.6, "sm": true, "fx": "blur", "L": {"cls": "kC", "style": {"top": "352px", "fontSize": "45px", "left": "310px"}}}, {"text": "ÔNG ĐỊNH GỌI CARTER", "at": 50.52, "fx": "slice", "L": {"cls": "kC", "style": {"top": "431px", "fontSize": "84px", "left": "480px"}}, "em": "CARTER"}], "t0": 43.08, "t1": 52.44, "lay": "ladder"}, {"type": "question", "text": "Bạn gọi Tổng thống,\nhay chờ thêm một chút?\nBÁO LÊN   |   CHƯA", "t0": 52.44, "t1": 57.68}, {"type": "kinetic", "items": [{"text": "CUỘC GỌI THỨ BA", "at": 57.68, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "740px", "fontSize": "50px"}}, "D": [{"kind": "bar", "style": {"top": "740px", "hei