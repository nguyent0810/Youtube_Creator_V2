motion/hf/assets/long\mim-watson-jeopardy\ch17\data.js:1:window.CASE = {"topic": "mim-watson-jeopardy", "ch": "ch17", "dur": 54.14, "seed": 26251, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 17", "t": "MỘT CỖ MÁY BIẾT TRANH LUẬN"}, "acc": ["watson", "toronto", "tự", "tin", "máy", "chắc", "thắng", "sai"], "lines": [{"text": "IBM chưa dừng ở đố vui.", "start": 0.0, "end": 1.76, "words": [{"w": "IBM", "t": 0.06, "d": 0.455}, {"w": "chưa", "t": 0.515, "d": 0.185}, {"w": "dừng", "t": 0.7, "d": 0.325}, {"w": "ở", "t": 1.025, "d": 0.09}, {"w": "đố", "t": 1.115, "d": 0.18}, {"w": "vui.", "t": 1.295, "d": 0.3}]}, {"text": "Tháng hai năm hai nghìn không trăm mười chín, ở San Francisco, họ đưa lên sân khấu một cỗ máy khác.", "start": 2.56, "end": 7.52, "words": [{"w": "Tháng", "t": 2.71, "d": 0.125}, {"w": "hai", "t": 2.835, "d": 0.255}, {"w": "năm", "t": 3.09, "d": 0.295}, {"w": "hai", "t": 3.385, "d": 0.15}, {"w": "nghìn", "t": 3.535, "d": 0.26}, {"w": "không", "t": 3.795, "d": 0.175}, {"w": "trăm", "t": 3.97, "d": 0.2}, {"w": "mười", "t": 4.17, "d": 0.065}, {"w": "chín,", "t": 4.235, "d": 0.475}, {"w": "ở", "t": 4.71, "d": 0.23}, {"w": "San", "t": 4.94, "d": 0.2}, {"w": "Francisco,", "t": 5.14, "d": 0.325}, {"w": "họ", "t": 5.465, "d": 0.115}, {"w": "đưa", "t": 5.58, "d": 0.115}, {"w": "lên", "t": 5.695, "d": 0.2}, {"w": "sân", "t": 5.895, "d": 0.33}, {"w": "khấu", "t": 6.225, "d": 0.16}, {"w": "một", "t": 6.385, "d": 0.215}, {"w": "cỗ", "t": 6.6, "d": 0.24}, {"w": "máy", "t": 6.84, "d": 0.165}, {"w": "khác.", "t": 7.005, "d": 0.32}]}, {"text": "Nó tên là Project Debater. Việc của nó không phải trả lời, mà là tranh luận.", "start": 7.84, "end": 12.16, "words": [{"w": "Nó", "t": 7.87, "d": 0.125}, {"w": "tên", "t": 7.995, "d": 0.41}, {"w": "là", "t": 8.405, "d": 0.165}, {"w": "Project", "t": 8.57, "d": 0.33}, {"w": "Debater.", "t": 8.9, "d": 0.345}, {"w": "Việc", "t": 9.245, "d": 0.26}, {"w": "của", "t": 9.505, "d": 0.23}, {"w": "nó", "t": 9.735, "d": 0.09}, {"w": "không", "t": 9.825, "d": 0.335}, {"w": "phải", "t": 10.16, "d": 0.145}, {"w": "trả", "t": 10.305, "d": 0.33}, {"w": "lời,", "t": 10.635, "d": 0.305}, {"w": "mà", "t": 10.94, "d": 0.34}, {"w": "là", "t": 11.28, "d": 0.09}, {"w": "tranh", "t": 11.37, "d": 0.34}, {"w": "luận.", "t": 11.71, "d": 0.31}]}, {"text": "Đối thủ là Harish Natarajan, một nhà vô địch tranh biện.", "start": 13.16, "end": 16.04, "words": [{"w": "Đối", "t": 13.17, "d": 0.12}, {"w": "thủ", "t": 13.29, "d": 0.36}, {"w": "là", "t": 13.65, "d": 0.265}, {"w": "Harish", "t": 13.915, "d": 0.18}, {"w": "Natarajan,", "t": 14.095, "d": 0.29}, {"w": "một", "t": 14.385, "d": 0.345}, {"w": "nhà", "t": 14.73, "d": 0.185}, {"w": "vô", "t": 14.915, "d": 0.19}, {"w": "địch", "t": 15.105, "d": 0.195}, {"w": "tranh", "t": 15.3, "d": 0.235}, {"w": "biện.", "t": 15.535, "d": 0.345}]}, {"text": "Chủ đề chỉ được công bố mười lăm phút trước giờ lên sân khấu: có nên trợ cấp cho giáo dục mầm non hay không.", "start": 16.36, "end": 21.56, "words": [{"w": "Chủ", "t": 16.385, "d": 0.1}, {"w": "đề", "t": 16.485, "d": 0.235}, {"w": "chỉ", "t": 16.72, "d": 0.305}, {"w": "được", "t": 17.025, "d": 0.185}, {"w": "công", "t": 17.21, "d": 0.185}, {"w": "bố", "t": 17.395, "d": 0.19}, {"w": "mười", "t": 17.585, "d": 0.195}, {"w": "lăm", "t": 17.78, "d": 0.19}, {"w": "phút", "t": 17.97, "d": 0.08}, {"w": "trước", "t": 18.05, "d": 0.16}, {"w": "giờ", "t": 18.21, "d": 0.32}, {"w": "lên", "t": 18.53, "d": 0.19}, {"w": "sân", "t": 18.72, "d": 0.13}, {"w": "khấu:", "t": 18.85, "d": 0.355}, {"w": "có", "t": 19.205, "d": 0.165}, {"w": "nên", "t": 19.37, "d": 0.06}, {"w": "trợ", "t": 19.43, "d": 0.33}, {"w": "cấp", "t": 19.76, "d": 0.2}, {"w": "cho", "t": 19.96, "d": 0.19}, {"w": "giáo", "t": 20.15, "d": 0.155}, {"w": "dục", "t": 20.305, "d": 0.155}, {"w": "mầm", "t": 20.46, "d": 0.14}, {"w": "non", "t": 20.6, "d": 0.195}, {"w": "hay", "t": 20.795, "d": 0.245}, {"w": "không.", "t": 21.04, "d": 0.275}]}, {"text": "Cỗ máy nói phe ủng hộ. Con người nói phe phản đối.", "start": 21.88, "end": 24.76, "words": [{"w": "Cỗ", "t": 21.94, "d": 0.11}, {"w": "máy", "t": 22.05, "d": 0.33}, {"w": "nói", "t": 22.38, "d": 0.245}, {"w": "phe", "t": 22.625, "d": 0.2}, {"w": "ủng", "t": 22.825, "d": 0.2}, {"w": "hộ.", "t": 23.025, "d": 0.18}, {"w": "Con", "t": 23.205, "d": 0.185}, {"w": "người", "t": 23.39, "d": 0.18}, {"w": "nói", "t": 23.57, "d": 0.375}, {"w": "phe", "t": 23.945, "d": 0.19}, {"w": "phản", "t": 24.135, "d": 0.19}, {"w": "đối.", "t": 24.325, "d": 0.26}]}, {"text": "Người thắng được chọn theo một cách thú vị.", "start": 25.76, "end": 27.84, "words": [{"w": "Người", "t": 25.76, "d": 0.105}, {"w": "thắng", "t": 25.865, "d": 0.36}, {"w": "được", "t": 26.225, "d": 0.06}, {"w": "chọn", "t": 26.285, "d": 0.275}, {"w": "theo", "t": 26.56, "d": 0.25}, {"w": "một", "t": 26.81, "d": 0.19}, {"w": "cách", "t": 27.0, "d": 0.195}, {"w": "thú", "t": 27.195, "d": 0.065}, {"w": "vị.", "t": 27.26, "d": 0.36}]}, {"text": "Khán giả bỏ phiếu trước và sau cuộc tranh luận.", "start": 28.16, "end": 31.68, "words": [{"w": "Khán", "t": 28.16, "d": 0.375}, {"w": "giả", "t": 28.535, "d": 0.26}, {"w": "bỏ", "t": 28.795, "d": 0.445}, {"w": "phiếu", "t": 29.24, "d": 0.08}, {"w": "trước", "t": 29.32, "d": 0.305}, {"w": "và", "t": 29.625, "d": 0.525}, {"w": "sau", "t": 30.15, "d": 0.32}, {"w": "cuộc", "t": 30.47, "d": 0.095}, {"w": "tranh", "t": 30.565, "d": 0.4}, {"w": "luận.", "t": 30.965, "d": 0.54}]}, {"text": "Bên nào làm nhiều người đổi ý hơn về phía mình, bên ấy thắng.", "start": 32.0, "end": 35.28, "words": [{"w": "Bên", "t": 32.1, "d": 0.115}, {"w": "nào", "t": 32.215, "d": 0.235}, {"w": "làm", "t": 32.45, "d": 0.175}, {"w": "nhiều", "t": 32.625, "d": 0.255}, {"w": "người", "t": 32.88, "d": 0.25}, {"w": "đổi", "t": 33.13, "d": 0.16}, {"w": "ý", "t": 33.29, "d": 0.265}, {"w": "hơn", "t": 33.555, "d": 0.195}, {"w": "về", "t": 33.75, "d": 0.06}, {"w": "phía", "t": 33.81, "d": 0.33}, {"w": "mình,", "t": 34.14, "d": 0.245}, {"w": "bên", "t": 34.385, "d": 0.095}, {"w": "ấy", "t": 34.48, "d": 0.245}, {"w": "thắng.", "t": 34.725, "d": 0.355}]}, {"text": "Kết quả: con người thắng.", "start": 36.28, "end": 37.96, "words": [{"w": "Kết", "t": 36.315, "d": 0.175}, {"w": "quả:", "t": 36.49, "d": 0.495}, {"w": "con", "t": 36.985, "d": 0.16}, {"w": "người", "t": 37.145, "d": 0.35}, {"w": "thắng.", "t": 37.495, "d": 0.28}]}, {"text": "Theo hãng tin AFP, trước cuộc tranh luận, bảy mươi chín phần trăm khán giả ủng hộ trợ cấp. Sau đó, chỉ còn sáu mươi hai phần trăm.", "start": 38.28, "end": 45.16, "words": [{"w": "Theo", "t": 38.29, "d": 0.285}, {"w": "hãng", "t": 38.575, "d": 0.205}, {"w": "tin", "t": 38.78, "d": 0.065}, {"w": "AFP,", "t": 38.845, "d": 0.76}, {"w": "trước", "t": 39.605, "d": 0.215}, {"w": "cuộc", "t": 39.82, "d": 0.165}, {"w": "tranh", "t": 39.985, "d": 0.335}, {"w": "luận,", "t": 40.32, "d": 0.32}, {"w": "bảy", "t": 40.64, "d": 0.06}, {"w": "mươi", "t": 40.7, "d": 0.235}, {"w": "chín", "t": 40.935, "d": 0.145}, {"w": "phần", "t": 41.08, "d": 0.21}, {"w": "trăm", "t": 41.29, "d": 0.19}, {"w": "khán", "t": 41.48, "d": 0.26}, {"w": "giả", "t": 41.74, "d": 0.195}, {"w": "ủng", "t": 41.935, "d": 0.315}, {"w": "hộ", "t": 42.25, "d": 0.22}, {"w": "trợ", "t": 42.47, "d": 0.2}, {"w": "cấp.", "t": 42.67, "d": 0.325}, {"w": "Sau", "t": 42.995, "d": 0.17}, {"w": "đó,", "t": 43.165, "d": 0.255}, {"w": "chỉ", "t": 43.42, "d": 0.295}, {"w": "còn", "t": 43.715, "d": 0.07}, {"w": "sáu", "t": 43.785, "d": 0.19}, {"w": "mươi", "t": 43.975, "d": 0.27}, {"w": "hai", "t": 44.245, "d": 0.115}, {"w": "phần", "t": 44.36, "d": 0.275}, {"w": "trăm.", "t": 44.635, "d": 0.345}]}, {"text": "Một nhà nghiên cứu của IBM nói rằng chuyện này không phải là thắng hay thua.", "start": 45.48, "end": 49.24, "words": [{"w": "Một", "t": 45.57, "d": 0.11}, {"w": "nhà", "t": 45.68, "d": 0.34}, {"w": "nghiên", "t": 46.02, "d": 0.19}, {"w": "cứu", "t": 46.21, "d": 0.155}, {"w": "của", "t": 46.365, "d": 0.12}, {"w": "IBM", "t": 46.485, "d": 0.665}, {"w": "nói", "t": 47.15, "d": 0.17}, {"w": "rằng", "t": 47.32, "d": 0.06}, {"w": "chuyện", "t": 47.38, "d": 0.165}, {"w": "này", "t": 47.545, "d": 0.255}, {"w": "không", "t": 47.8, "d": 0.16}, {"w": "phải", "t": 47.96, "d": 0.27}, {"w": "là", "t": 48.23, "d": 0.23}, {"w": "thắng", "t": 48.46, "d": 0.155}, {"w": "hay", "t": 48.615, "d": 0.06}, {"w": "thua.", "t": 48.675, "d": 0.385}]}, {"text": "Nhưng lần này, trên sân khấu của ngôn ngữ, con người vẫn giữ được phần thắng.", "start": 49.56, "end": 52.92, "words": [{"w": "Nhưng", "t": 49.56, "d": 0.21}, {"w": "lần", "t": 49.77, "d": 0.215}, {"w": "này,", "t": 49.985, "d": 0.28}, {"w": "trên", "t": 50.265, "d": 0.06}, {"w": "sân", "t": 50.325, "d": 0.2}, {"w": "khấu", "t": 50.525, "d": 0.145}, {"w": "của", "t": 50.67, "d": 0.18}, {"w": "ngôn", "t": 50.85, "d": 0.155}, {"w": "ngữ,", "t": 51.005, "d": 0.44}, {"w": "con", "t": 51.445, "d": 0.13}, {"w": "người", "t": 51.575, "d": 0.07}, {"w": "vẫn", "t": 51.645, "d": 0.2}, {"w": "giữ", "t": 51.845, "d": 0.21}, {"w": "được", "t": 52.055, "d": 0.275}, {"w": "phần", "t": 52.33, "d": 0.16}, {"w": "thắng.", "t": 52.49, "d": 0.23}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "17", "k": "CHƯƠNG 17", "title": "MỘT CỖ MÁY\nBIẾT TRANH LUẬN", "sub": "PROJECT DEBATER · 02.2019", "vid": "v0", "ms": 16, "illus": "VIDEO MINH HỌA · KHÔNG PHẢI HÌNH ẢNH CHƯƠNG TRÌNH", "titleAt": 0.06, "t0": 0.0, "t1": 13.16}, {"type": "ledger", "title": "SAN FRANCISCO · 02.2019", "rows": [{"k": "CON NGƯỜI", "v": "HARISH NATARAJAN", "at": 13.16}, {"k": "CHỦ ĐỀ", "v": "TRỢ CẤP MẦM NON?", "at": 16.36}, {"k": "CHUẨN BỊ", "v": "15 PHÚT", "at": 17.585}], "total": {"k": "MÁY · NGƯỜI", "v": "ỦNG HỘ · PHẢN ĐỐI", "at": 21.88}, "t0": 13.16, "t1": 28.16}, {"type": "timeline", "items": [{"year": "TRƯỚC", "text": "khán giả bỏ phiếu", "at": 28.