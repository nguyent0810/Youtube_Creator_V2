motion/hf/assets/long\mim-ai-khuon-mat\ch06\data.js:1:window.CASE = {"topic": "mim-ai-khuon-mat", "ch": "ch06", "dur": 71.74, "seed": 18735, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 06", "t": "KHI CỖ MÁY NHÌN NHẦM"}, "acc": ["khuôn", "mặt", "số", "trạm", "ngưỡng", "nhầm", "máy"], "lines": [{"text": "Năm hai nghìn không trăm mười tám, hai nhà nghiên cứu Joy Buolamwini và Timnit Gebru công bố một nghiên cứu tên là Gender Shades.", "start": 0.0, "end": 6.4, "words": [{"w": "Năm", "t": 0.0, "d": 0.335}, {"w": "hai", "t": 0.335, "d": 0.135}, {"w": "nghìn", "t": 0.47, "d": 0.255}, {"w": "không", "t": 0.725, "d": 0.325}, {"w": "trăm", "t": 1.05, "d": 0.22}, {"w": "mười", "t": 1.27, "d": 0.08}, {"w": "tám,", "t": 1.35, "d": 0.52}, {"w": "hai", "t": 1.87, "d": 0.23}, {"w": "nhà", "t": 2.1, "d": 0.2}, {"w": "nghiên", "t": 2.3, "d": 0.265}, {"w": "cứu", "t": 2.565, "d": 0.155}, {"w": "Joy", "t": 2.72, "d": 0.16}, {"w": "Buolamwini", "t": 2.88, "d": 0.415}, {"w": "và", "t": 3.295, "d": 0.27}, {"w": "Timnit", "t": 3.565, "d": 0.08}, {"w": "Gebru", "t": 3.645, "d": 0.2}, {"w": "công", "t": 3.845, "d": 0.325}, {"w": "bố", "t": 4.17, "d": 0.335}, {"w": "một", "t": 4.505, "d": 0.15}, {"w": "nghiên", "t": 4.655, "d": 0.2}, {"w": "cứu", "t": 4.855, "d": 0.35}, {"w": "tên", "t": 5.205, "d": 0.165}, {"w": "là", "t": 5.37, "d": 0.325}, {"w": "Gender", "t": 5.695, "d": 0.06}, {"w": "Shades.", "t": 5.755, "d": 0.46}]}, {"text": "Họ thử ba hệ thống thương mại phân tích khuôn mặt, với một việc tưởng như đơn giản: đoán xem người trong ảnh là nam hay nữ.", "start": 7.2, "end": 12.8, "words": [{"w": "Họ", "t": 7.24, "d": 0.14}, {"w": "thử", "t": 7.38, "d": 0.155}, {"w": "ba", "t": 7.535, "d": 0.32}, {"w": "hệ", "t": 7.855, "d": 0.19}, {"w": "thống", "t": 8.045, "d": 0.125}, {"w": "thương", "t": 8.17, "d": 0.27}, {"w": "mại", "t": 