motion/hf/assets/long\mim-ke-huy-diet-petrov\ch09\data.js:1:window.CASE = {"topic": "mim-ke-huy-diet-petrov", "ch": "ch09", "dur": 135.42, "seed": 32906, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 09", "t": "ÁNH NẮNG TRÊN MÂY"}, "acc": ["báo", "máy", "phóng", "mây", "người", "ghế", "chưa", "tấn"], "lines": [{"text": "Câu trả lời đến từ các đoàn điều tra.", "start": 0.0, "end": 2.8, "words": [{"w": "Câu", "t": 0.055, "d": 0.155}, {"w": "trả", "t": 0.21, "d": 0.505}, {"w": "lời", "t": 0.715, "d": 0.17}, {"w": "đến", "t": 0.885, "d": 0.435}, {"w": "từ", "t": 1.32, "d": 0.285}, {"w": "các", "t": 1.605, "d": 0.225}, {"w": "đoàn", "t": 1.83, "d": 0.135}, {"w": "điều", "t": 1.965, "d": 0.28}, {"w": "tra.", "t": 2.245, "d": 0.555}]}, {"text": "Petrov kể với tờ báo năm 2004 rằng ông không được ngủ mấy ngày liền, vì các uỷ ban kéo tới.", "start": 3.6, "end": 9.6, "words": [{"w": "Petrov", "t": 3.62, "d": 0.3}, {"w": "kể", "t": 3.92, "d": 0.06}, {"w": "với", "t": 3.98, "d": 0.27}, {"w": "tờ", "t": 4.25, "d": 0.125}, {"w": "báo", "t": 4.375, "d": 0.3}, {"w": "năm", "t": 4.675, "d": 0.265}, {"w": "2004", "t": 4.94, "d": 1.125}, {"w": "rằng", "t": 6.065, "d": 0.21}, {"w": "ông", "t": 6.275, "d": 0.365}, {"w": "không", "t": 6.64, "d": 0.215}, {"w": "được", "t": 6.855, "d": 0.245}, {"w": "ngủ", "t": 7.1, "d": 0.175}, {"w": "mấy", "t": 7.275, "d": 0.25}, {"w": "ngày", "t": 7.525, "d": 0.21}, {"w": "liền,", "t": 7.735, "d": 0.155}, {"w": "vì", "t": 7.89, "d": 0.26}, {"w": "các", "t": 8.15, "d": 0.35}, {"w": "uỷ", "t": 8.5, "d": 0.125}, {"w": "ban", "t": 8.625, "d": 0.175}, {"w": "kéo", "t": 8.8, "d": 0.33}, {"w": "tới.", "t": 9.13, "d": 0.255}]}, {"text": "Ông cũng bác bỏ một giai thoại báo phương Tây hay kể: rằng xong việc, ông uống nửa lít vodka rồi ngủ hai mươi tám tiếng.", "start": 9.92, "end": 15.84, "words": [{"w": "Ông", "t": 9.92, "d": 0.18}, {"w": "cũng", "t": 10.1, "d": 0.135}, {"w": "bác", "t": 10.235, "d": 0.325}, {"w": "bỏ", "t": 10.56, "d": 0.125}, {"w": "một", "t": 10.685, "d": 0.285}, {"w": "giai", "t": 10.97, "d": 0.16}, {"w": "thoại", "t": 11.13, "d": 0.295}, {"w": "báo", "t": 11.425, "d": 0.205}, {"w": "phương", "t": 11.63, "d": 0.205}, {"w": "Tây", "t": 11.835, "d": 0.195}, {"w": "hay", "t": 12.03, "d": 0.06}, {"w": "kể:", "t": 12.09, "d": 0.375}, {"w": "rằng", "t": 12.465, "d": 0.305}, {"w": "xong", "t": 12.77, "d": 0.205}, {"w": "việc,", "t": 12.975, "d": 0.145}, {"w": "ông", "t": 13.12, "d": 0.35}, {"w": "uống", "t": 13.47, "d": 0.06}, {"w": "nửa", "t": 13.53, "d": 0.365}, {"w": "lít", "t": 13.895, "d": 0.205}, {"w": "vodka", "t": 14.1, "d": 0.06}, {"w": "rồi", "t": 14.16, "d": 0.265}, {"w": "ngủ", "t": 14.425, "d": 0.16}, {"w": "hai", "t": 14.585, "d": 0.24}, {"w": "mươi", "t": 14.825, "d": 0.305}, {"w": "tám", "t": 15.13, "d": 0.205}, {"w": "tiếng.", "t": 15.335, "d": 0.24}]}, {"text": "Theo ông, thị trấn quân sự ấy cấm rượu, chỉ thỉnh thoảng có bia.", "start": 16.16, "end": 19.36, "words": [{"w": "Theo", "t": 16.16, "d": 0.27}, {"w": "ông,", "t": 16.43, "d": 0.165}, {"w": "thị", "t": 16.595, "d": 0.17}, {"w": "trấn", "t": 16.765, "d": 0.34}, {"w": "quân", "t": 17.105, "d": 0.135}, {"w": "sự", "t": 17.24, "d": 0.265}, {"w": "ấy", "t": 17.505, "d": 0.195}, {"w": "cấm", "t": 17.7, "d": 0.19}, {"w": "rượu,", "t": 17.89, "d": 0.295}, {"w": "chỉ", "t": 18.185, "d": 0.055}, {"w": "thỉnh", "t": 18.24, "d": 0.205}, {"w": "thoảng", "t": 18.445, "d": 0.195}, {"w": "có", "t": 18.64, "d": 0.185}, {"w": "bia.", "t": 18.825, "d": 0.37}]}, {"text": "Podvig viết rằng báo động giả năm 1983 về sau được quy cho phần mềm.", "start": 19.68, "end": 24.08, "words": [{"w": "Podvig", "t": 19.705, "d": 0.27}, {"w": "viết", "t": 19.975, "d": 0.15}, {"w": "rằng", "t": 20.125, "d": 0.23}, {"w": "báo", "t": 20.355, "d": 0.19}, {"w": "động", "t": 20.545, "d": 0.055}, {"w": "giả", "t": 20.