motion/hf/assets/long\mim-oppenheimer-feynman\ch07\data.js:1:window.CASE = {"topic": "mim-oppenheimer-feynman", "ch": "ch07", "dur": 111.1, "seed": 36027, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 07", "t": "THẺ TRẮNG, THẺ XANH, THẺ VÀNG"}, "acc": ["số", "khoá", "máy", "người", "thẻ", "mệt", "song", "xúc"], "lines": [{"text": "Trước đó, phòng máy chỉ chạy một bài một lúc.", "start": 0.0, "end": 2.24, "words": [{"w": "Trước", "t": 0.035, "d": 0.115}, {"w": "đó,", "t": 0.15, "d": 0.36}, {"w": "phòng", "t": 0.51, "d": 0.2}, {"w": "máy", "t": 0.71, "d": 0.075}, {"w": "chỉ", "t": 0.785, "d": 0.315}, {"w": "chạy", "t": 1.1, "d": 0.155}, {"w": "một", "t": 1.255, "d": 0.18}, {"w": "bài", "t": 1.435, "d": 0.12}, {"w": "một", "t": 1.555, "d": 0.2}, {"w": "lúc.", "t": 1.755, "d": 0.31}]}, {"text": "Xấp thẻ phải đi hết vòng máy này, rồi mới tới vòng sau.", "start": 3.04, "end": 6.0, "words": [{"w": "Xấp", "t": 3.11, "d": 0.14}, {"w": "thẻ", "t": 3.25, "d": 0.31}, {"w": "phải", "t": 3.56, "d": 0.135}, {"w": "đi", "t": 3.695, "d": 0.255}, {"w": "hết", "t": 3.95, "d": 0.055}, {"w": "vòng", "t": 4.005, "d": 0.28}, {"w": "máy", "t": 4.285, "d": 0.235}, {"w": "này,", "t": 4.52, "d": 0.27}, {"w": "rồi", "t": 4.79, "d": 0.055}, {"w": "mới", "t": 4.845, "d": 0.19}, {"w": "tới", "t": 5.035, "d": 0.23}, {"w": "vòng", "t": 5.265, "d": 0.185}, {"w": "sau.", "t": 5.45, "d": 0.36}]}, {"text": "Nghĩa là lúc xấp thẻ nằm ở máy nhân, thì máy cộng ngồi chơi.", "start": 6.32, "end": 9.52, "words": [{"w": "Nghĩa", "t": 6.32, "d": 0.105}, {"w": "là", "t": 6.425, "d": 0.295}, {"w": "lúc", "t": 6.72, "d": 0.21}, {"w": "xấp", "t": 6.93, "d": 0.27}, {"w": "thẻ", "t": 7.2, "d": 0.165}, {"w": "nằm", "t": 7.365, "d": 0.125}, {"w": "ở", "t": 7.49, "d": 0.14}, {"w": "máy", "t": 7.63, "d": 0.365}, {"w": "nhân,", "t": 7.995, "d": 0.235}, {"w": "thì", "t": 8.23, "d": 0.105}, {"w": "máy", "t": 8.335, "d": 0.375}, {"w": "cộng", "t": 8.71, "d": 0.135}, {"w": "ngồi", "t": 8.845, "d": 0.225}, {"w": "chơi.", "t": 9.07, "d": 0.275}]}, {"text": "Theo nghiên cứu của Los Alamos, chính những cậu lính nghĩ ra một mẹo rất đơn giản: tô màu thẻ.", "start": 10.52, "end": 15.4, "words": [{"w": "Theo", "t": 10.575, "d": 0.29}, {"w": "nghiên", "t": 10.865, "d": 0.225}, {"w": "cứu", "t": 11.09, "d": 0.06}, {"w": "của", "t": 11.15, "d": 0.345}, {"w": "Los", "t": 11.495, "d": 0.06}, {"w": "Alamos,", "t": 11.555, "d": 0.515}, {"w": "chính", "t": 12.07, "d": 0.21}, {"w": "những", "t": 12.28, "d": 0.075}, {"w": "cậu", "t": 12.355, "d": 0.355}, {"w": "lính", "t": 12.71, "d": 0.06}, {"w": "nghĩ", "t": 12.77, "d": 0.365}, {"w": "ra", "t": 13.135, "d": 0.11}, {"w": "một", "t": 13.245, "d": 0.315}, {"w": "mẹo", "t": 13.56, "d": 0.215}, {"w": "rất", "t": 13.775, "d": 0.07}, {"w": "đơn", "t": 13.845, "d": 0.315}, {"w": "giản:", "t": 14.16, "d": 0.38}, {"w": "tô", "t": 14.54, "d": 0.09}, {"w": "màu", "t": 14.63, "d": 0.2}, {"w": "thẻ.", "t": 14.83, "d": 0.39}]}, {"text": "Mỗi bài một màu.", "start": 15.72, "end": 16.68, "words": [{"w": "Mỗi", "t": 15.78, "d": 0.16}, {"w": "bài", "t": 15.94, "d": 0.175}, {"w": "một", "t": 16.115, "d": 0.125}, {"w": "màu.", "t": 16.24, "d": 0.205}]}, {"text": "Hai, ba bài cùng chạy trong một phòng, lệch nhịp nhau.", "start": 17.0, "end": 19.64, "words": [{"w": "Hai,", "t": 17.045, "d": 0.38}, {"w": "ba", "t": 17.425, "d": 0.185}, {"w": "bài", "t": 17.61, "d": 0.185}, {"w": "cùng", "t": 17.795, "d": 0.18}, {"w": "chạy", "t": 17.975, "d": 0.105}, {"w": "trong", "t": 18.08, "d": 0.21}, {"w": "một", "t": 18.29, "d": 0.26}, {"w": "phòng,", "t": 18.55, "d": 0.2}, {"w": "lệch", "t": 18.75, "d": 0.25}, {"w": "nhịp", "t": 19.0, "d": 0.13}, {"w": "nhau.", "t": 19.13, "d": 0.32}]}, {"text": "Lúc bài màu này ở máy nhân, bài màu kia đang ở máy cộng.", "start": 19.96, "end": 23.0, "words": [{"w": "Lúc", "t": 20.005, "d": 0.125}, {"w": "bài", "t": 20.13, "d": 0.21}, {"w": "màu", "t": 20.34, "d": 0.15}, {"w": "này", "t": 20.49, "d": 0.205}, {"w": "ở", "t": 20.695, "d": 0.14}, {"w": "máy", "t": 20.835, "d": 0.335}, {"w": "nhân,", "t": 21.17, "d": 0.3}, {"w": "bài", "t": 21.47, "d": 0.08}, {"w": "màu", "t": 21.55, "d": 0.24}, {"w": "kia", "t": 21.79, "d": 0.2}, {"w": "đang", "t": 21.99, "d": 0.195}, {"w": "ở", "t": 22.185, "d": 0.14}, {"w": "máy", "t": 22.325, "d": 0.155}, {"w": "cộng.", "t": 22.48, "d": 0.31}]}, {"text": "Không máy nào phải đứng chờ.", "start": 23.32, "end": 24.52, "words": [{"w": "Không", "t": 23.32, "d": 0.145}, {"w": "máy", "t": 23.465, "d": 0.145}, {"w": "nào", "t": 23.61, "d": 0.225}, {"w": "phải", "t": 23.835, "d": 0.11}, {"w": "đứng", "t": 23.945, "d": 0.15}, {"w": "chờ.", "t": 24.095, "d": 0.225}]}, {"text": "Nhờ vậy, thời gian cho một bài giảm từ ba tháng xuống chừng ba tuần.", "start": 25.52, "end": 29.04, "words": [{"w": "Nhờ", "t": 25.52, "d": 0.29}, {"w": "vậy,", "t": 25.81, "d": 0.26}, {"w": "thời", "t": 26.07, "d": 0.095}, {"w": "gian", "t": 26.165, "d": 0.35}, {"w": "cho", "t": 26.515, "d": 0.24}, {"w": "một", "t": 26.755, "d": 0.055}, {"w": "bài", "t": 26.81, "d": 0.235}, {"w": "giảm", "t": 27.045, "d": 0.325}, {"w": "từ", "t": 27.37, "d": 0.21}, {"w": "ba", "t": 27.58, "d": 0.055}, {"w": "tháng", "t": 27.635, "d": 0.18}, {"w": "xuống", "t": 27.815, "d": 0.38}, {"w": "chừng", "t": 28.195, "d": 0.095}, {"w": "ba", "t": 28.29, "d": 0.16}, {"w": "tuần.", "t": 28.45, "d": 0.4}]}, {"text": "Feynman thì nhớ theo kiểu dễ khoe hơn.", "start": 29.36, "end": 31.6, "words": [{"w": "Feynman", "t": 29.42, "d": 0.12}, {"w": "thì", "t": 29.54, "d": 0.255}, {"w": "nhớ", "t": 29.795, "d": 0.35}, {"w": "theo", "t": 30.145, "d": 0.155}, {"w": "kiểu", "t": 30.3, "d": 0.34}, {"w": "dễ", "t": 30.64, "d": 0.095}, {"w": "khoe", "t": 30.735, "d": 0.32}, {"w": "hơn.", "t": 31.055, "d": 0.305}]}, {"text": "Trước kia chín tháng được ba bài, giờ ba tháng được chín bài.", "start": 31.92, "end": 34.96, "words": [{"w": "Trước", "t": 31.965, "d": 0.135}, {"w": "kia", "t": 32.1, "d": 0.22}, {"w": "chín", "t": 32.32, "d": 0.19}, {"w": "tháng", "t": 32.51, "d": 0.26}, {"w": "được", "t": 32.77, "d": 0.15}, {"w": "ba", "t": 32.92, "d": 0.32}, {"w": "bài,", "t": 33.24, "d": 0.315}, {"w": "giờ", "t": 33.555, "d": 0.06}, {"w": "ba", "t": 33.615, "d": 0.185}, {"w": "tháng", "t": 33.8, "d": 0.18}, {"w": "được", "t": 33.98, "d": 0.37}, {"w": "chín", "t": 34.35, "d": 0.06}, {"w": "bài.", "t": 34.41, "d": 0.375}]}, {"text": "Nhanh gần gấp mười.", "start": 35.28, "end": 36.24, "words": [{"w": "Nhanh", "t": 35.355, "d": 0.16}, {"w": "gần", "t": 35.515, "d": 0.15}, {"w": "gấp", "t": 35.665, "d": 0.105}, {"w": "mười.", "t": 35.77, "d": 0.3}]}, {"text": "Một nhà nghiên cứu khác của Los Alamos đếm lại theo hồ sơ.", "start": 37.24, "end": 40.44, "words": [{"w": "Một", "t": 37.24, "d": 0.12}, {"w": "nhà", "t": 37.36, "d": 0.305}, {"w": "nghiên", "t": 37.665, "d": 0.325}, {"w": "cứu", "t": 37.99, "d": 0.06}, {"w": "khác", "t": 38.05, "d": 0.335}, {"w": "của", "t": 38.385, "d": 0.07}, {"w": "Los", "t": 38.455, "d": 0.41}, {"w": "Alamos", "t": 38.865, "d": 0.145}, {"w": "đếm", "t": 39.01, "d": 0.295}, {"w": "lại", "t": 39.305, "d": 0.06}, {"w": "theo", "t": 39.365, "d": 0.365}, {"w": "hồ", "t": 39.73, "d": 0.17}, {"w": "sơ.", "t": 39.9, "d": 0.32}]}, {"text": "Từ tháng 4 tới tháng 7 năm 1945, nhóm làm xong mười hai bài.", "start": 40.76, "end": 44.76, "words": [{"w": "Từ", "t": 40.81, "d": 0.15}, {"w": "tháng", "t": 40.96, "d": 0.155}, {"w": "4", "t": 41.115, "d": 0.29}, {"w": "tới", "t": 41.405, "d": 0.115}, {"w": "tháng", "t": 41.52, "d": 0.15}, {"w": "7", "t": 41.67, "d": 0.2}, {"w": "năm", "t": 41.87, "d": 0.205}, {"w": "1945,", "t": 42.075, "d": 1.3}, {"w": "nhóm", "t": 43.375, "d": 0.215}, {"w": "làm", "t": 43.59, "d": 0.26}, {"w": "xong", "t": 43.85, "d": 0.14}, {"w": "mười", "t": 43.99, "d": 0.21}, {"w": "hai", "t": 44.2, "d": 0.155}, {"w": "bài.", "t": 44.355, "d": 0.24}]}, {"text": "Hai cách đếm khác nhau, nhưng cùng chỉ về một hướng.", "start": 45.08, "end": 47.48, "words": [{"w": "Hai", "t": 45.08, "d": 0.195}, {"w": "cách", "t": 45.275, "d": 0.175}, {"w": "đếm", "t": 45.45, "d": 0.115}, {"w": "khác", "t": 45.565, "d": 0.31}, {"w": "nhau,", "t": 45.875, "d": 0.24}, {"w": "nhưng", "t": 46.115, "d": 0.23}, {"w": "cùng", "t": 46.345, "d": 0.18}, {"w": "chỉ", "t": 46.525, "d": 0.185}, {"w": "về", "t": 46.71, "d": 0.16}, {"w": "một", "t": 46.87, "d": 0.135}, {"w": "hướng.", "t": 47.005, "d": 0.28}]}, {"text": "Cạch, số thứ hai.", "start": 48.48, "end": 49.84, "words": [{"w": "Cạch,", "t": 48.53, "d": 0.405}, {"w": "số", "t": 48.935, "d": 0.09}, {"w": "thứ", "t": 49.025, "d": 0.235}, {"w": "hai.", "t": 49.26, "d": 0.395}]}, {"text": "Chạy nhiều việc cùng lúc, lệch nhịp nhau, để không cỗ máy nào đứng không.", "start": 50.16, "end": 53.6, "words": [{"w": "Chạy", "t": 50.16, "d": 0.11}, {"w": "nhiều", "t": 50.27, "d": 0.25}, {"w": "việc", "t": 50.52, "d": 0.16}, {"w": "cùng", "t": 50.68, "d": 0.32}, {"w": "lúc,", "t": 51.0, "d": 0.215}, {"w": "lệch", "t": 51.215, "d": 0.25}, {"w": "nhịp", "t": 51.465, "d": 0.145}, {"w": "nhau,", "t": 51.61, "d": 0.425}, {"w": "để", "t": 52.035, "d": 0.11}, {"w": "không", "t": 52.145, "d": 0.11}, {"w": "cỗ", "t": 52.255, "d": 0.2}, {"w": "máy", "t": 52.455, "d": 0.19}, {"w": "nào", "t": 52.645, "d": 0.315}, {"w": "đứng", "t": 52.96, "d": 0.175}, {"w": "không.", "t": 53.135, "d": 0.3}]}, {"text": "Ngày nay, người ta gọi đó là tính song song.", "start": 53.92, "end": 56.48, "words": [{"w": "Ngày", "t": 53.92, "d": 0.305}, {"w": "nay,", "t": 54.225, "d": 0.335}, {"w": "người", "t": 54.56, "d": 0.065}, {"w": "ta", "t": 54.625, "d": 0.25}, {"w": "gọi", "t": 54.875, "d": 0.33}, {"w": "đó", "t": 55.205, "d": 0.185}, {"w": "là", "t": 55.39, "d": 0.245}, {"w": "tính", "t": 55.635, "d": 0.06}, {"w": "song", "t": 55.695, "d": 0.215}, {"w": "song.", "t": 55.91, "d": 0.405}]}, {"text": "Và để ý nhé, số thứ hai không đến từ phòng của các nhà vật lý.", "start": 56.8, "end": 59.84, "words": [{"w": "Và", "t": 56.8, "d": 0.09}, {"w": "để", "t": 56.89, "d": 0.185}, {"w": "ý", "t": 57.075, "d": 0.275}, {"w": "nhé,", "t": 57.35, "d": 0.145}, {"w": "số", "t": 57.495, "d": 0.16}, {"w": "thứ", "t": 57.655, "d": 0.2}, {"w": "hai", "t": 57.855, "d": 0.17}, {"w": "không", "t": 58.025, "d": 0.23}, {"w": "đến", "t": 58.255, "d": 0.175}, {"w": "từ", "t": 58.43, "d": 0.2}, {"w": "phòng", "t": 58.63, "d": 0.11}, {"w": "của", "t": 58.74, "d": 0.22}, {"w": "các", "t": 58.96, "d": 0.155}, {"w": "nhà", "t": 59.115, "d": 0.18}, {"w": "vật", "t": 59.295, "d": 0.12}, {"w": "lý.", "t": 59.415, "d": 0.245}]}, {"text": "Nó đến từ những người vừa được cho biết mình đang tính gì.", "start": 60.16, "end": 63.04, "words": [{"w": "Nó", "t": 60.16, "d": 0.275}, {"w": "đến", "t": 60.435, "d": 0.155}, {"w": "từ", "t": 60.59, "d": 0.09}, {"w": "những", "t": 60.68, "d": 0.25}, {"w": "người", "t": 60.93, "d": 0.3}, {"w": "vừa", "t": 61.23, "d": 0.165}, {"w": "được", "t": 61.395, "d": 0.23}, {"w": "cho", "t": 61.625, "d": 0.195}, {"w": "biết", "t": 61.82, "d": 0.185}, {"w": "mình", "t": 62.005, "d": 0.07}, {"w": "đang", "t": 62.075, "d": 0.325}, {"w": "tính", "t": 62.4, "d": 0.165}, {"w": "gì.", "t": 62.565, "d": 0.27}]}, {"text": "Cuối năm 1944, máy cũng mạnh lên.", "start": 64.04, "end": 66.92, "words": [{"w": "Cuối", "t": 64.075, "d": 0.18}, {"w": "năm", "t": 64.255, "d": 0.15}, {"w": "1944,", "t": 64.405, "d": 1.46}, {"w": "máy", "t": 65.865, "d": 0.095}, {"w": "cũng", "t": 65.96, "d": 0.255}, {"w": "mạnh", "t": 66.215, "d": 0.28}, {"w": "lên.", "t": 66.495, "d": 0.22}]}, {"text": "Johnston, người thợ IBM, gợi ý dùng một kiểu máy nhân mới, nhân được ba số một lần.", "start": 67.24, "end": 72.28, "words": [{"w": "Johnston,", "t": 67.43, "d": 0.25}, {"w": "người", "t": 67.68, "d": 0.365}, {"w": "thợ", "t": 68.045, "d": 0.2}, {"w": "IBM,", "t": 68.245, "d": 0.62}, {"w": "gợi", "t": 68.865, "d": 0.355}, {"w": "ý", "t": 69.22, "d": 0.2}, {"w": "dùng", "t": 69.42, "d": 0.065}, {"w": "một", "t": 69.485, "d": 0.345}, {"w": "kiểu", "t": 69.83, "d": 0.135}, {"w": "máy", "t": 69.965, "d": 0.25}, {"w": "nhân", "t": 70.215, "d": 0.19}, {"w": "mới,", "t": 70.405, "d": 0.28}, {"w": "nhân", "t": 70.685, "d": 0.32}, {"w": "được", "t": 71.005, "d": 0.16}, {"w": "ba", "t": 71.165, "d": 0.075}, {"w": "số", "t": 71.24, "d": 0.21}, {"w": "một", "t": 71.45, "d": 0.245}, {"w": "lần.", "t": 71.695, "d": 0.38}]}, {"text": "Eldred Nelson tới gặp IBM, và hãng nhận làm riêng cho Los Alamos, trong đó có hai chiếc chia được.", "start": 72.6, "end": 77.96, "words": [{"w": "Eldred", "t": 72.615, "d": 0.285}, {"w": "Nelson", "t": 72.9, "d": 0.155}, {"w": "tới", "t": 73.055, "d": 0.28}, {"w": "gặp", "t": 73.335, "d": 0.25}, {"w": "IBM,", "t": 73.585, "d": 0.785}, {"w": "và", "t": 74.37, "d": 0.22}, {"w": "hãng", "t": 74.59, "d": 0.16}, {"w": "nhận", "t": 74.75, "d": 0.085}, {"w": "làm", "t": 74.835, "d": 0.335}, {"w": "riêng", "t": 75.17, "d": 0.155}, {"w": "cho", "t": 75.325, "d": 0.27}, {"w": "Los", "t": 75.595, "d": 0.205}, {"w": "Alamos,", "t": 75.8, "d": 0.26}, {"w": "trong", "t": 76.06, "d": 0.41}, {"w": "đó", "t": 76.47, "d": 0.215}, {"w": "có", "t": 76.685, "d": 0.1}, {"w": "hai", "t": 76.785, "d": 0.34}, {"w": "chiếc", "t": 77.125, "d": 0.125}, {"w": "chia", "t": 77.25, "d": 0.285}, {"w": "được.", "t": 77.535, "d": 0.28}]}, {"text": "Trước đó, muốn chia, người ta phải tra thẻ số nghịch đảo rồi đem nhân.", "start": 78.28, "end": 81.88, "words": [{"w": "Trước", "t": 78.28, "d": 0.11}, {"w": "đó,", "t": 78.39, "d": 0.32}, {"w": "muốn", "t": 78.71, "d": 0.25}, {"w": "chia,", "t": 78.96, "d": 0.4}, {"w": "người", "t": 79.36, "d": 0.245}, {"w": "ta", "t": 79.605, "d": 0.06}, {"w": "phải", "t": 79.665, "d": 0.255}, {"w": "tra", "t": 79.92, "d": 0.17}, {"w": "thẻ", "t": 80.09, "d": 0.205}, {"w": "số", "t": 80.295, "d": 0.28}, {"w": "nghịch", "t": 80.575, "d": 0.235}, {"w": "đảo", "t": 80.81, "d": 0.06}, {"w": "rồi", "t": 80.87, "d": 0.295}, {"w": "đem", "t": 81.165, "d": 0.105}, {"w": "nhân.", "t": 81.27, "d": 0.38}]}, {"text": "Trong phòng máy ấy còn có những cái tên về sau rất nổi tiếng.", "start": 82.88, "end": 86.08, "words": [{"w": "Trong", "t": 82.93, "d": 0.115}, {"w": "phòng", "t": 83.045, "d": 0.355}, {"w": "máy", "t": 83.4, "d": 0.13}, {"w": "ấy", "t": 83.53, "d": 0.215}, {"w": "còn", "t": 83.745, "d": 0.27}, {"w": "có", "t": 84.015, "d": 0.15}, {"w": "những", "t": 84.165, "d": 0.205}, {"w": "cái", "t": 84.37, "d": 0.26}, {"w": "tên", "t": 84.63, "d": 0.18}, {"w": "về", "t": 84.81, "d": 0.06}, {"w": "sau", "t": 84.87, "d": 0.33}, {"w": "rất", "t": 85.2, "d": 0.16}, {"w": "nổi", "t": 85.36, "d": 0.26}, {"w": "tiếng.", "t": 85.62, "d": 0.26}]}, {"text": "John Kemeny, một cậu lính vận hành máy, sau này cùng tạo ra ngôn ngữ lập trình BASIC.", "start": 86.4, "end": 90.64, "words": [{"w": "John", "t": 86.405, "d": 0.21}, {"w": "Kemeny,", "t": 86.615, "d": 0.415}, {"w": "một", "t": 87.03, "d": 0.205}, {"w": "cậu", "t": 87.235, "d": 0.185}, {"w": "lính", "t": 87.42, "d": 0.06}, {"w": "vận", "t": 87.48, "d": 0.375}, {"w": "hành", "t": 87.855, "d": 0.14}, {"w": "máy,", "t": 87.995, "d": 0.395}, {"w": "sau", "t": 88.39, "d": 0.19}, {"w": "này", "t": 88.58, "d": 0.08}, {"w": "cùng", "t": 88.66, "d": 0.325}, {"w": "tạo", "t": 88.985, "d": 0.165}, {"w": "ra", "t": 89.15, "d": 0.16}, {"w": "ngôn", "t": 89.31, "d": 0.275}, {"w": "ngữ", "t": 89.585, "d": 0.235}, {"w": "lập", "t": 89.82, "d": 0.225}, {"w": "trình", "t": 90.045, "d": 0.205}, {"w": "BASIC.", "t": 90.25, "d": 0.245}]}, {"text": "Richard Hamming đùa rằng ở đây ông chỉ là người lao công của máy tính.", "start": 90.96, "end": 94.72, "words": [{"w": "Richard", "t": 91.015, "d": 0.26}, {"w": "Hamming", "t": 91.275, "d": 0.3}, {"w": "đùa", "t": 91.575, "d": 0.18}, {"w": "rằng", "t": 91.755, "d": 0.17}, {"w": "ở", "t": 91.925, "d": 0.28}, {"w": "đây", "t": 92.205, "d": 0.165}, {"w": "ông", "t": 92.37, "d": 0.275}, {"w": "chỉ", "t": 92.645, "d": 0.37}, {"w": "là", "t": 93.015, "d": 0.06}, {"w": "người", "t": 93.075, "d": 0.24}, {"w": "lao", "t": 93.315, "d": 0.41}, {"w": "công", "t": 93.725, "d": 0.24}, {"w": "của", "t": 93.965, "d": 0.235}, {"w": "máy", "t": 94.2, "d": 0.235}, {"w": "tính.", "t": 94.435, "d": 0.285}]}, {"text": "Về sau, ông làm ra loại mã tự sửa lỗi mang tên mình.", "start": 95.04, "end": 98.0, "words": [{"w": "Về", "t": 95.04, "d": 0.125}, {"w": "sau,", "t": 95.165, "d": 0.435}, {"w": "ông", "t": 95.6, "d": 0.105}, {"w": "làm", "t": 95.705, "d": 0.22}, {"w": "ra", "t": 95.925, "d": 0.26}, {"w": "loại", "t": 96.185, "d": 0.14}, {"w": "mã", "t": 96.325, "d": 0.165}, {"w": "tự", "t": 96.49, "d": 0.205}, {"w": "sửa", "t": 96.695, "d": 0.215}, {"w": "lỗi", "t": 96.91, "d": 0.13}, {"w": "mang", "t": 97.04, "d": 0.23}, {"w": "tên", "t": 97.27, "d": 0.19}, {"w": "mình.", "t": 97.46, "d": 0.31}]}, {"text": "Hamming kể, chính phòng máy này cho ông thấy một điều.", "start": 98.32, "end": 100.64, "words": [{"w": "Hamming", "t": 98.335, "d": 0.23}, {"w": "kể,", "t": 98.565, "d": 0.29}, {"w": "chính", "t": 98.855, "d": 0.075}, {"w": "phòng", "t": 98.93, "d": 0.225}, {"w": "máy", "t": 99.155, "d": 0.135}, {"w": "này", "t": 99.29, "d": 0.195}, {"w": "cho", "t": 99.485, "d": 0.205}, {"w": "ông", "t": 99.69, "d": 0.2}, {"w": "thấy", "t": 99.89, "d": 0.17}, {"w": "một", "t": 100.06, "d": 0.16}, {"w": "điều.", "t": 100.22, "d": 0.22}]}, {"text": "Những thí nghiệm không thể làm trong phòng thí nghiệm sẽ làm được bằng máy tính.", "start": 100.96, "end": 104.72, "words": [{"w": "Những", "t": 101.02, "d": 0.21}, {"w": "thí", "t": 101.23, "d": 0.15}, {"w": "nghiệm", "t": 101.38, "d": 0.245}, {"w": "không", "t": 101.625, "d": 0.225}, {"w": "thể", "t": 101.85, "d": 0.16}, {"w": "làm", "t": 102.01, "d": 0.26}, {"w": "trong", "t": 102.27, "d": 0.195}, {"w": "phòng", "t": 102.465, "d": 0.215}, {"w": "thí", "t": 102.68, "d": 0.065}, {"w": "nghiệm", "t": 102.745, "d": 0.33}, {"w": "sẽ", 