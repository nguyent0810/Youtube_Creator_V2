ng", "t": 77.33, "d": 0.355}, {"w": "vệ", "t": 77.685, "d": 0.175}, {"w": "tinh", "t": 77.86, "d": 0.2}, {"w": "thế", "t": 78.06, "d": 0.135}, {"w": "hệ", "t": 78.195, "d": 0.14}, {"w": "hai", "t": 78.335, "d": 0.265}, {"w": "đầu", "t": 78.6, "d": 0.14}, {"w": "tiên.", "t": 78.74, "d": 0.29}]}, {"text": "Loại này nhìn được tên lửa trên nền mặt đất, không cần nhìn xiên nữa.", "start": 79.56, "end": 82.76, "words": [{"w": "Loại", "t": 79.59, "d": 0.13}, {"w": "này", "t": 79.72, "d": 0.295}, {"w": "nhìn", "t": 80.015, "d": 0.14}, {"w": "được", "t": 80.155, "d": 0.11}, {"w": "tên", "t": 80.265, "d": 0.28}, {"w": "lửa", "t": 80.545, "d": 0.14}, {"w": "trên", "t": 80.685, "d": 0.14}, {"w": "nền", "t": 80.825, "d": 0.3}, {"w": "mặt", "t": 81.125, "d": 0.165}, {"w": "đất,", "t": 81.29, "d": 0.255}, {"w": "không", "t": 81.545, "d": 0.08}, {"w": "cần", "t": 81.625, "d": 0.18}, {"w": "nhìn", "t": 81.805, "d": 0.31}, {"w": "xiên", "t": 82.115, "d": 0.06}, {"w": "nữa.", "t": 82.175, "d": 0.375}]}, {"text": "Còn người ngồi ghế thì sao?", "start": 83.08, "end": 84.28, "words": [{"w": "Còn", "t": 83.09, "d": 0.1}, {"w": "người", "t": 83.19, "d": 0.245}, {"w": "ngồi", "t": 83.435, "d": 0.15}, {"w": "ghế", "t": 83.585, "d": 0.15}, {"w": "thì", "t": 83.735, "d": 0.155}, {"w": "sao?", "t": 83.89, "d": 0.18}]}, {"text": "Tướng Yuri Votintsev, khi ấy chỉ huy lực lượng phòng thủ tên lửa và vũ trụ, đích thân tới.", "start": 84.88, "end": 89.52, "words": [{"w": "Tướng", "t": 84.88, "d": 0.115}, {"w": "Yuri", "t": 84.995, "d": 0.345}, {"w": "Votintsev,", "t": 85.34, "d": 0.39}, {"w": "khi", "t": 85.73, "d": 0.225}, {"w": "ấy", "t": 85.955, "d": 0.2}, {"w": "chỉ", "t": 86.155, "d": 0.08}, {"w": "huy", "t": 86.235, "d": 0.175}, {"w": "lực", "t": 86.41, "d": 0.32}, {"w": "lượng", "t": 86.73, "d": 0.185}, {"w": "phòng", "t": 86.915, "d": 0.28}, {"w": "thủ", "t": 87.195, "d": 0.215}, {"w": "tên", "t": 87.41, "d": 0.16}, {"w": "lửa", "t": 87.57, "d": 0.16}, {"w": "và", "t": 87.73, "d": 0.33}, {"w": "vũ", "t": 88.06, "d": 0.14}, {"w": "trụ,", "t": 88.2, "d": 0.425}, {"w": "đích", "t": 88.625, "d": 0.105}, {"w": "thân", "t": 88.73, "d": 0.185}, {"w": "tới.", "t": 88.915, "d": 0.42}]}, {"text": "Theo Petrov, lúc mới đến, ông tướng hứa đề nghị khen thưởng.", "start": 89.84, "end": 93.12, "words": [{"w": "Theo", "t": 89.84, "d": 0.12}, {"w": "Petrov,", "t": 89.96, "d": 0.545}, {"w": "lúc", "t": 90.505, "d": 0.215}, {"w": "mới", "t": 90.72, "d": 0.205}, {"w": "đến,", "t": 90.925, "d": 0.21}, {"w": "ông", "t": 91.135, "d": 0.385}, {"w": "tướng", "t": 91.52, "d": 0.11}, {"w": "hứa", "t": 91.63, "d": 0.24}, {"w": "đề", "t": 91.87, "d": 0.12}, {"w": "nghị", "t": 91.99, "d": 0.23}, {"w": "khen", "t": 92.22, "d": 0.305}, {"w": "thưởng.", "t": 92.525, "d": 0.36}]}, {"text": "Rồi ông hỏi: sao cuốn nhật ký trực đúng lúc ấy lại để trống?", "start": 93.44, "end": 96.72, "words": [{"w": "Rồi", "t": 93.44, "d": 0.26}, {"w": "ông", "t": 93.7, "d": 0.235}, {"w": "hỏi:", "t": 93.935, "d": 0.305}, {"w": "sao", "t": 94.24, "d": 0.15}, {"w": "cuốn", "t": 94.39, "d": 0.11}, {"w": "nhật", "t": 94.5, "d": 0.23}, {"w": "ký", "t": 94.73, "d": 0.31}, {"w": "trực", "t": 95.04, "d": 0.21}, {"w": "đúng", "t": 95.25, "d": 0.215}, {"w": "lúc", "t": 95.465, "d": 0.065}, {"w": "ấy", "t": 95.53, "d": 0.305}, {"w": "lại", "t": 95.835, "d": 0.19}, {"w": "để", "t": 96.025, "d": 0.3}, {"w": "trống?", "t": 96.325, "d": 0.245}]}, {"text": "Petrov đáp: một tay cầm ống nghe, một tay cầm micro, lấy gì mà viết.", "start": 97.32, "end": 101.32, "words": [{"w": "Petrov", "t": 97.33, "d": 0.155}, {"w": "đáp:", "t": 97.485, "d": 0.495}, {"w": "một", "t": 97.98, "d": 0.105}, {"w": "tay", "t": 98.085, "d": 0.235}, {"w": "cầm", "t": 98.32, "d": 0.165}, {"w": "ống", "t": 98.485, "d": 0.255}, {"w": "nghe,", "t": 98.74, "d": 0.44}, {"w": "một", "t": 99.18, "d": 0.2}, {"w": "tay", "t": 99.38, "d": 0.18}, {"w": "cầm", "t": 99.56, "d": 0.11}, {"w": "micro,", "t": 99.67, "d": 0.355}, {"w": "lấy", "t": 100.025, "d": 0.38}, {"w": "gì", "t": 100.405, "d": 0.08}, {"w": "mà", "t": 100.485, "d": 0.325}, {"w": "viết.", "t": 100.81, "d": 0.295}]}, {"text": "Cuối cùng, không có khen thưởng.", "start": 102.32, "end": 104.0, "words": [{"w": "Cuối", "t": 102.32, "d": 0.105}, {"w": "cùng,", "t": 102.425, "d": 0.435}, {"w": "không", "t": 102.86, "d": 0.085}, {"w": "có", "t": 102.945, "d": 0.27}, {"w": "khen", "t": 103.215, "d": 0.135}, {"w": "thưởng.", "t": 103.35, "d": 0.405}]}, {"text": "Chỉ có một lần khiển trách, vì cuốn nhật ký.", "start": 104.32, "end": 106.8, "words": [{"w": "Chỉ", "t": 104.32, "d": 0.11}, {"w": "có", "t": 104.43, "d": 0.28}, {"w": "một", "t": 104.71, "d": 0.27}, {"w": "lần", "t": 104.98, "d": 0.185}, {"w": "khiển", "t": 105.165, "d": 0.27}, {"w": "trách,", "t": 105.435, "d": 0.31}, {"w": "vì", "t": 105.745, "d": 0.055}, {"w": "cuốn", "t": 105.8, "d": 0.265}, {"w": "nhật", "t": 106.065, "d": 0.29}, {"w": "ký.", "t": 106.355, "d": 0.27}]}, {"text": "Ông tự giải thích vì sao.", "start": 107.12, "end": 108.4, "words": [{"w": "Ông", "t": 107.17, "d": 0.19}, {"w": "tự", "t": 107.36, "d": 0.155}, {"w": "giải", "t": 107.515, "d": 0.125}, {"w": "thích", "t": 107.64, "d": 0.125}, {"w": "vì", "t": 107.765, "d": 0.19}, {"w": "sao.", "t": 107.955, "d": 0.245}]}, {"text": "Nếu thưởng cho tôi vì vụ ấy, thì phải có người chịu trận rất nặng. Trước hết là những người làm ra hệ thống cảnh báo.", "start": 108.72, "end": 114.96, "words": [{"w": "Nếu", "t": 108.845, "d": 0.17}, {"w": "thưởng", "t": 109.015, "d": 0.23}, {"w": "cho", "t": 109.245, "d": 0.175}, {"w": "tôi", "t": 109.42, "d": 0.22}, {"w": "vì", "t": 109.64, "d": 0.175}, {"w": "vụ", "t": 109.815, "d": 0.36}, {"w": "ấy,", "t": 110.175, "d": 0.245}, {"w": "thì", "t": 110.42, "d": 0.115}, {"w": "phải", "t": 110.535, "d": 0.345}, {"w": "có", "t": 110.88, "d": 0.15}, {"w": "người", "t": 111.03, "d": 0.23}, {"w": "chịu", "t": 111.26, "d": 0.21}, {"w": "trận", "t": 111.47, "d": 0.225}, {"w": "rất", "t": 111.695, "d": 0.105}, {"w": "nặng.", "t": 111.8, "d": 0.355}, {"w": "Trước", "t": 112.155, "d": 0.185}, {"w": "hết", "t": 112.34, "d": 0.185}, {"w": "là", "t": 112.525, "d": 0.335}, {"w": "những", "t": 112.86, "d": 0.225}, {"w": "người", "t": 113.085, "d": 0.08}, {"w": "làm", "t": 113.165, "d": 0.375}, {"w": "ra", "t": 113.54, "d": 0.1}, {"w": "hệ", "t": 113.64, "d": 0.315}, {"w": "thống", "t": 113.955, "d": 0.205}, {"w": "cảnh", "t": 114.16, "d": 0.21}, {"w": "báo.", "t": 114.37, "d": 0.245}]}, {"text": "Ông im lặng suốt mười năm.", "start": 115.96, "end": 117.32, "words": [{"w": "Ông", "t": 116.01, "d": 0.11}, {"w": "im", "t": 116.12, "d": 0.14}, {"w": "lặng", "t": 116.26, "d": 0.235}, {"w": "suốt", "t": 116.495, "d": 0.145}, {"w": "mười", "t": 116.64, "d": 0.24}, {"w": "năm.", "t": 116.88, "d": 0.21}]}, {"text": "Ông nói với BBC rằng ông thấy xấu hổ cho quân đội Liên Xô, vì hệ thống đã hỏng như vậy.", "start": 117.64, "end": 122.6, "words": [{"w": "Ông", "t": 117.69, "d": 0.105}, {"w": "nói", "t": 117.795, "d": 0.22}, {"w": "với", "t": 118.015, "d": 0.29}, {"w": "BBC", "t": 118.305, "d": 0.63}, {"w": "rằng", "t": 118.935, "d": 0.185}, {"w": "ông", "t": 119.12, "d": 0.06}, {"w": "thấy", "t": 119.18, "d": 0.21}, {"w": "xấu", "t": 119.39, "d": 0.195}, {"w": "hổ", "t": 119.585, "d": 0.32}, {"w": "cho", "t": 119.905, "d": 0.175}, {"w": "quân", "t": 120.08, "d": 0.16}, {"w": "đội", "t": 120.24, "d": 0.175}, {"w": "Liên", "t": 120.415, "d": 0.19}, {"w": "Xô,", "t": 120.605, "d": 0.38}, {"w": "vì", "t": 120.985, "d": 0.165}, {"w": "hệ", "t": 121.15, "d": 0.09}, {"w": "thống", "t": 121.24, "d": 0.33}, {"w": "đã", "t": 121.57, "d": 0.06}, {"w": "hỏng", "t": 121.63, "d": 0.28}, {"w": "như", "t": 121.91, "d": 0.13}, {"w": "vậy.", "t": 122.04, "d": 0.345}]}, {"text": "Vài tháng sau đêm ấy, ông rời quân ngũ, và nhấn mạnh là tự xin đi, không bị ai đuổi.", "start": 122.92, "end": 127.32, "words": [{"w": "Vài", "t": 122.92, "d": 0.115}, {"w": "tháng", "t": 123.035, "d": 0.21}, {"w": "sau", "t": 123.245, "d": 0.215}, {"w": "đêm", "t": 123.46, "d": 0.28}, {"w": "ấy,", "t": 123.74, "d": 0.175}, {"w": "ông", "t": 123.915, "d": 0.195}, {"w": "rời", "t": 124.11, "d": 0.175}, {"w": "quân", "t": 124.285, "d": 0.15}, {"w": "ngũ,", "t": 124.435, "d": 0.45}, {"w": "và", "t": 124.885, "d": 0.105}, {"w": "nhấn", "t": 124.99, "d": 0.275}, {"w": "mạnh", "t": 125.265, "d": 0.185}, {"w": "là", "t": 125.45, "d": 0.06}, {"w": "tự", "t": 125.51, "d": 0.205}, {"w": "xin", "t": 125.715, "d": 0.17}, {"w": "đi,", "t": 125.885, "d": 0.425}, {"w": "không", "t": 126.31, "d": 0.175}, {"w": "bị", "t": 126.485, "d": 0.06}, {"w": "ai", "t": 126.545, "d": 0.27}, {"w": "đuổi.", "t": 126.815, "d": 0.275}]}, {"text": "Trong khi Petrov còn bị hỏi về cuốn nhật ký, thế giới bước vào tháng 11.", "start": 127.64, "end": 131.4, "words": [{"w": "Trong", "t": 127.64, "d": 0.11}, {"w": "khi", "t": 127.75, "d": 0.205}, {"w": "Petrov", "t": 127.955, "d": 0.22}, {"w": "còn", "t": 128.175, "d": 0.235}, {"w": "bị", "t": 128.41, "d": 0.18}, {"w": "hỏi", "t": 128.59, "d": 0.165}, {"w": "về", "t": 128.755, "d": 0.29}, {"w": "cuốn", "t": 129.045, "d": 0.205}, {"w": "nhật", "t": 129.25, "d": 0.14}, {"w": "ký,", "t": 129.39, "d": 0.25}, {"w": "thế", "t": 129.64, "d": 0.375}, {"w": "giới", "t": 130.015, "d": 0.095}, {"w": "bước", "t": 130.11, "d": 0.25}, {"w": "vào", "t": 130.36, "d": 0.245}, {"w": "tháng", "t": 130.605, "d": 0.2}, {"w": "11.", "t": 130.805, "d": 0.43}]}, {"text": "Và một lần nữa, có người ở giữa vòng lặp phải chọn.", "start": 131.72, "end": 134.2, "words": [{"w": "Và", "t": 131.72, "d": 0.095}, {"w": "một", "t": 131.815, "d": 0.225}, {"w": "lần", "t": 132.04, "d": 0.27}, {"w": "nữa,", "t": 132.31, "d": 0.2}, {"w": "có", "t": 132.51, "d": 0.1}, {"w": "người", "t": 132.61, "d": 0.31}, {"w": "ở", "t": 132.92, "d": 0.185}, {"w": "giữa", "t": 133.105, "d": 0.15}, {"w": "vòng", "t": 133.255, "d": 0.12}, {"w": "lặp", "t": 133.375, "d": 0.205}, {"w": "phải", "t": 133.58, "d": 0.225}, {"w": "chọn.", "t": 133.805, "d": 0.205}]}], "imgs": {"serp": {"src": "assets/long/mim-ke-huy-diet-petrov/img/serp.jpg", "w": 500, "h": 261, "lic": "Public domain", "by": "Imagery from LANCE FIRMS operated by NASA's Earth Science Data and Information System (ESDIS) with funding provided by N", "pd": true}, "mm3": {"src": "assets/long/mim-ke-huy-diet-petrov/img/mm3.jpg", "w": 1920, "h": 1281, "lic": "Public domain", "by": "U.S. Space Force photo by [null Courtesy]", "pd": true}, "mmsilo": {"src": "assets/long/mim-ke-huy-diet-petrov/img/mmsilo.jpg", "w": 1920, "h": 1327, "lic": "Public domain", "by": "", "pd": true}, "norad84": {"src": "assets/long/mim-ke-huy-diet-petrov/img/norad84.jpg", "w": 1615, "h": 2400, "lic": "Public domain", "by": "Staff Sgt. Bob Simons", "pd": true}, "cheyenne68": {"src": "assets/long/mim-ke-huy-diet-petrov/img/cheyenne68.jpg", "w": 1903, "h": 2400, "lic": "Public domain", "by": "", "pd": true}, "molniya": {"src": "assets/long/mim-ke-huy-diet-petrov/img/molniya.jpg", "w": 330, "h": 330, "lic": "Public domain", "by": "NASA", "pd": true}, "dsp": {"src": "assets/long/mim-ke-huy-diet-petrov/img/dsp.jpg", "w": 500, "h": 550, "lic": "Public domain", "by": "USAF", "pd": true}, "brown": {"src": "assets/long/mim-ke-huy-diet-petrov/img/brown.jpg", "w": 1886, "h": 2400, "lic": "Public domain", "by": "", "pd": true}, "reagan": {"src": "assets/long/mim-ke-huy-diet-petrov/img/reagan.jpg", "w": 1280, "h": 1574, "lic": "Public domain", "by": "Series: Reagan White House Photographs, 1/20/1981 - 1/20/1989\n\nCollection: White House Photographic Collection, 1/20/198", "pd": true}, "e4b": {"src": "assets/long/mim-ke-huy-diet-petrov/img/e4b.jpg", "w": 1280, "h": 677, "lic": "Public domain", "by": "", "pd": true}, "namerica": {"src": "assets/long/mim-ke-huy-diet-petrov/img/namerica.jpg", "w": 1920, "h": 1920, "lic": "Public domain", "by": "NASA/NOAA/GSFC/Suomi NPP/VIIRS/Norman Kuring", "pd": true}, "glint": {"src": "assets/long/mim-ke-huy-diet-petrov/img/glint.jpg", "w": 1920, "h": 1275, "lic": "