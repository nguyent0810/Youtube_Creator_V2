motion/hf/assets/long\mim-apollo-1202\ch02\data.js:1:window.CASE = {"topic": "mim-apollo-1202", "ch": "ch02", "dur": 95.42, "seed": 14034, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 02", "t": "CỖ MÁY KHÔNG BAO GIỜ LÀM MỘT VIỆC"}, "acc": ["1202", "1201", "radar", "phòng", "báo", "máy", "người", "tiếp"], "lines": [{"text": "Hạ cánh không phải một phép tính.", "start": 0.0, "end": 1.6, "words": [{"w": "Hạ", "t": 0.0, "d": 0.115}, {"w": "cánh", "t": 0.115, "d": 0.205}, {"w": "không", "t": 0.32, "d": 0.2}, {"w": "phải", "t": 0.52, "d": 0.265}, {"w": "một", "t": 0.785, "d": 0.155}, {"w": "phép", "t": 0.94, "d": 0.2}, {"w": "tính.", "t": 1.14, "d": 0.255}]}, {"text": "Là hàng chục việc chạy gần như cùng lúc.", "start": 2.4, "end": 4.24, "words": [{"w": "Là", "t": 2.54, "d": 0.13}, {"w": "hàng", "t": 2.67, "d": 0.185}, {"w": "chục", "t": 2.855, "d": 0.17}, {"w": "việc", "t": 3.025, "d": 0.18}, {"w": "chạy", "t": 3.205, "d": 0.06}, {"w": "gần", "t": 3.265, "d": 0.185}, {"w": "như", "t": 3.45, "d": 0.185}, {"w": "cùng", "t": 3.635, "d": 0.1}, {"w": "lúc.", "t": 3.735, "d": 0.29}]}, {"text": "Đọc gia tốc kế. Lái động cơ. Cập nhật màn hình cho phi hành đoàn.", "start": 4.56, "end": 8.48, "words": [{"w": "Đọc", "t": 4.615, "d": 0.305}, {"w": "gia", "t": 4.92, "d": 0.155}, {"w": "tốc", "t": 5.075, "d": 0.285}, {"w": "kế.", "t": 5.36, "d": 0.23}, {"w": "Lái", "t": 5.59, "d": 0.145}, {"w": "động", "t": 5.735, "d": 0.335}, {"w": "cơ.", "t": 6.07, "d": 0.38}, {"w": "Cập", "t": 6.45, "d": 0.18}, {"w": "nhật", "t": 6.63, "d": 0.125}, {"w": "màn", "t": 6.755, "d": 0.22}, {"w": "hình", "t": 6.975, "d": 0.22}, {"w": "cho", "t": 7.195, "d": 0.19}, {"w": "phi", "t": 7.385, "d": 0.395}, {"w": "hành", "t": 7.78, "d": 0.23}, {"w": "đoàn.", "t": 8.01, "d": 0.25}]}, {"text": "Cứ hai giây, việc dẫn đường lại tính lại một lần.", "start": 8.8, "end": 11.28, "words": [{"w": "Cứ", "t": 8.8, "d": 0.1}, {"w": "hai", "t": 8.9, "d": 0.2}, {"w": "giây,", "t": 9.1, "d": 0.4}, {"w": "việc", "t": 9.5, "d": 0.175}, {"w": "dẫn", "t": 9.675, "d": 0.075}, {"w": "đường", "t": 9.75, "d": 0.205}, {"w": "lại", "t": 9.955, "d": 0.165}, {"w": "tính", "t": 10.12, "d": 0.315}, {"w": "lại", "t": 10.435, "d": 0.125}, {"w": "một", "t": 10.56, "d": 0.205}, {"w": "lần.", "t": 10.765, "d": 0.29}]}, {"text": "Chiếc máy xử lý chúng bằng một hệ điều hành thu nhỏ, tên là Executive, nghĩa là bộ điều hành.", "start": 12.28, "end": 17.4, "words": [{"w": "Chiếc", "t": 12.28, "d": 0.32}, {"w": "máy", "t": 12.6, "d": 0.13}, {"w": "xử", "t": 12.73, "d": 0.185}, {"w": "lý", "t": 12.915, "d": 0.205}, {"w": "chúng", "t": 13.12, "d": 0.28}, {"w": "bằng", "t": 13.4, "d": 0.19}, {"w": "một", "t": 13.59, "d": 0.355}, {"w": "hệ", "t": 13.945, "d": 0.17}, {"w": "điều", "t": 14.115, "d": 0.28}, {"w": "hành", "t": 14.395, "d": 0.2}, {"w": "thu", "t": 14.595, "d": 0.15}, {"w": "nhỏ,", "t": 14.745, "d": 0.43}, {"w": "tên", "t": 15.175, "d": 0.11}, {"w": "là", "t": 15.285, "d": 0.25}, {"w": "Executive,", "t": 15.535, "d": 0.48}, {"w": "nghĩa", "t": 16.015, "d": 0.095}, {"w": "là", "t": 16.11, "d": 0.155}, {"w": "bộ", "t": 16.265, "d": 0.395}, {"w": "điều", "t": 16.66, "d": 0.225}, {"w": "hành.", "t": 16.885, "d": 0.295}]}, {"text": "Nó xếp hàng các việc theo mức ưu tiên.", "start": 17.72, "end": 19.56, "words": [{"w": "Nó", "t": 17.72, "d": 0.21}, {"w": "xếp", "t": 17.93, "d": 0.06}, {"w": "hàng", "t": 17.99, "d": 0.28}, {"w": "các", "t": 18.27, "d": 0.195}, {"w": "việc", "t": 18.465, "d": 0.06}, {"w": "theo", "t": 18.525, "d": 0.205}, {"w": "mức", "t": 18.73, "d": 0.24}, {"w": "ưu", "t": 18.97, "d": 0.17}, {"w": "tiên.", "t": 19.14, "d": 0.195}]}, {"text": "Cứ hai mươi phần nghìn giây, nó nhìn lại xem có việc nào quan trọng hơn không.", "start": 19.88, "end": 23.48, "words": [{"w": "Cứ", "t": 19.9, "d": 0.125}, {"w": "hai", "t": 20.025, "d": 0.275}, {"w": "mươi", "t": 20.3, "d": 0.095}, {"w": "phần", "t": 20.395, "d": 0.2}, {"w": "nghìn", "t": 20.595, "d": 0.285}, {"w": "giây,", "t": 20.88, "d": 0.255}, {"w": "nó", "t": 21.135, "d": 0.075}, {"w": "nhìn", "t": 21.21, "d": 0.18}, {"w": "lại", "t": 21.39, "d": 0.345}, {"w": "xem", "t": 21.735, "d": 0.085}, {"w": "có", "t": 21.82, "d": 0.235}, {"w": "việc", "t": 22.055, "d": 0.13}, {"w": "nào", "t": 22.185, "d": 0.14}, {"w": "quan", "t": 22.325, "d": 0.24}, {"w": "trọng", "t": 22.565, "d": 0.14}, {"w": "hơn", "t": 22.705, "d": 0.185}, {"w": "không.", "t": 22.89, "d": 0.335}]}, {"text": "Có thì việc đang chạy phải nhường.", "start": 23.8, "end": 25.4, "words": [{"w": "Có", "t": 23.8, "d": 0.135}, {"w": "thì", "t": 23.935, "d": 0.305}, {"w": "việc", "t": 24.24, "d": 0.14}, {"w": "đang", "t": 24.38, "d": 0.23}, {"w": "chạy", "t": 24.61, "d": 0.185}, {"w": "phải", "t": 24.795, "d": 0.06}, {"w": "nhường.", "t": 24.855, "d": 0.34}]}, {"text": "Nhưng bộ nhớ ghi được quá ít.", "start": 26.4, "end": 28.0, "words": [{"w": "Nhưng", "t": 26.4, "d": 0.105}, {"w": "bộ", "t": 26.505, "d": 0.175}, {"w": "nhớ", "t": 26.68, "d": 0.235}, {"w": "ghi", "t": 26.915, "d": 0.295}, {"w": "được", "t": 27.21, "d": 0.185}, {"w": "quá", "t": 27.395, "d": 0.055}, {"w": "ít.", "t": 27.45, "d": 0.345}]}, {"text": "Nên không việc nào được có chỗ riêng.", "start": 28.32, "end": 30.08, "words": [{"w": "Nên", "t": 28.32, "d": 0.15}, {"w": "không", "t": 28.47, "d": 0.18}, {"w": "việc", "t": 28.65, "d": 0.15}, {"w": "nào", "t": 28.8, "d": 0.3}, {"w": "được", "t": 29.1, "d": 0.175}, {"w": "có", "t": 29.275, "d": 0.055}, {"w": "chỗ", "t": 29.33, "d": 0.15}, {"w": "riêng.", "t": 29.48, "d": 0.36}]}, {"text": "Mỗi việc khi bắt đầu được cấp một \"phòng\" gồm mười hai ô nhớ.", "start": 30.4, "end": 32.96, "words": [{"w": "Mỗi", "t": 30.435, "d": 0.16}, {"w": "việc", "t": 30.595, "d": 0.135}, {"w": "khi", "t": 30.73, "d": 0.155}, {"w": "bắt", "t": 30.885, "d": 0.11}, {"w": "đầu", "t": 30.995, "d": 0.285}, {"w": "được", "t": 31.28, "d": 0.135}, {"w": "cấp", "t": 31.415, "d": 0.055}, {"w": "một", "t": 31.47, "d": 0.155}, {"w": "\"phòng\"", "t": 31.625, "d": 0.265}, {"w": "gồm", "t": 31.89, "d": 0.14}, {"w": "mười", "t": 32.03, "d": 0.06}, {"w": "hai", "t": 32.09, "d": 0.175}, {"w": "ô", "t": 32.265, "d": 0.255}, {"w": "nhớ.", "t": 32.52, "d": 0.2}]}, {"text": "Xong việc thì trả phòng, mà cả máy chỉ có tám phòng.", "start": 33.28, "end": 36.16, "words": [{"w": "Xong", "t": 33.28, "d": 0.145}, {"w": "việc", "t": 33.425, "d": 0.2}, {"w": "thì", "t": 33.625, "d": 0.325}, {"w": "trả", "t": 33.95, "d": 0.2}, {"w": "phòng,", "t": 34.15, "d": 0.295}, {"w": "mà", "t": 34.445, "d": 0.07}, {"w": "cả", "t": 34.515, "d": 0.23}, {"w": "máy", "t": 34.745, "d": 0.155}, {"w": "chỉ", "t": 34.9, "d": 0.26}, {"w": "có", "t": 35.16, "d": 0.175}, {"w": "tám", "t": 35.335, "d": 0.16}, {"w": "phòng.", "t": 35.495, "d": 0.395}]}, {"text": "Một kỹ sư MIT nhớ lại, có những ô nhớ phải gánh tới bảy việc khác nhau, ở những lúc khác nhau.", "start": 36.48, "end": 41.92, "words": [{"w": "Một", "t": 36.48, "d": 0.115}, {"w": "kỹ", "t": 36.595, "d": 0.205}, {"w": "sư", "t": 36.8, "d": 0.38}, {"w": "MIT", "t": 37.18, "d": 0.61}, {"w": "nhớ", "t": 37.79, "d": 0.2}, {"w": "lại,", "t": 37.99, "d": 0.165}, {"w": "có", "t": 38.155, "d": 0.19}, {"w": "những", "t": 38.345, "d": 0.3}, {"w": "ô", "t": 38.645, "d": 0.205}, {"w": "nhớ", "t": 38.85, "d": 0.265}, {"w": "phải", "t": 39.115, "d": 0.16}, {"w": "gánh", "t": 39.275, "d": 0.22}, {"w": "tới", "t": 39.495, "d": 0.2}, {"w": "bảy", "t": 39.695, "d": 0.25}, {"w": "việc", "t": 39.945, "d": 0.135}, {"w": "khác", "t": 40.08, "d": 0.14}, {"w": "nhau,", "t": 40.22, "d": 0.465}, {"w": "ở", "t": 40.685, "d": 0.13}, {"w": "những", "t": 40.815, "d": 0.105}, {"w": "lúc", "t": 40.92, "d": 0.27}, {"w": "khác", "t": 41.19, "d": 0.18}, {"w": "nhau.", "t": 41.37, "d": 0.365}]}, {"text": "Vậy nếu có việc xin phòng, mà phòng đã hết thì sao?", "start": 42.92, "end": 45.56, "words": [{"w": "Vậy", "t": 42.97, "d": 0.25}, {"w": "nếu", "t": 43.22, "d": 0.145}, {"w": "có", "t": 43.365, "d": 0.13}, {"w": "việc", "t": 43.495, "d": 0.19}, {"w": "xin", "t": 43.685, "d": 0.28}, {"w": "phòng,", "t": 43.965, "d": 0.295}, {"w": "mà", "t": 44.26, "d": 0.06}, {"w": "phòng", "t": 44.32, "d": 0.25}, {"w": "đã", "t": 44.57, "d": 0.19}, {"w": "hết", "t": 44.76, "d": 0.13}, {"w": "thì", "t": 44.89, "d": 0.155}, {"w": "sao?", "t": 45.045, "d": 0.355}]}, {"text": "Hãy nhớ câu hỏi này.", "start": 46.16, "end": 47.28, "words": [{"w": "Hãy", "t": 46.195, "d": 0.145}, {"w": "nhớ", "t": 46.34, "d": 0.215}, {"w": "câu", "t": 46.555, "d": 0.145}, {"w": "hỏi", "t": 46.7, "d": 0.15}, {"w": "này.", "t": 46.85, "d": 0.18}]}, {"text": "Các kỹ sư còn biết một điều: không được để máy chết giữa lúc đang đốt động cơ.", "start": 48.28, "end": 52.12, "words": [{"w": "Các", "t": 48.28, "d": 0.11}, {"w": "kỹ", "t": 48.39, "d": 0.195}, {"w": "sư", "t": 48.585, "d": 0.2}, {"w": "còn", "t": 48.785, "d": 0.27}, {"w": "biết", "t": 49.055, "d": 0.18}, {"w": "một", "t": 49.235, "d": 0.265}, {"w": "điều:", "t": 49.5, "d": 0.3}, {"w": "không", "t": 49.8, "d": 0.06}, {"w": "được", "t": 49.86, "d": 0.155}, {"w": "để", "t": 50.015, "d": 0.2}, {"w": "máy", "t": 50.215, "d": 0.225}, {"w": "chết", "t": 50.44, "d": 0.215}, {"w": "giữa", "t": 50.655, "d": 0.16}, {"w": "lúc", "t": 50.815, "d": 0.22}, {"w": "đang", "t": 51.035, "d": 0.195}, {"w": "đốt", "t": 51.23, "d": 0.255}, {"w": "động", "t": 51.485, "d": 0.22}, {"w": "cơ.", "t": 51.705, "d": 0.225}]}, {"text": "Nên họ viết riêng một phần khởi động lại.", "start": 52.44, "end": 55.0, "words": [{"w": "Nên", "t": 52.44, "d": 0.12}, {"w": "họ", "t": 52.56, "d": 0.31}, {"w": "viết", "t": 52.87, "d": 0.06}, {"w": "riêng", "t": 52.93, "d": 0.19}, {"w": "một", "t": 53.12, "d": 0.21}, {"w": "phần", "t": 53.33, "d": 0.215}, {"w": "khởi", "t": 53.545, "d": 0.175}, {"w": "động", "t": 53.72, "d": 0.115}, {"w": "lại.", "t": 53.835, "d": 0.31}]}, {"text": "Gặp sự cố, máy xoá sạch mọi lệnh đang phát ra ngoài: động cơ, bộ đẩy lái, đèn báo.", "start": 55.32, "end": 60.28, "words": [{"w": "Gặp", "t": 55.32, "d": 0.115}, {"w": "sự", "t": 55.435, "d": 0.225}, {"w": "cố,", "t": 55.66, "d": 0.505}, {"w": "máy", "t": 56.165, "d": 0.06}, {"w": "xoá", "t": 56.225, "d": 0.215}, {"w": "sạch", "t": 56.44, "d": 0.245}, {"w": "mọi", "t": 56.685, "d": 0.34}, {"w": "lệnh", "t": 57.025, "d": 0.23}, {"w": "đang", "t": 57.255, "d": 0.125}, {"w": "phát", "t": 57.38, "d": 0.18}, {"w": "ra", "t": 57.56, "d": 0.35}, {"w": "ngoài:", "t": 57.91, "d": 0.345}, {"w": "động", "t": 58.255, "d": 0.215}, {"w": "cơ,", "t": 58.47, "d": 0.29}, {"w": "bộ", "t": 58.76, "d": 0.205}, {"w": "đẩy", "t": 58.965, "d": 0.135}, {"w": "lái,", "t": 59.1, "d": 0.44}, {"w": "đèn", "t": 59.54, "d": 0.08}, {"w": "báo.", "t": 59.62, "d": 0.445}]}, {"text": "Rồi nó tra bảng, dựng lại từng việc quan trọng, chạy tiếp từ gần chỗ cũ.", "start": 60.6, "end": 64.28, "words": [{"w": "Rồi", "t": 60.6, "d": 0.21}, {"w": "nó", "t": 60.81, "d": 0.135}, {"w": "tra", "t": 60.945, "d": 0.32}, {"w": "bảng,", "t": 61.265, "d": 0.185}, {"w": "dựng", "t": 61.45, "d": 0.165}, {"w": "lại", "t": 61.615, "d": 0.25}, {"w": "từng", "t": 61.865, "d": 0.295}, {"w": "việc", "t": 62.16, "d": 0.06}, {"w": "quan", "t": 62.22, "d": 0.17}, {"w": "trọng,", "t": 62.39, "d": 0.465}, {"w": "chạy", "t": 62.855, "d": 0.205}, {"w": "tiếp", "t": 63.06, "d": 0.195}, {"w": "từ", "t": 63.255, "d": 0.06}, {"w": "gần", "t": 63.315, "d": 0.205}, {"w": "chỗ", "t": 63.52, "d": 0.315}, {"w": "cũ.", "t": 63.835, "d": 0.235}]}, {"text": "Trong một bài báo kỹ thuật năm 1975, Margaret Hamilton và đồng tác giả kể lại thiết kế này.", "start": 65.28, "end": 71.44, "words": [{"w": "Trong", "t": 65.28, "d": 0.21}, {"w": "một", "t": 65.49, "d": 0.34}, {"w": "bài", "t": 65.83, "d": 0.16}, {"w": "báo", "t": 65.99, "d": 0.19}, {"w": "kỹ", "t": 66.18, "d": 0.26}, {"w": "thuật", "t": 66.44, "d": 0.145}, {"w": "năm", "t": 66.585, "d": 0.37}, {"w": "1975,", "t": 66.955, "d": 1.605}, {"w": "Margaret", "t": 68.56, "d": 0.22}, {"w": "Hamilton", "t": 68.78, "d": 0.37}, {"w": "và", "t": 69.15, "d": 0.225}, {"w": "đồng", "t": 69.375, "d": 0.185}, {"w": "tác", "t": 69.56, "d": 0.07}, {"w": "giả", "t": 69.63, "d": 0.315}, {"w": "kể", "t": 69.945, "d": 0.145}, {"w": "lại", "t": 70.09, "d": 0.32}, {"w": "thiết", "t": 70.41, "d": 0.19}, {"w": "kế", "t": 70.6, "d": 0.295}, {"w": "này.", "t": 70.895, "d": 0.34}]}, {"text": "Phần mềm hệ thống của Apollo gồm các mô-đun chạy không đồng bộ: bộ lập lịch, mô-đun màn hình và mô-đun khởi động lại.", "start": 71.76, "end": 77.92, "words": [{"w": "Phần", "t": 71.76, "d": 0.245}, {"w": "mềm", "t": 72.005, "d": 0.21}, {"w": "hệ", "t": 72.215, "d": 0.175}, {"w": "thống", "t": 72.39, "d": 0.2}, {"w": "của", "t": 72.59, "d": 0.315}, {"w": "Apollo", "t": 72.905, "d": 0.22}, {"w": "gồm", "t": 73.125, "d": 0.14}, {"w": "các", "t": 73.265, "d": 0.24}, {"w": "mô-đun", "t": 73.505, "d": 0.415}, {"w": "chạy", "t": 73.92, "d": 0.06}, {"w": "không", "t": 73.98, "d": 0.21}, {"w": "đồng", "t": 74.19, "d": 0.315}, {"w": "bộ:", "t": 74.505, "d": 0.345}, {"w": "bộ", "t": 74.85, "d": 0.33}, {"w": "lập", "t": 75.18, "d": 0.27}, {"w": "lịch,", "t": 75.45, "d": 0.2}, {"w": "mô-đun", "t": 75.65, "d": 0.375}, {"w": "màn", "t": 76.025, "d": 0.16}, {"w": "hình", "t": 76.185, "d": 0.325}, {"w": "và", "t": 76.51, "d": 0.095}, {"w": "mô-đun", "t": 76.605, "d": 0.245}, {"w": "khởi", "t": 76.85, "d": 0.19}, {"w": "động", "t": 77.04, "d": 0.35}, {"w": "lại.", "t": 77.39, "d": 0.315}]}, {"text": "Bài báo dẫn tên Laning cho bộ lập lịch, và dẫn chính tên Hamilton cho mô-đun màn hình.", "start": 78.24, "end": 82.72, "words": [{"w": "Bài", "t": 78.24, "d": 0.315}, {"w": "báo", "t": 78.555, "d": 0.165}, {"w": "dẫn", "t": 78.72, "d": 0.13}, {"w": "tên", "t": 78.85, "d": 0.18}, {"w": "Laning", "t": 79.03, "d": 0.29}, {"w": "cho", "t": 79.32, "d": 0.195}, {"w": "bộ", "t": 79.515, "d": 0.305}, {"w": "lập", "t": 79.82, "d": 0.295}, {"w": "lịch,", "t": 80.115, "d": 0.285}, {"w": "và", "t": 80.4, "d": 0.1}, {"w": "dẫn", "t": 80.5, "d": 0.29}, {"w": "chính", "t": 80.79, "d": 0.17}, {"w": "tên", "t": 80.96, "d": 0.205}, {"w": "Hamilton", "t": 81.165, "d": 0.37}, {"w": "cho", "t": 81.535, "d": 0.195}, {"w": "mô-đun", "t": 81.73, "d": 0.135}, {"w": "màn", "t": 81.865, "d": 0.195}, {"w": "hình.", "t": 82.06, "d": 0.45}]}, {"text": "Họ viết rằng, nếu không thiết kế như vậy, ít nhất một chuyến bay Apollo đã thành thảm hoạ.", "start": 83.04, "end": 87.84, "words": [{"w": "Họ", "t": 83.04, "d": 0.21}, {"w": "viết", "t": 83.25, "d": 0.325}, {"w": "rằng,", "t": 83.575, "d": 0.27}, {"w": "nếu", "t": 83.845, "d": 0.29}, {"w": "không", "t": 84.135, "d": 0.175}, {"w": "thiết", "t": 84.31, "d": 0.12}, {"w": "kế", "t": 84.43, "d": 0.28}, {"w": "như", "t": 84.71, "d": 0.32}, {"w": "vậy,", "t": 85.03, "d": 0.165}, {"w": "ít", "t": 85.195, "d": 0.41}, {"w": "nhất", "t": 85.605, "d": 0.06}, {"w": "một", "t": 85.665, "d": 0.26}, {"w": "chuyến", "t": 85.925, "d": 0.275}, {"w": "bay", "t": 86.2, "d": 0.29}, {"w": "Apollo", "t": 86.49, "d": 0.06}, {"w": "đã", "t": 86.55, "d": 0.345}, {"w": "thành", "t": 86.895, "d": 0.17}, {"w": "thảm", "t": 87.065, "d": 0.165}, {"w": "hoạ.", "t": 87.23, "d": 0.405}]}, {"text": "Bài báo không nói đó là chuyến nào.", "start": 88.16, "end": 89.92, "words": [{"w": "Bài", "t": 88.16, "d": 0.105}, {"w": "báo", "t": 88.265, "d": 0.175}, {"w": "không", "t": 88.44, "d": 0.185}, {"w": "nói", "t": 88.625, "d": 0.29}, {"w": "đó", "t": 88.915, "d": 0.23}, {"w": "là", "t": 89.145, "d": 0.135}, {"w": "chuyến", "t": 89.28, "d": 0.075}, {"w": "nào.", "t": 89.355, "d": 0.375}]}, {"text": "Phần khởi động lại ấy sắp phải làm việc năm lần liền.", "start": 90.92, "end": 94.2, "words": [{"w": "Phần", "t": 90.92, "d": 0.14}, {"w": "khởi", "t": 91.06, "d": 0.24}, {"w": "động", "t": 91.3, "d": 0.465}, {"w": "lại", "t": 91.765, "d": 0.06}, {"w": "ấy", "t": 91.825, "d": 0.385}, {"w": "sắp", "t":