motion/hf/assets/long\mim-alphago-lee-sedol\ch08\data.js:1:window.CASE = {"topic": "mim-alphago-lee-sedol", "ch": "ch08", "dur": 84.02, "seed": 29582, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 08", "t": "VÁN NĂM"}, "acc": ["alphago", "sedol", "nước", "thua", "thắng", "vạn", "nghìn", "máy"], "lines": [{"text": "Ngày 15 tháng 3. Ván cuối cùng.", "start": 0.0, "end": 1.92, "words": [{"w": "Ngày", "t": 0.0, "d": 0.1}, {"w": "15", "t": 0.1, "d": 0.385}, {"w": "tháng", "t": 0.485, "d": 0.355}, {"w": "3.", "t": 0.84, "d": 0.285}, {"w": "Ván", "t": 1.125, "d": 0.06}, {"w": "cuối", "t": 1.185, "d": 0.215}, {"w": "cùng.", "t": 1.4, "d": 0.355}]}, {"text": "Theo thể thức, màu quân của ván này sẽ được chọn ngẫu nhiên.", "start": 2.72, "end": 6.16, "words": [{"w": "Theo", "t": 2.755, "d": 0.165}, {"w": "thể", "t": 2.92, "d": 0.38}, {"w": "thức,", "t": 3.3, "d": 0.35}, {"w": "màu", "t": 3.65, "d": 0.07}, {"w": "quân", "t": 3.72, "d": 0.285}, {"w": "của", "t": 4.005, "d": 0.24}, {"w": "ván", "t": 4.245, "d": 0.16}, {"w": "này", "t": 4.405, "d": 0.185}, {"w": "sẽ", "t": 4.59, "d": 0.39}, {"w": "được", "t": 4.98, "d": 0.105}, {"w": "chọn", "t": 5.085, "d": 0.3}, {"w": "ngẫu", "t": 5.385, "d": 0.17}, {"w": "nhiên.", "t": 5.555, "d": 0.4}]}, {"text": "Nhưng Lee Sedol xin được cầm quân đen.", "start": 6.48, "end": 8.64, "words": [{"w": "Nhưng", "t": 6.505, "d": 0.23}, {"w": "Lee", "t": 6.735, "d": 0.22}, {"w": "Sedol", "t": 6.955, "d": 0.185}, {"w": "xin", "t": 7.14, "d": 0.26}, {"w": "được", "t": 7.4, "d": 0.195}, {"w": "cầm", "t": 7.595, "d": 0.22}, {"w": "quân", "t": 7.815, "d": 0.235}, {"w": "đen.", "t": 8.05, "d": 0.34}]}, {"text": "Ở ván bốn, ông đã thắng bằng quân trắng.", "start": 8.96, "end": 11.28, "words": [{"w": "Ở", "t": 9.0, "d": 0.165}, {"w": "ván", "t": 9.165, "d": 0.32}, {"w": "bốn,", "t": 9.485, "d": 0.295}, {"w": "ông", "t": 9.78, "d": 0.13}, {"w": "đã", "t": 9.91, "d": 0.215}, {"w": "thắng", "t": 10.125, "d": 0.125}, {"w": "bằng", "t": 10.25, "d": 0.205}, {"w": "quân", "t": 10.455, "d": 0.215}, {"w": "trắng.", "t": 10.67, "d": 0.375}]}, {"text": "Và ông cho rằng AlphaGo mạnh hơn khi nó cầm trắng.", "start": 11.6, "end": 14.64, "words": [{"w": "Và", "t": 11.6, "d": 0.205}, {"w": "ông", "t": 11.805, "d": 0.155}, {"w": "cho", "t": 11.96, "d": 0.31}, {"w": "rằng", "t": 12.27, "d": 0.23}, {"w": "AlphaGo", "t": 12.5, "d": 0.405}, {"w": "mạnh", "t": 12.905, "d": 0.16}, {"w": "hơn", "t": 13.065, "d": 0.38}, {"w": "khi", "t": 13.445, "d": 0.08}, {"w": "nó", "t": 13.525, "d": 0.165}, {"w": "cầm", "t": 13.69, "d": 0.325}, {"w": "trắng.", "t": 14.015, "d": 0.345}]}, {"text": "Thắng nó bằng quân đen, theo ông, mới thật sự đáng giá.", "start": 14.96, "end": 18.0, "words": [{"w": "Thắng", "t": 14.96, "d": 0.26}, {"w": "nó", "t": 15.22, "d": 0.145}, {"w": "bằng", "t": 15.365, "d": 0.155}, {"w": "quân", "t": 15.52, "d": 0.345}, {"w": "đen,", "t": 15.865, "d": 0.16}, {"w": "theo", "t": 16.025, "d": 0.375}, {"w": "ông,", "t": 16.4, "d": 0.245}, {"w": "mới", "t": 16.645, "d": 0.11}, {"w": "thật", "t": 16.755, "d": 0.385}, {"w": "sự", "t": 17.14, "d": 0.095}, {"w": "đáng", "t": 17.235, "d": 0.145}, {"w": "giá.", "t": 17.38, "d": 0.415}]}, {"text": "Đầu ván, có vẻ ông sẽ làm được.", "start": 19.0, "end": 20.76, "words": [{"w": "Đầu", "t": 19.0, "d": 0.115}, {"w": "ván,", "t": 19.115, "d": 0.395}, {"w": "có", "t": 19.51, "d": 0.13}, {"w": "vẻ", "t": 19.64, "d": 0.06}, {"w": "ông", "t": 19.7, "d": 0.25}, {"w": "sẽ", "t": 19.95, "d": 0.195}, {"w": "làm", "t": 20.145, "d": 0.215}, {"w": "được.", "t": 20.36, "d": 0.2}]}, {"text": "Người đứng đầu DeepMind, Demis Hassabis, viết rằng cỗ máy đã mắc một sai lầm nặng từ sớm.", "start": 21.08, "end": 26.04, "words": [{"w": "Người", "t": 21.08, "d": 0.25}, {"w": "đứng", "t": 21.33, "d": 0.25}, {"w": "đầu", "t": 21.58, "d": 0.32}, {"w": "DeepMind,", "t": 21.9, "d": 0.185}, {"w": "Demis", "t": 22.085, "d": 0.385}, {"w": "Hassabis,", "t": 22.47, "d": 0.42}, {"w": "viết", "t": 22.89, "d": 0.255}, {"w": "rằng", "t": 23.145, "d": 0.215}, {"w": "cỗ", "t": 23.36, "d": 0.085}, {"w": "máy", "t": 23.445, "d": 0.205}, {"w": "đã", "t": 23.65, "d": 0.335}, {"w": "mắc", "t": 23.985, "d": 0.15}, {"w": "một", "t": 24.135, "d": 0.345}, {"w": "sai", "t": 24.48, "d": 0.165}, {"w": "lầm", "t": 24.645, "d": 0.245}, {"w": "nặng", "t": 24.89, "d": 0.265}, {"w": "từ", "t": 25.155, "d": 0.275}, {"w": "sớm.", "t": 25.43, "d": 0.39}]}, {"text": "Lee Sedol dẫn trước.", "start": 26.36, "end": 28.04, "words": [{"w": "Lee", "t": 26.425, "d": 0.26}, {"w": "Sedol", "t": 26.685, "d": 0.485}, {"w": "dẫn", "t": 27.17, "d": 0.2}, {"w": "trước.", "t": 27.37, "d": 0.47}]}, {"text": "Nhưng AlphaGo lặng lẽ gỡ lại, từng chút một.", "start": 29.04, "end": 31.68, "words": [{"w": "Nhưng", "t": 29.04, "d": 0.25}, {"w": "AlphaGo", "t": 29.29, "d": 0.5}, {"w": "lặng", "t": 29.79, "d": 0.055}, {"w": "lẽ", "t": 29.845, "d": 0.23}, {"w": "gỡ", "t": 30.075, "d": 0.37}, {"w": "lại,", "t": 30.445, "d": 0.35}, {"w": "từng", "t": 30.795, "d": 0.06}, {"w": "chút", "t": 30.855, "d": 0.28}, {"w": "một.", "t": 31.135, "d": 0.36}]}, {"text": "Tới khoảng nước thứ chín mươi, thế cờ đã cân bằng trở lại.", "start": 32.0, "end": 34.88, "words": [{"w": "Tới", "t": 32.045, "d": 0.125}, {"w": "khoảng", "t": 32.17, "d": 0.275}, {"w": "nước", "t": 32.445, "d": 0.165}, {"w": "thứ", "t": 32.61, "d": 0.125}, {"w": "chín", "t": 32.735, "d": 0.32}, {"w": "mươi,", "t": 33.055, "d": 0.295}, {"w": "thế", "t": 33.35, "d": 0.06}, {"w": "cờ", "t": 33.41, "d": 0.24}, {"w": "đã", "t": 33.65, "d": 0.195}, {"w": "cân", "t": 33.845, "d": 0.135}, {"w": "bằng", "t": 33.98, "d": 0.19}, {"w": "trở", "t": 34.17, "d": 0.185}, {"w": "lại.", "t": 34.355, "d": 0.345}]}, {"text": "Gần cuối, Lee Sedol tung một đòn liều lĩnh sau cùng. Cỗ máy đỡ được.", "start": 35.2, "end": 39.12, "words": [{"w": "Gần", "t": 35.335, "d": 0.175}, {"w": "cuối,", "t": 35.51, "d": 0.31}, {"w": "Lee", "t": 35.82, "d": 0.205}, {"w": "Sedol", "t": 36.025, "d": 0.255}, {"w": "tung", "t": 36.28, "d": 0.33}, {"w": "một", "t": 36.61, "d": 0.175}, {"w": "đòn", "t": 36.785, "d": 0.26}, {"w": "liều", "t": 37.045, "d": 0.09}, {"w": "lĩnh", "t": 37.135, "d": 0.305}, {"w": "sau", "t": 37.44, "d": 0.25}, {"w": "cùng.", "t": 37.69, "d": 0.305}, {"w": "Cỗ", "t": 37.995, "d": 0.25}, {"w": "máy", "t": 38.245, "d": 0.06}, {"w": "đỡ", "t": 38.305, "d": 0.185}, {"w": "được.", "t": 38.49, "d": 0.44}]}, {"text": "Ván cờ kéo dài nhất trong cả năm ván.", "start": 39.44, "end": 41.2, "words": [{"w": "Ván", "t": 39.44, "d": 0.13}, {"w": "cờ", "t": 39.57, "d": 0.26}, {"w": "kéo", "t": 39.83, "d": 0.165}, {"w": "dài", "t": 39.995, "d": 0.16}, {"w": "nhất", "t": 40.155, "d": 0.16}, {"w": "trong", "t": 40.315, "d": 0.065}, {"w": "cả", "t": 40.38, "d": 0.145}, {"w": "năm", "t": 40.525, "d": 0.27}, {"w": "ván.", "t": 40.795, "d": 0.19}]}, {"text": "Tới nước thứ hai trăm tám mươi, Lee Sedol xin thua.", "start": 41.52, "end": 44.08, "words": [{"w": "Tới", "t": 41.575, "d": 0.265}, {"w": "nước", "t": 41.84, "d": 0.145}, {"w": "thứ", "t": 41.985, "d": 0.165}, {"w": "hai", "t": 42.15, "d": 0.165}, {"w": "trăm", "t": 42.315, "d": 0.12}, {"w": "tám", "t": 42.435, "d": 0.345}, {"w": "mươi,", "t": 42.78, "d": 0.165}, {"w": "Lee", "t": 42.945, "d": 0.325}, {"w": "Sedol", "t": 43.27, "d": 0.115}, {"w": "xin", "t": 43.385, "d": 0.19}, {"w": "thua.", "t": 43.575, "d": 0.295}]}, {"text": "Tỉ số chung cuộc: bốn, một.", "start": 45.08, "end": 47.16, "words": [{"w": "Tỉ", "t": 45.125, "d": 0.33}, {"w": "số", "t": 45.455, "d": 0.165}, {"w": "chung", "t": 45.62, "d": 0.305}, {"w": "cuộc:", "t": 45.925, "d": 0.165}, {"w": "bốn,", "t": 46.09, "d": 0.51}, {"w": "một.", "t": 46.6, "d": 0.345}]}, {"text": "Lee Sedol nhận một trăm bảy mươi nghìn đô la, gồm tiền tham dự và tiền thưởng cho ván thắng duy nhất.", "start": 47.48, "end": 52.2, "words": [{"w": "Lee", "t": 47.48, "d": 0.125}, {"w": "Sedol", "t": 47.605, "d": 0.31}, {"w": "nhận", "t": 47.915, "d": 0.19}, {"w": "một", "t": 48.105, "d": 0.23}, {"w": "trăm", "t": 48.335, "d": 0.185}, {"w": "bảy", "t": 48.52, "d": 0.13}, {"w": "mươi", "t": 48.65, "d": 0.25}, {"w": "nghìn", "t": 48.9, "d": 0.135}, {"w": "đô", "t": 49.035, "d": 0.295}, {"w": "la,", "t": 49.33, "d": 0.315}, {"w": "gồm", "t": 49.645, "d": 0.06}, {"w": "tiền", "t": 49.705, "d": 0.335}, {"w": "tham", "t": 50.04, "d": 0.15}, {"w": "dự", "t": 50.19, "d": 0.145}, {"w": "và", "t": 50.335, "d": 0.21}, {"w": "tiền", "t": 50.545, "d": 0.12}, {"w": "thưởng", "t": 50.665, "d": 0.185}, {"w": "cho", "t": 50.85, "d": 0.37}, {"w": "ván", "t": 51.22, "d": 0.06}, {"w": "thắng", "t": 51.28, "d": 0.215}, {"w": "duy", "t": 51.495, "d": 0.145}, {"w": "nhất.", "t": 51.64, "d": 0.405}]}, {"text": "Hiệp hội cờ vây Hàn Quốc trao cho AlphaGo danh hiệu chín đẳng danh dự.", "start": 52.52, "end": 55.8, "words": [{"w": "Hiệp", "t": 52.53, "d": 0.11}, {"w": "hội", "t": 52.64, "d": 0.21}, {"w": "cờ", "t": 52.85, "d": 0.16}, {"w": "vây", "t": 53.01, "d": 0.335}, {"w": "Hàn", "t": 53.345, "d": 0.19}, {"w": "Quốc", "t": 53.535, "d": 0.06}, {"w": "trao", "t": 53.595, "d": 0.26}, {"w": "cho", "t": 53.855, "d": 0.155}, {"w": "AlphaGo", "t": 54.01, "d": 0.445}, {"w": "danh", "t": 54.455, "d": 0.175}, {"w": "hiệu", "t": 54.63, "d": 0.155}, {"w": "chín", "t": 54.785, "d": 0.22}, {"w": "đẳng", "t": 55.005, "d": 0.06}, {"w": "danh", "t": 55.065, "d": 0.285}, {"w": "dự.", "t": 55.35, "d": 0.27}]}, {"text": "Chỉ hai ngày sau, chính phủ Hàn Quốc công bố khoản đầu tư một nghìn tỷ won cho nghiên cứu trí tuệ nhân tạo.", "start": 56.12, "end": 60.92, "words": [{"w": "Chỉ", "t": 56.12, "d": 0.23}, {"w": "hai", "t": 56.35, "d": 0.155}, {"w": "ngày", "t": 56.505, "d": 0.24}, {"w": "sau,", "t": 56.745, "d": 0.255}, {"w": "chính", "t": 57.0, "d": 0.065}, {"w": "phủ", "t": 57.065, "d": 0.18}, {"w": "Hàn", "t": 57.245, "d": 0.33}, {"w": "Quốc", "t": 57.575, "d": 0.165}, {"w": "công", "t": 57.74, "d": 0.115}, {"w": "bố", "t": 57.855, "d": 0.2}, {"w": "khoản", "t": 58.055, "d": 0.27}, {"w": "đầu", "t": 58.325, "d": 0.185}, {"w": "tư", "t": 58.51, "d": 0.135}, {"w": "một", "t": 58.645, "d": 0.23}, {"w": "nghìn", "t": 58.875, "d": 0.06}, {"w": "tỷ", "t": 58.935, "d": 0.165}, {"w": "won", "t": 59.1, "d": 0.325}, {"w": "cho", "t": 59.425, "d": 0.065}, {"w": "nghiên", "t": 59.49, "d": 0.3}, {"w": "cứu", "t": 59.79, "d": 0.06}, {"w": "trí", "t": 59.85, "d": 0.235}, {"w": "tuệ", "t": 60.085, "d": 0.19}, {"w": "nhân", "t": 60.275, "d": 0.145}, {"w": "tạo.", "t": 60.42, "d": 0.325}]}, {"text": "Còn Lee Sedol, ở buổi họp báo cuối, vẫn không chịu nhận mình kém hơn.", "start": 61.92, "end": 65.92, "words": [{"w": "Còn", "t": 61.965, "d": 0.27}, {"w": "Lee", "t": 62.235, "d": 0.16}, {"w": "Sedol,", "t": 62.395, "d": 0.435}, {"w": "ở", "t": 62.83, "d": 0.07}, {"w": "buổi", "t": 62.9, "d": 0.21}, {"w": "họp", "t": 63.11, "d": 0.275}, {"w": "báo", "t": 63.385, "d": 0.225}, {"w": "cuối,", "t": 63.61, "d": 0.47}, {"w": "vẫn", "t": 64.08, "d": 0.105}, {"w": "không", "t": 64.185, "d": 0.305}, {"w": "chịu", "t": 64.49, "d": 0.18}, {"w": "nhận", "t": 64.67, "d": 0.31}, {"w": "mình", "t": 64.98, "d": 0.06}, {"w": "kém", "t": 65.04, "d": 0.24}, {"w": "hơn.", "t": 65.28, "d": 0.405}]}, {"text": "Tôi không hẳn nghĩ rằng AlphaGo giỏi hơn tôi. Tôi tin con người vẫn còn làm được nhiều hơn thế.", "start": 66.24, "end": 71.76, "words": [{"w": "Tôi", "t": 66.345, "d": 0.13}, {"w": "không", "t": 66.475, "d": 0.315}, {"w": "hẳn", "t": 66.79, "d": 0.225}, {"w": "nghĩ", "t": 67.015, "d": 0.34}, {"w": "rằng", "t": 67.355, "d": 0.06}, {"w": "AlphaGo", "t": 67.415, "d": 0.51}, {"w": "giỏi", "t": 67.925, "d": 0.175}, {"w": "hơn", "t": 68.1, "d": 0.42}, {"w": "tôi.", "t": 68.52, "d": 0.35}, {"w": "Tôi", "t": 68.87, "d": 0.235}, {"w": "tin", "t": 69.105, "d": 0.06}, {"w": "con", "t": 69.165, "d": 0.285}, {"w": "người", "t": 69.45, "d": 0.18}, {"w": "vẫn", "t": 69.63, "d": 0.415}, {"w": "còn", "t": 70.045, "d": 0.2}, {"w": "làm", "t": 70.245, "d": 0.155}, {"w": "được", "t": 70.4, "d": 0.245}, {"w": "nhiều", "t": 70.645, "d": 0.145}, {"w": "hơn", "t": 70.79, "d": 0.405}, {"w": "thế.", "t": 71.195, "d": 0.27}]}, {"text": "Ông cho rằng cỗ máy hơn mình ở chỗ khác. Nó không mệt, không run, và không bao giờ mất tập trung.", "start": 72.08, "end": 77.04, "words": [{"w": "Ông", "t": 72.125, "d": 0.125}, {"w": "cho", "t": 72.25, "d": 0.3}, {"w": "rằng", "t": 72.55, "d": 0.125}, {"w": "cỗ", "t": 72.675, "d": 0.14}, {"w": "máy", "t": 72.815, "d": 0.34}, {"w": "hơn", "t": 73.155, "d": 0.06}, {"w": "mình", "t": 73.215, "d": 0.24}, {"w": "ở", "t": 73.455, "d": 0.145}, {"w": "chỗ", "t": 73.6, "d": 0.34}, {"w": "khác.", "t": 73.94, "d": 0.155}, {"w": "Nó", "t": 74.095, "d": 0.255}, {"w": "không", "t": 74.35, "d": 0.305}, {"w": "mệt,", "t": 74.655, "d": 0.31}, {"w": "không", "t": 74.965, "d": 0.06}, {"w": "run,", "t": 75.025, "d": 0.445}, {"w": "và", "t": 75.47, "d": 0.145}, {"w": "không", "t": 75.615, "d": 0.085}, {"w": "bao", "t": 75.7, "d": 0.19}, {"w": "giờ", "t": 75.89, "d": 0.335}, {"w": "mất", "t": 76.225, "d": 0.18}, {"w": "tập", "t": 76.405, "d": 0.15}, {"w": "trung.", "t": 76.555, "d": 0.31}]}, {"text": "Nhưng câu chuyện chưa dừng ở Seoul.", "start": 77.36, "end": 79.36, "words": [{"w": "Nhưng", "t": 77.36, "d": 0.26}, {"w": "câu", "t": 77.62, "d": 0.295}, {"w": "chuyện", "t": 77.915, "d": 0.06}, {"w": "chưa", "t": 77.975, "d": 0.24}, {"w": "dừng", "t": 78.215, "d": 0.4}, {"w": "ở", "t": 78.615, "d": 0.06}, {"w": "Seoul.", "t": 78.675, "d": 0.48}]}, {"text": "Vì cỗ máy vừa thắng ông, sắp bị chính hậu duệ của nó hạ gục.", "start": 79.68, "end": 82.8, "words": [{"w": "Vì", "t": 79.68, "d": 0.12}, {"w": "cỗ", "t": 79.8, "d": 0.155}, {"w": "máy", "t": 79.955, "d": 0.23}, {"w": "vừa", "t": 80.185, "d": 0.135}, {"w": "thắng", "t": 80.32, "d": 0.335}, {"w": "ông,", "t": 80.655, "d": 0.265}, {"w": "sắp", "t": 80.92, "d": 0.06}, {"w": "bị", "t": 80.98, "d": 0.215}, {"w": "chính", "t": 81.195, "d": 0.19}, {"w": "hậu", "t": 81.385, "d": 0.2}, {"w": "duệ", "t": 81.585, "d": 0.215}, {"w": "của", "t": 81.8, "d": 0.21}, {"w": "nó", "t": 82.01, "d": 0.12}, {"w": "hạ", "t": 82.13, "d": 0.17}, {"w": "gục.", "t": 82.3, "d": 0.3}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "date", "day": "VÁN CUỐI CÙNG", "date": "15.03.2016", "t0": 0.0, "t1": 2.72, "dayAt": 0.15, "groupAt": [0.4, 0.7, 1.0]}, {"type": "ledger", "title": "MỘT ĐỀ NGHỊ LẠ", "rows": [{"k": "THEO THỂ THỨC", "v": "MÀU QUÂN CHỌN NGẪU NHIÊN", "at": 2.72}, {"k": "ÔNG XIN", "v": "ĐƯỢC CẦM QUÂN ĐEN", "at": 6.48}], "total": {"k": "LÝ DO", "v": "THẮNG BẰNG ĐEN MỚI ĐÁNG GIÁ", "at": 14.96}, "t0": 2.72, "t1": 19.0}, {"type": "go", "pos": [[16, 3, "B"], [3, 3, "W"], [15, 16, "B"], [3, 15, "W"], [14, 2, "B"], [15, 14, "W"], [16, 14, "B"], [16, 13, "W"], [16, 15, "B"], [15, 12, "W"], [13, 16, "B"], [16, 4, "W"], [15, 4, "B"], [16, 5, "W"], [17, 3, "B"], [15, 5, "W"], [16, 11, "B"], [14, 4, "W"], [15, 11, "B"], [14, 11, "W"], [14, 12, "B"], [14, 10, "W"], [13, 12, "B"], [16, 9, "W"], [17, 13, "B"], [6, 16, "W"], [2, 5, "B"], [5, 2, "W"], [1, 3, "B"], [2, 7, "W"], [3, 7, "B"], [3, 8, "W"], [3, 6, "B"], [2, 2, "W"], [2, 8, "B"], [2, 9, "W"], [1, 8, "B"], [3, 9, "W"], [1, 7, "B"], [12, 11, "W"], [12, 12, "B"], [11, 12, "W"], [13, 11, "B"], [13, 10, "W"], [11, 13, "B"], [11, 11, "W"], [10, 13, "B"], [12, 13, "W"], [12, 14, "B"], [17, 12, "W"], [17, 11, "B"], [17, 14, "W"], [18, 13, "B"], [15, 13, "W"], [14, 14, "B"], [14, 15, "W"], [13, 14, "B"], [18, 12, "W"]], "label": {"k": "VÁN 5 · SAU 58 NƯỚC: MÁY MẮC SAI LẦM NẶNG, LEE DẪN TRƯỚC", "v": "THẾ CỜ THẬT · DỰNG TỪ BIÊN BẢN VÁN ĐẤU", "at": 21.08}, "t0": 19.0, "t1": 29.04}, {"type": "kinetic", "items": [{"text": "MÁY LẶNG LẼ GỠ LẠI", "at": 29.04, "acc": true, "fx": "outline", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "104px", "left": "140px"}}, "em": "LẶNG"}, {"text": "khoảng nước 90: cân b