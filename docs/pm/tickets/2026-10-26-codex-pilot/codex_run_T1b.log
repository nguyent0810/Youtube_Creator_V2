motion/hf/assets/long\ck-e1-mua-deu-moi-thang\ch02\data.js:1:window.CASE = {"topic": "ck-e1-mua-deu-moi-thang", "ch": "ch02", "dur": 76.5, "seed": 33549, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 02", "t": "CÔ ĐỀU VỀ ĐÍCH"}, "acc": ["vn-index", "đều", "xui", "may", "lỗ", "lãi", "nộp"], "lines": [{"text": "Mình bắt đầu với cô Đều.", "start": 0.0, "end": 1.52, "words": [{"w": "Mình", "t": 0.055, "d": 0.205}, {"w": "bắt", "t": 0.26, "d": 0.135}, {"w": "đầu", "t": 0.395, "d": 0.25}, {"w": "với", "t": 0.645, "d": 0.165}, {"w": "cô", "t": 0.81, "d": 0.175}, {"w": "Đều.", "t": 0.985, "d": 0.21}]}, {"text": "Chín mươi bảy lần mua, không sót tháng nào.", "start": 2.32, "end": 4.72, "words": [{"w": "Chín", "t": 2.39, "d": 0.255}, {"w": "mươi", "t": 2.645, "d": 0.225}, {"w": "bảy", "t": 2.87, "d": 0.075}, {"w": "lần", "t": 2.945, "d": 0.32}, {"w": "mua,", "t": 3.265, "d": 0.175}, {"w": "không", "t": 3.44, "d": 0.175}, {"w": "sót", "t": 3.615, "d": 0.365}, {"w": "tháng", "t": 3.98, "d": 0.065}, {"w": "nào.", "t": 4.045, "d": 0.36}]}, {"text": "Hai trăm chín mươi mốt triệu nộp vào.", "start": 5.04, "end": 6.96, "words": [{"w": "Hai", "t": 5.12, "d": 0.125}, {"w": "trăm", "t": 5.245, "d": 0.195}, {"w": "chín", "t": 5.44, "d": 0.13}, {"w": "mươi", "t": 5.57, "d": 0.31}, {"w": "mốt", "t": 5.88, "d": 0.055}, {"w": "triệu", "t": 5.935, "d": 0.17}, {"w": "nộp", "t": 6.105, "d": 0.28}, {"w": "vào.", "t": 6.385, "d": 0.215}]}, {"text": "Và đầu tháng mười năm nay, tài khoản của cô ở mức khoảng bốn trăm ba mươi bảy triệu.", "start": 7.28, "end": 11.76, "words": [{"w": "Và", "t": 7.345, "d": 0.115}, {"w": "đầu", "t": 7.46, "d": 0.22}, {"w": "tháng", "t": 7.68, "d": 0.22}, {"w": "mười", "t": 7.9, "d": 0.295}, {"w": "năm", "t": 8.195, "d": 0.11}, {"w": "nay,", "t": 8.305, "d": 0.345}, {"w": "tài", "t": 8.65, "d": 0.135}, {"w": "khoản", "t": 8.785, "d": 0.33}, {"w": "của", "t": 9.115, "d": 0.22}, {"w": "cô", "t": 9.335, "d": 0.18}, {"w": "ở", "t": 9.515, "d": 0.2}, {"w": "mức", "t": 9.715, "d": 0.24}, {"w": "khoảng", "t": 9.955, "d": 0.075}, {"w": "bốn", "t": 10.03, "d": 0.25}, {"w": "trăm", "t": 10.28, "d": 0.265}, {"w": "ba", "t": 10.545, "d": 0.06}, {"w": "mươi", "t": 10.605, "d": 0.265}, {"w": "bảy", "t": 10.87, "d": 0.29}, {"w": "triệu.", "t": 11.16, "d": 0.24}]}, {"text": "Lãi khoảng một trăm bốn mươi sáu triệu.", "start": 12.76, "end": 14.76, "words": [{"w": "Lãi", "t": 12.81, "d": 0.23}, {"w": "khoảng", "t": 13.04, "d": 0.19}, {"w": "một", "t": 13.23, "d": 0.205}, {"w": "trăm", "t": 13.435, "d": 0.06}, {"w": "bốn", "t": 13.495, "d": 0.15}, {"w": "mươi", "t": 13.645, "d": 0.345}, {"w": "sáu", "t": 13.99, "d": 0.18}, {"w": "triệu.", "t": 14.17, "d": 0.22}]}, {"text": "Tức là khoảng năm mươi phần trăm trên tổng số tiền đã nộp.", "start": 15.08, "end": 18.04, "words": [{"w": "Tức", "t": 15.13, "d": 0.11}, {"w": "là", "t": 15.24, "d": 0.235}, {"w": "khoảng", "t": 15.475, "d": 0.2}, {"w": "năm", "t": 15.675, "d": 0.26}, {"w": "mươi", "t": 15.935, "d": 0.06}, {"w": "phần", "t": 15.995, "d": 0.15}, {"w": "trăm", "t": 16.145, "d": 0.255}, {"w": "trên", "t": 16.4, "d": 0.21}, {"w": "tổng", "t": 16.61, "d": 0.205}, {"w": "số", "t": 16.815, "d": 0.22}, {"w": "tiền", "t": 17.035, "d": 0.15}, {"w": "đã", "t": 17.185, "d": 0.125}, {"w": "nộp.", "t": 17.31, "d": 0.31}]}, {"text": "Khoan đã. Chỉ số tăng bảy mươi bảy phần trăm, sao cô ấy chỉ lãi năm mươi?", "start": 18.36, "end": 22.84, "ask": 1, "words": [{"w": "Khoan", "t": 18.485, "d": 0.175}, {"w": "đã.", "t": 18.66, "d": 0.29}, {"w": "Chỉ", "t": 18.95, "d": 0.41}, {"w": "số", "t": 19.36, "d": 0.205}, {"w": "tăng", "t": 19.565, "d": 0.055}, {"w": "bảy", "t": 19.62, "d": 0.395}, {"w": "mươi", "t": 20.015, "d": 0.21}, {"w": "bảy", "t": 20.225, "d": 0.13}, {"w": "phần", "t": 20.355, "d": 0.285}, {"w": "trăm,", "t": 20.64, "d": 0.195}, {"w": "sao", "t": 20.835, "d": 0.33}, {"w": "cô", "t": 21.165, "d": 0.1}, {"w": "ấy", "t": 21.265, "d": 0.285}, {"w": "chỉ", "t": 21.55, "d": 0.245}, {"w": "lãi", "t": 21.795, "d": 0.31}, {"w": "năm", "t": 22.105, "d": 0.06}, {"w": "mươi?", "t": 22.165, "d": 0.42}]}, {"text": "Vì tiền của cô không nằm trong thị trường ngay từ đầu.", "start": 23.44, "end": 26.24, "words": [{"w": "Vì", "t": 23.49, "d": 0.19}, {"w": "tiền", "t": 23.68, "d": 0.2}, {"w": "của", "t": 23.88, "d": 0.185}, {"w": "cô", "t": 24.065, "d": 0.22}, {"w": "không", "t": 24.285, "d": 0.1}, {"w": "nằm", "t": 24.385, "d": 0.3}, {"w": "trong", "t": 24.685, "d": 0.185}, {"w": "thị", "t": 24.87, "d": 0.17}, {"w": "trường", "t": 25.04, "d": 0.065}, {"w": "ngay", "t": 25.105, "d": 0.205}, {"w": "từ", "t": 25.31, "d": 0.205}, {"w": "đầu.", "t": 25.515, "d": 0.325}]}, {"text": "Ba triệu đầu tiên được hưởng trọn tám năm. Còn ba triệu cuối cùng, mới vào được vài ngày.", "start": 26.56, "end": 31.44, "words": [{"w": "Ba", "t": 26.61, "d": 0.15}, {"w": "triệu", "t": 26.76, "d": 0.365}, {"w": "đầu", "t": 27.125, "d": 0.06}, {"w": "tiên", "t": 27.185, "d": 0.355}, {"w": "được", "t": 27.54, "d": 0.225}, {"w": "hưởng", "t": 27.765, "d": 0.08}, {"w": "trọn", "t": 27.845, "d": 0.245}, {"w": "tám", "t": 28.09, "d": 0.15}, {"w": "năm.", "t": 28.24, "d": 0.455}, {"w": "Còn", "t": 28.695, "d": 0.1}, {"w": "ba", "t": 28.795, "d": 0.295}, {"w": "triệu", "t": 29.09, "d": 0.185}, {"w": "cuối", "t": 29.275, "d": 0.205}, {"w": "cùng,", "t": 29.48, "d": 0.455}, {"w": "mới", "t": 29.935, "d": 0.135}, {"w": "vào", "t": 30.07, "d": 0.245}, {"w": "được", "t": 30.315, "d": 0.26}, {"w": "vài", "t": 30.575, "d": 0.075}, {"w": "ngày.", "t": 30.65, "d": 0.39}]}, {"text": "Nhưng mua đều có một cơ chế rất thú vị, ít người để ý.", "start": 32.44, "end": 35.72, "words": [{"w": "Nhưng", "t": 32.495, "d": 0.19}, {"w": "mua", "t": 32.685, "d": 0.14}, {"w": "đều", "t": 32.825, "d": 0.24}, {"w": "có", "t": 33.065, "d": 0.145}, {"w": "một", "t": 33.21, "d": 0.205}, {"w": "cơ", "t": 33.415, "d": 0.16}, {"w": "chế", "t": 33.575, "d": 0.335}, {"w": "rất", "t": 33.91, "d": 0.065}, {"w": "thú", "t": 33.975, "d": 0.2}, {"w": "vị,", "t": 34.175, "d": 0.37}, {"w": "ít", "t": 34.545, "d": 0.07}, {"w": "người", "t": 34.615, "d": 0.36}, {"w": "để", "t": 34.975, "d": 0.17}, {"w": "ý.", "t": 35.145, "d": 0.24}]}, {"text": "Cùng ba triệu đồng, lúc giá rẻ, bạn mua được nhiều hơn. Lúc giá đắt, bạn mua được ít hơn.", "start": 36.04, "end": 41.32, "words": [{"w": "Cùng", "t": 36.11, "d": 0.3}, {"w": "ba", "t": 36.41, "d": 0.09}, {"w": "triệu", "t": 36.5, "d": 0.33}, {"w": "đồng,", "t": 36.83, "d": 0.15}, {"w": "lúc", "t": 36.98, "d": 0.25}, {"w": "giá", "t": 37.23, "d": 0.26}, {"w": "rẻ,", "t": 37.49, "d": 0.335}, {"w": "bạn", "t": 37.825, "d": 0.185}, {"w": "mua", "t": 38.01, "d": 0.275}, {"w": "được", "t": 38.285, "d": 0.115}, {"w": "nhiều", "t": 38.4, "d": 0.255}, {"w": "hơn.", "t": 38.655, "d": 0.44}, {"w": "Lúc", "t": 39.095, "d": 0.11}, {"w": "giá", "t": 39.205, "d": 0.19}, {"w": "đắt,", "t": 39.395, "d": 0.47}, {"w": "bạn", "t": 39.865, "d": 0.09}, {"w": "mua", "t": 39.955, "d": 0.195}, {"w": "được", "t": 40.15, "d": 0.345}, {"w": "ít", "t": 40.495, "d": 0.195}, {"w": "hơn.", "t": 40.69, "d": 0.265}]}, {"text": "Tháng tư năm hai nghìn không trăm hai mươi, chỉ số ở quanh sáu trăm tám mươi điểm.", "start": 41.64, "end": 45.48, "words": [{"w": "Tháng", "t": 41.705, "d": 0.14}, {"w": "tư", "t": 41.845, "d": 0.29}, {"w": "năm", "t": 42.135, "d": 0.06}, {"w": "hai", "t": 42.195, "d": 0.24}, {"w": "nghìn", "t": 42.435, "d": 0.125}, {"w": "không", "t": 42.56, "d": 0.175}, {"w": "trăm", "t": 42.735, "d": 0.215}, {"w": "hai", "t": 42.95, "d": 0.26}, {"w": "mươi,", "t": 43.21, "d": 0.13}, {"w": "chỉ", "t": 43.34, "d": 0.28}, {"w": "số", "t": 43.62, "d": 0.16}, {"w": "ở", "t": 43.78, "d": 0.18}, {"w": "quanh", "t": 43.96, "d": 0.195}, {"w": "sáu", "t": 44.155, "d": 0.24}, {"w": "trăm", "t": 44.395, "d": 0.07}, {"w": "tám", "t": 44.465, "d": 0.19}, {"w": "mươi", "t": 44.655, "d": 0.13}, {"w": "điểm.", "t": 44.785, "d": 0.36}]}, {"text": "Tháng bảy năm nay, chỉ số ở quanh một nghìn tám trăm sáu mươi bảy điểm.", "start": 45.8, "end": 49.48, "words": [{"w": "Tháng", "t": 45.875, "d": 0.1}, {"w": "bảy", "t": 45.975, "d": 0.325}, {"w": "năm", "t": 46.3, "d": 0.065}, {"w": "nay,", "t": 46.365, "d": 0.32}, {"w": "chỉ", "t": 46.685, "d": 0.195}, {"w": "số", "t": 46.88, "d": 0.185}, {"w": "ở", "t": 47.065, "d": 0.31}, {"w": "quanh", "t": 47.375, "d": 0.06}, {"w": "một", "t": 47.435, "d": 0.25}, {"w": "nghìn", "t": 47.685, "d": 0.255}, {"w": "tám", "t": 47.94, "d": 0.06}, {"w": "trăm", "t": 48.0, "d": 0.185}, {"w": "sáu", "t": 48.185, "d": 0.27}, {"w": "mươi", "t": 48.455, "d": 0.235}, {"w": "bảy", "t": 48.69, "d": 0.185}, {"w": "điểm.", "t": 48.875, "d": 0.225}]}, {"text": "Cùng ba triệu, ở tháng rẻ, cô Đều mua được lượng nhiều gấp gần hai phẩy bảy lần tháng đắt.", "start": 49.8, "end": 54.44, "words": [{"w": "Cùng", "t": 49.87, "d": 0.195}, {"w": "ba", "t": 50.065, "d": 0.18}, {"w": "triệu,", "t": 50.245, "d": 0.37}, {"w": "ở", "t": 50.615, "d": 0.06}, {"w": "tháng", "t": 50.675, "d": 0.18}, {"w": "rẻ,", "t": 50.855, "d": 0.475}, {"w": "cô", "t": 51.33, "d": 0.115}, {"w": "Đều", "t": 51.445, "d": 0.105}, {"w": "mua", "t": 51.55, "d": 0.245}, {"w": "được", "t": 51.795, "d": 0.245}, {"w": "lượng", "t": 52.04, "d": 0.095}, {"w": "nhiều", "t": 52.135, "d": 0.18}, {"w": "gấp", "t": 52.315, "d": 0.265}, {"w": "gần", "t": 52.58, "d": 0.165}, {"w": "hai", "t": 52.745, "d": 0.23}, {"w": "phẩy", "t": 52.975, "d": 0.24}, {"w": "bảy", "t": 53.215, "d": 0.145}, {"w": "lần", "t": 53.36, "d": 0.17}, {"w": "tháng", "t": 53.53, "d": 0.22}, {"w": "đắt.", "t": 53.75, "d": 0.305}]}, {"text": "Kết quả là gì?", "start": 55.44, "end": 56.56, "words": [{"w": "Kết", "t": 55.49, "d": 0.14}, {"w": "quả", "t": 55.63, "d": 0.18}, {"w": "là", "t": 55.81, "d": 0.225}, {"w": "gì?", "t": 56.035, "d": 0.19}]}, {"text": "Nếu lấy trung bình cộng giá 