def main():
 (D / "spec.json").write_text(json.dumps(SPEC, ensure_ascii=False, indent=1), encoding="utf-8")
 for n in CHAPTERS:
  p=D/f"{n}.json"; d=json.loads(p.read_text(encoding="utf-8")); title=d["title"]
  scenes=[{"type":"chapter","no":str(int(n[-2:])),"k":"MỞ HỒ SƠ" if n=="ch00" else f"CHƯƠNG {int(n[-2:]):02d}","title":title.upper(),"sub":"BLETCHLEY PARK · ENIGMA · BOMBE","titleAt":0},
