, "h": 1245, "lic": "Attribution (PD-LosAlamos)", "by": "Los Alamos National Laboratory", "pd": false}, "bethe": {"src": "assets/long/mim-oppenheimer-feynman/img/bethe.jpg", "w": 330, "h": 462, "lic": "Public domain", "by": "", "pd": true}, "livesay": {"src": "assets/long/mim-oppenheimer-feynman/img/livesay.jpg", "w": 1280, "h": 1777, "lic": "Attribution (PD-LosAlamos)", "by": "Los Alamos National Laboratory", "pd": false}, "hiroshima": {"src": "assets/long/mim-oppenheimer-feynman/img/hiroshima.jpg", "w": 1920, "h": 1920, "lic": "Public domain", "by": "US government, Post-Work: User:W.wolny", "pd": true}, "nagasaki": {"src": "assets/long/mim-oppenheimer-feynman/img/nagasaki.jpg", "w": 500, "h": 384, "lic": "Public domain", "by": "U.S. Navy", "pd": true}}, "geo": {}, "scenes": [{"type": "chapter", "no": "8", "k": "CHƯƠNG TÁM", "title": "HẠN CHÓT\nBA TUẦN", "sub": "1945", "bg": "bldgT", "titleAt": 0.0, "t0": 0.0, "t1": 4.16}, {"type": "kinetic", "items": [{"text": "NHIỀU THIẾT KẾ ĐÃ TÍNH", "at": 4.16, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "58px", "left": "140px"}}}, {"text": "CHƯA TÍNH: THIẾT KẾ SẼ ĐEM THỬ", "at": 4.56, "acc": true, "fx": "outline", "L": {"cls": "kC", "style": {"top": "346px", "fontSize": "61px", "left": "310px"}}, "em": "THIẾT"}], "t0": 4.16, "t1": 8.56, "lay": "ladder"}, {"type": "ledger", "title": "THIẾT KẾ ĐƯỢC CHỌN", "srcnote": "N. LEWIS · TRINITY BY THE NUMBERS (LANL) · LOS ALAMOS FROM BELOW (FEYNMAN, 1976)", "rows": [{"k": "LÕI", "v": "ĐẶC", "at": 10.95}, {"k": "ĐỀ XUẤT", "v": "ROBERT CHRISTY · 09.1944", "at": 12.155}], "total": {"k": "CHRISTY CẦN", "v": "KẾT QUẢ SAU ≈ 3–4 TUẦN", "at": 15.44}, "t0": 8.56, "t1": 19.56}, {"type": "slam", "text": "KHÔNG THỂ ĐƯỢC", "sub": "FEYNMAN ĐÁP", "t0": 19.56, "t1": 21.24, "at": 19.71, "fx": "punch"}, {"type": "kinetic", "items": [{"text": "MỖI BÀI: LÂU HƠN THẾ NHIỀU", "at": 21.24, "fx": "slice", "em": "NHIỀU"}, {"text": "chỉ nhanh vì chạy nhiều bài cùng lúc", "at": 23.09, "sm": true, "fx": "blur"}], "t0": 21.24, "t1": 27.72, "lay": "stack"}, {"type": "question", "text": "Nếu dẹp hết,\nchỉ dồn sức cho một bài?", "t0": 27.72, "t1": 31.28}, {"type": "kinetic", "items": [{"text": "“TA LÀM ĐƯỢC KHÔNG?”", "at": 31.98, "acc": true, "fx": "glitch", "L": {"cls": "kL", "style": {"top": "439px", "fontSize": "51px"}}, "D": [{"kind": "split", "style": {}, "at": 31.68}], "em": "KHÔNG?”"}, {"text": "hai ca · làm thêm giờ", "at": 35.56, "sm": true, "fx": "rise", "L": {"style": {"top": "150px", "fontSize": "52px"}}}, {"text": "LUẬT MỚI: CHỈ MỘT BÀI", "at": 38.44, "fx": "blur", "L": {"cls": "kR", "style": {"top": "441px", "fontSize": "48px"}}, "em": "LUẬT"}], "t0": 31.28, "t1": 42.0, "lay": "split"}, {"type": "date", "day": "VỢ FEYNMAN QUA ĐỜI Ở ALBUQUERQUE", "date": "1945", "sub": {"text": "THEO LỜI KỂ CỦA FEYNMAN", "at": 43.35}, "t0": 42.0, "t1": 45.8, "dayAt": 42.15, "groupAt": [42.4]}, {"type": "ledger", "title": "CHIẾC XE ĐI MƯỢN", "srcnote": "LOS ALAMOS FROM BELOW (FEYNMAN, 1976) · LỜI KỂ CỦA FEYNMAN", "rows": [{"k": "CHỦ XE", "v": "FUCHS · BẠN CÙNG KÝ TÚC XÁ", "at": 47.79}, {"k": "FEYNMAN BIẾT VỀ SAU", "v": "FUCHS LÀ GIÁN ĐIỆP", "at": 52.26}, {"k": "BA NGÀY SAU", "v": "QUAY LẠI PHÒNG MÁY", "at": 55.96}], "t0": 45.8, "t1": 59.2}, {"type": "photo", "img": "card", "tone": "color", "move": "out", "veil": 0.5, "illus": "ẢNH MINH HỌA · THẺ ĐỜI SAU", "kin": [{"text": "THẺ TRẮNG · THẺ XANH · THẺ VÀNG", "at": 59.2, "acc": true, "fx": "sync", "wt": [59.815, 60.105, 60.305, 60.305, 60.635, 60.965, 60.965, 61.025], "t0": 59.2, "em": "TRẮNG"}, {"text": "“đã bảo chỉ một bài thôi mà!”", "at": 62.0, "sm": true, "fx": "flicker"}], "label": {"k": "THẺ ĐỤC LỖ", "v": "PHẠM VI CÔNG CỘNG", "at": 59.2}, "t0": 59.2, "t1": 65.28}, {"type": "kinetic", "items": [{"text": "“ĐI ĐI, ĐỢI ĐÃ!”", "at": 65.28, "acc": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "104px", "left": "140px"}}}, {"text": "chuyện là thế này", "at": 69.56, "sm": true, "fx": "blur", "L": {"cls": "kC", "style": {"top": "407px", "fontSize": "58px", "left": "310px"}}}], "t0": 65.28, "t1": 70.76, "lay": "ladder"}, {"type": "ledger", "title": "LỖI LAN NHƯ MỘT CĂN BỆNH", "srcnote": "LOS ALAMOS FROM BELOW (FEYNMAN, 1976) · VÍ DỤ CỦA CHÍNH FEYNMAN", "rows": [{"k": "MỘT LỖI", "v": "HỎNG VÀI THẺ LÂN CẬN", "at": 75.145}, {"k": "MỖI VÒNG", "v": "LAN RỘNG THÊM", "at": 76.755}, {"k": "VÍ DỤ", "v": "50 THẺ · LỖI Ở THẺ 39", "at": 79.32}], "t0": 70.76, "t1": 83.48}, {"type": "timeline", "bg": "ibm601", "items": [{"year": "1", "text": "tách *xấp nhỏ* ≈ 10 thẻ", "at": 83.48}, {"year": "2", "text": "chạy *nhanh hơn* · đuổi kịp", "at": 88.04}, {"year": "3", "text": "*vá vào* xấp lớn", "at": 90.525}], "t0": 83.48, "t1": 92.4}, {"type": "kinetic", "items": [{"text": "MÀU THẺ THỨ HAI, THỨ BA", "at": 92.4, "fx": "flicker", "L": {"style": {"top": "282px", "fontSize": "60px"}}, "D": [{"kind": "rule", "style": {"top": "561px"}, "at": 94.465}]}, {"text": "= NHỮNG XẤP VÁ", "at": 94.365, "acc": true, "fx": "marker", "L": {"style": {"top": "382px", "fontSize": "162px"}}}, {"text": "sếp bước vào · bị đuổi ra", "at": 95.36, "sm": true, "fx": "rise", "L": {"style": {"top": "600px", "fontSize": "64px"}}}], "t0": 92.4, "t1": 99.52, "lay": "hero"}, {"type": "slam", "text": "XONG KỊP HẠN", "sub": "BÀI TOÁN CHO THIẾT KẾ SẼ ĐEM THỬ", "t0": 99.52, "t1": 101.72, "at": 99.67, "fx": "slice"}, {"type": "source", "source": "N. LEWIS · “TRINITY BY THE NUMBERS”", "ref": "LANL · LA-UR-20-30196", "snippet": "mô phỏng cho thấy thiết kế lõi đặc sẽ cho [[sức nổ tốt]] · ban lãnh đạo chọn thiết kế ấy để chế tạo", "hlAt": 106.055, "seal": "DIỄN Ý TỪ BÀI NGHIÊN CỨU", "sealAt": 107.48, "t0": 101.72, "t1": 110.04}, {"type": "date", "day": "QUAY LẠI NGỌN ĐỒI", "date": "16.07.1945", "sub": {"text": "05:29:45 MWT", "at": 110.88}, "t0": 110.04, "t1": 114.06, "dayAt": 110.19000000000001, "groupAt": [110.44000000000001, 110.74000000000001, 111.04]}], "prog0": 0.60944, "prog1": 0.68894};
motion/hf/assets/long\mim-google-maps-kal007\ch03\data.js:1:window.CASE = {"topic": "mim-google-maps-kal007", "ch": "ch03", "dur": 92.14, "seed": 28768, "accent": "#34d399", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 03", "t": "LỜI HỨA NGÀY 16 THÁNG 9"}, "acc": ["thước", "nấc", "lệch", "GPS", "miễn", "nhoè", "chấm", "hướng"], "lines": [{"text": "Tám giờ tối ngày 5 tháng 9 năm 1983, Reagan lên sóng truyền hình toàn quốc từ Phòng Bầu Dục.", "start": 0.0, "end": 5.76, "words": [{"w": "Tám", "t": 0.045, "d": 0.215}, {"w": "giờ", "t": 0.26, "d": 0.205}, {"w": "tối", "t": 0.465, "d": 0.22}, {"w": "ngày", "t": 0.685, "d": 0.175}, {"w": "5", "t": 0.86, "d": 0.16}, {"w": "tháng", "t": 1.02, "d": 0.155}, {"w": "9", "t": 1.175, "d": 0.345}, {"w": "năm", "t": 1.52, "d": 0.14}, {"w": "1983,", "t": 1.66, "d": 1.535}, {"w": "Reagan", "t": 3.195, "d": 0.265}, {"w": "lên", "t": 3.46, "d": 0.145}, {"w": "sóng", "t": 3.605, "d": 0.135}, {"w": "truyền", "t": 3.74, "d": 0.355}, {"w": "hình", "t": 4.095, "d": 0.23}, {"w": "toàn", "t": 4.325, "d": 0.08}, {"w": "quốc", "t": 4.405, "d": 0.325}, {"w": "từ", "t": 4.73, "d": 0.08}, {"w": "Phòng", "t": 4.81, "d": 0.29}, {"w": "Bầu", "t": 5.1, "d": 0.2}, {"w": "Dục.", "t": 5.3, "d": 0.285}]}, {"text": "Ông gọi vụ bắn là một tội ác chống lại loài người.", "start": 6.56, "end": 9.04, "words": [{"w": "Ông", "t": 6.605, "d": 0.14}, {"w": "gọi", "t": 6.745, "d": 0.16}, {"w": "vụ", "t": 6.905, "d": 0.145}, {"w": "bắn", "t": 7.05, "d": 0.195}, {"w": "là", "t": 7.245, "d": 0.31}, {"w": "một", "t": 7.555, "d": 0.055}, {"w": "tội", "t": 7.61, "d": 0.14}, {"w": "ác", "t": 7.75, "d": 0.325}, {"w": "chống", "t": 8.075, "d": 0.06}, {"w": "lại", "t": 8.135, "d": 0.165}, {"w": "loài", "t": 8.3, "d": 0.195}, {"w": "người.", "t": 8.495, "d": 0.32}]}, {"text": "Rồi ông nói một câu về chiếc máy tính dẫn đường trên máy bay.", "start": 9.36, "end": 12.72, "words": [{"w": "Rồi", "t": 9.425, "d": 0.24}, {"w": "ông", "t": 9.665, "d": 0.095}, {"w": "nói", "t": 9.76, "d": 0.385}, {"w": "một", "t": 10.145, "d": 0.225}, {"w": "câu", "t": 10.37, "d": 0.215}, {"w": "về", "t": 10.585, "d": 0.195}, {"w": "chiếc", "t": 10.78, "d": 0.23}, {"w": "máy", "t": 11.01, "d": 0.065}, {"w": "tính", "t": 11.075, "d": 0.36}, {"w": "dẫn", "t": 11.435, "d": 0.09}, {"w": "đường", "t": 11.525, "d": 0.15}, {"w": "trên", "t": 11.675, "d": 0.4}, {"w": "máy", "t": 12.075, "d": 0.125}, {"w": "bay.", "t": 12.2, "d": 0.335}]}, {"text": "Một chiếc máy tính phải đáp lại những gì bàn tay con người đưa vào.", "start": 13.72, "end": 17.24, "words": [{"w": "Một", "t": 13.78, "d": 0.14}, {"w": "chiếc", "t": 13.92, "d": 0.165}, {"w": "máy", "t": 14.085, "d": 0.215}, {"w": "tính", "t": 14.3, "d": 0.225}, {"w": "phải", "t": 14.525, "d": 0.3}, {"w": "đáp", "t": 14.825, "d": 0.06}, {"w": "lại", "t": 14.885, "d": 0.205}, {"w": "những", "t": 15.09, "d": 0.24}, {"w": "gì", "t": 15.33, "d": 0.165}, {"w": "bàn", "t": 15.495, "d": 0.255}, {"w": "tay", "t": 15.75, "d": 0.235}, {"w": "con", "t": 15.985, "d": 0.175}, {"w": "người", "t": 16.16, "d": 0.21}, {"w": "đưa", "t": 16.37, "d": 0.06}, {"w": "vào.", "t": 16.43, "d": 0.365}]}, {"text": "Sẽ không ai biết được là đã nhầm khi nhập đường bay cho máy, hay là máy trục trặc.", "start": 17.56, "end": 21.96, "words": [{"w": "Sẽ", "t": 17.71, "d": 0.125}, {"w": "không", "t": 17.835, "d": 0.345}, {"w": "ai", "t": 18.18, "d": 0.16}, {"w": "biết", "t": 18.34, "d": 0.185}, {"w": "được", "t": 18.525, "d": 0.205}, {"w": "là", "t": 18.73, "d": 0.15}, {"w": "đã", "t": 18.88, "d": 0.265}, {"w": "nhầm", "t": 19.145, "d": 0.06}, {"w": "khi", "t": 19.205, "d": 0.28}, {"w": "nhập", "t": 19.485, "d": 0.24}, {"w": "đường", "t": 19.725, "d": 0.195}, {"w": "bay", "t": 19.92, "d": 0.06}, {"w": "cho", "t": 19.98, "d": 0.155}, {"w": "máy,", "t": 20.135, "d": 0.41}, {"w": "hay", "t": 20.545, "d": 0.11}, {"w": "là", "t": 20.655, "d": 0.345}, {"w": "máy", "t": 21.0, "d": 0.065}, {"w": "trục", "t": 21.065, "d": 0.205}, {"w": "trặc.", "t": 21.27, "d": 0.34}]}, {"text": "Mười năm sau, hộp đen cho thấy máy không hề trục trặc.", "start": 22.96, "end": 25.68, "words": [{"w": "Mười", "t": 22.96, "d": 0.26}, {"w": "năm", "t": 23.22, "d": 0.21}, {"w": "sau,", "t": 23.43, "d": 0.31}, {"w": "hộp", "t": 23.74, "d": 0.065}, {"w": "đen", "t": 23.805, "d": 0.24}, {"w": "cho", "t": 24.045, "d": 0.175}, {"w": "thấy", "t": 24.22, "d": 0.13}, {"w": "máy", "t": 24.35, "d": 0.245}, {"w": "không", "t": 24.595, "d": 0.22}, {"w": "hề", "t": 24.815, "d": 0.17}, {"w": "trục", "t": 24.985, "d": 0.21}, {"w": "trặc.", "t": 25.195, "d": 0.335}]}, {"text": "Lỗi nằm ở cách dùng máy.", "start": 26.0, "end": 27.36, "words": [{"w": "Lỗi", "t": 26.045, "d": 0.175}, {"w": "nằm", "t": 26.22, "d": 0.195}, {"w": "ở", "t": 26.415, "d": 0.14}, {"w": "cách", "t": 26.555, "d": 0.155}, {"w": "dùng", "t": 26.71, "d": 0.115}, {"w": "máy.", "t": 26.825, "d": 0.315}]}, {"text": "Mười một ngày sau bài phát biểu, ngày 16 tháng 9, Nhà Trắng ra một tuyên bố.", "start": 27.68, "end": 32.08, "words": [{"w": "Mười", "t": 27.73, "d": 0.27}, {"w": "một", "t": 28.0, "d": 0.21}, {"w": "ngày", "t": 28.21, "d": 0.125}, {"w": "sau", "t": 28.335, "d": 0.15}, {"w": "bài", "t": 28.485, "d": 0.375}, {"w": "phát", "t": 28.86, "d": 0.21}, {"w": "biểu,", "t": 29.07, "d": 0.155}, {"w": "ngày", "t": 29.225, "d": 0.365}, {"w": "16", "t": 29.59, "d": 0.36}, {"w": "tháng", "t": 29.95, "d": 0.29}, {"w": "9,", "t": 30.24, "d": 0.165}, {"w": "Nhà", "t": 30.405, "d": 0.2}, {"w": "Trắng", "t": 30.605, "d": 0.24}, {"w": "ra", "t": 30.845, "d": 0.285}, {"w": "một", "t": 31.13, "d": 0.285}, {"w": "tuyên", "t": 31.415, "d": 0.055}, {"w": "bố.", "t": 31.47, "d": 0.4}]}, {"text": "Người đọc nó không phải Reagan, mà là phó thư ký báo chí Larry Speakes, trong buổi họp báo trưa.", "start": 32.4, "end": 37.04, "words": [{"w": "Người", "t": 32.4, "d": 0.155}, {"w": "đọ