AI NHẬN GIẢI", "t0": 81.0, "t1": 82.92, "at": 81.15, "fx": "zoom"}, {"type": "kinetic", "items": [{"text": "NGÔI SAO KHÔNG PHẢI THỨ QUÝ NHẤT", "at": 82.92, "sm": true, "fx": "rise"}, {"text": "NHỮNG GIÂY BẠN DỪNG LẠI", "at": 83.32, "acc": true, "fx": "flicker", "em": "NHỮNG"}], "t0": 82.92, "t1": 87.32, "lay": "stack"}, {"type": "broll", "vid": "v14", "veil": 0.5, "illus": "VIDEO MINH HỌA", "kin": [{"text": "MÁY KHÔNG HIỂU BẠN NHƯ MỘT NGƯỜI BẠN", "at": 87.32, "sm": true, "fx": "blur"}, {"text": "BẠN GIỐNG AI · BẠN DỪNG Ở ĐÂU", "at": 89.04, "acc": true, "fx": "marker", "em": "GIỐNG"}], "t0": 87.32, "t1": 91.72}, {"type": "slam", "text": "DỪNG LẠI ĐÚNG CHỖ", "sub": "KHÔNG CẦN GHÉT THUẬT TOÁN", "t0": 91.72, "t1": 96.44, "at": 91.87, "fx": "slice"}, {"type": "question", "text": "Video gần nhất khiến bạn nghĩ\n“sao nó biết mình thích cái này”?", "t0": 96.44, "t1": 102.24}, {"type": "broll", "vid": "v17", "ms": 12, "veil": 0.4, "illus": "VIDEO MINH HỌA", "kin": [{"text": "KỂ Ở PHẦN BÌNH LUẬN", "at": 102.24, "acc": true, "fx": "glitch", "em": "PHẦN"}], "t0": 102.24, "t1": 105.58}, {"type": "endcard", "t0": 105.58, "t1": 125.58, "bg": null, "sub": null}], "prog0": 0.86728, "prog1": 1.0};
motion/hf/assets/long\mim-qwerty\ch01\data.js:1:window.CASE = {"topic": "mim-qwerty", "ch": "ch01", "dur": 44.62, "seed": 9632, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 01", "t": "CHIẾC MÁY CỦA ÔNG CHỦ NHÀ IN"}, "acc": ["qwerty", "chậm", "tội", "phím", "thắng", "dvorak", "telex"], "lines": [{"text": "Bị cáo sinh ra ở thành phố Milwaukee, nước Mỹ, cuối những năm 1860.", "start": 0.0, "end": 4.32, "words": [{"w": "Bị", "t": 0.0, "d": 0.25}, {"w": "cáo", "t": 0.25, "d": 0.19}, {"w": "sinh", "t": 0.44, "d": 0.17}, {"w": "ra", "t": 0.61, "d": 0.11}, {"w": "ở", "t": 0.72, "d": 0.205}, {"w": "thành", "t": 0.925, "d": 0.17}, {"w": "phố", "t": 1.095, "d": 0.29}, {"w": "Milwaukee,", "t": 1.385, "d": 0.355}, {"w": "nước", "t": 1.74, "d": 0.185}, {"w": "Mỹ,", "t": 1.925, "d": 0.205}, {"w": "cuối", "t": 2.13, "d": 0.36}, {"w": "những", "t": 2.49, "d": 0.165}, {"w": "năm", "t": 2.655, "d": 0.06}, {"w": "1860.", "t": 2.715, "d": 1.395}]}, {"text": "Cha đẻ của nó là Christopher Sholes, một người làm nghề in.", "start": 5.12, "end": 8.4, "words": [{"w": "Cha", "t": 5.12, "d": 0.22}, {"w": "đẻ", "t": 5.34, "d": 0.14}, {"w": "của", "t": 5.48, "d": 0.42}, {"w": "nó", "t": 5.9, "d": 0.255}, {"w": "là", "t": 6.155, "d": 0.235}, {"w": "Christopher", "t": 6.39, "d": 0.2}, {"w": "Sholes,", "t": 6.59, "d": 0.41}, {"w": "một", "t": 7.0, "d": 0.12}, {"w": "người", "t": 7.12, "d": 0.145}, {"w": "làm", "t": 7.265, "d": 0.23}, {"w": "nghề", "t": 7.495, "d": 0.33}, {"w": "in.", "t": 7.825, "d": 0.39}]}, {"text": "Lúc đầu, ông chỉ định làm một cái máy đánh số trang sách.", "start": 9.4, "end": 12.44, "words": [{"w": "Lúc", "t": 9.4, "d": 0.105}, {"w": "đầu,", "t": 9.505, "d": 0.495}, {"w": "ông", "t": 10.0, "d": 0.095}, {"w": "chỉ", "t": 10.095, "d": 0.24}, {"w": "định", "t": 10.335, "d": 0.255}, {"w": "làm", "t": 10.59, "d": 0.2}, {"w": "một", "t": 10.79, "d": 0.2}, {"w": "cái", "t": 10.99, "d": 0.145}, {"w": "máy", "t": 11.135, "d": 0.255}, {"w": "đánh", "t": 11.39, "d": 0.21}, {"w": "số", "t": 11.6, "d": 0.2}, {"w": "trang", "t": 11.8, "d": 0.06}, {"w": "sách.", "t": 11.86, "d": 0.375}]}, {"text": "Một người bạn gợi ý: sao không cho nó in luôn cả chữ?", "start": 12.76, "end": 15.56, "words": [{"w": "Một", "t": 12.76, "d": 0.125}, {"w": "người", "t": 12.885, "d": 0.315}, {"w": "bạn", "t": 13.2, "d": 0.065}, {"w": "gợi", "t": 13.265, "d": 0.14}, {"w": "ý:", "t": 13.405, "d": 0.45}, {"w": "sao", "t": 13.855, "d": 0.06}, {"w": "không", "t": 13.915, "d": 0.21}, {"w": "cho", "t": 14.125, "d": 0.15}, {"w": "nó", "t": 14.275, "d": 0.28}, {"w": "in", "t": 14.555, "d": 0.115}, {"w": "luôn", "t": 14.67, "d": 0.28}, {"w": "cả", "t": 14.95, "d": 0.185}, {"w": "chữ?", "t": 15.135, "d": 0.215}]}, {"text": "Mẫu máy đầu tiên có bàn phím giống phím đàn piano.", "start": 16.16, "end": 18.88, "words": [{"w": "Mẫu", "t": 16.16, "d": 0.225}, {"w": "máy", "t": 16.385, "d": 0.18}, {"w": "đầu", "t": 16.565, "d": 0.335}, {"w": "tiên", "t": 16.9, "d": 0.11}, {"w": "có", "t": 17.01, "d": 0.205}, {"w": "bàn", "t": 17.215, "d": 0.185}, {"w": "phím", "t": 17.4, "d": 0.37}, {"w": "giống", "t": 17.77, "d": 0.055}, {"w": "phím", "t": 17.825, "d": 0.21}, {"w": "đàn", "t": 18.035, "d": 0.22}, {"w": "piano.", "t": 18.255, "d": 0.425}]}, {"text": "Và các chữ cái được xếp theo đúng thứ tự A, B, C, thành hai hàng.", "start": 19.2, "end": 23.04, "words": [{"w": "Và", "t": 19.24, "d": 0.125}, {"w": "các", "t": 19.365, "d": 0.33}, {"w": "chữ", "t": 19.695, "d": 0.195}, {"w": "cái", "t": 19.89, "d": 0.1}, {"w": "được", "t": 19.99, "d": 0.275}, {"w": "xếp", "t": 20.265, "d": 0.06}, {"w": "theo", "t": 20.325, "d": 0.315}, {"w": "đúng", "t": 20.64, "d": 0.135}, {"w": "thứ", "t": 20.775, "d": 0.135}, {"w": "tự", "t": 20.91, "d": 0.355}, {"w": "A,", "t": 21.265, "d": 0.16}, {"w": "B,", "t": 21.425, "d": 0.46}, {"w": "C,", "t": 21.885, "d": 0.14}, {"w": "thành", "t": 22.025, "d": 0.33}, {"w": "hai", "t": 22.355, "d": 0.15}, {"w": "hàng.", "t": 22.505, "d": 0.31}]}, {"text": "Tức là lúc mới ra đời, bàn phím từng xếp đúng như bạn mong.", "start": 24.04, "end": 26.92, "words": [{"w": "Tức", "t": 24.04, "d": 0.22}, {"w": "là", "t": 24.26, "d": 0.12}, {"w": "lúc", "t": 24.38, "d": 0.175}, {"w": "mới", "t": 24.555, "d": 0.15}, {"w": "ra", "t": 24.705, "d": 0.275}, {"w": "đời,", "t": 24.98, "d": 0.26}, {"w": "bàn", "t": 25.24, "d": 0.055}, {"w": "phím", "t": 25.295, "d": 0.195}, {"w": "từng", "t": 25.49, "d": 0.22}, {"w": "xếp", "t": 25.71, "d": 0.22}, {"w": "đúng", "t": 25.93, "d": 0.12}, {"w": "như", "t": 26.05, "d": 0.145}, {"w": "bạn", "t": 26.195, "d": 0.275}, {"w": "mong.", "t": 26.47, "d": 0.215}]}, {"text": "Rồi suốt khoảng năm năm, Sholes cứ sửa đi sửa lại.", "start": 27.24, "end": 30.04, "words": [{"w": "Rồi", "t": 27.31, "d": 0.225}, {"w": "suốt", "t": 27.535, "d": 0.145}, {"w": "khoảng", "t": 27.68, "d": 0.2}, {"w": "năm", "t": 27.88, "d": 0.335}, {"w": "năm,", "t": 28.215, "d": 0.295}, {"w": "Sholes", "t": 28.51, "d": 0.095}, {"w": "cứ", "t": 28.605, "d": 0.295}, {"w": "sửa", "t": 28.9, "d": 0.225}, {"w": "đi", "t": 29.125, "d": 0.185}, {"w": "sửa", "t": 29.31, "d": 0.19}, {"w": "lại.", "t": 29.5, "d": 0.375}]}, {"text": "Chữ này chuyển lên hàng trên. Chữ kia đổi sang bên phải.", "start": 30.36, "end": 33.24, "words": [{"w": "Chữ", "t": 30.36, "d": 0.29}, {"w": "này", "t": 30.65, "d": 0.165}, {"w": "chuyển", "t": 30.815, "d": 0.165}, {"w": "lên", "t": 30.98, "d": 0.215}, {"w": "hàng", "t": 31.195, "d": 0.27}, {"w": "trên.", "t": 31.465, "d": 0.295}, {"w": "Chữ", "t": 31.76, "d": 0.1}, {"w": "kia", "t": 31.86, "d": 0.265}, {"w": "đổi", "t": 32.125, "d": 0.2}, {"w": "sang", "t": 32.325, "d": 0.25}, {"w": "bên", "t": 32.575, "d": 0.24}, {"w": "phải.", "t": 32.815, "d": 0.245}]}, {"text": "Đến năm 1873, bố cục ấy đã gần giống thứ đang nằm dưới tay bạn.", "start": 33.56, "end": 37.8, "words": [{"w": "Đến", "t": 33.56, "d": 0.18}, {"w": "năm", "t": 33.74, "d": 0.18}, {"w": "1873,", "t": 33.92, "d": 1.36}, {"w": "bố", "t": 35.28, "d": 0.145}, {"w": "cục", "t": 35.425, "d": 0.21}, {"w": "ấy", "t": 35.635, "d": 0.13}, {"w": "đã", "t": 35.765, "d": 0.18}, {"w": "gần", "t": 35.945, "d": 0.27}, {"w": "giống", "t": 36.215, "d": 0.1}, {"w": "thứ", "t": 36.315, "d": 0.17}, {"w": "đang", "t": 36.485, "d": 0.245}, {"w": "nằm", "t": 36.73, "d": 0.15}, {"w": "dưới", "t": 36.88, "d": 0.24}, {"w": "tay", "t": 37.12, "d": 0.15}, {"w": "bạn.", "t": 37.27, "d": 0.31}]}, {"text": "Câu hỏi là: ông sửa để làm gì?", "start": 38.8, "end": 40.56, "words": [{"w": "Câu", "t": 38.8, "d": 0.1}, {"w": "hỏi", "t": 38.9, "d": 0.32}, {"w": "là:", "t": 39.22, "d": 0.13}, {"w": "ông", "t": 39.35, "d": 0.17}, {"w": "sửa", "t": 39.52, "d": 0.205}, {"w": "để", "t": 39.725, "d": 0.235}, {"w": "làm", "t": 39.96, "d": 0.215}, {"w": "gì?", "t": 40.175, "d": 0.22}]}, {"text": "Và đây chính là lời buộc tội thứ nhất.", "start": 41.16, "end": 43.4, "words": [{"w": "Và", "t": 41.16, "d": 0.235}, {"w": "đây", "t": 41.395, "d": 0.125}, {"w": "chính", "t": 41.52, "d": 0.37}, {"w": "là", "t": 41.89, "d": 0.185}, {"w": "lời", "t": 42.075, "d": 0.2}, {"w": "buộc", "t": 42.275, "d": 0.38}, {"w": "tội", "t": 42.655, "d": 0.235}, {"w": "thứ", "t": 42.89, "d": 0.075}, {"w": "nhất.", "t": 42.965, "d": 0.435}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "1", "k": "CHƯƠNG MỘT", "title": "CHIẾC MÁY CỦA\nÔNG CHỦ NHÀ IN", "sub": "MILWAUKEE · CUỐI NHỮNG NĂM 1860", "vid": "v0", "illus": "VIDEO MINH HỌA", "titleAt": 0.0, "t0": 0.0, "t1": 5.12}, {"type": "ledger", "title": "CHA ĐẺ CỦA BỊ CÁO", "rows": [{"k": "TÊN", "v": "CHRISTOPHER SHOLES", "at": 6.39}, {"k": "NGHỀ", "v": "LÀM NGHỀ IN", "at": 7.0}, {"k": "Ý ĐỊNH", "v": "MÁY ĐÁNH SỐ TRANG SÁCH", "at": 9.4}], "total": {"k": "GỢI Ý", "v": "SAO KHÔNG IN CẢ CHỮ?", "at": 13.855}, "t0": 5.12, "t1": 16.16}, {"type": "broll", "vid": "v2", "veil": 0.45, "illus": "VIDEO MINH HỌA", "kin": [{"text": "BÀN PHÍM NHƯ PHÍM ĐÀN PIANO", "at": 17.215, "acc": true, "fx": "outline", "em": "PIANO"}], "t0": 16.16, "t1": 19.2}, {"type": "keyboard", "layout": "abc", "hl": "ABCDEFG", "hlAt": 21.265, "hlGap": 0.22, "label": {"k": "MẪU ĐẦU TIÊN: THEO THỨ TỰ A B C", "v": "BÀN PHÍM DO KÊNH TỰ VẼ · THEO MÔ TẢ", "at": 19.2}, "t0": 19.2, "t1": 27.24}, {"type": "counter", "from": 0, "to": 5, "prefix": "~", "suffix": " NĂM", "until": 28.215, "label": "SỬA ĐI SỬA LẠI BỐ CỤC PHÍM", "sub": {"text": "chữ này lên hàng trên · chữ kia sang phải", "at": 30.36}, "t0": 27.24, "t1": 33.56, "at": 27.439999999999998}, {"type": "keyboard", "layout": "qwerty", "hl": "QWERTYUIOP", "hlAt": 35.28, "hlGap": 0.1, "label": {"k": "NĂM 1873: GẦN GIỐNG HÔM NAY", "v": "BÀN PHÍM DO KÊNH TỰ VẼ", "at": 33.56}, "t0": 33.56, "t1": 38.8}, {"type": "question", "text": "Ông sửa để làm gì?", "t0": 38.8, "t1": 44.62}], "prog0": 0.08909, "prog1": 0.17607};
motion/hf/assets/long\mim-watson-jeopardy\ch06\data.js:1:window.CASE = {"topic": "mim-watson-jeopardy", "ch": "ch06", "dur": 51.26, "seed": 26206, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "THANH 01", "t": "HIỂU CÂU HỎI"}, "acc": ["watson", "toronto", "tự", "tin", "máy", "chắc", "thắng", "sai"], "lines": [{"text": "Vậy Watson trả lời một câu hỏi như thế nào?", "start": 0.0, "end": 2.88, "words": [{"w": "Vậy", "t": 0.1, "d": 0.305}, {"w": "Watson", "t": 0.405, "d": 0.31}, {"w": "trả", "t": 0.715, "d": 0.16}, {"w": "lời", "t": 0.875, "d": 0.345}, {"w": "một", "t": 1.22, "d": 0.17}, {"w": "câu", "t": 1.39, "d": 0.34}, {"w": "hỏi", "t": 1.73, "d": 0.315}, {"w": "như", "t": 2.045, "d": 0.18}, {"w": "thế", "t": 2.225, "d": 0.22}, {"w": "nào?", "t": 2.445, "d": 0.435}]}, {"text": "Nó không hiểu theo cách bạn hiểu.", "start": 3.68, "end": 5.04, "words": [{"w": "Nó", "t": 3.68, "d": 0.105}, {"w": "không", "t": 3.785, "d": 0.145}, {"w": "hiểu", "t": 3.93, "d": 0.21}, {"w": "theo", "t": 4.14, "d": 0.185}, {"w": "cách", "t": 4.325, "d": 0.115}, {"w": "bạn", "t": 4.44, "d": 0.15}, {"w": "hiểu.", "t": 4.59, "d": 0.23}]}, {"text": "Nó làm một việc khác: tạo ra rất nhiều đáp án, rồi chấm điểm từng cái.", "start": 5.36, "end": 8.8, "words": [{"w": "Nó", "t": 5.36, "d": 0.185}, {"w": "làm", "t": 5.545, "d": 0.17}, {"w": "một", "t": 5.715, "d": 0.13}, {"w": "việc", "t": 5.845, "d": 0.31}, {"w": "khác:", "t": 6.155, "d": 0.13}, {"w": "tạo", "t": 6.285, "d": 0.335}, {"w": "ra", "t": 6.62, "d": 0.1}, {"w": "rất", "t": 6.72, "d": 0.21}, {"w": "nhiều", "t": 6.93, "d": 0.115}, {"w": "đáp", "t": 7.045, "d": 0.295}, {"w": "án,", "t": 7.34, "d": 0.22}, {"w": "rồi", "t": 7.56, "d": 0.25}, {"w": "chấm", "t": 7.81, "d": 0.12}, {"w": "điểm", "t": 7.93, "d": 0.24}, {"w": "từng", "t": 8.17, "d": 0.145}, {"w": "cái.", "t": 8.315, "d": 0.25}]}, {"text": "Bước một, nó mổ xẻ gợi ý.", "start": 9.8, "end": 11.88, "words": [{"w": "Bước", "t": 9.8, "d": 0.295}, {"w": "một,", "t": 10.095, "d": 0.31}, {"w": "nó", "t": 10.405, "d": 0.07}, {"w": "mổ", "t": 10.475, "d": 0.32}, {"w": "xẻ", "t": 10.795, "d": 0.24}, {"w": "gợi", "t": 11.035, "d": 0.165}, {"w": "ý.", "t": 11.2, "d": 0.32}]}, {"text": "Câu này đang hỏi về một người, một thành phố, hay một năm?", "start": 12.2, "end": 15.32, "words": [{"w": "Câu", "t": 12.245, "d": 0.25}, {"w": "này", "t": 12.495, "d": 0.135}, {"w": "đang", "t": 12.63, "d": 0.2}, {"w": "hỏi", "t": 12.83, "d": 0.255}, {"w": "về", "t": 13.085, "d": 0.06}, {"w": "một", "t": 13.145, "d": 0.32}, {"w": "người,", "t": 13.465, "d": 0.3}, {"w": "một", "t": 13.765, "d": 0.065}, {"w": "thành", "t": 13.83, "d": 0.235}, {"w": "phố,", "t": 14.065, "d": 0.22}, {"w": "hay", "t": 14.285, "d": 0.255}, {"w": "một", "t": 14.54, "d": 0.295}, {"w": "năm?", "t": 14.835, "d": 0.225}]}, {"text": "Những từ nào là quan trọng?", "start": 15.92, "end": 17.84, "words": [{"w": "Những", "t": 15.92, "d": 0.275}, {"w": "từ", "t": 16.195, "d": 0.355}, {"w": "nào", "t": 16.55, "d": 0.355}, {"w": "là", "t": 16.905, "d": 0.3}, {"w": "quan", "t": 17.205, "d": 0.165}, {"w": "trọng?", "t": 17.37, "d": 0.47}]}, {"text": "Bước hai, nó lục tìm trong kho kiến thức của mình.", "start": 18.84, "end": 21.48, "words": [{"w": "Bước", "t": 18.84, "d": 0.105}, {"w": "hai,", "t": 18.945, "d": 0.485}, {"w": "nó", "t": 19.43, "d": 0.095}, {"w": "lục", "t": 19.525, "d": 0.125}, {"w": "tìm", "t": 19.65, "d": 0.275}, {"w": "trong", "t": 19.925, "d": 0.265}, {"w": "kho", "t": 20.19, "d": 0.215}, {"w": "kiến", "t": 20.405, "d": 0.2}, {"w": "thức", "t": 20.605, "d": 0.195}, {"w": "của", "t": 20.8, "d": 0.14}, {"w": "mình.", "t": 20.94, "d": 0.29}]}, {"text": "Khoảng hai trăm triệu trang văn bản: bách khoa toàn thư, từ điển, sách, báo.", "start": 21.8, "end": 25.56, "words": [{"w": "Khoảng", "t": 21.8, "d": 0.105}, {"w": "hai", "t": 21.905, "d": 0.295}, {"w": "trăm", "t": 22.2, "d": 0.145}, {"w": "triệu", "t": 22.345, "d": 0.165}, {"w": "trang", "t": 22.51, "d": 0.36}, {"w": "văn", "t": 22.87, "d": 0.2}, {"w": "bản:", "t": 23.07, "d": 0.155}, {"w": "bách", "t": 23.225, "d": 0.21}, {"w": "khoa", "t": 23.435, "d": 0.215}, {"w": "toàn", "t": 23.65, "d": 0.185}, {"w": "thư,", "t": 23.835, "d": 0.325}, {"w": "từ", "t": 24.16, "d": 0.33}, {"w": "điển,", "t": 24.49, "d": 0.165}, {"w": "sách,", "t": 24.655, "d": 0.37}, {"w": "báo.", "t": 25.025, "d": 0.335}]}, {"text": "Tất cả được nạp sẵn vào bộ nhớ, để tìm cho nhanh.", "start": 25.88, "end": 28.68, "words": [{"w": "Tất", "t": 25.93, "d": 0.155}, {"w": "cả", "t": 26.085, "d": 0.28}, {"w": "được", "t": 26.365, "d": 0.185}, {"w": "nạp", "t": 26.55, "d": 0.075}, {"w": "sẵn", "t": 26.625, "d": 0.2}, {"w": "vào", "t": 26.825, "d": 0.275}, {"w": "bộ", "t": 27.1, "d": 0.265}, {"w": "nhớ,", "t": 27.365, "d": 0.3}, {"w": "để", "t": 27.665, "d": 0.055}, {"w": "tìm", "t": 27.72, "d": 0.235}, {"w": "cho", "t": 27.955, "d": 0.195}, {"w": "nhanh.", "t": 28.15, "d": 0.34}]}, {"text": "Từ đó, nó gom ra hàng trăm đáp án có thể.", "start": 29.68, "end": 32.08, "words": [{"w": "Từ", "t": 29.68, "d": 0.1}, {"w": "đó,", "t": 29.78, "d": 0.45}, {"w": "nó", "t": 30.23, "d": 0.075}, {"w": "gom", "t": 30.305, "d": 0.13}, {"w": "ra", "t": 30.435, "d": 0.315}, {"w": "hàng", "t": 30.75, "d": 0.15}, {"w": "trăm", "t": 30.9, "d": 0.19}, {"w": "đáp", "t": 31.09, "d": 0.165}, {"w": "án", "t": 31.255, "d": 0.13}, {"w": "có", "t": 31.385, "d": 0.205}, {"w": "thể.", "t": 31.59, "d": 0.32}]}, {"text": "Bước ba, nó đi tìm bằng chứng cho từng đáp án.", "start": 32.4, "end": 34.8, "words": [{"w": "Bước", "t": 32.4, "d": 0.095}, {"w": "ba,", "t": 32.495, "d": 0.415}, {"w": "nó", "t": 32.91, "d": 0.12}, {"w": "đi", "t": 33.03, "d": 0.27}, {"w": "tìm", "t": 33.3, "d": 0.175}, {"w": "bằng", "t": 33.475, "d": 0.185}, {"w": "chứng", "t": 33.66, "d": 0.18}, {"w": "cho", "t": 33.84, "d": 0.175}, {"w": "từng", "t": 34.015, "d": 0.18}, {"w": "đáp", "t": 34.195, "d": 0.14}, {"w": "án.", "t": 34.335, "d": 0.255}]}, {"text": "Đáp án này có khớp với thời gian trong gợi ý không? Có khớp với địa điểm không?", "start": 35.12, "end": 39.2, "words": [{"w": "Đáp", "t": 35.215, "d": 0.205}, {"w": "án", "t": 35.42, "d": 0.23}, {"w": "này", "t": 35.65, "d": 0.185}, {"w": "có", "t": 35.835, "d": 0.18}, {"w": "khớp", "t": 36.015, "d": 0.185}, {"w": "với", "t": 36.2, "d": 0.18}, {"w": "thời", "t": 36.38, "d": 0.27}, {"w": "gian", "t": 36.65, "d": 0.175}, {"w": "trong", "t": 36.825, "d": 0.23}, {"w": "gợi", "t": 37.055, "d": 0.225}, {"w": "ý", "t": 37.28, "d": 0.17}, {"w": "không?", "t": 37.45, "d": 0.245}, {"w": "Có", "t": 37.695, "d": 0.125}, {"w": "khớp", "t": 37.82, "d": 0.22}, {"w": "với", "t": 38.04, "d": 0.18}, {"w": "địa", "t": 38.22, "d": 0.355}, {"w": "điểm", "t": 38.575, "d": 0.19}, {"w": "không?", "t": 38.765, "d": 0.25}]}, {"text": "Mỗi phép thử cho ra một con số.", "start": 40.2, "end": 42.68, "words": [{"w": "Mỗi", "t": 40.2, "d": 0.345}, {"w": "phép", "t": 40.545, "d": 0.225}, {"w": "thử", "t": 40.77, "d": 0.185}, {"w": "cho", "t": 40.955, "d": 0.365}, {"w": "ra", "t": 41.32, "d": 0.44}, {"w": "một", "t": 41.76, "d": 0.285}, {"w": "con", "t": 42.045, "d": 0.19}, {"w": "số.", "t": 42.235, "d": 0.435}]}, {"text": "Cuối cùng, tất cả được gộp lại, thành một điểm duy nhất cho mỗi đáp án.", "start": 43.0, "end": 46.6, "words": [{"w": "Cuối", "t": 43.0, "d": 0.265}, {"w": "cùng,", "t": 43.265, "d": 0.285}, {"w": "tất", "t": 43.55, "d": 0.065}, {"w": "cả", "t": 43.615, "d": 0.185}, {"w": "được", "t": 43.8, "d": 0.265}, {"w": "gộp", "t": 44.065, "d": 0.115}, {"w": "lại,", "t": 44.18, "d": 0.435}, {"w": "thành", "t": 44.615, "d": 0.06}, {"w": "một", "t": 44.675, "d": 0.26}, {"w": "điểm", "t": 44.935, "d": 0.135}, {"w": "duy", "t": 45.07, "d": 0.225}, {"w": "nhất", "t": 45.295, "d": 0.255}, {"w": "cho", "t": 45.55, "d": 0.095}, {"w": "mỗi", "t": 45.645, "d": 0.28}, {"w": "đáp", "t": 45.925, "d": 0.135}, {"w": "án.", "t": 46.06, "d": 0.275}]}, {"text": "Và đây là phần quan trọng nhất: điểm ấy chính là độ tự tin.", "start": 46.92, "end": 50.04, "words": [{"w": "Và", "t": 46.98, "d": 0.115}, {"w": "đây", "t": 47.095, "d": 0.3}, {"w": "là", "t": 47.395, "d": 0.2}, {"w": "phần", "t": 47.595, "d": 0.175}, {"w": "quan", "t": 47.77, "d": 0.12}, {"w": "trọng", "t": 47.89, "d": 0.29}, {"w": "nhất:", "t": 48.18, "d": 0.14}, {"w": "điểm", "t": 48.32, "d": 0.245}, {"w": "ấy", "t": 48.565, "d": 0.29}, {"w": "chính", "t": 48.855, "d": 0.075}, {"w": "là", "t": 48.93, "d": 0.3}, {"w": "độ", "t": 49.23, "d": 0.19}, {"w": "tự", "t": 49.42, "d": 0.17}, {"w": "tin.", "t": 49.59, "d": 0.24}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "6", "k": "THANH THỨ NHẤT", "title": "HIỂU CÂU HỎI", "sub": "TẠO RẤT NHIỀU ĐÁP ÁN, RỒI CHẤM ĐIỂM", "vid": "v0", "illus": "VIDEO MINH HỌA · KHÔNG PHẢI HÌNH ẢNH CHƯƠNG TRÌNH", "titleAt": 0.1, "t0": 0.0, "t1": 3.68}, {"type": "myth", "mythLab": "WATSON KHÔNG", "myth": "HIỂU NHƯ BẠN HIỂU", "truthLab": "NÓ", "truth": "TẠO NHIỀU ĐÁP ÁN · CHẤM ĐIỂM", "strikeAt": 5.36, "truthAt": 6.285, "t0": 3.68, "t1": 9.8}, {"type": "timeline", "items": [{"year": "BƯỚC 1", "text": "mổ xẻ gợi ý: hỏi về người, nơi chốn hay năm?", "at": 9.8}, {"year": "BƯỚC 2", "text": "lục tìm trong kho kiến thức", "at": 18.84}, {"year": "BƯỚC 3", "text": "tìm bằng chứng cho từng đáp án", "at": 32.4}], "t0": 9.8, "t1": 21.8}, {"type": "counter", "from": 200, "to": 200, "suffix": " TRIỆU", "label": "TRANG VĂN BẢN · NẠP SẴN VÀO BỘ NHỚ", "sub": {"text": "BÁCH KHOA TOÀN THƯ · TỪ ĐIỂN · SÁCH · BÁO", "at": 21.8}, "t0": 21.8, "t1": 29.68, "at": 22.0, "until": 23.8}, {"type": "bars", "title": "HÀNG TRĂM ĐÁP ÁN CÓ THỂ → MỖI CÁI MỘT ĐIỂM", "unit": "MINH HOẠ CÁCH WATSON HIỆN ĐÁP ÁN · KHÔNG PHẢI SỐ ĐO THẬT", "items": [{"k": "ĐÁP ÁN A", "v": 72, "lbl": "72%", "at": 40.2, "acc": true}, {"k": "ĐÁP ÁN B", "v": 21, "lbl": "21%", "at": 40.955}, {"k": "ĐÁP ÁN C", "v": 7, "lbl": "7%", "at": 43.0}], "t0": 29.68, "t1": 46.92}, {"type": "slam", "text": "ĐIỂM ẤY = ĐỘ TỰ TIN", "sub": "PHẦN QUAN TRỌNG NHẤT", "subAt": 14, "t0": 46.92, "t1": 51.26, "at": 47.07, "fx": "zoom"}], "prog0": 0.30101, "prog1": 0.35046};
motion/hf/assets/long\mim-flappy-bird\ch03\data.js:1:window.CASE = {"topic": "mim-flappy-bird", "ch": "ch03", "dur": 46.34, "seed": 17101, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 03", "t": "VÌ SAO KHÓ BỎ"}, "acc": ["flappy", "bird", "gỡ", "giờ", "đô", "ngủ", "nghiện"], "lines": [{"text": "Hãy thử nhìn trò chơi này như một cỗ máy.", "start": 0.0, "end": 2.4, "words": [{"w": "Hãy", "t": 0.0, "d": 0.11}, {"w": "thử", "t": 0.11, "d": 0.385}, {"w": "nhìn", "t": 0.495, "d": 0.195}, {"w": "trò", "t": 0.69, "d": 0.175}, {"w": "chơi", "t": 0.865, "d": 0.25}, {"w": "này", "t": 1.115, "d": 0.155}, {"w": "như", "t": 1.27, "d": 0.09}, {"w": "một", "t": 1.36, "d": 0.37}, {"w": "cỗ", "t": 1.73, "d": 0.06}, {"w": "máy.", "t": 1.79, "d": 0.39}]}, {"text": "Phần này là cách kênh mình diễn giải, không phải lời của tác giả.", "start": 3.2, "end": 6.24, "words": [{"w": "Phần", "t": 3.235, "d": 0.1}, {"w": "này", "t": 3.335, "d": 0.255}, {"w": "là", "t": 3.59, "d": 0.15}, {"w": "cách", "t": 3.74, "d": 0.21}, {"w": "kênh", "t": 3.95, "d": 0.18}, {"w": "mình", "t": 4.13, "d": 0.18}, {"w": "diễn", "t": 4.31, "d": 0.29}, {"w": "giải,", "t": 4.6, "d": 0.21}, {"w": "không", "t": 4.81, "d": 0.11}, {"w": "phải", "t": 4.92, "d": 0.19}, {"w": "lời", "t": 5.11, "d": 0.195}, {"w": "của", "t": 5.305, "d": 0.235}, {"w": "tác", "t": 5.54, "d": 0.18}, {"w": "giả.", "t": 5.72, "d": 0.315}]}, {"text": "Thứ nhất, luật chơi học trong một giây. Chỉ có một nút bấm.", "start": 7.24, "end": 10.36, "words": [{"w": "Thứ", "t": 7.305, "d": 0.275}, {"w": "nhất,", "t": 7.58, "d": 0.265}, {"w": "luật", "t": 7.845, "d": 0.065}, {"w": "chơi", "t": 7.91, "d": 0.215}, {"w": "học", "t": 8.125, "d": 0.345}, {"w": "trong", "t": 8.47, "d": 0.06}, {"w": "một", "t": 8.53, "d": 0.23}, {"w": "giây.", "t": 8.76, "d": 0.405}, {"w": "Chỉ", "t": 9.165, "d": 0.065}, {"w": "có", "t": 9.23, "d": 0.27}, {"w": "một", "t": 9.5, "d": 0.245}, {"w": "nút", "t": 9.745, "d": 0.16}, {"w": "bấm.", "t": 9.905, "d": 0.265}]}, {"text": "Thứ hai, nó rất khó. Phần lớn các ván kết thúc sau vài giây.", "start": 10.68, "end": 14.36, "words": [{"w": "Thứ", "t": 10.68, "d": 0.14}, {"w": "hai,", "t": 10.82, "d": 0.405}, {"w": "nó", "t": 11.225, "d": 0.3}, {"w": "rất", "t": 11.525, "d": 0.125}, {"w": "khó.", "t": 11.65, "d": 0.51}, {"w": "Phần", "t": 12.16, "d": 0.16}, {"w": "lớn", "t": 12.32, "d": 0.125}, {"w": "các", "t": 12.445, "d": 0.185}, {"w": "ván", "t": 12.63, "d": 0.41}, {"w": "kết", "t": 13.04, "d": 0.16}, {"w": "thúc", "t": 13.2, "d": 0.22}, {"w": "sau", "t": 13.42, "d": 0.115}, {"w": "vài", "t": 13.535, "d": 0.335}, {"w": "giây.", "t": 13.87, "d": 0.34}]}, {"text": "Thứ ba, thua xong, chạm một cái là chơi lại ngay. Không chờ, không tốn gì.", "start": 14.68, "end": 19.0, "words": [{"w": "Thứ", "t": 14.725, "d": 0.115}, {"w": "ba,", "t": 14.84, "d": 0.47}, {"w": "thua", "t": 15.31, "d": 0.25}, {"w": "xong,", "t": 15.56, "d": 0.375}, {"w": "chạm", "t": 15.935, "d": 0.06}, {"w": "một", "t": 15.995, "d": 0.29}, {"w": "cái", "t": 16.285, "d": 0.21}, {"w": "là", "t": 16.495, "d": 0.3}, {"w": "chơi", "t": 16.795, "d": 0.06}, {"w": "lại", "t": 16.855, "d": 0.275}, {"w": "ngay.", "t": 17.13, "d": 0.43}, {"w": "Không", "t": 17.56, "d": 0.185}, {"w": "chờ,", "t": 17.745, "d": 0.26}, {"w": "không", "t": 18.005, "d": 0.255}, {"w": "tốn", "t": 18.26, "d": 0.175}, {"w": "gì.", "t": 18.435, "d": 0.38}]}, {"text": "Ghép ba thứ ấy lại.", "start": 20.0, "end": 21.76, "words": [{"w": "Ghép", "t": 20.0, "d": 0.335}, {"w": "ba", "t": 20.335, "d": 0.28}, {"w": "thứ", "t": 20.615, "d": 0.46}, {"w": "ấy", "t": 21.075, "d": 0.27}, {"w": "lại.", "t": 21.345, "d": 0.41}]}, {"text": "Mỗi lần thua, bạn đều thấy mình suýt làm được.", "start": 22.08, "end": 24.8, "words": [{"w": "Mỗi", "t": 22.12, "d": 0.33}, {"w": "lần", "t": 22.45, "d": 0.245}, {"w": "thua,", "t": 22.695, "d": 0.35}, {"w": "bạn", "t": 23.045, "d": 0.185}, {"w": "đều", "t": 23.23, "d": 0.32}, {"w": "thấy", "t": 23.55, "d": 0.185}, {"w": "mình", "t": 23.735, "d": 0.21}, {"w": "suýt", "t": 23.945, "d": 0.32}, {"w": "làm", "t": 24.265, "d": 0.24}, {"w": "được.", "t": 24.505, "d": 0.28}]}, {"text": "Và lần thử tiếp theo chỉ cách đúng một cú chạm.", "start": 25.12, "end": 27.28, "words": [{"w": "Và", "t": 25.155, "d": 0.23}, {"w": "lần", "t": 25.385, "d": 0.06}, {"w": "thử", "t": 25.445, "d": 0.175}, {"w": "tiếp", "t": 25.62, "d": 0.14}, {"w": "theo", "t": 25.76, "d": 0.265}, {"w": "chỉ", "t": 26.025, "d": 0.15}, {"w": "cách", "t": 26.175, "d": 0.16}, {"w": "đúng", "t": 26.335, "d": 0.185}, {"w": "một", "t": 26.52, "d": 0.165}, {"w": "cú", "t": 26.685, "d": 0.16}, {"w": "chạm.", "t": 26.845, "d": 0.195}]}, {"text": "Thêm một thứ nữa. Điểm số.", "start": 28.28, "end": 29.96, "words": [{"w": "Thêm", "t": 28.28, "d": 0.205}, {"w": "một", "t": 28.485, "d": 0.125}, {"w": "thứ", "t": 28.61, "d": 0.39}, {"w": "nữa.", "t": 29.0, "d": 0.2}, {"w": "Điểm", "t": 29.2, "d": 0.315}, {"w": "số.", "t": 29.515, "d": 0.285}]}, {"text": "Một con số nhỏ, rất dễ đem khoe, và rất dễ làm người khác ngứa tay muốn vượt.", "start": 30.28, "end": 35.08, "words": [{"w": "Một", "t": 30.28, "d": 0.265}, {"w": "con", "t": 30.545, "d": 0.155}, {"w": "số", "t": 30.7, "d": 0.38}, {"w": "nhỏ,", "t": 31.08, "d": 0.375}, {"w": "rất", "t": 31.455, "d": 0.06}, {"w": "dễ", "t": 31.515, "d": 0.235}, {"w": "đem", "t": 31.75, "d": 0.395}, {"w": "khoe,", "t": 32.145, "d": 0.365}, {"w": "và", "t": 32.51, "d": 0.235}, {"w": "rất", "t": 32.745, "d": 0.06}, {"w": "dễ", "t": 32.805, "d": 0.315}, {"w": "làm", "t": 33.12, "d": 0.35}, {"w": "người", "t": 33.47, "d": 0.23}, {"w": "khác", "t": 33.7, "d": 0.235}, {"w": "ngứa", "t": 33.935, "d": 0.13}, {"w": "tay", "t": 34.065, "d": 0.305}, {"w": "muốn", "t": 34.37, "d": 0.215}, {"w": "vượt.", "t": 34.585, "d": 0.33}]}, {"text": "Giới phê bình thì không mấy thiện cảm.", "start": 36.08, "end": 37.76, "words": [{"w": "Giới", "t": 36.08, "d": 0.13}, {"w": "phê", "t": 36.21, "d": 0.135}, {"w": "bình", "t": 36.345, "d": 0.235}, {"w": "thì", "t": 36.58, "d": 0.15}, {"w": "không", "t": 36.73, "d": 0.23}, {"w": "mấy", "t": 36.96, "d": 0.15}, {"w": "thiện", "t": 37.11, "d": 0.185}, {"w": "cảm.", "t": 37.295, "d": 0.195}]}, {"text": "Điểm trung bình các bài đánh giá chỉ khoảng năm mươi hai trên một trăm.", "start": 38.08, "end": 42.08, "words": [{"w": "Điểm", "t": 38.08, "d": 0.21}, {"w": "trung", "t": 38.29, "d": 0.37}, {"w": "bình", "t": 38.66, "d": 0.11}, {"w": "các", "t": 38.77, "d": 0.335}, {"w": "bài", "t": 39.105, "d": 0.285}, {"w": "đánh", "t": 39.39, "d": 0.245}, {"w": "giá", "t": 39.635, "d": 0.275}, {"w": "chỉ", "t": 39.91, "d": 0.23}, {"w": "khoảng", "t": 40.14, "d": 0.205}, {"w": "năm", "t": 40.345, "d": 0.41}, {"w": "mươi", "t": 40.755, "d": 0.26}, {"w": "hai", "t": 41.015, "d": 0.26}, {"w": "trên", "t": 41.275, "d": 0.09}, {"w": "một", "t": 41.365, "d": 0.305}, {"w": "trăm.", "t": 41.67, "d": 0.415}]}, {"text": "Nhưng người chơi không chấm điểm. Họ chỉ bấm chơi lại.", "start": 42.4, "end": 45.12, "words": [{"w": "Nhưng", "t": 42.435, "d": 0.29}, {"w": "người", "t": 42.725, "d": 0.06}, {"w": "chơi", "t": 42.785, "d": 0.205}, {"w": "không", "t": 42.99, "d": 0.21}, {"w": "chấm", "t": 43.2, "d": 0.34}, {"w": "điểm.", "t": 43.54, "d": 0.25}, {"w": "Họ", "t": 43.79, "d": 0.1}, {"w": "chỉ", "t": 43.89, "d": 0.205}, {"w": "bấm", "t": 44.095, "d": 0.265}, {"w": "chơi", "t": 44.36, "d": 0.225}, {"w": "lại.", "t": 44.585, "d": 0.335}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "3", "k": "CHƯƠNG BA", "title": "VÌ SAO\nKHÓ BỎ", "sub": "DIỄN GIẢI CỦA KÊNH · KHÔNG PHẢI LỜI TÁC GIẢ", "vid": "v0", "illus": "VIDEO MINH HỌA", "titleAt": 0.0, "t0": 0.0, "t1": 7.24}, {"type": "ledger", "title": "BA BÁNH RĂNG", "srcnote": "DIỄN GIẢI CỦA KÊNH", "rows": [{"k": "1", "v": "HỌC TRONG MỘT GIÂY · MỘT NÚT BẤM", "at": 7.24}, {"k": "2", "v": "RẤT KHÓ · VÀI GIÂY LÀ THUA", "at": 10.68}, {"k": "3", "v": "CHƠI LẠI NGAY · KHÔNG CHỜ", "at": 14.68}], "t0": 7.24, "t1": 20.0}, {"type": "flap", "crashAt": 23.945, "speed": 300, "label": {"k": "“SUÝT LÀM ĐƯỢC”", "v": "HÌNH MINH HOẠ DO KÊNH TỰ VẼ · KHÔNG PHẢI HÌNH CỦA TRÒ CHƠI", "at": 23.945}, "t0": 20.0, "t1": 25.12}, {"type": "kinetic", "items": [{"text": "LẦN THỬ TIẾP THEO", "at": 25.12, "sm": true, "fx": "blur", "L": {"style": {"top": "428px", "fontSize": "54px"}}, "D": [{"kind": "frame", "style": {"top": "352px", "height": "313px", "width": "1267px", "left": "327px"}, "at": 24.82}]}, {"text": "CÁCH ĐÚNG MỘT CÚ CHẠM", "at": 25.52, "acc": true, "fx": "rise", "L": {"style": {"top": "500px", "fontSize": "85px"}}, "em": "CÁCH"}], "t0": 25.12, "t1": 28.28, "lay": "frame"}, {"type": "counter", "from": 0, "to": 12, "until": 32.145, "label": "ĐIỂM SỐ: NHỎ · DỄ KHOE · DỄ GÂY NGỨA TAY", "sub": {"text": "CON SỐ MINH HOẠ", "at": 28.28}, "t0": 28.28, "t1": 36.08, "at": 28.48}, {"type": "bars", "title": "GIỚI PHÊ BÌNH CHẤM", "unit": "", "items": [{"k": "ĐIỂM TRUNG BÌNH CÁC BÀI ĐÁNH GIÁ", "v": 52, "lbl": "52 / 100", "at": 40.345, "acc": true}, {"k": "THANG ĐIỂM", "v": 100, "lbl": "100", "at": 36.08}], "label": {"k": "NGUỒN", "v": "METACRITIC · 7 BÀI", "at": 36.08}, "t0": 36.08, "t1": 42.4}, {"type": "slam", "text": "CHƠI LẠI", "sub": "NGƯỜI CHƠI KHÔNG CHẤM ĐIỂM", "t0": 42.4, "t1": 46.34, "at": 42.55, "fx": "zoom"}], "prog0": 0.40629, "prog1": 0.52718};
motion/hf/assets/long\mim-watson-jeopardy\ch04\data.js:1:window.CASE = {"topic": "mim-watson-jeopardy", "ch": "ch04", "dur": 51.58, "seed": 26160, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 04", "t": "MỘT TIẾNG CHUÔNG"}, "acc": ["watson", "toronto", "tự", "tin", "máy", "chắc", "thắng", "sai"], "lines": [{"text": "Nếu bạn lớn lên ở Việt Nam, có lẽ bạn đã quen với một hình ảnh tương tự.", "start": 0.0, "end": 4.0, "words": [{"w": "Nếu", "t": 0.0, "d": 0.225}, {"w": "bạn", "t": 0.225, "d": 0.255}, {"w": "lớn", "t": 0.48, "d": 0.195}, {"w": "lên", "t": 0.675, "d": 0.06}, {"w": "ở", "t": 0.735, "d": 0.265}, {"w": "Việt", "t": 1.0, "d": 0.27}, {"w": "Nam,", "t": 1.27, "d": 0.295}, {"w": "có", "t": 1.565, "d": 0.12}, {"w": "lẽ", "t": 1.685, "d": 0.125}, {"w": "bạn", "t": 1.81, "d": 0.245}, {"w": "đã", "t": 2.055, "d": 0.325}, {"w": "quen", "t": 2.38, "d": 0.06}, {"w": "với", "t": 2.44, "d": 0.32}, {"w": "một", "t": 2.76, "d": 0.19}, {"w": "hình", "t": 2.95, "d": 0.185}, {"w": "ảnh", "t": 3.135, "d": 0.185}, {"w": "tương", "t": 3.32, "d": 0.175}, {"w": "tự.", "t": 3.495, "d": 0.31}]}, {"text": "Những học sinh đứng sau bục, tay đặt sẵn trên nút bấm, chờ câu hỏi của Đường lên đỉnh Olympia.", "start": 4.8, "end": 9.76, "words": [{"w": "Những", "t": 4.8, "d": 0.22}, {"w": "học", "t": 5.02, "d": 0.31}, {"w": "sinh", "t": 5.33, "d": 0.065}, {"w": "đứng", "t": 5.395, "d": 0.365}, {"w": "sau", "t": 5.76, "d": 0.21}, {"w": "bục,", "t": 5.97, "d": 0.365}, {"w": "tay", "t": 6.335, "d": 0.095}, {"w": "đặt", "t": 6.43, "d": 0.215}, {"w": "sẵn", "t": 6.645, "d": 0.265}, {"w": "trên", "t": 6.91, "d": 0.305}, {"w": "nút", "t": 7.215, "d": 0.19}, {"w": "bấm,", "t": 7.405, "d": 0.23}, {"w": "chờ", "t": 7.635, "d": 0.365}, {"w": "câu", "t": 8.0, "d": 0.19}, {"w": "hỏi", "t": 8.19, "d": 0.2}, {"w": "của", "t": 8.39, "d": 0.255}, {"w": "Đường", "t": 8.645, "d": 0.18}, {"w": "lên", "t": 8.825, "d": 0.27}, {"w": "đỉnh", "t": 9.095, "d": 0.07}, {"w": "Olympia.", "t": 9.165, "d": 0.41}]}, {"text": "Ai bấm trước, người ấy được trả lời.", "start": 10.08, "end": 11.68, "words": [{"w": "Ai", "t": 10.125, "d": 0.125}, {"w": "bấm", "t": 10.25, "d": 0.155}, {"w": "trước,", "t": 10.405, "d": 0.255}, {"w": "người", "t": 10.66, "d": 0.08}, {"w": "ấy", "t": 10.74, "d": 0.265}, {"w": "được", "t": 11.005, "d": 0.125}, {"w": "trả", "t": 11.13, "d": 0.145}, {"w": "lời.", "t": 11.275, "d": 0.215}]}, {"text": "Jeopardy cũng vậy, chỉ là gay cấn hơn.", "start": 12.68, "end": 15.16, "words": [{"w": "Jeopardy", "t": 12.745, "d": 0.155}, {"w": "cũng", "t": 12.9, "d": 0.315}, {"w": "vậy,", "t": 13.215, "d": 0.475}, {"w": "chỉ", "t": 13.69, "d": 0.195}, {"w": "là", "t": 13.885, "d": 0.1}, {"w": "gay", "t": 13.985, "d": 0.355}, {"w": "cấn", "t": 14.34, "d": 0.175}, {"w": "hơn.", "t": 14.515, "d": 0.45}]}, {"text": "Người chơi chỉ được bấm sau khi người dẫn đọc xong gợi ý.", "start": 15.48, "end": 18.12, "words": [{"w": "Người", "t": 15.48, "d": 0.105}, {"w": "chơi", "t": 15.585, "d": 0.235}, {"w": "chỉ", "t": 15.82, "d": 0.215}, {"w": "được", "t": 16.035, "d": 0.24}, {"w": "bấm", "t": 16.275, "d": 0.185}, {"w": "sau", "t": 16.46, "d": 0.06}, {"w": "khi", "t": 16.52, "d": 0.26}, {"w": "người", "t": 16.78, "d": 0.135}, {"w": "dẫn", "t": 16.915, "d": 0.24}, {"w": "đọc", "t": 17.155, "d": 0.19}, {"w": "xong", "t": 17.345, "d": 0.105}, {"w": "gợi", "t": 17.45, "d": 0.21}, {"w": "ý.", "t": 17.66, "d": 0.28}]}, {"text": "Bấm sớm một chút, chuông bị khoá trong một khoảnh khắc ngắn.", "start": 18.44, "end": 21.32, "words": [{"w": "Bấm", "t": 18.485, "d": 0.195}, {"w": "sớm", "t": 18.68, "d": 0.26}, {"w": "một", "t": 18.94, "d": 0.225}, {"w": "chút,", "t": 19.165, "d": 0.305}, {"w": "chuông", "t": 19.47, "d": 0.06}, {"w": "bị", "t": 19.53, "d": 0.36}, {"w": "khoá", "t": 19.89, "d": 0.205}, {"w": "trong", "t": 20.095, "d": 0.09}, {"w": "một", "t": 20.185, "d": 0.31}, {"w": "khoảnh", "t": 20.495, "d": 0.06}, {"w": "khắc", "t": 20.555, "d": 0.305}, {"w": "ngắn.", "t": 20.86, "d": 0.275}]}, {"text": "Nên những nhà vô địch không chỉ giỏi kiến thức. Họ giỏi canh nhịp.", "start": 21.64, "end": 24.52, "words": [{"w": "Nên", "t": 21.675, "d": 0.24}, {"w": "những", "t": 21.915, "d": 0.185}, {"w": "nhà", "t": 22.1, "d": 0.105}, {"w": "vô", "t": 22.205, "d": 0.135}, {"w": "địch", "t": 22.34, "d": 0.205}, {"w": "không", "t": 22.545, "d": 0.16}, {"w": "chỉ", "t": 22.705, "d": 0.19}, {"w": "giỏi", "t": 22.895, "d": 0.14}, {"w": "kiến", "t": 23.035, "d": 0.29}, {"w": "thức.", "t": 23.325, "d": 0.16}, {"w": "Họ", "t": 23.485, "d": 0.145}, {"w": "giỏi", "t": 23.63, "d": 0.265}, {"w": "canh", "t": 23.895, "d": 0.155}, {"w": "nhịp.", "t": 24.05, "d": 0.295}]}, {"text": "Với một cỗ máy, đây là chỗ vừa dễ vừa khó.", "start": 25.52, "end": 27.84, "words": [{"w": "Với", "t": 25.52, "d": 0.23}, {"w": "một", "t": 25.75, "d": 0.145}, {"w": "cỗ", "t": 25.895, "d": 0.21}, {"w": "máy,", "t": 26.105, "d": 0.235}, {"w": "đây", "t": 26.34, "d": 0.065}, {"w": "là", "t": 26.405, "d": 0.24}, {"w": "chỗ", "t": 26.645, "d": 0.19}, {"w": "vừa", "t": 26.835, "d": 0.2}, {"w": "dễ", "t": 27.035, "d": 0.17}, {"w": "vừa", "t": 27.205, "d": 0.145}, {"w": "khó.", "t": 27.35, "d": 0.27}]}, {"text": "Dễ, vì máy không bao giờ run tay.", "start": 28.16, "end": 30.32, "words": [{"w": "Dễ,", "t": 28.305, "d": 0.4}, {"w": "vì", "t": 28.705, "d": 0.085}, {"w": "máy", "t": 28.79, "d": 0.14}, {"w": "không", "t": 28.93, "d": 0.35}, {"w": "bao", "t": 29.28, "d": 0.125}, {"w": "giờ", "t": 29.405, "d": 0.16}, {"w": "run", "t": 29.565, "d": 0.335}, {"w": "tay.", "t": 29.9, "d": 0.235}]}, {"text": "Khó, vì nó phải tìm xong đáp án và độ tự tin trong vài giây, trước khi bấm.", "start": 30.64, "end": 34.72, "words": [{"w": "Khó,", "t": 30.64, "d": 0.395}, {"w": "vì", "t": 31.035, "d": 0.065}, {"w": "nó", "t": 31.1, "d": 0.155}, {"w": "phải", "t": 31.255, "d": 0.26}, {"w": "tìm", "t": 31.515, "d": 0.18}, {"w": "xong", "t": 31.695, "d": 0.18}, {"w": "đáp", "t": 31.875, "d": 0.305}, {"w": "án", "t": 32.18, "d": 0.06}, {"w": "và", "t": 32.24, "d": 0.315}, {"w": "độ", "t": 32.555, "d": 0.125}, {"w": "tự", "t": 32.68, "d": 0.205}, {"w": "tin", "t": 32.885, "d": 0.19}, {"w": "trong", "t": 33.075, "d": 0.195}, {"w": "vài", "t": 33.27, "d": 0.19}, {"w": "giây,", "t": 33.46, "d": 0.445}, {"w": "trước", "t": 33.905, "d": 0.08}, {"w": "khi", "t": 33.985, "d": 0.23}, {"w": "bấm.", "t": 34.215, "d": 0.315}]}, {"text": "Sau trận đấu, một số người cho rằng tốc độ bấm chuông của Watson là một lợi thế không công bằng.", "start": 35.72, "end": 40.36, "words": [{"w": "Sau", "t": 35.72, "d": 0.235}, {"w": "trận", "t": 35.955, "d": 0.115}, {"w": "đấu,", "t": 36.07, "d": 0.455}, {"w": "một", "t": 36.525, "d": 0.16}, {"w": "số", "t": 36.685, "d": 0.07}, {"w": "người", "t": 36.755, "d": 0.315}, {"w": "cho", "t": 37.07, "d": 0.115}, {"w": "rằng", "t": 37.185, "d": 0.185}, {"w": "tốc", "t": 37.37, "d": 0.335}, {"w": "độ", "t": 37.705, "d": 0.175}, {"w": "bấm", "t": 37.88, "d": 0.125}, {"w": "chuông", "t": 38.005, "d": 0.2}, {"w": "của", "t": 38.205, "d": 0.21}, {"w": "Watson", "t": 38.415, "d": 0.275}, {"w": "là", "t": 38.69, "d": 0.25}, {"w": "một", "t": 38.94, "d": 0.16}, {"w": "lợi", "t": 39.1, "d": 0.205}, {"w": "thế", "t": 39.305, "d": 0.24}, {"w": "không", "t": 39.545, "d": 0.06}, {"w": "công", "t": 39.605, "d": 0.17}, {"w": "bằng.", "t": 39.775, "d": 0.41}]}, {"text": "Những người khác thì nói: biết nhanh cũng là một phần của trò chơi.", "start": 40.68, "end": 43.8, "words": [{"w": "Những", "t": 40.71, "d": 0.12}, {"w": "người", "t": 40.83, "d": 0.195}, {"w": "khác", "t": 41.025, "d": 0.19}, {"w": "thì", "t": 41.215, "d": 0.165}, {"w": "nói:", "t": 41.38, "d": 0.475}, {"w": "biết", "t": 41.855, "d": 0.155}, {"w": "nhanh", "t": 42.01, "d": 0.21}, {"w": "cũng", "t": 42.22, "d": 0.205}, {"w": "là", "t": 42.425, "d": 0.125}, {"w": "một", "t": 42.55, "d": 0.255}, {"w": "phần", "t": 42.805, "d": 0.065}, {"w": "của", "t": 42.87, "d": 0.215}, {"w": "trò", "t": 43.085, "d": 0.14}, {"w": "chơi.", "t": 43.225, "d": 0.375}]}, {"text": "Câu hỏi ấy tới nay vẫn còn tranh cãi.", "start": 44.12, "end": 46.84, "words": [{"w": "Câu", "t": 44.12, "d": 0.405}, {"w": "hỏi", "t": 44.525, "d": 0.25}, {"w": "ấy", "t": 44.775, "d": 0.215}, {"w": "tới", "t": 44.99, "d": 0.33}, {"w": "nay", "t": 45.32, "d": 0.09}, {"w": "vẫn", "t": 45.41, "d": 0.325}, {"w": "còn", "t": 45.735, "d": 0.485}, {"w": "tranh", "t": 46.22, "d": 0.28}, {"w": "cãi.", "t": 46.5, "d": 0.335}]}, {"text": "Nhưng trước khi tới được tiếng chuông, Watson phải học cách chơi đã.", "start": 47.16, "end": 50.36, "words": [{"w": "Nhưng", "t": 47.2, "d": 0.185}, {"w": "trước", "t": 47.385, "d": 0.14}, {"w": "khi", "t": 47.525, "d": 0.235}, {"w": "tới", "t": 47.76, "d": 0.315}, {"w": "được", "t": 48.075, "d": 0.165}, {"w": "tiếng", "t": 48.24, "d": 0.315}, {"w": "chuông,", "t": 48.555, "d": 0.245}, {"w": "Watson", "t": 48.8, "d": 0.23}, {"w": "phải", "t": 49.03, "d": 0.255}, {"w": "học", "t": 49.285, "d": 0.245}, {"w": "cách", "t": 49.53, "d": 0.215}, {"w": "chơi", "t": 49.745, "d": 0.065}, {"w": "đã.", "t": 49.81, "d": 0.395}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "4", "k": "CHƯƠNG 04", "title": "MỘT TIẾNG CHUÔNG", "sub": "AI BẤM TRƯỚC, NGƯỜI ẤY TRẢ LỜI", "vid": "v0", "illus": "VIDEO MINH HỌA · KHÔNG PHẢI HÌNH ẢNH CHƯƠNG TRÌNH", "titleAt": 0.0, "t0": 0.0, "t1": 4.8}, {"type": "kinetic", "items": [{"text": "ĐƯỜNG LÊN ĐỈNH OLYMPIA", "at": 5.5, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "704px", "fontSize": "85px"}}, "D": [{"kind": "bar", "style": {"top": "704px", "height": "156px"}, "at": 5.25}], "em": "OLYMPIA"}, {"text": "tay đặt sẵn trên nút bấm", "at": 6.335, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "815px", "fontSize": "50px"}}}], "t0": 4.8, "t1": 15.48, "lay": "corner"}, {"type": "timeline", "items": [{"year": "ĐỌC XONG", "text": "người dẫn đọc hết gợi ý", "at": 15.48}, {"year": "BẤM SỚM", "text": "chuông bị khoá trong khoảnh khắc", "at": 18.44}, {"year": "VÔ ĐỊCH", "text": "giỏi kiến thức · giỏi canh nhịp", "at": 21.64}], "t0": 15.48, "t1": 25.52}, {"type": "ledger", "title": "VỚI MỘT CỖ MÁY", "rows": [{"k": "DỄ", "v": "KHÔNG BAO GIỜ RUN TAY", "at": 28.16}, {"k": "KHÓ", "v": "TÌM ĐÁP ÁN TRONG VÀI GIÂY", "at": 30.64}], "t0": 25.52, "t1": 35.72}, {"type": "ledger", "title": "SAU TRẬN: HAI Ý KIẾN", "rows": [{"k": "MỘT SỐ NGƯỜI", "v": "LỢI THẾ KHÔNG CÔNG BẰNG", "at": 35.72}, {"k": "NGƯỜI KHÁC", "v": "BIẾT NHANH LÀ LUẬT CHƠI", "at": 40.68}], "total": {"k": "TỚI NAY", "v": "VẪN CÒN TRANH CÃI", "at": 44.12}, "t0": 35.72, "t1": 51.58}], "prog0": 0.20684, "prog1": 0.25659};
motion/hf/assets/long\mim-ai-khuon-mat\ch00\data.js:1:window.CASE = {"topic": "mim-ai-khuon-mat", "ch": "ch00", "dur": 52.9, "seed": 18615, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "MỞ ĐẦU", "t": "KHUÔN MẶT MƯỜI TRIỆU ĐỒNG"}, "acc": ["khuôn", "mặt", "số", "trạm", "ngưỡng", "nhầm", "máy"], "lines": [{"text": "Bạn mở ứng dụng ngân hàng, gõ một lệnh chuyển mười hai triệu đồng.", "start": 0.0, "end": 2.96, "words": [{"w": "Bạn", "t": 0.0, "d": 0.095}, {"w": "mở", "t": 0.095, "d": 0.315}, {"w": "ứng", "t": 0.41, "d": 0.13}, {"w": "dụng", "t": 0.54, "d": 0.175}, {"w": "ngân", "t": 0.715, "d": 0.255}, {"w": "hàng,", "t": 0.97, "d": 0.285}, {"w": "gõ", "t": 1.255, "d": 0.06}, {"w": "một", "t": 1.315, "d": 0.195}, {"w": "lệnh", "t": 1.51, "d": 0.265}, {"w": "chuyển", "t": 1.775, "d": 0.065}, {"w": "mười", "t": 1.84, "d": 0.175}, {"w": "hai", "t": 2.015, "d": 0.22}, {"w": "triệu", "t": 2.235, "d": 0.18}, {"w": "đồng.", "t": 2.415, "d": 0.31}]}, {"text": "Thay vì một mã số gửi về điện thoại, màn hình hiện lên một khung hình bầu dục.", "start": 3.28, "end": 7.04, "words": [{"w": "Thay", "t": 3.3, "d": 0.115}, {"w": "vì", "t": 3.415, "d": 0.325}, {"w": "một", "t": 3.74, "d": 0.19}, {"w": "mã", "t": 3.93, "d": 0.06}, {"w": "số", "t": 3.99, "d": 0.15}, {"w": "gửi", "t": 4.14, "d": 0.245}, {"w": "về", "t": 4.385, "d": 0.285}, {"w": "điện", "t": 4.67, "d": 0.055}, {"w": "thoại,", "t": 4.725, "d": 0.43}, {"w": "màn", "t": 5.155, "d": 0.13}, {"w": "hình", "t": 5.285, "d": 0.075}, {"w": "hiện", "t": 5.36, "d": 0.29}, {"w": "lên", "t": 5.65, "d": 0.155}, {"w": "một", "t": 5.805, "d": 0.265}, {"w": "khung", "t": 6.07, "d": 0.175}, {"w": "hình", "t": 6.245, "d": 0.125}, {"w": "bầu", "t": 6.37, "d": 0.17}, {"w": "dục.", "t": 6.54, "d": 0.315}]}, {"text": "Đưa khuôn mặt vào đây.", "start": 7.36, "end": 8.4, "words": [{"w": "Đưa", "t": 7.4, "d": 0.14}, {"w": "khuôn", "t": 7.54, "d": 0.11}, {"w": "mặt", "t": 7.65, "d": 0.195}, {"w": "vào", "t": 7.845, "d": 0.1}, {"w": "đây.", "t": 7.945, "d": 0.205}]}, {"text": "Từ ngày một tháng bảy năm hai nghìn không trăm hai mươi tư, đó là chuyện thường ngày ở Việt Nam.", "start": 9.4, "end": 13.32, "words": [{"w": "Từ", "t": 9.445, "d": 0.13}, {"w": "ngày", "t": 9.575, "d": 0.205}, {"w": "một", "t": 9.78, "d": 0.13}, {"w": "tháng", "t": 9.91, "d": 0.16}, {"w": "bảy", "t": 10.07, "d": 0.205}, {"w": "năm", "t": 10.275, "d": 0.145}, {"w": "hai", "t": 10.42, "d": 0.255}, {"w": "nghìn", "t": 10.675, "d": 0.17}, {"w": "không", "t": 10.845, "d": 0.14}, {"w": "trăm", "t": 10.985, "d": 0.135}, {"w": "hai", "t": 11.12, "d": 0.11}, {"w": "mươi", "t": 11.23, "d": 0.28}, {"w": "tư,", "t": 11.51, "d": 0.2}, {"w": "đó", "t": 11.71, "d": 0.09}, {"w": "là", "t": 11.8, "d": 0.285}, {"w": "chuyện", "t": 12.085, "d": 0.19}, {"w": "thường", "t": 12.275, "d": 0.165}, {"w": "ngày", "t": 12.44, "d": 0.105}, {"w": "ở", "t": 12.545, "d": 0.19}, {"w": "Việt", "t": 12.735, "d": 0.135}, {"w": "Nam.", "t": 12.87, "d": 0.27}]}, {"text": "Theo quy định của Ngân hàng Nhà nước, chuyển tiền trực tuyến trên mười triệu đồng một lần phải xác thực bằng sinh trắc học.", "start": 13.64, "end": 18.68, "words": [{"w": "Theo", "t": 13.69, "d": 0.135}, {"w": "quy", "t": 13.825, "d": 0.265}, {"w": "định", "t": 14.09, "d": 0.225}, {"w": "của", "t": 14.315, "d": 0.16}, {"w": "Ngân", "t": 14.475, "d": 0.18}, {"w": "hàng", "t": 14.655, "d": 0.21}, {"w": "Nhà", "t": 14.865, "d": 0.185}, {"w": "nước,", "t": 15.05, "d": 0.14}, {"w": "chuyển", "t": 15.19, "d": 0.285}, {"w": "tiền", "t": 15.475, "d": 0.155}, {"w": "trực", "t": 15.63, "d": 0.165}, {"w": "tuyến", "t": 15.795, "d": 0.225}, {"w": "trên", "t": 16.02, "d": 0.15}, {"w": "mười", "t": 16.17, "d": 0.225}, {"w": "triệu", "t": 16.395, "d": 0.155}, {"w": "đồng", "t": 16.55, "d": 0.17}, {"w": "một", "t": 16.72, "d": 0.115}, {"w": "lần", "t": 16.835, "d": 0.285}, {"w": "phải", "t": 17.12, "d": 0.125}, {"w": "xác", "t": 17.245, "d": 0.285}, {"w": "thực", "t": 17.53, "d": 0.175}, {"w": "bằng", "t": 17.705, "d": 0.205}, {"w": "sinh", "t": 17.91, "d": 0.14}, {"w": "trắc", "t": 18.05, "d": 0.165}, {"w": "học.", "t": 18.215, "d": 0.28}]}, {"text": "Và rất nhiều người chọn cách nhanh nhất: khuôn mặt.", "start": 19.0, "end": 21.32, "words": [{"w": "Và", "t": 19.06, "d": 0.24}, {"w": "rất", "t": 19.3, "d": 0.19}, {"w": "nhiều", "t": 19.49, "d": 0.18}, {"w": "người", "t": 19.67, "d": 0.195}, {"w": "chọn", "t": 19.865, "d": 0.13}, {"w": "cách", "t": 19.995, "d": 0.165}, {"w": "nhanh", "t": 20.16, "d": 0.25}, {"w": "nhất:", "t": 20.41, "d": 0.275}, {"w": "khuôn", "t": 20.685, "d": 0.065}, {"w": "mặt.", "t": 20.75, "d": 0.35}]}, {"text": "Mỗi ngày, có vô số khuôn mặt được đưa trước một cỗ máy như thế.", "start": 22.32, "end": 25.6, "words": [{"w": "Mỗi", "t": 22.365, "d": 0.115}, {"w": "ngày,", "t": 22.48, "d": 0.355}, {"w": "có", "t": 22.835, "d": 0.115}, {"w": "vô", "t": 22.95, "d": 0.185}, {"w": "số", "t": 23.135, "d": 0.325}, {"w": "khuôn", "t": 23.46, "d": 0.125}, {"w": "mặt", "t": 23.585, "d": 0.27}, {"w": "được", "t": 23.855, "d": 0.06}, {"w": "đưa", "t": 23.915, "d": 0.155}, {"w": "trước", "t": 24.07, "d": 0.23}, {"w": "một", "t": 24.3, "d": 0.195}, {"w": "cỗ", "t": 24.495, "d": 0.23}, {"w": "máy", "t": 24.725, "d": 0.15}, {"w": "như", "t": 24.875, "d": 0.265}, {"w": "thế.", "t": 25.14, "d": 0.24}]}, {"text": "Nhưng ít ai tự hỏi, cỗ máy ấy thật ra đang nhìn gì.", "start": 25.92, "end": 28.72, "words": [{"w": "Nhưng", "t": 26.03, "d": 0.25}, {"w": "ít", "t": 26.28, "d": 0.175}, {"w": "ai", "t": 26.455, "d": 0.17}, {"w": "tự", "t": 26.625, "d": 0.185}, {"w": "hỏi,", "t": 26.81, "d": 0.22}, {"w": "cỗ", "t": 27.03, "d": 0.08}, {"w": "máy", "t": 27.11, "d": 0.265}, {"w": "ấy", "t": 27.375, "d": 0.245}, {"w": "thật", "t": 27.62, "d": 0.15}, {"w": "ra", "t": 27.77, "d": 0.06}, {"w": "đang", "t": 27.83, "d": 0.165}, {"w": "nhìn", "t": 27.995, "d": 0.33}, {"w": "gì.", "t": 28.325, "d": 0.21}]}, {"text": "Nó không nhìn thấy bạn như mẹ bạn nhìn thấy bạn.", "start": 29.72, "end": 31.88, "words": [{"w": "Nó", "t": 29.775, "d": 0.09}, {"w": "không", "t": 29.865, "d": 0.295}, {"w": "nhìn", "t": 30.16, "d": 0.135}, {"w": "thấy", "t": 30.295, "d": 0.14}, {"w": "bạn", "t": 30.435, "d": 0.145}, {"w": "như", "t": 30.58, "d": 0.16}, {"w": "mẹ", "t": 30.74, "d": 0.255}, {"w": "bạn", "t": 30.995, "d": 0.115}, {"w": "nhìn", "t": 31.11, "d": 0.07}, {"w": "thấy", "t": 31.18, "d": 0.225}, {"w": "bạn.", "t": 31.405, "d": 0.28}]}, {"text": "Nó không nhớ nụ cười, cũng không nhớ giọng nói.", "start": 32.2, "end": 34.76, "words": [{"w": "Nó", "t": 32.2, "d": 0.175}, {"w": "không", "t": 32.375, "d": 0.19}, {"w": "nhớ", "t": 32.565, "d": 0.195}, {"w": "nụ", "t": 32.76, "d": 0.35}, {"w": "cười,", "t": 33.11, "d": 0.275}, {"w": "cũng", "t": 33.385, "d": 0.24}, {"w": "không", "t": 33.625, "d": 0.21}, {"w": "nhớ", "t": 33.835, "d": 0.21}, {"w": "giọng", "t": 34.045, "d": 0.15}, {"w": "nói.", "t": 34.195, "d": 0.35}]}, {"text": "Với nó, khuôn mặt bạn là một dãy con số.", "start": 35.08, "end": 37.32, "words": [{"w": "Với", "t": 35.08, "d": 0.105}, {"w": "nó,", "t": 35.185, "d": 0.42}, {"w": "khuôn", "t": 35.605, "d": 0.085}, {"w": "mặt", "t": 35.69, "d": 0.31}, {"w": "bạn", "t": 36.0, "d": 0.19}, {"w": "là", "t": 36.19, "d": 0.16}, {"w": "một", "t": 36.35, "d": 0.17}, {"w": "dãy", "t": 36.52, "d": 0.18}, {"w": "con", "t": 36.7, "d": 0.195}, {"w": "số.", "t": 36.895, "d": 0.24}]}, {"text": "Trong video này, mình sẽ theo chân một tấm ảnh khuôn mặt, từ lúc camera bật lên, tới lúc cỗ máy nói: đúng là bạn.", "start": 38.32, "end": 44.48, "words": [{"w": "Trong", "t": 38.32, "d": 0.115}, {"w": "video", "t": 38.435, "d": 0.25}, {"w": "này,", "t": 38.685, "d": 0.43}, {"w": "mình", "t": 39.115, "d": 0.085}, {"w": "sẽ", "t": 39.2, "d": 0.32}, {"w": "theo", "t": 39.52, "d": 0.215}, {"w": "chân", "t": 39.735, "d": 0.13}, {"w": "một", "t": 39.865, "d": 0.25}, {"w": "tấm", "t": 40.115, "d": 0.315}, {"w": "ảnh", "t": 40.43, "d": 0.125}, {"w": "khuôn", "t": 40.555, "d": 0.32}, {"w": "mặt,", "t": 40.875, "d": 0.165}, {"w": "từ", "t": 41.04, "d": 0.375}, {"w": "lúc", "t": 41.415, "d": 0.145}, {"w": "camera", "t": 41.56, "d": 0.29}, {"w": "bật", "t": 41.85, "d": 0.145}, {"w": "lên,", "t": 41.995, "d": 0.41}, {"w": "tới", "t": 42.405, "d": 0.06}, {"w": "lúc", "t": 42.465, "d": 0.365}, {"w": "cỗ", "t": 42.83, "d": 0.06}, {"w": "máy", "t": 42.89, "d": 0.32}, {"w": "nói:", "t": 43.21, "d": 0.39}, {"w": "đúng", "t": 43.6, "d": 0.19}, {"w": "là", "t": 43.79, "d": 0.06}, {"w": "bạn.", "t": 43.85, "d": 0.425}]}, {"text": "Tấm ảnh ấy sẽ đi qua bốn trạm.", "start": 44.8, "end": 46.4, "words": [{"w": "Tấm", "t": 44.8, "d": 0.23}, {"w": "ảnh", "t": 45.03, "d": 0.165}, {"w": "ấy", "t": 45.195, "d": 0.135}, {"w": "sẽ", "t": 45.33, "d": 0.095}, {"w": "đi", "t": 45.425, "d": 0.175}, {"w": "qua", "t": 45.6, "d": 0.215}, {"w": "bốn", "t": 45.815, "d": 0.205}, {"w": "trạm.", "t": 46.02, "d": 0.195}]}, {"text": "Và ở cuối hành trình, bạn sẽ thấy vì sao cỗ máy làm rất giỏi việc này, mà vẫn có lúc nhầm người.", "start": 46.72, "end": 51.68, "words": [{"w": "Và", "t": 46.72, "d": 0.27}, {"w": "ở", "t": 46.99, "d": 0.06}, {"w": "cuối", "t": 47.05, "d": 0.265}, {"w": "hành", "t": 47.315, "d": 0.255}, {"w": "trình,", "t": 47.57, "d": 0.18}, {"w": "bạn", "t": 47.75, "d": 0.155}, {"w": "sẽ", "t": 47.905, "d": 0.355}, {"w": "thấy", "t": 48.26, "d": 0.195}, {"w": "vì", "t": 48.455, "d": 0.06}, {"w": "sao", "t": 48.515, "d": 0.18}, {"w": "cỗ", "t": 48.695, "d": 0.185}, {"w": "máy", "t": 48.88, "d": 0.18}, {"w": "làm", "t": 49.06, "d": 0.36}, {"w": "rất", "t": 49.42, "d": 0.16}, {"w": "giỏi", "t": 49.58, "d": 0.225}, {"w": "việc", "t": 49.805, "d": 0.13}, {"w": "này,", "t": 49.935, "d": 0.37}, {"w": "mà", "t": 50.305, "d": 0.065}, {"w": "vẫn", "t": 50.37, "d": 0.28}, {"w": "có", "t": 50.65, "d": 0.16}, {"w": "lúc", "t": 50.81, "d": 0.255}, {"w": "nhầm", "t": 51.065, "d": 0.185}, {"w": "người.", "t": 51.25, "d": 0.25}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "broll", "vid": "v0", "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "LỆNH CHUYỂN 12 TRIỆU", "at": 0.0, "sm": true, "fx": "flicker"}, {"text": "MỘT KHUNG BẦU DỤC", "at": 5.155, "acc": true, "fx": "marker", "em": "KHUNG"}, {"text": "đưa khuôn mặt vào đây", "at": 7.36, "sm": true, "fx": "blur"}], "t0": 0.0, "t1": 9.4}, {"type": "source", "source": "QUYẾT ĐỊNH 2345/QĐ-NHNN · HIỆU LỰC 01/07/2024", "ref": "CHUYỂN TIỀN TRỰC TUYẾN", "snippet": "trên [[10 triệu đồng một lần]] phải xác thực bằng sinh trắc học", "hlAt": 16.17, "seal": "THEO BÁO CHÍ", "sealAt": 19.0, "t0": 9.4, "t1": 22.32}, {"type": "broll", "vid": "v2", "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "VÔ SỐ KHUÔN MẶT MỖI NGÀY", "at": 22.32, "sm": true, "fx": "rise"}, {"text": "CỖ MÁY THẬT RA NHÌN GÌ?", "at": 25.92, "acc": true, "fx": "outline", "em": "THẬT"}], "t0": 22.32, "t1": 29.72}, {"type": "myth", "mythLab": "KHÔNG NHÌN NHƯ", "myth": "MẸ BẠN NHÌN BẠN", "truthLab": "VỚI CỖ MÁY", "truth": "MỘT DÃY CON SỐ", "strikeAt": 32.2, "truthAt": 36.35, "t0": 29.72, "t1": 38.32}, {"type": "timeline", "items": [{"year": "TRẠM 1", "text": "tìm khuôn mặt", "at": 38.37}, {"year": "TRẠM 2", "text": "căn cho thẳng", "at": 41.04}, {"year": "TRẠM 3", "text": "biến thành con số", "at": 44.8}, {"year": "TRẠM 4", "text": "đo khoảng cách", "at": 45.815}], "t0": 38.32, "t1": 46.72}, {"type": "kinetic", "items": [{"text": "RẤT GIỎI", "at": 47.42, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "662px", "fontSize": "118px"}}, "D": [{"kind": "bar", "style": {"top": "662px", "height": "198px"}, "at": 47.17}]}, {"text": "mà vẫn có lúc nhầm người", "at": 50.305, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "815px", "fontSize": "50px"}}}], "t0": 46.72, "t1": 52.9, "lay": "corner"}], "prog0": 0.0, "prog1": 0.10268};
motion/hf/assets/long\mim-oppenheimer-feynman\ch08\data.js:1:window.CASE = {"topic": "mim-oppenheimer-feynman", "ch": "ch08", "dur": 114.06, "seed": 36054, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 08", "t": "HẠN CHÓT BA TUẦN"}, "acc": ["số", "khoá", "máy", "người", "thẻ", "mệt", "song", "xúc"], "lines": [{"text": "Gần cuối cuộc chiến, nhà vật lý Robert Christy xuống phòng máy.", "start": 0.0, "end": 3.36, "words": [{"w": "Gần", "t": 0.0, "d": 0.16}, {"w": "cuối", "t": 0.16, "d": 0.305}, {"w": "cuộc", "t": 0.465, "d": 0.345}, {"w": "chiến,", "t": 0.81, "d": 0.18}, {"w": "nhà", "t": 0.99, "d": 0.32}, {"w": "vật", "t": 1.31, "d": 0.265}, {"w": "lý", "t": 1.575, "d": 0.34}, {"w": "Robert", "t": 1.915, "d": 0.07}, {"w": "Christy", "t": 1.985, "d": 0.41}, {"w": "xuống", "t": 2.395, "d": 0.24}, {"w": "phòng", "t": 2.635, "d": 0.185}, {"w": "máy.", "t": 2.82, "d": 0.335}]}, {"text": "Phòng thí nghiệm đã tính cho nhiều thiết kế, nhưng chưa tính riêng cho thiết kế sẽ đem thử.", "start": 4.16, "end": 8.24, "words": [{"w": "Phòng", "t": 4.16, "d": 0.125}, {"w": "thí", "t": 4.285, "d": 0.28}, {"w": "nghiệm", "t": 4.565, "d": 0.255}, {"w": "đã", "t": 4.82, "d": 0.19}, {"w": "tính", "t": 5.01, "d": 0.195}, {"w": "cho", "t": 5.205, "d": 0.16}, {"w": "nhiều", "t": 5.365, "d": 0.125}, {"w": "thiết", "t": 5.49, "d": 0.295}, {"w": "kế,", "t": 5.785, "d": 0.26}, {"w": "nhưng", "t": 6.045, "d": 0.07}, {"w": "chưa", "t": 6.115, "d": 0.275}, {"w": "tính", "t": 6.39, "d": 0.18}, {"w": "riêng", "t": 6.57, "d": 0.175}, {"w": "cho", "t": 6.745, "d": 0.255}, {"w": "thiết", "t": 7.0, "d": 0.175}, {"w": "kế", "t": 7.175, "d": 0.19}, {"w": "sẽ", "t": 7.365, "d": 0.265}, {"w": "đem", "t": 7.63, "d": 0.16}, {"w": "thử.", "t": 7.79, "d": 0.27}]}, {"text": "Theo nghiên cứu của Los Alamos, thiết kế được chọn có lõi đặc, do chính Christy đề xuất từ tháng 9 năm 1944.", "start": 8.56, "end": 15.12, "words": [{"w": "Theo", "t": 8.635, "d": 0.25}, {"w": "nghiên", "t": 8.885, "d": 0.21}, {"w": "cứu", "t": 9.095, "d": 0.24}, {"w": "của", "t": 9.335, "d": 0.06}, {"w": "Los", "t": 9.395, "d": 0.25}, {"w": "Alamos,", "t": 9.645, "d": 0.395}, {"w": "thiết", "t": 10.04, "d": 0.11}, {"w": "kế", "t": 10.15, "d": 0.245}, {"w": "được", "t": 10.395, "d": 0.29}, {"w": "chọn", "t": 10.685, "d": 0.205}, {"w": "có", "t": 10.89, "d": 0.06}, {"w": "lõi", "t": 10.95, "d": 0.245}, {"w": "đặc,", "t": 11.195, "d": 0.435}, {"w": "do", "t": 11.63, "d": 0.085}, {"w": "chính", "t": 11.715, "d": 0.21}, {"w": "Christy", "t": 11.925, "d": 0.23}, {"w": "đề", "t": 12.155, "d": 0.29}, {"w": "xuất", "t": 12.445, "d": 0.175}, {"w": "từ", "t": 12.62, "d": 0.12}, {"w": "tháng", "t": 12.74, "d": 0.325}, {"w": "9", "t": 13.065, "d": 0.15}, {"w": "năm", "t": 13.215, "d": 0.215}, {"w": "1944.", "t": 13.43, "d": 1.515}]}, {"text": "Christy cần kết quả trong chừng một tháng, thậm chí ba tuần.", "start": 15.44, "end": 18.56, "words": [{"w": "Christy", "t": 15.44, "d": 0.3}, {"w": "cần", "t": 15.74, "d": 0.195}, {"w": "kết", "t": 15.935, "d": 0.175}, {"w": "quả", "t": 16.11, "d": 0.155}, {"w": "trong", "t": 16.265, "d": 0.295}, {"w": "chừng", "t": 16.56, "d": 0.175}, {"w": "một", "t": 16.735, "d": 0.3}, {"w": "tháng,", "t": 17.035, "d": 0.37}, {"w": "thậm", "t": 17.405, "d": 0.195}, {"w": "chí", "t": 17.6, "d": 0.06}, {"w": "ba", "t": 17.66, "d": 0.21}, {"w": "tuần.", "t": 17.87, "d": 0.45}]}, {"text": "Feynman đáp: không thể được.", "start": 19.56, "end": 20.92, "words": [{"w": "Feynman", "t": 19.56, "d": 0.25}, {"w": "đáp:", "t": 19.81, "d": 0.35}, {"w": "không", "t": 20.16, "d": 0.105}, {"w": "thể", "t": 20.265, "d": 0.25}, {"w": "được.", "t": 20.515, "d": 0.265}]}, {"text": "Mỗi bài thật ra mất lâu hơn thế nhiều, họ chỉ nhanh vì chạy nhiều bài cùng lúc.", "start": 21.24, "end": 24.84, "words": [{"w": "Mỗi", "t": 21.285, "d": 0.105}, {"w": "bài", "t": 21.39, "d": 0.175}, {"w": "thật", "t": 21.565, "d": 0.16}, {"w": "ra", "t": 21.725, "d": 0.325}, {"w": "mất", "t": 22.05, "d": 0.055}, {"w": "lâu", "t": 22.105, "d": 0.29}, {"w": "hơn", "t": 22.395, "d": 0.06}, {"w": "thế", "t": 22.455, "d": 0.135}, {"w": "nhiều,", "t": 22.59, "d": 0.415}, {"w": "họ", "t": 23.005, "d": 0.085}, {"w": "chỉ", "t": 23.09, "d": 0.18}, {"w": "nhanh", "t": 23.27, "d": 0.14}, {"w": "vì", "t": 23.41, "d": 0.26}, {"w": "chạy", "t": 23.67, "d": 0.135}, {"w": "nhiều", "t": 23.805, "d": 0.14}, {"w": "bài", "t": 23.945, "d": 0.215}, {"w": "cùng", "t": 24.16, "d": 0.195}, {"w": "lúc.", "t": 24.355, "d": 0.26}]}, {"text": "Rồi ông nghĩ lại.", "start": 25.16, "end": 27.4, "words": [{"w": "Rồi", "t": 25.24, "d": 0.675}, {"w": "ông", "t": 25.915, "d": 0.45}, {"w": "nghĩ", "t": 26.365, "d": 0.07}, {"w": "lại.", "t": 26.435, "d": 0.965}]}, {"text": "Nếu dẹp hết, chỉ dồn sức cho một bài thì sao?", "start": 27.72, "end": 30.28, "words": [{"w": "Nếu", "t": 27.72, "d": 0.18}, {"w": "dẹp", "t": 27.9, "d": 0.135}, {"w": "hết,", "t": 28.035, "d": 0.44}, {"w": "chỉ", "t": 28.475, "d": 0.055}, {"w": "dồn", "t": 28.53, "d": 0.205}, {"w": "sức", "t": 28.735, "d": 0.355}, {"w": "cho", "t": 29.09, "d": 0.15}, {"w": "một", "t": 29.24, "d": 0.14}, {"w": "bài", "t": 29.38, "d": 0.295}, {"w": "thì", "t": 29.675, "d": 0.2}, {"w": "sao?", "t": 29.875, "d": 0.23}]}, {"text": "Ông viết lên bảng đen một câu thách cho cả nhóm: ta làm được không?", "start": 31.28, "end": 34.96, "words": [{"w": "Ông", "t": 31.335, "d": 0.165}, {"w": "viết", "t": 31.5, "d": 0.145}, {"w": "lên", "t": 31.645, "d": 0.355}, {"w": "bảng", "t": 32.0, "d": 0.06}, {"w": "đen", "t": 32.06, "d": 0.325}, {"w": "một", "t": 32.385, "d": 0.065}, {"w": "câu", "t": 32.45, "d": 0.325}, {"w": "thách", "t": 32.775, "d": 0.06}, {"w": "cho", "t": 32.835, "d": 0.2}, {"w": "cả", "t": 33.035, "d": 0.155}, {"w": "nhóm:", "t": 33.19, "d": 0.48}, {"w": "ta", "t": 33.67, "d": 0.08}, {"w": "làm", "t": 33.75, "d": 0.205}, {"w": "được", "t": 33.955, "d": 0.295}, {"w": "không?", "t": 34.25, "d": 0.235}]}, {"text": "Họ hò lên: sẽ làm hai ca, làm thêm giờ.", "start": 35.56, "end": 38.12, "words": [{"w": "Họ", "t": 35.56, "d": 0.115}, {"w": "hò", "t": 35.675, "d": 0.365}, {"w": "lên:", "t": 36.04, "d": 0.17}, {"w": "sẽ", "t": 36.21, "d": 0.17}, {"w": "làm", "t": 36.38, "d": 0.32}, {"w": "hai", "t": 36.7, "d": 0.19}, {"w": "ca,", "t": 36.89, "d": 0.35}, {"w": "làm", "t": 37.24, "d": 0.06}, {"w": "thêm", "t": 37.3, "d": 0.24}, {"w": "giờ.", "t": 37.54, "d": 0.36}]}, {"text": "Luật mới: dẹp mọi bài khác, chỉ còn một bài.", "start": 38.44, "end": 41.0, "words": [{"w": "Luật", "t": 38.44, "d": 0.11}, {"w": "mới:", "t": 38.55, "d": 0.5}, {"w": "dẹp", "t": 39.05, "d": 0.065}, {"w": "mọi", "t": 39.115, "d": 0.225}, {"w": "bài", "t": 39.34, "d": 0.31}, {"w": "khác,", "t": 39.65, "d": 0.32}, {"w": "chỉ", "t": 39.97, "d": 0.15}, {"w": "còn", "t": 40.12, "d": 0.17}, {"w": "một", "t": 40.29, "d": 0.28}, {"w": "bài.", "t": 40.57, "d": 0.23}]}, {"text": "Đúng lúc ấy, vợ Feynman qua đời ở Albuquerque.", "start": 42.0, "end": 44.8, "words": [{"w": "Đúng", "t": 42.065, "d": 0.235}, {"w": "lúc", "t": 42.3, "d": 0.36}, {"w": "ấy,", "t": 42.66, "d": 0.35}, {"w": "vợ", "t": 43.01, "d": 0.135}, {"w": "Feynman", "t": 43.145, "d": 0.205}, {"w": "qua", "t": 43.35, "d": 0.435}, {"w": "đời", "t": 43.785, "d": 0.22}, {"w": "ở", "t": 44.005, "d": 0.16}, {"w": "Albuquerque.", "t": 44.165, "d": 0.4}]}, {"text": "Ông phải đi ngay, và mượn xe của một người bạn cùng ký túc xá, tên là Fuchs.", "start": 45.8, "end": 49.8, "words": [{"w": "Ông", "t": 45.845, "d": 0.145}, {"w": "phải", "t": 45.99, "d": 0.225}, {"w": "đi", "t": 46.215, "d": 0.28}, {"w": "ngay,", "t": 46.495, "d": 0.26}, {"w": "và", "t": 46.755, "d": 0.065}, {"w": "mượn", "t": 46.82, "d": 0.34}, {"w": "xe", "t": 47.16, "d": 0.205}, {"w": "của", "t": 47.365, "d": 0.125}, {"w": "một", "t": 47.49, "d": 0.105}, {"w": "người", "t": 47.595, "d": 0.195}, {"w": "bạn", "t": 47.79, "d": 0.245}, {"w": "cùng", "t": 48.035, "d": 0.175}, {"w": "ký", "t": 48.21, "d": 0.15}, {"w": "túc", "t": 48.36, "d": 0.185}, {"w": "xá,", "t": 48.545, "d": 0.455}, {"w": "tên", "t": 49.0, "d": 0.14}, {"w": "là", "t": 49.14, "d": 0.075}, {"w": "Fuchs.", "t": 49.215, "d": 0.39}]}, {"text": "Feynman kể, mãi về sau ông mới biết Fuchs là gián điệp, và từng dùng chính chiếc xe ấy để mang bí mật đi.", "start": 50.12, "end": 55.64, "words": [{"w": "Feynman", "t": 50.165, "d": 0.235}, {"w": "kể,", "t": 50.4, "d": 0.345}, {"w": "mãi", "t": 50.745, "d": 0.12}, {"w": "về", "t": 50.865, "d": 0.28}, {"w": "sau", "t": 51.145, "d": 0.185}, {"w": "ông", "t": 51.33, "d": 0.14}, {"w": "mới", "t": 51.47, "d": 0.32}, {"w": "biết", "t": 51.79, "d": 0.15}, {"w": "Fuchs", "t": 51.94, "d": 0.26}, {"w": "là", "t": 52.2, "d": 0.06}, {"w": "gián", "t": 52.26, "d": 0.23}, {"w": "điệp,", "t": 52.49, "d": 0.465}, {"w": "và", "t": 52.955, "d": 0.205}, {"w": "từng", "t": 53.16, "d": 0.08}, {"w": "dùng", "t": 53.24, "d": 0.195}, {"w": "chính", "t": 53.435, "d": 0.335}, {"w": "chiếc", "t": 53.77, "d": 0.21}, {"w": "xe", "t": 53.98, "d": 0.13}, {"w": "ấy", "t": 54.11, "d": 0.1}, {"w": "để", "t": 54.21, "d": 0.35}, {"w": "mang", "t": 54.56, "d": 0.19}, {"w": "bí", "t": 54.75, "d": 0.2}, {"w": "mật", "t": 54.95, "d": 0.17}, {"w": "đi.", "t": 55.12, "d": 0.33}]}, {"text": "Ba ngày sau, Feynman quay lại phòng máy.", "start": 55.96, "end": 58.2, "words": [{"w": "Ba", "t": 56.005, "d": 0.285}, {"w": "ngày", "t": 56.29, "d": 0.24}, {"w": "sau,", "t": 56.53, "d": 0.245}, {"w": "Feynman", "t": 56.775, "d": 0.21}, {"w": "quay", "t": 56.985, "d": 0.205}, {"w": "lại", "t": 57.19, "d": 0.335}, {"w": "phòng", "t": 57.525, "d": 0.06}, {"w": "máy.", "t": 57.585, "d": 0.415}]}, {"text": "Khắp nơi là thẻ trắng, thẻ xanh, thẻ vàng.", "start": 59.2, "end": 61.68, "words": [{"w": "Khắp", "t": 59.2, "d": 0.11}, {"w": "nơi", "t": 59.31, "d": 0.3}, {"w": "là", "t": 59.61, "d": 0.205}, {"w": "thẻ", "t": 59.815, "d": 0.29}, {"w": "trắng,", "t": 60.105, "d": 0.2}, {"w": "thẻ", "t": 60.305, "d": 0.33}, {"w": "xanh,", "t": 60.635, "d": 0.33}, {"w": "thẻ", "t": 60.965, "d": 0.06}, {"w": "vàng.", "t": 61.025, "d": 0.385}]}, {"text": "Ông bắt đầu nhắc: đã bảo chỉ chạy một bài thôi mà!", "start": 62.0, "end": 64.96, "words": [{"w": "Ông", "t": 62.0, "d": 0.27}, {"w": "bắt", "t": 62.27, "d": 0.06}, {"w": "đầu", "t": 62.33, "d": 0.385}, {"w": "nhắc:", "t": 62.715, "d": 0.23}, {"w": "đã", "t": 62.945, "d": 0.13}, {"w": "bảo", "t": 63.075, "d": 0.39}, {"w": "chỉ", "t": 63.465, "d": 0.18}, {"w": "chạy", "t": 63.645, "d": 0.185}, {"w": "một", "t": 63.83, "d": 0.13}, {"w": "bài", "t": 63.96, "d": 0.225}, {"w": "thôi", "t": 64.185, "d": 0.145}, {"w": "mà!", "t": 64.33, "d": 0.43}]}, {"text": "Cả nhóm đẩy ông ra: đi đi, đợi đã, rồi sẽ giải thích.", "start": 65.28, "end": 68.56, "words": [{"w": "Cả", "t": 65.335, "d": 0.28}, {"w": "nhóm", "t": 65.615, "d": 0.2}, {"w": "đẩy", "t": 65.815, "d": 0.085}, {"w": "ông", "t": 65.9, "d": 0.31}, {"w": "ra:", "t": 66.21, "d": 0.15}, {"w": "đi", "t": 66.36, "d": 0.375}, {"w": "đi,", "t": 66.735, "d": 0.155}, {"w": "đợi", "t": 66.89, "d": 0.295}, {"w": "đã,", "t": 67.185, "d": 0.39}, {"w": "rồi", "t": 67.575, "d": 0.06}, {"w": "sẽ", "t": 67.635, "d": 0.285}, {"w": "giải", "t": 67.92, "d": 0.225}, {"w": "thích.", "t": 68.145, "d": 0.265}]}, {"text": "Chuyện là thế này.", "start": 69.56, "end": 70.44, "words": [{"w": "Chuyện", "t": 69.605, "d": 0.095}, {"w": "là", "t": 69.7, "d": 0.13}, {"w": "thế", "t": 69.83, "d": 0.115}, {"w": "này.", "t": 69.945, "d": 0.275}]}, {"text": "Thỉnh thoảng máy nhầm, hoặc người gõ sai một số.", "start": 70.76, "end": 73.32, "words": [{"w": "Thỉnh", "t": 70.81, "d": 0.17}, {"w": "thoảng", "t": 70.98, "d": 0.23}, {"w": "máy", "t": 71.21, "d": 0.32}, {"w": "nhầm,", "t": 71.53, "d": 0.335}, {"w": "hoặc", "t": 71.865, "d": 0.095}, {"w": "người", "t": 71.96, "d": 0.235}, {"w": "gõ", "t": 72.195, "d": 0.295}, {"w": "sai", "t": 72.49, "d": 0.21}, {"w": "một", "t": 72.7, "d": 0.22}, {"w": "số.", "t": 72.92, "d": 0.25}]}, {"text": "Họ nhận ra một lỗi chỉ làm hỏng vài thẻ lân cận, rồi mỗi vòng lan rộng thêm một chút, như một căn bệnh.", "start": 73.64, "end": 79.0, "words": [{"w": "Họ", "t": 73.66, "d": 0.25}, {"w": "nhận", "t": 73.91, "d": 0.105}, {"w": "ra", "t": 74.015, "d": 0.305}, {"w": "một", "t": 74.32, "d": 0.165}, {"w": "lỗi", "t": 74.485, "d": 0.19}, {"w": "chỉ", "t": 74.675, "d": 0.27}, {"w": "làm", "t": 74.945, "d": 0.2}, {"w": "hỏng", "t": 75.145, "d": 0.06}, {"w": "vài", "t": 75.205, "d": 0.33}, {"w": "thẻ", "t": 75.535, "d": 0.21}, {"w": "lân", "t": 75.745, "d": 0.17}, {"w": "cận,", "t": 75.915, "d": 0.21}, {"w": "rồi", "t": 76.125, "d": 0.16}, {"w": "mỗi", "t": 76.285, "d": 0.275}, {"w": "vòng", "t": 76.56, "d": 0.195}, {"w": "lan", "t": 76.755, "d": 0.15}, {"w": "rộng", "t": 76.905, "d": 0.255}, {"w": "thêm", "t": 77.16, "d": 0.185}, {"w": "một", "t": 77.345, "d": 0.32}, {"w": "chút,", "t": 77.665, "d": 0.315}, {"w": "như", "t": 77.98, "d": 0.17}, {"w": "một", "t": 78.15, "d": 0.06}, {"w": "căn", "t": 78.21, "d": 0.325}, {"w": "bệnh.", "t": 78.535, "d": 0.285}]}, {"text": "Giả sử xấp có năm mươi thẻ, và lỗi nằm ở thẻ thứ ba mươi chín.", "start": 79.32, "end": 83.16, "words": [{"w": "Giả", "t": 79.42, "d": 0.125}, {"w": "sử", "t": 79.545, "d": 0.38}, {"w": "xấp", "t": 79.925, "d": 0.065}, {"w": "có", "t": 79.99, "d": 0.255}, {"w": "năm", "t": 80.245, "d": 0.155}, {"w": "mươi", "t": 80.4, "d": 0.19}, {"w": "thẻ,", "t": 80.59, "d": 0.49}, {"w": "và", "t": 81.08, "d": 0.105}, {"w": "lỗi", "t": 81.185, "d": 0.13}, {"w": "nằm", "t": 81.315, "d": 0.285}, {"w": "ở", "t": 81.6, "d": 0.31}, {"w": "thẻ", "t": 81.91, "d": 0.065}, {"w": "thứ", "t": 81.975, "d": 0.185}, {"w": "ba", "t": 82.16, "d": 0.19}, {"w": "mươi", "t": 82.35, "d": 0.375}, {"w": "chín.", "t": 82.725, "d": 0.25}]}, {"text": "Thay vì làm lại từ đầu, họ tách riêng một xấp nhỏ chừng mười thẻ quanh chỗ lỗi.", "start": 83.48, "end": 87.72, "words": [{"w": "Thay", "t": 83.49, "d": 0.125}, {"w": "vì", "t": 83.615, "d": 0.25}, {"w": "làm", "t": 83.865, "d": 0.23}, {"w": "lại", "t": 84.095, "d": 0.325}, {"w": "từ", "t": 84.42, "d": 0.2}, {"w": "đầu,", "t": 84.62, "d": 0.165}, {"w": "họ", "t": 84.785, "d": 0.37}, {"w": "tách", "t": 85.155, "d": 0.06}, {"w": "riêng", "t": 85.215, "d": 0.215}, {"w": "một", "t": 85.43, "d": 0.375}, {"w": "xấp", "t": 85.805, "d": 0.06}, {"w": "nhỏ", "t": 85.865, "d": 0.34}, {"w": "chừng", "t": 86.205, "d": 0.06}, {"w": "mười", "t": 86.265, "d": 0.38}, {"w": "thẻ", "t": 86.645, "d": 0.065}, {"w": "quanh", "t": 86.71, "d": 0.26}, {"w": "chỗ", "t": 86.97, "d": 0.19}, {"w": "lỗi.", "t": 87.16, "d": 0.365}]}, {"text": "Xấp nhỏ chạy nhanh hơn, đuổi kịp xấp lớn, rồi vá vào.", "start": 88.04, "end": 91.4, "words": [{"w": "Xấp", "t": 88.115, "d": 0.125}, {"w": "nhỏ", "t": 88.24, "d": 0.28}, {"w": "chạy", "t": 88.52, "d": 0.17}, {"w": "nhanh", "t": 88.69, "d": 0.37}, {"w": "hơn,", "t": 89.06, "d": 0.365}, {"w": "đuổi", "t": 89.425, "d": 0.06}, {"w": "kịp", "t": 89.485, "d": 0.225}, {"w": "xấp", "t": 89.71, "d": 0.3}, {"w": "lớn,", "t": 90.01, "d": 0.435}, {"w": "rồi", "t": 90.445, "d": 0.08}, {"w": "vá", "t": 90.525, "d": 0.305}, {"w": "vào.", "t": 90.83, "d": 0.34}]}, {"text": "Màu thẻ thứ hai, thứ ba chính là những xấp vá ấy.", "start": 92.4, "end": 95.04, "words": [{"w": "Màu", "t": 92.4, "d": 0.105}, {"w": "thẻ", "t": 92.505, "d": 0.18}, {"w": "thứ", "t": 92.685, "d": 0.18}, {"w": "hai,", "t": 92.865, "d": 0.455}, {"w": "thứ", "t": 93.32, "d": 0.06}, {"w": "ba", "t": 93.38, "d": 0.215}, {"w": "chính", "t": 93.595, "d": 0.27}, {"w": "là", "t": 93.865, "d": 0.105}, {"w": "những", "t": 93.97, "d": 0.21}, {"w": "xấp", "t": 94.18, "d": 0.185}, {"w": "vá", "t": 94.365, "d": 0.125}, {"w": "ấy.", "t": 94.49, "d": 0.34}]}, {"text": "Đúng lúc họ đang rối nhất, sếp bước vào.", "start": 95.36, "end": 97.6, "words": [{"w": "Đúng", "t": 95.485, "d": 0.25}, {"w": "lúc", "t": 95.735, "d": 0.185}, {"w": "họ", "t": 95.92, "d": 0.19}, {"w": "đang", "t": 96.11, "d": 0.155}, {"w": "rối", "t": 96.265, "d": 0.235}, {"w": "nhất,", "t": 96.5, "d": 0.15}, {"w": "sếp", "t": 96.65, "d": 0.28}, {"w": "bước", "t": 96.93, "d": 0.185}, {"w": "vào.", "t": 97.115, "d": 0.31}]}, {"text": "Nên họ đuổi sếp ra ngoài.", "start": 97.92, "end": 99.2, "words": [{"w": "Nên", "t": 97.965, "d": 0.12}, {"w": "họ", "t": 98.085, "d": 0.17}, {"w": "đuổi", "t": 98.255, "d": 0.175}, {"w": "sếp", "t": 98.43, "d": 0.155}, {"w": "ra", "t": 98.585, "d": 0.175}, {"w": "ngoài.", "t": 98.76, "d": 0.235}]}, {"text": "Bài toán xong kịp hạn.", "start": 99.52, "end": 100.72, "words": [{"w": "Bài", "t": 99.58, "d": 0.165}, {"w": "toán", "t": 99.745, "d": 0.2}, {"w": "xong", "t": 99.945, "d": 0.16}, {"w": "kịp", "t": 100.105, "d": 0.12}, {"w": "hạn.", "t": 100.225, "d": 0.22}]}, {"text": "Theo nghiên cứu của Los Alamos, những mô phỏng như vậy cho thấy thiết kế lõi đặc sẽ cho sức nổ tốt.", "start": 101.72, "end": 107.16, "words": [{"w": "Theo", "t": 101.775, "d": 0.26}, {"w": "nghiên", "t": 102.035, "d": 0.225}, {"w": "cứu", "t": 102.26, "d": 0.26}, {"w": "của", "t": 102.52, "d": 0.24}, {"w": "Los", "t": 102.76, "d": 0.225}, {"w": "Alamos,", "t": 102.985, "d": 0.36}, {"w": "những", "t": 103.345, "d": 0.06}, {"w": "mô", "t": 103.405, "d": 0.215}, {"w": "phỏng", "t": 103.62, "d": 0.225}, {"w": "như", "t": 103.845, "d": 0.34}, {"w": "vậy", "t": 104.185, "d": 0.185}, {"w": "cho", "t": 104.37, "d": 0.18}, {"w": "thấy", "t": 104.55, "d": 0.36}, {"w": "thiết", "t": 104.91, "d": 0.115}, {"w": "kế", "t": 105.025, "d": 0.225}, {"w": "lõi", "t": 105.25, "d": 0.21}, {"w": "đặc", "t": 105.46, "d": 0.325}, {"w": "sẽ", "t": 105.785, "d": 0.115}, {"w": "cho", "t": 105.9, "d": 0.155}, {"w": "sức", "t": 106.055, "d": 0.24}, {"w": "nổ", "t": 106.295, "d": 0.325}, {"w": "tốt.", "t": 106.62, "d": 0.34}]}, {"text": "Ban lãnh đạo chọn đúng thiết kế ấy để chế tạo.", "start": 107.48, "end": 109.72, "words": [{"w": 