motion/hf/assets/long\mim-oppenheimer-feynman\ch02\data.js:1:window.CASE = {"topic": "mim-oppenheimer-feynman", "ch": "ch02", "dur": 100.42, "seed": 35892, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 02", "t": "NHỮNG “MÁY TÍNH” BIẾT THỞ"}, "acc": ["số", "khoá", "máy", "người", "thẻ", "mệt", "song", "xúc"], "lines": [{"text": "Ở Los Alamos năm 1943, chữ \"máy tính\" trước hết là tên một nghề.", "start": 0.0, "end": 4.24, "words": [{"w": "Ở", "t": 0.045, "d": 0.15}, {"w": "Los", "t": 0.195, "d": 0.18}, {"w": "Alamos", "t": 0.375, "d": 0.31}, {"w": "năm", "t": 0.685, "d": 0.18}, {"w": "1943,", "t": 0.865, "d": 1.435}, {"w": "chữ", "t": 2.3, "d": 0.095}, {"w": "\"máy", "t": 2.395, "d": 0.205}, {"w": "tính\"", "t": 2.6, "d": 0.205}, {"w": "trước", "t": 2.805, "d": 0.21}, {"w": "hết", "t": 3.015, "d": 0.175}, {"w": "là", "t": 3.19, "d": 0.17}, {"w": "tên", "t": 3.36, "d": 0.185}, {"w": "một", "t": 3.545, "d": 0.14}, {"w": "nghề.", "t": 3.685, "d": 0.34}]}, {"text": "Người làm nghề ấy ngồi trước những chiếc máy cộng cơ khí: Marchant, Friden, Monroe.", "start": 5.04, "end": 9.44, "words": [{"w": "Người", "t": 5.04, "d": 0.205}, {"w": "làm", "t": 5.245, "d": 0.295}, {"w": "nghề", "t": 5.54, "d": 0.225}, {"w": "ấy", "t": 5.765, "d": 0.275}, {"w": "ngồi", "t": 6.04, "d": 0.12}, {"w": "trước", "t": 6.16, "d": 0.39}, {"w": "những", "t": 6.55, "d": 0.165}, {"w": "chiếc", "t": 6.715, "d": 0.345}, {"w": "máy", "t": 7.06, "d": 0.22}, {"w": "cộng", "t": 7.28, "d": 0.06}, {"w": "cơ", "t": 7.34, "d": 0.25}, {"w": "khí:", "t": 7.59, "d": 0.37}, {"w": "Marchant,", "t": 7.96, "d": 0.59}, {"w": "Friden,", "t": 8.55, "d": 0.17}, {"w": "Monroe.", "t": 8.72, "d": 0.495}]}, {"text": "Họ làm tính theo một tờ hướng dẫn, hết bước này sang bước khác.", "start": 9.76, "end": 12.8, "words": [{"w": "Họ", "t": 9.76, "d": 0.265}, {"w": "làm", "t": 10.025, "d": 0.06}, {"w": "tính", "t": 10.085, "d": 0.205}, {"w": "theo", "t": 10.29, "d": 0.295}, {"w": "một", "t": 10.585, "d": 0.185}, {"w": "tờ", "t": 10.77, "d": 0.17}, {"w": "hướng", "t": 10.94, "d": 0.205}, {"w": "dẫn,", "t": 11.145, "d": 0.3}, {"w": "hết", "t": 11.445, "d": 0.06}, {"w": "bước", "t": 11.505, "d": 0.305}, {"w": "này", "t": 11.81, "d": 0.2}, {"w": "sang", "t": 12.01, "d": 0.06}, {"w": "bước", "t": 12.07, "d": 0.18}, {"w": "khác.", "t": 12.25, "d": 0.355}]}, {"text": "Kênh mình từng kể về những \"máy tính\" người ở Langley của NASA.", "start": 13.8, "end": 16.6, "words": [{"w": "Kênh", "t": 13.905, "d": 0.255}, {"w": "mình", "t": 14.16, "d": 0.175}, {"w": "từng", "t": 14.335, "d": 0.06}, {"w": "kể", "t": 14.395, "d": 0.195}, {"w": "về", "t": 14.59, "d": 0.165}, {"w": "những", "t": 14.755, "d": 0.3}, {"w": "\"máy", "t": 15.055, "d": 0.18}, {"w": "tính\"", "t": 15.235, "d": 0.06}, {"w": "người", "t": 15.295, "d": 0.3}, {"w": "ở", "t": 15.595, "d": 0.06}, {"w": "Langley", "t": 15.655, "d": 0.215}, {"w": "của", "t": 15.87, "d": 0.145}, {"w": "NASA.", "t": 16.015, "d": 0.33}]}, {"text": "Ở Los Alamos, nghề ấy còn phải giữ thêm một bí mật quốc gia.", "start": 16.92, "end": 20.28, "words": [{"w": "Ở", "t": 16.97, "d": 0.29}, {"w": "Los", "t": 17.26, "d": 0.165}, {"w": "Alamos,", "t": 17.425, "d": 0.365}, {"w": "nghề", "t": 17.79, "d": 0.205}, {"w": "ấy", "t": 17.995, "d": 0.205}, {"w": "còn", "t": 18.2, "d": 0.06}, {"w": "phải", "t": 18.26, "d": 0.275}, {"w": "giữ", "t": 18.535, "d": 0.185}, {"w": "thêm", "t": 18.72, "d": 0.15}, {"w": "một", "t": 18.87, "d": 0.175}, {"w": "bí", "t": 19.045, "d": 0.33}, {"w": "mật", "t": 19.375, "d": 0.215}, {"w": "quốc", "t": 19.59, "d": 0.16}, {"w": "gia.", "t": 19.75, "d": 0.33}]}, {"text": "Mùa xuân năm 1943, nhóm tính tay chỉ có chừng mười hai người tình nguyện.", "start": 20.6, "end": 24.76, "words": [{"w": "Mùa", "t": 20.6, "d": 0.17}, {"w": "xuân", "t": 20.77, "d": 0.26}, {"w": "năm", "t": 21.03, "d": 0.11}, {"w": "1943,", "t": 21.14, "d": 1.28}, {"w": "nhóm", "t": 22.42, "d": 0.315}, {"w": "tính", "t": 22.735, "d": 0.165}, {"w": "tay", "t": 22.9, "d": 0.21}, {"w": "chỉ", "t": 23.11, "d": 0.06}, {"w": "có", "t": 23.17, "d": 0.17}, {"w": "chừng", "t": 23.34, "d": 0.15}, {"w": "mười", "t": 23.49, "d": 0.245}, {"w": "hai", "t": 23.735, "d": 0.23}, {"w": "người", "t": 23.965, "d": 0.19}, {"w": "tình", "t": 24.155, "d": 0.13}, {"w": "nguyện.", "t": 24.285, "d": 0.29}]}, {"text": "Nhiều người là vợ của các nhà khoa học, như Mici Teller, vợ nhà vật lý Edward Teller.", "start": 25.08, "end": 29.72, "words": [{"w": "Nhiều", "t": 25.08, "d": 0.135}, {"w": "người", "t": 25.215, "d": 0.265}, {"w": "là", "t": 25.48, "d": 0.34}, {"w": "vợ", "t": 25.82, "d": 0.12}, {"w": "của", "t": 25.94, "d": 0.21}, {"w": "các", "t": 26.15, "d": 0.375}, {"w": "nhà", "t": 26.525, "d": 0.18}, {"w": "khoa", "t": 26.705, "d": 0.095}, {"w": "học,", "t": 26.8, "d": 0.36}, {"w": "như", "t": 27.16, "d": 0.225}, {"w": "Mici", "t": 27.385, "d": 0.405}, {"w": "Teller,", "t": 27.79, "d": 0.23}, {"w": "vợ", "t": 28.02, "d": 0.23}, {"w": "nhà", "t": 28.25, "d": 0.31}, {"w": "vật", "t": 28.56, "d": 0.265}, {"w": "lý", "t": 28.825, "d": 0.22}, {"w": "Edward", "t": 29.045, "d": 0.225}, {"w": "Teller.", "t": 29.27, "d": 0.275}]}, {"text": "Lý do khá thực tế.", "start": 30.04, "end": 31.16, "words": [{"w": "Lý", "t": 30.04, "d": 0.13}, {"w": "do", "t": 30.17, "d": 0.205}, {"w": "khá", "t": 30.375, "d": 0.205}, {"w": "thực", "t": 30.58, "d": 0.14}, {"w": "tế.", "t": 30.72, "d": 0.22}]}, {"text": "Họ đã sống sẵn trên núi, không cần thêm nhà ở, cũng không cần điều tra an ninh mới.", "start": 31.48, "end": 35.56, "words": [{"w": "Họ", "t": 31.48, "d": 0.265}, {"w": "đã", "t": 31.745, "d": 0.145}, {"w": "sống", "t": 31.89, "d": 0.165}, {"w": "sẵn", "t": 32.055, "d": 0.135}, {"w": "trên", "t": 32.19, "d": 0.305}, {"w": "núi,", "t": 32.495, "d": 0.185}, {"w": "không", "t": 32.68, "d": 0.245}, {"w": "cần", "t": 32.925, "d": 0.2}, {"w": "thêm", "t": 33.125, "d": 0.135}, {"w": "nhà", "t": 33.26, "d": 0.29}, {"w": "ở,", "t": 33.55, "d": 0.275}, {"w": "cũng", "t": 33.825, "d": 0.06}, {"w": "không", "t": 33.885, "d": 0.3}, {"w": "cần", "t": 34.185, "d": 0.2}, {"w": "điều", "t": 34.385, "d": 0.14}, {"w": "tra", "t": 34.525, "d": 0.165}, {"w": "an", "t": 34.69, "d": 0.275}, {"w": "ninh", "t": 34.965, "d": 0.11}, {"w": "mới.", "t": 35.075, "d": 0.315}]}, {"text": "Người giao bài cho họ là Mary Frankel, vợ nhà vật lý Stanley Frankel.", "start": 36.56, "end": 41.12, "words": [{"w": "Người", "t": 36.56, "d": 0.355}, {"w": "giao", "t": 36.915, "d": 0.335}, {"w": "bài", "t": 37.25, "d": 0.2}, {"w": "cho", "t": 37.45, "d": 0.34}, {"w": "họ", "t": 37.79, "d": 0.25}, {"w": "là", "t": 38.04, "d": 0.29}, {"w": "Mary", "t": 38.33, "d": 0.375}, {"w": "Frankel,", "t": 38.705, "d": 0.21}, {"w": "vợ", "t": 38.915, "d": 0.48}, {"w": "nhà", "t": 39.395, "d": 0.325}, {"w": "vật", "t": 39.72, "d": 0.115}, {"w": "lý", "t": 39.835, "d": 0.325}, {"w": "Stanley", "t": 40.16, "d": 0.255}, {"w": "Frankel.", "t": 40.415, "d": 0.545}]}, {"text": "Bà viết mỗi bài toán ra một tờ mẫu.", "start": 41.44, "end": 43.2, "words": [{"w": "Bà", "t": 41.465, "d": 0.17}, {"w": "viết", "t": 41.635, "d": 0.145}, {"w": "mỗi", "t": 41.78, "d": 0.23}, {"w": "bài", "t": 42.01, "d": 0.165}, {"w": "toán", "t": 42.175, "d": 0.16}, {"w": "ra", "t": 42.335, "d": 0.135}, {"w": "một", "t": 42.47, "d": 0.165}, {"w": "tờ", "t": 42.635, "d": 0.14}, {"w": "mẫu.", "t": 42.775, "d": 0.235}]}, {"text": "Lấy số này ở đâu, cộng với số nào, chia đôi, rồi ghi vào ô nào.", "start": 43.52, "end": 46.88, "words": [{"w": "Lấy", "t": 43.655, "d": 0.13}, {"w": "số", "t": 43.785, "d": 0.265}, {"w": "này", "t": 44.05, "d": 0.06}, {"w": "ở", "t": 44.11, "d": 0.27}, {"w": "đâu,", "t": 44.38, "d": 0.235}, {"w": "cộng", "t": 44.615, "d": 0.155}, {"w": "với", "t": 44.77, "d": 0.13}, {"w": "số", "t": 44.9, "d": 0.235}, {"w": "nào,", "t": 45.135, "d": 0.125}, {"w": "chia", "t": 45.26, "d": 0.3}, {"w": "đôi,", "t": 45.56, "d": 0.26}, {"w": "rồi", "t": 45.82, "d": 0.06}, {"w": "ghi", "t": 45.88, "d": 0.165}, {"w": "vào", "t": 46.045, "d": 0.14}, {"w": "ô", "t": 46.185, "d": 0.28}, {"w": "nào.", "t": 46.465, "d": 0.21}]}, {"text": "Một bài lớn được chẻ ra, để nhiều người cùng làm một lúc.", "start": 47.2, "end": 50.0, "words": [{"w": "Một", "t": 47.205, "d": 0.13}, {"w": "bài", "t": 47.335, "d": 0.295}, {"w": "lớn", "t": 47.63, "d": 0.15}, {"w": "được", "t": 47.78, "d": 0.19}, {"w": "chẻ", "t": 47.97, "d": 0.235}, {"w": "ra,", "t": 48.205, "d": 0.295}, {"w": "để", "t": 48.5, "d": 0.06}, {"w": "nhiều", "t": 48.56, "d": 0.25}, {"w": "người", "t": 48.81, "d": 0.22}, {"w": "cùng", "t": 49.03, "d": 0.195}, {"w": "làm", "t": 49.225, "d": 0.105}, {"w": "một", "t": 49.33, "d": 0.215}, {"w": "lúc.", "t": 49.545, "d": 0.285}]}, {"text": "Cuối mùa hè, nhóm có chừng hai mươi người, nhờ thêm các nữ quân nhân.", "start": 51.0, "end": 54.44, "words": [{"w": "Cuối", "t": 51.0, "d": 0.275}, {"w": "mùa", "t": 51.275, "d": 0.19}, {"w": "hè,", "t": 51.465, "d": 0.265}, {"w": "nhóm", "t": 51.73, "d": 0.075}, {"w": "có", "t": 51.805, "d": 0.29}, {"w": "chừng", "t": 52.095, "d": 0.095}, {"w": "hai", "t": 52.19, "d": 0.195}, {"w": "mươi", "t": 52.385, "d": 0.25}, {"w": "người,", "t": 52.635, "d": 0.395}, {"w": "nhờ", "t": 53.03, "d": 0.205}, {"w": "thêm", "t": 53.235, "d": 0.06}, {"w": "các", "t": 53.295, "d": 0.19}, {"w": "nữ", "t": 53.485, "d": 0.175}, {"w": "quân", "t": 53.66, "d": 0.26}, {"w": "nhân.", "t": 53.92, "d": 0.335}]}, {"text": "Về sau, nhóm có hai mươi lăm người, đông nhất Ban Lý thuyết.", "start": 54.76, "end": 57.64, "words": [{"w": "Về", "t": 54.76, "d": 0.105}, {"w": "sau,", "t": 54.865, "d": 0.44}, {"w": "nhóm", "t": 55.305, "d": 0.06}, {"w": "có", "t": 55.365, "d": 0.225}, {"w": "hai", "t": 55.59, "d": 0.225}, {"w": "mươi", "t": 55.815, "d": 0.06}, {"w": "lăm", "t": 55.875, "d": 0.34}, {"w": "người,", "t": 56.215, "d": 0.23}, {"w": "đông", "t": 56.445, "d": 0.085}, {"w": "nhất", "t": 56.53, "d": 0.34}, {"w": "Ban", "t": 56.87, "d": 0.06}, {"w": "Lý", "t": 56.93, "d": 0.195}, {"w": "thuyết.", "t": 57.125, "d": 0.325}]}, {"text": "Phòng tính nằm trên tầng hai một toà nhà gỗ dựng vội.", "start": 57.96, "end": 60.44, "words": [{"w": "Phòng", "t": 57.96, "d": 0.135}, {"w": "tính", "t": 58.095, "d": 0.275}, {"w": "nằm", "t": 58.37, "d": 0.185}, {"w": "trên", "t": 58.555, "d": 0.155}, {"w": "tầng", "t": 58.71, "d": 0.185}, {"w": "hai", "t": 58.895, "d": 0.215}, {"w": "một", "t": 59.11, "d": 0.2}, {"w": "toà", "t": 59.31, "d": 0.06}, {"w": "nhà", "t": 59.37, "d": 0.22}, {"w": "gỗ", "t": 59.59, "d": 0.205}, {"w": "dựng", "t": 59.795, "d": 0.25}, {"w": "vội.", "t": 60.045, "d": 0.215}]}, {"text": "Máy kêu lạch cạch suốt ngày.", "start": 60.76, "end": 62.04, "words": [{"w": "Máy", "t": 60.815, "d": 0.12}, {"w": "kêu", "t": 60.935, "d": 0.24}, {"w": "lạch", "t": 61.175, "d": 0.09}, {"w": "cạch", "t": 61.265, "d": 0.13}, {"w": "suốt", "t": 61.395, "d": 0.155}, {"w": "ngày.", "t": 61.55, "d": 0.26}]}, {"text": "Mùa nóng, bụi xe tải theo cửa sổ bay vào, mài mòn máy.", "start": 62.36, "end": 65.32, "words": [{"w": "Mùa", "t": 62.36, "d": 0.13}, {"w": "nóng,", "t": 62.49, "d": 0.395}, {"w": "bụi", "t": 62.885, "d": 0.06}, {"w": "xe", "t": 62.945, "d": 0.33}, {"w": "tải", "t": 63.275, "d": 0.205}, {"w": "theo", "t": 63.48, "d": 0.145}, {"w": "cửa", "t": 63.625, "d": 0.14}, {"w": "sổ", "t": 63.765, "d": 0.15}, {"w": "bay", "t": 63.915, "d": 0.175}, {"w": "vào,", "t": 64.09, "d": 0.435}, {"w": "mài", "t": 64.525, "d": 0.06}, {"w": "mòn", "t": 64.585, "d": 0.16}, {"w": "máy.", "t": 64.745, "d": 0.375}]}, {"text": "Bụi là kẻ thù.", "start": 65.64, "end": 66.52, "words": [{"w": "Bụi", "t": 65.705, "d": 0.14}, {"w": "là", "t": 65.845, "d": 0.1}, {"w": "kẻ", "t": 65.945, "d": 0.135}, {"w": "thù.", "t": 66.08, "d": 0.23}]}, {"text": "Nên những phép tính quan trọng phải làm hai lần.", "start": 66.84, "end": 68.84, "words": [{"w": "Nên", "t": 66.9, "d": 0.145}, {"w": "những", "t": 67.045, "d": 0.155}, {"w": "phép", "t": 67.2, "d": 0.165}, {"w": "tính", "t": 67.365, "d": 0.225}, {"w": "quan", "t": 67.59, "d": 0.165}, {"w": "trọng", "t": 67.755, "d": 0.195}, {"w": "phải", "t": 67.95, "d": 0.06}, {"w": "làm", "t": 68.01, "d": 0.255}, {"w": "hai", "t": 68.265, "d": 0.06}, {"w": "lần.", "t": 68.325, "d": 0.315}]}, {"text": "Còn máy hỏng thì sao?", "start": 69.84, "end": 70.88, "words": [{"w": "Còn", "t": 69.84, "d": 0.09}, {"w": "máy", "t": 69.93, "d": 0.185}, {"w": "hỏng", "t": 70.115, "d": 0.18}, {"w": "thì", "t": 70.295, "d": 0.125}, {"w": "sao?", "t": 70.42, "d": 0.26}]}, {"text": "Ban đầu, máy phải gửi xuống Santa Fe hoặc Albuquerque để sửa.", "start": 71.48, "end": 75.16, "words": [{"w": "Ban", "t": 71.48, "d": 0.375}, {"w": "đầu,", "t": 71.855, "d": 0.28}, {"w": "máy", "t": 72.135, "d": 0.23}, {"w": "phải", "t": 72.365, "d": 0.395}, {"w": "gửi", "t": 72.76, "d": 0.17}, {"w": "xuống", "t": 72.93, "d": 0.21}, {"w": "Santa", "t": 73.14, "d": 0.455}, {"w": "Fe", "t": 73.595, "d": 0.24}, {"w": "hoặc", "t": 73.835, "d": 0.22}, {"w": "Albuquerque", "t": 74.055, "d": 0.165}, {"w": "để", "t": 74.22, "d": 0.195}, {"w": "sửa.", "t": 74.415, "d": 0.545}]}, {"text": "Feynman và đồng nghiệp Nicholas Metropolis thấy chờ như vậy quá lâu.", "start": 75.48, "end": 79.32, "words": [{"w": "Feynman", "t": 75.48, "d": 0.3}, {"w": "và", "t": 75.78, "d": 0.39}, {"w": "đồng", "t": 76.17, "d": 0.225}, {"w": "nghiệp", "t": 76.395, "d": 0.3}, {"w": "Nicholas", "t": 76.695, "d": 0.26}, {"w": "Metropolis", "t": 76.955, "d": 0.265}, {"w": "thấy", "t": 77.22, "d": 0.41}, {"w": "chờ", "t": 77.63, "d": 0.17}, {"w": "như", "t": 77.8, "d": 0.15}, {"w": "vậy", "t": 77.95, "d": 0.455}, {"w": "quá", "t": 78.405, "d": 0.325}, {"w": "lâu.", "t": 78.73, "d": 0.395}]}, {"text": "Họ tháo nắp máy ra, dù quy định ghi rõ: tự tháo nắp thì hãng không chịu trách nhiệm.", "start": 79.64, "end": 83.96, "words": [{"w": "Họ", "t": 79.64, "d": 0.105}, {"w": "tháo", "t": 79.745, "d": 0.305}, {"w": "nắp", "t": 80.05, "d": 0.215}, {"w": "máy", "t": 80.265, "d": 0.25}, {"w": "ra,", "t": 80.515, "d": 0.32}, {"w": "dù", "t": 80.835, "d": 0.055}, {"w": "quy", "t": 80.89, "d": 0.235}, {"w": "định", "t": 81.125, "d": 0.245}, {"w": "ghi", "t": 81.37, "d": 0.22}, {"w": "rõ:", "t": 81.59, "d": 0.3}, {"w": "tự", "t": 81.89, "d": 0.12}, {"w": "tháo", "t": 82.01, "d": 0.2}, {"w": "nắp", "t": 82.21, "d": 0.33}, {"w": "thì", "t": 82.54, "d": 0.185}, {"w": "hãng", "t": 82.725, "d": 0.06}, {"w": "không", "t": 82.785, "d": 0.35}, {"w": "chịu", "t": 83.135, "d": 0.2}, {"w": "trách", "t": 83.335, "d": 0.135}, {"w": "nhiệm.", "t": 83.47, "d": 0.3}]}, {"text": "Rồi họ tự học sửa, ngay trong văn phòng của mình.", "start": 84.28, "end": 86.84, "words": [{"w": "Rồi", "t": 84.28, "d": 0.245}, {"w": "họ", "t": 84.525, "d": 0.19}, {"w": "tự", "t": 84.715, "d": 0.135}, {"w": "học", "t": 84.85, "d": 0.135}, {"w": "sửa,", "t": 84.985, "d": 0.44}, {"w": "ngay", "t": 85.425, "d": 0.145}, {"w": "trong", "t": 85.57, "d": 0.255}, {"w": "văn", "t": 85.825, "d": 0.165}, {"w": "phòng", "t": 85.99, "d": 0.19}, {"w": "của", "t": 86.18, "d": 0.205}, {"w": "mình.", "t": 86.385, "d": 0.275}]}, {"text": "Feynman kể, về sau ông lo hết phần máy tính, còn một anh trong xưởng lo máy chữ.", "start": 87.84, "end": 92.48, "words": [{"w": "Feynman", "t": 87.84, "d": 0.265}, {"w": "kể,", "t": 88.105, "d": 0.365}, {"w": "về", "t": 88.47, "d": 0.165}, {"w": "sau", "t": 88.635, "d": 0.135}, {"w": "ông", "t": 88.77, "d": 0.23}, {"w": "lo", "t": 89.0, "d": 0.255}, {"w": "hết", "t": 89.255, "d": 0.355}, {"w": "phần", "t": 89.61, "d": 0.17}, {"w": "máy", "t": 89.78, "d": 0.15}, {"w": "tính,", "t": 89.93, "d": 0.465}, {"w": "còn", "t": 90.395, "d": 0.085}, {"w": "một", "t": 90.48, "d": 0.415}, {"w": "anh", "t": 90.895, "d": 0.06}, {"w": "trong", "t": 90.955, "d": 0.31}, {"w": "xưởng", "t": 91.265, "d": 0.225}, {"w": "lo", "t": 91.49, "d": 0.175}, {"w": "máy", "t": 91.665, "d": 0.22}, {"w": "chữ.", "t": 91.885, "d": 0.395}]}, {"text": "Nhưng đến cuối năm 1943, cả nhóm tính tay vẫn không theo kịp nhu cầu.", "start": 92.8, "end": 96.88, "words": [{"w": "Nhưng", "t": 92.8, "d": 0.095}, {"w": "đến", "t": 92.895, "d": 0.215}, {"w": "cuối", "t": 93.11, "d": 0.285}, {"w": "năm", "t": 93.395, "d": 0.11}, {"w": "1943,", "t": 93.505, "d": 1.24}, {"w": "cả", "t": 94.745, "d": 0.27}, {"w": "nhóm", "t": 95.015, "d": 0.225}, {"w": "tính", "t": 95.24, "d": 0.175}, {"w": "tay", "t": 95.415, "d": 0.185}, {"w": "vẫn", "t": 95.6, "d": 0.075}, {"w": "không", "t": 95.675, "d": 0.16}, {"w": "theo", "t": 95.835, "d": 0.19}, {"w": "kịp", "t": 96.025, "d": 0.16}, {"w": "nhu", "t": 96.185, "d": 0.15}, {"w": "cầu.", "t": 96.335, "d": 0.345}]}, {"text": "Và bài toán sắp tới còn lớn hơn nhiều.", "start": 97.2, "end": 99.2, "words": [{"w": "Và", "t": 97.2, "d": 0.265}, {"w": "bài", "t": 97.465, "d": 0.06}, {"w": "toán", "t": 97.525, "d": 0.275}, {"w": "sắp", "t": 97.8, "d": 0.23}, {"w": "tới", "t": 98.03, "d": 0.19}, {"w": "còn", "t": 98.22, "d": 0.085}, {"w": "lớn", "t": 98.305, "d": 0.135}, {"w": "hơn", "t": 98.44, "d": 0.195}, {"w": "nhiều.", "t": 98.635, "d": 0.375}]}], "imgs": {"feyn": {"src": "assets/long/mim-oppenheimer-feynman/img/feyn.jpg", "w": 500, "h": 579, "lic": "Public domain", "by": "United States Army", "pd": true}, "feyn0": {"src": "assets/long/mim-oppenheimer-feynman/img/feyn0.jpg", "w": 1920, "h": 2358, "lic": "CC0", "by": "Credit Line: Los Alamos National Laboratory, courtesy AIP Emilio Segrè Visual Archives", "pd": true}, "feyn39": {"src": "assets/long/mim-oppenheimer-feynman/img/feyn39.jpg", "w": 500, "h": 733, "lic": "Public domain", "by": "Unknown authorUnknown author", "pd": true}, "fire16": {"src": "assets/long/mim-oppenheimer-feynman/img/fire16.jpg", "w": 1280, "h": 863, "lic": "Public domain", "by": "Berlyn Brixner / Los Alamos National Laboratory", "pd": true}, "fire25": {"src": "assets/long/mim-oppenheimer-feynman/img/f