 CÂU CHƯA TỪNG NÓI", "sub": "GIỜ THÌ BẠN ĐÃ HIỂU VÌ SAO", "t0": 82.52, "t1": 86.92, "at": 82.67, "fx": "punch"}, {"type": "kinetic", "items": [{"text": "GIỌNG NÓI = CÁI MIỆNG", "at": 87.655, "acc": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "764px", "fontSize": "89px"}}, "D": [{"kind": "bar", "style": {"top": "764px", "height": "96px"}, "at": 87.405}], "em": "GIỌNG"}], "t0": 86.92, "t1": 88.36, "lay": "corner"}, {"type": "question", "text": "Còn cái đầu:\nai dạy chiếc máy hiểu câu bạn hỏi?", "t0": 88.36, "t1": 94.9}], "prog0": 0.43539, "prog1": 0.58512};
motion/hf/assets/long\mim-ai-khuon-mat\ch05\data.js:1:window.CASE = {"topic": "mim-ai-khuon-mat", "ch": "ch05", "dur": 59.06, "seed": 18715, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 05", "t": "HAI MƯƠI LẦN GIỎI HƠN"}, "acc": ["khuôn", "mặt", "số", "trạm", "ngưỡng", "nhầm", "máy"], "lines": [{"text": "Cách làm vừa rồi không phải lúc nào cũng có.", "start": 0.0, "end": 2.16, "words": [{"w": "Cách", "t": 0.0, "d": 0.1}, {"w": "làm", "t": 0.1, "d": 0.23}, {"w": "vừa", "t": 0.33, "d": 0.17}, {"w": "rồi", "t": 0.5, "d": 0.31}, {"w": "không", "t": 0.81, "d": 0.185}, {"w": "phải", "t": 0.995, "d": 0.055}, {"w": "lúc", "t": 1.05, "d": 0.245}, {"w": "nào", "t": 1.295, "d": 0.25}, {"w": "cũng", "t": 1.545, "d": 0.155}, {"w": "có.", "t": 1.7, "d": 0.25}]}, {"text": "Trước khi mạng nơ-ron sâu thống trị, các hệ thống nhận diện khuôn mặt đo những đặc điểm do con người chọn sẵn.", "start": 2.96, "end": 8.08, "words": [{"w": "Trước", "t": 3.0, "d": 0.13}, {"w": "khi", "t": 3.13, "d": 0.315}, {"w": "mạng", "t": 3.445, "d": 0.195}, {"w": "nơ-ron", "t": 3.64, "d": 0.19}, {"w": "sâu", "t": 3.83, "d": 0.155}, {"w": "thống", "t": 3.985, "d": 0.16}, {"w": "trị,", "t": 4.145, "d": 0.465}, {"w": "các", "t": 4.61, "d": 0.1}, {"w": "hệ", "t": 4.71, "d": 0.13}, {"w": "thống", "t": 4.84, "d": 0.29}, {"w": "nhận", "t": 5.13, "d": 0.28}, {"w": "diện", "t": 5.41, "d": 0.21}, {"w": "khuôn", "t": 5.62, "d": 0.085}, {"w": "mặt", "t": 5.705, "d": 0.315}, {"w": "đo", "t": 6.02, "d": 0.055}, {"w": "những", "t": 6.075, "d": 0.315}, {"w": "đặc", "t": 6.39, "d": 0.215}, {"w": "điểm", "t": 6.605, "d": 0.06}, {"w": "do", "t": 6.665, "d": 0.275}, {"w": "con", "t": 6.94, "d": 0.165}, {"w": "người", "t": 7.105, "d": 0.325}, {"w": "chọn", "t": 7.43, "d": 0.17}, {"w": "sẵn.", "t": 7.6, "d": 0.27}]}, {"text": "Và chúng sai khá nhiều.", "start": 8.4, "end": 9.52, "words": [{"w": "Và", "t": 8.4, "d": 0.095}, {"w": "chúng", "t": 8.495, "d": 0.175}, {"w": "sai", "t": 8.67, "d": 0.265}, {"w": "khá", "t": 8.935, "d": 0.16}, {"w": "nhiều.", "t": 9.095, "d": 0.21}]}, {"text": "Viện Tiêu chuẩn và Công nghệ Quốc gia Mỹ, gọi tắt là NIST, đều đặn thử nghiệm các thuật toán nhận diện khuôn mặt.", "start": 10.52, "end": 15.88, "words": [{"w": "Viện", "t": 10.52, "d": 0.115}, {"w": "Tiêu", "t": 10.635, "d": 0.37}, {"w": "chuẩn", "t": 11.005, "d": 0.13}, {"w": "và", "t": 11.135, "d": 0.105}, {"w": "Công", "t": 11.24, "d": 0.235}, {"w": "nghệ", "t": 11.475, "d": 0.275}, {"w": "Quốc", "t": 11.75, "d": 0.255}, {"w": "gia", "t": 12.005, "d": 0.175}, {"w": "Mỹ,", "t": 12.18, "d": 0.17}, {"w": "gọi", "t": 12.35, "d": 0.305}, {"w": "tắt", "t": 12.655, "d": 0.215}, {"w": "là", "t": 12.87, "d": 0.25}, {"w": "NIST,", "t": 13.12, "d": 0.325}, {"w": "đều", "t": 13.445, "d": 0.155}, {"w": "đặn", "t": 13.6, "d": 0.14}, {"w": "thử", "t": 13.74, "d": 0.205}, {"w": "nghiệm", "t": 13.945, "d": 0.19}, {"w": "các", "t": 14.135, "d": 0.15}, {"w": "thuật", "t": 14.285, "d": 0.28}, {"w": "toán", "t": 14.565, "d": 0.15}, {"w": "nhận", "t": 14.715, "d": 0.165}, {"w": "diện", "t": 14.88, "d": 0.315}, {"w": "khuôn", "t": 15.195, "d": 0.235}, {"w": "mặt.", "t": 15.43, "d": 0.25}]}, {"text": "Năm hai nghìn không trăm mười tám, họ công bố kết quả thử nghiệm một trăm hai mươi bảy thuật toán, của ba mươi chín nhà phát triển.", "start": 16.2, "end": 22.36, "words": [{"w": "Năm", "t": 16.2, "d": 0.235}, {"w": "hai", "t": 16.435, "d": 0.18}, {"w": "nghìn", "t": 16.615, "d": 0.12}, {"w": "không", "t": 16.735, "d": 0.27}, {"w": "trăm", "t": 17.005, "d": 0.28}, {"w": "mười", "t": 17.285, "d": 0.2}, {"w": "tám,", "t": 17.485, "d": 0.305}, {"w": "họ", "t": 17.79, "d": 0.115}, {"w": "công", "t": 17.905, "d": 0.3}, {"w": "bố", "t": 18.205, "d": 0.17}, {"w": "kết", "t": 18.375, "d": 0.195}, {"w": "quả", "t": 18.57, "d": 0.16}, {"w": "thử", "t": 18.73, "d": 0.23}, {"w": "nghiệm", "t": 18.96, "d": 0.25}, {"w": "một", "t": 19.21, "d": 0.06}, {"w": "trăm", "t": 19.27, "d": 0.25}, {"w": "hai", "t": 19.52, "d": 0.18}, {"w": "mươi", "t": 19.7, "d": 0.155}, {"w": "bảy", "t": 19.855, "d": 0.225}, {"w": "thuật", "t": 20.08, "d": 0.19}, {"w": "toán,", "t": 20.27, "d": 0.46}, {"w": "của", "t": 20.73, "d": 0.105}, {"w": "ba", "t": 20.835, "d": 0.125}, {"w": "mươi", "t": 20.96, "d": 0.32}, {"w": "chín", "t": 21.28, "d": 0.225}, {"w": "nhà", "t": 21.505, "d": 0.11}, {"w": "phát", "t": 21.615, "d": 0.27}, {"w": "triển.", "t": 21.885, "d": 0.29}]}, {"text": "Một trong các bài thử là tìm một người trong một kho ảnh lớn.", "start": 23.36, "end": 26.64, "words": [{"w": "Một", "t": 23.36, "d": 0.135}, {"w": "trong", "t": 23.495, "d": 0.305}, {"w": "các", "t": 23.8, "d": 0.195}, {"w": "bài", "t": 23.995, "d": 0.255}, {"w": "thử", "t": 24.25, "d": 0.185}, {"w": "là", "t": 24.435, "d": 0.28}, {"w": "tìm", "t": 24.715, "d": 0.31}, {"w": "một", "t": 25.025, "d": 0.125}, {"w": "người", "t": 25.15, "d": 0.16}, {"w": "trong", "t": 25.31, "d": 0.28}, {"w": "một", "t": 25.59, "d": 0.335}, {"w": "kho", "t": 25.925, "d": 0.12}, {"w": "ảnh", "t": 26.045, "d": 0.33}, {"w": "lớn.", "t": 26.375, "d": 0.265}]}, {"text": "Năm hai nghìn không trăm mười bốn, các thuật toán tốt nhất thất bại khoảng bốn phần trăm số lần.", "start": 26.96, "end": 31.2, "words": [{"w": "Năm", "t": 27.1, "d": 0.095}, {"w": "hai", "t": 27.195, "d": 0.265}, {"w": "nghìn", "t": 27.46, "d": 0.165}, {"w": "không", "t": 27.625, "d": 0.275}, {"w": "trăm", "t": 27.9, "d": 0.18}, {"w": "mười", "t": 28.08, "d": 0.17}, {"w": "bốn,", "t": 28.25, "d": 0.155}, {"w": "các", "t": 28.405, "d": 0.2}, {"w": "thuật", "t": 28.605, "d": 0.16}, {"w": "toán", "t": 28.765, "d": 0.26}, {"w": "tốt", "t": 29.025, "d": 0.125}, {"w": "nhất", "t": 29.15, "d": 0.265}, {"w": "thất", "t": 29.415, "d": 0.16}, {"w": "bại", "t": 29.575, "d": 0.245}, {"w": "khoảng", "t": 29.82, "d": 0.06}, {"w": "bốn", "t": 29.88, "d": 0.24}, {"w": "phần", "t": 30.12, "d": 0.235}, {"w": "trăm", "t": 30.355, "d": 0.135}, {"w": "số", "t": 30.49, "d": 0.215}, {"w": "lần.", "t": 30.705, "d": 0.24}]}, {"text": "Năm hai nghìn không trăm mười tám, con số ấy còn khoảng không phẩy hai phần trăm.", "start": 31.52, "end": 34.96, "words": [{"w": "Năm", "t": 31.52, "d": 0.145}, {"w": "hai", "t": 31.665, "d": 0.275}, {"w": "nghìn", "t": 31.94, "d": 0.065}, {"w": "không", "t": 32.005, "d": 0.145}, {"w": "trăm", "t": 32.15, "d": 0.285}, {"w": "mười", "t": 32.435, "d": 0.195}, {"w": "tám,", "t": 32.63, "d": 0.305}, {"w": "con", "t": 32.935, "d": 0.09}, {"w": "số", "t": 33.025, "d": 0.11}, {"w": "ấy", "t": 33.135, "d": 0.185}, {"w": "còn", "t": 33.32, "d": 0.25}, {"w": "khoảng", "t": 33.57, "d": 0.18}, {"w": "không", "t": 33.75, "d": 0.18}, {"w": "phẩy", "t": 33.93, "d": 0.19}, {"w": "hai", "t": 34.12, "d": 0.2}, {"w": "phần", "t": 34.32, "d": 0.135}, {"w": "trăm.", "t": 34.455, "d": 0.285}]}, {"text": "Chỉ trong bốn năm, giỏi hơn khoảng hai mươi lần.", "start": 35.96, "end": 38.2, "words": [{"w": "Chỉ", "t": 35.97, "d": 0.115}, {"w": "trong", "t": 36.085, "d": 0.32}, {"w": "bốn", "t": 36.405, "d": 0.185}, {"w": "năm,", "t": 36.59, "d": 0.25}, {"w": "giỏi", "t": 36.84, "d": 0.06}, {"w": "hơn", "t": 36.9, "d": 0.285}, {"w": "khoảng", "t": 37.185, "d": 0.165}, {"w": "hai", "t": 37.35, "d": 0.255}, {"w": "mươi", "t": 37.605, "d": 0.06}, {"w": "lần.", "t": 37.665, "d": 0.335}]}, {"text": "Và NIST nói rõ nguyên nhân: các cách làm cũ được thay bằng mạng nơ-ron tích chập sâu, đúng loại mạng ở trạm thứ ba.", "start": 38.52, "end": 44.36, "words": [{"w": "Và", "t": 38.52, "d": 0.295}, {"w": "NIST", "t": 38.815, "d": 0.16}, {"w": "nói", "t": 38.975, "d": 0.17}, {"w": "rõ", "t": 39.145, "d": 0.295}, {"w": "nguyên", "t": 39.44, "d": 0.215}, {"w": "nhân:", "t": 39.655, "d": 0.335}, {"w": "các", "t": 39.99, "d": 0.12}, {"w": "cách", "t": 40.11, "d": 0.195}, {"w": "làm", "t": 40.305, "d": 0.13}, {"w": "cũ", "t": 40.435, "d": 0.295}, {"w": "