motion/hf/assets/long\mim-qwerty\ch08\data.js:1:window.CASE = {"topic": "mim-qwerty", "ch": "ch08", "dur": 81.38, "seed": 9730, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 08", "t": "THỨ NẰM DƯỚI NGÓN TAY BẠN"}, "acc": ["qwerty", "chậm", "tội", "phím", "thắng", "dvorak", "telex"], "lines": [{"text": "Máy đánh chữ rồi cũng biến mất.", "start": 0.0, "end": 1.52, "words": [{"w": "Máy", "t": 0.065, "d": 0.19}, {"w": "đánh", "t": 0.255, "d": 0.17}, {"w": "chữ", "t": 0.425, "d": 0.195}, {"w": "rồi", "t": 0.62, "d": 0.11}, {"w": "cũng", "t": 0.73, "d": 0.15}, {"w": "biến", "t": 0.88, "d": 0.14}, {"w": "mất.", "t": 1.02, "d": 0.285}]}, {"text": "Không còn cần chữ nào để kẹt nữa.", "start": 2.32, "end": 4.0, "words": [{"w": "Không", "t": 2.32, "d": 0.105}, {"w": "còn", "t": 2.425, "d": 0.225}, {"w": "cần", "t": 2.65, "d": 0.175}, {"w": "chữ", "t": 2.825, "d": 0.17}, {"w": "nào", "t": 2.995, "d": 0.255}, {"w": "để", "t": 3.25, "d": 0.14}, {"w": "kẹt", "t": 3.39, "d": 0.17}, {"w": "nữa.", "t": 3.56, "d": 0.245}]}, {"text": "Nhưng bàn phím thì ở lại.", "start": 4.32, "end": 5.36, "words": [{"w": "Nhưng", "t": 4.32, "d": 0.11}, {"w": "bàn", "t": 4.43, "d": 0.165}, {"w": "phím", "t": 4.595, "d": 0.155}, {"w": "thì", "t": 4.75, "d": 0.06}, {"w": "ở", "t": 4.81, "d": 0.175}, {"w": "lại.", "t": 4.985, "d": 0.175}]}, {"text": "Từ máy đánh chữ, QWERTY sang máy điện báo, rồi sang máy tính.", "start": 6.36, "end": 9.8, "words": [{"w": "Từ", "t": 6.405, "d": 0.15}, {"w": "máy", "t": 6.555, "d": 0.295}, {"w": "đánh", "t": 6.85, "d": 0.29}, {"w": "chữ,", "t": 7.14, "d": 0.255}, {"w": "QWERTY", "t": 7.395, "d": 0.115}, {"w": "sang", "t": 7.51, "d": 0.405}, {"w": "máy", "t": 7.915, "d": 0.14}, {"w": "điện", "t": 8.055, "d": 0.235}, {"w": "báo,", "t": 8.29, "d": 0.4}, {"w": "rồi", "t": 8.69, "d": 0.095}, {"w": "sang", "t": 8.785, "d": 0.335}, {"w": "máy", "t": 9.12, "d": 0.105}, {"w": "tính.", "t": 9.225, "d": 0.365}]}, {"text": "Và bây giờ, nó nằm trên màn hình cảm ứng trong túi bạn. Nơi chẳng có lấy một cái phím thật nào.", "start": 10.12, "end": 15.0, "words": [{"w": "Và", "t": 10.18, "d": 0.225}, {"w": "bây", "t": 10.405, "d": 0.25}, {"w": "giờ,", "t": 10.655, "d": 0.29}, {"w": "nó", "t": 10.945, "d": 0.06}, {"w": "nằm", "t": 11.005, "d": 0.32}, {"w": "trên", "t": 11.325, "d": 0.125}, {"w": "màn", "t": 11.45, "d": 0.165}, {"w": "hình", "t": 11.615, "d": 0.17}, {"w": "cảm", "t": 11.785, "d": 0.18}, {"w": "ứng", "t": 11.965, "d": 0.21}, {"w": "trong", "t": 12.175, "d": 0.205}, {"w": "túi", "t": 12.38, "d": 0.34}, {"w": "bạn.", "t": 12.72, "d": 0.31}, {"w": "Nơi", "t": 13.03, "d": 0.12}, {"w": "chẳng", "t": 13.15, "d": 0.1}, {"w": "có", "t": 13.25, "d": 0.26}, {"w": "lấy", "t": 13.51, "d": 0.2}, {"w": "một", "t": 13.71, "d": 0.285}, {"w": "cái", "t": 13.995, "d": 0.18}, {"w": "phím", "t": 14.175, "d": 0.135}, {"w": "thật", "t": 14.31, "d": 0.17}, {"w": "nào.", "t": 14.48, "d": 0.335}]}, {"text": "Người Việt mình còn có một lớp chuyện nữa nằm trên những phím ấy.", "start": 16.0, "end": 18.96, "words": [{"w": "Người", "t": 16.0, "d": 0.2}, {"w": "Việt", "t": 16.2, "d": 0.24}, {"w": "mình", "t": 16.44, "d": 0.17}, {"w": "còn", "t": 16.61, "d": 0.145}, {"w": "có", "t": 16.755, "d": 0.275}, {"w": "một", "t": 17.03, "d": 0.06}, {"w": "lớp", "t": 17.09, "d": 0.155}, {"w": "chuyện", "t": 17.245, "d": 0.36}, {"w": "nữa", "t": 17.605, "d": 0.115}, {"w": "nằm", "t": 17.72, "d": 0.1}, {"w": "trên", "t": 17.82, "d": 0.25}, {"w": "những", "t": 18.07, "d": 0.2}, {"w": "phím", "t": 18.27, "d": 0.14}, {"w": "ấy.", "t": 18.41, "d": 0.375}]}, {"text": "Kiểu gõ Telex, gõ hai chữ A thành chữ Â, thêm chữ S thành dấu sắc.", "start": 19.28, "end": 23.2, "words": [{"w": "Kiểu", "t": 19.285, "d": 0.155}, {"w": "gõ", "t": 19.44, "d": 0.185}, {"w": "Telex,", "t": 19.625, "d": 0.48}, {"w": "gõ", "t": 20.105, "d": 0.205}, {"w": "hai", "t": 20.31, "d": 0.06}, {"w": "chữ", "t": 20.37, "d": 0.375}, {"w": "A", "t": 20.745, "d": 0.06}, {"w": "thành", "t": 20.805, "d": 0.285}, {"w": "chữ", "t": 21.09, "d": 0.175}, {"w": "Â,", "t": 21.265, "d": 0.42}, {"w": "thêm", "t": 21.685, "d": 0.15}, {"w": "chữ", "t": 21.835, "d": 0.1}, {"w": "S", "t": 21.935, "d": 0.225}, {"w": "thành", "t": 22.16, "d": 0.285}, {"w": "dấu", "t": 22.445, "d": 0.215}, {"w": "sắc.", "t": 22.66, "d": 0.325}]}, {"text": "Nó có gốc từ thời điện tín, khoảng một trăm năm trước, khi người ta phải gửi chữ có dấu qua những cỗ máy chỉ biết chữ không dấu.", "start": 23.52, "end": 30.08, "words": [{"w": "Nó", "t": 23.52, "d": 0.11}, {"w": "có", "t": 23.63, "d": 0.345}, {"w": "gốc", "t": 23.975, "d": 0.15}, {"w": "từ", "t": 24.125, "d": 0.305}, {"w": "thời", "t": 24.43, "d": 0.185}, {"w": "điện", "t": 24.615, "d": 0.22}, {"w": "tín,", "t": 24.835, "d": 0.16}, {"w": "khoảng", "t": 24.995, "d": 0.3}, {"w": "một", "t": 25.295, "d": 0.2}, {"w": "trăm", "t": 25.495, "d": 0.29}, {"w": "năm", "t": 25.785, "d": 0.205}, {"w": "trước,", "t": 25.99, "d": 0.33}, {"w": "khi", "t": 26.32, "d": 0.085}, {"w": "người", "t": 26.405, "d": 0.145}, {"w": "ta", "t": 26.55, "d": 0.37}, {"w": "phải", "t": 26.92, "d": 0.18}, {"w": "gửi", "t": 27.1, "d": 0.16}, {"w": "chữ", "t": 27.26, "d": 0.17}, {"w": "có", "t": 27.43, "d": 0.205}, {"w": "dấu", "t": 27.635, "d": 0.175}, {"w": "qua", "t": 27.81, "d": 0.235}, {"w": "những", "t": 28.045, "d": 0.245}, {"w": "cỗ", "t": 28.29, "d": 0.195}, {"w": "máy", "t": 28.485, "d": 0.175}, {"w": "chỉ", "t": 28.66, "d": 0.24}, {"w": "biết", "t": 28.9, "d": 0.3}, {"w": "chữ", "t": 29.2, "d": 0.065}, {"w": "không", "t": 29.265, "d": 0.185}, {"w": "dấu.", "t": 29.45, "d": 0.405}]}, {"text": "Vậy là mỗi lần gõ một tin nhắn, bạn đang dùng hai phát minh của thời điện tín.", "start": 31.08, "end": 34.92, "words": [{"w": "Vậy", "t": 31.145, "d": 0.25}, {"w": "là", "t": 31.395, "d": 0.155}, {"w": "mỗi", "t": 31.55, "d": 0.2}, {"w": "lần", "t": 31.75, "d": 0.155}, {"w": "gõ", "t": 31.905, "d": 0.18}, {"w": "một", "t": 32.085, "d": 0.11}, {"w": "tin", "t": 32.195, "d": 0.35}, {"w": "nhắn,", "t": 32.545, "d": 0.25}, {"w": "bạn", "t": 32.795, "d": 0.075}, {"w": "đang", "t": 32.87, "d": 0.19}, {"w": "dùng", "t": 33.06, "d": 0.21}, {"w": "hai", "t": 33.27, "d": 0.225}, {"w": "phát", "t": 33.495, "d": 0.185}, {"w": "minh", "t": 33.68, "d": 0.13}, {"w": "của", "t": 33.81, "d": 0.255}, {"w": "thời", "t": 34.065, "d": 0.185}, {"w": "điện", "t": 34.25, "d": 0.285}, {"w": "tín.", "t": 34.535, "d": 0.225}]}, {"text": "Một hàng phím từ nước Mỹ những năm 1870.", "start": 35.24, "end": 38.52, "words": [{"w": "Một", "t": 35.24, "d": 0.3}, {"w": "hàng", "t": 35.54, "d": 0.065}, {"w": "phím", "t": 35.605, "d": 0.19}, {"w": "từ", "t": 35.795, "d": 0.265}, {"w": "nước", "t": 36.06, "d": 0.335}, {"w": "Mỹ", "t": 36.395, "d": 0.195}, {"w": "những", "t": 36.59, "d": 0.095}, {"w": "năm", "t": 36.685, "d": 0.16}, {"w": "1870.", "t": 36.845, "d": 1.505}]}, {"text": "Và một cách bỏ dấu của người Việt đầu thế kỷ hai mươi.", "start": 38.84, "end": 41.56, "words": [{"w": "Và", "t": 38.84, "d": 0.2}, {"w": "một", "t": 39.04, "d": 0.13}, {"w": "cách", "t": 39.17, "d": 0.245}, {"w": "bỏ", "t": 39.415, "d": 0.24}, {"w": "dấu", "t": 39.655, "d": 0.145}, {"w": "của", "t": 39.8, "d": 0.16}, {"w": "người", "t": 39.96, "d": 0.27}, {"w": "Việt", "t": 40.23, "d": 0.185}, {"w": "đầu", "t": 40.415, "d": 0.06}, {"w": "thế", "t": 40.475, "d": 0.27}, {"w": "kỷ", "t": 40.745, "d": 0.145}, {"w": "hai", "t": 40.89, "d": 0.15}, {"w": "mươi.", "t": 41.04, "d": 0.35}]}, {"text": "Ba lời buộc tội. Một vô tội, một có tội một phần, một chưa đủ chứng cứ.", "start": 42.56, "end": 46.8, "words": [{"w": "Ba", "t": 42.6, "d": 0.265}, {"w": "lời", "t": 42.865, "d": 0.17}, {"w": "buộc", "t": 43.035, "d": 0.27}, {"w": "tội.", "t": 43.305, "d": 0.26}, {"w": "Một", "t": 43.565, "d": 0.24}, {"w": "vô", "t": 43.805, "d": 0.145}, {"w": "tội,", "t": 43.95, "d": 0.37}, {"w": "một", "t": 44.32, "d": 0.215}, {"w": "có", "t": 44.535, "d": 0.14}, {"w": "tội", "t": 44.675, "d": 0.305}, {"w": "một", "t": 44.98, "d": 0.06}, {"w": "phần,", "t": 45.04, "d": 0.325}, {"w": "một", "t": 45.365, "d": 0.19}, {"w": "chưa", "t": 45.555, "d": 0.295}, {"w": "đủ", "t": 45.85, "d": 0.19}, {"w": "chứng", "t": 46.04, "d": 0.185}, {"w": "cứ.", "t": 46.225, "d": 0.37}]}, {"text": "QWERTY không phải bàn phím tốt nhất có thể có.", "start": 47.12, "end": 49.76, "words": [{"w": "QWERTY", "t": 47.17, "d": 0.145}, {"w": "không", "t": 47.315, "d": 0.355}, {"w": "phải", "t": 47.67, "d": 0.195}, {"w": "bàn", "t": 47.865, "d": 0.255}, {"w": "phím", "t": 48.12, "d": 0.235}, {"w": "tốt", "t": 48.355, "d": 0.13}, {"w": "nhất", "t": 48.485, "d": 0.305}, {"w": "có", "t": 48.79, "d": 0.155}, {"w": "thể", "t": 48.945, "d": 0.22}, {"w": "có.", "t": 49.165, "d": 0.375}]}, {"text": "Nó chỉ là thứ đã có mặt, đúng lúc mọi người bắt đầu học gõ.", "start": 50.08, "end": 53.36, "words": [{"w": "Nó", "t": 50.08, "d": 0.105}, {"w": "chỉ", "t": 50.185, "d": 0.27}, {"w": "là", "t": 50.455, "d": 0.225}, {"w": "thứ", "t": 50.68, "d": 0.165}, {"w": "đã", "t": 50.845, "d": 0.265}, {"w": "có", "t": 51.11, "d": 0.175}, {"w": "mặt,", "t": 51.285, "d": 0.185}, {"w": "đúng", "t": 51.47, "d": 0.27}, {"w": "lúc", "t": 51.74, "d": 0.155}, {"w": "mọi", "t": 51.895, "d": 0.24}, {"w": "người", "t": 52.135, "d": 0.065}, {"w": "bắt", "t": 52.2, "d": 0.25}, {"w": "đầu", "t": 52.45, "d": 0.135}, {"w": "học", "t": 52.585, "d": 0.335}, {"w": "gõ.", "t": 52.92, "d": 0.24}]}, {"text": "Còn bạn, bạn gõ mười ngón, hay vẫn mổ cò bằng hai ngón?", "start": 54.36, "end": 57.56, "words": [{"w": "Còn", "t": 54.365, "d": 0.11}, {"w": "bạn,", "t": 54.475, "d": 0.495}, {"w": "bạn", "t": 54.97, "d": 0.06}, {"w": "gõ", "t": 55.03, "d": 0.24}, {"w": "mười", "t": 55.27, "d": 0.305}, {"w": "ngón,", "t": 55.575, "d": 0.325}, {"w": "hay", "t": 55.9, "d": 0.145}, {"w": "vẫn", "t": 56.045, "d": 0.21}, {"w": "mổ", "t": 56.255, "d": 0.125}, {"w": "cò", "t": 56.38, "d": 0.21}, {"w": "bằng", "t": 56.59, "d": 0.18}, {"w": "hai", "t": 56.77, "d": 0.165}, {"w": "ngón?", "t": 56.935, "d": 0.41}]}, {"text": "Kể cho mình nghe ở phần bình luận nhé.", "start": 58.16, "end": 60.16, "words": [{"w": "Kể", "t": 58.16, "d": 0.115}, {"w": "cho", "t": 58.275, "d": 0.235}, {"w": "mình", "t": 58.51, "d": 0.335}, {"w": "nghe", "t": 58.845, "d": 0.19}, {"w": "ở", "t": 59.035, "d": 0.26}, {"w": "phần", "t": 59.295, "d": 0.205}, {"w": "bình", "t": 59.5, "d": 0.19}, {"w": "luận", "t": 59.69, "d": 0.2}, {"w": "nhé.", "t": 59.89, "d": 0.27}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "8", "k": "CHƯƠNG TÁM", "title": "THỨ NẰM DƯỚI\nNGÓN TAY BẠN", "sub": "MÁY ĐÁNH CHỮ BIẾN MẤT · BÀN PHÍM Ở LẠI", "vid": "v0", "ms": 8, "illus": "VIDEO MINH HỌA", "titleAt": 0.065, "t0": 0.0, "t1": 6.36}, {"type": "timeline", "items": [{"year": "1870s", "text": "*máy đánh chữ*", "at": 6.36}, {"year": "sau đó", "text": "*máy điện báo* · *máy tính*", "at": 7.51}, {"year": "hôm nay", "text": "*màn hình cảm ứng* · không còn phím thật", "at": 10.12}], "t0": 6.36, "t1": 16.0}, {"type": "broll", "vid": "v2", "veil": 0.5, "illus": "VIDEO MINH HỌA", "kin": [{"text": "NGƯỜI VIỆT CÒN MỘT LỚP CHUYỆN NỮA", "at": 16.0, "sm": true, "fx": "rise"}, {"text": "KIỂU GÕ TELEX", "at": 19.625, "acc": true, "fx": "flicker", "em": "TELEX"}], "t0": 16.0, "t1": 19.28}, {"type": "ledger", "title": "TELEX", "srcnote": "GỐC TỪ THỜI ĐIỆN TÍN · KHOẢNG 100 NĂM TRƯỚC", "rows": [{"k": "A + A", "v": "→ Â", "at": 19.44}, {"k": "THÊM S", "v": "→ DẤU SẮC", "at": 21.685}], "total": {"k": "VÌ", "v": "MÁY CHỈ BIẾT CHỮ KHÔNG DẤU", "at": 26.32}, "t0": 19.28, "t1": 31.08}, {"type": "ledger", "title": "MỖI TIN NHẮN: HAI PHÁT MINH THỜI ĐIỆN TÍN", "rows": [{"k": "1", "v": "HÀNG PHÍM · MỸ, 1870s", "at": 35.24}, {"k": "2", "v": "CÁCH BỎ DẤU · VIỆT NAM", "at": 38.84}], "t0": 31.08, "t1": 42.56}, {"type": "ledger", "title": "BA PHÁN QUYẾT", "rows": [{"k": "1", "v": "VÔ TỘI", "at": 43.565}, {"k": "2", "v": "CÓ TỘI MỘT PHẦN", "at": 44.32}, {"k": "3", "v": "CHƯA ĐỦ CHỨNG CỨ", "at": 44.98}], "t0": 42.56, "t1": 47.12}, {"type": "kinetic", "items": [{"text": "KHÔNG PHẢI TỐT NHẤT", "at": 47.12, "fx": "rise", "L": {"style": {"top": "403px", "fontSize": "95px"}}, "D": [{"kind": "frame", "style": {"top": "327px", "height": "364px", "width": "1279px", "left": "320px"}, "at": 46.82}], "em": "KHÔNG"}, {"text": "CHỈ LÀ CÓ MẶT ĐÚNG LÚC", "at": 50.08, "acc": true, "fx": "outline", "L": {"style": {"top": "529px", "fontSize": "82px"}}, "em": "ĐÚNG"}], "t0": 47.12, "t1": 54.36, "lay": "frame"}, {"type": "question", "text": "Bạn gõ mười ngón,\nhay vẫn mổ cò bằng hai ngón?", "t0": 54.36, "t1": 58.16}, {"type": "kinetic", "items": [{"text": "KỂ CHO MÌNH NGHE", "at": 58.16, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "576px", "fontSize": "117px"}}, "D": [{"kind": "bar", "style": {"top": "576px", "height": "284px"}, "at": 57.91}], "em": "MÌNH"}, {"text": "Ở PHẦN BÌNH LUẬN", "at": 59.035, "acc": true, "fx": "marker", "L": {"cls": "kC", "style": {"top": "728px", "fontSize": "117px"}}, "em": "PHẦN"}], "t0": 58.16, "t1": 61.38, "lay": "corner"}, {"type": "endcard", "t0": 61.38, "t1": 81.38, "bg": null, "sub": null}], "prog0": 0.88035, "prog1": 1.0};
motion/hf/assets/long\mim-qwerty\ch07\data.js:1:window.CASE = {"topic": "mim-qwerty", "ch": "ch07", "dur": 70.1, "seed": 9716, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 07", "t": "VÌ SAO KHÔNG AI ĐỔI ĐƯỢC"}, "acc": ["qwerty", "chậm", "tội", "phím", "thắng", "dvorak", "telex"], "lines": [{"text": "Năm 1985, nhà kinh tế học Paul David viết một bài báo ngắn, lấy chính QWERTY làm ví dụ.", "start": 0.0, "end": 5.84, "words": [{"w": "Năm", "t": 0.0, "d": 0.18}, {"w": "1985,", "t": 0.18, "d": 1.585}, {"w": "nhà", "t": 1.765, "d": 0.155}, {"w": "kinh", "t": 1.92, "d": 0.3}, {"w": "tế", "t": 2.22, "d": 0.305}, {"w": "học", "t": 2.525, "d": 0.21}, {"w": "Paul", "t": 2.735, "d": 0.19}, {"w": "David", "t": 2.925, "d": 0.23}, {"w": "viết", "t": 3.155, "d": 0.21}, {"w": "một", "t": 3.365, "d": 0.06}, {"w": "bài", "t": 3.425, "d": 0.185}, {"w": "báo", "t": 3.61, "d": 0.385}, {"w": "ngắn,", "t": 3.995, "d": 0.27}, {"w": "lấy", "t": 4.265, "d": 0.09}, {"w": "chính", "t": 4.355, "d": 0.21}, {"w": "QWERTY", "t": 4.565, "d": 0.395}, {"w": "làm", "t": 4.96, "d": 0.055}, {"w": "ví", "t": 5.015, "d": 0.325}, {"w": "dụ.", "t": 5.34, "d": 0.29}]}, {"text": "Ông gọi tên một hiện tượng: sự phụ thuộc vào lối mòn.", "start": 6.64, "end": 9.52, "words": [{"w": "Ông", "t": 6.69, "d": 0.14}, {"w": "gọi", "t": 6.83, "d": 0.185}, {"w": "tên", "t": 7.015, "d": 0.315}, {"w": "một", "t": 7.33, "d": 0.195}, {"w": "hiện", "t": 7.525, "d": 0.24}, {"w": "tượng:", "t": 7.765, "d": 0.305}, {"w": "sự", "t": 8.07, "d": 0.09}, {"w": "phụ", "t": 8.16, "d": 0.25}, {"w": "thuộc", "t": 8.41, "d": 0.145}, {"w": "vào", "t": 8.555, "d": 0.175}, {"w": "lối", "t": 8.73, "d": 0.3}, {"w": "mòn.", "t": 9.03, "d": 0.28}]}, {"text": "Một lựa chọn nhỏ từ rất sớm, có thể khoá chặt cả tương lai.", "start": 9.84, "end": 12.96, "words": [{"w": "Một", "t": 9.885, "d": 0.27}, {"w": "lựa", "t": 10.155, "d": 0.18}, {"w": "chọn", "t": 10.335, "d": 0.06}, {"w": "nhỏ", "t": 10.395, "d": 0.245}, {"w": "từ", "t": 10.64, "d": 0.21}, {"w": "rất", "t": 10.85, "d": 0.115}, {"w": "sớm,", "t": 10.965, "d": 0.45}, {"w": "có", "t": 11.415, "d": 0.125}, {"w": "thể", "t": 11.54, "d": 0.155}, {"w": "khoá", "t": 11.695, "d": 0.215}, {"w": "chặt", "t": 11.91, "d": 0.235}, {"w": "cả", "t": 12.145, "d": 0.175}, {"w": "tương", "t": 12.32, "d": 0.145}, {"w": "lai.", "t": 12.465, "d": 0.325}]}, {"text": "Vì đổi bàn phím không phải chuyện của riêng bạn.", "start": 13.96, "end": 16.04, "words": [{"w": "Vì", "t": 14.025, "d": 0.12}, {"w": "đổi", "t": 14.145, "d": 0.155}, {"w": "bàn", "t": 14.3, "d": 0.17}, {"w": "phím", "t": 14.47, "d": 0.25}, {"w": "không", "t": 14.72, "d": 0.185}, {"w": "phải", "t": 14.905, "d": 0.185}, {"w": "chuyện", "t": 15.09, "d": 0.205}, {"w": "của", "t": 15.295, "d": 0.06}, {"w": "riêng", "t": 15.355, "d": 0.165}, {"w": "bạn.", "t": 15.52, "d": 0.325}]}, {"text": "Bạn đổi, thì máy ở chỗ làm vẫn thế. Máy của bạn bè vẫn thế.", "start": 16.36, "end": 19.88, "words": [{"w": "Bạn", "t": 16.415, "d": 0.11}, {"w": "đổi,", "t": 16.525, "d": 0.485}, {"w": "thì", "t": 17.01, "d": 0.055}, {"w": "máy", "t": 17.065, "d": 0.165}, {"w": "ở", "t": 17.23, "d": 0.24}, {"w": "chỗ", "t": 17.47, "d": 0.325}, {"w": "làm", "t": 17.795, "d": 0.195}, {"w": "vẫn", "t": 17.99, "d": 0.055}, {"w": "thế.", "t": 18.045, "d": 0.46}, {"w": "Máy", "t": 18.505, "d": 0.165}, {"w": "của", "t": 18.67, "d": 0.055}, {"w": "bạn", "t": 18.725, "d": 0.195}, {"w": "bè", "t": 18.92, "d": 0.215}, {"w": "vẫn", "t": 19.135, "d": 0.24}, {"w": "thế.", "t": 19.375, "d": 0.345}]}, {"text": "Còn muốn mọi người cùng đổi một lúc, thì chẳng ai đứng ra tổ chức nổi.", "start": 20.2, "end": 23.48, "words": [{"w": "Còn", "t": 20.225, "d": 0.245}, {"w": "muốn", "t": 20.47, "d": 0.14}, {"w": "mọi", "t": 20.61, "d": 0.225}, {"w": "người", "t": 20.835, "d": 0.06}, {"w": "cùng", "t": 20.895, "d": 0.165}, {"w": "đổi", "t": 21.06, "d": 0.165}, {"w": "một", "t": 21.225, "d": 0.325}, {"w": "lúc,", "t": 21.55, "d": 0.24}, {"w": "thì", "t": 21.79, "d": 0.07}, {"w": "chẳng", "t": 21.86, "d": 0.245}, {"w": "ai", "t": 22.105, "d": 0.175}, {"w": "đứng", "t": 22.28, "d": 0.26}, {"w": "ra", "t": 22.54, "d": 0.1}, {"w": "tổ", "t": 22.64, "d": 0.165}, {"w": "chức", "t": 22.805, "d": 0.285}, {"w": "nổi.", "t": 23.09, "d": 0.215}]}, {"text": "Thử nhìn sang nước Pháp.", "start": 24.48, "end": 27.44, "words": [{"w": "Thử", "t": 24.48, "d": 0.58}, {"w": "nhìn", "t": 25.06, "d": 0.54}, {"w": "sang", "t": 25.6, "d": 0.395}, {"w": "nước", "t": 25.995, "d": 0.495}, {"w": "Pháp.", "t": 26.49, "d": 0.785}]}, {"text": "Người Pháp gõ một bàn phím khác, tên là AZERTY.", "start": 27.76, "end": 30.64, "words": [{"w": "Người", "t": 27.76, "d": 0.34}, {"w": "Pháp", "t": 28.1, "d": 0.065}, {"w": "gõ", "t": 28.165, "d": 0.26}, {"w": "một", "t": 28.425, "d": 0.185}, {"w": "bàn", "t": 28.61, "d": 0.44}, {"w": "phím", "t": 29.05, "d": 0.2}, {"w": "khác,", "t": 29.25, "d": 0.435}, {"w": "tên", "t": 29.685, "d": 0.24}, {"w": "là", "t": 29.925, "d": 0.24}, {"w": "AZERTY.", "t": 30.165, "d": 0.285}]}, {"text": "Và nhiều người kêu nó bất tiện. Muốn gõ một chữ hoa có dấu cũng khó.", "start": 30.96, "end": 34.56, "words": [{"w": "Và", "t": 30.96, "d": 0.25}, {"w": "nhiều", "t": 31.21, "d": 0.195}, {"w": "người", "t": 31.405, "d": 0.145}, {"w": "kêu", "t": 31.55, "d": 0.25}, {"w": "nó", "t": 31.8, "d": 0.22}, {"w": "bất", "t": 32.02, "d": 0.18}, {"w": "tiện.", "t": 32.2, "d": 0.2}, {"w": "Muốn", "t": 32.4, "d": 0.155}, {"w": "gõ", "t": 32.555, "d": 0.275}, {"w": "một", "t": 32.83, "d": 0.165}, {"w": "chữ", "t": 32.995, "d": 0.175}, {"w": "hoa", "t": 33.17, "d": 0.17}, {"w": "có", "t": 33.34, "d": 0.22}, {"w": "dấu", "t": 33.56, "d": 0.345}, {"w": "cũng", "t": 33.905, "d": 0.17}, {"w": "khó.", "t": 34.075, "d": 0.26}]}, {"text": "Năm 2019, nước Pháp công bố một tiêu chuẩn bàn phím mới.", "start": 34.88, "end": 38.64, "words": [{"w": "Năm", "t": 34.94, "d": 0.105}, {"w": "2019,", "t": 35.045, "d": 1.26}, {"w": "nước", "t": 36.305, "d": 0.215}, {"w": "Pháp", "t": 36.52, "d": 0.2}, {"w": "công", "t": 36.72, "d": 0.265}, {"w": "bố", "t": 36.985, "d": 0.17}, {"w": "một", "t": 37.155, "d": 0.225}, {"w": "tiêu", "t": 37.38, "d": 0.18}, {"w": "chuẩn", "t": 37.56, "d": 0.245}, {"w": "bàn", "t": 37.805, "d": 0.19}, {"w": "phím", "t": 37.995, "d": 0.06}, {"w": "mới.", "t": 38.055, "d": 0.36}]}, {"text": "Nhưng tiêu chuẩn ấy chỉ là tự nguyện.", "start": 38.96, "end": 40.8, "words": [{"w": "Nhưng", "t": 38.96, "d": 0.135}, {"w": "tiêu", "t": 39.095, "d": 0.16}, {"w": "chuẩn", "t": 39.255, "d": 0.36}, {"w": "ấy", "t": 39.615, "d": 0.07}, {"w": "chỉ", "t": 39.685, "d": 0.195}, {"w": "là", "t": 39.88, "d": 0.31}, {"w": "tự", "t": 40.19, "d": 0.06}, {"w": "nguyện.", "t": 40.25, "d": 0.36}]}, {"text": "Và trong bản cải tiến của nó, các chữ cái vẫn nằm nguyên chỗ cũ. Chỉ dấu và ký hiệu được dời đi.", "start": 41.12, "end": 46.08, "words": [{"w": "Và", "t": 41.12, "d": 0.23}, {"w": "trong", "t": 41.35, "d": 0.2}, {"w": "bản", "t": 41.55, "d": 0.165}, {"w": "cải", "t": 41.715, "d": 0.175}, {"w": "tiến", "t": 41.89, "d": 0.11}, {"w": "của", "t": 42.0, "d": 0.32}, {"w": "nó,", "t": 42.32, "d": 0.19}, {"w": "các", "t": 42.51, "d": 0.33}, {"w": "chữ", "t": 42.84, "d": 0.185}, {"w": "cái", "t": 43.025, "d": 0.155}, {"w": "vẫn", "t": 43.18, "d": 0.1}, {"w": "nằm", "t": 43.28, "d": 0.255}, {"w": "nguyên", "t": 43.535, "d": 0.25}, {"w": "chỗ", "t": 43.785, "d": 0.195}, {"w": "cũ.", "t": 43.98, "d": 0.335}, {"w": "Chỉ", "t": 44.315, "d": 0.195}, {"w": "dấu", "t": 44.51, "d": 0.06}, {"w": "và", "t": 44.57, "d": 0.27}, {"w": "ký", "t": 44.84, "d": 0.225}, {"w": "hiệu", "t": 45.065, "d": 0.125}, {"w": "được", "t": 45.19, "d": 0.295}, {"w": "dời", "t": 45.485, "d": 0.11}, {"w": "đi.", "t": 45.595, "d": 0.33}]}, {"text": "Rồi tới chiếc điện thoại.", "start": 47.08, "end": 48.2, "words": [{"w": "Rồi", "t": 47.135, "d": 0.22}, {"w": "tới", "t": 47.355, "d": 0.155}, {"w": "chiếc", "t": 47.51, "d": 0.115}, {"w": "điện", "t": 47.625, "d": 0.17}, {"w": "thoại.", "t": 47.795, "d": 0.215}]}, {"text": "Năm 2013, một nhóm nghiên cứu ở châu Âu thiết kế lại từ đầu, một bàn phím cho hai ngón cái.", "start": 48.52, "end": 54.04, "words": [{"w": "Năm", "t": 48.67, "d": 0.145}, {"w": "2013,", "t": 48.815, "d": 1.26}, {"w": "một", "t": 50.075, "d": 0.21}, {"w": "nhóm", "t": 50.285, "d": 0.145}, {"w": "nghiên", "t": 50.43, "d": 0.22}, {"w": "cứu", "t": 50.65, "d": 0.195}, {"w": "ở", "t": 50.845, "d": 0.21}, {"w": "châu", "t": 51.055, "d": 0.245}, {"w": "Âu", "t": 51.3, "d": 0.085}, {"w": "thiết", "t": 51.385, "d": 0.175}, {"w": "kế", "t": 51.56, "d": 0.3}, {"w": "lại", "t": 51.86, "d": 0.145}, {"w": "từ", "t": 52.005, "d": 0.23}, {"w": "đầu,", "t": 52.235, "d": 0.23}, {"w": "một", "t": 52.465, "d": 0.21}, {"w": "bàn", "t": 52.675, "d": 0.225}, {"w": "phím", "t": 52.9, "d": 0.2}, {"w": "cho", "t": 53.1, "d": 0.06}, {"w": "hai", "t": 53.16, "d": 0.3}, {"w": "ngón", "t": 53.46, "d": 0.14}, {"w": "cái.", "t": 53.6, "d": 0.285}]}, {"text": "Trong thử nghiệm của họ, sau khi luyện tập, người dùng gõ nhanh hơn khoảng một phần ba.", "start": 54.36, "end": 58.6, "words": [{"w": "Trong", "t": 54.36, "d": 0.12}, {"w": "thử", "t": 54.48, "d": 0.305}, {"w": "nghiệm", "t": 54.785, "d": 0.13}, {"w": "của", "t": 54.915, "d": 0.325}, {"w": "họ,", "t": 55.24, "d": 0.165}, {"w": "sau", "t": 55.405, "d": 0.25}, {"w": "khi", "t": 55.655, "d": 0.3}, {"w": "luyện", "t": 55.955, "d": 0.235}, {"w": "tập,", "t": 56.19, "d": 0.325}, {"w": "người", "t": 56.515, "d": 0.07}, {"w": "dùng", "t": 56.585, "d": 0.25}, {"w": "gõ", "t": 56.835, "d": 0.19}, {"w": "nhanh", "t": 57.025, "d": 0.185}, {"w": "hơn", "t": 57.21, "d": 0.195}, {"w": "khoảng", "t": 57.405, "d": 0.225}, {"w": "một", "t": 57.63, "d": 0.2}, {"w": "phần", "t": 57.83, "d": 0.19}, {"w": "ba.", "t": 58.02, "d": 0.36}]}, {"text": "Hơn mười năm sau, bạn đã thấy ai dùng nó chưa?", "start": 58.92, "end": 61.4, "words": [{"w": "Hơn", "t": 58.98, "d": 0.135}, {"w": "mười", "t": 59.115, "d": 0.265}, {"w": "năm", "t": 59.38, "d": 0.185}, {"w": "sau,", "t": 59.565, "d": 0.345}, {"w": "bạn", "t": 59.91, "d": 0.075}, {"w": "đã", "t": 59.985, "d": 0.285}, {"w": "thấy", "t": 60.27, "d": 0.135}, {"w": "ai", "t": 60.405, "d": 0.155}, {"w": "dùng", "t": 60.56, "d": 0.2}, {"w": "nó", "t": 60.76, "d": 0.27}, {"w": "chưa?", "t": 61.03, "d": 0.22}]}, {"text": "Hai câu chuyện cho thấy cùng một điều.", "start": 62.4, "end": 64.08, "words": [{"w": "Hai", "t": 62.4, "d": 0.21}, {"w": "câu", "t": 62.61, "d": 0.17}, {"w": "chuyện", "t": 62.78, "d": 0.145}, {"w": "cho", "t": 62.925, "d": 0.225}, {"w": "thấy", "t": 63.15, "d": 0.06}, {"w": "cùng", "t": 63.21, "d": 0.215}, {"w": "một", "t": 63.425, "d": 0.19}, {"w": "điều.", "t": 63.615, "d": 0.25}]}, {"text": "Thứ giữ QWERTY ở lại, không còn là chiếc máy.", "start": 64.4, "end": 67.04, "words": [{"w": "Thứ", "t": 64.425, "d": 0.28}, {"w": "giữ", "t": 64.705, "d": 0.18}, {"w": "QWERTY", "t": 64.885, "d": 0.28}, {"w": "ở", "t": 65.165, "d": 0.2}, {"w": "lại,", "t": 65.365, "d": 0.36}, {"w": "không", "t": 65.725, "d": 0.215}, {"w": "còn", "t": 65.94, "d": 0.08}, {"w": "là", "t": 66.02, "d": 0.205}, {"w": "chiếc", "t": 66.225, "d": 0.345}, {"w": "máy.", "t": 66.57, "d": 0.275}]}, {"text": "Mà là hàng tỷ đôi tay đã quen.", "start": 67.36, "end": 68.88, "words": [{"w": "Mà", "t": 67.36, "d": 0.215}, {"w": "là", "t": 67.575, "d": 0.155}, {"w": "hàng", "t": 67.73, "d": 0.06}, {"w": "tỷ", "t": 67.79, "d": 0.17}, {"w": "đôi", "t": 67.96, "d": 0.215}, {"w": "tay", "t": 68.175, "d": 0.175}, {"w": "đã", "t": 68.35, "d": 0.155}, {"w": "quen.", "t": 68.505, "d": 0.185}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "date", "day": "MỘT BÀI BÁO NGẮN CỦA NHÀ KINH TẾ PAUL DAVID", "date": "1985", "t0": 0.0, "t1": 6.64, "dayAt": 0.15, "groupAt": [0.4]}, {"type": "slam", "text": "PHỤ THUỘC VÀO LỐI MÒN", "s