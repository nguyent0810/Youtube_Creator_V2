motion/hf/assets/long\mim-ke-huy-diet-petrov\ch08\data.js:1:window.CASE = {"topic": "mim-ke-huy-diet-petrov", "ch": "ch08", "dur": 119.3, "seed": 32880, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 08", "t": "CUỘC GỌI"}, "acc": ["báo", "máy", "phóng", "mây", "người", "ghế", "chưa", "tấn"], "lines": [{"text": "Theo lời ông với BBC, chỉ cần với tay lấy điện thoại, gọi đường dây thẳng lên chỉ huy cấp cao.", "start": 0.0, "end": 4.8, "words": [{"w": "Theo", "t": 0.085, "d": 0.255}, {"w": "lời", "t": 0.34, "d": 0.18}, {"w": "ông", "t": 0.52, "d": 0.12}, {"w": "với", "t": 0.64, "d": 0.135}, {"w": "BBC,", "t": 0.775, "d": 0.71}, {"w": "chỉ", "t": 1.485, "d": 0.075}, {"w": "cần", "t": 1.56, "d": 0.185}, {"w": "với", "t": 1.745, "d": 0.29}, {"w": "tay", "t": 2.035, "d": 0.17}, {"w": "lấy", "t": 2.205, "d": 0.235}, {"w": "điện", "t": 2.44, "d": 0.06}, {"w": "thoại,", "t": 2.5, "d": 0.365}, {"w": "gọi", "t": 2.865, "d": 0.095}, {"w": "đường", "t": 2.96, "d": 0.265}, {"w": "dây", "t": 3.225, "d": 0.16}, {"w": "thẳng", "t": 3.385, "d": 0.18}, {"w": "lên", "t": 3.565, "d": 0.185}, {"w": "chỉ", "t": 3.75, "d": 0.195}, {"w": "huy", "t": 3.945, "d": 0.18}, {"w": "cấp", "t": 4.125, "d": 0.145}, {"w": "cao.", "t": 4.27, "d": 0.305}]}, {"text": "Nhưng tôi không nhúc nhích được. Tôi thấy như mình đang ngồi trên một cái chảo nóng.", "start": 5.6, "end": 9.6, "words": [{"w": "Nhưng", "t": 5.665, "d": 0.2}, {"w": "tôi", "t": 5.865, "d": 0.135}, {"w": "không", "t": 6.0, "d": 0.325}, {"w": "nhúc", "t": 6.325, "d": 0.055}, {"w": "nhích", "t": 6.38, "d": 0.19}, {"w": "được.", "t": 6.57, "d": 0.33}, {"w": "Tôi", "t": 6.9, "d": 0.19}, {"w": "thấy", "t": 7.09, "d": 0.195}, {"w": "như", "t": 7.285, "d": 0.2}, {"w": "mình", "t": 7.485, "d": 0.155}, {"w": "đang", "t": 7.64, "d": 0.245}, {"w": "ngồi", "t": 7.885, "d": 0.125}, {"w": "trên", "t": 8.01, "d": 0.235}, {"w": "một", "t": 8.245, "d": 0.325}, {"w": "cái", "t": 8.57, "d": 0.19}, {"w": "chảo", "t": 8.76, "d": 0.06}, {"w": "nóng.", "t": 8.82, "d": 0.365}]}, {"text": "Bài năm 2004 kể ông có rất ít thời gian.", "start": 10.6, "end": 13.88, "words": [{"w": "Bài", "t": 10.655, "d": 0.12}, {"w": "năm", "t": 10.775, "d": 0.18}, {"w": "2004", "t": 10.955, "d": 1.185}, {"w": "kể", "t": 12.14, "d": 0.275}, {"w": "ông", "t": 12.415, "d": 0.225}, {"w": "có", "t": 12.64, "d": 0.2}, {"w": "rất", "t": 12.84, "d": 0.175}, {"w": "ít", "t": 13.015, "d": 0.21}, {"w": "thời", "t": 13.225, "d": 0.06}, {"w": "gian.", "t": 13.285, "d": 0.36}]}, {"text": "Trong hai ba phút ấy, chẳng phân tích được gì ra hồn. Chỉ còn trực giác.", "start": 14.2, "end": 18.36, "words": [{"w": "Trong", "t": 14.29, "d": 0.155}, {"w": "hai", "t": 14.445, "d": 0.21}, {"w": "ba", "t": 14.655, "d": 0.335}, {"w": "phút", "t": 14.99, "d": 0.055}, {"w": "ấy,", "t": 15.045, "d": 0.335}, {"w": "chẳng", "t": 15.38, "d": 0.185}, {"w": "phân", "t": 15.565, "d": 0.375}, {"w": "tích", "t": 15.94, "d": 0.135}, {"w": "được", "t": 16.075, "d": 0.235}, {"w": "gì", "t": 16.31, "d": 0.205}, {"w": "ra", "t": 16.515, "d": 0.17}, {"w": "hồn.", "t": 16.685, "d": 0.415}, {"w": "Chỉ", "t": 17.1, "d": 0.095}, {"w": "còn", "t": 17.195, "d": 0.2}, {"w": "trực", "t": 17.395, "d": 0.215}, {"w": "giác.", "t": 17.61, "d": 0.38}]}, {"text": "Rồi Petrov nhấc máy.", "start": 19.36, "end": 20.48, "words": [{"w": "Rồi", "t": 19.36, "d": 0.205}, {"w": "Petrov", "t": 19.565, "d": 0.165}, {"w": "nhấc", "t": 19.73, "d": 0.285}, {"w": "máy.", "t": 20.015, "d": 0.26}]}, {"text": "Ông gọi sĩ quan trực ở sở chỉ huy quân đội Liên Xô.", "start": 20.8, "end": 23.44, "words": [{"w": "Ông", "t": 20.92, "d": 0.145}, {"w": "gọi", "t": 21.065, "d": 0.225}, {"w": "sĩ", "t": 21.29, "d": 0.105}, {"w": "quan", "t": 21.395, "d": 0.185}, {"w": "trực", "t": 21.58, "d": 0.25}, {"w": "ở", "t": 21.83, "d": 0.19}, {"w": "sở", "t": 22.02, "d": 0.17}, {"w": "chỉ", "t": 22.19, "d": 0.06}, {"w": "huy", "t": 22.25, "d": 0.15}, {"w": "quân", "t": 22.4, "d": 0.19}, {"w": "đội", "t": 22.59, "d": 0.16}, {"w": "Liên", "t": 22.75, "d": 0.29}, {"w": "Xô.", "t": 23.04, "d": 0.21}]}, {"text": "Và ông báo rằng hệ thống bị trục trặc.", "start": 23.76, "end": 25.6, "words": [{"w": "Và", "t": 23.76, "d": 0.16}, {"w": "ông", "t": 23.92, "d": 0.165}, {"w": "báo", "t": 24.085, "d": 0.265}, {"w": "rằng", "t": 24.35, "d": 0.145}, {"w": "hệ", "t": 24.495, "d": 0.06}, {"w": "thống", "t": 24.555, "d": 0.23}, {"w": "bị", "t": 24.785, "d": 0.2}, {"w": "trục", "t": 24.985, "d": 0.145}, {"w": "trặc.", "t": 25.13, "d": 0.295}]}, {"text": "Không phải bị tấn công.", "start": 25.92, "end": 27.52, "words": [{"w": "Không", "t": 25.92, "d": 0.155}, {"w": "phải", "t": 26.075, "d": 0.355}, {"w": "bị", "t": 26.43, "d": 0.47}, {"w": "tấn", "t": 26.9, "d": 0.285}, {"w": "công.", "t": 27.185, "d": 0.335}]}, {"text": "Về sau, ông nói với BBC một câu về giây phút ấy.", "start": 28.52, "end": 31.72, "words": [{"w": "Về", "t": 28.52, "d": 0.105}, {"w": "sau,", "t": 28.625, "d": 0.48}, {"w": "ông", "t": 29.105, "d": 0.205}, {"w": "nói", "t": 29.31, "d": 0.06}, {"w": "với", "t": 29.37, "d": 0.165}, {"w": "BBC", "t": 29.535, "d": 0.75}, {"w": "một", "t": 30.285, "d": 0.135}, {"w": "câu", "t": 30.42, "d": 0.25}, {"w": "về", "t": 30.67, "d": 0.23}, {"w": "giây", "t": 30.9, "d": 0.14}, {"w": "phút", "t": 31.04, "d": 0.165}, {"w": "ấy.", "t": 31.205, "d": 0.325}]}, {"text": "Tôi biết rất rõ rằng sẽ không ai sửa được sai lầm của tôi, nếu tôi phạm phải.", "start": 32.04, "end": 36.28, "words": [{"w": "Tôi", "t": 32.095, "d": 0.28}, {"w": "biết", "t": 32.375, "d": 0.2}, {"w": "rất", "t": 32.575, "d": 0.2}, {"w": "rõ", "t": 32.775, "d": 0.155}, {"w": "rằng", "t": 32.93, "d": 0.135}, {"w": "sẽ", "t": 33.065, "d": 0.14}, {"w": "không", "t": 33.205, "d": 0.365}, {"w": "ai", "t": 33.57, "d": 0.06}, {"w": "sửa", "t": 33.63, "d": 0.335}, {"w": "được", "t": 33.965, "d": 0.06}, {"w": "sai", "t": 34.025, "d": 0.34}, {"w": "lầm", "t": 34.365, "d": 0.195}, {"w": "của", "t": 34.56, "d": 0.2}, {"w": "tôi,", "t": 34.76, "d": 0.27}, {"w": "nếu", "t": 35.03, "d": 0.075}, {"w": "tôi", "t": 35.105, "d": 0.235}, {"w": "phạm", "t": 35.34, "d": 0.175}, {"w": "phải.", "t": 35.515, "d": 0.395}]}, {"text": "Vậy câu trả lời cho hai cái nút là gì?", "start": 36.6, "end": 38.52, "words": [{"w": "Vậy", "t": 36.655, "d": 0.135}, {"w": "câu", "t": 36.79, "d": 0.15}, {"w": "trả", "t": 36.94, "d": 0.185}, {"w": "lời", "t": 37.125, "d": 0.16}, {"w": "cho", "t": 37.285, "d": 0.145}, {"w": "hai", "t": 37.43, "d": 0.21}, {"w": "cái", "t": 37.64, "d": 0.155}, {"w": "nút", "t": 37.795, "d": 0.13}, {"w": "là", "t": 37.925, "d": 0.165}, {"w": "gì?", "t": 38.09, "d": 0.195}]}, {"text": "Ông có báo lên, nhưng báo điều ngược lại với cỗ máy.", "start": 39.12, "end": 41.76, "words": [{"w": "Ông", "t": 39.185, "d": 0.205}, {"w": "có", "t": 39.39, "d": 0.13}, {"w": "báo", "t": 39.52, "d": 0.135}, {"w": "lên,", "t": 39.655, "d": 0.425}, {"w": "nhưng", "t": 40.08, "d": 0.085}, {"w": "báo", "t": 40.165, "d": 0.21}, {"w": "điều", "t": 40.375, "d": 0.17}, {"w": "ngược", "t": 40.545, "d": 0.17}, {"w": "lại", "t": 40.715, "d": 0.165}, {"w": "với", "t": 40.88, "d": 0.26}, {"w": "cỗ", "t": 41.14, "d": 0.11}, {"w": "máy.", "t": 41.25, "d": 0.34}]}, {"text": "Theo bài năm 2004, một tay ông cầm ống nghe báo cáo cấp trên.", "start": 42.76, "end": 46.44, "words": [{"w": "Theo", "t": 42.765, "d": 0.095}, {"w": "bài", "t": 42.86, "d": 0.3}, {"w": "năm", "t": 43.16, "d": 0.125}, {"w": "2004,", "t": 43.285, "d": 1.085}, {"w": "một", "t": 44.37, "d": 0.255}, {"w": "tay", "t": 44.625, "d": 0.21}, {"w": "ông", "t": 44.835, "d": 0.085}, {"w": "cầm", "t": 44.92, "d": 0.14}, {"w": "ống", "t": 45.06, "d": 0.295}, {"w": "nghe", "t": 45.355, "d": 0.06}, {"w": "báo", "t": 45.415, "d": 0.225}, {"w": "cáo", "t": 45.64, "d": 0.155}, {"w": "cấp", "t": 45.795, "d": 0.14}, {"w": "trên.", "t": 45.935, "d": 0.315}]}, {"text": "Tay kia cầm micro, ra lệnh cho kíp trực.", "start": 46.76, "end": 49.48, "words": [{"w": "Tay", "t": 46.815, "d": 0.2}, {"w": "kia", "t": 47.015, "d": 0.29}, {"w": "cầm", "t": 47.305, "d": 0.315}, {"w": "micro,", "t": 47.62, "d": 0.41}, {"w": "ra", "t": 48.03, "d": 0.215}, {"w": "lệnh", "t": 48.245, "d": 0.11}, {"w": "cho", "t": 48.355, "d": 0.395}, {"w": "kíp", "t": 48.75, "d": 0.25}, {"w": "trực.", "t": 49.0, "d": 0.285}]}, {"text": "Hãy nhớ hai bàn tay bận rộn ấy, vì chúng sẽ quay lại trong một cuộc điều tra.", "start": 49.8, "end": 53.72, "words": [{"w": "Hãy", "t": 49.8, "d": 0.27}, {"w": "nhớ", "t": 50.07, "d": 0.145}, {"w": "hai", "t": 50.215, "d": 0.175}, {"w": "bàn", "t": 50.39, "d": 0.25}, {"w": "tay", "t": 50.64, "d": 0.195}, {"w": "bận", "t": 50.835, "d": 0.175}, {"w": "rộn", "t": 51.01, "d": 0.22}, {"w": "ấy,", "t": 51.23, "d": 0.245}, {"w": "vì", "t": 51.475, "d": 0.09}, {"w": "chúng", "t": 51.565, "d": 0.19}, {"w": "sẽ", "t": 51.755, "d": 0.315}, {"w": "quay", "t": 52.07, "d": 0.175}, {"w": "lại", "t": 52.245, "d": 0.23}, {"w": "trong", "t": 52.475, "d": 0.165}, {"w": "một", "t": 52.64, "d": 0.22}, {"w": "cuộc", "t": 52.86, "d": 0.225}, {"w": "điều", "t": 53.085, "d": 0.055}, {"w": "tra.", "t": 53.14, "d": 0.365}]}, {"text": "BBC viết rằng nếu ông sai, những vụ nổ hạt nhân đầu tiên sẽ đến chỉ vài phút sau.", "start": 54.72, "end": 59.76, "words": [{"w": "BBC", "t": 54.775, "d": 0.58}, {"w": "viết", "t": 55.355, "d": 0.375}, {"w": "rằng", "t": 55.73, "d": 0.2}, {"w": "nếu", "t": 55.93, "d": 0.06}, {"w": "ông", "t": 55.99, "d": 0.385}, {"w": "sai,", "t": 56.375, "d": 0.345}, {"w": "những", "t": 56.72, "d": 0.08}, {"w": "vụ", "t": 56.8, "d": 0.185}, {"w": "nổ", "t": 56.985, "d": 0.22}, {"w": "hạt", "t": 57.205, "d": 0.33}, {"w": "nhân", "t": 57.535, "d": 0.145}, {"w": "đầu", "t": 57.68, "d": 0.22}, {"w": "tiên", "t": 57.9, "d": 0.21}, {"w": "sẽ", "t": 58.11, "d": 0.255}, {"w": "đến", "t": 58.365, "d": 0.205}, {"w": "chỉ", "t": 58.57, "d": 0.215}, {"w": "vài", "t": 58.785, "d": 0.235}, {"w": "phút", "t": 59.02, "d": 0.195}, {"w": "sau.", "t": 59.215, "d": 0.355}]}, {"text": "Không có gì đến cả.", "start": 60.08, "end": 61.12, "words": [{"w": "Không", "t": 60.08, "d": 0.15}, {"w": "có", "t": 60.23, "d": 0.115}, {"w": "gì", "t": 60.345, "d": 0.19}, {"w": "đến", "t": 60.535, "d": 0.19}, {"w": "cả.", "t": 60.725, "d": 0.175}]}, {"text": "Hai mươi ba phút sau, tôi nhận ra là chẳng có gì xảy ra. Nếu là tấn công thật, tôi đã biết rồi. Nhẹ cả người.", "start": 61.44, "end": 68.0, "words": [{"w": "Hai", "t": 61.55, "d": 0.24}, {"w": "mươi", "t": 61.79, "d": 0.215}, {"w": "ba", "t": 62.005, "d": 0.22}, {"w": "phút", "t": 62.225, "d": 0.25}, {"w": "sau,", "t": 62.475, "d": 0.155}, {"w": "tôi", "t": 62.63, "d": 0.395}, {"w": "nhận", "t": 63.025, "d": 0.06}, {"w": "ra", "t": 63.085, "d": 0.34}, {"w": "là", "t": 63.425, "d": 0.23}, {"w": "chẳng", "t": 63.655, "d": 0.195}, {"w": "có", "t": 63.85, "d": 0.19}, {"w": "gì", "t": 64.04, "d": 0.195}, {"w": "xảy", "t": 64.235, "d": 0.26}, {"w": "ra.", "t": 64.495, "d": 0.335}, {"w": "Nếu", "t": 64.83, "d": 0.06}, {"w": "là", "t": 64.89, "d": 0.345}, {"w": "tấn", "t": 65.235, "d": 0.175}, {"w": "công", "t": 65.41, "d": 0.195}, {"w": "thật,", "t": 65.605, "d": 0.27}, {"w": "tôi", "t": 65.875, "d": 0.255}, {"w": "đã", "t": 66.13, "d": 0.295}, {"w": "biết", "t": 66.425, "d": 0.06}, {"w": "rồi.", "t": 66.485, "d": 0.42}, {"w": "Nhẹ", "t": 66.905, "d": 0.09}, {"w": "cả", "t": 66.995, "d": 0.245}, {"w": "người.", "t": 67.24, "d": 0.4}]}, {"text": "Ba mươi năm sau, ông nói với BBC rằng khả năng khi ấy là năm mươi năm mươi.", "start": 69.0, "end": 73.32, "words": [{"w": "Ba", "t": 69.17, "d": 0.225}, {"w": "mươi", "t": 69.395, "d": 0.115}, {"w": "năm", "t": 69.51, "d": 0.295}, {"w": "sau,", "t": 69.805, "d": 0.3}, {"w": "ông", "t": 70.105, "d": 0.06}, {"w": "nói", "t": 70.165, "d": 0.165}, {"w": "với", "t": 70.33, "d": 0.18}, {"w": "BBC", "t": 70.51, "d": 0.6}, {"w": "rằng", "t": 71.11, "d": 0.185}, {"w": "khả", "t": 71.295, "d": 0.245}, {"w": "năng", "t": 71.54, "d": 0.185}, {"w": "khi", "t": 71.725, "d": 0.245}, {"w": "ấy", "t": 71.97, "d": 0.06}, {"w": "là", "t": 72.03, "d": 0.24}, {"w": "năm", "t": 72.27, "d": 0.255}, {"w": "mươi", "t": 72.525, "d": 0.095}, {"w": "năm", "t": 72.62, "d": 0.26}, {"w": "mươi.", "t": 72.88, "d": 0.245}]}, {"text": "Ông thừa nhận chưa bao giờ chắc tuyệt đối đó là báo động giả.", "start": 73.64, "end": 76.84, "words": [{"w": "Ông", "t": 73.72, "d": 0.165}, {"w": "thừa", "t": 73.885, "d": 0.35}, {"w": "nhận", "t": 74.235, "d": 0.135}, {"w": "chưa", "t": 74.37, "d": 0.135}, {"w": "bao", "t": 74.505, "d": 0.335}, {"w": "giờ", "t": 74.84, "d": 0.145}, {"w": "chắc", "t": 74.985, "d": 0.27}, {"w": "tuyệt", "t": 75.255, "d": 0.17}, {"w": "đối", "t": 75.425, "d": 0.265}, {"w": "đó", "t": 75.69, "d": 0.095}, {"w": "là", "t": 75.785, "d": 0.375}, {"w": "báo", "t": 76.16, "d": 0.165}, {"w": "động", "t": 76.325, "d": 0.12}, {"w": "giả.", "t": 76.445, "d": 0.395}]}, {"text": "Năm mươi năm mươi.", "start": 77.16, "end": 77.96, "words": [{"w": "Năm", "t": 77.2, "d": 0.1}, {"w": "mươi", "t": 77.3, "d": 0.21}, {"w": "năm", "t": 77.51, "d": 0.06}, {"w": "mươi.", "t": 77.57, "d": 0.215}]}, {"text": "Ông cũng nghĩ, nếu một đồng đội khác trực ca ấy, có lẽ báo động đã được báo lên.", "start": 78.96, "end": 83.2, "words": [{"w": "Ông", "t": 79.01, "d": 0.16}, {"w": "cũng", "t": 79.17, "d": 0.31}, {"w": "nghĩ,", "t": 79.48, "d": 0.29}, {"w": "nếu", "t": 79.77, "d": 0.065}, {"w": "một", "t": 79.835, "d": 0.235}, {"w": "đồng", "t": 80.07, "d": 0.125}, {"w": "đội", "t": 80.195, "d": 0.365}, {"w": "khác", "t": 80.56, "d": 0.19}, {"w": "trực", "t": 80.75, "d": 0.185}, {"w": "ca", "t": 80.935, "d": 0.2}, {"w": "ấy,", "t": 81.135, "d": 0.31}, {"w": "có", "t": 81.445, "d": 0.12}, {"w": "lẽ", "t": 81.565, "d": 0.095}, {"w": "báo", "t": 81.66, "d": 0.25}, {"w": "động", "t": 81.91, "d": 0.175}, {"w": "đã", "t": 82.085, "d": 0.16}, {"w": "được", "t": 82.245, "d": 0.355}, {"w": "báo", "t": 82.6, "d": 0.065}, {"w": "lên.", "t": 82.665, "d": 0.35}]}, {"text": "BBC còn viết một câu mà mình muốn bạn nghe kỹ.", "start": 83.52, "end": 86.56, "words": [{"w": "BBC", "t": 83.6, "d": 0.52}, {"w": "còn", "t": 84.12, "d": 0.305}, {"w": "viết", "t": 84.425, "d": 0.25}, {"w": "một", "t": 84.675, "d": 0.24}, {"w": "câu", "t": 84.915, "d": 0.205}, {"w": "mà", "t": 85.12, "d": 0.125}, {"w": "mình", "t": 85.245, "d": 0.105}, {"w": "muốn", "t": 85.35, "d": 0.29}, {"w": "bạn", "t": 85.64, "d": 0.2}, {"w": "nghe", "t": 85.84, "d": 0.13}, {"w": "kỹ.", "t": 85.97, "d": 0.42}]}, {"text": "Làm như ông là trái hướng dẫn, là bỏ bổn phận.", "start": 86.88, "end": 89.2, "words": [{"w": "Làm", "t": 86.88, "d": 0.09}, {"w": "như", "t": 86.97, "d": 0.21}, {"w": "ông", "t": 87.18, "d": 0.17}, {"w": "là", "t": 87.35, "d": 0.17}, {"w": "trái", "t": 87.52, "d": 0.18}, {"w": "hướng", "t": 87.7, "d": 0.28}, {"w": "dẫn,", "t": 87.98, "d": 0.145}, {"w": "là", "t": 88.125, "d": 0.235}, {"w": "bỏ", "t": 88.36, "d": 0.215}, {"w": "bổn", "t": 88.575, "d": 0.195}, {"w": "phận.", "t": 88.77, "d": 0.205}]}, {"text": "Cách an toàn cho bản thân là đẩy trách nhiệm lên trên.", "start": 89.52, "end": 92.8, "words": [{"w": "Cách", "t": 89.575, "d": 0.34}, {"w": "an", "t": 89.915, "d": 0.225}, {"w": "toàn", "t": 90.14, "d": 0.31}, {"w": "cho", "t": 90.45, "d": 0.13}, {"w": "bản", "t": 90.58, "d": 0.31}, {"w": "thân", "t": 90.89, "d": 0.2}, {"w": "là", "t": 91.09, "d": 0.275}, {"w": "đẩy", "t": 91.365, "d": 0.165}, {"w": "trách", "t": 91.53, "d": 0.455}, {"w": "nhiệm", "t": 91.985, "d": 0.18}, {"w": "lên", "t": 92.165, "d": 0.24}, {"w": "trên.", "t": 92.405, "d": 0.395}]}, {"text": "Chính Petrov cũng nói với BBC điều tương tự.", "start": 93.8, "end": 96.52, "words": [{"w": "Chính", "t": 93.8, "d": 0.205}, {"w": "Petrov", "t": 94.005, "d": 0.165}, {"w": "cũng", "t": 94.17, "d": 0.335}, {"w": "nói", "t": 94.505, "d": 0.065}, {"w": "với", "t": 94.57, "d": 0.215}, {"w": "BBC", "t": 94.785, "d": 0.655}, {"w": "điều", "t": 95.44, "d": 0.27}, {"w": "tương", "t": 95.71, "d": 0.355}, {"w": "tự.", "t": 96.065, "d": 0.255}]}, {"text": "Tôi có đủ mọi dữ liệu. Nếu tôi gửi báo cáo lên, sẽ không ai nói nửa lời trách tôi.", "start": 96.84, "end": 101.64, "words": [{"w": "Tôi", "t": 96.93, "d": 0.115}, {"w": "có", "t": 97.045, "d": 0.345}, {"w": "đủ", "t": 97.39, "d": 0.215}, {"w": "mọi", "t": 97.605, "d": 0.06}, {"w": "dữ", "t": 97.665, "d": 0.335}, {"w": "liệu.", "t": 98.0, "d": 0.22}, {"w": "Nếu", "t": 98.22, "d": 0.235}, {"w": "tôi", "t": 98.455, "d": 0.195}, {"w": "gửi", "t": 98.65, "d": 0.195}, {"w": "báo", "t": 98.845, "d": 0.215}, {"w": "cáo", "t": 99.06, "d": 0.24}, {"w": "lên,", "t": 99.3, "d": 0.26}, {"w": "sẽ", "t": 99.56, "d": 0.09}, {"w": "không", "t": 99.65, "d": 0.22}, {"w": "ai", "t": 99.87, "d": 0.195}, {"w": "nói", "t": 100.065, "d": 0.17}, {"w": "nửa", "t": 100.235, "d": 0.2}, {"w": "lời", "t": 100.435, "d": 0.365}, {"w": "trách", "t": 100.8, "d": 0.19}, {"w": "tôi.", "t": 100.99, "d": 0.24}]}, {"text": "Nên nếu bạn đã bấm \"báo lên\" ngay từ chương một, bạn không hề ngốc.", "start": 102.64, "end": 105.84, "words": [{"w": "Nên", "t": 102.715, "d": 0.235}, {"w": "nếu", "t": 102.95, "d": 0.175}, {"w": "bạn", "t": 103.125, "d": 0.1}, {"w": "đã", "t": 103.225, "d": 0.195}, {"w": "bấm", "t": 103.42, "d": 0.215}, {"w": "\"báo", "t": 103.635, "d": 0.135}, {"w": "lên\"", "t": 103.77, "d": 0.21}, {"w": "ngay", "t": 103.98, "d": 0.155}, {"w": "từ", "t": 104.135, "d": 0.295}, {"w": "chương", "t": 104.43, "d": 0.185}, {"w": "một,", "t": 104.615, "d": 0.235}, {"w": "bạn", "t": 104.85, "d": 0.08}, {"w": "không", "t": 104.93, "d": 0.25}, {"w": "hề", "t": 105.18, "d": 0.165}, {"w": "ngốc.", "t": 105.345, "d": 0.325}]}, {"text": "Bạn chỉ làm đúng điều bản hướng dẫn yêu cầu.", "start": 106.16, "end": 108.24, "words": [{"w": "Bạn", "t": 106.175, "d": 0.12}, {"w": "chỉ", "t": 106.295, "d": 0.29}, {"w": "làm", "t": 106.585, "d": 0.195}, {"w": "đúng", "t": 106.78, "d": 0.06}, {"w": "điều", "t": 106.84, "d": 0.295}, {"w": "bản", "t": 107.135, "d": 0.175}, {"w": "hướng", "t": 107.31, "d": 0.06}, {"w": "dẫn", "t": 107.37, "d": 0.27}, {"w": "yêu", "t": 107.64, "d": 0.09}, {"w": "cầu.", "t": 107.73, "d": 0.325}]}, {"text": "Thứ khác biệt là sáu mẩu tin bạn vừa gom lại, và một người dám đặt chúng lên bàn cân với cỗ máy.", "start": 108.56, "end": 113.76, "words": [{"w": "Thứ", "t": 108.56, "d": 0.235}, {"w": "khác", "t": 108.795, "d": 0.26}, {"w": "biệt", "t": 109.055, "d": 0.12}, {"w": "là", "t": 109.175, "d": 0.12}, {"w": "sáu", "t": 109.295, "d": 0.23}, {"w": "mẩu", "t": 109.525, "d": 0.305}, {"w": "tin", "t": 109.83, "d": 0.21}, {"w": "bạn", "t": 110.04, "d": 0.205}, {"w": "vừa", "t": 110.245, "d": 0.25}, {"w": "gom", "t": 110.495, "d": 0.225}, {"w": "lại,", "t": 110.72, "d": 0.305}, {"w": "và", "t": 111.025, "d": 0.06}, {"w": "một", "t": 111.085, "d": 0.265}, {"w": "người", "t": 111.35, "d": 0.195}, {"w": "dám", "t": 111.545, "d": 0.335}, {"w": "đặt", "t": 111.88, "d": 0.12}, {"w": "chúng", "t": 112.0, "d": 0.225}, {"w": "lên", "t": 112.225, "d": 0.18}, {"w": "bàn", "t": 112.405, "d": 0.3}, {"w": "cân", "t": 112.705, "d": 0.095}, {"w": "với", "t": 112.8, "d": 0.32}, {"w": "cỗ", "t": 113.12, "d": 0.205}, {"w": "máy.", "t": 113.325, "d": 0.25}]}, {"text": "Nhưng nếu không có tên lửa nào, thì vệ tinh đã nhìn thấy cái gì?", "start": 114.76, "end": 117.8, "words": [{"w": "Nhưng", "t": 114.76, "d": 0.135}, {"w": "nếu", "t": 114.895, "d": 0.145}, {"w": "không", "t": 115.04, "d": 0.295}, {"w": "có", "t": 115.335, "d": 0.115}, {"w": "tên", "t": 115.45, "d": 0.175}, {"w": "lửa", "t": 115.625, "d": 0.265}, {"w": "nào,", "t": 115.89, "d": 0.15}, {"w": "thì", "t": 116.04, "d": 0.27}, {"w": "vệ", "t": 116.31, "d": 0.19}, {"w": "tinh", "t": 116.5, "d": 0.13}, {"w": "đã", "t": 116.63, "d": 0.115}, {"w": "nhìn", "t": 116.745, "d": 0.175}, {"w": "thấy", "t": 116.92, "d": 0.235}, {"w": "cái", "t": 117.155, "d": 0.19}, {"w": "gì?", "t": 117.345, "d": 0.27}]}], "imgs": {"serp": {"src": "assets/long/mim-ke-huy-diet-petrov/img/serp.jpg", "w": 500, "h": 261, "lic": "Public domain", "by": "Imagery from LANCE FIRMS operated by NASA's Earth Science Data and Information System (ESDIS) with funding provided by N", "pd": true}, "mm3": {"src": "assets/long/mim-ke-huy-diet-petrov/img/mm3.jpg", "w": 1920, "h": 1281, "lic": "Public domain", "by": "U.S. Space Force photo by [null Courtesy]", "pd": true}, "mmsilo": {"src": "assets/long/mim-ke-huy-diet-petrov/img/mmsilo.jpg", "w": 1920, "h": 1327, "lic": "Public domain", "by": "", "pd": true}, "norad84": {"src": "assets/long/mim-ke-huy-diet-petrov/img/norad84.jpg", "w": 1615, "h": 2400, "lic": "Public domain", "by": "Staff Sgt. Bob Simons", "pd": true}, "cheyenne68": {"src": "assets/long/mim-ke-huy-diet-petrov/img/cheyenne68.jpg", "w": 1903, "h": 2400, "lic": "Public domain", "by": "", "pd": true}, "molniya": {"src": "assets/long/mim-ke-huy-diet-petrov/img/molniya.jpg", "w": 330, "h": 330, "lic": "Public domain", "by": "NASA", "pd": true}, "dsp": {"src": "assets/long/mim-ke-huy-diet-petrov/img/dsp.jpg", "w": 500, "h": 550, "lic": "Public domain", "by": "USAF", "pd": true}, "brown": {"src": "assets/long/mim-ke-huy-diet-petrov/img/brown.jpg", "w": 1886, "h": 2400, "lic": "Public domain", "by": "", "pd": true}, "reagan": {"src": "assets/long/mim-ke-huy-diet-petrov/img/reagan.jpg", "w": 1280, "h": 1574, "lic": "Public domain", "by": "Series: Reagan White House Photographs, 1/20/1981 - 1/20/1989\n\nCollection: White House Photographic Collection, 1/20/198", "pd": true}, "e4b": {"src": "assets/long/mim-ke-huy-diet-petrov/img/e4b.jpg", "w": 1280, "h": 677, "lic": "Public domain", "by": "", "pd": true}, "namerica": {"src": "assets/long/mim-ke-huy-diet-petrov/img/namerica.jpg", "w": 1920, "h": 1920, "lic": "Public domain", "by": "NASA/NOAA/GSFC/Suomi NPP/VIIRS/Norman Kuring", "pd": true}, "glint": {"src": "assets/long/mim-ke-huy-diet-petrov/img/glint.jpg", "w": 1920, "h": 1275, "lic": "Public domain", "by": "NASA", "pd": true}, "clouds": {"src": "assets/long/mim-ke-huy-diet-petrov/img/clouds.jpg", "w": 1920, "h": 1278, "lic": "Public domain", "by": "NASA", "pd": true}, "memorial": {"src": "assets/long/mim-ke-huy-diet-petrov/img/memorial.jpg", "w": 1800, "h": 2400, "lic": "Public domain", "by": "User:Brandmeister (Togrul Safarov)", "pd": true}, "warsaw": {"src": "assets/long/mim-ke-huy-diet-petrov/img/warsaw.jpg", "w": 1920, "h": 1440, "lic": "CC0", "by": "Cybularny", "pd": true}}, "geo": {}, "scenes": [{"type": "chapter", "no": "8", "k": "CHƯƠNG TÁM", "title": "CUỘC GỌI", "sub": "SERPUKHOV-15 · RẠNG SÁNG 26.09.1983", "vid": "v0", "illus": "VIDEO MINH HỌA", "titleAt": 0.085, "t0": 0.0, "t1": 5.6}, {"type": "quote", "text": "All I had to do was to reach for the phone… but I couldn’t move. I felt like I was sitting on a hot frying pan.", "by": "STANISLAV PETROV · BBC NEWS · 2013", "lbl": "TRÍCH DỊCH", "qline": 1, "t0": 5.6, "t1": 10.6, "at": 5.665, "typeDur": 3.701, "voiceAt": 5.6, "voiceEnd": 9.6, "radio": true}, {"type": "kinetic", "items": [{"text": "RẤT ÍT THỜI GIAN", "at": 11.0, "acc": true, "fx": "marker", "L": {"style": {"top": "446px", "fontSize": "112px"}}, "D": [{"kind": "frame", "style": {"top": "370px", "height": "278px", "width": "1271px", "left": "324px"}, "at": 10.7}], "em": "THỜI"}], "t0": 10.6, "t1": 14.2, "lay": "frame"}, {"type": "quote", "text": "За те две-три минуты толком ничего не проанализируешь. Остаётся интуиция.", "by": "S. PETROV · MOSKOVSKIYE NOVOSTI · 2004", "lbl": "TRÍCH DỊCH", "qline": 3, "t0": 14.2, "t1": 19.36, "at": 14.29, "typeDur": 2.555, "voiceAt": 14.2, "voiceEnd": 18.36, "radio": true}, {"type": "broll", "vid": "v4", "veil": 0.5, "illus": "VIDEO MINH HỌA", "kin": [{"text": "ÔNG NHẤC MÁY", "at": 19.73, "acc": true, "fx": "outline", "em": "NHẤC"}, {"text": "gọi sĩ quan trực · sở chỉ huy quân đội Liên Xô", "at": 20.8, "sm": true, "fx": "rise"}], "t0": 19.36, "t1": 23.76}, {"type": "slam", "text": "HỆ THỐNG TRỤC TRẶC", "sub": "KHÔNG PHẢI: “BỊ TẤN CÔNG” · BBC 2013", "t0": 23.76, "t1": 32.04, "at": 23.91, "fx": "punch"}, {"type": "quote", "text": "I knew perfectly well that nobody would be able to correct my mistake if I had made one.", "by": "STANISLAV PETROV · BBC NEWS · 2013", "lbl": "TRÍCH DỊCH", "qline": 9, "t0": 32.04, "t1": 36.6, "at": 32.095, "typeDur": 3.08, "voiceAt": 32.04, "voiceEnd": 36.28, "radio": true}, {"type": "question", "text": "Vậy câu trả lời\ncho hai cái nút?", "t0": 36.6, "t1": 39.12}, {"type": "slam", "text": "BÁO LÊN: MÁY SAI", "sub": "ÔNG BÁO ĐIỀU NGƯỢC LẠI VỚI CỖ MÁY", "t0": 39.12, "t1": 42.76, "at": 39.27, "fx": "outline"}, {"type": "ledger", "title": "HAI BÀN TAY", "srcnote": "MOSKOVSKIYE NOVOSTI 2004", "rows": [{"k": "MỘT TAY", "v": "ỐNG NGHE · BÁO CÁO CẤP TRÊN", "at": 45.06}, {"k": "TAY KIA", "v": "MICRO · RA LỆNH CHO KÍP TRỰC", "at": 46.76}], "total": {"k": "HÃY NHỚ", "v": "SẼ QUAY LẠI KHI ĐIỀU TRA", "at": 49.8}, "t0": 42.76, "t1": 54.72}, {"type": "kinetic", "items": [{"text": "NẾU ÔNG SAI", "at": 55.93, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "58px", "left": "140px"}}}, {"text": "VÀI PHÚT SAU · NHỮNG VỤ NỔ ĐẦU TIÊN", "at": 55.42, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "346px", "fontSize": "52px", "left": "310px"}}, "em": "NHỮNG"}], "t0": 54.72, "t1": 60.08, "lay": "ladder"}, {"type": "counter", "from": 0, "to": 23, "suffix": " PHÚT", "until": 60.725, "label": "KHÔNG CÓ GÌ ĐẾN CẢ", "sub": {"text": "BBC 2013", "at": 60.08}, "t0": 60.08, "t1": 61.44, "at": 60.28}, {"type": "quote", "text": "Twenty-three minutes later I realised that nothing had happened. If there had been a real strike, then I would already know about it. It was such a relief.", "by": "STANISLAV PETROV · BBC NEWS · 2013", "lbl": "TRÍCH DỊCH", "qline": 17, "typeDur": 3.2, "t0": 61.44, "t1": 69.0, "at": 61.49, "voiceAt": 61.44, "voiceEnd": 68.0, "radio": true}, {"type": "bars", "title": "ÔNG ƯỚC KHẢ NĂNG ĐÊM ẤY", "unit": "% · BBC 2013", "max": 100, "items": [{"k": "BÁO ĐỘNG GIẢ", "v": 50, "lbl": "50", "at": 72.27}, {"k": "TẤN CÔNG THẬT", "v": 50, "lbl": "50", "at": 72.62, "acc": true}], "t0": 69.0, "t1": 77.16}, {"type": "slam", "text": "50 / 50", "sub": "“CHƯA BAO GIỜ CHẮC TUYỆT ĐỐI” · BBC 2013", "t0": 77.16, "t1": 78.96, "at": 77.31, "fx": "slice"}, {"type": "kinetic", "items": [{"text": "NGƯỜI KHÁC TRỰC → CÓ LẼ ĐÃ BÁO LÊN", "at": 79.36, "acc": true, "fx": "flicker", "em": "NGƯỜI"}, {"text": "theo Petrov · BBC 2013", "at": 78.96, "sm": true, "fx": "blur"}], "t0": 78.96, "t1": 83.52, "lay": "stack"}, {"type": "source", "source": "BBC NEWS · 26.09.2013", "ref": "“STANISLAV PETROV: THE MAN WHO MAY HAVE SAVED THE WORLD”", "snippet": "This was a breach of his instructions, a dereliction of duty. [[The safe thing to do would have been to pass the responsibility on]], to refer up.", "hlAt": 89.52, "seal": "TRÍCH NGẮN · TIẾNG ANH", "sealAt": 91.365, "t0": 83.52, "t1": 96.84}, {"type": "quote", "text": "I had all the data. If I had sent my report up the chain of command, nobody would have said a word against it.", "by": "STANISLAV PETROV · BBC NEWS · 2013", "lbl": "TRÍCH DỊCH", "qline": 26, "t0": 96.84, "t1": 102.64, "at": 96.93, "typeDur": 3.85, "voiceAt": 96.84, "voiceEnd": 101.64, "radio": true}, {"type": "kinetic", "items": [{"text": "BẤM “BÁO LÊN” KHÔNG HỀ NGỐC", "at": 103.34, "acc": true, "fx": "marker", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "77px", "left": "140px"}}, "em": "KHÔNG"}, {"text": "đúng điều bản hướng dẫn yêu cầu", "at": 106.16, "sm": true, "fx": "rise", "L": {"cls": "kC", "style": {"top": "371px", "fontSize": "58px", "left": "310px"}}}], "t0": 102.64, "t1": 108.56, "lay": "ladder"}, {"type": "ledger", "title": "GHẾ TRỰC · ĐỦ SÁU MẨU TIN", "srcnote": "CÁC CHƯƠNG 1–7", "rows": [{"k": "1 · MÀN HÌNH", "v": "1 VỤ PHÓNG · TIN CẬY TỐI ĐA", "at": 108.56}, {"k": "2 · CON MẮT", "v": "OKO MỚI · TỪNG HỎNG NHIỀU", "at": 108.56}, {"k": "3 · SỐ LƯỢNG", "v": "5 (BẢN 2004: 4) · 1 CĂN CỨ", "at": 108.56}, {"k": "4 · BỐI CẢNH", "v": "LÃNH ĐẠO TIN MỸ SẮP RA TAY", "at": 108.56}, {"k": "5 · PHÍA MỸ", "v": "TỪNG NHẦM · CẦN MẮT THỨ 2", "at": 108.56}, {"k": "6 · MẮT THỨ 2", "v": "KHÔNG THẤY · VỐN HAY THẾ", "at": 108.56}], "total": {"k": "VÀ MỘT NGƯỜI", "v": "CÂN CHÚNG VỚI CỖ MÁY", "at": 112.405}, "t0": 108.56, "t1": 114.76}, {"type": "photo", "img": "glint", "tone": "color", "move": "in", "veil": 0.55, "illus": "ẢNH MINH HỌA", "kin": [{"text": "VỆ TINH ĐÃ THẤY GÌ?", "at": 116.31, "acc": true, "fx": "outline", "em": "TINH"}], "label": {"k": "ÁNH NẮNG VÀ MÂY NHÌN TỪ ISS", "v": "ẢNH NASA · 2012", "at": 114.76}, "t0": 114.76, "t1": 119.3}], "prog0": 0.64131, "prog1": 0.72957};
motion/hf/assets/long\mim-ai-gpu\ch04\data.js:1:window.CASE = {"topic": "mim-ai-gpu", "ch": "ch04", "dur": 72.14, "seed": 8954, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 04", "t": "MỘT NÚI PHÉP NHÂN"}, "acc": ["gpu", "cpu", "card", "nvidia", "alexnet", "cuda", "phòng", "ngủ"], "lines": [{"text": "Mạng nơ-ron nghe như bộ não, nhưng bên trong nó gần với một bảng tính khổng lồ hơn.", "start": 0.0, "end": 4.08, "words": [{"w": "Mạng", "t": 0.1, "d": 0.145}, {"w": "nơ-ron", "t": 0.245, "d": 0.25}, {"w": "nghe", "t": 0.495, "d": 0.21}, {"w": "như", "t": 0.705, "d": 0.255}, {"w": "bộ", "t": 0.96, "d": 0.095}, {"w": "não,", "t": 1.055, "d": 0.425}, {"w": "nhưng", "t": 1.48, "d": 0.105}, {"w": "bên", "t": 1.585, "d": 0.16}, {"w": "trong", "t": 1.745, "d": 0.26}, {"w": "nó", "t": 2.005, "d": 0.125}, {"w": "gần", "t": 2.13, "d": 0.185}, {"w": "với", "t": 2.315, "d": 0.19}, {"w": "một", "t": 2.505, "d": 0.255}, {"w": "bảng", "t": 2.76, "d": 0.295}, {"w": "tính", "t": 3.055, "d": 0.195}, {"w": "khổng", "t": 3.25, "d": 0.06}, {"w": "lồ", "t": 3.31, "d": 0.19}, {"w": "hơn.", "t": 3.5, "d": 0.38}]}, {"text": "Mỗi kết nối là một con số, gọi là trọng số.", "start": 4.88, "end": 7.28, "words": [{"w": "Mỗi", "t": 4.985, "d": 0.18}, {"w": "kết", "t": 5.165, "d": 0.09}, {"w": "nối", "t": 5.255, "d": 0.25}, {"w": "là", "t": 5.505, "d": 0.2}, {"w": "một", "t": 5.705, "d": 0.185}, {"w": "con", "t": 5.89, "d": 0.065}, {"w": "số,", "t": 5.955, "d": 0.235}, {"w": "gọi", "t": 6.19, "d": 0.16}, {"w": "là", "t": 6.35, "d": 0.195}, {"w": "trọng", "t": 6.545, "d": 0.145}, {"w": "số.", "t": 6.69, "d": 0.345}]}, {"text": "Ảnh đi vào, được nhân với hàng triệu trọng số, cộng lại, rồi chuyển sang lớp tiếp theo.", "start": 7.6, "end": 11.84, "words": [{"w": "Ảnh", "t": 7.655, "d": 0.265}, {"w": "đi", "t": 7.92, "d": 0.205}, {"w": "vào,", "t": 8.125, "d": 0.285}, {"w": "được", "t": 8.41, "d": 0.19}, {"w": "nhân", "t": 8.6, "d": 0.23}, {"w": "với", "t": 8.83, "d": 0.13}, {"w": "hàng", "t": 8.96, "d": 0.155}, {"w": "triệu", "t": 9.115, "d": 0.17}, {"w": "trọng", "t": 9.285, "d": 0.155}, {"w": "số,", "t": 9.44, "d": 0.355}, {"w": "cộng", "t": 9.795, "d": 0.155}, {"w": "lại,", "t": 9.95, "d": 0.45}, {"w": "rồi", "t": 10.4, "d": 0.225}, {"w": "chuyển", "t": 10.625, "d": 0.195}, {"w": "sang", "t": 10.82, "d": 0.06}, {"w": "lớp", "t": 10.88, "d": 0.335}, {"w": "tiếp", "t": 11.215, "d": 0.155}, {"w": "theo.", "t": 11.37, "d": 0.27}]}, {"text": "Dạy một mạng nơ-ron nghĩa là làm việc ấy hàng triệu lần.", "start": 12.84, "end": 15.56, "words": [{"w": "Dạy", "t": 12.925, "d": 0.25}, {"w": "một", "t": 13.175, "d": 0.155}, {"w": "mạng", "t": 13.33, "d": 0.235}, {"w": "nơ-ron", "t": 13.565, "d": 0.21}, {"w": "nghĩa", "t": 13.775, "d": 0.145}, {"w": "là", "t": 13.92, "d": 0.175}, {"w": "làm", "t": 14.095, "d": 0.17}, {"w": "việc", "t": 14.265, "d": 0.135}, {"w": "ấy", "t": 14.4, "d": 0.335}, {"w": "hàng", "t": 14.735, "d": 0.06}, {"w": "triệu", "t": 14.795, "d": 0.18}, {"w": "lần.", "t": 14.975, "d": 0.375}]}, {"text": "Mỗi lần đoán sai, chỉnh từng trọng số một chút, rồi đoán lại.", "start": 15.88, "end": 19.0, "words": [{"w": "Mỗi", "t": 15.97, "d": 0.26}, {"w": "lần", "t": 16.23, "d": 0.195}, {"w": "đoán", "t": 16.425, "d": 0.08}, {"w": "sai,", "t": 16.505, "d": 0.255}, {"w": "chỉnh", "t": 16.76, "d": 0.205}, {"w": "từng", "t": 16.965, "d": 0.16}, {"w": "trọng", "t": 17.125, "d": 0.245}, {"w": "số", "t": 17.37, "d": 0.3}, {"w": "một", "t": 17.67, "d": 0.185}, {"w": "chút,", "t": 17.855, "d": 0.26}, {"w": "rồi", "t": 18.115, "d": 0.07}, {"w": "đoán", "t": 18.185, "d": 0.245}, {"w": "lại.", "t": 18.43, "d": 0.33}]}, {"text": "Ví dụ, máy nhìn một con mèo và đoán là con cáo.", "start": 19.32, "end": 21.96, "words": [{"w": "Ví", "t": 19.43, "d": 0.14}, {"w": "dụ,", "t": 19.57, "d": 0.345}, {"w": "máy", "t": 19.915, "d": 0.065}, {"w": "nhìn", "t": 19.98, "d": 0.325}, {"w": "một", "t": 20.305, "d": 0.105}, {"w": "con", "t": 20.41, "d": 0.1}, {"w": "mèo", "t": 20.51, "d": 0.325}, {"w": "và", "t": 20.835, "d": 0.11}, {"w": "đoán", "t": 20.945, "d": 0.24}, {"w": "là", "t": 21.185, "d": 0.105}, {"w": "con", "t": 21.29, "d": 0.185}, {"w": "cáo.", "t": 21.475, "d": 0.275}]}, {"text": "Nó lần ngược lại xem trọng số nào đã đẩy nó về phía cáo, rồi vặn mỗi trọng số đi một chút.", "start": 22.28, "end": 27.08, "words": [{"w": "Nó", "t": 22.365, "d": 0.205}, {"w": "lần", "t": 22.57, "d": 0.2}, {"w": "ngược", "t": 22.77, "d": 0.26}, {"w": "lại", "t": 23.03, "d": 0.195}, {"w": "xem", "t": 23.225, "d": 0.195}, {"w": "trọng", "t": 23.42, "d": 0.06}, {"w": "số", "t": 23.48, "d": 0.155}, {"w": "nào", "t": 23.635, "d": 0.245}, {"w": "đã", "t": 23.88, "d": 0.155}, {"w": "đẩy", "t": 24.035, "d": 0.345}, {"w": "nó", "t": 24.38, "d": 0.14}, {"w": "về", "t": 24.52, "d": 0.175}, {"w": "phía", "t": 24.695, "d": 0.28}, {"w": "cáo,", "t": 24.975, "d": 0.31}, {"w": "rồi", "t": 25.285, "d": 0.06}, {"w": "vặn", "t": 25.345, "d": 0.265}, {"w": "mỗi", "t": 25.61, "d": 0.14}, {"w": "trọng", "t": 25.75, "d": 0.265}, {"w": "số", "t": 26.015, "d": 0.115}, {"w": "đi", "t": 26.13, "d": 0.265}, {"w": "một", "t": 26.395, "d": 0.255}, {"w": "chút.", "t": 26.65, "d": 0.23}]}, {"text": "Một bức ảnh chưa đủ. Phải làm vậy với hơn một triệu bức ảnh, cả bộ ảnh được lặp lại khoảng chín mươi lượt.", "start": 27.4, "end": 32.2, "words": [{"w": "Một", "t": 27.5, "d": 0.13}, {"w": "bức", "t": 27.63, "d": 0.29}, {"w": "ảnh", "t": 27.92, "d": 0.055}, {"w": "chưa", "t": 27.975, "d": 0.295}, {"w": "đủ.", "t": 28.27, "d": 0.28}, {"w": "Phải", "t": 28.55, "d": 0.055}, {"w": "làm", "t": 28.605, "d": 0.29}, {"w": "vậy", "t": 28.895, "d": 0.075}, {"w": "với", "t": 28.97, "d": 0.225}, {"w": "hơn", "t": 29.195, "d": 0.11}, {"w": "một", "t": 29.305, "d": 0.29}, {"w": "triệu", "t": 29.595, "d": 0.055}, {"w": "bức", "t": 29.65, "d": 0.16}, {"w": "ảnh,", "t": 29.81, "d": 0.41}, {"w": "cả", "t": 30.22, "d": 0.165}, {"w": "bộ", "t": 30.385, "d": 0.055}, {"w": "ảnh", "t": 30.44, "d": 0.305}, {"w": "được", "t": 30.745, "d": 0.175}, {"w": "lặp", "t": 30.92, "d": 0.17}, {"w": "lại", "t": 31.09, "d": 0.18}, {"w": "khoảng", "t": 31.27, "d": 0.055}, {"w": "chín", "t": 31.325, "d": 0.22}, {"w": "mươi", "t": 31.545, "d": 0.095}, {"w": "lượt.", "t": 31.64, "d": 0.36}]}, {"text": "Mạng của Alex có sáu mươi triệu trọng số.", "start": 32.52, "end": 35.08, "words": [{"w": "Mạng", "t": 32.595, "d": 0.27}, {"w": "của", "t": 32.865, "d": 0.125}, {"w": "Alex", "t": 32.99, "d": 0.355}, {"w": "có", "t": 33.345, "d": 0.26}, {"w": "sáu", "t": 33.605, "d": 0.205}, {"w": "mươi", "t": 33.81, "d": 0.085}, {"w": "triệu", "t": 33.895, "d": 0.355}, {"w": "trọng", "t": 34.25, "d": 0.16}, {"w": "số.", "t": 34.41, "d": 0.435}]}, {"text": "Mỗi bức ảnh đi qua mạng là hàng trăm triệu phép nhân.", "start": 35.4, "end": 37.88, "words": [{"w": "Mỗi", "t": 35.505, "d": 0.235}, {"w": "bức", "t": 35.74, "d": 0.18}, {"w": "ảnh", "t": 35.92, "d": 0.165}, {"w": "đi", "t": 36.085, "d": 0.105}, {"w": "qua", "t": 36.19, "d": 0.225}, {"w": "mạng", "t": 36.415, "d": 0.06}, {"w": "là", "t": 36.475, "d": 0.245}, {"w": "hàng", "t": 36.72, "d": 0.16}, {"w": "trăm", "t": 36.88, "d": 0.215}, {"w": "triệu", "t": 37.095, "d": 0.215}, {"w": "phép", "t": 37.31, "d": 0.095}, {"w": "nhân.", "t": 37.405, "d": 0.285}]}, {"text": "Nghe có quen không? Hàng triệu phép tính nhỏ, giống hệt nhau, không cần chờ nhau.", "start": 38.88, "end": 42.96, "words": [{"w": "Nghe", "t": 38.985, "d": 0.255}, {"w": "có", "t": 39.24, "d": 0.115}, {"w": "quen", "t": 39.355, "d": 0.215}, {"w": "không?", "t": 39.57, "d": 0.45}, {"w": "Hàng", "t": 40.02, "d": 0.17}, {"w": "triệu", "t": 40.19, "d": 0.065}, {"w": "phép", "t": 40.255, "d": 0.355}, {"w": "tính", "t": 40.61, "d": 0.195}, {"w": "nhỏ,", "t": 40.805, "d": 0.37}, {"w": "giống", "t": 41.175, "d": 0.09}, {"w": "hệt", "t": 41.265, "d": 0.28}, {"w": "nhau,", "t": 41.545, "d": 0.355}, {"w": "không", "t": 41.9, "d": 0.225}, {"w": "cần", "t": 42.125, "d": 0.06}, {"w": "chờ", "t": 42.185, "d": 0.205}, {"w": "nhau.", "t": 42.39, "d": 0.395}]}, {"text": "Đúng là một núi hành, chờ hàng nghìn phụ bếp.", "start": 43.28, "end": 45.44, "words": [{"w": "Đúng", "t": 43.36, "d": 0.21}, {"w": "là", "t": 43.57, "d": 0.115}, {"w": "một", "t": 43.685, "d": 0.125}, {"w": "núi", "t": 43.81, "d": 0.285}, {"w": "hành,", "t": 44.095, "d": 0.27}, {"w": "chờ", "t": 44.365, "d": 0.06}, {"w": "hàng", "t": 44.425, "d": 0.22}, {"w": "nghìn", "t": 44.645, "d": 0.1}, {"w": "phụ", "t": 44.745, "d": 0.235}, {"w": "bếp.", "t": 44.98, "d": 0.255}]}, {"text": "Năm 2009, ở Đại học Stanford, nhóm của Andrew Ng thử dạy mạng nơ-ron trên card đồ hoạ.", "start": 45.76, "end": 51.76, "words": [{"w": "Năm", "t": 45.815, "d": 0.145}, {"w": "2009,", "t": 45.96, "d": 1.68}, {"w": "ở", "t": 47.64, "d": 0.16}, {"w": "Đại", "t": 47.8, "d": 0.18}, {"w": "học", "t": 47.98, "d": 0.4}, {"w": "Stanford,", "t": 48.38, "d": 0.18}, {"w": "nhóm", "t": 48.56, "d": 0.335}, {"w": "của", "t": 48.895, "d": 0.3}, {"w": "Andrew", "t": 49.195, "d": 0.19}, {"w": "Ng", "t": 49.385, "d": 0.23}, {"w": "thử", "t": 49.615, "d": 0.16}, {"w": "dạy", "t": 49.775, "d": 0.38}, {"w": "mạng", "t": 50.155, "d": 0.205}, {"w": "nơ-ron", "t": 50.36, "d": 0.06}, {"w": "trên", "t": 50.42, "d": 0.38}, {"w": "card", "t": 50.8, "d": 0.205}, {"w": "đồ", "t": 51.005, "d": 0.18}, {"w": "hoạ.", "t": 51.185, "d": 0.41}]}, {"text": "Trong bài toán họ chọn, máy chạy nhanh hơn tới năm mươi lăm lần so với một bộ xử lý hai lõi thời ấy.", "start": 52.08, "end": 56.8, "words": [{"w": "Trong", "t": 52.16, "d": 0.22}, {"w": "bài", "t": 52.38, "d": 0.15}, {"w": "toán", "t": 52.53, "d": 0.2}, {"w": "họ", "t": 52.73, "d": 0.21}, {"w": "chọn,", "t": 52.94, "d": 0.235}, {"w": "máy", "t": 53.175, "d": 0.225}, {"w": "chạy", "t": 53.4, "d": 0.12}, {"w": "nhanh", "t": 53.52, "d": 0.08}, {"w": "hơn", "t": 53.6, "d": 