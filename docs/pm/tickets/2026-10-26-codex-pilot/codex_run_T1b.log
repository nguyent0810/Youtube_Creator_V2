motion/hf/assets/long\mim-ai-gpu\ch06\data.js:1:window.CASE = {"topic": "mim-ai-gpu", "ch": "ch06", "dur": 104.7, "seed": 8982, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 06", "t": "TỪ PHÒNG NGỦ ĐẾN SIÊU MÁY TÍNH"}, "acc": ["gpu", "cpu", "card", "nvidia", "alexnet", "cuda", "phòng", "ngủ"], "lines": [{"text": "Tháng 12 năm 2012, ở một khách sạn sòng bạc bên hồ Tahoe, nước Mỹ, có một cuộc đấu giá kín.", "start": 0.0, "end": 5.92, "words": [{"w": "Tháng", "t": 0.12, "d": 0.27}, {"w": "12", "t": 0.39, "d": 0.23}, {"w": "năm", "t": 0.62, "d": 0.345}, {"w": "2012,", "t": 0.965, "d": 1.26}, {"w": "ở", "t": 2.225, "d": 0.135}, {"w": "một", "t": 2.36, "d": 0.205}, {"w": "khách", "t": 2.565, "d": 0.125}, {"w": "sạn", "t": 2.69, "d": 0.185}, {"w": "sòng", "t": 2.875, "d": 0.205}, {"w": "bạc", "t": 3.08, "d": 0.15}, {"w": "bên", "t": 3.23, "d": 0.23}, {"w": "hồ", "t": 3.46, "d": 0.155}, {"w": "Tahoe,", "t": 3.615, "d": 0.445}, {"w": "nước", "t": 4.06, "d": 0.19}, {"w": "Mỹ,", "t": 4.25, "d": 0.305}, {"w": "có", "t": 4.555, "d": 0.095}, {"w": "một", "t": 4.65, "d": 0.275}, {"w": "cuộc", "t": 4.925, "d": 0.14}, {"w": "đấu", "t": 5.065, "d": 0.23}, {"w": "giá", "t": 5.295, "d": 0.165}, {"w": "kín.", "t": 5.46, "d": 0.28}]}, {"text": "Theo lời kể của nhà báo Cade Metz, món hàng là một công ty vừa lập vội, chưa có sản phẩm nào, chỉ có ba người: Hinton, Alex và Ilya.", "start": 6.72, "end": 15.12, "words": [{"w": "Theo", "t": 6.825, "d": 0.305}, {"w": "lời", "t": 7.13, "d": 0.23}, {"w": "kể", "t": 7.36, "d": 0.265}, {"w": "của", "t": 7.625, "d": 0.19}, {"w": "nhà", "t": 7.815, "d": 0.135}, {"w": "báo", "t": 7.95, "d": 0.415}, {"w": "Cade", "t": 8.365, "d": 0.15}, {"w": "Metz,", "t": 8.515, "d": 0.42}, {"w": "món", "t": 8.935, "d": 0.295}, {"w": "hàng", "t": 9.23, "d": 0.225}, {"w": "là", "t": 9.455, "d": 0.2}, {"w": "một", "t": 9.655, "d": 0.295}, {"w": "công", "t": 9.95, "d": 0.24}, {"w": "ty", "t": 10.19, "d": 0.24}, {"w": "vừa", "t": 10.43, "d": 0.06}, {"w": "lập", "t": 10.49, "d": 0.245}, {"w": "vội,", "t": 10.735, "d": 0.41}, {"w": "chưa", "t": 11.145, "d": 0.39}, {"w": "có", "t": 11.535, "d": 0.16}, {"w": "sản", "t": 11.695, "d": 0.22}, {"w": "phẩm", "t": 11.915, "d": 0.13}, {"w": "nào,", "t": 12.045, "d": 0.595}, {"w": "chỉ", "t": 12.64, "d": 0.155}, {"w": "có", "t": 12.795, "d": 0.225}, {"w": "ba", "t": 13.02, "d": 0.34}, {"w": "người:", "t": 13.36, "d": 0.2}, {"w": "Hinton,", "t": 13.56, "d": 0.385}, {"w": "Alex", "t": 13.945, "d": 0.34}, {"w": "và", "t": 14.285, "d": 0.19}, {"w": "Ilya.", "t": 14.475, "d": 0.415}]}, {"text": "Bốn công ty trả giá từ xa, qua thư điện tử, mỗi lần tăng ít nhất một triệu đô.", "start": 15.44, "end": 19.6, "words": [{"w": "Bốn", "t": 15.515, "d": 0.18}, {"w": "công", "t": 15.695, "d": 0.15}, {"w": "ty", "t": 15.845, "d": 0.16}, {"w": "trả", "t": 16.005, "d": 0.195}, {"w": "giá", "t": 16.2, "d": 0.185}, {"w": "từ", "t": 16.385, "d": 0.215}, {"w": "xa,", "t": 16.6, "d": 0.405}, {"w": "qua", "t": 17.005, "d": 0.075}, {"w": "thư", "t": 17.08, "d": 0.21}, {"w": "điện", "t": 17.29, "d": 0.225}, {"w": "tử,", "t": 17.515, "d": 0.345}, {"w": "mỗi", "t": 17.86, "d": 0.055}, {"w": "lần", "t": 17.915, "d": 0.315}, {"w": "tăng", "t": 18.23, "d": 0.065}, {"w": "ít", "t": 18.295, "d": 0.16}, {"w": "nhất", "t": 18.455, "d": 0.33}, {"w": "một", "t": 18.785, "d": 0.185}, {"w": "triệu", "t": 18.97, "d": 0.145}, {"w": "đô.", "t": 19.115, "d": 0.265}]}, {"text": "Khi giá lên tới bốn mươi tư triệu đô, Hinton dừng cuộc đấu giá, và chọn về với Google.", "start": 19.92, "end": 24.16, "words": [{"w": "Khi", "t": 20.015, "d": 0.11}, {"w": "giá", "t": 20.125, "d": 0.285}, {"w": "lên", "t": 20.41, "d": 0.115}, {"w": "tới", "t": 20.525, "d": 0.25}, {"w": "bốn", "t": 20.775, "d": 0.17}, {"w": "mươi", "t": 20.945, "d": 0.15}, {"w": "tư", "t": 21.095, "d": 0.335}, {"w": "triệu