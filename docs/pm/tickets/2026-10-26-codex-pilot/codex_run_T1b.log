 "d": 0.14}, {"w": "bạn", "t": 32.78, "d": 0.185}, {"w": "thì", "t": 32.965, "d": 0.105}, {"w": "sao?", "t": 33.07, "d": 0.27}]}, {"text": "Nếu thứ bạn làm ra mang về năm mươi nghìn đô mỗi ngày, bạn có gỡ nó xuống không?", "start": 34.12, "end": 37.8, "words": [{"w": "Nếu", "t": 34.135, "d": 0.115}, {"w": "thứ", "t": 34.25, "d": 0.285}, {"w": "bạn", "t": 34.535, "d": 0.165}, {"w": "làm", "t": 34.7, "d": 0.07}, {"w": "ra", "t": 34.77, "d": 0.175}, {"w": "mang", "t": 34.945, "d": 0.22}, {"w": "về", "t": 35.165, "d": 0.135}, {"w": "năm", "t": 35.3, "d": 0.23}, {"w": "mươi", "t": 35.53, "d": 0.185}, {"w": "nghìn", "t": 35.715, "d": 0.125}, {"w": "đô", "t": 35.84, "d": 0.135}, {"w": "mỗi", "t": 35.975, "d": 0.3}, {"w": "ngày,", "t": 36.275, "d": 0.255}, {"w": "bạn", "t": 36.53, "d": 0.065}, {"w": "có", "t": 36.595, "d": 0.255}, {"w": "gỡ", "t": 36.85, "d": 0.13}, {"w": "nó", "t": 36.98, "d": 0.185}, {"w": "xuống", "t": 37.165, "d": 0.17}, {"w": "không?", "t": 37.335, "d": 0.28}]}, {"text": "Kể cho mình nghe ở phần bình luận nhé.", "start": 38.4, "end": 41.12, "words": [{"w": "Kể", "t": 38.4, "d": 0.225}, {"w": "cho", "t": 38.625, "d": 0.46}, {"w": "mình", "t": 39.085, "d": 0.065}, {"w": "nghe", "t": 39.15, "d": 0.435}, {"w": "ở", "t": 39.585, "d": 0.35}, {"w": "phần", "t": 39.935, "d": 0.13}, {"w": "bình", "t": 40.065, "d": 0.185}, {"w": "luận", "t": 40.25, "d": 0.285}, {"w": "nhé.", "t": 40.535, "d": 0.58}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "bars", "title": "PHÉP ĐO QUEN THUỘC CỦA NGÀNH", "unit": "", "items": [{"k": "NGƯỜI DÙNG Ở LẠI ÍT", "v": 20, "lbl": "“KÉM”", "at": 0.0}, {"k": "NGƯỜI DÙNG Ở LẠI LÂU", "v": 90, "lbl": "“THÀNH CÔNG”", "at": 2.72, "acc": true}], "label": {"k": "", "v": "SƠ ĐỒ MINH HOẠ", "at": 0.0}, "t0": 0.0, "t1": 6.36}, {"type": "kinetic", "items": [{"text": "CÓ NGƯỜI NHÌN CON SỐ ẤY", "at": 7.06, "fx": "flicker", "L": {"style": {"top": "239px", "fontSize": "60px"}}, "D": [{"kind": "rule", "style": {"top": "599px"}, "at": 10.125}]}, {"text"