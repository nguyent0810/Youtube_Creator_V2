          {"type":"slam","at":max(2,len(d["lines"])//2),"text":"MỘT KHÓA BỊ THIẾU","sub":"CON NGƯỜI · MÁY · QUY TRÌNH"}]
  if n in ("ch00","ch07"):
   scenes.insert(1,{"type":"print","at":1,"img":"turing16","tone":"bw","side":{"k":"NHÀ TOÁN HỌC ANH","h":"Alan\nTuring","lines":[{"text":"ảnh năm mười sáu tuổi · phạm vi công cộng","at":1}]}})
  d.update({"hud":{"k":"MẬT MÃ THỜI CHIẾN","t":title.upper()},"bgm":{"mood":"mystery","gain":0.10},"scenes":scenes})
  p.write_text(json.dumps(d,ensure_ascii=False,indent=1),encoding="utf-8")
 print("spec + 8 chương")
