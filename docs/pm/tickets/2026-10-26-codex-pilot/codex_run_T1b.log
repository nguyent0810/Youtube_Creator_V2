e", "bg": "glint", "items": [{"year": "1982", "text": "Oko *trực chiến* · nhìn xiên", "at": 73.24}, {"year": "1983", "text": "*báo động giả*", "at": 77.33}, {"year": "02.1991", "text": "vệ tinh *thế hệ hai* · nhìn được trên nền mặt đất", "at": 79.56}], "t0": 73.24, "t1": 83.08}, {"type": "kinetic", "items": [{"text": "CÒN NGƯỜI NGỒI GHẾ?", "at": 83.08, "acc": true, "fx": "flicker", "em": "NGƯỜI"}], "t0": 83.08, "t1": 84.88, "lay": "stack"}, {"type": "ledger", "title": "CUỘC ĐIỀU TRA", "srcnote": "MOSKOVSKIYE NOVOSTI 2004", "rows": [{"k": "TƯỚNG Y. VOTINTSEV", "v": "ĐÍCH THÂN TỚI", "at": 88.625}, {"k": "LÚC ĐẦU", "v": "HỨA ĐỀ NGHỊ KHEN THƯỞNG", "at": 91.63}, {"k": "RỒI HỎI", "v": "SAO NHẬT KÝ TRỰC ĐỂ TRỐNG?", "at": 93.44}, {"k": "PETROV ĐÁP", "v": "1 TAY ỐNG NGHE · 1 TAY MICRO", "at": 97.32}], "t0": 84.88, "t1": 102.32}, {"type": "slam", "text": "KHIỂN TRÁCH", "sub": "VÌ CUỐN NHẬT KÝ · KHÔNG KHEN THƯỞNG · BBC 2013 + BẢN 2004", "t0": 102.32, "t1": 108.72, "at": 102.47, "fx": "outline"}, {"type": "quote", "text": "Если награждать меня за тот случай, то кто-то за него же должен был очень крупно пострадать.", "by": "S. PETROV · MOSKOVSKIYE NOVOSTI · 2004", "lbl": "TRÍCH DỊCH", "qline": 28, "t0": 108.72, "t1": 115.96, "at": 108.845, "typeDur": 3.22, "voiceAt": 108.72, "voiceEnd": 114.96, "radio": true}, {"type": "kinetic", "items": [{"text": "IM LẶNG MƯỜI NĂM", "at": 116.12, "acc": true, "fx": "outline", "L": {"cls": "kC", "style": {"top": "598px", "fontSize": "117px"}}, "D": [{"kind": "bar", "style": {"top": "598px", "height": "262px"}, "at": 115.87}], "em": "LẶNG"}, {"text": "“xấu hổ cho quân đội Liên Xô” · BBC", "at": 117.64, "sm": true, "fx": "blur", "L": {"cls": "kC", "style": {"top": "750px", "fontSize": "50px"}}}, {"text": "tự xin rời quân ngũ · bản 2004", "at": 122.92, "sm": true, "fx": "rise", "L": {"cls": "kC", "style": {"top": "815px", "fontSize": "50px"}}}], "t0": 115.96, "t1": 127.64, "lay": "corner"}, {"type": "broll", "vid": "v15", "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "THÁNG 11 NĂM 1983", "at": 127.64, "acc": true, "fx": "glitch", "em": "11"}, {"text": "lại có người ở giữa vòng lặp", "at": 131.72, "sm": true, "fx": "flicker"}], "t0": 127.64, "t1": 135.42}], "prog0": 0.72957, "prog1": 0.82975};
motion/hf/assets/long\mim-apollo-1202\ch04\data.js:1:window.CASE = {"topic": "mim-apollo-1202", "ch": "ch04", "dur": 109.14, "seed": 14072, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 04", "t": "THỦ PHẠM LÀ MỘT CÁI RADAR ĐANG KHÔNG CÓ VIỆC"}, "acc": ["1202", "1201", "radar", "phòng", "báo", "máy", "người", "tiếp"], "lines": [{"text": "Con radar này sinh ra để giúp tàu hẹn gặp lại tàu mẹ.", "start": 0.0, "end": 2.72, "words": [{"w": "Con", "t": 0.0, "d": 0.12}, {"w": "radar", "t": 0.12, "d": 0.26}, {"w": "này", "t": 0.38, "d": 0.235}, {"w": "sinh", "t": 0.615, "d": 0.14}, {"w": "ra", "t": 0.755, "d": 0.2}, {"w": "để", "t": 0.955, "d": 0.17}, {"w": "giúp", "t": 1.125, "d": 0.17}, {"w": "tàu", "t": 1.295, "d": 0.27}, {"w": "hẹn", "t": 1.565, "d": 0.17}, {"w": "gặp", "t": 1.735, "d": 0.2}, {"w": "lại", "t": 1.935, "d": 0.06}, {"w": "tàu", "t": 1.995, "d": 0.205}, {"w": "mẹ.", "t": 2.2, "d": 0.33}]}, {"text": "Lúc hạ cánh, tín hiệu của nó hoàn toàn vô nghĩa.", "start": 3.52, "end": 6.08, "words": [{"w": "Lúc", "t": 3.52, "d": 0.105}, {"w": "hạ", "t": 3.625, "d": 0.205}, {"w": "cánh,", "t": 3.83, "d": 0.475}, {"w": "tín", "t": 4.305, "d": 0.1}, {"w": "hiệu", "t": 4.405, "d": 0.225}, {"w": "của", "t": 4.63, "d": 0.17}, {"w": "nó", "t": 4.8, "d": 0.29}, {"w": "hoàn", "t": 5.09, "d": 0.195}, {"w": "toàn", "t": 5.285, "d": 0.195}, {"w": "vô", "t": 5.48, "d": 0.195}, {"w": "nghĩa.", "t": 5.675, "d": 0.235}]}, {"text": "Vậy mà nó vẫn làm máy tính chạy hụt hơi.", "start": 6.4, "end": 9.04, "words": [{"w": "Vậy", "t": 6.455, "d": 0.12}, {"w": "mà", "t": 6.575, "d": 0.27}, {"w": "nó", "t": 6.845, "d": 0.095}, {"w": "vẫn", "t": 6.94, "d": 0.225}, {"w": "làm", "t": 7.165, "d": 0.075}, {"w": "máy", "t": 7.24, "d": 0.18}, {"w": "tính", "t": 7.42, "d": 0.215}, {"w": "chạy", "t": 7.635, "d": 0.16}, {"w": "hụt", "t": 7.795, "d": 0.17}, {"w": "hơi.", "t": 7.965, "d": 0.2}]}, {"text": "Thủ phạm là một sai lệch rất nhỏ về điện.", "start": 10.04, "end": 12.84, "words": [{"w": "Thủ", "t": 10.04, "d": 0.145}, {"w": "phạm", "t": 10.185, "d": 0.265}, {"w": "là", "t": 10.45, "d": 0.375}, {"w": "một", "t": 10.825, "d": 0.295}, {"w": "sai", "t": 11.12, "d": 0.16}, {"w": "lệch", "t": 11.28, "d": 0.345}, {"w": "rất", "t": 11.625, "d": 0.37}, {"w": "nhỏ", "t": 11.995, "d": 0.265}, {"w": "về", "t": 12.26, "d": 0.23}, {"w": "điện.", "t": 12.49, "d": 0.34}]}, {"text": "Hai nguồn điện xoay chiều tám trăm hertz, một ở bộ điều khiển tàu và một ở hệ dẫn đường, cùng tần số nhưng lệch pha.", "start": 13.16, "end": 19.08, "words": [{"w": "Hai", "t": 13.16, "d": 0.29}, {"w": "nguồn", "t": 13.45, "d": 0.085}, {"w": "điện", "t": 13.535, "d": 0.145}, {"w": "xoay", "t": 13.68, "d": 0.26}, {"w": "chiều", "t": 13.94, "d": 0.175}, {"w": "tám", "t": 14.115, "d": 0.36}, {"w": "trăm", "t": 14.475, "d": 0.21}, {"w": "hertz,", "t": 14.685, "d": 0.145}, {"w": "một", "t": 14.83, "d": 0.335}, {"w": "ở", "t": 15.165, "d": 0.15}, {"w": "bộ", "t": 15.315, "d": 0.155}, {"w": "điều", "t": 15.47, "d": 0.25}, {"w": "khiển", "t": 15.72, "d": 0.32}, {"w": "tàu", "t": 16.04, "d": 0.11}, {"w": "và", "t": 16.15, "d": 0.13}, {"w": "một", "t": 16.28, "d": 0.265}, {"w": "ở", "t": 16.545, "d": 0.2}, {"w": "hệ", "t": 16.745, "d": 0.25}, {"w": "dẫn", "t": 16.995, "d": 0.275}, {"w": "đường,", "t": 17.27, "d": 0.275}, {"w": "cùng", "t": 17.545, "d": 0.08}, {"w": "tần", "t": 17.625, "d": 0.29}, {"w": "số", "t": 17.915, "d": 0.19}, {"w": "nhưng", "t": 18.105, "d": 0.24}, {"w": "lệch", "t": 18.345, "d": 0.255}, {"w": "pha.", "t": 18.6, "d": 0.27}]}, {"text": "Bộ đổi tín hiệu của radar nhận ra như thể ăng-ten đang đổi góc không ngừng.", "start": 19.4, "end": 23.24, "words": [{"w": "Bộ", "t": 19.4, "d": 0.24}, {"w": "đổi", "t": 19.64, "d": 0.29}, {"w": "tín", "t": 19.93, "d": 0.06}, {"w": "hiệu", "t": 19.99, "d": 0.275}, {"w": "của", "t": 20.265, "d": 0.245}, {"w": "radar", "t": 20.51, "d": 0.14}, {"w": "nhận", "t": 20.65, "d": 0.36}, {"w": "ra", "t": 21.01, "d": 0.215}, {"w": "như", "t": 21.225, "d": 0.085}, {"w": "thể", "t": 21.31, "d": 0.21}, {"w": "ăng-ten", "t": 21.52, "d": 0.22}, {"w": "đang", "t": 21.74, "d": 0.215}, {"w": "đổi", "t": 21.955, "d": 0.22}, {"w": "góc", "t": 22.175, "d": 0.35}, {"w": "không", "t": 22.525, "d": 0.155}, {"w": "ngừng.", "t": 22.68, "d": 0.315}]}, {"text": "Nó cứ thế gửi xung vào máy tính.", "start": 23.56, "end": 25.32, "words": [{"w": "Nó", "t": 23.56, "d": 0.1}, {"w": "cứ", "t": 23.66, "d": 0.18}, {"w": "thế", "t": 23.84, "d": 0.235}, {"w": "gửi", "t": 24.075, "d": 0.22}, {"w": "xung", "t": 24.295, "d": 0.1}, {"w": "vào", "t": 24.395, "d": 0.195}, {"w": "máy", "t": 24.59, "d": 0.305}, {"w": "tính.", "t": 24.895, "d": 0.23}]}, {"text": "Mỗi xung chiếm đúng một nhịp nhớ của máy: mười một phẩy bảy phần triệu giây.", "start": 26.32, "end": 29.68, "words": [{"w": "Mỗi", "t": 26.32, "d": 0.165}, {"w": "xung", "t": 26.485, "d": 0.225}, {"w": "chiếm", "t": 26.71, "d": 0.19}, {"w": "đúng", "t": 26.9, "d": 0.115}, {"w": "một", "t": 27.015, "d": 0.16}, {"w": "nhịp", "t": 27.175, "d": 0.185}, {"w": "nhớ", "t": 27.36, "d": 0.26}, {"w": "của", "t": 27.62, "d": 0.11}, {"w": "máy:", "t": 27.73, "d": 0.435}, {"w": "mười", "t": 28.165, "d": 0.17}, {"w": "một", "t": 28.335, "d": 0.195}, {"w": "phẩy", "t": 28.53, "d": 0.155}, {"w": "bảy", "t": 28.685, "d": 0.15}, {"w": "phần", "t": 28.835, "d": 0.2}, {"w": "triệu", "t": 29.035, "d": 0.14}, {"w": "giây.", "t": 29.175, "d": 0.33}]}, {"text": "Hai bộ đổi gửi tối đa mười hai nghìn tám trăm xung mỗi giây.", "start": 30.0, "end": 33.36, "words": [{"w": "Hai", "t": 30.0, "d": 0.22}, {"w": "bộ", "t": 30.22, "d": 0.215}, {"w": "đổi", "t": 30.435, "d": 0.19}, {"w": "gửi", "t": 30.625, "d": 0.325}, {"w": "tối", "t": 30.95, "d": 0.14}, {"w": "đa", "t": 31.09, "d": 0.385}, {"w": "mười", "t": 31.475, "d": 0.195}, {"w": "hai", "t": 31.67, "d": 0.19}, {"w": "ng