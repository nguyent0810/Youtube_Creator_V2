], "pins": [{"name": "Anchorage", "lon": 169.0, "lat": 57.5, "label": "TỪ ANCHORAGE →", "x": 1348.9, "y": 251.1}, {"name": "Kamchatka", "lon": 158.65, "lat": 53.02, "label": "KAMCHATKA", "x": 1165.9, "y": 390.3}, {"name": "Sakhalin", "lon": 142.8, "lat": 50.0, "label": "ĐẢO SAKHALIN", "x": 885.8, "y": 476.1}, {"name": "Hit", "lon": 141.547, "lat": 46.774, "label": "18:26 UTC", "x": 863.6, "y": 562.0}, {"name": "Seoul", "lon": 126.98, "lat": 37.57, "label": "SEOUL · ĐÍCH ĐẾN", "x": 606.1, "y": 782.2}]}}, "scenes": [{"type": "chapter", "no": "3", "k": "CHƯƠNG BA", "title": "LỜI HỨA\nNGÀY 16 THÁNG 9", "sub": "NHÀ TRẮNG · 1983", "bg": "reagan_press", "titleAt": 0.045, "t0": 0.0, "t1": 3.46}, {"type": "photo", "img": "reagan_press", "tone": "color", "move": "in", "veil": 0.5, "kin": [{"text": "05.09.1983 · 20:00", "at": 3.46, "fx": "blur"}, {"text": "TỘI ÁC CHỐNG LẠI LOÀI NGƯỜI", "at": 7.61, "acc": true, "fx": "outline", "em": "CHỐNG"}], "label": {"k": "PHÒNG BẦU DỤC · BÀI PHÁT BIỂU VỀ KAL 007", "v": "WHITE HOUSE PHOTOGRAPHIC OFFICE", "at": 0.0}, "t0": 3.46, "t1": 13.72}, {"type": "quote", "text": "The 747 is equipped with the most modern computerized navigation facilities, but a computer must respond to input provided by human hands.", "by": "RONALD REAGAN · DIỄN VĂN 05.09.1983 · AMERICAN PRESIDENCY PROJECT", "lbl": "TRÍCH DỊCH", "qline": 3, "typeDur": 3.0, "t0": 13.72, "t1": 17.56, "at": 13.78, "voiceAt": 13.72, "voiceEnd": 17.24, "radio": true}, {"type": "quote", "text": "No one will ever know whether a mistake was made in giving the computer the course or whether there was a malfunction.", "by": "RONALD REAGAN · DIỄN VĂN 05.09.1983", "lbl": "TRÍCH DỊCH", "qline": 4, "typeDur": 2.8, "t0": 17.56, "t1": 22.96, "at": 17.71, "voiceAt": 17.56, "voiceEnd": 21.96, "radio": true}, {"type": "kinetic", "items": [{"text": "MƯỜI NĂM SAU · HỘP ĐEN", "at": 22.96, "sm": true, "fx": "rise", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "58px", "left": "140px"}}}, {"text": "KHÔNG TRỤC TRẶC", "at": 23.36, "acc": true, "fx": "marker", "L": {"cls": "kC", "style": {"top": "346px", "fontSize": "114px", "left": "310px"}}, "em": "KHÔNG"}, {"text": "lỗi nằm ở cách dùng máy", "at": 26.0, "sm": true, "fx": "blur", "L": {"cls": "kC", "style": {"top": "516px", "fontSize": "58px", "left": "480px"}}}], "t0": 22.96, "t1": 27.68, "lay": "ladder"}, {"type": "print", "img": "speakes", "tone": "bw", "side": {"k": "16.09.1983 · HỌP BÁO 12:30", "h": "Larry\nSpeakes", "lines": [{"text": "*phó thư ký báo chí* Nhà Trắng", "at": 34.06}, {"text": "đọc tuyên bố, *không phải* Reagan", "at": 32.95}]}, "t0": 27.68, "t1": 40.16}, {"type": "quote", "text": "…the United States is prepared to make available to civilian aircraft the facilities of its Global Positioning System when it becomes operational in 1988.", "by": "TUYÊN BỐ DO LARRY SPEAKES ĐỌC · 16.09.1983 · REAGAN LIBRARY", "lbl": "TRÍCH DỊCH", "qline": 10, "typeDur": 3.4, "t0": 40.16, "t1": 48.0, "at": 40.24, "voiceAt": 40.16, "voiceEnd": 47.68, "radio": true}, {"type": "slam", "text": "GPS", "sub": "HỆ THỐNG ĐỊNH VỊ TOÀN CẦU · GLOBAL POSITIONING SYSTEM", "t0": 48.0, "t1": 51.48, "at": 48.15, "fx": "punch"}, {"type": "ledger", "title": "ĐỌC KỸ CÂU ẤY", "srcnote": "REAGAN LIBRARY · TUYÊN BỐ 16.09.1983", "rows": [{"k": "DÀNH CHO", "v": "MÁY BAY DÂN SỰ", "at": 52.84}, {"k": "CHỮ “MIỄN PHÍ”", "v": "KHÔNG CÓ", "at": 55.72}, {"k": "REAGAN PHÁT MINH GPS?", "v": "KHÔNG", "at": 57.4}], "t0": 51.48, "t1": 60.48}, {"type": "timeline", "items": [{"year": "1973", "text": "chương trình GPS *được duyệt*", "at": 60.48}, {"year": "22.02.1978", "text": "vệ tinh thử nghiệm *đầu tiên*", "at": 63.68}], "t0": 60.48, "t1": 68.48}, {"type": "photo", "img": "block1", "tone": "bw", "move": "in", "veil": 0.5, "kin": [{"text": "1983: HỆ THỐNG CÒN DANG DỞ", "at": 68.48, "acc": true, "fx": "flicker", "em": "1983:"}, {"text": "lời hứa hẹn mốc 1988", "at": 71.84, "sm": true, "fx": "flicker"}], "label": {"k": "BẢN VẼ VỆ TINH GPS BLOCK I", "v": "USAF · 1979", "at": 68.48}, "t0": 68.48, "t1": 73.52}, {"type": "kinetic", "items": [{"text": "MỞ MỘT HỆ THỐNG QUÂN SỰ", "at": 73.52, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "710px", "fontSize": "81px"}}, "D": [{"kind": "bar", "style": {"top": "710px", "height": "150px"}, "at": 73.27}], "em": "THỐNG"}, {"text": "cho máy bay chở dân thường", "at": 76.395, "sm": true, "fx": "rise", "L": {"cls": "kC", "style": {"top": "815px", "fontSize": "50px"}}}], "t0": 73.52, "t1": 78.92, "lay": "corner"}, {"type": "slam", "text": "CHẤM XANH", "sub": "GOOGLE MAPS · MỘT BUỔI SÁNG Ở SAKHALIN · 1983", "white": true, "t0": 78.92, "t1": 84.12, "at": 79.07, "fx": "outline"}, {"type": "question", "text": "Vì sao chấm xanh\nchưa chính xác ngay?", "t0": 84.12, "t1": 92.14}], "prog0": 0.45309, "prog1": 0.59985};
motion/hf/assets/long\mim-oppenheimer-feynman\ch03\data.js:1:window.CASE = {"topic": "mim-oppenheimer-feynman", "ch": "ch03", "dur": 106.98, "seed": 35919, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 03", "t": "MỘT VỤ NỔ KHÔNG ĐƯỢC LÀM THỬ"}, "acc": ["số", "khoá", "máy", "người", "thẻ", "mệt", "song", "xúc"], "lines": [{"text": "Thử tưởng tượng bạn phải thiết kế một thứ chưa ai làm ra, mà không được làm thử.", "start": 0.0, "end": 3.92, "words": [{"w": "Thử", "t": 0.0, "d": 0.125}, {"w": "tưởng", "t": 0.125, "d": 0.345}, {"w": "tượng", "t": 0.47, "d": 0.19}, {"w": "bạn", "t": 0.66, "d": 0.185}, {"w": "phải", "t": 0.845, "d": 0.195}, {"w": "thiết", "t": 1.04, "d": 0.185}, {"w": "kế", "t": 1.225, "d": 0.19}, {"w": "một", "t": 1.415, "d": 0.06}, {"w": "thứ", "t": 1.475, "d": 0.23}, {"w": "chưa", "t": 1.705, "d": 0.175}, {"w": "ai", "t": 1.88, "d": 0.335}, {"w": "làm", "t": 2.215, "d": 0.195}, {"w": "ra,", "t": 2.41, "d": 0.3}, {"w": "mà", "t": 2.71, "d": 0.095}, {"w": "không", "t": 2.805, "d": 0.195}, {"w": "được", "t": 3.0, "d": 0.23}, {"w": "làm", "t": 3.23, "d": 0.125}, {"w": "thử.", "t": 3.355, "d": 0.37}]}, {"text": "Nguyên liệu quá hiếm, quá đắt để thử từng phương án.", "start": 4.72, "end": 7.52, "words": [{"w": "Nguyên", "t": 4.795, "d": 0.115}, {"w": "liệu", "t": 4.91, "d": 0.225}, {"w": "quá", "t": 5.135, "d": 0.33}, {"w": "hiếm,", "t": 5.465, "d": 0.215}, {"w": "quá", "t": 5.68, "d": 0.15}, {"w": "đắt", "t": 5.83, "d": 0.38}, {"w": "để", "t": 6.21, "d": 0.065}, {"w": "thử", "t": 6.275, "d": 0.29}, {"w": "từng", "t": 6.565, "d": 0.225}, {"w": "phương", "t": 6.79, "d": 0.15}, {"w": "án.", "t": 6.94, "d": 0.305}]}, {"text": "Còn các bài toán thì không giải gọn được bằng công thức trên giấy.", "start": 7.84, "end": 11.04, "words": [{"w": "Còn", "t": 7.89, "d": 0.165}, {"w": "các", "t": 8.055, "d": 0.28}, {"w": "bài", "t": 8.335, "d": 0.23}, {"w": "toán", "t": 8.565, "d": 0.11}, {"w": "thì", "t": 8.675, "d": 0.19}, {"w": "không", "t": 8.865, "d": 0.175}, {"w": "giải", "t": 9.04, "d": 0.35}, {"w": "gọn", "t": 9.39, "d": 0.165}, {"w": "được", "t": 9.555, "d": 0.11}, {"w": "bằng", "t": 9.665, "d": 0.15}, {"w": "công", "t": 9.815, "d": 0.29}, {"w": "thức", "t": 10.105, "d": 0.175}, {"w": "trên", "t": 10.28, "d": 0.175}, {"w": "giấy.", "t": 10.455, "d": 0.385}]}, {"text": "Nên Ban Lý thuyết phải tính bằng số, từng bước nhỏ một.", "start": 11.36, "end": 14.08, "words": [{"w": "Nên", "t": 11.36, "d": 0.135}, {"w": "Ban", "t": 11.495, "d": 0.315}, {"w": "Lý", "t": 11.81, "d": 0.2}, {"w": "thuyết", "t": 12.01, "d": 0.17}, {"w": "phải", "t": 12.18, "d": 0.185}, {"w": "tính", "t": 12.365, "d": 0.115}, {"w": "bằng", "t": 12.48, "d": 0.13}, {"w": "số,", "t": 12.61, "d": 0.47}, {"w": "từng", "t": 13.08, "d": 0.06}, {"w": "bước", "t": 13.14, "d": 0.235}, {"w": "nhỏ", "t": 13.375, "d": 0.125}, {"w": "một.", "t": 13.5, "d": 0.385}]}, {"text": "Mùa hè năm 1944, thí nghiệm của nhóm Emilio Segrè cho thấy một tin xấu.", "start": 15.08, "end": 20.84, "words": [{"w": "Mùa", "t": 15.08, "d": 0.355}, {"w": "hè", "t": 15.435, "d": 0.1}, {"w": "năm", "t": 15.535, "d": 0.2}, {"w": "1944,", "t": 15.735, "d": 1.98}, {"w": "thí", "t": 17.715, "d": 0.16}, {"w": "nghiệm", "t": 17.875, "d": 0.375}, {"w": "của", "t": 18.25, "d": 0.34}, {"w": "nhóm", "t": 18.59, "d": 0.055}, {"w": "Emilio", "t": 18.645, "d": 0.28}, {"w": "Segrè", "t": 18.925, "d": 0.305}, {"w": "cho", "t": 19.23, "d": 0.17}, {"w": "thấy", "t": 19.4, "d": 0.425}, {"w": "một", "t": 19.825, "d": 0.1}, {"w": "tin", "t": 19.925, "d": 0.305}, {"w": "xấu.", "t": 20.23, "d": 0.41}]}, {"text": "Kiểu bom \"khẩu súng\", bắn hai khối nhỏ vào nhau cho thành một khối lớn, không dùng được với plutonium.", "start": 21.16, "end": 26.12, "words": [{"w": "Kiểu", "t": 21.17, "d": 0.125}, {"w": "bom", "t": 21.295, "d": 0.255}, {"w": "\"khẩu", "t": 21.55, "d": 0.365}, {"w": "súng\",", "t": 21.915, "d": 0.295}, {"w": "bắn", "t": 22.21, "d": 0.085}, {"w": "hai", "t": 22.295, "d": 0.325}, {"w": "khối", "t": 22.62, "d": 0.13}, {"w": "nhỏ", "t": 22.75, "d": 0.2}, {"w": "vào", "t": 22.95, "d": 0.335}, {"w": "nhau", "t": 23.285, "d": 0.125}, {"w": "cho", "t": 23.41, "d": 0.315}, {"w": "thành", "t": 23.725, "d": 0.185}, {"w": "một", "t": 23.91, "d": 0.325}, {"w": "khối", "t": 24.235, "d": 0.115}, {"w": "lớn,", "t": 24.35, "d": 0.345}, {"w": "không", "t": 24.695, "d": 0.325}, {"w": "dùng", "t": 25.02, "d": 0.22}, {"w": "được", "t": 25.24, "d": 0.06}, {"w": "với", "t": 25.3, "d": 0.185}, {"w": "plutonium.", "t": 25.485, "d": 0.45}]}, {"text": "Với plutonium, hai khối gặp nhau quá chậm.", "start": 26.44, "end": 29.0, "words": [{"w": "Với", "t": 26.44, "d": 0.36}, {"w": "plutonium,", "t": 26.8, "d": 0.185}, {"w": "hai", "t": 26.985, "d": 0.475}, {"w": "khối", "t": 27.46, "d": 0.155}, {"w": "gặp", "t": 27.615, "d": 0.24}, {"w": "nhau", "t": 27.855, "d": 0.365}, {"w": "quá", "t": 28.22, "d": 0.255}, {"w": "chậm.", "t": 28.475, "d": 0.3}]}, {"text": "Phản ứng sẽ bắt đầu sớm, trước khi quả bom kịp ghép xong.", "start": 29.32, "end": 32.36, "words": [{"w": "Phản", "t": 29.365, "d": 0.11}, {"w": "ứng", "t": 29.475, "d": 0.28}, {"w": "sẽ", "t": 29.755, "d": 0.21}, {"w": "bắt", "t": 29.965, "d": 0.23}, {"w": "đầu", "t": 30.195, "d": 0.225}, {"w": "sớm,", "t": 30.42, "d": 0.3}, {"w": "trước", "t": 30.72, "d": 0.055}, {"w": "khi", "t": 30.775, "d": 0.21}, {"w": "quả", "t": 30.985, "d": 0.195}, {"w": "bom", "t": 31.18, "d": 0.165}, {"w": "kịp", "t": 31.345, "d": 0.275}, {"w": "ghép", "t": 31.62, "d": 0.155}, {"w": "xong.", "t": 31.775, "d": 0.36}]}, {"text": "Mà dự án có lẽ chỉ đủ uranium cho một quả bom vào mùa hè năm 1945.", "start": 33.36, "end": 38.24, "words": [{"w": "Mà", "t": 33.415, "d": 0.13}, {"w": "dự", "t": 33.545, "d": 0.295}, {"w": "án", "t": 33.84, "d": 0.245}, {"w": "có", "t": 34.085, "d": 0.075}, {"w": "lẽ", "t": 34.16, "d": 0.285}, {"w": "chỉ", "t": 34.445, "d": 0.18}, {"w": "đủ", "t": 34.625, "d": 0.125}, {"w": "uranium", "t": 34.75, "d": 0.31}, {"w": "cho", "t": 35.06, "d": 0.18}, {"w": "một", "t": 35.24, "d": 0.14}, {"w": "quả", "t": 35.38, "d": 0.2}, {"w": "bom", "t": 35.58, "d": 0.23}, {"w": "vào", "t": 35.81, "d": 0.195}, {"w": "mùa", "t": 36.005, "d": 0.245}, {"w": "hè", "t": 36.25, "d": 0.125}, {"w": "năm", "t": 36.375, "d": 0.205}, {"w": "1945.", "t": 36.58, "d": 1.475}]}, {"text": "Plutonium thì đủ cho nhiều quả hơn.", "start": 38.56, "end": 40.64, "words": [{"w": "Plutonium", "t": 38.595, "d": 0.135}, {"w": "thì", "t": 38.73, "d": 0.46}, {"w": "đủ", "t": 39.19, "d": 0.21}, {"w": "cho", "t": 39.4, "d": 0.07}, {"w": "nhiều", "t": 39.47, "d": 0.355}, {"w": "quả", "t": 39.825, "d": 0.355}, {"w": "hơn.", "t": 40.18, "d": 0.29}]}, {"text": "Không còn đường lùi.", "start": 40.96, "end": 41.92, "words": [{"w": "Không", "t": 41.04, "d": 0.11}, {"w": "còn", "t": 41.15, "d": 0.135}, {"w": "đường", "t": 41.285, "d": 0.13}, {"w": "lùi.", "t": 41.415, "d": 0.31}]}, {"text": "Nên phòng thí nghiệm buộc phải chọn cách khác: nổ ép vào trong.", "start": 42.24, "end": 45.2, "words": [{"w": "Nên", "t": 42.24, "d": 0.125}, {"w": "phòng", "t": 42.365, "d": 0.18}, {"w": "thí", "t": 42.545, "d": 0.265}, {"w": "nghiệm", "t": 42.81, "d": 0.225}, {"w": "buộc", "t": 43.035, "d": 0.22}, {"w": "phải", "t": 43.255, "d": 0.21}, {"w": "chọn", "t": 43.465, "d": 0.17}, {"w": "cách", "t": 43.635, "d": 0.21}, {"w": "khác:", "t": 43.845, "d": 0.28}, {"w": "nổ", "t": 44.125, "d": 0.06}, {"w": "ép", "t": 44.185, "d": 0.24}, {"w": "vào", "t": 44.425, "d": 0.16}, {"w": "trong.", "t": 44.585, "d": 0.365}]}, {"text": "Từ cuối năm 1943, nhà toán học John von Neumann đã thúc đẩy cách này.", "start": 46.2, "end": 50.76, "words": [{"w": "Từ", "t": 46.22, "d": 0.135}, {"w": "cuối", "t": 46.355, "d": 0.265}, {"w": "năm", "t": 46.62, "d": 0.245}, {"w": "1943,", "t": 46.865, "d": 1.455}, {"w": "nhà", "t": 48.32, "d": 0.145}, {"w": "toán", "t": 48.465, "d": 0.195}, {"w": "học", "t": 48.66, "d": 0.225}, {"w": "John", "t": 48.885, "d": 0.285}, {"w": "von", "t": 49.17, "d": 0.15}, {"w": "Neumann", "t": 49.32, "d": 0.07}, {"w": "đã", "t": 49.39, "d": 0.195}, {"w": "thúc", "t": 49.585, "d": 0.37}, {"w": "đẩy", "t": 49.955, "d": 0.13}, {"w": "cách", "t": 50.085, "d": 0.19}, {"w": "này.", "t": 50.275, "d": 0.305}]}, {"text": "Thuốc nổ thường xếp quanh một lõi kim loại, cùng nổ một lúc, ép lõi đặc lại.", "start": 51.08, "end": 55.0, "words": [{"w": "Thuốc", "t": 51.08, "d": 0.105}, {"w": "nổ", "t": 51.185, "d": 0.265}, {"w": "thường", "t": 51.45, "d": 0.225}, {"w": "xếp", "t": 51.675, "d": 0.145}, {"w": "quanh", "t": 51.82, "d": 0.295}, {"w": "một", "t": 52.115, "d": 0.23}, {"w": "lõi", "t": 52.345, "d": 0.15}, {"w": "kim", "t": 52.495, "d": 0.245}, {"w": "loại,", "t": 52.74, "d": 0.29}, {"w": "cùng", "t": 53.03, "d": 0.06}, {"w": "nổ", "t": 53.09, "d": 0.365}, {"w": "một", "t": 53.455, "d": 0.135}, {"w": "lúc,", "t": 53.59, "d": 0.375}, {"w": "ép", "t": 53.965, "d": 0.07}, {"w": "lõi", "t": 54.035, "d": 0.2}, {"w": "đặc", "t": 54.235, "d": 0.325}, {"w": "lại.", "t": 54.56, "d": 0.235}]}, {"text": "Nghe thì đơn giản.", "start": 55.32, "end": 56.2, "words": [{"w": "Nghe", "t": 55.32, "d": 0.19}, {"w": "thì", "t": 55.51, "d": 0.125}, {"w": "đơn", "t": 55.635, "d": 0.15}, {"w": "giản.", "t": 55.785, "d": 0.195}]}, {"text": "Nhưng phải tính sóng ép chạy vào lõi, dội ngược ra, đi qua từng lớp vật liệu.", "start": 56.52, "end": 60.52, "words": [{"w": "Nhưng", "t": 56.52, "d": 0.25}, {"w": "phải", "t": 56.77, "d": 0.19}, {"w": "tính", "t": 56.96, "d": 0.125}, {"w": "sóng", "t": 57.085, "d": 0.2}, {"w": "ép", "t": 57.285, "d": 0.215}, {"w": "chạy", "t": 57.5, "d": 0.14}, {"w": "vào", "t": 57.64, "d": 0.375}, {"w": "lõi,", "t": 58.015, "d": 0.265}, {"w": "dội", "t": 58.28, "d": 0.085}, {"w": "ngược", "t": 58.365, "d": 0.38}, {"w": "ra,", "t": 58.745, "d": 0.32}, {"w": "đi", "t": 59.065, "d": 0.17}, 