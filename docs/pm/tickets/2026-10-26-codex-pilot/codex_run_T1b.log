motion/hf/assets/long\mim-ke-huy-diet-petrov\ch05\data.js:1:window.CASE = {"topic": "mim-ke-huy-diet-petrov", "ch": "ch05", "dur": 116.74, "seed": 32802, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 05", "t": "BA GIỜ SÁNG Ở WASHINGTON"}, "acc": ["báo", "máy", "phóng", "mây", "người", "ghế", "chưa", "tấn"], "lines": [{"text": "Ngày 9 tháng 11 năm 1979, bốn năm trước đêm ở Serpukhov.", "start": 0.0, "end": 4.24, "words": [{"w": "Ngày", "t": 0.055, "d": 0.11}, {"w": "9", "t": 0.165, "d": 0.24}, {"w": "tháng", "t": 0.405, "d": 0.305}, {"w": "11", "t": 0.71, "d": 0.425}, {"w": "năm", "t": 1.135, "d": 0.165}, {"w": "1979,", "t": 1.3, "d": 1.555}, {"w": "bốn", "t": 2.855, "d": 0.135}, {"w": "năm", "t": 2.99, "d": 0.24}, {"w": "trước", "t": 3.23, "d": 0.22}, {"w": "đêm", "t": 3.45, "d": 0.195}, {"w": "ở", "t": 3.645, "d": 0.06}, {"w": "Serpukhov.", "t": 3.705, "d": 0.385}]}, {"text": "Bộ chỉ huy Phòng không Bắc Mỹ, gọi tắt là NORAD, đặt trong lòng núi Cheyenne ở bang Colorado.", "start": 5.04, "end": 10.32, "words": [{"w": "Bộ", "t": 5.04, "d": 0.135}, {"w": "chỉ", "t": 5.175, "d": 0.33}, {"w": "huy", "t": 5.505, "d": 0.17}, {"w": "Phòng", "t": 5.675, "d": 0.27}, {"w": "không", "t": 5.945, "d": 0.425}, {"w": "Bắc", "t": 6.37, "d": 0.18}, {"w": "Mỹ,", "t": 6.55, "d": 0.365}, {"w": "gọi", "t": 6.915, "d": 0.2}, {"w": "tắt", "t": 7.115, "d": 0.39}, {"w": "là", "t": 7.505, "d": 0.25}, {"w": "NORAD,", "t": 7.755, "d": 0.38}, {"w": "đặt", "t": 8.135, "d": 0.145}, {"w": "trong", "t": 8.28, "d": 0.255}, {"w": "lòng", "t": 8.535, "d": 0.195}, {"w": "núi", "t": 8.73, "d": 0.325}, {"w": "Cheyenne", "t": 9.055, "d": 0.15}, {"w": "ở", "t": 9.205, "d": 0.205}, {"w": "bang", "t": 9.41, "d": 0.4}, {"w": "Colorado.", "t": 9.81, "d": 0.35}]}, {"text": "Hôm ấy, màn hình cảnh báo của họ hiện một cuộc tấn công tên lửa của Liên Xô.", "start": 10.64, "end": 14.4, "words": [{"w": "Hôm", "t": 10.65, "d": 0.1}, {"w": "ấy,", "t": 10.75, "d": 0.44}, {"w": "màn", "t": 11.19, "d": 0.085}, {"w": "hình", "t": 11.275, "d": 0.215}, {"w": "cảnh", "t": 11.49, "d": 0.15}, {"w": "báo", "t": 11.64, "d": 0.16}, {"w": "của", "t": 11.8, "d": 0.23}, {"w": "họ", "t": 12.03, "d": 0.305}, {"w": "hiện", "t": 12.335, "d": 0.185}, {"w": "một", "t": 12.52, "d": 0.19}, {"w": "cuộc", "t": 12.71, "d": 0.07}, {"w": "tấn", "t": 12.78, "d": 0.24}, {"w": "công", "t": 13.02, "d": 0.2}, {"w": "tên", "t": 13.22, "d": 0.185}, {"w": "lửa", "t": 13.405, "d": 0.1}, {"w": "của", "t": 13.505, "d": 0.285}, {"w": "Liên", "t": 13.79, "d": 0.225}, {"w": "Xô.", "t": 14.015, "d": 0.225}]}, {"text": "Cùng lúc, hình ảnh ấy hiện ở Bộ chỉ huy Không quân Chiến lược và Trung tâm Chỉ huy Quân sự Quốc gia.", "start": 14.72, "end": 19.76, "words": [{"w": "Cùng", "t": 14.765, "d": 0.28}, {"w": "lúc,", "t": 15.045, "d": 0.305}, {"w": "hình", "t": 15.35, "d": 0.06}, {"w": "ảnh", "t": 15.41, "d": 0.28}, {"w": "ấy", "t": 15.69, "d": 0.22}, {"w": "hiện", "t": 15.91, "d": 0.15}, {"w": "ở", "t": 16.06, "d": 0.135}, {"w": "Bộ", "t": 16.195, "d": 0.175}, {"w": "chỉ", "t": 16.37, "d": 0.375}, {"w": "huy", "t": 16.745, "d": 0.19}, {"w": "Không", "t": 16.935, "d": 0.175}, {"w": "quân", "t": 17.11, "d": 0.13}, {"w": "Chiến", "t": 17.24, "d": 0.28}, {"w": "lược", "t": 17.52, "d": 0.21}, {"w": "và", "t": 17.73, "d": 0.055}, {"w": "Trung", "t": 17.785, "d": 0.235}, {"w": "tâm", "t": 18.02, "d": 0.21}, {"w": "Chỉ", "t": 18.23, "d": 0.22}, {"w": "huy", "t": 18.45, "d": 0.205}, {"w": "Quân", "t": 18.655, "d": 0.2}, {"w": "sự", "t": 18.855, "d": 0.175}, {"w": "Quốc", "t": 19.03, "d": 0.2}, {"w": "gia.", "t": 19.23, "d": 0.315}]}, {"text": "Lưu trữ An ninh Quốc gia, một viện nghiên cứu ở Washington, đã công bố hồ sơ giải mật về đêm ấy.", "start": 20.08, "end": 25.28, "words": [{"w": "Lưu", "t": 20.08, "d": 0.21}, {"w": "trữ", "t": 20.29, "d": 0.235}, {"w": "An", "t": 20.525, "d": 0.175}, {"w": "ninh", "t": 20.7, "d": 0.14}, {"w": "Quốc", "t": 20.84, "d": 0.385}, {"w": "gia,", "t": 21.225, "d": 0.245}, {"w": "một", "t": 21.47, "d": 0.225}, {"w": "viện", "t": 21.695, "d": 0.11}, {"w": "nghiên", "t": 21.805, "d": 0.255}, {"w": "cứu", "t": 22.06, "d": 0.345}, {"w": "ở", "t": 22.405, "d": 0.185}, {"w": "Washington,", "t": 22.59, "d": 0.365}, {"w": "đã", "t": 22.955, "d": 0.17}, {"w": "công", "t": 23.125, "d": 0.165}, {"w": "bố", "t": 23.29, "d": 0.24}, {"w": "hồ", "t": 23.53, "d": 0.1}, {"w": "sơ", "t": 23.63, "d": 0.23}, {"w": "giải", "t": 23.86, "d": 0.215}, {"w": "mật", "t": 24.075, "d": 0.18}, {"w": "về", "t": 24.255, "d": 0.335}, {"w": "đêm", "t": 24.59, "d": 0.145}, {"w": "ấy.", "t": 24.735, "d": 0.36}]}, {"text": "Họ dẫn lại hồi ký của Robert Gates, khi đó làm ở Hội đồng An ninh Quốc gia.", "start": 25.6, "end": 29.52, "words": [{"w": "Họ", "t": 25.6, "d": 0.105}, {"w": "dẫn", "t": 25.705, "d": 0.31}, {"w": "lại", "t": 26.015, "d": 0.215}, {"w": "hồi", "t": 26.23, "d": 0.22}, {"w": "ký", "t": 26.45, "d": 0.06}, {"w": "của", "t": 26.51, "d": 0.19}, {"w": "Robert", "t": 26.7, "d": 0.255}, {"w": "Gates,", "t": 26.955, "d": 0.38}, {"w": "khi", "t": 27.335, "d": 0.19}, {"w": "đó", "t": 27.525, "d": 0.125}, {"w": "làm", "t": 27.65, "d": 0.165}, {"w": "ở", "t": 27.815, "d": 0.205}, {"w": "Hội", "t": 28.02, "d": 0.275}, {"w": "đồng", "t": 28.295, "d": 0.185}, {"w": "An", "t": 28.48, "d": 0.2}, {"w": "ninh", "t": 28.68, "d": 0.12}, {"w": "Quốc", "t": 28.8, "d": 0.17}, {"w": "gia.", "t": 28.97, "d": 0.325}]}, {"text": "Theo hồi ký, cố vấn an ninh quốc gia Zbigniew Brzezinski bị đánh thức lúc ba giờ sáng.", "start": 29.84, "end": 34.64, "words": [{"w": "Theo", "t": 29.84, "d": 0.295}, {"w": "hồi", "t": 30.135, "d": 0.28}, {"w": "ký,", "t": 30.415, "d": 0.22}, {"w": "cố", "t": 30.635, "d": 0.355}, {"w": "vấn", "t": 30.99, "d": 0.25}, {"w": "an", "t": 31.24, "d": 0.13}, {"w": "ninh", "t": 31.37, "d": 0.195}, {"w": "quốc", "t": 31.565, "d": 0.27}, {"w": "gia", "t": 31.835, "d": 0.28}, {"w": "Zbigniew", "t": 32.115, "d": 0.205}, {"w": "Brzezinski", "t": 32.32, "d": 0.37}, {"w": "bị", "t": 32.69, "d": 0.135}, {"w": "đánh", "t": 32.825, "d": 0.34}, {"w": "thức", "t": 33.165, "d": 0.06}, {"w": "lúc", "t": 33.225, "d": 0.35}, {"w": "ba", "t": 33.575, "d": 0.14}, {"w": "giờ", "t": 33.715, "d": 0.19}, {"w": "sáng.", "t": 33.905, "d": 0.49}]}, {"text": "Cuộc gọi đầu tiên báo khoảng hai trăm năm mươi tên lửa của Liên Xô.", "start": 34.96, "end": 38.08, "words": [{"w": "Cuộc", "t": 35.005, "d": 0.11}, {"w": "gọi", "t": 35.115, "d": 0.315}, {"w": "đầu", "t": 35.43, "d": 0.195}, {"w": "tiên", "t": 35.625, "d": 0.18}, {"w": "báo", "t": 35.805, "d": 0.06}, {"w": "khoảng", "t": 35.865, "d": 0.215}, {"w": "hai", "t": 36.08, "d": 0.16}, {"w": "trăm", "t": 36.24, "d": 0.135}, {"w": "năm", "t": 36.375, "d": 0.235}, {"w": "mươi", "t": 36.61, "d": 0.195}, {"w": "tên", "t": 36.805, "d": 0.115}, {"w": "lửa", "t": 36.92, "d": 0.34}, {"w": "của", "t": 37.26, "d": 0.1}, {"w": "Liên", "t": 37.36, "d": 0.205}, {"w": "Xô.", "t": 37.565, "d": 0.275}]}, {"text": "Cuộc gọi thứ hai: hai nghìn hai trăm tên lửa, một cuộc tấn công toàn diện.", "start": 38.4, "end": 42.08, "words": [{"w": "Cuộc", "t": 38.4, "d": 0.21}, {"w": "gọi", "t": 38.61, "d": 0.145}, {"w": "thứ", "t": 38.755, "d": 0.32}, {"w": "hai:", "t": 39.075, "d": 0.17}, {"w": "hai", "t": 39.245, "d": 0.24}, {"w": "nghìn", "t": 39.485, "d": 0.205}, {"w": "hai", "t": 39.69, "d": 0.185}, {"w": "trăm", "t": 39.875, "d": 0.175}, {"w": "tên", "t": 40.05, "d": 0.335}, {"w": "lửa,", "t": 40.385, "d": 0.255}, {"w": "một", "t": 40.64, "d": 0.26}, {"w": "cuộc", "t": 40.9, "d": 0.06}, {"w": "tấn", "t": 40.96, "d": 0.235}, {"w": "công", "t": 41.195, "d": 0.2}, {"w": "toàn", "t": 41.395, "d": 0.205}, {"w": "diện.", "t": 41.6, "d": 0.325}]}, {"text": "Ông biết Tổng thống chỉ có chừng ba đến bảy phút để quyết định đánh trả.", "start": 43.08, "end": 46.28, "words": [{"w": "Ông", "t": 43.08, "d": 0.25}, {"w": "biết", "t": 43.33, "d": 0.18}, {"w": "Tổng", "t": 43.51, "d": 0.19}, {"w": "thống", "t": 43.7, "d": 0.185}, {"w": "chỉ", "t": 43.885, "d": 0.125}, {"w": "có", "t": 44.01, "d": 0.23}, {"w": "chừng", "t": 44.24, "d": 0.13}, {"w": "ba", "t": 44.37, "d": 0.225}, {"w": "đến", "t": 44.595, "d": 0.2}, {"w": "bảy", "t": 44.795, "d": 0.18}, {"w": "phút", "t": 44.975, "d": 0.185}, {"w": "để", "t": 45.16, "d": 0.06}, {"w": "quyết", "t": 45.22, "d": 0.305}, {"w": "định", "t": 45.525, "d": 0.115}, {"w": "đánh", "t": 45.64, "d": 0.13}, {"w": "trả.", "t": 45.77, "d": 0.335}]}, {"text": "Ông không đánh thức vợ, vì nghĩ rằng nửa tiếng nữa mọi người đều sẽ chết.", "start": 46.6, "end": 50.2, "words": [{"w": "Ông", "t": 46.645, "d": 0.145}, {"w": "không", "t": 46.79, "d": 0.325}, {"w": "đánh", "t": 47.115, "d": 0.135}, {"w": "thức", "t": 47.25, "d": 0.25}, {"w": "vợ,", "t": 47.5, "d": 0.3}, {"w": "vì", "t": 47.8, "d": 0.145}, {"w": "nghĩ", "t": 47.945, "d": 0.085}, {"w": "rằng", "t": 48.03, "d": 0.325}, {"w": "nửa", "t": 48.355, "d": 0.155}, {"w": "tiếng", "t": 48.51, "d": 0.27}, {"w": "nữa", "t": 48.78, "d": 0.06}, {"w": "mọi", "t": 48.84, "d": 0.31}, {"w": "người", "t": 49.15, "d": 0.17}, {"w": "đều", "t": 49.32, "d": 0.21}, {"w": "sẽ", "t": 49.53, "d": 0.135}, {"w": "chết.", "t": 49.665, "d": 0.315}]}, {"text": "Ông định gọi Tổng thống Carter.", "start": 50.52, "end": 52.12, "words": [{"w": "Ông", "t": 50.57, "d": 0.17}, {"w": "định", "t": 50.74, "d": 0.19}, {"w": "gọi", "t": 50.93, "d": 0.17}, {"w": "Tổng", "t": 51.1, "d": 0.365}, {"w": "thống", "t": 51.465, "d": 0.17}, {"w": "Carter.", "t": 51.635, "d": 0.27}]}, {"text": "Bạn đang ở chỗ của ông.", "start": 52.44, "end": 53.56, "words": [{"w": "Bạn", "t": 52.495, "d": 0.13}, {"w": "đang", "t": 52.625, "d": 0.12}, {"w": "ở", "t": 52.745, "d": 0.13}, {"w": "chỗ", "t": 52.875, "d": 0.19}, {"w": "của", "t": 53.065, "d": 0.13}, {"w": "ông.", "t": 53.195, "d": 0.16}]}, {"text": "Bạn bấm số gọi Tổng thống, hay chờ thêm một chút