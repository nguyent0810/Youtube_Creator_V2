motion/hf/assets/long\mim-ke-huy-diet-petrov\ch11\data.js:1:window.CASE = {"topic": "mim-ke-huy-diet-petrov", "ch": "ch11", "dur": 133.06, "seed": 32723, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 11", "t": "NGƯỜI Ở GIỮA VÒNG LẶP"}, "acc": ["báo", "máy", "phóng", "mây", "người", "ghế", "chưa", "tấn"], "lines": [{"text": "Câu chuyện chỉ lộ ra sau khi Liên Xô tan rã.", "start": 0.0, "end": 2.32, "words": [{"w": "Câu", "t": 0.045, "d": 0.115}, {"w": "chuyện", "t": 0.16, "d": 0.165}, {"w": "chỉ", "t": 0.325, "d": 0.33}, {"w": "lộ", "t": 0.655, "d": 0.06}, {"w": "ra", "t": 0.715, "d": 0.25}, {"w": "sau", "t": 0.965, "d": 0.145}, {"w": "khi", "t": 1.11, "d": 0.145}, {"w": "Liên", "t": 1.255, "d": 0.3}, {"w": "Xô", "t": 1.555, "d": 0.17}, {"w": "tan", "t": 1.725, "d": 0.185}, {"w": "rã.", "t": 1.91, "d": 0.215}]}, {"text": "Theo bài năm 2004, chính tướng Votintsev công bố nó trong một cuộc phỏng vấn đầu thập niên chín mươi.", "start": 3.12, "end": 8.96, "words": [{"w": "Theo", "t": 3.12, "d": 0.275}, {"w": "bài", "t": 3.395, "d": 0.15}, {"w": "năm", "t": 3.545, "d": 0.31}, {"w": "2004,", "t": 3.855, "d": 1.295}, {"w": "chính", "t": 5.15, "d": 0.335}, {"w": "tướng", "t": 5.485, "d": 0.21}, {"w": "Votintsev", "t": 5.695, "d": 0.215}, {"w": "công", "t": 5.91, "d": 0.18}, {"w": "bố", "t": 6.09, "d": 0.25}, {"w": "nó", "t": 6.34, "d": 0.08}, {"w": "trong", "t": 6.42, "d": 0.26}, {"w": "một", "t": 6.68, "d": 0.305}, {"w": "cuộc", "t": 6.985, "d": 0.19}, {"w": "phỏng", "t": 7.175, "d": 0.24}, {"w": "vấn", "t": 7.415, "d": 0.15}, {"w": "đầu", "t": 7.565, "d": 0.175}, {"w": "thập", "t": 7.74, "d": 0.315}, {"w": "niên", "t": 8.055, "d": 0.19}, {"w": "chín", "t": 8.245, "d": 0.195}, {"w": "mươi.", "t": 8.44, "d": 0.3}]}, {"text": "Guardian thì viết rằng phải tới năm 1998, khi hồi ký của ông tướng ra đời, câu chuyện mới được biết rộng rãi.", "start": 9.28, "end": 15.84, "words": [{"w": "Guardian", "t": 9.435, "d": 0.135}, {"w": "thì", "t": 9.57, "d": 0.265}, {"w": "viết", "t": 9.835, "d": 0.12}, {"w": "rằng", "t": 9.955, "d": 0.255}, {"w": "phải", "t": 10.21, "d": 0.315}, {"w": "tới", "t": 10.525, "d": 0.2}, {"w": "năm", "t": 10.725, "d": 0.2}, {"w": "1998,", "t": 10.925, "d": 1.5}, {"w": "khi", "t": 12.425, "d": 0.11}, {"w": "hồi", "t": 12.535, "d": 0.16}, {"w": "ký", "t": 12.695, "d": 0.26}, {"w": "của", "t": 12.955, "d": 0.185}, {"w": "ông", "t": 13.14, "d": 0.255}, {"w": "tướng", "t": 13.395, "d": 0.155}, {"w": "ra", "t": 13.55, "d": 0.155}, {"w": "đời,", "t": 13.705, "d": 0.465}, {"w": "câu", "t": 14.17, "d": 0.06}, {"w": "chuyện", "t": 14.23, "d": 0.25}, {"w": "mới", "t": 14.48, "d": 0.165}, {"w": "được", "t": 14.645, "d": 0.28}, {"w": "biết", "t": 14.925, "d": 0.105}, {"w": "rộng", "t": 15.03, "d": 0.28}, {"w": "rãi.", "t": 15.31, "d": 0.305}]}, {"text": "Hai mốc lệch nhau, mình để cả hai.", "start": 16.16, "end": 18.08, "words": [{"w": "Hai", "t": 16.22, "d": 0.145}, {"w": "mốc", "t": 16.365, "d": 0.29}, {"w": "lệch", "t": 16.655, "d": 0.195}, {"w": "nhau,", "t": 16.85, "d": 0.295}, {"w": "mình", "t": 17.145, "d": 0.055}, {"w": "để", "t": 17.2, "d": 0.22}, {"w": "cả", "t": 17.42, "d": 0.12}, {"w": "hai.", "t": 17.54, "d": 0.375}]}, {"text": "Năm 2006, Petrov được vinh danh tại trụ sở Liên Hợp Quốc ở New York.", "start": 19.08, "end": 23.56, "words": [{"w": "Năm", "t": 19.08, "d": 0.115}, {"w": "2006,", "t": 19.195, "d": 1.34}, {"w": "Petrov", "t": 20.535, "d": 0.275}, {"w": "được", "t": 20.81, "d": 0.21}, {"w": "vinh", "t": 21.02, "d": 0.175}, {"w": "danh", "t": 21.195, "d": 0.205}, {"w": "tại", "t": 21.4, "d": 0.2}, {"w": "trụ", "t": 21.6, "d": 0.15}, {"w": "sở", "t": 21.75, "d": 0.215}, {"w": "Liên", "t": 21.965, "d": 0.37}, {"w": "Hợp", "t": 22.335, "d": 0.085}, {"w": "Quốc", "t": 22.42, "d": 0.32}, {"w": "ở", "t": 22.74, "d": 0.06}, {"w": "New", "t": 22.8, "d": 0.26}, {"w": "York.", "t": 23.06, "d": 0.32}]}, {"text": "Năm 2013, ông nhận giải Hoà bình Dresden ở Đức.", "start": 23.88, "end": 27.48, "words": [{"w": "Năm", "t": 23.88, "d": 0.12}, {"w": "2013,", "t": 24.0, "d": 1.555}, {"w": "ông", "t": 25.555, "d": 0.18}, {"w": "nhận", "t": 25.735, "d": 0.17}, {"w": "giải", "t": 25.905, "d": 0.16}, {"w": "Hoà", "t": 26.065, "d": 0.36}, {"w": "bình", "t": 26.425, "d": 0.13}, {"w": "Dresden", "t": 26.555, "d": 0.29}, {"w": "ở", "t": 26.845, "d": 0.12}, {"w": "Đức.", "t": 26.965, "d": 0.345}]}, {"text": "Ở Warsaw, Ba Lan, có một phiến đá khắc tên ông, ghi rằng ông đã liều mình nhân danh nhân loại.", "start": 27.8, "end": 33.08, "words": [{"w": "Ở", "t": 27.845, "d": 0.305}, {"w": "Warsaw,", "t": 28.15, "d": 0.17}, {"w": "Ba", "t": 28.32, "d": 0.23}, {"w": "Lan,", "t": 28.55, "d": 0.515}, {"w": "có", "t": 29.065, "d": 0.09}, {"w": "một", "t": 29.155, "d": 0.29}, {"w": "phiến", "t": 29.445, "d": 0.17}, {"w": "đá", "t": 29.615, "d": 0.23}, {"w": "khắc", "t": 29.845, "d": 0.305}, {"w": "tên", "t": 30.15, "d": 0.07}, {"w": "ông,", "t": 30.22, "d": 0.485}, {"w": "ghi", "t": 30.705, "d": 0.085}, {"w": "rằng", "t": 30.79, "d": 0.17}, {"w": "ông", "t": 30.96, "d": 0.405}, {"w": "đã", "t": 31.365, "d": 0.105}, {"w": "liều", "t": 31.47, "d": 0.2}, {"w": "mình", "t": 31.67, "d": 0.185}, {"w": "nhân", "t": 31.855, "d": 0.195}, {"w": "danh", "t": 32.05, "d": 0.23}, {"w": "nhân", "t": 32.28, "d": 0.265}, {"w": "loại.", "t": 32.545, "d": 0.38}]}, {"text": "Ông mất ngày 19 tháng 5 năm 2017, ở thị trấn Fryazino gần Mát-xcơ-va.", "start": 33.4, "end": 39.16, "words": [{"w": "Ông", "t": 33.445, "d": 0.255}, {"w": "mất", "t": 33.7, "d": 0.25}, {"w": "ngày", "t": 33.95, "d": 0.16}, {"w": "19", "t": 34.11, "d": 0.675}, {"w": "tháng", "t": 34.785, "d": 0.135}, {"w": "5", "t": 34.92, "d": 0.27}, {"w": "năm", "t": 35.19, "d": 0.435}, {"w": "2017,", "t": 35.625, "d": 1.48}, {"w": "ở", "t": 37.105, "d": 0.3}, {"w": "thị", "t": 37.405, "d": 0.45}, {"w": "trấn", "t": 3