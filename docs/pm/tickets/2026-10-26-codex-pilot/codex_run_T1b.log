motion/hf/assets/long\mim-qwerty\ch06\data.js:1:window.CASE = {"topic": "mim-qwerty", "ch": "ch06", "dur": 54.54, "seed": 9702, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 06", "t": "NGƯỜI CHẤM THI"}, "acc": ["qwerty", "chậm", "tội", "phím", "thắng", "dvorak", "telex"], "lines": [{"text": "Năm 1990, hai nhà kinh tế học lật lại hồ sơ của thử nghiệm ấy.", "start": 0.0, "end": 4.16, "words": [{"w": "Năm", "t": 0.0, "d": 0.265}, {"w": "1990,", "t": 0.265, "d": 1.095}, {"w": "hai", "t": 1.36, "d": 0.265}, {"w": "nhà", "t": 1.625, "d": 0.14}, {"w": "kinh", "t": 1.765, "d": 0.14}, {"w": "tế", "t": 1.905, "d": 0.315}, {"w": "học", "t": 2.22, "d": 0.205}, {"w": "lật", "t": 2.425, "d": 0.14}, {"w": "lại", "t": 2.565, "d": 0.075}, {"w": "hồ", "t": 2.64, "d": 0.23}, {"w": "sơ", "t": 2.87, "d": 0.205}, {"w": "của", "t": 3.075, "d": 0.245}, {"w": "thử", "t": 3.32, "d": 0.12}, {"w": "nghiệm", "t": 3.44, "d": 0.29}, {"w": "ấy.", "t": 3.73, "d": 0.22}]}, {"text": "Và họ để ý tới một cái tên.", "start": 4.96, "end": 6.48, "words": [{"w": "Và", "t": 4.96, "d": 0.09}, {"w": "họ", "t": 5.05, "d": 0.17}, {"w": "để", "t": 5.22, "d": 0.225}, {"w": "ý", "t": 5.445, "d": 0.16}, {"w": "tới", "t": 5.605, "d": 0.085}, {"w": "một", "t": 5.69, "d": 0.11}, {"w": "cái", "t": 5.8, "d": 0.16}, {"w": "tên.", "t": 5.96, "d": 0.265}]}, {"text": "Người phụ trách nghiên cứu năng suất của Hải quân lúc đó, là một thiếu tá.", "start": 7.48, "end": 10.92, "words": [{"w": "Người", "t": 7.48, "d": 0.12}, {"w": "phụ", "t": 7.6, "d": 0.26}, {"w": "trách", "t": 7.86, "d": 0.21}, {"w": "nghiên", "t": 8.07, "d": 0.2}, {"w": "cứu", "t": 8.27, "d": 0.22}, {"w": "năng", "t": 8.49, "d": 0.19}, {"w": "suất", "t": 8.68, "d": 0.19}, {"w": "của", "t": 8.87, "d": 0.185}, {"w": "Hải", "t": 9.055, "d": 0.145}, {"w": "quân", "t": 9.2, "d": 0.13}, {"w": "lúc", "t": 9.33, "d": 0.29}, {"w": "đó,", "t": 9.62, "d": 0.3}, {"w": "là", "t": 9.92, "d": 0.06}, {"w": "một", "t": 9.98, "d": 0.305}, {"w": "thiếu", "t": 10.285, "d": 0.06}, {"w": "tá.", "t": 10.345, "d": 0.36}]}, {"text": "Tên ông là August Dvorak.", "start": 11.24, "end": 12.76, "words": [{"w": "Tên", "t": 11.3, "d": 0.125}, {"w": "ông", "t": 11.425, "d": 0.315}, {"w": "là", "t": 11.74, "d": 0.35}, {"w": "August", "t": 12.09, "d": 0.23}, {"w": "Dvorak.", "t": 12.32, "d": 0.275}]}, {"text": "Tức là người chấm thi, cũng chính là người làm ra bàn phím dự thi.", "start": 13.76, "end": 16.96, "words": [{"w": "Tức", "t": 13.805, "d": 0.1}, {"w": "là", "t": 13.905, "d": 0.185}, {"w": "người", "t": 14.09, "d": 0.23}, {"w": "chấm", "t": 14.32, "d": 0.205}, {"w": "thi,", "t": 14.525, "d": 0.355}, {"w": "cũng", "t": 14.88, "d": 0.13}, {"w": "chính", "t": 15.01, "d": 0.105}, {"w": "là", "t": 15.115, "d": 0.195}, {"w": "người", "t": 15.31, "d": 0.33}, {"w": "làm", "t": 15.64, "d": 0.185}, {"w": "ra", "t": 15.825, "d": 0.165}, {"w": "bàn", "t": 15.99, "d": 0.175}, {"w": "phím", "t": 16.165, "d": 0.135}, {"w": "dự", "t": 16.3, "d": 0.155}, {"w": "thi.", "t": 16.455, "d": 0.32}]}, {"text": "Họ còn chỉ ra rằng, ai được luyện lại bài bản thì cũng gõ nhanh lên, dù trên bàn phím nào.", "start": 17.28, "end": 22.0, "words": [{"w": "Họ", "t": 17.28, "d": 0.21}, {"w": "còn", "t": 17.49, "d": 0.145}, {"w": "chỉ", "t": 17.635, "d": 0.175}, {"w": "ra", "t": 17.81, "d": 0.345}, {"w": "rằng,", "t": 18.155, "d": 0.165}, {"w": "ai", "t": 18.32, "d": 0.335}, {"w": "được", "t": 18.655, "d": 0.21}, {"w": "luyện", "t": 18.865, "d": 0.2}, {"w": "lại", "t": 19.065, "d": 0.19}, {"w": "bài", "t": 19.255, "d": 0.21}, {"w": "bản", "t": 19.465, "d": 0.065}, {"w": "thì", "t": 19.53, "d": 0.185}, {"w": "cũng", "t": 19.715, "d": 0.23}, {"w": "gõ", "t": 19.945, "d": 0.19}, {"w": "nhanh", "t": 20.135, "d": 0.145}, {"w": "lên,", "t": 20.28, "d": 0.45}, {"w": "dù", "t": 20.73, "d": 0.135}, {"w": "trên", "t": 20.865, "d": 0.295}, {"w": "bàn", "t": 21.16, "d": 0.17}, {"w": "phím", "t": 21.33, "d": 0.15}, {"w": "nào.", "t": 21.48, "d": 0.32}]}, {"text": "Năm 1956, một thử nghiệm khác của chính phủ Mỹ đã so hai bàn phím cẩn thận hơn.", "start": 23.0, "end": 28.12, "words": [{"w": "Năm", "t": 23.0, "d": 0.19}, {"w": "1956,", "t": 23.19, "d": 1.485}, {"w": "một", "t": 24.675, "d": 0.21}, {"w": "thử", "t": 24.885, "d": 0.13}, {"w": "nghiệm", "t": 25.015, "d": 0.33}, {"w": "khác", "t": 25.345, "d": 0.135}, {"w": "của", "t": 25.48, "d": 0.195}, {"w": "chính", "t": 25.675, "d": 0.12}, {"w": "phủ", "t": 25.795, "d": 0.345}, {"w": "Mỹ", "t": 26.14, "d": 0.2}, {"w": "đã", "t": 26.34, "d": 0.06}, {"w": "so", "t": 26.4, "d": 0.245}, {"w": "hai", "t": 26.645, "d": 0.195}, {"w": "bàn", "t": 26.84, "d": 0.165}, {"w": "phím", "t": 27.005, "d": 0.205}, {"w": "cẩn", "t": 27.21, "d": 0.215}, {"w": "thận", "t": 27.425, "d": 0.28}, {"w": "hơn.", "t": 27.705, "d": 0.24}]}, {"text": "Và không thấy Dvorak hơn QWERTY.", "start": 28.44, "end": 30.36, "words": [{"w": "Và", "t": 28.485, "d": 0.26}, {"w": "không", "t": 28.745, "d": 0.135}, {"w": "thấy", "t": 28.88, "d": 0.24}, {"w": "Dvorak", "t": 29.12, "d": 0.42}, {"w": "hơn", "t": 29.54, "d": 0.255}, {"w": "QWERTY.", "t": 29.795, "d": 0.34}]}, {"text": "Nói cho công bằng, những người ủng hộ Dvorak cũng cho rằng thử nghiệm năm 1956 thiên vị.", "start": 31.36, "end": 36.48, "words": [{"w": "Nói", "t": 31.36, "d": 0.185}, {"w": "cho", "t": 31.545, "d": 0.12}, {"w": "công", "t": 31.665, "d": 0.36}, {"w": "bằng,", "t": 32.025, "d": 0.26}, {"w": "những", "t": 32.285, "d": 0.075}, {"w": "người", "t": 32.36, "d": 0.335}, {"w": "ủng", "t": 32.695, "d": 0.195}, {"w": "hộ", "t": 32.89, "d": 0.19}, {"w": "Dvorak", "t": 33.08, "d": 0.16}, {"w": "cũng", "t": 33.24, "d": 0.2}, {"w": "cho", "t": 33.44, "d": 0.195}, {"w": "rằng", "t": 33.635, "d": 0.155}, {"w": "thử", "t": 33.79, "d": 0.295}, {"w": "nghiệm", "t": 34.085, "d": 0.135}, {"w": "năm", "t": 34.22, "d": 0.085}, {"w": "1956", "t": 34.305, "d": 1.465}, {"w": "thiên", "t": 35.77, "d": 0.17}, {"w": "vị.", "t": 35.94, "d": 0.32}]}, {"text": "Và ngay cả hai nhà kinh tế kia cũng không nói QWERTY tốt hơn.", "start": 36.8, "end": 40.0, "words": [{"w": "Và", "t": 36.8, "d": 0.245}, {"w": "ngay", "t": 37.045, "d": 0.16}, {"w": "cả", "t": 37.205, "d": 0.295}, {"w": "hai", "t": 37.5, "d": 0.195}, {"w": "nhà", "t": 37.695, "d": 0.17}, {"w": "kinh", "t": 37.865, "d": 0.065}, {"w": "tế", "t": 37.93, "d": 0.355}, {"w": "kia", "t": 38.285, "d": 0.11}, {"w": "cũng", "t": 38.395, "d": 0.25}, {"w": "không", "t": 38.645, "d": 0.155}, {"w": "nói", "t": 38.8, "d": 0.325}, {"w": "QWERTY", "t": 39.125, "d": 0.195}, {"w": "tốt", "t": 39.32, "d": 0.13}, {"w": "hơn.", "t": 39.45, "d": 0.315}]}, {"text": "Họ chỉ nói: chưa có bằng chứng chắc chắn rằng nó kém.", "start": 40.32, "end": 43.36, "words": [{"w": "Họ", "t": 40.32, "d": 0.205}, {"w": "chỉ", "t": 40.525, "d": 0.315}, {"w": "nói:", "t": 40.84, "d": 0.275}, {"w": "chưa", "t": 41.115, "d": 0.285}, {"w": "có", "t": 41.4, "d": 0.165}, {"w": "bằng", "t": 41.565, "d": 0.24}, {"w": "chứng", "t": 41.805, "d": 0.245}, {"w": "chắc", "t": 42.05, "d": 0.175}, {"w": "chắn", "t": 42.225, "d": 0.205}, {"w": "rằng", "t": 42.43, "d": 0.26}, {"w": "nó", "t": 42.69, "d": 0.22}, {"w": "kém.", "t": 42.91, "d": 0.255}]}, {"text": "Phán quyết cho lời buộc tội thứ ba: chưa đủ chứng cứ.", "start": 44.36, "end": 46.92, "words": [{"w": "Phán", "t": 44.415, "d": 0.18}, {"w": "quyết", "t": 44.595, "d": 0.17}, {"w": "cho", "t": 44.765, "d": 0.16}, {"w": "lời", "t": 44.925, "d": 0.14}, {"w": "buộc", "t": 45.065, "d": 0.155}, {"w": "tội", "t": 45.22, "d": 0.155}, {"w": "thứ", "t": 45.375, "d": 0.32}, {"w": "ba:", "t": 45.695, "d": 0.195}, {"w": "chưa", "t": 45.89, "d": 0.205}, {"w": "đủ", "t": 46.095, "d": 0.175}, {"w": "chứng", "t": 46.27, "d": 0.185}, {"w": "cứ.", "t": 46.455, "d": 0.245}]}, {"text": "Có thể có một bàn phím tốt hơn một chút.", "start": 47.24, "end": 49.32, "words": [{"w": "Có", "t": 47.24, "d": 0.1}, {"w": "thể", "t": 47.34, "d": 0.22}, {"w": "có", "t": 47.56, "d": 0.26}, {"w": "một", "t": 47.82, "d": 0.205}, {"w": "bàn", "t": 48.025, "d": 0.06}, {"w": "phím", "t": 48.085, "d": 0.235}, {"w": "tốt", "t": 48.32, "d": 0.14}, {"w": "hơn", "t": 48.46, "d": 0.28}, {"w": "một", "t": 48.74, "d": 0.175}, {"w": "chút.", "t": 48.915, "d": 0.215}]}, {"text": "Nhưng chưa ai chứng minh được nó tốt hơn tới mức đáng để cả thế giới học lại từ đầu.", "start": 49.64, "end": 53.32, "words": [{"w": "Nhưng", "t": 49.64, "d": 0.13}, {"w": "chưa", "t": 49.77, "d": 0.28}, {"w": "ai", "t": 50.05, "d": 0.17}, {"w": "chứng", "t": 50.22, "d": 0.155}, {"w": "minh", "t": 50.375, "d": 0.095}, {"w": "được", "t": 50.47, "d": 0.21}, {"w": "nó", "t": 50.68, "d": 0.145}, {"w": "tốt", "t": 50.825, "d": 0.245}, {"w": "hơn", "t": 51.07, "d": 0.16}, {"w": "tới", "t": 51.23, "d": 0.185}, {"w": "mức", "t": 51.415, "d": 0.065}, {"w": "đáng", "t": 51.48, "d": 0.275}, {"w": "để", "t": 51.755, "d": 0.17}, {"w": "cả", "t": 51.925, "d": 0.17}, {"w": "thế", "t": 52.095, "d": 0.06}, {"w": "giới", "t": 52.155, "d": 0.13}, {"w": "học", "t": 52.285, "d": 0.29}, {"w": "lại", "t": 52.575, "d": 0.2}, {"w": "từ", "t": 52.775, "d": 0.075}, {"w": "đầu.", "t": 52.85, "d": 0.3}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "date", "day": "HAI NHÀ KINH TẾ LẬT LẠI HỒ SƠ", "date": "1990", "t0": 0.0, "t1": 7.48, "dayAt": 0.15, "groupAt": [0.4]}, {"type": "ledger", "title": "NGƯỜI PHỤ TRÁCH THỬ NGHIỆM", "srcnote": "LIEBOWITZ & MARGOLIS · 1990", "rows": [{"k": "CHỨC VỤ", "v": "THIẾU TÁ HẢI QUÂN", "at": 9.92}], "total": {"k": "TÊN", "v": "AUGUST DVORAK", "at": 12.09}, "t0": 7.48, "t1": 13.76}, {"type": "slam", "text": "NGƯỜI CHẤM = NGƯỜI DỰ THI", "sub": "VÀ AI ĐƯỢC LUYỆN LẠI THÌ CŨNG GÕ NHANH LÊN", "subAt": 5, "t0": 13.76, "t1": 23.0, "at": 13.91, "fx": "zoom"}, {"type": "timeline", "items": [{"year": "1956", "text": "thử nghiệm khác: *không thấy Dvorak hơn*", "at": 23.0}, {"year": "phía Dvorak", "text": "cho rằng thử nghiệm ấy *thiên vị*", "at": 31.36}, {"year": "hai nhà kinh tế", "text": "*không nói* QWERTY tốt hơn", "at": 36.8}], "t0": 23.0, "t1": 40.32}, {"type": "kinetic", "items": [{"text": "HỌ CHỈ NÓI", "at": 40.32, "sm": true, "fx": "rise", "L": {"style": {"top": "437px", "fontSize": "54px"}}, "D": [{"kind": "frame", "style": {"top": "361px", "height": "296px", "width": "1276px", "left": "322px"}, "at": 40.02}]}, {"text": "CHƯA CÓ BẰNG CHỨNG NÓ KÉM", "at": 41.115, "acc": true, "fx": "sync", "wt": [41.115, 41.4, 41.565, 41.805, 42.69, 42.91], "t0": 40.32, "L": {"style": {"top": "508px", "fontSize": "72px"}}, "em": "CHỨNG"}], "t0": 40.32, "t1": 44.36, "lay": "frame"}, {"type": "broll", "vid": "v5", "veil": 0.5, "illus": "VIDEO MINH HỌA", "kin": [{"text": "PHÁN QUYẾT 3", "at": 44.36, "sm": true, "fx": "scramble"}, {"text": "CHƯA ĐỦ CHỨNG CỨ", "at": 45.89, "acc": true, "fx": "glitch", "em": "CHỨNG"}], "t0": 44.36, "t1": 49.64}, {"type": "kinetic", "items": [{"text": "TỐT HƠN MỘT CHÚT?", "at": 49.64, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "740px", "fontSize": "50px"}}, "D": [{"kind": "bar", "style": {"top": "740px", "height": "120px"}, "at": 49.39}]}, {"text": "CHƯA ĐÁNG ĐỂ CẢ THẾ GIỚI HỌC LẠI", "at": 50.04, "acc": true, "fx": "marker", "L": {"cls": "kC", "style": {"top": "805px", "fontSize": "58px"}}, "em": "CHƯA"}], "t0": 49.64, "t1": 54.54, "lay": "corner"}], "prog0": 0.63737, "prog1": 0.74369};
motion/hf/assets/long\mim-ai-khuon-mat\ch08\data.js:1:window.CASE = {"topic": "mim-ai-khuon-mat", "ch": "ch08", "dur": 72.78, "seed": 18775, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "PHẦN CUỐI", "t": "128 CON SỐ"}, "acc": ["khuôn", "mặt", "số", "trạm", "ngưỡng", "nhầm", "máy"], "lines": [{"text": "Hãy nhìn lại hành trình của tấm ảnh.", "start": 0.0, "end": 1.52, "words": [{"w": "Hãy", "t": 0.0, "d": 0.08}, {"w": "nhìn", "t": 0.08, "d": 0.28}, {"w": "lại", "t": 0.36, "d": 0.13}, {"w": "hành", "t": 0.49, "d": 0.095}, {"w": "trình", "t": 0.585, "d": 0.22}, {"w": "của", "t": 0.805, "d": 0.06}, {"w": "tấm", "t": 0.865, "d": 0.145}, {"w": "ảnh.", "t": 1.01, "d": 0.275}]}, {"text": "Trạm thứ nhất tìm khuôn mặt. Trạm thứ hai căn cho thẳng.", "start": 2.32, "end": 4.96, "words": [{"w": "Trạm", "t": 2.32, "d": 0.15}, {"w": "thứ", "t": 2.47, "d": 0.285}, {"w": "nhất", "t": 2.755, "d": 0.19}, {"w": "tìm", "t": 2.945, "d": 0.065}, {"w": "khuôn", "t": 3.01, "d": 0.3}, {"w": "mặt.", "t": 3.31, "d": 0.23}, {"w": "Trạm", "t": 3.54, "d": 0.22}, {"w": "thứ", "t": 3.76, "d": 0.16}, {"w": "hai", "t": 3.92, "d": 0.215}, {"w": "căn", "t": 4.135, "d": 0.145}, {"w": "cho", "t": 4.28, "d": 0.145}, {"w": "thẳng.", "t": 4.425, "d": 0.295}]}, {"text": "Trạm thứ ba biến nó thành một trăm hai mươi tám con số. Trạm thứ tư đo khoảng cách và quyết định.", "start": 5.28, "end": 9.76, "words": [{"w": "Trạm", "t": 5.28, "d": 0.15}, {"w": "thứ", "t": 5.43, "d": 0.26}, {"w": "ba", "t": 5.69, "d": 0.14}, {"w": "biến", "t": 5.83, "d": 0.15}, {"w": "nó", "t": 5.98, "d": 0.145}, {"w": "thành", "t": 6.125, "d": 0.235}, {"w": "một", "t": 6.36, "d": 0.24}, {"w": "trăm", "t": 6.6, "d": 0.245}, {"w": "hai", "t": 6.845, "d": 0.185}, {"w": "mươi", "t": 7.03, "d": 0.185}, {"w": "tám", "t": 7.215, "d": 0.055}, {"w": "con", "t": 7.27, "d": 0.31}, {"w": "số.", "t": 7.58, "d": 0.22}, {"w": "Trạm", "t": 7.8, "d": 0.27}, {"w": "thứ", "t": 8.07, "d": 0.145}, {"w": "tư", "t": 8.215, "d": 0.225}, {"w": "đo", "t": 8.44, "d": 0.19}, {"w": "khoảng", "t": 8.63, "d": 0.185}, {"w": "cách", "t": 8.815, "d": 0.185}, {"w": "và", "t": 9.0, "d": 0.06}, {"w": "quyết", "t": 9.06, "d": 0.285}, {"w": "định.", "t": 9.345, "d": 0.25}]}, {"text": "Không trạm nào hiểu bạn là ai.", "start": 10.76, "end": 12.92, "words": [{"w": "Không", "t": 10.76, "d": 0.26}, {"w": "trạm", "t": 11.02, "d": 0.405}, {"w": "nào", "t": 11.425, "d": 0.255}, {"w": "hiểu", "t": 11.68, "d": 0.33}, {"w": "bạn", "t": 12.01, "d": 0.195}, {"w": "là", "t": 12.205, "d": 0.275}, {"w": "ai.", "t": 12.48, "d": 0.43}]}, {"text": "Cỗ máy không biết bạn vui hay buồn, tốt hay xấu.", "start": 13.24, "end": 15.8, "words": [{"w": "Cỗ", "t": 13.24, "d": 0.27}, {"w": "máy", "t": 13.51, "d": 0.155}, {"w": "không", "t": 13.665, "d": 0.1}, {"w": "biết", "t": 13.765, "d": 0.265}, {"w": "bạn", "t": 14.03, "d": 0.18}, {"w": "vui", "t": 14.21, "d": 0.165}, {"w": "hay", "t": 14.375, "d": 0.295}, {"w": "buồn,", "t": 14.67, "d": 0.195}, {"w": "tốt", "t": 14.865, "d": 0.245}, {"w": "hay", "t": 15.11, "d": 0.195}, {"w": "xấu.", "t": 15.305, "d": 0.285}]}, {"text": "Nó chỉ biết hai dãy số gần nhau tới đâu.", "start": 16.12, "end": 18.28, "words": [{"w": "Nó", "t": 16.12, "d": 0.12}, {"w": "chỉ", "t": 16.24, "d": 0.32}, {"w": "biết", "t": 16.56, "d": 0.175}, {"w": "hai", "t": 16.735, "d": 0.055}, {"w": "dãy", "t": 16.79, "d": 0.245}, {"w": "số", "t": 17.035, "d": 0.18}, {"w": "gần", "t": 17.215, "d": 0.165}, {"w": "nhau", "t": 17.38, "d": 0.125}, {"w": "tới", "t": 17.505, "d": 0.24}, {"w": "đâu.", "t": 17.745, "d": 0.32}]}, {"text": "Điều ấy vừa là sức mạnh, vừa là giới hạn của nó.", "start": 19.28, "end": 21.84, "words": [{"w": "Điều", "t": 19.425, "d": 0.24}, {"w": "ấy", "t": 19.665, "d": 0.065}, {"w": "vừa", "t": 19.73, "d": 0.275}, {"w": "là", "t": 20.005, "d": 0.11}, {"w": "sức", "t": 20.115, "d": 0.23}, {"w": "mạnh,", "t": 20.345, "d": 0.205}, {"w": "vừa", "t": 20.55, "d": 0.09}, {"w": "là", "t": 20.64, "d": 0.28}, {"w": "giới", "t": 20.92, "d": 0.165}, {"w": "hạn", "t": 21.085, "d": 0.2}, {"w": "của", "t": 21.285, "d": 0.12}, {"w": "nó.", "t": 21.405, "d": 0.265}]}, {"text": "Sức mạnh, vì nó nhanh và chính xác hơn con người rất nhiều, ở hầu hết các lần thử.", "start": 22.16, "end": 26.32, "words": [{"w": "Sức", "t": 22.16, "d": 0.27}, {"w": "mạnh,", "t": 22.43, "d": 0.275}, {"w": "vì", "t": 22.705, "d": 0.07}, {"w": "nó", "t": 22.775, "d": 0.23}, {"w": "nhanh", "t": 23.005, "d": 0.15}, {"w": "và", "t": 23.155, "d": 0.325}, {"w": "chính", "t": 23.48, "d": 0.17}, {"w": "xác", "t": 23.65, "d": 0.165}, {"w": "hơn", "t": 23.815, "d": 0.21}, {"w": "con", "t": 24.025, "d": 0.115}, {"w": "người", "t": 24.14, "d": 0.33}, {"w": "rất", "t": 24.47, "d": 0.055}, {"w": "nhiều,", "t": 24.525, "d": 0.44}, {"w": "ở", "t": 24.965, "d": 0.06}, {"w": "hầu", "t": 25.025, "d": 0.175}, {"w": "hết", "t": 25.2, "d": 0.345}, {"w": "các", "t": 25.545, "d": 0.085}, {"w": "lần", "t": 25.63, "d": 0.145}, {"w": "thử.", "t": 25.775, "d": 0.385}]}, {"text": "Giới hạn, vì khi nó sai, nó sai một cách rất tự tin, và người đứng sau màn hình có thể không biết.", "start": 26.64, "end": 32.0, "words": [{"w": "Giới", "t": 26.78, "d": 0.28}, {"w": "hạn,", "t": 27.06, "d": 0.31}, {"w": "vì", "t": 27.37, "d": 0.06}, {"w": "khi", "t": 27.43, "d": 0.225}, {"w": "nó", "t": 27.655, "d": 0.3}, {"w": "sai,", "t": 27.955, "d": 0.33}, {"w": "nó", "t": 28.285, "d": 0.12}, {"w": "sai", "t": 28.405, "d": 0.215}, {"w": "một", "t": 28.62, "d": 0.18}, {"w": "cách", "t": 28.8, "d": 0.225}, {"w": "rất", "t": 29.025, "d": 0.14}, {"w": "tự", "t": 29.165, "d": 0.195}, {"w": "tin,", "t": 29.36, "d": 0.425}, {"w": "và", "t": 29.785, "d": 0.2}, {"w": "người", "t": 29.985, "d": 0.055}, {"w": "đứng", "t": 30.04, "d": 0.26}, {"w": "sau", "t": 30.3, "d": 0.165}, {"w": "màn", "t": 30.465, "d": 0.225}, {"w": "hình", "t": 30.69, "d": 0.11}, {"w": "có", "t": 30.8, "d": 0.355}, {"w": "thể", "t": 31.155, "d": 0.115}, {"w": "không", "t": 31.27, "d": 0.18}, {"w": "biết.", "t": 31.45, "d": 0.35}]}, {"text": "Lần tới khi đưa khuôn mặt vào khung bầu dục trên điện thoại, bạn sẽ biết cỗ máy đang làm gì.", "start": 33.0, "end": 37.4, "words": [{"w": "Lần", "t": 33.0, "d": 0.13}, {"w": "tới", "t": 33.13, "d": 0.195}, {"w": "khi", "t": 33.325, "d": 0.28}, {"w": "đưa", "t": 33.605, "d": 0.165}, {"w": "khuôn", "t": 33.77, "d": 0.18}, {"w": "mặt", "t": 33.95, "d": 0.215}, {"w": "vào", "t": 34.165, "d": 0.185}, {"w": "khung", "t": 34.35, "d": 0.205}, {"w": "bầu", "t": 34.555, "d": 0.225}, {"w": "dục", "t": 34.78, "d": 0.06}, {"w": "trên", "t": 34.84, "d": 0.27}, {"w": "điện", "t": 35.11, "d": 0.235}, {"w": "thoại,", "t": 35.345, "d": 0.28}, {"w": "bạn", "t": 35.625, "d": 0.06}, {"w": "sẽ", "t": 35.685, "d": 0.175}, {"w": "biết", "t": 35.86, "d": 0.355}, {"w": "cỗ", "t": 36.215, "d": 0.06}, {"w": "máy", "t": 36.275, "d": 0.23}, {"w": "đang", "t": 36.505, "d": 0.23}, {"w": "làm", "t": 36.735, "d": 0.11}, {"w": "gì.", "t": 36.845, "d": 0.35}]}, {"text": "Nó không nhìn bạn. Nó đang đo một khoảng cách.", "start": 37.72, "end": 40.12, "words": [{"w": "Nó", "t": 37.72, "d": 0.105}, {"w": "không", "t": 37.825, "d": 0.32}, {"w": "nhìn", "t": 38.145, "d": 0.25}, {"w": "bạn.", "t": 38.395, "d": 0.32}, {"w": "Nó", "t": 38.715, "d": 0.06}, {"w": "đang", "t": 38.775, "d": 0.19}, {"w": "đo", "t": 38.965, "d": 0.17}, {"w": "một", "t": 39.135, "d": 0.3}, {"w": "khoảng", "t": 39.435, "d": 0.15}, {"w": "cách.", "t": 39.585, "d": 0.355}]}, {"text": "Và ở đâu đó, có một con người đã chọn: gần tới mức nào thì đủ.", "start": 40.44, "end": 44.04, "words": [{"w": "Và", "t": 40.455, "d": 0.21}, {"w": "ở", "t": 40.665, "d": 0.115}, {"w": "đâu", "t": 40.78, "d": 0.33}, {"w": "đó,", "t": 41.11, "d": 0.295}, {"w": "có", "t": 41.405, "d": 0.065}, {"w": "một", "t": 41.47, "d": 0.25}, {"w": "con", "t": 41.72, "d": 0.105}, {"w": "người", "t": 41.825, "d": 0.245}, {"w": "đã", "t": 42.07, "d": 0.165}, {"w": "chọn:", "t": 42.235, "d": 0.365}, {"w": "gần", "t": 42.6, "d": 0.11}, {"w": "tới", "t": 42.71, "d": 0.33}, {"w": "mức", "t": 43.04, "d": 0.12}, {"w": "nào", "t": 43.16, "d": 0.145}, {"w": "thì", "t": 43.305, "d": 0.3}, {"w": "đủ.", "t": 43.605, "d": 0.255}]}, {"text": "Bạn thấy yên tâm hơn, hay lo hơn, khi biết khuôn mặt mình chỉ là một dãy số trong máy?", "start": 45.04, "end": 49.28, "words": [{"w": "Bạn", "t": 45.04, "d": 0.21}, {"w": "thấy", "t": 45.25, "d": 0.175}, {"w": "yên", "t": 45.425, "d": 0.09}, {"w": "tâm", "t": 45.515, "d": 0.34}, {"w": "hơn,", "t": 45.855, "d": 0.175}, {"w": "hay", "t": 46.03, "d": 0.2}, {"w": "lo", "t": 46.23, "d": 0.22}, {"w": "hơn,", "t": 46.45, "d": 0.365}, {"w": "khi", "t": 46.815, "d": 0.115}, {"w": "biết", "t": 46.93, "d": 0.09}, {"w": "khuôn", "t": 47.02, "d": 0.265}, {"w": "mặt", "t": 47.285, "d": 0.145}, {"w": "mình", "t": 47.43, "d": 0.175}, {"w": "chỉ", "t": 47.605, "d": 0.21}, {"w": "là", "t": 47.815, "d": 0.29}, {"w": "một", "t": 48.105, "d": 0.145}, {"w": "dãy", "t": 48.25, "d": 0.19}, {"w": "số", "t": 48.44, "d": 0.06}, {"w": "trong", "t": 48.5, "d": 0.19}, {"w": "máy?", "t": 48.69, "d": 0.375}]}, {"text": "Kể cho mình nghe ở phần bình luận nhé.", "start": 49.88, "end": 51.56, "words": [{"w": "Kể", "t": 49.88, "d": 0.12}, {"w": "cho", "t": 50.0, "d": 0.115}, {"w": "mình", "t": 50.115, "d": 0.15}, {"w": "nghe", "t": 50.265, "d": 0.285}, {"w": "ở", "t": 50.55, "d": 0.11}, {"w": "phần", "t": 50.66, "d": 0.195}, {"w": "bình", "t": 50.855, "d": 0.155}, {"w": "luận", "t": 51.01, "d": 0.06}, {"w": "nhé.", "t": 51.07, "d": 0.275}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "8", "k": "PHẦN CUỐI", "title": "MỘT TRĂM HAI MƯƠI\nTÁM CON SỐ", "sub": "NHÌN LẠI HÀNH TRÌNH", "vid": "v0", "ms": 14, "illus": "VIDEO MINH HỌA", "titleAt": 0.0, "t0": 0.0, "t1": 2.32}, {"type": "timeline", "items": [{"year": "TRẠM 1", "text": "tìm khuôn mặt", "at": 2.32}, {"year": "TRẠM 2", "text": "căn cho thẳng", "at": 3.54}, {"year": "TRẠM 3", "text": "128 con số", "at": 5.28}, {"year": "TRẠM 4", "text": "đo khoảng cách", "at": 7.8}], "t0": 2.32, "t1": 10.76}, {"type": "kinetic", "items": [{"text": "4 TRẠM · 0 TRẠM HIỂU BẠN", "at": 10.76, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "86px", "left": "140px"}}, "em": "4"}, {"text": "chỉ biết hai dãy số gần nhau tới đâu", "at": 16.12, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "383px", "fontSize": "51px", "left": "310px"}}}], "t0": 10.76, "t1": 19.28, "lay": "ladder"}, {"type": "ledger", "title": "VỪA LÀ", "rows": [{"k": "SỨC MẠNH", "v": "NHANH · CHÍNH XÁC HƠN NGƯỜI", "at": 22.16}, {"k": "GIỚI HẠN", "v": "SAI MÀ VẪN RẤT TỰ TIN", "at": 26.64}], "t0": 19.28, "t1": 33.0}, {"type": "broll", "vid": "v4", "ms": 20, "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "NÓ KHÔNG NHÌN BẠN", "at": 37.72, "sm": true, "fx": "rise"}, {"text": "NÓ ĐANG ĐO MỘT KHOẢNG CÁCH", "at": 38.715, "acc": true, "fx": "marker", "em": "KHOẢNG"}, {"text": "một con người đã chọn: gần tới mức nào thì đủ", "at": 40.44, "sm": true, "fx": "blur"}], "t0": 33.0, "t1": 45.04}, {"type": "question", "text": "Yên tâm hơn, hay lo hơn,\nkhi khuôn mặt chỉ là một dãy số?", "t0": 45.04, "t1": 49.88}, {"type": "kinetic", "items": [{"text": "YÊN TÂM · HAY LO?", "at": 49.88, "fx": "blur", "L": {"cls": "kL", "style": {"top": "434px", "fontSize": "60px"}}, "D": [{"kind": "split", "style": {}, "at": 49.58}]}, {"text": "VIẾT XUỐNG BÌNH LUẬN", "at": 50.55, "acc": true, "fx": "flicker", "L": {"cls": "kR", "style": {"top": "439px", "fontSize": "51px"}}, "em": "XUỐNG"}], "t0": 49.88, "t1": 52.78, "lay": "split"}, {"type": "endcard", "t0": 52.78, "t1": 72.78, "bg": null, "sub": null}], "prog0": 0.89755, "prog1": 1.0};
motion/hf/assets/long\mim-ke-huy-diet-petrov\ch06\data.js:1:window.CASE = {"topic": "mim-ke-huy-diet-petrov", "ch": "ch06", "dur": 137.5, "seed": 32828, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 06", "t": "CON CHIP BỐN MƯƠI SÁU XU"}, "acc": ["báo", "máy", "phóng", "mây", "người", "ghế", "chưa", "tấn"], "lines": [{"text": "Ngày 3 tháng 6 năm 1980.", "start": 0.0, "end": 2.0, "words": [{"w": "Ngày", "t": 0.055, "d": 0.155}, {"w": "3", "t": 0.21, "d": 0.155}, {"w": "tháng", "t": 0.365, "d": 0.155}, {"w": "6", "t": 0.52, "d": 0.19}, {"w": "năm", "t": 0.71, "d": 0.115}, {"w": "1980.", "t": 0.825, "d": 0.96}]}, {"text": "Máy tính của NORAD đều đặn gửi bản tin cho các bộ chỉ huy, báo số tên lửa đối phương vừa phóng.", "start": 2.8, "end": 7.68, "words": [{"w": "Máy", "t": 2.855, "d": 0.28}, {"w": "tính", "t": 3.135, "d": 0.15}, {"w": "của", "t": 3.285, "d": 0.22}, {"w": "NORAD", "t": 3.505, "d": 0.165}, {"w": "đều", "t": 3.67, "d": 0.215}, {"w": "đặn", "t": 3.885, "d": 0.125}, {"w": "gửi", "t": 4.01, "d": 0.25}, {"w": "bản", "t": 4.26, "d": 0.19}, {"w": "tin", "t": 4.45, "d": 0.215}, {"w": "cho", "t": 4.665, "d": 0.12}, {"w": "các", "t": 4.785, "d": 0.325}, {"w": "bộ", "t": 5.11, "d": 0.18}, {"w": "chỉ", "t": 5.29, "d": 0.225}, {"w": "huy,", "t": 5.515, "d": 0.24}, {"w": "báo", "t": 5.755, "d": 0.13}, {"w": "số", "t": 5.885, "d": 0.32}, {"w": "tên", "t": 6.205, "d": 0.175}, {"w": "lửa", "t": 6.38, "d": 0.13}, {"w": "đối", "t": 6.51, "d": 0.23}, {"w": "phương", "t": 6.74, "d": 0.18}, {"w": "vừa", "t": 6.92, "d": 0.3}, {"w": "phóng.", "t": 7.22, "d": 0.235}]}, {"text": "Ngày thường, con số ấy là ba số không.", "start": 8.0, "end": 10.0, "words": [{"w": "Ngày", "t": 8.0, "d": 0.125}, {"w": "thường,", "t": 8.125, "d": 0.415}, {"w": "con", "t": 8.54, "d": 0.1}, {"w": "số", "t": 8.64, "d": 0.185}, {"w": "ấy", "t": 8.825, "d": 0.145}, {"w": "là", "t": 8.97, "d": 0.185}, {"w": "ba", "t": 9.155, "d": 0.16}, {"w": "số", "t": 9.315, "d": 0.16}, {"w": "không.", "t": 9.475, "d": 0.36}]}, {"text": "Hôm ấy, vài số không tự biến thành số hai.", "start": 10.32, "end": 12.8, "words": [{"w": "Hôm", "t": 10.37, "d": 0.275}, {"w": "ấy,", "t": 10.645, "d": 0.245}, {"w": "vài", "t": 10.89, "d": 0.09}, {"w": "số", "t": 10.98, "d": 0.29}, {"w": "không", "t": 11.27, "d": 0.15}, {"w": "tự", "t": 11.42, "d": 0.215}, {"w": "biến", "t": 11.635, "d": 0.155}, {"w": "thành", "t": 11.79, "d": 0.22}, {"w": "số", "t": 12.01, "d": 0.195}, {"w": "hai.", "t": 12.205, "d": 0.345}]}, {"text": "Thành không không hai, rồi hai trăm.", "start": 13.12, "end": 14.96, "words": [{"w": "Thành", "t": 13.12, "d": 0.24}, {"w": "không", "t": 13.36, "d": 0.145}, {"w": "không", "t": 13.505, "d": 0.29}, {"w": "hai,", "t": 13.795, "d": 0.205}, {"w": "rồi", "t": 14.0, "d": 0.14}, {"w": "hai", "t": 14.14, "d": 0.27}, {"w": "trăm.", "t": 14.41, "d": 0.335}]}, {"text": "Bản tin báo hai trăm tên lửa phóng từ tàu ngầm.", "start": 15.28, "end": 17.92, "words": [{"w": "Bản", "t": 15.285, "d": 0.135}, {"w": "tin", "t": 15.42, "d": 0.325}, {"w": "báo", "t": 15.745, "d": 0.16}, {"w": "hai", "t": 15.905, "d": 0.17}, {"w": "trăm", "t": 16.075, "d": 0.145}, {"w": "tên", "t": 16.22, "d": 0.385}, {"w": "lửa", "t": 16.605, "d": 0.12}, {"w": "phóng", "t": 16.725, "d": 0.115}, {"w": "từ", "t": 16.84, "d": 0.31}, {"w": "tàu", "t": 17.15, "d": 0.215}, {"w": "ngầm.", "t": 17.365, "d": 0.31}]}, {"text": "Bộ chỉ huy Không quân Chiến lược làm đúng quy trình.", "start": 18.92, "end": 21.64, "words": [{"w": "Bộ", "t": 18.92, "d": 0.14}, {"w": "chỉ", "t": 19.06, "d": 0.36}, {"w": "huy", "t": 19.42, "d": 0.19}, {"w": "Không", "t": 19.61, "d": 0.16}, {"w": "quân", "t": 19.77, "d": 0.155}, {"w": "Chiến", "t": 19.925, "d": 0.355}, {"w": "lược", "t": 20.28, "d": 0.14}, {"w": "làm", "t": 20.42, "d": 0.315}, {"w": "đúng", "t": 20.735, "d": 0.16}, {"w": "quy", "t": 20.895, "d": 0.205}, {"w": "trình.", "t": 21.1, "d": 0.32}]}, {"text": "Tổ lái chạy ra máy bay ném bom và máy bay tiếp dầu, rồi nổ máy.", "start": 21.96, "end": 25.72, "words": [{"w": "Tổ", "t": 21.995, "d": 0.145}, {"w": "lái", "t": 22.14, "d": 0.21}, {"w": "chạy", "t": 22.35, "d": 0.17}, {"w": "ra", "t": 22.52, "d": 0.24}, {"w": "máy", "t": 22.76, "d": 0.2}, {"w": "bay", "t": 22.96, "d": 0.295}, {"w": "ném", "t": 23.255, "d": 0.26}, {"w": "bom", "t": 23.515, "d": 0.095}, {"w": "và", "t": 23.61, "d": 0.23}, {"w": "máy", "t": 23.84, "d": 0.15}, {"w": "bay", "t": 23.99, "d": 0.165}, {"w": "tiếp", "t": 24.155, "d": 0.385}, {"w": "dầu,", "t": 24.54, "d": 0.305}, {"w": "rồi", "t": 24.845, "d": 0.06}, {"w": "nổ", "t": 24.905, "d": 0.37}, {"w": "máy.", "t": 25.275, "d": 0.245}]}, {"text": "Sở chỉ huy bay của Tổng thống lăn bánh tới vị trí cất cánh.", "start": 26.04, "end": 29.16, "words": [{"w": "Sở", "t": 26.04, "d": 0.115}, {"w": "chỉ", "t": 26.155, "d": 0.375}, {"w": "huy", "t": 26.53, "d": 0.2}, {"w": "bay", "t": 26.73, "d": 0.2}, {"w": "của", "t": 26.93, "d": 0.17}, {"w": "Tổng", "t": 27.1, "d": 0.235}, {"w": "thống", "t": 27.335, "d": 0.145}, {"w": "lăn", "t": 27.48, "d": 0.105}, {"w": "bánh", "t": 27.585, "d": 0.315}, {"w": "tới", "t": 27.9, "d": 0.21}, {"w": "vị", "t": 28.11, "d": 0.145}, {"w": "trí", "t": 28.255, "d": 0.16}, {"w": "cất", "t": 28.415, "d": 0.33}, {"w": "cánh.", "t": 28.745, "d": 0.245}]}, {"text": "Rồi người ta dừng lại.", "start": 29.48, "end": 31.8, "words": [{"w": "Rồi", "t": 29.48, "d": 0.245}, {"w": "người", "t": 29.725, "d": 0.64}, {"w": "ta", "t": 30.365, "d": 0.175}, {"w": "dừng", "t": 30.54, "d": 0.53}, {"w": "lại.", "t": 31.07, "d": 0.555}]}, {"text": "Vì sao?", "start": 32.12, "end": 32.6, "words": [{"w": "Vì", "t": 32.12, "d": 0.065}, {"w": "sao?", "t": 32.185, "d": 0.24}]}, {"text": "Vì các vệ tinh và radar cảnh báo, những con mắt độc lập, không thấy gì bất thường.", "start": 33.6, "end": 37.76, "words": [{"w": "Vì", "t": 33.6, "d"