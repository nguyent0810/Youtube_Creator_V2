, {"w": "có", "t": 56.105, "d": 0.15}, {"w": "chữ", "t": 56.255, "d": 0.175}, {"w": "miễn", "t": 56.43, "d": 0.235}, {"w": "phí.", "t": 56.665, "d": 0.235}]}, {"text": "Và Reagan cũng không phát minh ra GPS.", "start": 57.4, "end": 59.48, "words": [{"w": "Và", "t": 57.4, "d": 0.095}, {"w": "Reagan", "t": 57.495, "d": 0.34}, {"w": "cũng", "t": 57.835, "d": 0.165}, {"w": "không", "t": 58.0, "d": 0.06}, {"w": "phát", "t": 58.06, "d": 0.3}, {"w": "minh", "t": 58.36, "d": 0.2}, {"w": "ra", "t": 58.56, "d": 0.15}, {"w": "GPS.", "t": 58.71, "d": 0.605}]}, {"text": "Chương trình GPS được duyệt từ năm 1973.", "start": 60.48, "end": 63.36, "words": [{"w": "Chương", "t": 60.48, "d": 0.13}, {"w": "trình", "t": 60.61, "d": 0.255}, {"w": "GPS", "t": 60.865, "d": 0.485}, {"w": "được", "t": 61.35, "d": 0.055}, {"w": "duyệt", "t": 61.405, "d": 0.195}, {"w": "từ", "t": 61.6, "d": 0.22}, {"w": "năm", "t": 61.82, "d": 0.06}, {"w": "1973.", "t": 61.88, "d": 1.275}]}, {"text": "Vệ tinh thử nghiệm đầu tiên được phóng ngày 22 tháng 2 năm 1978.", "start": 63.68, "end": 68.16, "words": [{"w": "Vệ", "t": 63.71, "d": 0.22}, {"w": "tinh", "t": 63.93, "d": 0.155}, {"w": "thử", "t": 64.085, "d": 0.26}, {"w": "nghiệm", "t": 64.345, "d": 0.06}, {"w": "đầu", "t": 64.405, "d": 0.2}, {"w": "tiên", "t": 64.605, "d": 0.3}, {"w": "được", "t": 64.905, "d": 0.06}, {"w": "phóng", "t": 64.965, "d": 0.17}, {"w": "ngày", "t": 65.135, "d": 0.25}, {"w": "22", "t": 65.385, "d": 0.64}, {"w": "tháng", "t": 66.025, "d": 0.185}, {"w": "2", "t": 66.21, "d": 0.185}, {"w": "năm", "t": 66.395, "d": 0.14}, {"w": "1978.", "t": 66.535, "d": 1.39}]}, {"text": "Năm 1983, hệ thống vẫn còn dang dở.", "start": 68.48, "end": 71.52, "words": [{"w": "Năm", "t": 68.48, "d": 0.25}, {"w": "1983,", "t": 68.73, "d": 1.415}, {"w": "hệ", "t": 70.145, "d": 0.06}, {"w": "thống", "t": 70.205, "d": 0.35}, {"w": "vẫn", "t": 70.555, "d": 0.185}, {"w": "còn", "t": 70.74, "d": 0.19}, {"w": "dang", "t": 70.93, "d": 0.19}, {"w": "dở.", "t": 71.12, "d": 0.225}]}, {"text": "Lời hứa hẹn năm năm nữa.", "start": 71.84, "end": 73.2, "words": [{"w": "Lời", "t": 71.85, "d": 0.175}, {"w": "hứa", "t": 72.025, "d": 0.185}, {"w": "hẹn", "t": 72.21, "d": 0.18}, {"w": "năm", "t": 72.39, "d": 0.07}, {"w": "năm", "t": 72.46, "d": 0.275}, {"w": "nữa.", "t": 72.735, "d": 0.255}]}, {"text": "Thứ Reagan quyết định là mở một hệ thống quân sự cho máy bay chở dân thường.", "start": 73.52, "end": 77.92, "words": [{"w": "Thứ", "t": 73.56, "d": 0.355}, {"w": "Reagan", "t": 73.915, "d": 0.185}, {"w": "quyết", "t": 74.1, "d": 0.315}, {"w": "định", "t": 74.415, "d": 0.06}, {"w": "là", "t": 74.475, "d": 0.425}, {"w": "mở", "t": 74.9, "d": 0.17}, {"w": "một", "t": 75.07, "d": 0.165}, {"w": "hệ", "t": 75.235, "d": 0.2}, {"w": "thống", "t": 75.435, "d": 0.44}, {"w": "quân", "t": 75.875, "d": 0.145}, {"w": "sự", "t": 76.02, "d": 0.375}, {"w": "cho", "t": 76.395, "d": 0.195}, {"w": "máy", "t": 76.59, "d": 0.135}, {"w": "bay", "t": 76.725, "d": 0.415}, {"w": "chở", "t": 77.14, "d": 0.185}, {"w": "dân", "t": 77.325, "d": 0.19}, {"w": "thường.", "t": 77.515, "d": 0.41}]}, {"text": "Giờ thì bạn hiểu vì sao chấm xanh trên Google Maps lại dính tới một buổi sáng ở Sakhalin.", "start": 78.92, "end": 83.8, "words": [{"w": "Giờ", "t": 78.99, "d": 0.2}, {"w": "thì", "t": 79.19, "d": 0.34}, {"w": "bạn", "t": 79.53, "d": 0.125}, {"w": "hiểu", "t": 79.655, "d": 0.245}, {"w": "vì", "t": 79.9, "d": 0.22}, {"w": "sao", "t": 80.12, "d": 0.17}, {"w": "chấm", "t": 80.29, "d": 0.3}, {"w": "xanh", "t": 80.59, "d": 0.365}, {"w": "trên", "t": 80.955, "d": 0.1}, {"w": "Google", "t": 81.055, "d": 0.265}, {"w": "Maps", "t": 81.32, "d": 0.145}, {"w": "lại", "t": 81.465, "d": 0.285}, {"w": "dính", "t": 81.75, "d": 0.33}, {"w": "tới", "t": 82.08, "d": 0.165}, {"w": "một", "t": 82.245, "d": 0.32}, {"w": "buổi", "t": 82.565, "d": 0.24}, {"w": "sáng", "t": 82.805, "d": 0.185}, {"w": "ở", "t": 82.99, "d": 0.225}, {"w": "Sakhalin.", "t": 83.215, "d": 0.355}]}, {"text": "Nhưng l