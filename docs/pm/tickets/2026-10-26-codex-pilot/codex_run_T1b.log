motion/hf/assets/long\mim-alphago-lee-sedol\ch14\data.js:1:window.CASE = {"topic": "mim-alphago-lee-sedol", "ch": "ch14", "dur": 85.98, "seed": 29506, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 14", "t": "MỘT PHẦN MƯỜI NGHÌN"}, "acc": ["alphago", "sedol", "nước", "thua", "thắng", "vạn", "nghìn", "máy"], "lines": [{"text": "Trong các trận đấu chính thức mà AlphaGo từng đánh, nó chỉ thua con người đúng một ván.", "start": 0.0, "end": 4.48, "words": [{"w": "Trong", "t": 0.0, "d": 0.23}, {"w": "các", "t": 0.23, "d": 0.125}, {"w": "trận", "t": 0.355, "d": 0.245}, {"w": "đấu", "t": 0.6, "d": 0.33}, {"w": "chính", "t": 0.93, "d": 0.19}, {"w": "thức", "t": 1.12, "d": 0.06}, {"w": "mà", "t": 1.18, "d": 0.38}, {"w": "AlphaGo", "t": 1.56, "d": 0.42}, {"w": "từng", "t": 1.98, "d": 0.16}, {"w": "đánh,", "t": 2.14, "d": 0.39}, {"w": "nó", "t": 2.53, "d": 0.105}, {"w": "chỉ", "t": 2.635, "d": 0.255}, {"w": "thua", "t": 2.89, "d": 0.18}, {"w": "con", "t": 3.07, "d": 0.24}, {"w": "người", "t": 3.31, "d": 0.11}, {"w": "đúng", "t": 3.42, "d": 0.265}, {"w": "một", "t": 3.685, "d": 0.315}, {"w": "ván.", "t": 4.0, "d": 0.25}]}, {"text": "Ván thứ tư, ở Seoul, với nước bảy mươi tám.", "start": 5.28, "end": 7.84, "words": [{"w": "Ván", "t": 5.28, "d": 0.11}, {"w": "thứ", "t": 5.39, "d": 0.375}, {"w": "tư,", "t": 5.765, "d": 0.215}, {"w": "ở", "t": 5.98, "d": 0.23}, {"w": "Seoul,", "t": 6.21, "d": 0.4}, {"w": "với", "t": 6.61, "d": 0.17}, {"w": "nước", "t": 6.78, "d": 0.06}, {"w": "bảy", "t": 6.84, "d": 0.305}, {"w": "mươi", "t": 7.145, "d": 0.185}, {"w": "tám.", "t": 7.33, "d": 0.325}]}, {"text": "Người ta hay kể trận này như ngày con người thua máy.", "start": 8.84, "end": 11.4, "words": [{"w": "Người", "t": 8.84, "d": 0.27}, {"w": "ta", "t": 9.11, "d": 0.165}, {"w": "hay", "t": 9.275, "d": 0.21}, {"w": "kể", "t": 9.485, "d": 0.11}, {"w": "trận", "t": 9.595, "d": 0.275}, {"w": "này", "t": 9.87, "d": 0.15}, {"w": "như", "t": 10.02, "d": 0.11}, {"w": "ngày", "t": 10.13, "d": 0.31}, {"w": "con", "t": 10.44, "d": 0.14}, {"w": "người", "t": 10.58, "d": 0.24}, {"w": "thua", "t": 10.82, "d": 0.06}, {"w": "máy.", "t": 10.88, "d": 0.355}]}, {"text": "Nhưng hãy nhìn lại hai nước cờ một phần vạn.", "start": 11.72, "end": 13.72, "words": [{"w": "Nhưng", "t": 11.82, "d": 0.195}, {"w": "hãy", "t": 12.015, "d": 0.105}, {"w": "nhìn", "t": 12.12, "d": 0.18}, {"w": "lại", "t": 12.3, "d": 0.215}, {"w": "hai", "t": 12.515, "d": 0.135}, {"w": "nước", "t": 12.65, "d": 0.15}, {"w": "cờ", "t": 12.8, "d": 0.225}, {"w": "một", "t": 13.025, "d": 0.185}, {"w": "phần", "t": 13.21, "d": 0.165}, {"w": "vạn.", "t": 13.375, "d": 0.195}]}, {"text": "Nước ba mươi bảy cho thấy, máy có thể tìm ra thứ con người chưa từng nghĩ tới.", "start": 14.04, "end": 18.12, "words": [{"w": "Nước", "t": 14.095, "d": 0.135}, {"w": "ba", "t": 14.23, "d": 0.23}, {"w": "mươi", "t": 14.46, "d": 0.31}, {"w": "bảy", "t": 14.77, "d": 0.16}, {"w": "cho", "t": 14.93, "d": 0.235}, {"w": "thấy,", "t": 15.165, "d": 0.28}, {"w": "máy", "t": 15.445, "d": 0.075}, {"w": "có", "t": 15.52, "d": 0.25}, {"w": "thể", "t": 15.77, "d": 0.3}, {"w": "tìm", "t": 16.07, "d": 0.06}, {"w": "ra", "t": 16.13, "d": 0.205}, {"w": "thứ", "t": 16.335, "d": 0.215}, {"w": "con", "t": 16.55, "d": 0.205}, {"w": "người", "t": 16.755, "d": 0.13}, {"w": "chưa", "t": 16.885, "d": 0.31}, {"w": "từng", "t": 17.195, "d": 0.23}, {"w": "nghĩ", "t": 17.425, "d": 0.22}, {"w": "tới.", "t": 17.645, "d": 0.23}]}, {"text": "Nước bảy mươi tám cho thấy, con người vẫn có thể tìm ra thứ mà máy không ngờ.", "start": 18.44, "end": 22.28, "words": [{"w": "Nước", "t": 18.44, "d": 0.12}, {"w": "bảy", "t": 18.56, "d": 0.235}, {"w": "mươi", "t": 18.795, "d": 0.16}, {"w": "tám", "t": 18.955, "d": 0.325}, {"w": "cho", "t": 19.28, "d": 0.06}, {"w": "thấy,", "t": 19.34, "d": 0.44}, {"w": "con", "t": 19.78, 