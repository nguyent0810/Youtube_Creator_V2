15, "d": 0.325}]}, {"text": "Đến nước thứ một trăm tám mươi, trên màn hình của Aja Huang hiện lên một dòng chữ.", "start": 100.88, "end": 104.56, "words": [{"w": "Đến", "t": 100.92, "d": 0.25}, {"w": "nước", "t": 101.17, "d": 0.18}, {"w": "thứ", "t": 101.35, "d": 0.16}, {"w": "một", "t": 101.51, "d": 0.17}, {"w": "trăm", "t": 101.68, "d": 0.11}, {"w": "tám", "t": 101.79, "d": 0.27}, {"w": "mươi,", "t": 102.06, "d": 0.28}, {"w": "trên", "t": 102.34, "d": 0.055}, {"w": "màn", "t": 102.395, "d": 0.18}, {"w": "hình", "t": 102.575, "d": 0.165}, {"w": "của", "t": 102.74, "d": 0.205}, {"w": "Aja", "t": 102.945, "d": 0.28}, {"w": "Huang", "t": 103.225, "d": 0.15}, {"w": "hiện", "t": 103.375, "d": 0.21}, {"w": "lên", "t": 103.585, "d": 0.12}, {"w": "một", "t": 103.705, "d": 0.185}, {"w": "dòng", "t": 103.89, "d": 0.235}, {"w": "chữ.", "t": 104.125, "d": 0.21}]}, {"text": "AlphaGo xin thua.", "start": 104.88, "end": 105.92, "words": [{"w": "AlphaGo", "t": 104.885, "d": 0.31}, {"w": "xin", "t": 105.195, "d": 0.31}, {"w": "thua.", "t": 105.505, "d": 0.22}]}, {"text": "Phòng họp báo vỡ oà.", "start": 106.92, "end": 108.28, "words": [{"w": "Phòng", "t": 106.995, "d": 0.14}, {"w": "họp", "t": 107.135, "d": 0.165}, {"w": "báo", "t": 107.3, "d": 0.235}, {"w": "vỡ", "t": 107.535, "d": 0.19}, {"w": "oà.", "t": 107.725, "d": 0.24}]}, {"text": "Các nhà báo đứng dậy vỗ tay, hô tên ông.", "start": 108.6, "end": 111.0, "words": [{"w": "Các", "t": 108.6, "d": 0.245}, {"w": "nhà", "t": 108.845, "d": 0.22}, {"w": "báo", "t": 109.065, "d": 0.195}, {"w": "đứng", "t": 109.26, "d": 0.18}, {"w": "dậy", "t": 109.44, "d": 0.17}, {"w": "vỗ", "t": 109.61, "d": 0.23}, {"w": "tay,", "t": 109.84, "d": 0.31}, {"w": "hô", "t": 110.15, "d": 0.06}, {"w": "tên", "t": 110.21, "d": 0.255}, {"w": "ông.", "t": 110.465, "d": 0.305}]}, {"text": "Tỉ số: một, ba.", "start": 111.32, "end": 112.92, "words": [{"w": "Tỉ", "t": 111.32, "d": 0.225}, {"w": "số:", "t": 111.545, "d": 0.455}, {"w": "một,", "t": 112.0, "d": 0.4