5}, {"w": "việc", "t": 70.315, "d": 0.12}, {"w": "của", "t": 70.435, "d": 0.25}, {"w": "bạn,", "t": 70.685, "d": 0.29}, {"w": "phần", "t": 70.975, "d": 0.06}, {"w": "nào", "t": 71.035, "d": 0.15}, {"w": "là", "t": 71.185, "d": 0.34}, {"w": "thứ", "t": 71.525, "d": 0.06}, {"w": "đã", "t": 71.585, "d": 0.16}, {"w": "được", "t": 71.745, "d": 0.31}, {"w": "viết", "t": 72.055, "d": 0.135}, {"w": "sẵn", "t": 72.19, "d": 0.1}, {"w": "trong", "t": 72.29, "d": 0.22}, {"w": "sách?", "t": 72.51, "d": 0.335}]}, {"text": "Và phần nào, chỉ bạn mới biết, vì bạn đã làm nó đủ lâu?", "start": 73.64, "end": 76.84, "words": [{"w": "Và", "t": 73.745, "d": 0.155}, {"w": "phần", "t": 73.9, "d": 0.14}, {"w": "nào,", "t": 74.04, "d": 0.45}, {"w": "chỉ", "t": 74.49, "d": 0.06}, {"w": "bạn", "t": 74.55, "d": 0.3}, {"w": "mới", "t": 74.85, "d": 0.175}, {"w": "biết,", "t": 75.025, "d": 0.32}, {"w": "vì", "t": 75.345, "d": 0.145}, {"w": "bạn", "t": 75.49, "d": 0.065}, {"w": "đã", "t": 75.555, "d": 0.29}, {"w": "làm", "t": 75.845, "d": 0.09}, {"w": "nó", "t": 75.935, "d": 0.34}, {"w": "đủ", "t": 76.275, "d": 0.115}, {"w": "lâu?", "t": 76.39, "d": 0.295}]}], "imgs": {"langley51": {"src": "assets/long/mim-ai-jobs/img/langley51.jpg", "w": 1920, "h": 1469, "lic": "Public domain", "by": "NASA Langley Research Center / NACA, Bill Taub", "pd": true}, "x4": {"src": "assets/long/mim-ai-jobs/img/x4.jpg", "w": 1920, "h": 1499, "lic": "Public domain", "by": "NASA Langley Research Center / NACA Langley", "pd": true}, "langley43": {"src": "assets/long/mim-ai-jobs/img/langley43.jpg", "w": 1920, "h": 1502, "lic": "Public domain", "by": "NASA Langley Research Center / NACA Langley", "pd": true}, "ibm704": {"src": "assets/long/mim-ai-jobs/img/ibm704.jpg", "w": 1920, "h": 1521, "lic": "Public domain", "by": "NASA", "pd": true}, "jcards": {"src": "assets/long/mim-ai-jobs/img/jcards.jpg", "w": 1280, "h": 1707, "lic": "CC0", "by": "Robert-brook", "pd": true}, "jloom": {"src": "assets/long/mim-ai-jobs/img/jloom.jpg", "