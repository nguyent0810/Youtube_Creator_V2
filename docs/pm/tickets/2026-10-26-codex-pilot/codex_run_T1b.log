"d": 0.215}, {"w": "xu", "t": 74.795, "d": 0.27}, {"w": "hướng", "t": 75.065, "d": 0.105}, {"w": "dựa", "t": 75.17, "d": 0.13}, {"w": "dẫm", "t": 75.3, "d": 0.19}, {"w": "quá", "t": 75.49, "d": 0.375}, {"w": "mức", "t": 75.865, "d": 0.195}, {"w": "vào", "t": 76.06, "d": 0.185}, {"w": "kết", "t": 76.245, "d": 0.215}, {"w": "quả", "t": 76.46, "d": 0.14}, {"w": "của", "t": 76.6, "d": 0.17}, {"w": "máy.", "t": 76.77, "d": 0.325}]}, {"text": "Luật gọi tên nó: thiên kiến tự động hoá.", "start": 77.64, "end": 79.8, "words": [{"w": "Luật", "t": 77.64, "d": 0.275}, {"w": "gọi", "t": 77.915, "d": 0.105}, {"w": "tên", "t": 78.02, "d": 0.28}, {"w": "nó:", "t": 78.3, "d": 0.21}, {"w": "thiên", "t": 78.51, "d": 0.125}, {"w": "kiến", "t": 78.635, "d": 0.22}, {"w": "tự", "t": 78.855, "d": 0.19}, {"w": "động", "t": 79.045, "d": 0.28}, {"w": "hoá.", "t": 79.325, "d": 0.29}]}, {"text": "Người ấy phải có thể bỏ qua, ghi đè hoặc đảo ngược kết quả, và dừng hệ thống bằng một nút dừng.", "start": 80.12, "end": 84.84, "words": [{"w": "Người", "t": 80.12, "d": 0.27}, {"w": "ấy", "t": 80.39, "d": 0.185}, {"w": "phải", "t": 80.575, "d": 0.115}, {"w": "có", "t": 80.69, "d": 0.155}, {"w": "thể", "t": 80.845, "d": 0.215}, {"w": "bỏ", "t": 81.06, "d": 0.275}, {"w": "qua,", "t": 81.335, "d": 0.225}, {"w": "ghi", "t": 81.56, "d": 0.18}, {"w": "đè", "t": 81.74, "d": 0.215}, {"w": "hoặc", "t": 81.955, "d": 0.125}, {"w": "đảo", "t": 82.08, "d": 0.265}, {"w": "ngược", "t": 82.345, "d": 0.2}, {"w": "kết", "t": 82.545, "d": 0.155}, {"w": "quả,", "t": 82.7, "d": 0.385}, {"w": "và", "t": 83.085, "d": 0.15}, {"w": "dừng", "t": 83.235, "d": 0.065}, {"w": "hệ", "t": 83.3, "d": 0.19}, {"w": "thống", "t": 83.49, "d": 0.275}, {"w": "bằng", "t": 83.765, "d": 0.265}, {"w": "một", "t": 84.03, "d": 0.13}, {"w": "nút", "t": 84.16, "d": 0.185}, {"w": "dừng.", "t": 84.345, "d": 0.295}]}, {"text": "Đêm năm 1983, Petrov không có điều luật nào như thế.", "start": 85.84, "end": 90.08, "words": [{"w": "Đêm", "t": 85.885, "d": 0.23}, {"w": "năm", "t": 86.115, "d": 0.13}, {"w": "1983,", "t": 86.245, "d": 1.735}, {"w": "Petrov", "t": 87.98, "d": 0.06}, {"w": "không", "t": 88.04, "d": 0.255}, {"w": "có", "t": 88.295, "d": 0.18}, {"w": "điều", "t": 88.475, "d": 0.265}, {"w": "luật", "t": 88.74, "d": 0.105}, {"w": "nào", "t": 88.845, "d": 0.3}, {"w": "như", "t": 89.145, "d": 0.3}, {"w": "thế.", "t": 89.445, "d": 0.25}]}, {"text": "Bản hướng dẫn còn bảo ông làm điều ngược lại.", "start": 90.4, "end": 92.96, "words": [{"w": "Bản", "t": 90.4, "d": 0.23}, {"w": "hướng", "t": 90.63, "d": 0.195}, {"w": "dẫn", "t": 90.825, "d": 0.19}, {"w": "còn", "t": 91.015, "d": 0.27}, {"w": "bảo", "t": 91.285, "d": 0.405}, {"w": "ông", "t": 91.69, "d": 0.14}, {"w": "làm", "t": 91.83, "d": 0.36}, {"w": "điều", "t": 92.19, "d": 0.18}, {"w": "ngược", "t": 92.37, "d": 0.235}, {"w": "lại.", "t": 92.605, "d": 0.355}]}, {"text": "Ở video về Apollo 11, máy báo động, và người quyết định cho nó làm tiếp.", "start": 93.28, "end": 97.52, "words": [{"w": "Ở", "t": 93.375, "d": 0.2}, {"w": "video", "t": 93.575, "d": 0.125}, {"w": "về", "t": 93.7, "d": 0.27}, {"w": "Apollo", "t": 93.97, "d": 0.325}, {"w": "11,", "t": 94.295, "d": 0.56}, {"w": "máy", "t": 94.855, "d": 0.175}, {"w": "báo", "t": 95.03, "d": 0.12}, {"w": "động,", "t": 95.15, "d": 0.28}, {"w": "và", "t": 95.43, "d": 0.37}, {"w": "người", "t": 95.8, "d": 0.165}, {"w": "quyết", "t": 95.965, "d": 0.1}, {"w": "định", "t": 96.065, "d": 0.28}, {"w": "cho", "t": 96.345, "d": 0.305}, {"w": "nó", "t": 96.65, "d": 0.15}, {"w": "làm", "t": 96.8, "d": 0.295}, {"w": "tiếp.", "t": 97.095, "d": 0.25}]}, {"text": "Đêm ở Serpukhov là chiều ngược lại: máy nói chắc chắn, và người không tin.", "start": 97.84, "end": 101.84, "words": [{"w": "Đêm", "t": 97.91, "d": 0.27}, {"w": "ở", "t": 98.18, "d": 0.145}, {"w": "Serpukhov", "t": 98.325, "d": 0.315}, {"w": "là", "t": 98.64, "d": 0.21}, {"w": "chiều", "t": 98.85, "d": 0.185}, {"w": "ngược", "t": 99.035, "d": 0.14}, {"w": "lại:", "t": 99.175, "d": 0.525}, {"w": "máy", "t": 99.7, "d": 0.06}, {"w": "nói", "t": 99.76, "d": 0.4}, {"w": "chắc", "t": 100.16, "d": 0.17}, {"w": "chắn,", "t": 100.33, "d": 0.41}, {"w": "và", "t": 100.74, "d": 0.1}, {"w": "người", "t": 100.84, "d": 0.22}, {"w": "không", "t": 101.06, "d": 0.21}, {"w": "tin.", "t": 101.27, "d": 0.41}]}, {"text": "Giờ đến lượt bạn.", "start": 102.84, "end": 103.8, "words": [{"w": "Giờ", "t": 102.905, "d": 0.13}, {"w": "đến", "t": 103.035, "d": 0.12}, {"w": "lượt", "t": 103.155, "d": 0.145}, {"w": "bạn.", "t": 103.3, "d": 0.195}]}, {"text": "Bạn đã bấm nút báo lên ở mẩu tin thứ mấy, hay giữ nút chưa tới tận cuối?", "start": 104.12, "end": 107.8, "words": [{"w": "Bạn", "t": 104.12, "d": 0.2}, {"w": "đã", "t": 104.32, "d": 0.115}, {"w": "bấm", "t": 104.435, "d": 0.155}, {"w": "nút", "t": 104.59, "d": 0.325}, {"w": "báo", "t": 104.915, "d": 0.125}, {"w": "lên", "t": 105.04, "d": 0.235}, {"w": "ở", "t": 105.275, "d": 0.165}, {"w": "mẩu", "t": 105.44, "d": 0.12}, {"w": "tin", "t": 105.56, "d": 0.26}, {"w": "thứ", "t": 105.82, "d": 0.18}, {"w": "mấy,", "t": 106.0, "d": 0.155}, {"w": "hay", "t": 106.155, "d": 0.305}, {"w": "giữ", "t": 106.46, "d": 0.17}, {"w": "nút", "t": 106.63, "d": 0.195}, {"w": "chưa", "t": 106.825, "d": 0.06}, {"w": "tới", "t": 106.885, "d": 0.16}, {"w": "tận", "t": 107.045, "d": 0.325}, {"w": "cuối?", "t": 107.37, "d": 0.215}]}, {"text": "Ghi con số ấy vào phần bình luận, kèm một câu: điều gì làm bạn đổi ý.", "start": 108.4, "end": 111.84, "words": [{"w": "Ghi", "t": 108.4, "d": 0.205}, {"w": "con", "t": 108.605, "d": 0.06}, {"w": "số", "t": 108.665, "d": 0.29}, {"w": "ấy", "t": 108.955, "d": 0.14}, {"w": "vào", "t": 109.095, "d": 0.165}, {"w": "phần", "t": 109.26, "d": 0.1}, {"w": "bình", "t": 109.36, "d": 0.325}, {"w": "luận,", "t": 109.685, "d": 0.135}, {"w": "kèm", "t": 109.82, "d": 0.24}, {"w": "một", "t": 110.06, "d": 0.19}, {"w": "câu:", "t": 110.25, "d": 0.335}, {"w": "điều", "t": 110.585, "d": 0.06}, {"w": "gì", "t": 110.645, "d": 0.29}, {"w": "làm", "t": 110.935, "d": 0.06}, {"w": "bạn", "t": 110.995, "d": 0.21}, {"w": "đổi", "t": 111.205, "d": 0.135}, {"w": "ý.", "t": 111.34, "d": 0.32}]}], "imgs": {"serp": {"src": "assets/long/mim-ke-huy-diet-petrov/img/serp.jpg", "w": 500, "h": 261, "lic": "Public domain", "by": "Imagery from LANCE FIRMS operated by NASA's Earth Science Data and Information System (ESDIS) with funding provided by N", "pd": true}, "mm3": {"src": "assets/long/mim-ke-huy-diet-petrov/img/mm3.jpg", "w": 1920, "h": 1281, "lic": "Public domain", "by": "U.S. Space Force photo by [null Courtesy]", "pd": true}, "mmsilo": {"src": "assets/long/mim-ke-huy-diet-petrov/img/mmsilo.jpg", "w": 1920, "h": 1327, "lic": "Public domain", "by": "", "pd": true}, "norad84": {"src": "assets/long/mim-ke-huy-diet-petrov/img/norad84.jpg", "w": 1615, "h": 2400, "lic": "Public domain", "by": "Staff Sgt. Bob Simons", "pd": true}, "cheyenne68": {"src": "assets/long/mim-ke-huy-diet-petrov/img/cheyenne68.jpg", "w": 1903, "h": 2400, "lic": "Public domain", "by": "", "pd": true}, "molniya": {"src": "assets/long/mim-ke-huy-diet-petrov/img/molniya.jpg", "w": 330, "h": 330, "lic": "Public domain", "by": "NASA", "pd": true}, "dsp": {"src": "assets/long/mim-ke-huy-diet-petrov/img/dsp.jpg", "w": 500, "h": 550, "lic": "Public domain", "by": "USAF", "pd": true}, "brown": {"src": "assets/long/mim-ke-huy-diet-petrov/img/brown.jpg", "w": 1886, "h": 2400, "lic": "Public domain", "by": "", "pd": true}, "reagan": {"src": "assets/long/mim-ke-huy-diet-petrov/img/reagan.jpg", "w": 1280, "h": 1574, "lic": "Public domain", "by": "Series: Reagan White House Photographs, 1/20/1981 - 1/20/1989\n\nCollection: White House Photographic Collection, 1/20/198", "pd": true}, "e4b": {"src": "assets/long/mim-ke-huy-diet-petrov/img/e4b.jpg", "w": 1280, "h": 677, "lic": "Public domain", "by": "", "pd": true}, "namerica": {"src": "assets/long/mim-ke-huy-diet-petrov/img/namerica.jpg", "w": 1920, "h": 1920, "lic": "Public domain", "