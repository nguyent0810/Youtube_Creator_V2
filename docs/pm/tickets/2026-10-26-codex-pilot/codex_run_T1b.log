, "d": 0.26}, {"w": "của", "t": 32.315, "d": 0.235}, {"w": "Watson", "t": 32.55, "d": 0.09}, {"w": "hay", "t": 32.64, "d": 0.29}, {"w": "được", "t": 32.93, "d": 0.06}, {"w": "kể", "t": 32.99, "d": 0.32}, {"w": "như", "t": 33.31, "d": 0.19}, {"w": "một", "t": 33.5, "d": 0.065}, {"w": "thất", "t": 33.565, "d": 0.265}, {"w": "bại.", "t": 33.83, "d": 0.275}]}, {"text": "Nhưng có lẽ chính xác hơn, nó là một bài học về khoảng cách giữa một màn trình diễn và một công việc thật.", "start": 34.64, "end": 39.44, "words": [{"w": "Nhưng", "t": 34.64, "d": 0.11}, {"w": "có", "t": 34.75, "d": 0.255}, {"w": "lẽ", "t": 35.005, "d": 0.16}, {"w": "chính", "t": 35.165, "d": 0.16}, {"w": "xác", "t": 35.325, "d": 0.315}, {"w": "hơn,", "t": 35.64, "d": 0.27}, {"w": "nó", "t": 35.91, "d": 0.06}, {"w": "là", "t": 35.97, "d": 0.335}, {"w": "một", "t": 36.305, "d": 0.185}, {"w": "bài", "t": 36.49, "d": 0.185}, {"w": "học", "t": 36.675, "d": 0.06}, {"w": "về", "t": 36.735, "d": 0.185}, {"w": "khoảng", "t": 36.92, "d": 0.195}, {"w": "cách", "t": 37.115, "d": 0.185}, {"w": "giữa", "t": 37.3, "d": 0.135}, {"w": "một", "t": 37.435, "d": 0.305}, {"w": "màn", "t": 37.74, "d": 0.225}, {"w": "trình", "t": 37.965, "d": 0.185}, {"w": "diễn", "t": 38.15, "d": 0.185}, {"w": "và", "t": 38.335, "d": 0.18}, {"w": "một", "t": 38.515, "d": 0.06}, {"w": "công", "t": 38.575, "d": 0.305}, {"w": "việc", "t": 38.88, "d": 0.16}, {"w": "thật.", "t": 39.04, "d": 0.255}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "18", "k": "CHƯƠNG 18", "title": "MỘT CÁI TÊN\nBỊ BÁN ĐI", "sub": "01.2022", "vid": "v0", "ms": 14, "illus": "VIDEO MINH HỌA · KHÔNG PHẢI HÌNH ẢNH CHƯƠNG TRÌNH", "titleAt": 0.01, "t0": 0.0, "t1": 4.72}, {"type": "ledger", "title": "THÁNG 1 NĂM 2022", "rows": [{"k": "IBM BÁN", "v": "PHẦN LỚN TÀI SẢN WATSON HEALTH", "at": 4.72}, {"k": "CHO", "v": "MỘT QUỸ ĐẦU TƯ", "at": 10.405}, {"k": "GIÁ", "v": "> 1 TỶ ĐÔ LA · THEO BLOOMBERG", "at": 12.0}], "t0": 4.72, "t1": 16.84}, {"type": "kinetic", "it