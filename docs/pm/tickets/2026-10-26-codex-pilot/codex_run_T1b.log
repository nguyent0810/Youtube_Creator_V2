HỌA · KHÔNG QUÂN MỸ", "side": {"k": "VỆ TINH CẢNH BÁO DSP CỦA MỸ", "h": "NHỮNG CON MẮT\nĐỘC LẬP", "lines": [{"text": "vệ tinh + radar: không thấy gì bất thường", "at": 36.57}]}, "t0": 32.12, "t1": 38.76}, {"type": "slam", "text": "46¢", "sub": "VI MẠCH HỎNG + THIẾT KẾ BẢN TIN CÓ LỖI · THEO LẦU NĂM GÓC", "t0": 38.76, "t1": 44.6, "at": 38.91, "fx": "punch"}, {"type": "kinetic", "items": [{"text": "06.06.1980 · CHẠY THỬ · LỖI LẶP LẠI", "at": 45.0, "fx": "flicker", "L": {"style": {"top": "486px", "fontSize": "51px"}}, "D": [{"kind": "frame", "style": {"top": "410px", "height": "197px", "width": "1267px", "left": "327px"}, "at": 44.7}], "em": "06.06.1980"}], "t0": 44.6, "t1": 48.84, "lay": "frame"}, {"type": "print", "img": "brown", "tone": "bw", "side": {"k": "HAROLD BROWN", "h": "BỘ TRƯỞNG\nQUỐC PHÒNG MỸ", "lines": [{"text": "báo Tổng thống Carter · 06.1980", "at": 48.84}, {"text": "khi thử, không làm con chip hỏng lại được", "at": 52.92}]}, "t0": 48.84, "t1": 57.44}, {"type": "date", "day": "BÁO CÁO HART–GOLDWATER GỬI THƯỢNG VIỆN", "date": "10.1980", "sub": {"text": "“RECENT FALSE ALERTS FROM THE NATION’S MISSILE ATTACK WARNING SYSTEM”", "at": 63.34}, "t0": 57.44, "t1": 64.4, "dayAt": 57.589999999999996, "groupAt": [57.839999999999996, 58.13999999999999]}, {"type": "counter", "from": 0, "to": 147, "suffix": " BÁO ĐỘNG GIẢ", "until": 68.92, "label": "TRONG 18 THÁNG · CS MONITOR 30.10.1980", "sub": {"text": "4 LẦN ĐỦ ĐỂ LỰC LƯỢNG CHIẾN LƯỢC BẮT ĐẦU CHUẨN BỊ", "at": 72.88}, "t0": 64.4, "t1": 76.56, "at": 64.60000000000001}, {"type": "kinetic", "items": [{"text": "HAROLD BROWN → TỔNG THỐNG CARTER", "at": 76.56, "sm": true, "fx": "rise", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "58px", "left": "140px"}}}, {"text": "06.1980", "at": 76.96, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "346px", "fontSize": "114px", "left": "310px"}}}], "t0": 76.56, "t1": 80.0, "lay": "ladder"}, {"type": "quote", "text": "We must be prepared for the possibility that another, unrelated malfunction may someday generate another false alert.", "by": "H. BROWN · GỬI TỔNG THỐNG CARTER · 06.1980 · QUA NSA EBB 371", "lbl": "TRÍCH DỊCH", "qline": 21, "t0": 80.0, "t1": 86.24, "at": 80.095, "typeDur": 4.095, "voiceAt": 80.0, "voiceEnd": 85.92, "radio": true}, {"type": "quote", "text": "…we must continue to place our confidence in the human element of our missile attack warning system.", "by": "H. BROWN · 06.1980 · QUA NSA EBB 371", "lbl": "TRÍCH DỊCH", "qline": 22, "t0": 86.24, "t1": 92.12, "at": 86.4, "typeDur": 3.5, "voiceAt": 86.24, "voiceEnd": 91.12, "radio": true}, {"type": "kinetic", "items": [{"text": "các nhà báo hỏi Lầu Năm Góc · 1980", "at": 92.12, "sm": true, "fx": "blur"}, {"text": "“PHẢN ỨNG DÂY CHUYỀN”?", "at": 92.52, "acc": true, "fx": "flicker", "em": "CHUYỀN”?"}, {"text": "“hy vọng họ có hệ thống an toàn như chúng tôi”", "at": 100.24, "sm": true, "fx": "flicker"}], "t0": 92.12, "t1": 105.36, "lay": "stack"}, {"type": "broll", "vid": "v13", "ms": 8, "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "QUAY LẠI CHIẾC GHẾ", "at": 105.36, "acc": true, "fx": "outline", "em": "CHIẾC"}, {"text": "phía Mỹ: có những con mắt khác nói ngược lại", "at": 109.28, "sm": true, "fx": "rise"}], "t0": 105.36, "t1": 113.44}, {"type": "kinetic", "items": [{"text": "SCOTT SAGAN · ĐẠI HỌC STANFORD", "at": 113.44, "sm": true, "fx": "blur", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "58px", "left": "140px"}}}, {"text": "ĐỔ LỖI CHO CON CHIP, CHO MỘT NGƯỜI", "at": 113.84, "acc": true, "fx": "marker", "L": {"cls": "kC", "style": {"top": "346px", "fontSize": "54px", "left": "310px"}}, "em": "NGƯỜI"}, {"text": "thay vì nhìn vào thiết kế cả hệ thống", "at": 122.18, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "436px", "fontSize": "43px", "left": "480px"}}}], "t0": 113.44, "t1": 124.8, "lay": "ladder"}, {"type": "ledger", "title": "GHẾ TRỰC · BẠN ĐANG CÓ", "srcnote": "MẨU TIN 5 / 6 · NSA EBB 371 · CSMONITOR 1980", "rows": [{"k": "1 · MÀN HÌNH", "v": "1 VỤ PHÓNG · TIN CẬY TỐI ĐA", "at": 124.8}, {"k": "2 · CON MẮT", "v": "OKO MỚI · TỪNG HỎNG NHIỀU", "at": 124.8}, {"k": "3 · SỐ LƯỢNG", "v": "5 (BẢN 2004: 4) · 1 CĂN CỨ", "at": 124.8}, {"k": "4 · BỐI CẢNH", "v": "LÃNH ĐẠO TIN MỸ SẮP RA TAY", "at": 124.8}, {"k": "5 · PHÍA MỸ", "v": "TỪNG NHẦM · CẦN MẮT THỨ 2", "at": 126.08}], "t0": 124.8, "t1": 132.32}, {"type": "question", "text": "Chờ nguồn tin thứ hai,\nhay báo lên trước?\nBÁO LÊN   |   CHƯA", "t0": 132.32, "t1": 137.5}], "prog0": 0.45833, "prog1": 0.56006};
motion/hf/assets/long\mim-apollo-1202\ch01\data.js:1:window.CASE = {"topic": "mim-apollo-1202", "ch": "ch01", "dur": 93.94, "seed": 14015, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 01", "t": "CHIẾC MÁY ĐẶT HÀNG KHI CHƯA CÓ BẢN VẼ"}, "acc": ["1202", "1201", "radar", "phòng", "báo", "máy", "người", "tiếp"], "lines": [{"text": "Chuyện bắt đầu tám năm trước đó.", "start": 0.0, "end": 1.52, "words": [{"w": "Chuyện", "t": 0.015, "d": 0.235}, {"w": "bắt", "t": 0.25, "d": 0.06}, {"w": "đầu", "t": 0.31, "d": 0.245}, {"w": "tám", "t": 0.555, "d": 0.135}, {"w": "năm", "t": 0.69, "d": 0.225}, {"w": "trước", "t": 0.915, "d": 0.115}, {"w": "đó.", "t": 1.03, "d": 0.28}]}, {"text": "Ngày 9 tháng 8 năm 1961, NASA ký hợp đồng với Phòng thí nghiệm Dụng cụ của trường MIT.", "start": 2.32, "end": 7.76, "words": [{"w": "Ngày", "t": 2.32, "d": 0.125}, {"w": "9", "t": 2.445, "d": 0.325}, {"w": "tháng", "t": 2.77, "d": 0.135}, {"w": "8", "t": 2.905, "d": 0.135}, {"w": "năm", "t": 3.04, "d": 0.13}, {"w": "1961,", "t": 3.17, "d": 1.445}, {"w": "NASA", "t": 4.615, "d": 0.315}, {"w": "ký", "t": 4.93, "d": 0.125}, {"w": "hợp", "t": 5.055, "d": 0.235}, {"w": "đồng", "t": 5.29, "d": 0.195}, {"w": "với", "t": 5.485, "d": 0.14}, {"w": "Phòng", "t": 5.625, "d": 0.205}, {"w": "thí", "t": 5.83, "d": 0.195}, {"w": "nghiệm", "t": 6.025, "d": 0.155}, {"w": "Dụng", "t": 6.18, "d": 0.165}, {"w": "cụ", "t": 6.345, "d": 0.205}, {"w": "của", "t": 6.55, "d": 0.235}, {"w": "trường", "t": 6.785, "d": 0.065}, {"w": "MIT.", "t": 6.85, "d": 0.71}]}, {"text": "Việc phải làm: thiết kế và chế tạo hệ thống dẫn đường cho tàu Apollo, kể cả phần mềm.", "start": 8.08, "end": 13.12, "words": [{"w": "Việc", "t": 8.08, "d": 0.125}, {"w": "phải", "t": 8.205, "d": 0.43}, {"w": "làm:", "t": 8.635, "d": 0.245}, {"w": "thiết", "t": 8.88, "d": 0.195}, {"w": "kế", "t": 9.075, "d": 0.385}, {"w": "và", "t": 9.46, "d": 0.185}, {"w": "chế", "t": 9.645, "d": 0.175}, {"w": "tạo", "t": 9.82, "d": 0.14}, {"w": "hệ", "t": 9.96, "d": 0.215}, {"w": "thống", "t": 10.175, "d": 0.43}, {"w": "dẫn", "t": 10.605, "d": 0.195}, {"w": "đường", "t": 10.8, "d": 0.255}, {"w": "cho", "t": 11.055, "d": 0.24}, {"w": "tàu", "t": 11.295, "d": 0.195}, {"w": "Apollo,", "t": 11.49, "d": 0.39}, {"w": "kể", "t": 11.88, "d": 0.2}, {"w": "cả", "t": 12.08, "d": 0.07}, {"w": "phần", "t": 12.15, "d": 0.385}, {"w": "mềm.", "t": 12.535, "d": 0.315}]}, {"text": "Nhóm kỹ sư vừa làm hệ dẫn đường cho tên lửa Polaris, nên được chọn.", "start": 14.12, "end": 17.64, "words": [{"w": "Nhóm", "t": 14.12, "d": 0.18}, {"w": "kỹ", "t": 14.3, "d": 0.22}, {"w": "sư", "t": 14.52, "d": 0.235}, {"w": "vừa", "t": 14.755, "d": 0.265}, {"w": "làm", "t": 15.02, "d": 0.165}, {"w": "hệ", "t": 15.185, "d": 0.145}, {"w": "dẫn", "t": 15.33, "d": 0.3}, {"w": "đường", "t": 15.63, "d": 0.105}, {"w": "cho", "t": 15.735, "d": 0.21}, {"w": "tên", "t": 15.945, "d": 0.29}, {"w": "lửa", "t": 16.235, "d": 0.255}, {"w": "Polaris,", "t": 16.49, "d": 0.245}, {"w": "nên", "t": 16.735, "d": 0.155}, {"w": "được", "t": 16.89, "d": 0.35}, {"w": "chọn.", "t": 17.24, "d": 0.245}]}, {"text": "Nhưng lúc ký, chưa có bản đặc tả nào đầy đủ.", "start": 17.96, "end": 20.44, "words": [{"w": "Nhưng", "t": 17.96, "d": 0.25}, {"w": "lúc", "t": 18.21, "d": 0.06}, {"w": "ký,", "t": 18.27, "d": 0.385}, {"w": "chưa", "t": 18.655, "d": 0.11}, {"w": "có", "t": 18.765, "d": 0.26}, {"w": "bản", "t": 19.025, "d": 0.105}, {"w": "đặc", "t": 19.13, "d": 0.31}, {"w": "tả", "t": 19.44, "d": 0.185}, {"w": "nào", "t": 19.625, "d": 0.055}, {"w": "đầy", "t": 19.68, "d": 0.235}, {"w": "đủ.", "t": 19.915, "d": 0.3}]}, {"text": "Mãi cuối năm 1962, họ mới hình dung ra Apollo cần gì.", "start": 20.76, "end": 24.36, "words": [{"w": "Mãi", "t": 20.825, "d": 0.14}, {"w": "cuối", "t": 20.965, "d": 0.245}, {"w": "năm", "t": 21.21, "d": 0.105}, {"w": "1962,", "t": 21.315, "d": 1.285}, {"w": "họ", "t": 22.6, "d": 0.175}, {"w": "mới", "t": 22.775, "d": 0.32}, {"w": "hình", "t": 23.095, "d": 0.185}, {"w": "dung", "t": 23.28, "d": 0.06}, {"w": "ra", "t": 23.34, "d": 0.25}, {"w": "Apollo", "t": 23.59, "d": 0.14}, {"w": "cần", "t": 23.73, "d": 0.14}, {"w": "gì.", "t": 23.87, "d": 0.32}]}, {"text": "Về sau, một người trong nhóm nhớ lại rằng nếu biết trước, họ có lẽ đã kết luận là với công nghệ đầu những năm 1960, bài toán này vô nghiệm.", "start": 24.68, "end": 32.36, "words": [{"w": "Về", "t": 24.68, "d": 0.125}, {"w": "sau,", "t": 24.805, "d": 0.46}, {"w": "một", "t": 25.265, "d": 0.06}, {"w": "người", "t": 25.325, "d": 0.225}, {"w": "trong", "t": 25.55, "d": 0.165}, {"w": "nhóm", "t": 25.715, "d": 0.155}, {"w": "nhớ", "t": 25.87, "d": 0.195}, {"w": "lại", "t": 26.065, "d": 0.29}, {"w": "rằng", "t": 26.355, "d": 0.24}, {"w": "nếu", "t": 26.595, "d": 0.055}, {"w": "biết", "t": 26.65, "d": 0.275}, {"w": "trước,", "t": 26.925, "d": 0.385}, {"w": "họ", "t": 27.31, "d": 0.14}, {"w": "có", "t": 27.45, "d": 0.09}, {"w": "lẽ", "t": 27.54, "d": 0.26}, {"w": "đã", "t": 27.8, "d": 0.3}, {"w": "kết", "t": 28.1, "d": 0.165}, {"w": "luận", "t": 28.265, "d": 0.185}, {"w": "là", "t": 28.45, "d": 0.23}, {"w": "với", "t": 28.68, "d": 0.06}, {"w": "công", "t": 28.74, "d": 0.175}, {"w": "nghệ", "t": 28.915, "d": 0.35}, {"w": "đầu", "t": 29.265, "d": 0.195}, {"w": "những", "t": 29.46, "d": 0.065}, {"w": "năm", "t": 29.525, "d": 0.285}, {"w": "1960,", "t": 29.81, "d": 1.32}, {"w": "bài", "t": 31.13, "d": 0.075}, {"w": "toán", "t": 31.205, "d": 0.27}, {"w": "này", "t": 31.475, "d": 0.105}, {"w": "vô", "t": 31.58, "d": 0.235}, {"w": "nghiệm.", "t": 31.815, "d": 0.32}]}, {"text": "Thiết kế đầu tiên chỉ có bốn nghìn từ nhớ cố định, và hai trăm năm mươi sáu từ ghi được.", "start": 33.36, "end": 37.36, "words": [{"w": "Thiết", "t": 33.36, "d": 0.13}, {"w": "kế", "t": 33.49, "d": 0.155}, {"w": "đầu", "t": 33.645, "d": 0.205}, {"w": "tiên", "t": 33.85, "d": 0.255}, {"w": "chỉ", "t": 34.105, "d": 0.15}, {"w": "có", "t": 34.255, "d": 0.145}, {"w": "bốn", "t": 34.4, "d": 0.225}, {"w": "nghìn", "t": 34.625, "d": 0.175}, {"w": "từ", "t": 34.8, "d": 0.06}, {"w": "nhớ", "t": 34.86, "d": 0.14}, {"w": "cố", "t": 35.0, "d": 0.175}, {"w": "định,", "t": 35.175, "d": 0.41}, {"w": "và", "t": 35.585, "d": 0.1}, {"w": "hai", "t": 35.685, "d": 0.16}, {"w": "trăm", "t": 35.845, "d": 0.195}, {"w": "năm", "t": 36.04, "d": 0.15}, {"w": "mươi", "t": 36.19, "d": 0.25}, {"w": "sáu", "t": 36.44, "d": 0.175}, {"w": "từ", "t": 36.615, "d": 0.17}, {"w": "ghi", "t": 36.785, "d": 0.14}, {"w": "được.", "t": 36.925, "d": 0.235}]}, {"text": "Con số cuối cùng, trong chiếc máy bay lên Mặt Trăng, là ba mươi sáu nghìn tám trăm sáu mươi bốn từ cố định, và hai nghìn bốn mươi tám từ ghi được.", "start": 37.68, "end": 44.96, "words": [{"w": "Con", "t": 37.735, "d": 0.2}, {"w": "số", "t": 37.935, "d": 0.19}, {"w": "cuối", "t": 38.125, "d": 0.155}, {"w": "cùng,", "t": 38.28, "d": 0.41}, {"w": "trong", "t": 38.69, "d": 0.14}, {"w": "chiếc", "t": 38.83, "d": 0.22}, {"w": "máy", "t": 39.05, "d": 0.12}, {"w": "bay", "t": 39.17, "d": 0.19}, {"w": "lên", "t": 39.36, "d": 0.295}, {"w": "Mặt", "t": 39.655, "d": 0.19}, {"w": "Trăng,", "t": 39.845, "d": 0.385}, {"w": "là", "t": 40.23, "d": 0.115}, {"w": "ba", "t": 40.345, "d": 0.26}, {"w": "mươi", "t": 40.605, "d": 0.165}, {"w": "sáu", "t": 40.77, "d": 0.205}, {"w": "nghìn", "t": 40.975, "d": 0.155}, {"w": "tám", "t": 41.13, "d": 0.265}, {"w": "trăm", "t": 41.395, "d": 0.225}, {"w": "sáu", "t": 41.62, "d": 0.195}, {"w": "mươi", "t": 41.815, "d": 0.12}, {"w": "bốn", "t": 41.935, "d": 0.28}, {"w": "từ", "t": 42.215, "d": 0.15}, {"w": "cố", "t": 42.365, "d": 0.245}, {"w": "định,", "t": 42.61, "d": 0.315}, {"w": "và", "t": 42.925, "d": 0.06}, {"w": "hai", "t": 42.985, "d": 0.165}, {"w": "nghìn", "t": 43.15, "d": 0.195}, {"w": "bốn", "t": 43.345, "d": 0.375}, {"w": "mươi", "t": 43.72, "d": 0.07}, {"w": "tám", "t": 43.79, "d": 0.29}, {"w": "từ", "t": 44.08, "d": 0.18}, {"w": "ghi", "t": 44.26, "d": 0.105}, {"w": "được.", "t": 44.365, "d": 0.38}]}, {"text": "Cộng lại, chưa tới tám mươi kilobyte.", "start": 45.96, "end": 48.04, "words": [{"w": "Cộng", "t": 46.015, "d": 0.32}, {"w": "lại,", "t": 46.335, "d": 0.26}, {"w": "chưa", "t": 46.595, "d": 0.28}, {"w": "tới", "t": 46.875, "d": 0.25}, {"w": "tám", "t": 47.125, "d": 0.155}, {"w": "mươi", "t": 47.28, "d": 0.205}, {"w": "kilobyte.", "t": 47.485, "d": 0.385}]}, {"text": "Nhỏ hơn nhiều so với một tấm ảnh bạn chụp bằng điện thoại.", "start": 48.36, "end": 51.64, "words": [{"w": "Nhỏ", "t": 48.405, "d": 0.18}, {"w": "hơn", "t": 48.585, "d": 0.37}, {"w": "nhiều", "t": 48.955, "d": 0.19}, {"w": "so", "t": 49.145, "d": 0.31}, {"w": "với", "t": 49.455, "d": 0.165}, {"w": "một", "t": 49.62, "d": 0.235}, {"w": "tấm", "t": 49.855, "d": 0.245}, {"w": "ảnh", "t": 50.1, "d": 0.195}, {"w": "bạn", "t": 50.295, "d": 0.3}, {"w": "chụp", "t": 50.595, "d": 0.29}, {"w": "bằng", "t": 50.885, "d": 0.235}, {"w": "điện", "t": 51.12, "d": 0.105}, {"w": "thoại.", "t": 51.225, "d": 0.415}]}, {"text": "Nặng ba mươi hai ký, ngốn bảy mươi oát.", "start": 51.96, "end": 53.96, "words": [{"w": "Nặng", "t": 51.96, "d": 0.095}, {"w": "ba", "t": 52.055, "d": 0.185}, {"w": "mươi", "t": 52.24, "d": 0.27}, {"w": "hai", "t": 52.51, "d": 0.22}, {"w": "ký,", "t": 52.73, "d": 0.185}, {"w": "ngốn", "t": 52.915, "d": 0.115}, {"w": "bảy", "t": 53.03, "d": 0.225}, {"w": "mươi", "t": 53.255, "d": 0.17}, {"w": "oát.", "t": 53.425, "d": 0.315}]}, {"text": "Bên trong có gần năm nghìn mạch logic đơn giản, làm từ những vi mạch còn rất mới.", "start": 54.28, "end": 58.92, "words": [{"w": "Bên", "t": 54.28, "d": 0.13}, {"w": "trong", "t": 54.41, "d": 0.23}, {"w": "có", "t": 54.64, "d": 0.3}, {"w": "gần", "t": 54.94, "d": 0.195}, {"w": "năm", "t": 55.135, "d": 0.38}, {"w": "nghìn", "t": 55.515, "d": 0.205}, {"w": "mạch", "t": 55.72, "d": 0.15}, {"w": "logic", "t": 55.87, "d": 0.215}, {"w": "đơn", "t": 56.085, "d": 0.38}, {"w": "giản,", "t": 56.465, "d": 0.37}, {"w": "làm", "t": 56.835, "d": 0.065}, {"w": "từ", "t": 56.9, "d": 0.3}, {"w": "những", "t": 57.2, "d": 0.2}, {"w": "vi", "t": 57.4, "d": 0.16}, {"w": "mạch", "t": 57.56, "d": 0.42}, {"w": "còn", "t": 57.98, "d": 0.06}, {"w": "rất", "t": 58.04, "d": 0.395}, {"w": "mới.", "t": 58.435, "d": 0.295}]}, {"text": "Mới đến mức, theo báo cáo lịch sử của NASA, mùa hè năm 1963 các nguyên mẫu Apollo đã dùng khoảng sáu mươi phần trăm số vi mạch cả nước Mỹ sản xuất ra.", "start": 59.92, "end": 68.64, "words": [{"w": "Mới", "t": 59.97, "d": 0.225}, {"w": "đến", "t": 60.195, "d": 0.265}, {"w": "mức,", "t": 60.46, "d": 0.275}, {"w": "theo", "t": 60.735, "d": 0.075}, {"w": "báo", "t": 60.81, "d": 0.285}, {"w": "cáo", "t": 61.095, "d": 0.28}, {"w": "lịch", "t": 61.375, "d": 0.09}, {"w": "sử", "t": 61.465, "d": 0.16}, {"w": "của", "t": 61.625, "d": 0.335}, {"w": "NASA,", "t": 61.96, "d": 0.365}, {"w": "mùa", "t": 62.325, "d": 0.2}, {"w": "hè", "t": 62.525, "d": 0.06}, {"w": "năm", "t": 62.585, "d": 0.31}, {"w": "1963", "t": 62.895, "d": 1.33}, {"w": "các", "t": 64.225, "d": 0.255}, {"w": "nguyên", "t": 64.48, "d": 0.215}, {"w": "mẫu", "t": 64.695, "d": 0.19}, {"w": "Apollo", "t": 64.885, "d": 0.14}, {"w": "đã", "t": 65.025, "d": 0.34}, {"w": "dùng", "t": 65.365, "d": 0.175}, {"w": "khoảng", "t": 65.54, "d": 0.06}, {"w": "sáu", "t": 65.6, "d": 0.345}, {"w": "mươi", "t": 65.945, "d": 0.175}, {"w": "phần", "t": 66.12, "d": 0.08}, {"w": "trăm", "t": 66.2, "d": 0.26}, {"w": "số", "t": 66.46, "d": 0.315}, {"w": "vi", "t": 66.775, "d": 0.19}, {"w": "mạch", "t": 66.965, "d": 0.185}, {"w": "cả", "t": 67.15, "d": 0.17}, {"w": "nước", "t": 67.32, "d": 0.275}, {"w": "Mỹ", "t": 67.595, "d": 0.06}, {"w": "sản", "t": 67.655, "d": 0.345}, {"w": "xuất", "t": 68.0, "d": 0.17}, {"w": "ra.", "t": 68.17, "d": 0.275}]}, {"text": "Còn phần chương trình thì sao?", "start": 68.96, "end": 70.24, "words": [{"w": "Còn", "t": 68.96, "d": 0.155}, {"w": "phần", "t": 69.115, "d": 0.155}, {"w": "chương", "t": 69.27, "d": 0.175}, {"w": "trình", "t": 69.445, "d": 0.18}, {"w": "thì", "t": 69.625, "d": 0.165}, {"w": "sao?", "t": 69.79, "d": 0.26}]}, {"text": "Nó không nằm trong đĩa nào cả.", "start": 70.84, "end": 72.84, "words": [{"w": "Nó", "t": 70.84, "d": 0.205}, {"w": "không", "t": 71.045, "d": 0.24}, {"w": "nằm", "t": 71.285, "d": 0.455}, {"w": "trong", "t": 71.74, "d": 0.265}, {"w": "đĩa", "t": 72.005, "d": 0.19}, {"w": "nào", "t": 72.195, "d": 0.25}, {"w": "cả.", "t": 72.445, "d": 0.395}]}, {"text": "Nó được luồn bằng dây qua những lõi từ, gọi là bộ nhớ dây thừng.", "start": 73.16, "end": 76.52, "words": [{"w": "Nó", "t": 73.16, "d": 0.245}, {"w": "được", "t": 73.405, "d": 0.195}, {"w": "luồn", "t": 73.6, "d": 0.09}, {"w": "bằng", "t": 73.69, "d": 0.205}, {"w": "dây", "t": 73.895, "d": 0.21}, {"w": "qua", "t": 74.105, "d": 0.265}, {"w": "những", "t": 74.37, "d": 0.22}, {"w": "lõi", "t": 74.59, "d": 0.19}, {"w": "từ,", "t": 74.78, "d": 0.29}, {"w": "gọi", "t": 75.07, "d": 0.085}, {"w": "là", "t": 75.155, "d": 0.21}, {"w": "bộ", "t": 75.365, "d": 0.21}, {"w": "nhớ", "t": 75.575, "d": 0.185}, {"w": "dây", "t": 75.76, "d": 0.245}, {"w": "thừng.", "t": 76.005, "d": 0.265}]}, {"text": "Làm xong thì rất khó sửa.", "start": 77.52, "end": 78.96, "words": [{"w": "Làm", "t": 77.52, "d": 0.14}, {"w": "xong", "t": 77.66, "d": 0.3}, {"w": "thì", "t": 77.96, "d": 0.175}, {"w": "rất", "t": 78.135, "d": 0.125}, {"w": "khó", "t": 78.26, "d": 0.095}, {"w": "sửa.", "t": 78.355, "d": 0.37}]}, {"text": "Phải giao chương trình trước chuyến bay nhiều tháng.", "start": 79.28, "end": 82.56, "words": [{"w": "Phải", "t": 79.34, "d": 0.32}, {"w": "giao", "t": 79.66, "d": 0.41}, {"w": "chương", "t": 80.07, "d": 0.145}, {"w": "trình", "t": 80.215, "d": 0.4}, {"w": "trước", "t": 80.615, "d": 0.435}, {"w": "chuyến", "t": 81.05, "d": 0.27}, {"w": "bay", "t": 81.32, "d": 0.085}, {"w": "nhiều", "t": 81.405, "d": 0.31}, {"w": "tháng.", "t": 81.715, "d": 0.65}]}, {"text": "Nghĩa là phần mềm phải đúng ngay từ lần đầu.", "start": 82.88, "end": 84.64, "words": [{"w": "Nghĩa", "t": 82.88, "d": 0.205}, {"w": "là", "t": 83.085, "d": 0.1}, {"w": "phần", "t": 83.185, "d": 0.065}, {"w": "mềm", "t": 83.25, "d": 0.255}, {"w": "phải", "t": 83.505, "d": 0.145}, {"w": "đúng", "t": 83.65, "d": 0.14}, {"w": "ngay", "t": 83.79, "d": 0.06}, {"w": "từ", "t": 83.85, "d": 0.185}, {"w": "lần", "t": 84.035, "d": 0.22}, {"w": "đầu.", "t": 84.255, "d": 0.175}]}, {"text": "Một cỗ máy bé như vậy, khó sửa như vậy, làm sao lo nổi cả chuyến hạ cánh?", "start": 85.64, "end": 89.8, "words": [{"w": "Một", "t": 85.64, "d": 0.105}, {"w": "cỗ", "t": 85.745, "d": 0.315}, {"w": "máy", "t": 86.06, "d": 0.235}, {"w": "bé", "t": 86.295, "d": 0.22}, {"w": "như", "t": 86.515, "d": 0.16}, {"w": "vậy,", "t": 86.675, "d": 0.18}, {"w": "khó", "t": 86.855, "d": 0.225}, {"w": "sửa", "t": 87.08, "d": 0.325}, {"w": "như", "t": 87.405, "d": 0.215}, {"w": "vậy,", "t": 87.62, "d": 0.225}, {"w": "làm", "t": 87.845, "d": 0.275}, {"w": "sao", "t": 88.12, "d": 0.13}, {"w": "lo", "t": 88.25, "d": 0.17}, {"w": "nổi", "t": 88.42, "d": 0.225}, {"w": "cả", "t": 88.645, "d": 0.23}, {"w": "chuyến", "t": 88.875, "d": 0.15}, {"w": "hạ", "t": 89.025, "d": 0.13}, {"w": "cánh?", "t": 89.155, "d": 0.405}]}, {"text": "Câu trả lời nằm ở cách nó chia việc.", "start": 90.4, "end": 92.72, "words": [{"w": "Câu", "t": 90.4, "d": 0.13}, {"w": "trả", "t": 90.53, "d": 0.335}, {"w": "lời", "t": 90.865, "d": 0.36}, {"w": "nằm", "t": 91.225, "d": 0.125}, {"w": "ở", "t": 91.35, "d": 0.2}, {"w": "cách", "t": 91.55, "d": 0.4}, {"w": "nó", "t": 91.95, "d": 0.245}, {"w": "chia", "t": 92.195, "d": 0.2}, {"w": "việc.", "t": 92.395, "d": 0.325}]}], "imgs": {"launch": {"src": "assets/long/mim-apollo-1202/img/launch.jpg", "w": 1920, "h": 2400, "lic": "Public domain", "by": "NASA", "pd": true}, "agc": {"src": "assets/long/mim-apollo-1202/img/agc.jpg", "w": 1920, "h": 1538, "lic": "CC BY 2.0", "by": "Steve Jurvetson", "pd": false}, "lm": {"src": "assets/long/mim-apollo-1202/img/lm.jpg", "w": 1920, "h": 1920, "lic": "Public domain", "by": "NASA", "pd": true}, "lm2": {"src": "assets/long/mim-apollo-1202/img/lm2.jpg", "w": 1920, "h": 1845, "lic": "Public domain", "by": "NASA / Apollo 11", "pd": true}, "mcc": {"src": "assets/long/mim-apollo-1202/img/mcc.jpg", "w": 1920, "h": 1281, "lic": "Public domain", "by": "NASA Johnson Space Center", "pd": true}, "mcctraj": {"src": "assets/long/mim-apollo-1202/img/mcctraj.jpg", "w": 1920, "h": 1523, "lic": "Public domain", "by": "NASA", "pd": true}, "site": {"src": "assets/long/mim-apollo-1202/img/site.jpg", "w": 1280, "h": 1280, "lic": "Public domain", "by": "NASA Goddard Space Flight Center from Greenbelt, MD, USA", "pd": true}}, "geo": {}, "scenes": [{"type": "chapter", "no": "1", "k": "CHƯƠNG MỘT", "title": "CHIẾC MÁY ĐẶT HÀNG\nKHI CHƯA CÓ BẢN VẼ", "sub": "MIT · 1961", "bg": "launch", "titleAt": 0.015, "t0": 0.0, "t1": 2.32}, {"type": "date", "day": "NASA KÝ HỢP ĐỒNG VỚI PHÒNG THÍ NGHIỆM DỤNG CỤ MIT", "date": "09.08.1961", "sub": {"text": "THIẾT KẾ + CHẾ TẠO HỆ DẪN ĐƯỜNG, KỂ CẢ PHẦN MỀM", "at": 8.08}, "t0": 2.32, "t1": 14.12, "dayAt": 2.4699999999999998, "groupAt": [2.7199999999999998, 3.0199999999999996, 3.32]}, {"type": "photo", "img": "agc", "tone": "color", "move": "in", "veil": 0.5, "illus": "ẢNH MINH HỌA", "kin": [{"text": "NHÓM LÀM HỆ DẪN ĐƯỜNG TÊN LỬA POLARIS", "at": 14.12, "acc": true, "fx": "sync", "wt": [14.12, 15.02, 15.185, 15.33, 15.63, 15.945, 16.235, 16.49], "t0": 14.12, "em": "POLARIS"}, {"text": "nên được chọn cho Apollo", "at": 16.735, "sm": true, "fx": "blur"}], "label": {"k": "MÁY TÍNH DẪN ĐƯỜNG APOLLO", "v": "ẢNH: STEVE JURVETSON · CC BY 2.0", "at": 14.12}, "t0": 14.12, "t1": 17.96}, {"type": "timeline", "items": [{"year": "1961", "text": "*ký hợp đồng* · chưa có đặc tả đầy đủ", "at": 17.96}, {"year": "CUỐI 1962", "text": "*mới hình dung* Apollo cần gì", "at": 20.76}], "t0": 17.96, "t1": 24.6