motion/hf/assets/long\mim-flappy-bird\ch01\data.js:1:window.CASE = {"topic": "mim-flappy-bird", "ch": "ch01", "dur": 55.18, "seed": 17063, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 01", "t": "HAI, BA NGÀY"}, "acc": ["flappy", "bird", "gỡ", "giờ", "đô", "ngủ", "nghiện"], "lines": [{"text": "Người đăng dòng tweet ấy là Nguyễn Hà Đông.", "start": 0.0, "end": 2.48, "words": [{"w": "Người", "t": 0.0, "d": 0.275}, {"w": "đăng", "t": 0.275, "d": 0.225}, {"w": "dòng", "t": 0.5, "d": 0.155}, {"w": "tweet", "t": 0.655, "d": 0.33}, {"w": "ấy", "t": 0.985, "d": 0.275}, {"w": "là", "t": 1.26, "d": 0.185}, {"w": "Nguyễn", "t": 1.445, "d": 0.47}, {"w": "Hà", "t": 1.915, "d": 0.205}, {"w": "Đông.", "t": 2.12, "d": 0.36}]}, {"text": "Anh lớn lên ở Vạn Phúc, gần Hà Nội, và tự viết game từ năm mười sáu tuổi.", "start": 3.28, "end": 7.36, "words": [{"w": "Anh", "t": 3.335, "d": 0.105}, {"w": "lớn", "t": 3.44, "d": 0.26}, {"w": "lên", "t": 3.7, "d": 0.18}, {"w": "ở", "t": 3.88, "d": 0.305}, {"w": "Vạn", "t": 4.185, "d": 0.06}, {"w": "Phúc,", "t": 4.245, "d": 0.345}, {"w": "gần", "t": 4.59, "d": 0.25}, {"w": "Hà", "t": 4.84, "d": 0.105}, {"w": "Nội,", "t": 4.945, "d": 0.435}, {"w": "và", "t": 5.38, "d": 0.125}, {"w": "tự", "t": 5.505, "d": 0.235}, {"w": "viết", "t": 5.74, "d": 0.165}, {"w": "game", "t": 5.905, "d": 0.13}, {"w": "từ", "t": 6.035, "d": 0.28}, {"w": "năm", "t": 6.315, "d": 0.115}, {"w": "mười", "t": 6.43, "d": 0.305}, {"w": "sáu", "t": 6.735, "d": 0.06}, {"w": "tuổi.", "t": 6.795, "d": 0.36}]}, {"text": "Năm 2012, anh vẽ một chú chim nhỏ cho một trò chơi khác.", "start": 8.36, "end": 12.12, "words": [{"w": "Năm", "t": 8.36, "d": 0.105}, {"w": "2012,", "t": 8.465, "d": 1.335}, {"w": "anh", "t": 9.8, "d": 0.08}, {"w": "vẽ", "t": 9.88, "d": 0.235}, {"w": "một", "t": 10.115, "d": 0.195}, {"w": "chú", "t": 10.31, "d": 0.175}, {"w": "chim", "t": 10.485, "d": 0.165}, {"w": "nhỏ", "t": 10.65, "d": 0.165}, {"w": "cho", "t": 10.815, "d": 0.35}, {"w": "một", "t": 11.165, "d": 0.175}, {"w": "trò", "t": 11.34, "d": 0.1}, {"w": "chơi", "t": 11.44, "d": 0.17}, {"w": "khác.", "t": 11.61, "d": 0.33}]}, {"text": "Trò chơi ấy bị bỏ dở. Chú chim nằm lại trong máy.", "start": 12.44, "end": 15.32, "words": [{"w": "Trò", "t": 12.485, "d": 0.15}, {"w": "chơi", "t": 12.635, "d": 0.33}, {"w": "ấy", "t": 12.965, "d": 0.06}, {"w": "bị", "t": 13.025, "d": 0.34}, {"w": "bỏ", "t": 13.365, "d": 0.2}, {"w": "dở.", "t": 13.565, "d": 0.265}, {"w": "Chú", "t": 13.83, "d": 0.13}, {"w": "chim", "t": 13.96, "d": 0.25}, {"w": "nằm", "t": 14.21, "d": 0.16}, {"w": "lại", "t": 14.37, "d": 0.21}, {"w": "trong", "t": 14.58, "d": 0.17}, {"w": "máy.", "t": 14.75, "d": 0.37}]}, {"text": "Tới năm 2013, anh làm một trò mới.", "start": 16.32, "end": 19.2, "words": [{"w": "Tới", "t": 16.375, "d": 0.265}, {"w": "năm", "t": 16.64, "d": 0.06}, {"w": "2013,", "t": 16.7, "d": 1.285}, {"w": "anh", "t": 17.985, "d": 0.185}, {"w": "làm", "t": 18.17, "d": 0.265}, {"w": "một", "t": 18.435, "d": 0.175}, {"w": "trò", "t": 18.61, "d": 0.165}, {"w": "mới.", "t": 18.775, "d": 0.265}]}, {"text": "Ý tưởng đến từ một việc rất quen. Tâng quả bóng bàn trên mặt vợt, cố giữ cho nó đừng rơi.", "start": 19.52, "end": 24.4, "words": [{"w": "Ý", "t": 19.52, "d": 0.11}, {"w": "tưởng", "t": 19.63, "d": 0.38}, {"w": "đến", "t": 20.01, "d": 0.055}, {"w": "từ", "t": 20.065, "d": 0.345}, {"w": "một", "t": 20.41, "d": 0.19}, {"w": "việc", "t": 20.6, "d": 0.215}, {"w": "rất", "t": 20.815, "d": 0.055}, {"w": "quen.", "t": 20.87, "d": 0.485}, {"w": "Tâng", "t": 21.355, "d": 0.08}, {"w": "quả", "t": 21.435, "d": 0.17}, {"w": "bóng", "t": 21.605, "d": 0.255}, {"w": "bàn", "t": 21.86, "d": 0.18}, {"w": "trên", "t": 22.04, "d": 0.17}, {"w": "mặt", "t": 22.21, "d": 0.21}, {"w": "vợt,", "t": 22.42, "d": 0.48}, {"w": "cố", "t": 22.9, "d": 0.15}, {"w": "giữ", "t": 23.05, "d": 0.08}, {"w": "cho", "t": 23.13, "d": 0.335}, {"w": "nó", "t": 23.465, "d": 0.135}, {"w": "đừng", "t": 23.6, "d": 0.32}, {"w": "rơi.", "t": 23.92, "d": 0.24}]}, {"text": "Anh làm xong trong khoảng hai, ba ngày.", "start": 24.72, "end": 26.64, "words": [{"w": "Anh", "t": 24.83, "d": 0.25}, {"w": "làm", "t": 25.08, "d": 0.175}, {"w": "xong", "t": 25.255, "d": 0.145}, {"w": "trong", "t": 25.4, "d": 0.16}, {"w": "khoảng", "t": 25.56, "d": 0.225}, {"w": "hai,", "t": 25.785, "d": 0.23}, {"w": "ba", "t": 26.015, "d": 0.075}, {"w": "ngày.", "t": 26.09, "d": 0.365}]}, {"text": "Có một chi tiết thú vị.", "start": 27.64, "end": 29.0, "words": [{"w": "Có", "t": 27.64, "d": 0.24}, {"w": "một", "t": 27.88, "d": 0.055}, {"w": "chi", "t": 27.935, "d": 0.2}, {"w": "tiết", "t": 28.135, "d": 0.225}, {"w": "thú", "t": 28.36, "d": 0.07}, {"w": "vị.", "t": 28.43, "d": 0.34}]}, {"text": "Bản đầu tiên dễ hơn nhiều. Chính anh chơi thử, và thấy chán.", "start": 29.32, "end": 32.68, "words": [{"w": "Bản", "t": 29.32, "d": 0.115}, {"w": "đầu", "t": 29.435, "d": 0.22}, {"w": "tiên", "t": 29.655, "d": 0.245}, {"w": "dễ", "t": 29.9, "d": 0.285}, {"w": "hơn", "t": 30.185, "d": 0.28}, {"w": "nhiều.", "t": 30.465, "d": 0.275}, {"w": "Chính", "t": 30.74, "d": 0.085}, {"w": "anh", "t": 30.825, "d": 0.305}, {"w": "chơi", "t": 31.13, "d": 0.155}, {"w": "thử,", "t": 31.285, "d": 0.435}, {"w": "và", "t": 31.72, "d": 0.24}, {"w": "thấy", "t": 31.96, "d": 0.205}, {"w": "chán.", "t": 32.165, "d": 0.28}]}, {"text": "Thế là anh chỉnh cho nó khó lên.", "start": 33.0, "end": 35.64, "words": [{"w": "Thế", "t": 33.0, "d": 0.38}, {"w": "là", "t": 33.38, "d": 0.225}, {"w": "anh", "t": 33.605, "d": 0.255}, {"w": "chỉnh", "t": 33.86, "d": 0.5}, {"w": "cho", "t": 34.36, "d": 0.29}, {"w": "nó", "t": 34.65, "d": 0.19}, {"w": "khó", "t": 34.84, "d": 0.17}, {"w": "lên.", "t": 35.01, "d": 0.63}]}, {"text": "Ngày 24 tháng 5 năm 2013, trò chơi lên kho ứng dụng.", "start": 36.64, "end": 40.16, "words": [{"w": "Ngày",