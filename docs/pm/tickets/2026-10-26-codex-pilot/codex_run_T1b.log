 100.84, "d": 0.145}, {"w": "cảnh", "t": 100.985, "d": 0.35}, {"w": "ấy,", "t": 101.335, "d": 0.255}, {"w": "và", "t": 101.59, "d": 0.29}, {"w": "cho", "t": 101.88, "d": 0.06}, {"w": "thấy", "t": 101.94, "d": 0.245}, {"w": "máy", "t": 102.185, "d": 0.325}, {"w": "chạy", "t": 102.51, "d": 0.235}, {"w": "đúng", "t": 102.745, "d": 0.17}, {"w": "thiết", "t": 102.915, "d": 0.255}, {"w": "kế.", "t": 103.17, "d": 0.255}]}, {"text": "Nhưng câu chuyện chưa kết thúc.", "start": 103.92, "end": 105.6, "words": [{"w": "Nhưng", "t": 103.955, "d": 0.265}, {"w": "câu", "t": 104.22, "d": 0.185}, {"w": "chuyện", "t": 104.405, "d": 0.29}, {"w": "chưa", "t": 104.695, "d": 0.17}, {"w": "kết", "t": 104.865, "d": 0.075}, {"w": "thúc.", "t": 104.94, "d": 0.445}]}, {"text": "Bởi Eagle vẫn còn ba nghìn feet để xuống.", "start": 105.92, "end": 107.92, "words": [{"w": "Bởi", "t": 105.975, "d": 0.26}, {"w": "Eagle", "t": 106.235, "d": 0.185}, {"w": "vẫn", "t": 106.42, "d": 0.16}, {"w": "còn", "t": 106.58, "d": 0.2}, {"w": "ba", "t": 106.78, "d": 0.175}, {"w": "nghìn", "t": 106.955, "d": 0.2}, {"w": "feet", "t": 107.155, "d": 0.185}, {"w": "để", "t": 107.34, "d": 0.185}, {"w": "xuống.", "t": 107.525, "d": 0.22}]}], "imgs": {"launch": {"src": "assets/long/mim-apollo-1202/img/launch.jpg", "w": 1920, "h": 2400, "lic": "Public domain", "by": "NASA", "pd": true}, "agc": {"src": "assets/long/mim-apollo-1202/img/agc.jpg", "w": 1920, "h": 1538, "lic": "CC BY 2.0", "by": "Steve Jurvetson", "pd": false}, "lm": {"src": "assets/long/mim-apollo-1202/img/lm.jpg", "w": 1920, "h": 1920, "lic": "Public domain", "by": "NASA", "pd": true}, "lm2": {"src": "assets/long/mim-apollo-1202/img/lm2.jpg", "w": 1920, "h": 1845, "lic": "Public domain", "by": "NASA / Apollo 11", "pd": true}, "mcc": {"src": "assets/long/mim-apollo-1202/img/mcc.jpg", "w": 1920, "h": 1281, "lic": "Public domain", "by": "NASA Johnson Space Center", "pd": true}, "mcctraj": {"src": "assets/long/mim-apollo-1202/img/mcctraj.jpg", "w": 1920, "h": 1523