motion/hf/assets/long\ck-b3-tra-gop-0\ch05\data.js:1:window.CASE = {"topic": "ck-b3-tra-gop-0", "ch": "ch05", "dur": 69.94, "seed": 14913, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 05", "t": "CÁI GIÁ THỨ TƯ: TRỄ MỘT KỲ"}, "acc": ["không", "phí", "giá", "lãi", "thẳng", "góp", "tổng"], "lines": [{"text": "Mọi phép tính nãy giờ có chung một giả định.", "start": 0.0, "end": 2.4, "words": [{"w": "Mọi", "t": 0.065, "d": 0.185}, {"w": "phép", "t": 0.25, "d": 0.235}, {"w": "tính", "t": 0.485, "d": 0.215}, {"w": "nãy", "t": 0.7, "d": 0.185}, {"w": "giờ", "t": 0.885, "d": 0.185}, {"w": "có", "t": 1.07, "d": 0.185}, {"w": "chung", "t": 1.255, "d": 0.08}, {"w": "một", "t": 1.335, "d": 0.275}, {"w": "giả", "t": 1.61, "d": 0.11}, {"w": "định.", "t": 1.72, "d": 0.315}]}, {"text": "Mười hai tháng liền, bạn trả đủ, đúng ngày.", "start": 3.2, "end": 5.84, "words": [{"w": "Mười", "t": 3.3, "d": 0.165}, {"w": "hai", "t": 3.465, "d": 0.215}, {"w": "tháng", "t": 3.68, "d": 0.305}, {"w": "liền,", "t": 3.985, "d": 0.165}, {"w": "bạn", "t": 4.15, "d": 0.33}, {"w": "trả", "t": 4.48, "d": 0.06}, {"w": "đủ,", "t": 4.54, "d": 0.49}, {"w": "đúng", "t": 5.03, "d": 0.06}, {"w": "ngày.", "t": 5.09, "d": 0.385}]}, {"text": "Nhưng mười hai tháng là một quãng dài.", "start": 6.16, "end": 8.16, "words": [{"w": "Nhưng", "t": 6.225, "d": 0.26}, {"w": "mười", "t": 6.485, "d": 0.06}, {"w": "hai", "t": 6.545, "d": 0.195}, {"w": "tháng", "t": 6.74, "d": 0.165}, {"w": "là", "t": 6.905, "d": 0.2}, {"w": "một", "t": 7.105, "d": 0.215}, {"w": "quãng", "t": 7.32, "d": 0.27}, {"w": "dài.", "t": 7.59, "d": 0.225}]}, {"text": "Trễ một kỳ, ưu đãi có thể không còn.", "start": 9.16, "end": 11.64, "words": [{"w": "Trễ", "t": 9.22, "d": 0.285}, {"w": "một", "t": 9.505, "d": 0.065}, {"w": "kỳ,", "t": 9.57, "d": 0.385}, {"w": "ưu", "t": 9.955, "d": 0.095}, {"w": "đãi", "t": 10.05, "d": 0.375}, {"w": "có", "t": 10.425, "d": 0.195}, {"w": "thể", "t": 10.62, "d": 0.205}, {"w": "không", "t": 10.825, "d": 0.2}, {"w": "còn.", "t": 11.025, "d": 0.24}]}, {"text": "Bạn chịu phí phạt trả chậm.", "start": 11.96, "end": 13.64, "words": [{"w": "Bạn", "t": 12.02, "d": 0.22}, {"w": "chịu", "t": 12.24, "d": 0.245}, {"w": "phí", "t": 12.485, "d": 0.205}, {"w": "phạt", "t": 12.69, "d": 0.2}, {"w": "trả", "t": 12.89, "d": 0.06}, {"w": "chậm.", "t": 12.95, "d": 0.37}]}, {"text": "Và ở một số hợp đồng, khoản còn lại bị tính lãi theo mức thông thường, không còn là số không.", "start": 13.96, "end": 18.84, "words": [{"w": "Và", "t": 14.005, "d": 0.175}, {"w": "ở", "t": 14.18, "d": 0.3}, {"w": "một", "t": 14.48, "d": 0.09}, {"w": "số", "t": 14.57, "d": 0.26}, {"w": "hợp", "t": 14.83, "d": 0.24}, {"w": "đồng,", "t": 15.07, "d": 0.19}, {"w": "khoản", "t": 15.26, "d": 0.32}, {"w": "còn", "t": 15.58, "d": 0.06}, {"w": "lại", "t": 15.64, "d": 0.29}, {"w": "bị", "t": 15.93, "d": 0.205}, {"w": "tính", "t": 16.135, "d": 0.08}, {"w": "lãi", "t": 16.215, "d": 0.305}, {"w": "theo", "t": 16.52, "d": 0.24}, {"w": "mức", "t": 16.76, "d": 0.085}, {"w": "thông", "t": 16.845, "d": 0.19}, {"w": "thường,", "t": 17.035, "d": 0.43}, {"w": "không", "t": 17.465, "d": 0.055}, {"w": "còn", "t": 17.52, "d": 0.185}, {"w": "là", "t": 17.705, "d": 0.35}, {"w": "số", "t": 18.055, "d": 0.195}, {"w": "không.", "t": 18.25, "d": 0.235}]}, {"text": "Với trả góp qua thẻ tín dụng, khoản góp mỗi tháng được cộng vào sao kê của thẻ.", "start": 19.84, "end": 24.16, "words": [{"w": "Với", "t": 19.895, "d": 0.175}, {"w": "trả", "t": 20.07, "d": 0.215}, {"w": "góp", "t": 20.285, "d": 0.18}, {"w": "qua", "t": 20.465, "d": 0.2}, {"w": "thẻ", "t": 20.665, "d": 0.215}, {"w": "tín", "t": 20.88, "d": 0.225}, {"w": "dụng,", "t": 21.105, "d": 0.31}, {"w": "khoản", "t": 21.415, "d": 0.135}, {"w": "góp", "t": 21.55, "d": 0.385}, {"w": "mỗi", "t": 21.935, "d": 0.055}, {"w": "tháng", "t": 21.99, "d": 0.195}, {"w": "được", "t": 22.185, "d": 0.36}, {"w": "cộng", "t": 22.545, "d": 0.06}, {"w": "vào", "t": 22.605, "d": 0.23}, {"w": "sao", "t": 22.835, "d": 0.225}, {"w": "kê", "t": 23.06, "d": 0.165}, {"w": "của", "t": 23.225, "d": 0.195}, {"w": "thẻ.", "t": 23.42, "d": 0.385}]}, {"text": "Không trả đủ sao kê, phần còn thiếu bị tính lãi thẻ.", "start": 24.48, "end": 27.68, "words": [{"w": "Không", "t": 24.555, "d": 0.155}, {"w": "trả", "t": 24.71, "d": 0.35}, {"w": "đủ", "t": 25.06, "d": 0.21}, {"w": "sao", "t": 25.27, "d": 0.06}, {"w": "kê,", "t": 25.33, "d": 0.335}, {"w": "phần", "t": 25.665, "d": 0.175}, {"w": "còn", "t": 25.84, "d": 0.235}, {"w": "thiếu", "t": 26.075, "d": 0.215}, {"w": "bị", "t": 26.29, "d": 0.36}, {"w": "tính", "t": 26.65, "d": 0.055}, {"w": "lãi", "t": 26.705, "d": 0.36}, {"w": "thẻ.", "t": 27.065, "d": 0.25}]}, {"text": "Mà lãi thẻ, như bài trước mình đã tính, thường từ hai mươi tới bốn mươi phần trăm một năm.", "start": 28.0, "end": 32.72, "words": [{"w": "Mà", "t": 28.065, "d": 0.23}, {"w": "lãi", "t": 28.295, "d": 0.1}, {"w": "thẻ,", "t": 28.395, "d": 0.435}, {"w": "như", "t": 28.83, "d": 0.055}, {"w": "bài", "t": 28.885, "d": 0.36}, {"w": "trước", "t": 29.245, "d": 0.155}, {"w": "mình", "t": 29.4, "d": 0.245}, {"w": "đã", "t": 29.645, "d": 0.18}, {"w": "tính,", "t": 29.825, "d": 0.325}, {"w": "thường", "t": 30.15, "d": 0.135}, {"w": "từ", "t": 30.285, "d": 0.105}, {"w": "hai", "t": 30.39, "d": 0.205}, {"w": "mươi", "t": 30.595, "d": 0.185}, {"w": "tới", "t": 30.78, "d": 0.355}, {"w": "bốn", "t": 31.135, "d": 0.19}, {"w": "mươi", "t": 31.325, "d": 0.17}, {"w": "phần", "t": 31.495, "d": 0.215}, {"w": "trăm", "t": 31.71, "d": 0.155}, {"w": "một", "t": 31.865, "d": 0.275}, {"w": "năm.", "t": 32.14, "d": 0.235}]}, {"text": "Còn một cái giá nữa, khó đo hơn.", "start": 33.72, "end": 35.88, "words": [{"w": "Còn", "t": 33.79, "d": 0.27}, {"w": "một", "t": 34.06, "d": 0.19}, {"w": "cái", "t": 34.25, "d": 0.145}, {"w": "giá", "t": 34.395, "d": 0.24}, {"w": "nữa,", "t": 34.635, "d": 0.15}, {"w": "khó", "t": 34.785, "d": 0.18}, {"w": "đo", "t": 34.965, "d": 0.36}, {"w": "hơn.", "t": 35.325, "d": 0.23}]}, {"text": "Một triệu bảy mỗi tháng nghe nhỏ, nên ta dễ gật đầu với một chiếc máy đắt hơn dự định.", "start": 36.2, "end": 40.76, "words": [{"w": "Một", "t": 36.31, "d": 0.135}, {"w": "triệu", "t": 36.445, "d": 0.185}, {"w": "bảy", "t": 36.63, "d": 0.2}, {"w": "mỗi", "t": 36.83, "d": 0.24}, {"w": "tháng", "t": 37.07, "d": 0.235}, {"w": "nghe", "t": 37.305, "d": 0.155}, {"w": "nhỏ,", "t": 37.46, "d": 0.39}, {"w": "nên", "t": 37.85, "d": 0.06}, {"w": "ta", "t": 37.91, "d": 0.305}, {"w": "dễ", "t": 38.215, "d": 0.195}, {"w": "gật", "t": 38.41, "d": 0.185}, {"w": "đầu", "t": 38.595, "d": 0.14}, {"w": "với", "t": 38.735, "d": 0.27}, {"w": "một", "t": 39.005, "d": 0.145}, {"w": "chiếc", "t": 39.15, "d": 0.19}, {"w": "máy", "t": 39.34, "d": 0.15}, {"w": "đắt", "t": 39.49, "d": 0.225}, {"w": "hơn", "t": 39.715, "d": 0.1}, {"w": "dự", "t": 39.815, "d": 0.33}, {"w": "định.", "t": 40.145, "d": 0.24}]}, {"text": "Rồi thêm một món trả góp khác. Rồi một món nữa.", "start": 41.08, "end": 44.12, "words": [{"w": "Rồi", "t": 41.19, "d": 0.13}, {"w": "thêm", "t": 41.32, "d": 0.31}, {"w": "một", "t": 41.63, "d": 0.275}, {"w": "món", "t": 41.905, "d": 0.23}, {"w": "trả", "t": 42.135, "d": 0.165}, {"w": "góp", "t": 42.3, "d": 0.26}, {"w": "khác.", "t": 42.56, "d": 0.275}, {"w": "Rồi", "t": 42.835, "d": 0.095}, {"w": "một", "t": 42.93, "d": 0.405}, {"w": "món", "t": 43.335, "d": 0.06}, {"w": "nữa.", "t": 43.395, "d": 0.405}]}, {"text": "Từng khoản đều nhỏ. Cộng lại thì không nhỏ.", "start": 44.44, "end": 46.92, "words": [{"w": "Từng", "t": 44.485, "d": 0.175}, {"w": "khoản", "t": 44.66, "d": 0.185}, {"w": "đều", "t": 44.845, "d": 0.175}, {"w": "nhỏ.", "t": 45.02, "d": 0.445}, {"w": "Cộng", "t": 45.465, "d": 0.075}, {"w": "lại", "t": 45.54, "d": 0.195}, {"w": "thì", "t": 45.735, "d": 0.26}, {"w": "không", "t": 45.995, "d": 0.16}, {"w": "nhỏ.", "t": 46.155, "d": 0.41}]}, {"text": "Vì thế, trước khi ký, hãy cộng mọi khoản góp hằng tháng của bạn lại thành một con số.", "start": 47.92, "end": 52.56, "words": [{"w": "Vì", "t": 47.985, "d": 0.165}, {"w": "thế,", "t": 48.15, "d": 0.36}, {"w": "trước", "t": 48.51, "d": 0.21}, {"w": "khi", "t": 48.72, "d": 0.13}, {"w": "ký,", "t": 48.85, "d": 0.445}, {"w": "hãy", "t": 49.295, "d": 0.06}, {"w": "cộng", "t": 49.355, "d": 0.205}, {"w": "mọi", "t": 49.56, "d": 0.38}, {"w": "khoản", "t": 49.94, "d": 0.06}, {"w": "góp", "t": 50.0, "d": 0.24}, {"w": "hằng", "t": 50.24, "d": 0.145}, {"w": "tháng", "t": 50.385, "d": 0.25}, {"w": "của", "t": 50.635, "d": 0.25}, {"w": "bạn", "t": 50.885, "d": 0.26}, {"w": "lại", "t": 51.145, "d": 0.215}, {"w": "thành", "t": 51.36, "d": 0.06}, {"w": "một", "t": 51.42, "d": 0.33}, {"w": "con", "t": 51.75, "d": 0.22}, {"w": "số.", "t": 51.97, "d": 0.24}]}, {"text": "Con số ấy mới là thứ bạn thật sự cam kết.", "start": 52.88, "end": 55.44, "words": [{"w": "Con", "t": 52.945, "d": 0.175}, {"w": "số", "t": 53.12, "d": 0.145}, {"w": "ấy", "t": 53.265, "d": 0.17}, {"w": "mới", "t": 53.435, "d": 0.265}, {"w": "là", "t": 53.7, "d": 0.205}, {"w": "thứ", "t": 53.905, "d": 0.15}, {"w": "bạn", "t": 54.055, "d": 0.23}, {"w": "thật", "t": 54.285, "d": 0.21}, {"w": "sự", "t": 54.495, "d": 0.185}, {"w": "cam", "t": 54.68, "d": 0.06}, {"w": "kết.", "t": 54.74, "d": 0.345}]}, {"text": "Và một việc nhỏ nữa trước khi ký.", "start": 55.76, "end": 57.68, "words": [{"w": "Và", "t": 55.815, "d": 0.135}, {"w": "một", "t": 55.95, "d": 0.195}, {"w": "việc", "t": 56.145, "d": 0.16}, {"w": "nhỏ", "t": 56.305, "d": 0.22}, {"w": "nữa", "t": 56.525, "d": 0.26}, {"w": "trước", "t": 56.785, "d": 0.195}, {"w": "khi", "t": 56.98, "d": 0.15}, {"w": "ký.", "t": 57.13, "d": 0.25}]}, {"text": "Hãy xin một lịch trả tiền in sẵn: mỗi kỳ bao nhiêu, vào ngày nào, tổng cộng bao nhiêu.", "start": 58.0, "end": 62.8, "words": [{"w": "Hãy", "t": 58.07, "d": 0.195}, {"w": "xin", "t": 58.265, "d": 0.24}, {"w": "một", "t": 58.505, "d": 0.205}, {"w": "lịch", "t": 58.71, "d": 0.26}, {"w": "trả", "t": 58.97, "d": 0.205}, {"w": "tiền", "t": 59.175, "d": 0.195}, {"w": "in", "t": 59.37, "d": 0.07}, {"w": "sẵn:", "t": 59.44, "d": 0.38}, {"w": "mỗi", "t": 59.82, "d": 0.285}, {"w": "kỳ", "t": 60.105, "d": 0.185}, {"w": "bao", "t": 60.29, "d": 0.08}, {"w": "nhiêu,", "t": 60.37, "d": 0.465}, {"w": "vào", "t": 60.835, "d": 0.06}, {"w": "ngày", "t": 60.895, "d": 0.34}, {"w": "nào,", "t": 61.235, "d": 0.34}, {"w": "tổng", "t": 61.575, "d": 0.06}, {"w": "cộng", "t": 61.635, "d": 0.24}, {"w": "bao", "t": 61.875, "d": 0.145}, {"w": "nhiêu.", "t": 62.02, "d": 0.42}]}, {"text": "Một tờ giấy thôi.", "start": 63.12, "end": 65.36, "words": [{"w": "Một", "t": 63.225, "d": 0.565}, {"w": "tờ", "t": 63.79, "d": 0.435}, {"w": "giấy", "t": 64.225, "d": 0.08}, {"w": "thôi.", "t": 64.305, "d": 0.86}]}, {"text": "Nhưng nó trả lời gần hết những câu hỏi mà tấm biển không nhắc.", "start": 65.68, "end": 68.72, "words": [{"w": "Nhưng", "t": 65.74, "d": 0.245}, {"w": "nó", "t": 65.985, "d": 0.085}, {"w": "trả", "t": 66.07, "d": 0.13}, {"w": "lời", "t": 66.2, "d": 0.26}, {"w": "gần", "t": 66.46, "d": 0.185}, {"w": "hết", "t": 66.645, "d": 0.17}, {"w": "những", "t": 66.815, "d": 0.185}, {"w": "câu", "t": 67.0, "d": 0.195}, {"w": "hỏi", "t": 67.195, "d": 0.2}, {"w": "mà", "t": 67.395, "d": 0.225}, {"w": "tấm", "t": 67.62, "d": 0.185}, {"w": "biển", "t": 67.805, "d": 0.18}, {"w": "không", "t": 67.985, "d": 0.07}, {"w": "nhắc.", "t": 68.055, "d": 0.325}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "5", "k": "CHƯƠNG NĂM", "title": "CÁI GIÁ THỨ TƯ", "sub": "KHI BẠN TRỄ MỘT KỲ", "vid": "v0", "illus": "VIDEO MINH HỌA", "titleAt": 0.065, "t0": 0.0, "t1": 3.2}, {"type": "units", "title": "GIẢ ĐỊNH CỦA MỌI PHÉP TÍNH: 12 THÁNG, TRẢ ĐỦ, ĐÚNG NGÀY", "total": 12, "cols": 12, "lit": 12, "litAt": 3.3, "unitLabel": "KỲ TRẢ ĐÚNG HẠN", "t0": 3.2, "t1": 9.16}, {"type": "ledger", "title": "TRỄ MỘT KỲ", "srcnote": "TUỲ TỪNG HỢP ĐỒNG · ĐỌC ĐIỀU KHOẢN CỦA BẠN", "rows": [{"k": "ƯU ĐÃI", "v": "CÓ THỂ KHÔNG CÒN", "at": 9.16}, {"k": "THÊM", "v": "PHÍ PHẠT TRẢ CHẬM", "at": 11.96}, {"k": "Ở MỘT SỐ HỢP ĐỒNG", "v": "PHẦN CÒN LẠI BỊ TÍNH LÃI", "at": 13.96}], "t0": 9.16, "t1": 19.84}, {"type": "timeline", "items": [{"year": "QUA THẺ", "text": "khoản góp mỗi tháng cộng vào sao kê", "at": 19.84}, {"year": "TRẢ THIẾU", "text": "phần còn thiếu bị tính lãi thẻ", "at": 24.48}, {"year": "LÃI THẺ", "text": "thường 20–40% một năm", "at": 30.15}], "t0": 19.84, "t1": 33.72}, {"type": "broll", "vid": "v4", "ms": 4, "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "1,7 TRIỆU MỖI THÁNG NGHE NHỎ", "at": 36.2, "sm": true, "fx": "rise"}, {"text": "RỒI THÊM MỘT MÓN · RỒI MỘT MÓN NỮA", "at": 41.19, "acc": true, "fx": "marker", "em": "THÊM"}, {"text": "từng khoản đều nhỏ · cộng lại thì không nhỏ", "at": 44.44, "sm": true, "fx": "blur"}], "t0": 33.72, "t1": 47.92}, {"type": "slam", "text": "CỘNG MỌI KHOẢN GÓP LẠI", "sub": "CON SỐ ẤY MỚI LÀ THỨ BẠN CAM KẾT", "subAt": 14, "t0": 47.92, "t1": 55.76, "at": 48.07, "fx": "slice"}, {"type": "ledger", "title": "LỊCH TRẢ TIỀN IN SẴN", "rows": [{"k": "MỖI KỲ", "v": "BAO NHIÊU?", "at": 59.82}, {"k": "NGÀY NÀO", "v": "TRẢ?", "at": 60.835}, {"k": "TỔNG CỘNG", "v": "BAO NHIÊU?", "at": 61.575}], "total": {"k": "MỘT TỜ GIẤY", "v": "TRẢ LỜI ĐIỀU TẤM BIỂN KHÔNG NHẮC", "at": 65.68}, "t0": 55.76, "t1": 69.94}], "prog0": 0.6916, "prog1": 0.84449};
motion/hf/assets/long\mim-oppenheimer-feynman\ch06\data.js:1:window.CASE = {"topic": "mim-oppenheimer-feynman", "ch": "ch06", "dur": 103.22, "seed": 36000, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 06", "t": "BA BÀI TRONG CHÍN THÁNG"}, "acc": ["số", "khoá", "máy", "người", "thẻ", "mệt", "song", "xúc"], "lines": [{"text": "Máy không mệt, nhưng máy sợ bụi.", "start": 0.0, "end": 1.76, "words": [{"w": "Máy", "t": 0.025, "d": 0.12}, {"w": "không", "t": 0.145, "d": 0.34}, {"w": "mệt,", "t": 0.485, "d": 0.235}, {"w": "nhưng", "t": 0.72, "d": 0.095}, {"w": "máy", "t": 0.815, "d": 0.355}, {"w": "sợ", "t": 1.17, "d": 0.07}, {"w": "bụi.", "t": 1.24, "d": 0.35}]}, {"text": "Mỗi máy có hàng trăm rơ-le, chỉ một hạt bụi kẹt vào là ra số sai.", "start": 2.56, "end": 6.16, "words": [{"w": "Mỗi", "t": 2.56, "d": 0.265}, {"w": "máy", "t": 2.825, "d": 0.135}, {"w": "có", "t": 2.96, "d": 0.2}, {"w": "hàng", "t": 3.16, "d": 0.19}, {"w": "trăm", "t": 3.35, "d": 0.135}, {"w": "rơ-le,", "t": 3.485, "d": 0.5}, {"w": "chỉ", "t": 3.985, "d": 0.095}, {"w": "một", "t": 4.08, "d": 0.32}, {"w": "hạt", "t": 4.4, "d": 0.18}, {"w": "bụi", "t": 4.58, "d": 0.225}, {"w": "kẹt", "t": 4.805, "d": 0.185}, {"w": "vào", "t": 4.99, "d": 0.06}, {"w": "là", "t": 5.05, "d": 0.265}, {"w": "ra", "t": 5.315, "d": 0.15}, {"w": "số", "t": 5.465, "d": 0.19}, {"w": "sai.", "t": 5.655, "d": 0.305}]}, {"text": "Nên chương trình được thiết kế để chịu được sai số nhỏ.", "start": 6.48, "end": 9.76, "words": [{"w": "Nên", "t": 6.48, "d": 0.275}, {"w": "chương", "t": 6.755, "d": 0.34}, {"w": "trình", "t": 7.095, "d": 0.175}, {"w": "được", "t": 7.27, "d": 0.29}, {"w": "thiết", "t": 7.56, "d": 0.23}, {"w": "kế", "t": 7.79, "d": 0.24}, {"w": "để", "t": 8.03, "d": 0.155}, {"w": "chịu", "t": 8.185, "d": 0.35}, {"w": "được", "t": 8.535, "d": 0.4}, {"w": "sai", "t": 8.935, "d": 0.23}, {"w": "số", "t": 9.165, "d": 0.145}, {"w": "nhỏ.", "t": 9.31, "d": 0.45}]}, {"text": "Sai ở chữ số cuối thì bỏ qua, chỉ sửa khi sai ở những chữ số lớn.", "start": 10.08, "end": 13.68, "words": [{"w": "Sai", "t": 10.165, "d": 0.23}, {"w": "ở", "t": 10.395, "d": 0.19}, {"w": "chữ", "t": 10.585, "d": 0.155}, {"w": "số", "t": 10.74, "d": 0.205}, {"w": "cuối", "t": 10.945, "d": 0.09}, {"w": "thì", "t": 11.035, "d": 0.2}, {"w": "bỏ", "t": 11.235, "d": 0.265}, {"w": "qua,", "t": 11.5, "d": 0.205}, {"w": "chỉ", "t": 11.705, "d": 0.235}, {"w": "sửa", "t": 11.94, "d": 0.06}, {"w": "khi", "t": 12.0, "d": 0.175}, {"w": "sai", "t": 12.175, "d": 0.175}, {"w": "ở", "t": 12.35, "d": 0.24}, {"w": "những", "t": 12.59, "d": 0.17}, {"w": "chữ", "t": 12.76, "d": 0.175}, {"w": "số", "t": 12.935, "d": 0.19}, {"w": "lớn.", "t": 13.125, "d": 0.32}]}, {"text": "Ngoài bụi, còn một thứ bệnh của người.", "start": 14.68, "end": 16.76, "words": [{"w": "Ngoài", "t": 14.74, "d": 0.11}, {"w": "bụi,", "t": 14.85, "d": 0.495}, {"w": "còn", "t": 15.345, "d": 0.065}, {"w": "một", "t": 15.41, "d": 0.23}, {"w": "thứ", "t": 15.64, "d": 0.145}, {"w": "bệnh", "t": 15.785, "d": 0.36}, {"w": "của", "t": 16.145, "d": 0.145}, {"w": "người.", "t": 16.29, "d": 0.3}]}, {"text": "Feynman gọi nó là \"bệnh máy tính\".", "start": 17.08, "end": 19.16, "words": [{"w": "Feynman", "t": 17.08, "d": 0.36}, {"w": "gọi", "t": 17.44, "d": 0.21}, {"w": "nó", "t": 17.65, "d": 0.08}, {"w": "là", "t": 17.73, "d": 0.315}, {"w": "\"bệnh", "t": 18.045, "d": 0.33}, {"w": "máy", "t": 18.375, "d": 0.105}, {"w": "tính\".", "t": 18.48, "d": 0.49}]}, {"text": "Người mắc đầu tiên lại chính là Stanley Frankel, người nghĩ ra cả hệ thống.", "start": 19.48, "end": 23.24, "words": [{"w": "Người", "t": 19.48, "d": 0.205}, {"w": "mắc", "t": 19.685, "d": 0.23}, {"w": "đầu", "t": 19.915, "d": 0.155}, {"w": "tiên", "t": 20.07, "d": 0.195}, {"w": "lại", "t": 20.265, "d": 0.34}, {"w": "chính", "t": 20.605, "d": 0.1}, {"w": "là", "t": 20.705, "d": 0.32}, {"w": "Stanley", "t": 21.025, "d": 0.19}, {"w": "Frankel,", "t": 21.215, "d": 0.45}, {"w": "người", "t": 21.665, "d": 0.16}, {"w": "nghĩ", "t": 21.825, "d": 0.095}, {"w": "ra", "t": 21.92, "d": 0.285}, {"w": "cả", "t": 22.205, "d": 0.33}, {"w": "hệ", "t": 22.535, "d": 0.125}, {"w": "thống.", "t": 22.66, "d": 0.355}]}, {"text": "Ông mải mê làm cho một máy tự in ra bảng hàm arctang.", "start": 23.56, "end": 26.2, "words": [{"w": "Ông", "t": 23.59, "d": 0.14}, {"w": "mải", "t": 23.73, "d": 0.18}, {"w": "mê", "t": 23.91, "d": 0.225}, {"w": "làm", "t": 24.135, "d": 0.2}, {"w": "cho", "t": 24.335, "d": 0.095}, {"w": "một", "t": 24.43, "d": 0.145}, {"w": "máy", "t": 24.575, "d": 0.26}, {"w": "tự", "t": 24.835, "d": 0.125}, {"w": "in", "t": 24.96, "d": 0.235}, {"w": "ra", "t": 25.195, "d": 0.125}, {"w": "bảng", "t": 25.32, "d": 0.13}, {"w": "hàm", "t": 25.45, "d": 0.32}, {"w": "arctang.", "t": 25.77, "d": 0.21}]}, {"text": "Trong khi bảng ấy, họ đã có sẵn.", "start": 26.52, "end": 28.44, "words": [{"w": "Trong", "t": 26.52, "d": 0.145}, {"w": "khi", "t": 26.665, "d": 0.27}, {"w": "bảng", "t": 26.935, "d": 0.235}, {"w": "ấy,", "t": 27.17, "d": 0.225}, {"w": "họ", "t": 27.395, "d": 0.26}, {"w": "đã", "t": 27.655, "d": 0.2}, {"w": "có", "t": 27.855, "d": 0.145}, {"w": "sẵn.", "t": 28.0, "d": 0.27}]}, {"text": "Một bảng vô ích.", "start": 28.76, "end": 30.76, "words": [{"w": "Một", "t": 28.76, "d": 0.56}, {"w": "bảng", "t": 29.32, "d": 0.235}, {"w": "vô", "t": 29.555, "d": 0.205}, {"w": "ích.", "t": 29.76, "d": 0.805}]}, {"text": "Feynman giải thích: máy vui quá, nên người ta chơi với nó và quên việc chính.", "start": 31.76, "end": 35.84, "words": [{"w": "Feynman", "t": 31.795, "d": 0.275}, {"w": "giải", "t": 32.07, "d": 0.15}, {"w": "thích:", "t": 32.22, "d": 0.43}, {"w": "máy", "t": 32.65, "d": 0.135}, {"w": "vui", "t": 32.785, "d": 0.285}, {"w": "quá,", "t": 33.07, "d": 0.18}, {"w": "nên", "t": 33.25, "d": 0.375}, {"w": "người", "t": 33.625, "d": 0.13}, {"w": "ta", "t": 33.755, "d": 0.11}, {"w": "chơi", "t": 33.865, "d": 0.335}, {"w": "với", "t": 34.2, "d": 0.13}, {"w": "nó", "t": 34.33, "d": 0.215}, {"w": "và", "t": 34.545, "d": 0.165}, {"w": "quên", "t": 34.71, "d": 0.385}, {"w": "việc", "t": 35.095, "d": 0.215}, {"w": "chính.", "t": 35.31, "d": 0.265}]}, {"text": "Ai từng mải nghịch một bảng tính đến quên giờ ăn chắc hiểu căn bệnh này.", "start": 36.16, "end": 40.0, "words": [{"w": "Ai", "t": 36.205, "d": 0.13}, {"w": "từng", "t": 36.335, "d": 0.43}, {"w": "mải", "t": 36.765, "d": 0.18}, {"w": "nghịch", "t": 36.945, "d": 0.265}, {"w": "một", "t": 37.21, "d": 0.18}, {"w": "bảng", "t": 37.39, "d": 0.21}, {"w": "tính", "t": 37.6, "d": 0.235}, {"w": "đến", "t": 37.835, "d": 0.24}, {"w": "quên", "t": 38.075, "d": 0.28}, {"w": "giờ", "t": 38.355, "d": 0.215}, {"w": "ăn", "t": 38.57, "d": 0.255}, {"w": "chắc", "t": 38.825, "d": 0.23}, {"w": "hiểu", "t": 39.055, "d": 0.2}, {"w": "căn", "t": 39.255, "d": 0.11}, {"w": "bệnh", "t": 39.365, "d": 0.225}, {"w": "này.", "t": 39.59, "d": 0.415}]}, {"text": "Đầu năm 1945, Frankel được chuyển sang nhóm khác.", "start": 40.32, "end": 43.92, "words": [{"w": "Đầu", "t": 40.405, "d": 0.2}, {"w": "năm", "t": 40.605, "d": 0.245}, {"w": "1945,", "t": 40.85, "d": 1.61}, {"w": "Frankel", "t": 42.46, "d": 0.115}, {"w": "được", "t": 42.575, "d": 0.325}, {"w": "chuyển", "t": 42.9, "d": 0.185}, {"w": "sang", "t": 43.085, "d": 0.115}, {"w": "nhóm", "t": 43.2, "d": 0.145}, {"w": "khác.", "t": 43.345, "d": 0.425}]}, {"text": "Feynman được giao trông phần tính toán bằng máy IBM.", "start": 44.24, "end": 46.88, "words": [{"w": "Feynman", "t": 44.24, "d": 0.105}, {"w": "được", "t": 44.345, "d": 0.235}, {"w": "giao", "t": 44.58, "d": 0.18}, {"w": "trông", "t": 44.76, "d": 0.2}, {"w": "phần", "t": 44.96, "d": 0.18}, {"w": "tính", "t": 45.14, "d": 0.185}, {"w": "toán", "t": 45.325, "d": 0.34}, {"w": "bằng", "t": 45.665, "d": 0.19}, {"w": "máy", "t": 45.855, "d": 0.06}, {"w": "IBM.", "t": 45.915, "d": 0.745}]}, {"text": "Theo ông, tới lúc ấy nhóm mới làm xong ba bài toán trong chín tháng.", "start": 47.2, "end": 50.72, "words": [{"w": "Theo", "t": 47.2, "d": 0.285}, {"w": "ông,", "t": 47.485, "d": 0.325}, {"w": "tới", "t": 47.81, "d": 0.06}, {"w": "lúc", "t": 47.87, "d": 0.25}, {"w": "ấy", "t": 48.12, "d": 0.165}, {"w": "nhóm", "t": 48.285, "d": 0.175}, {"w": "mới", "t": 48.46, "d": 0.355}, {"w": "làm", "t": 48.815, "d": 0.18}, {"w": "xong", "t": 48.995, "d": 0.06}, {"w": "ba", "t": 49.055, "d": 0.365}, {"w": "bài", "t": 49.42, "d": 0.175}, {"w": "toán", "t": 49.595, "d": 0.195}, {"w": "trong", "t": 49.79, "d": 0.13}, {"w": "chín", "t": 49.92, "d": 0.2}, {"w": "tháng.", "t": 50.12, "d": 0.35}]}, {"text": "Tiến độ rất chậm.", "start": 51.04, "end": 51.92, "words": [{"w": "Tiến", "t": 51.075, "d": 0.12}, {"w": "độ", "t": 51.195, "d": 0.22}, {"w": "rất", "t": 51.415, "d": 0.14}, {"w": "chậm.", "t": 51.555, "d": 0.175}]}, {"text": "Bạn còn nhớ chớp sáng ở đầu video chứ?", "start": 52.24, "end": 54.32, "words": [{"w": "Bạn", "t": 52.295, "d": 0.16}, {"w": "còn", "t": 52.455, "d": 0.13}, {"w": "nhớ", "t": 52.585, "d": 0.33}, {"w": "chớp", "t": 52.915, "d": 0.145}, {"w": "sáng", "t": 53.06, "d": 0.26}, {"w": "ở", "t": 53.32, "d": 0.155}, {"w": "đầu", "t": 53.475, "d": 0.195}, {"w": "video", "t": 53.67, "d": 0.11}, {"w": "chứ?", "t": 53.78, "d": 0.335}]}, {"text": "Lúc này, con đường dẫn tới nó đang tắc ngay trong căn phòng ấy.", "start": 54.92, "end": 58.2, "words": [{"w": "Lúc", "t": 54.99, "d": 0.105}, {"w": "này,", "t": 55.095, "d": 0.48}, {"w": "con", "t": 55.575, "d": 0.205}, {"w": "đường", "t": 55.78, "d": 0.06}, {"w": "dẫn", "t": 55.84, "d": 0.315}, {"w": "tới", "t": 56.155, "d": 0.2}, {"w": "nó", "t": 56.355, "d": 0.215}, {"w": "đang", "t": 56.57, "d": 0.06}, {"w": "tắc", "t": 56.63, "d": 0.335}, {"w": "ngay", "t": 56.965, "d": 0.16}, {"w": "trong", "t": 57.125, "d": 0.06}, {"w": "căn", "t": 57.185, "d": 0.2}, {"w": "phòng", "t": 57.385, "d": 0.27}, {"w": "ấy.", "t": 57.655, "d": 0.33}]}, {"text": "Người vận hành máy là lính của Đội Kỹ sư Đặc biệt.", "start": 59.2, "end": 62.08, "words": [{"w": "Người", "t": 59.2, "d": 0.19}, {"w": "vận", "t": 59.39, "d": 0.205}, {"w": "hành", "t": 59.595, "d": 0.2}, {"w": "máy", "t": 59.795, "d": 0.36}, {"w": "là", "t": 60.155, "d": 0.28}, {"w": "lính", "t": 60.435, "d": 0.06}, {"w": "của", "t": 60.495, "d": 0.205}, {"w": "Đội", "t": 60.7, "d": 0.255}, {"w": "Kỹ", "t": 60.955, "d": 0.39}, {"w": "sư", "t": 61.345, "d": 0.21}, {"w": "Đặc", "t": 61.555, "d": 0.11}, {"w": "biệt.", "t": 61.665, "d": 0.405}]}, {"text": "Quân đội chọn họ khắp nước vì có năng khiếu kỹ thuật, rồi đưa lên núi.", "start": 62.4, "end": 65.84, "words": [{"w": "Quân", "t": 62.4, "d": 0.23}, {"w": "đội", "t": 62.63, "d": 0.15}, {"w": "chọn", "t": 62.78, "d": 0.185}, {"w": "họ", "t": 62.965, "d": 0.16}, {"w": "khắp", "t": 63.125, "d": 0.285}, {"w": "nước", "t": 63.41, "d": 0.06}, {"w": "vì", "t": 63.47, "d": 0.225}, {"w": "có", "t": 63.695, "d": 0.125}, {"w": "năng", "t": 63.82, "d": 0.185}, {"w": "khiếu", "t": 64.005, "d": 0.2}, {"w": "kỹ", "t": 64.205, "d": 0.325}, {"w": "thuật,", "t": 64.53, "d": 0.285}, {"w": "rồi", "t": 64.815, "d": 0.085}, {"w": "đưa", "t": 64.9, "d": 0.17}, {"w": "lên", "t": 65.07, "d": 0.285}, {"w": "núi.", "t": 65.355, "d": 0.255}]}, {"text": "Họ đục lỗ lên thẻ những con số mà không ai giải thích là số gì.", "start": 66.16, "end": 69.44, "words": [{"w": "Họ", "t": 66.21, "d": 0.26}, {"w": "đục", "t": 66.47, "d": 0.18}, {"w": "lỗ", "t": 66.65, "d": 0.16}, {"w": "lên", "t": 66.81, "d": 0.065}, {"w": "thẻ", "t": 66.875, "d": 0.27}, {"w": "những", "t": 67.145, "d": 0.175}, {"w": "con", "t": 67.32, "d": 0.15}, {"w": "số", "t": 67.47, "d": 0.26}, {"w": "mà", "t": 67.73, "d": 0.16}, {"w": "không", "t": 67.89, "d": 0.14}, {"w": "ai", "t": 68.03, "d": 0.205}, {"w": "giải", "t": 68.235, "d": 0.205}, {"w": "thích", "t": 68.44, "d": 0.155}, {"w": "là", "t": 68.595, "d": 0.075}, {"w": "số", "t": 68.67, "d": 0.225}, {"w": "gì.", "t": 68.895, "d": 0.325}]}, {"text": "Họ chỉ biết đục.", "start": 69.76, "end": 70.56, "words": [{"w": "Họ", "t": 69.79, "d": 0.17}, {"w": "chỉ", "t": 69.96, "d": 0.135}, {"w": "biết", "t": 70.095, "d": 0.12}, {"w": "đục.", "t": 70.215, "d": 0.16}]}, {"text": "Feynman cho rằng chỗ tắc thật nằm ở đó.", "start": 70.88, "end": 72.96, "words": [{"w": "Feynman", "t": 70.96, "d": 0.27}, {"w": "cho", "t": 71.23, "d": 0.165}, {"w": "rằng", "t": 71.395, "d": 0.205}, {"w": "chỗ", "t": 71.6, "d": 0.06}, {"w": "tắc", "t": 71.66, "d": 0.315}, {"w": "thật", "t": 71.975, "d": 0.185}, {"w": "nằm", "t": 72.16, "d": 0.065}, {"w": "ở", "t": 72.225, "d": 0.29}, {"w": "đó.", "t": 72.515, "d": 0.235}]}, {"text": "Không phải ở máy.", "start": 73.28, "end": 75.44, "words": [{"w": "Không", "t": 73.28, "d": 0.375}, {"w": "phải", "t": 73.655, "d": 0.665}, {"w": "ở", "t": 74.32, "d": 0.09}, {"w": "máy.", "t": 74.41, "d": 0.88}]}, {"text": "Ông xin Oppenheimer, và được phép giảng cho họ biết họ đang làm gì.", "start": 76.44, "end": 80.04, "words": [{"w": "Ông", "t": 76.495, "d": 0.235}, {"w": "xin", "t": 76.73, "d": 0.29}, {"w": "Oppenheimer,", "t": 77.02, "d": 0.205}, {"w": "và", "t": 77.225, "d": 0.165}, {"w": "được", "t": 77.39, "d": 0.41}, {"w": "phép", "t": 77.8, "d": 0.16}, {"w": "giảng", "t": 77.96, "d": 0.18}, {"w": "cho", "t": 78.14, "d": 0.14}, {"w": "họ", "t": 78.28, "d": 0.195}, {"w": "biết", "t": 78.475, "d": 0.22}, {"w": "họ", "t": 78.695, "d": 0.23}, {"w": "đang", "t": 78.925, "d": 0.2}, {"w": "làm", "t": 79.125, "d": 0.285}, {"w": "gì.", "t": 79.41, "d": 0.38}]}, {"text": "Theo lời Feynman, cả nhóm như bừng tỉnh: giờ họ biết mình đang góp sức vào cuộc chiến.", "start": 80.36, "end": 84.52, "words": [{"w": "Theo", "t": 80.39, "d": 0.28}, {"w": "lời", "t": 80.67, "d": 0.125}, {"w": "Feynman,", "t": 80.795, "d": 0.39}, {"w": "cả", "t": 81.185, "d": 0.115}, {"w": "nhóm", "t": 81.3, "d": 0.215}, {"w": "như", "t": 81.515, "d": 0.175}, {"w": "bừng", "t": 81.69, "d": 0.295}, {"w": "tỉnh:", "t": 81.985, "d": 0.32}, {"w": "giờ", "t": 82.305, "d": 0.2}, {"w": "họ", "t": 82.505, "d": 0.06}, {"w": "biết", "t": 82.565, "d": 0.34}, {"w": "mình", "t": 82.905, "d": 0.15}, {"w": "đang", "t": 83.055, "d": 0.225}, {"w": "góp", "t": 83.28, "d": 0.165}, {"w": "sức", "t": 83.445, "d": 0.11}, {"w": "vào", "t": 83.555, "d": 0.2}, {"w": "cuộc", "t": 83.755, "d": 0.205}, {"w": "chiến.", "t": 83.96, "d": 0.375}]}, {"text": "Áp suất ra cao hơn nghĩa là năng lượng thoát ra nhiều hơn.", "start": 84.84, "end": 87.32, "words": [{"w": "Áp", "t": 84.84, "d": 0.21}, {"w": "suất", "t": 85.05, "d": 0.17}, {"w": "ra", "t": 85.22, "d": 0.195}, {"w": "cao", "t": 85.415, "d": 0.145}, {"w": "hơn", "t": 85.56, "d": 0.06}, {"w": "nghĩa", "t": 85.62, "d": 0.175}, {"w": "là", "t": 85.795, "d": 0.28}, {"w": "năng", "t": 86.075, "d": 0.13}, {"w": "lượng", "t": 86.205, "d": 0.215}, {"w": "thoát", "t": 86.42, "d": 0.165}, {"w": "ra", "t": 86.585, "d": 0.175}, {"w": "nhiều", "t": 86.76, "d": 0.155}, {"w": "hơn.", "t": 86.915, "d": 0.22}]}, {"text": "Những con số bỗng có nghĩa.", "start": 87.64, "end": 88.92, "words": [{"w": "Những", "t": 87.64, "d": 0.23}, {"w": "con", "t": 87.87, "d": 0.06}, {"w": "số", "t": 87.93, "d": 0.2}, {"w": "bỗng", "t": 88.13, "d": 0.18}, {"w": "có", "t": 88.31, "d": 0.12}, {"w": "nghĩa.", "t": 88.43, "d": 0.28}]}, {"text": "Còn nhóm tính tay thì không được giải thích như thế, theo nghiên cứu của Los Alamos.", "start": 89.24, "end": 93.4, "words": [{"w": "Còn", "t": 89.275, "d": 0.3}, {"w": "nhóm", "t": 89.575, "d": 0.18}, {"w": "tính", "t": 89.755, "d": 0.255}, {"w": "tay", "t": 90.01, "d": 0.215}, {"w": "thì", "t": 90.225, "d": 0.06}, {"w": "không", "t": 90.285, "d": 0.26}, {"w": "được", "t": 90.545, "d": 0.325}, {"w": "giải", "t": 90.87, "d": 0.15}, {"w": "thích", "t": 91.02, "d": 0.28}, {"w": "như", "t": 91.3, "d": 0.215}, {"w": "thế,", "t": 91.515, "d": 0.155}, {"w": "theo", "t": 91.67, "d": 0.405}, {"w": "nghiên", "t": 92.075, "d": 0.055}, {"w": "cứu", "t": 92.13, "d": 0.27}, {"w": "của", "t": 92.4, "d": 0.32}, {"w": "Los", "t": 92.72, "d": 0.065}, {"w": "Alamos.", "t": 92.785, "d": 0.405}]}, {"text": "Và con đường ấy rẽ ngoặt đúng ở khoảnh khắc này, trong một phòng máy đầy bụi.", "start": 94.4, "end": 97.84, "words": [{"w": "Và", "t": 94.4, "d": 0.095}, {"w": "con", "t": 94.495, "d": 0.275}, {"w": "đường", "t": 94.77, "d": 0.235}, {"w": "ấy", "t": 95.005, "d": 0.18}, {"w": "rẽ", "t": 95.185, "d": 0.135}, {"w": "ngoặt", "t": 95.32, "d": 0.17}, {"w": "đúng", "t": 95.49, "d": 0.165}, {"w": "ở", "t": 95.655, "d": 0.14}, {"w": "khoảnh", "t": 95.795, "d": 0.125}, {"w": "khắc", "t": 95.92, "d": 0.33}, {"w": "này,", "t": 96.25, "d": 0.28}, {"w": "trong", "t": 96.53, "d": 0.06}, {"w": "một", "t": 96.59, "d": 0.3}, {"w": "phòng", "t": 96.89, "d": 0.06}, {"w": "máy", "t": 96.95, "d": 0.155}, {"w": "đầy", "t": 97.105, "d": 0.2}, {"w": "bụi.", "t": 97.305, "d": 0.33}]}, {"text": "Bởi ngay sau buổi giảng ấy, những cậu lính bắt đầu tự nghĩ cách làm nhanh hơn.", "start": 98.16, "end": 102.0, "words": [{"w": "Bởi", "t": 98.16, "d": 0.17}, {"w": "ngay", "t": 98.33, "d": 0.205}, {"w": "sau", "t": 98.535, "d": 0.305}, {"w": "buổi", "t": 98.84, "d": 0.14}, {"w": "giảng", "t": 98.98, "d": 0.27}, {"w": "ấy,", "t": 99.25, "d": 0.27}, {"w": "những", "t": 99.52, "d": 0.075}, {"w": "cậu", "t": 99.595, "d": 0.33}, {"w": "lính", "t": 99.925, "d": 0.25}, {"w": "bắt", "t": 100.175, "d": 0.105}, {"w": "đầu", "t": 100.28, "d": 0.195}, {"w": "tự", "t": 100.475, "d": 0.245}, {"w": "nghĩ", "t": 100.72, "d": 0.135}, {"w": "cách", "t": 100.855, "d": 0.305}, {"w": "làm", "t": 101.16, "d": 0.125}, {"w": "nhanh", "t": 101.285, "d": 0.185}, {"w": "hơn.", "t": 101.47, "d": 0.35}]}], "imgs": {"feyn": {"src": "assets/long/mim-oppenheimer-feynman/img/feyn.jpg", "w": 500, "h": 579, "lic": "Public domain", "by": "United States Army", "pd": true}, "feyn0": {"src": "assets/long/mim-oppenheimer-feynman/img/feyn0.jpg", "w": 1920, "h": 2358, "lic": "CC0