motion/hf/assets/long\mim-qwerty\ch00\data.js:1:window.CASE = {"topic": "mim-qwerty", "ch": "ch00", "dur": 45.7, "seed": 9618, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "MỞ ĐẦU", "t": "HÀNG PHÍM KỲ LẠ"}, "acc": ["qwerty", "chậm", "tội", "phím", "thắng", "dvorak", "telex"], "lines": [{"text": "Bạn hãy nhìn xuống bàn phím một chút.", "start": 0.0, "end": 1.6, "words": [{"w": "Bạn", "t": 0.06, "d": 0.13}, {"w": "hãy", "t": 0.19, "d": 0.145}, {"w": "nhìn", "t": 0.335, "d": 0.195}, {"w": "xuống", "t": 0.53, "d": 0.13}, {"w": "bàn", "t": 0.66, "d": 0.21}, {"w": "phím", "t": 0.87, "d": 0.175}, {"w": "một", "t": 1.045, "d": 0.19}, {"w": "chút.", "t": 1.235, "d": 0.19}]}, {"text": "Hàng chữ đầu tiên, từ trái sang. Q, W, E, R, T, Y.", "start": 1.92, "end": 6.72, "words": [{"w": "Hàng", "t": 1.92, "d": 0.125}, {"w": "chữ", "t": 2.045, "d": 0.285}, {"w": "đầu", "t": 2.33, "d": 0.375}, {"w": "tiên,", "t": 2.705, "d": 0.175}, {"w": "từ", "t": 2.88, "d": 0.44}, {"w": "trái", "t": 3.32, "d": 0.23}, {"w": "sang.", "t": 3.55, "d": 0.265}, {"w": "Q,", "t": 3.815, "d": 0.275}, {"w": "W,", "t": 4.09, "d": 0.78}, {"w": "E,", "t": 4.87, "d": 0.31}, {"w": "R,", "t": 5.18, "d": 0.46}, {"w": "T,", "t": 5.64, "d": 0.17}, {"w": "Y.", "t": 5.81, "d": 0.71}]}, {"text": "Không phải A, B, C.", "start": 7.72, "end": 9.8, "words": [{"w": "Không", "t": 7.72, "d": 0.265}, {"w": "phải", "t": 7.985, "d": 0.4}, {"w": "A,", "t": 8.385, "d": 0.44}, {"w": "B,", "t": 8.825, "d": 0.3}, {"w": "C.", "t": 9.125, "d": 0.465}]}, {"text": "Không theo một thứ tự nào bạn từng học ở trường.", "start": 10.12, "end": 12.52, "words": [{"w": "Không", "t": 10.12, "d": 0.11}, {"w": "theo", "t": 10.23, "d": 0.22}, {"w": "một", "t": 10.45, "d": 0.165}, {"w": "thứ", "t": 10.615, "d": 0.195}, {"w": "tự", "t": 10.81, "d": 0.36}, {"w": "nào", "t": 11.17, "d": 0.18}, {"w": "bạn", "t": 11.35, "d": 0.065}, {"w": "từng", "t": 11.415, "d": 0.225}, {"w": "học", "t": 11.64, "d": 0.28}, {"w": "ở", "t": 11.92, "d": 0.165}, {"w": "trường.", "t": 12.085, "d": 0.275}]}, {"text": "Vậy mà cả thế giới gõ theo đúng thứ tự ấy, suốt gần một trăm năm mươi năm.", "start": 12.84, "end": 16.6, "words": [{"w": "Vậy", "t": 12.84, "d": 0.245}, {"w": "mà", "t": 13.085, "d": 0.165}, {"w": "cả", "t": 13.25, "d": 0.185}, {"w": "thế", "t": 13.435, "d": 0.22}, {"w": "giới", "t": 13.655, "d": 0.2}, {"w": "gõ", "t": 13.855, "d": 0.07}, {"w": "theo", "t": 13.925, "d": 0.235}, {"w": "đúng", "t": 14.16, "d": 0.16}, {"w": "thứ", "t": 14.32, "d": 0.12}, {"w": "tự", "t": 14.44, "d": 0.35}, {"w": "ấy,", "t": 14.79, "d": 0.29}, {"w": "suốt", "t": 15.08, "d": 0.075}, {"w": "gần", "t": 15.155, "d": 0.235}, {"w": "một", "t": 15.39, "d": 0.155}, {"w": "trăm", "t": 15.545, "d": 0.22}, {"w": "năm", "t": 15.765, "d": 0.12}, {"w": "mươi", "t": 15.885, "d": 0.175}, {"w": "năm.", "t": 16.06, "d": 0.375}]}, {"text": "Chắc bạn đã nghe một lời giải thích.", "start": 17.6, "end": 19.6, "words": [{"w": "Chắc", "t": 17.6, "d": 0.22}, {"w": "bạn", "t": 17.82, "d": 0.14}, {"w": "đã", "t": 17.96, "d": 0.29}, {"w": "nghe", "t": 18.25, "d": 0.235}, {"w": "một", "t": 18.485, "d": 0.375}, {"w": "lời", "t": 18.86, "d": 0.225}, {"w": "giải", "t": 19.085, "d": 0.235}, {"w": "thích.", "t": 19.32, "d": 0.28}]}, {"text": "Rằng người ta cố tình xếp lộn xộn như thế, để bạn gõ chậm lại.", "start": 19.92, "end": 23.12, "words": [{"w": "Rằng", "t": 19.92, "d": 0.225}, {"w": "người", "t": 20.145, "d": 0.16}, {"w": "ta", "t": 20.305, "d": 0.185}, {"w": "cố", "t": 20.49, "d": 0.2}, {"w": "tình", "t": 20.69, "d": 0.1}, {"w": "xếp", "t": 20.79, "d": 0.215}, {"w": "lộn", "t": 21.005, "d": 0.245}, {"w": "xộn", "t": 21.25, "d": 0.06}, {"w": "như", "t": 21.31, "d": 0.325}, {"w": "thế,", "t": 21.635, "d": 0.13}, {"w": "để", "t": 21.765, "d": 0.325}, {"w": "bạn", "t": 22.09, "d": 0.11}, {"w": "gõ", "t": 22.2, "d": 0.27}, {"w": "chậm", "t": 22.47, "d": 0.155}, {"w": "lại.", "t": 22.625, "d": 0.245}]}, {"text": "Nghe rất vô lý. Và cũng vì vô lý, nên nó lan đi rất xa.", "start": 23.44, "end": 26.72, "words": [{"w": "Nghe", "t": 23.44, "d": 0.215}, {"w": "rất", "t": 23.655, "d": 0.065}, {"w": "vô", "t": 23.72, "d": 0.345}, {"w": "lý.", "t": 24.065, "d": 0.225}, {"w": "Và", "t": 24.29, "d": 0.09}, {"w": "cũng", "t": 24.38, "d": 0.18}, {"w": "vì", "t": 24.56, "d": 0.34}, {"w": "vô", "t": 24.9, "d": 0.175}, {"w": "lý,", "t": 25.075, "d": 0.305}, {"w": "nên", "t": 25.38, "d": 0.06}, {"w": "nó", "t": 25.44, "d": 0.195}, {"w": "lan", "t": 25.635, "d": 0.175}, {"w": "đi", "t": 25.81, "d": 0.3}, {"w": "rất", "t": 26.11, "d": 0.125}, {"w": "xa.", "t": 26.235, "d": 0.275}]}, {"text": "Hôm nay, mình mở một phiên toà nhỏ, xử hàng phím này.", "start": 27.72, "end": 30.6, "words": [{"w": "Hôm", "t": 27.72, "d": 0.105}, {"w": "nay,", "t": 27.825, "d": 0.465}, {"w": "mình", "t": 28.29, "d": 0.065}, {"w": "mở", "t": 28.355, "d": 0.19}, {"w": "một", "t": 28.545, "d": 0.22}, {"w": "phiên", "t": 28.765, "d": 0.165}, {"w": "toà", "t": 28.93, "d": 0.31}, {"w": "nhỏ,", "t": 29.24, "d": 0.355}, {"w": "xử", "t": 29.595, "d": 0.06}, {"w": "hàng", "t": 29.655, "d": 0.285}, {"w": "phím", "t": 29.94, "d": 0.155}, {"w": "này.", "t": 30.095, "d": 0.315}]}, {"text": "Có ba lời buộc tội.", "start": 30.92, "end": 32.04, "words": [{"w": "Có", "t": 30.975, "d": 0.11}, {"w": "ba", "t": 31.085, "d": 0.16}, {"w": "lời", "t": 31.245, "d": 0.175}, {"w": "buộc", "t": 31.42, "d": 0.175}, {"w": "tội.", "t": 31.595, "d": 0.22}]}, {"text": "Một, nó sinh ra để làm bạn gõ chậm.", "start": 32.36, "end": 34.76, "words": [{"w": "Một,", "t": 32.475, "d": 0.41}, {"w": "nó", "t": 32.885, "d": 0.155}, {"w": "sinh", "t": 33.04, "d": 0.07}, {"w": "ra", "t": 33.11, "d": 0.225}, {"w": "để", "t": 33.335, "d": 0.315}, {"w": "làm", "t": 33.65, "d": 0.16}, {"w": "bạn", "t": 33.81, "d": 0.235}, {"w": "gõ", "t": 34.045, "d": 0.13}, {"w": "chậm.", "t": 34.175, "d": 0.365}]}, {"text": "Hai, nó thắng không phải vì nó tốt.", "start": 35.08, "end": 37.08, "words": [{"w": "Hai,", "t": 35.08, "d": 0.39}, {"w": "nó", "t": 35.47, "d": 0.175}, {"w": "thắng", "t": 35.645, "d": 0.06}, {"w": "không", "t": 35.705, "d": 0.205}, {"w": "phải", "t": 35.91, "d": 0.34}, {"w": "vì", "t": 36.25, "d": 0.215}, {"w": "nó", "t": 36.465, "d": 0.115}, {"w": "tốt.", "t": 36.58, "d": 0.32}]}, {"text": "Ba, có một bàn phím tốt hơn hẳn, và đã bị vùi dập.", "start": 37.4, "end": 40.52, "words": [{"w": "Ba,", "t": 37.565, "d": 0.375}, {"w": "có", "t": 37.94, "d": 0.155}, {"w": "một", "t": 38.095, "d": 0.06}, {"w": "bàn", "t": 38.155, "d": 0.25}, {"w": "phím", "t": 38.405, "d": 0.175}, {"w": "tốt", "t": 38.58, "d": 0.215}, {"w": "hơn", "t": 38.795, "d": 0.135}, {"w": "hẳn,", "t": 38.93, "d": 0.435}, {"w": "và", "t": 39.365, "d": 0.125}, {"w": "đã", "t": 39.49, "d": 0.09}, {"w": "bị", "t": 39.58, "d": 0.27}, {"w": "vùi", "t": 39.85, "d": 0.205}, {"w": "dập.", "t": 40.055, "d": 0.285}]}, {"text": "Mình sẽ xét từng lời một. Còn phán quyết, bạn là người quyết.", "start": 41.52, "end": 44.48, "words": [{"w": "Mình", "t": 41.52, "d": 0.135}, {"w": "sẽ", "t": 41.655, "d": 0.2}, {"w": "xét", "t": 41.855, "d": 0.18}, {"w": "từng", "t": 42.035, "d": 0.315}, {"w": "lời", "t": 42.35, "d": 0.19}, {"w": "một.", "t": 42.54, "d": 0.285}, {"w": "Còn", "t": 42.825, "d": 0.08}, {"w": "phán", "t": 42.905, "d": 0.145}, {"w": "quyết,", "t": 43.05, "d": 0.315}, {"w": "bạn", "t": 43.365, "d": 0.175}, {"w": "là", "t": 43.54, "d": 0.245}, {"w": "người", "t": 43.785, "d": 0.155}, {"w": "quyết.", "t": 43.94, "d": 0.365}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "broll", "vid": "v0", "veil": 0.45, "illus": "VIDEO MINH HỌA", "kin": [{"text": "NHÌN XUỐNG BÀN PHÍM", "at": 0.335, "acc": true, "fx": "sync", "wt": [0.335, 0.53, 0.66, 0.87], "t0": 0.0, "em": "XUỐNG"}], "t0": 0.0, "t1": 1.92}, {"type": "keyboard", "layout": "qwerty", "hl": "QWERTY", "hlAt": 3.815, "hlGap": 0.42, "label": {"k": "HÀNG CHỮ ĐẦU TIÊN", "v": "BÀN PHÍM DO KÊNH TỰ VẼ", "at": 1.92}, "t0": 1.92, "t1": 7.72}, {"type": "keyboard", "layout": "abc", "hl": "ABC", "hlAt": 8.385, "hlGap": 0.35, "label": {"k": "KHÔNG PHẢI A B C", "v": "BÀN PHÍM DO KÊNH TỰ VẼ", "at": 7.72}, "t0": 7.72, "t1": 10.12}, {"type": "kinetic", "items": [{"text": "KHÔNG THEO THỨ TỰ NÀO", "at": 10.12, "acc": true, "fx": "outline", "L": {"style": {"top": "428px", "fontSize": "85px"}}, "D": [{"kind": "frame", "style": {"top": "352px", "height": "313px", "width": "1267px", "left": "327px"}, "at": 9.82}], "em": "KHÔNG"}, {"text": "bạn từng học ở trường", "at": 11.35, "sm": true, "fx": "flicker", "L": {"style": {"top": "540px", "fontSize": "54px"}}}], "t0": 10.12, "t1": 12.84, "lay": "frame"}, {"type": "counter", "from": 0, "to": 150, "prefix": "~", "suffix": " NĂM", "until": 15.885, "label": "CẢ THẾ GIỚI GÕ THEO ĐÚNG THỨ TỰ ẤY", "t0": 12.84, "t1": 17.6, "at": 13.04}, {"type": "broll", "vid": "v5", "ms": 3, "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "MỘT LỜI GIẢI THÍCH QUEN TAI", "at": 17.6, "sm": true, "fx": "blur"}, {"text": "“ĐỂ BẠN GÕ CHẬM LẠI”", "at": 21.765, "acc": true, "fx": "flicker", "em": "CHẬM"}, {"text": "vô lý · nên lan rất xa", "at": 23.44, "sm": true, "fx": "rise"}], "t0": 17.6, "t1": 27.72}, {"type": "broll", "vid": "v6", "veil": 0.5, "illus": "VIDEO MINH HỌA", "kin": [{"text": "MỘT PHIÊN TOÀ NHỎ", "at": 28.545, "acc": true, "fx": "sync", "wt": [28.545, 28.765, 28.93, 29.24], "t0": 27.72, "em": "PHIÊN"}, {"text": "xử hàng phím này", "at": 29.595, "sm": true, "fx": "flicker"}], "t0": 27.72, "t1": 30.92}, {"type": "ledger", "title": "BA LỜI BUỘC TỘI", "rows": [{"k": "1", "v": "SINH RA ĐỂ LÀM BẠN GÕ CHẬM", "at": 32.36}, {"k": "2", "v": "THẮNG KHÔNG PHẢI VÌ TỐT", "at": 35.08}, {"k": "3", "v": "VÙI DẬP BÀN PHÍM TỐT HƠN", "at": 37.4}], "t0": 30.92, "t1": 41.52}, {"type": "question", "text": "Phán quyết:\nbạn là người quyết.", "t0": 41.52, "t1": 45.7}], "prog0": 0.0, "prog1": 0