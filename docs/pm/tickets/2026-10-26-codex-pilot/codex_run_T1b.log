}]}, {"text": "Từ hai chiếc card trong phòng ngủ, đến tám GPU trong một chiếc hộp, rồi đến những toà nhà chứa hàng nghìn GPU.", "start": 59.44, "end": 64.88, "words": [{"w": "Từ", "t": 59.525, "d": 0.175}, {"w": "hai", "t": 59.7, "d": 0.33}, {"w": "chiếc", "t": 60.03, "d": 0.195}, {"w": "card", "t": 60.225, "d": 0.205}, {"w": "trong", "t": 60.43, "d": 0.15}, {"w": "phòng", "t": 60.58, "d": 0.28}, {"w": "ngủ,", "t": 60.86, "d": 0.155}, {"w": "đến", "t": 61.015, "d": 0.325}, {"w": "tám", "t": 61.34, "d": 0.27}, {"w": "GPU", "t": 61.61, "d": 0.06}, {"w": "trong", "t": 61.67, "d": 0.27}, {"w": "một", "t": 61.94, "d": 0.21}, {"w": "chiếc", "t": 62.15, "d": 0.14}, {"w": "hộp,", "t": 62.29, "d": 0.455}, {"w": "rồi", "t": 62.745, "d": 0.06}, {"w": "đến", "t": 62.805, "d": 0.39}, {"w": "những", "t": 63.195, "d": 0.105}, {"w": "toà", "t": 63.3, "d": 0.145}, {"w": "nhà", "t": 63.445, "d": 0.21}, {"w": "chứa", "t": 63.655, "d": 0.235}, {"w": "hàng", "t": 63.89, "d": 0.345}, {"w": "nghìn", "t": 64.235, "d": 0.11}, {"w": "GPU.", "t": 64.345, "d": 0.345}]}, {"text": "Đó là con đường của trí tuệ nhân tạo trong một thập kỷ.", "start": 65.2, "end": 67.84, "words": [{"w": "Đó", "t": 65.31, "d": 0.235}, {"w": "là", "t": 65.545, "d": 0.06}, {"w": "con", "t": 65.605, "d": 0.275}, {"w": "đường", "t": 65.88, "d": 0.15}, {"w": "của", "t": 66.03, "d": 0.185}, {"w": "trí", "t": 66.215, "d": 0.145}, {"w": "tuệ", "t": 66.36, "d": 0.19}, {"w": "nhân", "t": 66.55, "d": 0.115}, {"w": "tạo", "t": 66.665, "d": 0.22}, {"w": "trong", "t": 66.885, "d": 0.095}, {"w": "một", "t": 66.98, "d": 0.24}, {"w": "thập", "t": 67.22, "d": 0.16}, {"w": "kỷ.", "t": 67.38, "d": 0.205}]}, {"text": "Chính card đồ hoạ chơi game cũng lớn lên.", "start": 68.84, "end": 70.92, "words": [{"w": "Chính", "t": 68.96, "d": 0.2}, {"w": "card", "t": 69.16, "d": 0.205}, {"w": "đồ", "t": 69.365, "d": 0.16}, {"w": "hoạ", "t": 69.525, "d": 0.135}, {"w": "chơi", "t": 69.66, "d": 0.18}, {"w": "game", "t": 69.84, "d": 0.27}, {"w": "cũng", "t": 70.11, "d": 0.105}, {"w": "lớn", "t": 70.215, "d": 0.255}, {"w": "lên.", "t": 70.47, "d": 0.215}]}, {"text": "Chiếc GTX 580 mà Alex dùng có năm trăm mười hai lõi tính toán.", "start": 71.24, "end": 75.72, "words": [{"w": "Chiếc", "t": 71.35, "d": 0.165}, {"w": "GTX", "t": 71.515, "d": 0.32}, {"w": "580", "t": 71.835, "d": 0.92}, {"w": "mà", "t": 72.755, "d": 0.24}, {"w": "Alex", "t": 72.995, "d": 0.345}, {"w": "dùng", "t": 73.34, "d": 0.235}, {"w": "có", "t": 73.575, "d": 0.06}, {"w": "năm", "t": 73.635, "d": 0.41}, {"w": "trăm", "t": 74.045, "d": 0.16}, {"w": "mười", "t": 74.205, "d": 0.2}, {"w": "hai", "t": 74.405, "d": 0.35}, {"w": "lõi", "t": 74.755, "d": 0.065}, {"w": "tính", "t": 74.82, "d": 0.295}, {"w": "toán.", "t": 75.115, "d": 0.385}]}, {"text": "Chiếc RTX 4090 ra mắt năm 2022 có mười sáu nghìn ba trăm tám mươi tư lõi.", "start": 76.04, "end": 81.8, "words": [{"w": "Chiếc", "t": 76.13, "d": 0.225}, {"w": "RTX", "t": 76.355, "d": 0.14}, {"w": "4090", "t": 76.495, "d": 1.08}, {"w": "ra", "t": 77.575, "d": 0.355}, {"w": "mắt", "t": 77.93, "d": 0.15}, {"w": "năm", "t": 78.08, "d": 0.14}, {"w": "2022", "t": 78.22, "d": 1.435}, {"w": "có", "t": 79.655, "d": 0.115}, {"w": "mười", "t": 79.77, "d": 0.155}, {"w": "sáu", "t": 79.925, "d": 0.3}, {"w": "nghìn", "t": 80.225, "d": 0.15}, {"w": "ba", "t": 80.375, "d": 0.235}, {"w": "trăm", "t": 80.61, "d": 0.17}, {"w": "tám", "t": 80.78, "d": 0.2}, {"w": "mươi", "t": 80.98, "d": 0.13}, {"w": "tư", "t": 81.11, "d": 0.145}, {"w": "lõi.", "t": 81.255, "d": 0.35}]}, {"text": "Gấp ba mươi hai lần, chỉ trong mười hai năm.", "start": 82.12, "end": 84.44, "words": [{"w": "Gấp", "t": 82.18, "d": 0.185}, {"w": "ba", "t": 82.365, "d": 0.17}, {"w": "mươi", "t": 82.535, "d": 0.15}, {"w": "hai", "t": 82.685, "d": 0.31}, {"w": "lần,", "t": 82.995, "d": 0.3}, {"w": "chỉ", "t": 83.295, "d": 0.06}, {"w": "trong", "t": 83.355, "d": 0.22}, {"w": "mười", "t": 83.575, "d": 0.275}, {"w": "hai", "t": 83.85, "d": 0.06}, {"w": "năm.", "t": 83.91, "d": 0.345}]}, {"text": "Một lưu ý nhỏ: lõi của GPU không so ngang được với lõi của CPU.", "start": 85.44, "end": 89.12, "words": [{"w": "Một", "t": 85.525, "d": 0.295}, {"w": "lưu", "t": 85.82, "d": 0.125}, {"w": "ý", "t": 85.945, "d": 0.3}, {"w": "nhỏ:", "t": 86.245, "d": 0.15}, {"w": "lõi", "t": 86.395, "d": 0.395}, {"w": "của", "t": 86.79, "d": 0.155}, {"w": "GPU", "t": 86.945, "d": 0.265}, {"w": "không", "t": 87.21, "d": 0.06}, {"w": "so", "t": 87.27, "d": 0.19}, {"w": "ngang", "t": 87.46, "d": 0.32}, {"w": "được", "t": 87.78, "d": 0.195}, {"w": "với", "t": 87.975, "d": 0.105}, {"w": "lõi", "t": 88.08, "d": 0.265}, {"w": "của", "t": 88.345, "d": 0.27}, {"w": "CPU.", "t": 88.615, "d": 0.315}]}, {"text": "Mỗi lõi GPU nhỏ và đơn giản hơn nhiều. Vẫn là chuyện phụ bếp và đầu bếp.", "start": 89.44, "end": 93.44, "words": [{"w": "Mỗi", "t": 89.495, "d": 0.155}, {"w": "lõi", "t": 89.65, "d": 0.33}, {"w": "GPU", "t": 89.98, "d": 0.215}, {"w": "nhỏ", "t": 90.195, "d": 0.205}, {"w": "và", "t": 90.4, "d": 0.2}, {"w": "đơn", "t": 90.6, "d": 0.1}, {"w": "giản", "t": 90.7, "d": 0.315}, {"w": "hơn", "t": 91.015, "d": 0.06}, {"w": "nhiều.", "t": 91.075, "d": 0.47}, {"w": "Vẫn", "t": 91.545, "d": 0.06}, {"w": "là", "t": 91.605, "d": 0.35}, {"w": "chuyện", "t": 91.955, "d": 0.06}, {"w": "phụ", "t": 92.015, "d": 0.245}, {"w": "bếp", "t": 92.26, "d": 0.205}, {"w": "và", "t": 92.465, "d": 0.305}, {"w": "đầu", "t": 92.77, "d": 0.06}, {"w": "bếp.", "t": 92.83, "d": 0.395}]}, {"text": "Điều thay đổi là số phụ bếp, và nhà bếp ngày càng giống một nhà máy.", "start": 93.76, "end": 97.28, "words": [{"w": "Điều", "t": 93.835, "d": 0.125}, {"w": "thay", "t": 93.96, "d": 0.33}, {"w": "đổi", "t": 94.29, "d": 0.19}, {"w": "là", "t": 94.48, "d": 0.175}, {"w": "số", "t": 94.655, "d": 0.1}, {"w": "phụ", "t": 94.755, "d": 0.29}, {"w": "bếp,", "t": 95.045, "d": 0.25}, {"w": "và", "t": 95.295, "d": 0.21}, {"w": "nhà", "t": 95.505, "d": 0.16}, {"w": "bếp", "t": 95.665, "d": 0.245}, {"w": "ngày", "t": 95.91, "d": 0.06}, {"w": "càng", "t": 95.97, "d": 0.225}, {"w": "giống", "t": 96.195, "d": 0.245}, {"w": "một", "t": 96.44, "d": 0.225}, {"w": "nhà", "t": 96.665, "d": 0.18}, {"w": "máy.", "t": 96.845, "d": 0.235}]}, {"text": "Và nhà máy ấy, từ năm 2023, bắt đầu nhìn về một nơi rất gần chúng ta.", "start": 98.28, "end": 103.48, "words": [{"w": "Và", "t": 98.365, "d": 0.28}, {"w": "nhà", "t": 98.645, "d": 0.15}, {"w": "máy", "t": 98.795, "d": 0.24}, {"w": "ấy,", "t": 99.035, "d": 0.315}, {"w": "từ", "t": 99.35, "d": 0.06}, {"w": "năm", "t": 99.41, "d": 0.27}, {"w": "2023,", "t": 99.68, "d": 1.425}, {"w": "bắt", "t": 101.105, "d": 0.155}, {"w": "đầu", "t": 101.26, "d": 0.37}, {"w": "nhìn", "t": 101.63, "d": 0.095}, {"w": "về", "t": 101.725, "d": 0.215}, {"w": "một", "t": 101.94, "d": 0.235}, {"w": "nơi", "t": 102.175, "d": 0.07}, {"w": "rất", "t": 102.245, "d": 0.26}, {"w": "gần", "t": 102.505, "d": 0.135}, {"w": "chúng", "t": 102.64, "d": 0.23}, {"w": "ta.", "t": 102.87, "d": 0.37}]}], "imgs": {"gf256": {"src": "assets/long/mim-ai-gpu/img/gf256.jpg", "w": 1920, "h": 1140, "lic": "Public domain", "by": "Hyins", "pd": true}, "jensen": {"src": "assets/long/mim-ai-gpu/img/jensen.jpg", "w": 960, "h": 1427, "lic": "CC BY 4.0", "by": "Photographer: Peter Dasilva", "pd": false}, "feifei": {"src": "assets/long/mim-ai-gpu/img/feifei.jpg", "w": 500, "h": 743, "lic": "CC BY 2.0", "by": "ITU Pictures", "pd": false}, "hinton": {"src": "assets/long/mim-ai-gpu/img/hinton.jpg", "w": 1920, "h": 2268, "lic": "CC BY 2.0", "by": "Vaughn Ridley/Collision via Sportsfile - Collision Conf", "pd": false}, "sutskever": {"src": "assets/long/mim-ai-gpu/img/sutskever.jpg", "w": 500, "h": 421, "lic": "CC BY 2.0", "by": "Steve Jurvetson from Los Altos, USA", "pd": false}, "gf110": {"src": "assets/long/mim-ai-gpu/img/gf110.jpg", "w": 1920, "h": 1280, "lic": "CC0", "by": "Fritzchens Fritz from Berlin", "pd": true}, "gp100": {"src": "assets/long/mim-ai-gpu/img/gp100.jpg", "w": 1920, "h": 1080,