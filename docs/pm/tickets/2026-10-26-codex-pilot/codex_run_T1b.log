motion/hf/assets/long\mim-alphago-lee-sedol\ch07\data.js:1:window.CASE = {"topic": "mim-alphago-lee-sedol", "ch": "ch07", "dur": 132.46, "seed": 29557, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 07", "t": "VÁN BỐN: NƯỚC 78"}, "acc": ["alphago", "sedol", "nước", "thua", "thắng", "vạn", "nghìn", "máy"], "lines": [{"text": "Ngày 13 tháng 3. Ván thứ tư.", "start": 0.0, "end": 1.76, "words": [{"w": "Ngày", "t": 0.0, "d": 0.19}, {"w": "13", "t": 0.19, "d": 0.26}, {"w": "tháng", "t": 0.45, "d": 0.295}, {"w": "3.", "t": 0.745, "d": 0.265}, {"w": "Ván", "t": 1.01, "d": 0.06}, {"w": "thứ", "t": 1.07, "d": 0.29}, {"w": "tư.", "t": 1.36, "d": 0.2}]}, {"text": "Lee Sedol cầm quân trắng, và đổi hẳn cách đánh.", "start": 2.56, "end": 5.28, "words": [{"w": "Lee", "t": 2.56, "d": 0.14}, {"w": "Sedol", "t": 2.7, "d": 0.355}, {"w": "cầm", "t": 3.055, "d": 0.165}, {"w": "quân", "t": 3.22, "d": 0.175}, {"w": "trắng,", "t": 3.395, "d": 0.51}, {"w": "và", "t": 3.905, "d": 0.09}, {"w": "đổi", "t": 3.995, "d": 0.215}, {"w": "hẳn", "t": 4.21, "d": 0.185}, {"w": "cách", "t": 4.395, "d": 0.27}, {"w": "đánh.", "t": 4.665, "d": 0.4}]}, {"text": "Ông để cho máy chiếm thật nhiều đất ở biên.", "start": 5.6, "end": 7.6, "words": [{"w": "Ông", "t": 5.645, "d": 0.085}, {"w": "để", "t": 5.73, "d": 0.27}, {"w": "cho", "t": 6.0, "d": 0.17}, {"w": "máy", "t": 6.17, "d": 0.185}, {"w": "chiếm", "t": 6.355, "d": 0.055}, {"w": "thật", "t": 6.41, "d": 0.185}, {"w": "nhiều", "t": 6.595, "d": 0.13}, {"w": "đất", "t": 6.725, "d": 0.24}, {"w": "ở", "t": 6.965, "d": 0.11}, {"w": "biên.", "t": 7.075, "d": 0.275}]}, {"text": "Còn mình thì chờ, để lao vào vùng trung tâm vào phút chót.", "start": 7.92, "end": 10.8, "words": [{"w": "Còn", "t": 7.92, "d": 0.1}, {"w": "mình", "t": 8.02, "d": 0.32}, {"w": "thì", "t": 8.34, "d": 0.22}, {"w": "chờ,", "t": 8.56, "d": 0.305}, {"w": "để", "t": 8.865, "d": 0.095}, {"w": "lao", "t": 8.96, "d": 0.255}, {"w": "vào", "t": 9.215, "d": 0.21}, {"w": "vùng", "t": 9.425, "d": 0.145}, {"w": "trung", "t": 9.57, "d": 0.185}, {"w": "tâm", "t": 9.755, "d": 0.17}, {"w": "vào", "t": 9.925, "d": 0.18}, {"w": "phút", "t": 10.105, "d": 0.155}, {"w": "chót.", "t": 10.26, "d": 0.335}]}, {"text": "Một lối đánh rất liều. Sai một nước là thua trắng.", "start": 11.12, "end": 13.76, "words": [{"w": "Một", "t": 11.18, "d": 0.135}, {"w": "lối", "t": 11.315, "d": 0.155}, {"w": "đánh", "t": 11.47, "d": 0.3}, {"w": "rất", "t": 11.77, "d": 0.235}, {"w": "liều.", "t": 12.005, "d": 0.28}, {"w": "Sai", "t": 12.285, "d": 0.085}, {"w": "một", "t": 12.37, "d": 0.16}, {"w": "nước", "t": 12.53, "d": 0.245}, {"w": "là", "t": 12.775, "d": 0.195}, {"w": "thua", "t": 12.97, "d": 0.175}, {"w": "trắng.", "t": 13.145, "d": 0.315}]}, {"text": "Mười một nước đầu tiên giống hệt ván hai.", "start": 14.76, "end": 17.24, "words": [{"w": "Mười", "t": 14.77, "d": 0.235}, {"w": "một", "t": 15.005, "d": 0.205}, {"w": "nước", "t": 15.21, "d": 0.29}, {"w": "đầu", "t": 15.5, "d": 0.265}, {"w": "tiên", "t": 15.765, "d": 0.36}, {"w": "giống", "t": 16.125, "d": 0.115}, {"w": "hệt", "t": 16.24, "d": 0.405}, {"w": "ván", "t": 16.645, "d": 0.2}, {"w": "hai.", "t": 16.845, "d": 0.39}]}, {"text": "Rồi ông rẽ sang hướng khác.", "start": 17.56, "end": 18.92, "words": [{"w": "Rồi", "t": 17.585, "d": 0.245}, {"w": "ông", "t": 17.83, "d": 0.17}, {"w": "rẽ", "t": 18.0, "d": 0.175}, {"w": "sang", "t": 18.175, "d": 0.075}, {"w": "hướng", "t": 18.25, "d": 0.13}, {"w": "khác.", "t": 18.38, "d": 0.335}]}, {"text": "Tới giữa ván, mọi thứ có vẻ lại như cũ.", "start": 19.92, "end": 22.32, "words": [{"w": "Tới", "t": 19.92, "d": 0.285}, {"w": "giữa", "t": 20.205, "d": 0.2}, {"w": "ván,", "t": 20.405, "d": 0.305}, {"w": "mọi", "t": 20.71, "d": 0.06}, {"w": "thứ", "t": 20.77, "d": 0.22}, {"w": "có", "t": 20.99, "d": 0.205}, {"w": "vẻ", "t": 21.195, "d": 0.155}, {"w": "lại", "t": 21.35, "d": 0.315}, {"w": "như", "t": 21.665, "d": 0.215}, {"w": "cũ.", "t": 21.88, "d": 0.28}]}, {"text": "Quân đen của AlphaGo dựng một bức tường lớn ở trung tâm.", "start": 22.64, "end": 25.44, "words": [{"w": "Quân", "t": 22.685, "d": 0.15}, {"w": "đen", "t": 22.835, "d": 0.22}, {"w": "của", "t": 23.055, "d": 0.265}, {"w": "AlphaGo", "t": 23.32, "d": 0.37}, {"w": "dựng", "t": 23.69, "d": 0.125}, {"w": "một", "t": 23.815, "d": 0.25}, {"w": "bức", "t": 24.065, "d": 0.185}, {"w": "tường", "t": 24.25, "d": 0.065}, {"w": "lớn", "t": 24.315, "d": 0.15}, {"w": "ở", "t": 24.465, "d": 0.34}, {"w": "trung", "t": 24.805, "d": 0.135}, {"w": "tâm.", "t": 24.94, "d": 0.28}]}, {"text": "Các bình luận viên bắt đầu nói về một tỉ số năm không.", "start": 25.76, "end": 28.32, "words": [{"w": "Các", "t": 25.76, "d": 0.09}, {"w": "bình", "t": 25.85, "d": 0.29}, {"w": "luận", "t": 26.14, "d": 0.08}, {"w": "viên", "t": 26.22, "d": 0.3}, {"w": "bắt", "t": 26.52, "d": 0.06}, {"w": "đầu", "t": 26.58, "d": 0.14}, {"w": "nói", "t": 26.72, "d": 0.24}, {"w": "về", "t": 26.96, "d": 0.16}, {"w": "một", "t": 27.12, "d": 0.24}, {"w": "tỉ", "t": 27.36, "d": 0.195}, {"w": "số", "t": 27.555, "d": 0.06}, {"w": "năm", "t": 27.615, "d": 0.285}, {"w": "không.", "t": 27.9, "d": 0.205}]}, {"text": "Và rồi tới nước thứ bảy mươi tám.", "start": 29.32, "end": 31.0, "words": [{"w": "Và", "t": 29.32, "d": 0.095}, {"w": "rồi", "t": 29.415, "d": 0.22}, {"w": "tới", "t": 29.635, "d": 0.155}, {"w": "nước", "t": 29.79, "d": 0.24}, {"w": "thứ", "t": 30.03, "d": 0.19}, {"w": "bảy", "t": 30.22, "d": 0.185}, {"w": "mươi", "t": 30.405, "d": 0.145}, {"w": "tám.", "t": 30.55, "d": 0.245}]}, {"text": "Lee Sedol đặt một quân trắng, chêm vào đúng giữa hai quân đen.", "start": 31.32, "end": 34.28, "words": [{"w": "Lee", "t": 31.325, "d": 0.11}, {"w": "Sedol", "t": 31.435, "d": 0.355}, {"w": "đặt", "t": 31.79, "d": 0.165}, {"w": "một", "t": 31.955, "d": 0.175}, {"w": "quân", "t": 32.13, "d": 0.195}, {"w": "trắng,", "t": 32.325, "d": 0.355}, {"w": "chêm", "t": 32.68, "d": 0.155}, {"w": "vào", "t": 32.835, "d": 0.06}, {"w": "đúng", "t": 32.895, "d": 0.21}, {"w": "giữa", "t": 33.105, "d": 0.275}, {"w": "hai", "t": 33.38, "d": 0.105}, {"w": "quân", "t": 33.485, "d": 0.335}, {"w": "đen.", "t": 33.82, "d": 0.245}]}, {"text": "Không ai trong phòng bình luận thấy trước nước này.", "start": 35.28, "end": 37.52, "words": [{"w": "Không", "t": 35.28, "d": 0.12}, {"w": "ai", "t": 35.4, "d": 0.245}, {"w": "trong", "t": 35.645, "d": 0.17}, {"w": "phòng", "t": 35.815, "d": 0.17}, {"w": "bình", "t": 35.985, "d": 0.34}, {"w": "luận", "t": 36.325, "d": 0.17}, {"w": "thấy", "t": 36.495, "d": 0.06}, {"w": "trước", "t": 36.555, "d": 0.285}, {"w": "nước", "t": 36.84, "d": 0.135}, {"w": "này.", "t": 36.975, "d": 0.36}]}, {"text": "Kỳ thủ Trung Quốc Cổ Lực gọi nó là nước cờ của thần.", "start": 37.84, "end": 40.8, "words": [{"w": "Kỳ", "t": 37.84, "d": 0.125}, {"w": "thủ", "t": 37.965, "d": 0.345}, {"w": "Trung", "t": 38.31, "d": 0.19}, {"w": "Quốc", "t": 38.5, "d": 0.185}, {"w": "Cổ", "t": 38.685, "d": 0.22}, {"w": "Lực", "t": 38.905, "d": 0.2}, {"w": "gọi", "t": 39.105, "d": 0.06}, {"w": "nó", "t": 39.165, "d": 0.275}, {"w": "là", "t": 39.44, "d": 0.155}, {"w": "nước", "t": 39.595, "d": 0.22}, {"w": "cờ", "t": 39.815, "d": 0.235}, {"w": "của", "t": 40.05, "d": 0.2}, {"w": "thần.", "t": 40.25, "d": 0.27}]}, {"text": "Sau này, DeepMind kiểm lại bên trong cỗ máy.", "start": 41.12, "end": 43.84, "words": [{"w": "Sau", "t": 41.19, "d": 0.345}, {"w": "này,", "t": 41.535, "d": 0.39}, {"w": "DeepMind", "t": 41.925, "d": 0.245}, {"w": "kiểm", "t": 42.17, "d": 0.06}, {"w": "lại", "t": 42.23, "d": 0.325}, {"w": "bên", "t": 42.555, "d": 0.33}, {"w": "trong", "t": 42.885, "d": 0.17}, {"w": "cỗ", "t": 43.055, "d": 0.195}, {"w": "máy.", "t": 43.25, "d": 0.435}]}, {"text": "AlphaGo cũng đã xét tới nước ấy.", "start": 44.16, "end": 46.0, "words": [{"w": "AlphaGo", "t": 44.19, "d": 0.435}, {"w": "cũng", "t": 44.625, "d": 0.18}, {"w": "đã", "t": 44.805, "d": 0.18}, {"w": "xét", "t": 44.985, "d": 0.11}, {"w": "tới", "t": 45.095, "d": 0.13}, {"w": "nước", "t": 45.225, "d": 0.275}, {"w": "ấy.", "t": 45.5, "d": 0.245}]}, {"text": "Và nó ước tính, xác suất một con người đi nước ấy, cũng chỉ khoảng một phần mười nghìn.", "start": 46.32, "end": 50.32, "words": [{"w": "Và", "t": 46.385, "d": 0.095}, {"w": "nó", "t": 46.48, "d": 0.28}, {"w": "ước", "t": 46.76, "d": 0.24}, {"w": "tính,", "t": 47.0, "d": 0.265}, {"w": "xác", "t": 47.265, "d": 0.06}, {"w": "suất", "t": 47.325, "d": 0.195}, {"w": "một", "t": 47.52, "d": 0.17}, {"w": "con", "t": 47.69, "d": 0.16}, {"w": "người", "t": 47.85, "d": 0.335}, {"w": "đi", "t": 48.185, "d": 0.105}, {"w": "nước", "t": 48.29, "d": 0.115}, {"w": "ấy,", "t": 48.405, "d": 0.435}, {"w": "cũng", "t": 48.84, "d": 0.06}, {"w": "chỉ", "t": 48.9, "d": 0.19}, {"w": "khoảng", "t": 49.09, "d": 0.165}, {"w": "một", "t": 49.255, "d": 0.19}, {"w": "phần", "t": 49.445, "d": 0.21}, {"w": "mười", "t": 49.655, "d": 0.2}, {"w": "nghìn.", "t": 49.855, "d": 0.28}]}, {"text": "Nên nó gần như không chuẩn bị cho khả năng ấy.", "start": 50.64, "end": 53.12, "words": [{"w": "Nên", "t": 50.64, "d": 0.285}, {"w": "nó", "t": 50.925, "d": 0.105}, {"w": "gần", "t": 51.03, "d": 0.215}, {"w": "như", "t": 51.245, "d": 0.195}, {"w": "không", "t": 51.44, "d": 0.34}, {"w": "chuẩn", "t": 51.78, "d": 0.115}, {"w": "bị", "t": 51.895, "d": 0.145}, {"w": "cho", "t": 52.04, "d": 0.39}, {"w": "khả", "t": 52.43, "d": 0.21}, {"w": "năng", "t": 52.64, "d": 0.07}, {"w": "ấy.", "t": 52.71, "d": 0.41}]}, {"text": "Lúc đó, cỗ máy vẫn tin rằng mình thắng tới bảy mươi phần trăm.", "start": 54.12, "end": 57.16, "words": [{"w": "Lúc", "t": 54.12, "d": 0.105}, {"w": "đó,", "t": 54.225, "d": 0.45}, {"w": "cỗ", "t": 54.675, "d": 0.07}, {"w": "máy", "t": 54.745, "d": 0.26}, {"w": "vẫn", "t": 55.005, "d": 0.24}, {"w": "tin", "t": 55.245, "d": 0.15}, {"w": "rằng", "t": 55.395, "d": 0.195}, {"w": "mình", "t": 55.59, "d": 0.21}, {"w": "thắng", "t": 55.8, "d": 0.18}, {"w": "tới", "t": 55.98, "d": 0.215}, {"w": "bảy", "t": 56.195, "d": 0.15}, {"w": "mươi", "t": 56.345, "d": 0.2}, {"w": "phần", "t": 56.545, "d": 0.14}, {"w": "trăm.", "t": 56.685, "d": 0.3}]}, {"text": "Nó đáp lại nước bảy mươi tám bằng một nước yếu.", "start": 57.48, "end": 59.8, "words": [{"w": "Nó", "t": 57.48, "d": 0.2}, {"w": "đáp", "t": 57.68, "d": 0.22}, {"w": "lại", "t": 57.9, "d": 0.18}, {"w": "nước", "t": 58.08, "d": 0.19}, {"w": "bảy", "t": 58.27, "d": 0.185}, {"w": "mươi", "t": 58.455, "d": 0.18}, {"w": "tám", "t": 58.635, "d": 0.145}, {"w": "bằng", "t": 58.78, "d": 0.22}, {"w": "một", "t": 59.0, "d": 0.17}, {"w": "nước", "t": 59.17, "d": 0.155}, {"w": "yếu.", "t": 59.325, "d": 0.25}]}, {"text": "Rồi qua vài nước nữa, con số ấy sụp đổ.", "start": 60.12, "end": 62.44, "words": [{"w": "Rồi", "t": 60.12, "d": 0.135}, {"w": "qua", "t": 60.255, "d": 0.18}, {"w": "vài", "t": 60.435, "d": 0.22}, {"w": "nước", "t": 60.655, "d": 0.305}, {"w": "nữa,", "t": 60.96, "d": 0.25}, {"w": "con", "t": 61.21, "d": 0.08}, {"w": "số", "t": 61.29, "d": 0.19}, {"w": "ấy", "t": 61.48, "d": 0.35}, {"w": "sụp", "t": 61.83, "d": 0.16}, {"w": "đổ.", "t": 61.99, "d": 0.265}]}, {"text": "Và AlphaGo bắt đầu đi những nước rất lạ.", "start": 62.76, "end": 65.32, "words": [{"w": "Và", "t": 62.76, "d": 0.235}, {"w": "AlphaGo", "t": 62.995, "d": 0.51}, {"w": "bắt", "t": 63.505, "d": 0.25}, {"w": "đầu", "t": 63.755, "d": 0.24}, {"w": "đi", "t": 63.995, "d": 0.19}, {"w": "những", "t": 64.185, "d": 0.365}, {"w": "nước", "t": 64.55, "d": 0.185}, {"w": "rất", "t": 64.735, "d": 0.085}, {"w": "lạ.", "t": 64.82, "d": 0.495}]}, {"text": "Lần này là lạ theo nghĩa xấu. Những nước mà một người mới học cũng thấy vô ích.", "start": 65.64, "end": 69.4, "words": [{"w": "Lần", "t": 65.71, "d": 0.1}, {"w": "này", "t": 65.81, "d": 0.23}, {"w": "là", "t": 66.04, "d": 0.295}, {"w": "lạ", "t": 66.335, "d": 0.105}, {"w": "theo", "t": 66.44, "d": 0.21}