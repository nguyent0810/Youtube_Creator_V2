motion/hf/assets/long\mim-ke-huy-diet-petrov\ch02\data.js:1:window.CASE = {"topic": "mim-ke-huy-diet-petrov", "ch": "ch02", "dur": 123.18, "seed": 32724, "accent": "#f59e0b", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 02", "t": "CON MẮT TRÊN QUỸ ĐẠO"}, "acc": ["báo", "máy", "phóng", "mây", "người", "ghế", "chưa", "tấn"], "lines": [{"text": "Petrov chưa báo, ít nhất là chưa ngay.", "start": 0.0, "end": 2.24, "words": [{"w": "Petrov", "t": 0.015, "d": 0.31}, {"w": "chưa", "t": 0.325, "d": 0.065}, {"w": "báo,", "t": 0.39, "d": 0.505}, {"w": "ít", "t": 0.895, "d": 0.2}, {"w": "nhất", "t": 1.095, "d": 0.195}, {"w": "là", "t": 1.29, "d": 0.165}, {"w": "chưa", "t": 1.455, "d": 0.13}, {"w": "ngay.", "t": 1.585, "d": 0.445}]}, {"text": "Theo bài năm 2004, kíp trực làm đúng từng bước trong bản hướng dẫn của ông.", "start": 3.24, "end": 7.48, "words": [{"w": "Theo", "t": 3.24, "d": 0.1}, {"w": "bài", "t": 3.34, "d": 0.315}, {"w": "năm", "t": 3.655, "d": 0.06}, {"w": "2004,", "t": 3.715, "d": 1.26}, {"w": "kíp", "t": 4.975, "d": 0.09}, {"w": "trực", "t": 5.065, "d": 0.34}, {"w": "làm", "t": 5.405, "d": 0.06}, {"w": "đúng", "t": 5.465, "d": 0.215}, {"w": "từng", "t": 5.68, "d": 0.23}, {"w": "bước", "t": 5.91, "d": 0.18}, {"w": "trong", "t": 6.09, "d": 0.195}, {"w": "bản", "t": 6.285, "d": 0.165}, {"w": "hướng", "t": 6.45, "d": 0.185}, {"w": "dẫn", "t": 6.635, "d": 0.205}, {"w": "của", "t": 6.84, "d": 0.18}, {"w": "ông.", "t": 7.02, "d": 0.22}]}, {"text": "Họ kiểm tra hoạt động của mọi hệ thống, ba mươi tầng kiểm tra, tầng này nối tầng kia.", "start": 7.8, "end": 12.2, "words": [{"w": "Họ", "t": 7.8, "d": 0.11}, {"w": "kiểm", "t": 7.91, "d": 0.335}, {"w": "tra", "t": 8.245, "d": 0.12}, {"w": "hoạt", "t": 8.365, "d": 0.23}, {"w": "động", "t": 8.595, "d": 0.3}, {"w": "của", "t": 8.895, "d": 0.155}, {"w": "mọi", "t": 9.05, "d": 0.26}, {"w": "hệ", "t": 9.31, "d": 0.2}, {"w": "thống,", "t": 9.51, "d": 0.155}, {"w": "ba", "t": 9.665, "d": 0.38}, {"w": "mươi", "t": 10.045, "d": 0.155}, {"w": "tầng", "t": 10.2, "d": 0.17}, {"w": "kiểm", "t": 10.37, "d": 0.285}, {"w": "tra,", "t": 10.655, "d": 0.33}, {"w": "tầng", "t": 10.985, "d": 0.065}, {"w": "này", "t": 11.05, "d": 0.265}, {"w": "nối", "t": 11.315, "d": 0.185}, {"w": "tầng", "t": 11.5, "d": 0.3}, {"w": "kia.", "t": 11.8, "d": 0.24}]}, {"text": "Kết quả đổ về: mọi thứ khớp.", "start": 12.52, "end": 14.36, "words": [{"w": "Kết", "t": 12.575, "d": 0.125}, {"w": "quả", "t": 12.7, "d": 0.2}, {"w": "đổ", "t": 12.9, "d": 0.18}, {"w": "về:", "t": 13.08, "d": 0.45}, {"w": "mọi", "t": 13.53, "d": 0.06}, {"w": "thứ", "t": 13.59, "d": 0.215}, {"w": "khớp.", "t": 13.805, "d": 0.35}]}, {"text": "Với BBC chín năm sau, ông lại nhớ là hai mươi tám hay hai mươi chín tầng.", "start": 15.36, "end": 18.48, "words": [{"w": "Với", "t": 15.36, "d": 0.095}, {"w": "BBC", "t": 15.455, "d": 0.535}, {"w": "chín", "t": 15.99, "d": 0.125}, {"w": "năm", "t": 16.115, "d": 0.115}, {"w": "sau,", "t": 16.23, "d": 0.285}, {"w": "ông", "t": 16.515, "d": 0.125}, {"w": "lại", "t": 16.64, "d": 0.145}, {"w": "nhớ", "t": 16.785, "d": 0.055}, {"w": "là", "t": 16.84, "d": 0.13}, {"w": "hai", "t": 16.97, "d": 0.18}, {"w": "mươi", "t": 17.15, "d": 0.215}, {"w": "tám", "t": 17.365, "d": 0.065}, {"w": "hay", "t": 17.43, "d": 0.215}, {"w": "hai", "t": 17.645, "d": 0.055}, {"w": "mươi", "t": 17.7, "d": 0.26}, {"w": "chín", "t": 17.96, "d": 0.145}, {"w": "tầng.", "t": 18.105, "d": 0.175}]}, {"text": "Chênh lệch nhỏ.", "start": 18.8, "end": 20.64, "words": [{"w": "Chênh", "t": 18.8, "d": 0.65}, {"w": "lệch", "t": 19.45, "d": 0.275}, {"w": "nhỏ.", "t": 19.725, "d": 0.705}]}, {"text": "Nhưng mình vẫn nói ra.", "start": 20.96, "end": 21.92, "words": [{"w": "Nhưng", "t": 20.985, "d": 0.115}, {"w": "mình", "t": 21.1, "d": 0.195}, {"w": "vẫn", "t": 21.295, "d": 0.1}, {"w": "nói", "t": 21.395, "d": 0.16}, {"w": "ra.", "t": 21.555, "d": 0.155}]}, {"text": "Vì gần như cả câu chuyện này đi qua trí nhớ của một người.", "start": 22.24, "end": 25.28, "words": [{"w": "Vì", "t": 22.24, "d": 0.115}, {"w": "gần", "t": 22.355, "d": 0.285}, {"w": "như", "t": 22.64, "d": 0.16}, {"w": "cả", "t": 22.8, "d": 0.125}, {"w": "câu", "t": 22.925, "d": 0.19}, {"w": "chuyện", "t": 23.115, "d": 0.36}, {"w": "này", "t": 23.475, "d": 0.135}, {"w": "đi", "t": 23.61, "d": 0.225}, {"w": "qua", "t": 23.835, "d": 0.2}, {"w": "trí", "t": 24.035, "d": 0.055}, {"w": "nhớ", "t": 24.09, "d": 0.18}, {"w": "của", "t": 24.27, "d": 0.25}, {"w": "một", "t": 24.52, "d": 0.275}, {"w": "người.", "t": 24.795, "d": 0.255}]}, {"text": "Vậy cỗ máy đang nói chuyện với bạn là ai?", "start": 25.6, "end": 27.52, "words": [{"w": "Vậy", "t": 25.665, "d": 0.14}, {"w": "cỗ", "t": 25.805, "d": 0.14}, {"w": "máy", "t": 25.945, "d": 0.19}, {"w": "đang", "t": 26.135, "d": 0.115}, {"w": "nói", "t": 26.25, "d": 0.15}, {"w": "chuyện", "t": 26.4, "d": 0.24}, {"w": "với", "t": 26.64, "d": 0.135}, {"w": "bạn", "t": 26.775, "d": 0.155}, {"w": "là", "t": 26.93, "d": 0.18}, {"w": "ai?", "t": 27.11, "d": 0.185}]}, {"text": "Nó tên là Oko, tiếng Nga nghĩa là con mắt.", "start": 28.12, "end": 30.28, "words": [{"w": "Nó", "t": 28.12, "d": 0.095}, {"w": "tên", "t": 28.215, "d": 0.175}, {"w": "là", "t": 28.39, "d": 0.225}, {"w": "Oko,", "t": 28.615, "d": 0.395}, {"w": "tiếng", "t": 29.01, "d": 0.14}, {"w": "Nga", "t": 29.15, "d": 0.06}, {"w": "nghĩa", "t": 29.21, "d": 0.305}, {"w": "là", "t": 29.515, "d": 0.06}, {"w": "con", "t": 29.575, "d": 0.25}, {"w": "mắt.", "t": 29.825, "d": 0.28}]}, {"text": "Nhà nghiên cứu Pavel Podvig, chuyên về lực lượng hạt nhân Nga, đã mô tả nó trong một bài báo khoa học năm 2002.", "start": 30.6, "end": 37.08, "words": [{"w": "Nhà", "t": 30.6, "d": 0.245}, {"w": "nghiên", "t": 30.845, "d": 0.225}, {"w": "cứu", "t": 31.07, "d": 0.165}, {"w": "Pavel", "t": 31.235, "d": 0.195}, {"w": "Podvig,", "t": 31.43, "d": 0.38}, {"w": "chuyên", "t": 31.81, "d": 0.145}, {"w": "về", "t": 31.955, "d": 0.15}, {"w": "lực", "t": 32.105, "d": 0.275}, {"w": "lượng", "t": 32.38, "d": 0.2}, {"w": "hạt", "t": 32.58, "d": 0.175}, {"w": "nhân", "t": 32.755, "d": 0.19}, {"w": "Nga,", "t": 32.945, "d": 0.255}, {"w": "đã", "t": 33.2, "d": 0.385}, {"w": "mô", "t": 33.585, "d": 0.115}, {"w": "tả", "t": 33.7, "d": 0.115}, {"w": "nó", "t": 33.815, "d": 0.38}, {"w": "trong", "t": 34.195, "d": 0.18}, {"w": "một", "t": 34.375, "d": 0.23}, {"w": "bài", "t": 34.605, "d": 0.13}, {"w": "báo", "t": 34.735, "d": 0.155}, {"w": "khoa", "t": 34.89, "d": 0.175}, {"w": "học", "t": 35.065, "d": 0.26}, {"w": "năm", "t": 35.325, "d": 0.3}, {"w": "2002.", "t": 35.625, "d": 1.265}]}, {"text": "Các vệ tinh Oko bay trên một quỹ đạo rất dẹt.", "start": 37.4, "end": 39.88, "words": [{"w": "Các", "t": 37.4, "d": 0.245}, {"w": "vệ", "t": 37.645, "d": 0.135}, {"w": "tinh", "t": 37.78, "d": 0.2}, {"w": "Oko", "t": 37.98, "d": 0.16}, {"w": "bay", "t": 38.14, "d": 0.205}, {"w": "trên", "t": 38.345, "d": 0.315}, {"w": "một", "t": 38.66, "d": 0.165}, {"w": "quỹ", "t": 38.825, "d": 0.23}, {"w": "đạo", "t": 39.055, "d": 0.185}, {"w": "rất", "t": 39.24, "d": 0.06}, {"w": "dẹt.", "t": 39.3, "d": 0.38}]}, {"text": "Điểm xa nhất cách mặt đất gần bốn mươi nghìn cây số.", "start": 40.2, "end": 43.16, "words": [{"w": "Điểm", "t": 40.2, "d": 0.17}, {"w": "xa", "t": 40.37, "d": 0.34}, {"w": "nhất", "t": 40.71, "d": 0.155}, {"w": "cách", "t": 40.865, "d": 0.18}, {"w": "mặt", "t": 41.045, "d": 0.315}, {"w": "đất", "t": 41.36, "d": 0.135}, {"w": "gần", "t": 41.495, "d": 0.32}, {"w": "bốn", "t": 41.815, "d": 0.205}, {"w": "mươi", "t": 42.02, "d": 0.06}, {"w": "nghìn", "t": 42.08, "d": 0.385}, {"w": "cây", "t": 42.465, "d": 0.065}, {"w": "số.", "t": 42.53, "d": 0.41}]}, {"text": "Điểm gần nhất chỉ chừng sáu trăm cây số.", "start": 43.48, "end": 45.72, "words": [{"w": "Điểm", "t": 43.48, "d": 0.195}, {"w": "gần", "t": 43.675, "d": 0.315}, {"w": "nhất", "t": 43.99, "d": 0.205}, {"w": "chỉ", "t": 44.195, "d": 0.06}, {"w": "chừng", "t": 44.255, "d": 0.21}, {"w": "sáu", "t": 44.465, "d": 0.245}, {"w": "trăm", "t": 44.71, "d": 0.24}, {"w": "cây", "t": 44.95, "d": 0.165}, {"w": "số.", "t": 45.115, "d": 0.4}]}, {"text": "Mỗi ngày, một vệ tinh quay đúng hai vòng.", "start": 46.04, "end": 48.36, "words": [{"w": "Mỗi", "t": 46.08, "d": 0.13}, {"w": "ngày,", "t": 46.21, "d": 0.48}, {"w": "một", "t": 46.69, "d": 0.06}, {"w": "vệ", "t": 46.75, "d": 0.17}, {"w": "tinh", "t": 46.92, "d": 0.385}, {"w": "quay", "t": 47.305, "d": 0.2}, {"w": "đúng", "t": 47.505, "d": 0.155}, {"w": "hai", "t": 47.66, "d": 0.115}, {"w": "vòng.", "t": 47.775, "d": 0.38}]}, {"text": "Điều lạ nằm ở góc nhìn.", "start": 48.68, "end": 49.88, "words": [{"w": "Điều", "t": 48.68, "d": 0.085}, {"w": "lạ", "t": 48.765, "d": 0.18}, {"w": "nằm", "t": 48.945, "d": 0.24}, {"w": "ở", "t": 49.185, "d": 0.135}, {"w": "góc", "t": 49.32, "d": 0.09}, {"w": "nhìn.", "t": 49.41, "d": 0.255}]}, {"text": "Vệ tinh không nhìn thẳng xuống nước Mỹ.", "start": 50.2, "end": 51.8, "words": [{"w": "Vệ", "t": 50.26, "d": 0.155}, {"w": "tinh", "t": 50.415, "d": 0.16}, {"w": "không", "t": 50.575, "d": 0.105}, {"w": "nhìn", "t": 50.68, "d": 0.23}, {"w": "thẳng", "t": 50.91, "d": 0.2}, {"w": "xuống", "t": 51.11, "d": 0.075}, {"w": "nước", "t": 51.185, "d": 0.2}, {"w": "Mỹ.", "t": 51.385, "d": 0.23}]}, {"text": "Nó nhìn xiên, sát mép Trái Đất.", "start": 52.12, "end": 53.88, "words": [{"w": "Nó", "t": 52.125, "d": 0.155}, {"w": "nhìn", "t": 52.28, "d": 0.185}, {"w": "xiên,", "t": 52.465, "d": 0.425}, {"w": "sát", "t": 52.89, "d": 0.1}, {"w": "mép", "t": 52.99, "d": 0.235}, {"w": "Trái", "t": 53.225, "d": 0.185}, {"w": "Đất.", "t": 53.41, "d": 0.275}]}, {"text": "Như vậy, luồng lửa của tên lửa sẽ hiện lên trên nền vũ trụ tối, chứ không lẫn vào mặt đất.", "start": 54.2, "end": 58.52, "words": [{"w": "Như", "t": 54.275, "d": 0.1}, {"w": "vậy,", "t": 54.375, "d": 0.415}, {"w": "luồng", "t": 54.79, "d": 0.195}, {"w": "lửa", "t": 54.985, "d": 0.135}, {"w": "của", "t": 55.12, "d": 0.105}, {"w": "tên", "t": 55.225, "d": 0.265}, {"w": "lửa", "t": 55.49, "d": 0.135}, {"w": "sẽ", "t": 55.625, "d": 0.145}, {"w": "hiện", "t": 55.77, "d": 0.28}, {"w": "lên", "t": 56.05, "d": 0.08}, {"w": "trên", "t": 56.13, "d": 0.19}, {"w": "nền", "t": 56.32, "d": 0.22}, {"w": "vũ", "t": 56.54, "d": 0.135}, {"w": "trụ", "t": 56.675, "d": 0.155}, {"w": "tối,", "t": 56.83, "d": 0.355}, {"w": "chứ", "t": 57.185, "d": 0.155}, {"w": "không", "t": 57.34, "d": 0.175}, {"w": "lẫn", "t": 57.515, "d": 0.12}, {"w": "vào", "t": 57.635, "d": 0.28}, {"w": "mặt", "t": 57.915, "d": 0.15}, {"w": "đất.", "t": 58.065, "d": 0.25}]}, {"text": "Theo Podvig, cách nhìn ấy cho phép dùng cảm biến đơn giản hơn của Mỹ.", "start": 58.84, "end": 62.36, "words": [{"w": "Theo", "t": 58.87, "d": 0.135}, {"w": "Podvig,", "t": 59.005, "d": 0.485}, {"w": "cách", "t": 59.49, "d": 0.195}, {"w": "nhìn", "t": 59.685, "d": 0.06}, {"w": "ấy", "t": 59.745, "d": 0.19}, {"w": "cho", "t": 59.935, "d": 0.33}, {"w": "phép", "t": 60.265, "d": 0.16}, {"w": "dùng", "t": 60.425, "d": 0.14}, {"w": "cảm", "t": 60.565, "d": 0.28}, {"w": "biến", "t": 60.845, "d": 0.2}, {"w": "đơn", "t": 61.045, "d": 0.215}, {"w": "giản", "t": 61.26, "d": 0.22}, {"w": "hơn", "t": 61.48, "d": 0.165}, {"w": "của", "t": 61.645, "d": 0.18}, {"w": "Mỹ.", "t": 61.825, "d": 0.385}]}, {"text": "Nhưng nó có giá.", "start": 62.68, "end": 64.92, "words": [{"w": "Nhưng", "t": 62.68, "d": 0.26}, {"w": "nó", "t": 62.94, "d": 0.86}, {"w": "có", "t": 63.8, "d": 0.06}, {"w": "giá.", "t": 63.86, "d": 0.955}]}, {"text": "Mỗi vệ tinh chỉ ở đúng chỗ chừng sáu tiếng mỗi ngày.", "start": 65.24, "end": 68.36, "words": [{"w": "Mỗi", "t": 65.24, "d": 0.155}, {"w": "vệ", "t": 65.395, "d": 0.165}, {"w": "tinh", "t": 65.56, "d": 0.195}, {"w": "chỉ", "t": 65.755, "d": 0.27}, {"w": "ở", "t": 66.025, "d": 0.195}, {"w": "đúng", "t": 66.22, "d": 0.105}, {"w": "chỗ", "t": 66.325, "d": 0.135}, {"w": "chừng", "t": 66.46, "d": 0.325}, {"w": "sáu", "t": 66.785, "d": 0.185}, {"w": "tiếng", "t": 66.97, "d": 0.18}, {"w": "mỗi", "t": 67.15, "d": 0.06}, {"w": "ngày.", "t": 67.21, "d": 0.34}]}, {"text": "Muốn canh suốt ngày đêm, cần ít nhất bốn chiếc.", "start": 68.68, "end": 71.16, "words": [{"w": "Muốn", "t": 68.73, "d": 0.21}, {"w": "canh", "t": 68.94, "d": 0.185}, {"w": "suốt", "t": 69.125, "d": 0.105}, {"w": "ngày", "t": 69.23, "d": 0.335}, {"w": "đêm,", "t": 69.565, "d": 0.285}, {"w": "cần", "t": 69.85, "d": 0.09}, {"w": "ít", "t": 69.94, "d": 0.315}, {"w": "nhất", "t": 70.255, "d": 0.25}, {"w": "bốn", "t": 70.505, "d": 0.06}, {"w": "chiếc.", "t": 70.565, "d": 0.375}]}, {"text": "Hệ thống được thiết kế cho tới chín chiếc cùng lúc.", "start": 71.48, "end": 74.36, "words": [{"w": "Hệ", "t": 71.48, "d": 0.23}, {"w": "thống", "t": 71.71, "d": 0.37}, {"w": "được", "t": 72.08, "d": 0.24}, {"w": "thiết", "t": 72.32, "d": 0.17}, {"w": "kế", "t": 72.49, "d": 0.2}, {"w": "cho", "t": 72.69, "d": 0.275}, {"w": "tới", "t": 72.965, "d": 0.225}, {"w": "chín", "t": 73.19, "d": 0.38}, {"w": "chiếc", "t": 73.57, "d": 0.195}, {"w": "cùng", "t": 73.765, "d": 0.265}, {"w": "lúc.", "t": 74.03, "d": 0.33}]}, {"text": "Và Podvig ghi thêm một lý do để nhiều vệ tinh cùng nhìn một chỗ.", "start": 74.68, "end": 78.04, "words": [{"w": "Và", "t": 74.68, "d": 0.11}, {"w": "Podvig", "t": 74.79, "d": 0.305}, {"w": "ghi", "t": 75.095, "d": 0.195}, {"w": "thêm", "t": 75.29, "d": 0.155}, {"w": "một", "t": 75.445, "d": 0.175}, {"w": "lý", "t": 75.62, "d": 0.265}, {"w": "do", "t": 75.885, "d": 0.29}, {"w": "để", "t": 76.175, "d": 0.205}, {"w": "nhiều", "t": 76.38, "d": 0.06}, {"w": "vệ", "t": 76.44, "d": 0.205}, {"w": "tinh", "t": 76.645, "d": 0.235}, {"w": "cùng", "t": 76.88, "d": 0.175}, {"w": "nhìn", "t": 77.055, "d": 0.195}, {"w": "một", "t": 77.25, "d": 0.255}, {"w": "chỗ.", "t": 77.505, "d": 0.325}]}, {"text": "Để chúng không bị chói cùng một lúc, bởi ánh nắng trực tiếp hay ánh phản chiếu từ mây.", "start": 78.36, "end": 82.12, "words": [{"w": "Để", "t": 78.36, "d": 0.12}, {"w": "chúng", "t": 78.48, "d": 0.16}, {"w": "không", "t": 78.64, "d": 0.32}, {"w": "bị", "t": 78.96, "d": 0.18}, {"w": "chói", "t": 79.14, "d": 0.165}, {"w": "cùng", "t": 79.305, "d": 0.1}, {"w": "một", "t": 79.405, "d": 0.265}, {"w": "lúc,", "t": 79.67, "d": 0.175}, {"w": "bởi", "t": 79.845, "d": 0.285}, {"w": "ánh", "t": 80.13, "d": 0.06}, {"w": "nắng", "t": 80.19, "d": 0.225}, {"w": "trực", "t": 80.415, "d": 0.175}, {"w": "tiếp", "t": 80.59, "d": 0.21}, {"w": "hay", "t": 80.8, "d": 0.12}, {"w": "ánh", "t": 80.92, "d": 0.275}, {"w": "phản", "t": 81.195, "d": 0.055}, {"w": "chiếu", "t": 81.25, "d": 0.16}, {"w": "từ", "t": 81.41, "d": 0.215}, {"w": "mây.", "t": 81.625, "d": 0.31}]}, {"text": "Bạn hãy nhớ chữ \"mây\" này.", "start": 82.44, "end": 83.64, "words": [{"w": "Bạn", "t": 82.515, "d": 0.125}, {"w": "hãy", "t": 82.64, "d": 0.14}, {"w": "nhớ", "t": 82.78, "d": 0.2}, {"w": "chữ", "t": 82.98, "d": 0.13}, {"w": "\"mây\"", "t": 83.11, "d": 0.17}, {"w": "này.", "t": 83.28, "d": 0.18}]}, {"text": "Oko còn rất mới.", "start": 84.64, "end": 85.76, "words": [{"w": "Oko", "t": 84.645, "d": 0.155}, {"w": "còn", "t": 84.8, "d": 0.175}, {"w": "rất", "t": 84.975, "d": 0.3}, {"w": "mới.", "t": 85.275, "d": 0.3}]}, {"text": "Hệ thống chạy hạn chế từ năm 1978, và chỉ được đưa vào trực chiến năm 1982.", "start": 86.08, "end": 91.36, "words": [{"w": "Hệ", "t": 86.09, "d": 0.1}, {"w": "thống", "t": 86.19, "d": 0.16}, {"w": "chạy", "t": 86.35, "d": 0.305}, {"w": "hạn", "t": 86.655, "d": 0.18}, {"w": "chế", "t": 86.835, "d": 0.165}, {"w": "từ", "t": 87.0, "d": 0.105}, {"w": "năm", "t": 87.105, "d": 0.13}, {"w": "1978,", "t": 87.235, "d": 1.245}, {"w": "và", "t": 88.48, "d": 0.18}, {"w": "chỉ", "t": 88.66, "d": 0.215}, {"w": "được", "t": 88.875, "d": 0.19}, {"w": "đưa", "t": 89.065, "d": 0.15}, {"w": "vào", "t": 89.215, "d": 0.245}, {"w": "trực", "t": 89.46, "d": 0.17}, {"w": "chiến", "t": 89.63, "d": 0.17}, {"w": "năm", "t": 89.8, "d": 0.06}, {"w": "1982.", "t": 89.86, "d": 1.32}]}, {"text": "Podvig viết rằng chương trình này dính đủ thứ trục trặc, từ con tàu vũ trụ đến phần mềm.", "start": 91.68, "end": 96.0, "words": [{"w": "Podvig", "t": 91.68, "d": 0.265}, {"w": "viết", "t": 91.945, "d": 0.15}, {"w": "rằng", "t": 92.095, "d": 0.285}, {"w": "chương", "t": 92.38, "d": 0.06}, {"w": "trình", "t": 92.44, "d": 0.17}, {"w": "này", "t": 92.61, "d": 0.385}, {"w": "dính", "t": 92.995, "d": 0.195}, {"w": "đủ", "t": 93.19, "d": 0.195}, {"w": "thứ", "t": 93.385, "d": 0.195}, {"w": "trục", "t": 93.58, "d": 0.155}, {"w": "trặc,", "t": 93.735, "d": 0.39}, {"w": "từ", "t": 94.125, "d": 0.19}, {"w": "con", "t": 94.315, "d": 0.06}, {"w": "tàu", "t": 94.375, "d": 0.24}, {"w": "vũ", "t": 94.615, "d": 0.17}, {"w": "trụ", "t": 94.785, "d": 0.305}, {"w": "đến", "t": 95.09, "d": 0.27}, {"w": "phần", "t": 95.36, "d": 0.17}, {"w": "mềm.", "t": 95.53, "d": 0.295}]}, {"text": "Trong mười ba vệ tinh đầu tiên, chỉ bảy chiếc chạy được quá một trăm ngày.", "start": 96.32, "end": 99.68, "words": [{"w": "Trong", "t": 96.38, "d": 0.125}, {"w": "mười", "t": 96.505, "d": 0.16}, {"w": "ba", "t": 96.665, "d": 0.325}, {"w": "vệ", "t": 96.99, "d": 0.14}, {"w": "tinh", "t": 97.13, "d": 0.14}, {"w": "đầu", "t": 97.27, "d": 0.26}, {"w": "tiên,", "t": 97.53, "d": 0.225}, {"w": "chỉ", "t": 97.755, "d": 0.1}, {"w": "bảy", "t": 97.855, "d": 0.165}, {"w": "chiếc", "t": 98.02, "d": 0.235}, {"w": "chạy", "t": 98.255, "d": 0.16}, {"w": "được", "t": 98.415, "d": 0.3}, {"w": "quá", "t": 98.715, "d": 0.055}, {"w": "một", "t": 98.77, "d": 0.225}, {"w": "trăm", "t": 98.995, "d": 0.105}, {"w": "ngày.", "t": 99.1, "d": 0.37}]}, {"text": "Mỗi vệ tinh còn mang một bộ tự huỷ, kích hoạt khi mất liên lạc với mặt đất.", "start": 100.0, "end": 103.92, "words": [{"w": "Mỗi", "t": 100.0, "d": 0.135}, {"w": "vệ", "t": 100.135, "d": 0.18}, {"w": "tinh", "t": 100.315, "d": 0.205}, {"w": "còn", "t": 100.52, "d": 0.17}, {"w": "mang", "t": 100.69, "d": 0.365}, {"w": "một", "t": 101.055, "d": 0.06}, {"w": "bộ", "t": 101.115, "d": 0.185}, {"w": "tự", "t": 101.3, "d": 0.17}, {"w": "huỷ,", "t": 101.47, "d": 0.435}, {"w": "kích", "t": 101.905, "d": 0.22}, {"w": "hoạt", "t": 102.125, "d": 0.06}, {"w": "khi", "t": 102.185, "d": 0.185}, {"w": "mất", "t": 102.37, "d": 0.26}, {"w": "liên", "t": 102.63, "d": 0.3}, {"w": "lạc", "t": 102.93, "d": 0.06}, {"w": "với", "t": 102.99, "d": 0.335}, {"w": "mặt", "t": 103.325, "d": 0.06}, {"w": "đất.", "t": 103.385, "d": 0.365}]}, {"text": "Tới năm 1983 người ta mới gỡ bộ ấy ra.", "start": 104.24, "end": 107.52, "words": [{"w": "Tới", "t": 104.265, "d": 0.255}, {"w": "năm", "t": 104.52, "d": 0.13}, {"w": "1983", "t": 104.65, "d": 1.335}, {"w": "người", "t": 105.985, "d": 0.06}, {"w": "ta", "t": 106.045, "d": 0.255}, {"w": "mới", "t": 106.3, "d": 0.18}, {"w": "gỡ", "t": 106.48, "d": 0.185}, {"w": "bộ", "t": 106.665, "d": 0.175}, {"w": "ấy", "t": 106.84, "d": 0.23}, {"w": "ra.", "t": 107.07, "d": 0.23}]}, {"text": "Lúc đó, mười một trong ba mươi mốt vệ tinh đã tự nổ tung theo cách này.", "start": 107.84, "end": 111.6, "words": [{"w": "Lúc", "t": 107.895, "d": 0.105}, {"w": "đó,", "t": 108.0, "d": 0.44}, {"w": "mười", "t": 108.44, "d": 0.12}, {"w": "một", "t": 108.56, "d": 0.21}, {"w": "trong", "t": 108.77, "d": 0.15}, {"w": "ba", "t": 108.92, "d": 0.16}, {"w": "mươi", "t": 109.08, "d": 0.29}, {"w": "mốt", "t": 109.37, "d": 0.16}, {"w": "vệ", "t": 109.53, "d": 0.23}, {"w": "tinh", "t": 109.76, "d": 0.26}, {"w": "đã", "t": 110.02, "d": 0.195}, {"w": "tự", "t": 110.215, "d": 0.06}, {"w": "nổ", "t": 110.275, "d": 0.155}, {"w": "tung", "t": 110.43, "d": 0.31}, {"w": "theo", "t": 110.74, "d": 0.225}, {"w": "cách", "t": 110.965, "d": 0.13}, {"w": "này.", "t": 111.095, "d": 0.315}]}, {"text": "Mẩu tin thứ hai.", "start": 111.92, "end": 112.8, "words": [{"w": "Mẩu", "t": 111.96, "d": 0.135}, {"w": "tin", "t": 112.095, "d": 0.14}, {"w": "thứ", "t": 112.235, "d": 0.11}, {"w": "hai.", "t": 112.345, "d": 0.25}]}, {"text": "Con mắt đang báo động là một con mắt mới, từng hỏng nhiều lần.", "start": 113.12, "end": 116.24, "words": [{"w": "Con", "t": 113.12, "d": 0.225}, {"w": "mắt", "t": 113.345, "d": 0.165}, {"w": "đang", "t": 113.51, "d": 0.17}, {"w": "báo", "t": 113.68, "d": 0.145}, {"w": "động", "t": 113.825, "d": 0.2}, {"w": "là", "t": 114.025, "d": 0.21}, {"w": "một", "t": 114.235, "d": 0.27}, {"w": "con", "t": 114.505, "d": 0.06}, {"w": "mắt", "t": 114.565, "d": 0.345}, {"w": "mới,", "t": 114.91, "d": 0.305}, {"w": "từng", "t": 115.215, "d": 0.06}, {"w": "hỏng", "t": 115.275, "d": 0.24}, {"w": "nhiều", "t": 115.515, "d": 0.23}, {"w": "lần.", "t": 115.745, "d": 0.265}]}, {"text": "Nhưng đêm nay, nó vừa qua mọi tầng kiểm tra.", "start": 116.56, "end": 118.96, "words": [{"w": "Nhưng", "t": 116.62, "d": 0.1}, {"w": "đêm", "t": 116.72, "d": 0.355}, {"w": "nay,", "t": 117.075, "d": 0.275}, {"w": "nó", "t": 117.35, "d": 0.075}, {"w": "vừa", "t": 117.425, "d": 0.325}, {"w": "qua", "t": 117.75, "d": 0.06}, {"w": "mọi", "t": 117.81, "d": 0.275}, {"w": "tầng", "t": 118.085, "d": 0.18}, {"w": "kiểm", "t": 118.265, "d": 0.195}, {"w": "tra.", "t": 118.46, "d": 0.27}]}, {"text": "Biết vậy rồi, bạn có nhấc máy báo lên không?", "start": 119.28, "end": 121.68, "words": [{"w": "Biết", "t": 119.28, "d": 0.225}, {"w": "vậy", "t": 119.505, "d": 0.26}, {"w": "rồi,", "t": 119.765, "d": 0.15}, {"w": "bạn", "t": 119.915, "d": 0.195}, {"w": "có", "t": 120.11, "d": 0.305}, {"w": "nhấc", "t": 120.415, "d": 0.27}, {"w": "máy", "t": 120.685, "d": 0.06}, {"w": "báo", "t": 120.745, "d": 0.17}, {"w": "lên", "t": 120.915, "d": 0.37}, {"w": "không?", "t": 121.285, "d": 0.235}]}], "imgs": {"serp": {"src": "assets/long/mim-ke-huy-diet-petrov/img/serp.jpg", "w": 500, "h": 261, "lic": "Public domain", "by": "Imagery from LANCE FIRMS operated by NASA's Earth Science Data and Information System (ESDIS) with funding provided by N", "pd": true}, "mm3": {"src": "assets/lon