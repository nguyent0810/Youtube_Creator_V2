": 8.48, "d": 0.125}, {"w": "dữ", "t": 8.605, "d": 0.355}, {"w": "liệu", "t": 8.96, "d": 0.19}, {"w": "và", "t": 9.15, "d": 0.205}, {"w": "phân", "t": 9.355, "d": 0.23}, {"w": "tích", "t": 9.585, "d": 0.155}, {"w": "của", "t": 9.74, "d": 0.26}, {"w": "Watson", "t": 10.0, "d": 0.215}, {"w": "Health", "t": 10.215, "d": 0.19}, {"w": "cho", "t": 10.405, "d": 0.165}, {"w": "một", "t": 10.57, "d": 0.085}, {"w": "quỹ", "t": 10.655, "d": 0.345}, {"w": "đầu", "t": 11.0, "d": 0.16}, {"w": "tư.", "t": 11.16, "d": 0.34}]}, {"text": "Giá không được công bố. Hãng tin Bloomberg đưa tin là hơn một tỷ đô la.", "start": 12.0, "end": 15.84, "words": [{"w": "Giá", "t": 12.09, "d": 0.115}, {"w": "không", "t": 12.205, "d": 0.285}, {"w": "được", "t": 12.49, "d": 0.12}, {"w": "công", "t": 12.61, "d": 0.38}, {"w": "bố.", "t": 12.99, "d": 0.195}, {"w": "Hãng", "t": 13.185, "d": 0.23}, {"w": "tin", "t": 13.415, "d": 0.19}, {"w": "Bloomberg", "t": 13.605, "d": 0.165}, {"w": "đưa", "t": 13.77, "d": 0.31}, {"w": "tin", "t": 14.08, "d": 0.23}, {"w": "là", "t": 14.31, "d": 0.2}, {"w": "hơn", "t": 14.51, "d": 0.225}, {"w": "một", "t": 14.735, "d": 0.165}, {"w": "tỷ", "t": 14.9, "d": 0.155}, {"w": "đô", "t": 15.055, "d": 0.215}, {"w": "la.", "t": 15.27, "d": 0.33}]}, {"text": "IBM vẫn giữ công nghệ trí tuệ nhân tạo cốt lõi mang tên Watson.", "start": 16.84, "end": 20.44, "words": [{"w": "IBM", "t": 16.84, "d": 0.615}, {"w": "vẫn", "t": 17.455, "d": 0.16}, {"w": "giữ", "t": 17.615, "d": 0.32}, {"w": "công", "t": 17.935, "d": 0.055}, {"w": "nghệ", "t": 17.99, "d": 0.195}, {"w": "trí", "t": 18.185, "d": 0.355}, {"w": "tuệ", "t": 18.54, "d": 0.055}, {"w": "nhân", "t": 18.595, "d": 0.24}, {"w": "tạo", "t": 18.835, "d": 0.165}, {"w": "cốt", "t": 19.0, "d": 0.35}, {"w": "lõi", "t": 19.35, "d": 0.135}, {"w": "mang", "t": 19.485, "d": 0.27}, {"w": "tên", "t": 19.755, "d": 0.15}, {"w": "Watson.", "t": 19.905, "d": 0.29}]}, {"text": "Cái tên ấy vẫn còn, trên những sản phẩm cho doanh nghiệp.", "start": 20.76, "