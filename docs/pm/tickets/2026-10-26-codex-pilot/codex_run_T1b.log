motion/hf/assets/long\mim-siri-susan-bennett\ch03\data.js:1:window.CASE = {"topic": "mim-siri-susan-bennett", "ch": "ch03", "dur": 94.9, "seed": 33036, "accent": "#f472b6", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 03", "t": "KÉO CUỘN BĂNG RA: NHỮNG MẢNH ÂM"}, "acc": ["giọng", "mảnh", "băng", "ghép", "người", "nấc", "cắt", "thật"], "lines": [{"text": "Hãy hình dung cả tháng thu âm ấy là một dải băng rất dài.", "start": 0.0, "end": 2.88, "words": [{"w": "Hãy", "t": 0.015, "d": 0.255}, {"w": "hình", "t": 0.27, "d": 0.185}, {"w": "dung", "t": 0.455, "d": 0.14}, {"w": "cả", "t": 0.595, "d": 0.2}, {"w": "tháng", "t": 0.795, "d": 0.195}, {"w": "thu", "t": 0.99, "d": 0.175}, {"w": "âm", "t": 1.165, "d": 0.195}, {"w": "ấy", "t": 1.36, "d": 0.16}, {"w": "là", "t": 1.52, "d": 0.06}, {"w": "một", "t": 1.58, "d": 0.33}, {"w": "dải", "t": 1.91, "d": 0.06}, {"w": "băng", "t": 1.97, "d": 0.19}, {"w": "rất", "t": 2.16, "d": 0.285}, {"w": "dài.", "t": 2.445, "d": 0.225}]}, {"text": "Máy cắt dải băng thành rất nhiều mảnh nhỏ.", "start": 3.68, "end": 5.68, "words": [{"w": "Máy", "t": 3.76, "d": 0.255}, {"w": "cắt", "t": 4.015, "d": 0.06}, {"w": "dải", "t": 4.075, "d": 0.18}, {"w": "băng", "t": 4.255, "d": 0.22}, {"w": "thành", "t": 4.475, "d": 0.23}, {"w": "rất", "t": 4.705, "d": 0.14}, {"w": "nhiều", "t": 4.845, "d": 0.245}, {"w": "mảnh", "t": 5.09, "d": 0.13}, {"w": "nhỏ.", "t": 5.22, "d": 0.265}]}, {"text": "Mỗi mảnh ngắn hơn một âm tiết, có khi chỉ bằng nửa một âm.", "start": 6.0, "end": 9.12, "words": [{"w": "Mỗi", "t": 6.0, "d": 0.235}, {"w": "mảnh", "t": 6.235, "d": 0.065}, {"w": "ngắn", "t": 6.3, "d": 0.345}, {"w": "hơn", "t": 6.645, "d": 0.1}, {"w": "một", "t": 6.745, "d": 0.18}, {"w": "âm", "t": 6.925, "d": 0.27}, {"w": "tiết,", "t": 7.195, "d": 0.29}, {"w": "có", "t": 7.485, "d": 0.06}, {"w": "khi", "t": 7.545, "d": 0.205}, {"w": "chỉ", "t": 7.75, "d": 0.175}, {"w": "bằng", "t": 7.925, "d": 0.19}, {"w": "nửa", "t": 8.115, "d": 0.195}, {"w": "một", "t": 8.31, "d": 0.35}, {"w": "âm.", "t": 8.66, "d": 0.225}]}, {"text": "Mỗi mảnh được dán nhãn: âm gì, cao hay thấp, đứng cạnh âm nào.", "start": 9.44, "end": 12.88, "words": [{"w": "Mỗi", "t": 9.485, "d": 0.28}, {"w": "mảnh", "t": 9.765, "d": 0.17}, {"w": "được", "t": 9.935, "d": 0.14}, {"w": "dán", "t": 10.075, "d": 0.265}, {"w": "nhãn:", "t": 10.34, "d": 0.205}, {"w": "âm", "t": 10.545, "d": 0.305}, {"w": "gì,", "t": 10.85, "d": 0.18}, {"w": "cao", "t": 11.03, "d": 0.155}, {"w": "hay", "t": 11.185, "d": 0.355}, {"w": "thấp,", "t": 11.54, "d": 0.32}, {"w": "đứng", "t": 11.86, "d": 0.085}, {"w": "cạnh", "t": 11.945, "d": 0.23}, {"w": "âm", "t": 12.175, "d": 0.135}, {"w": "nào.", "t": 12.31, "d": 0.36}]}, {"text": "Muốn nói câu mới? Máy đi lục kho.", "start": 13.2, "end": 15.36, "words": [{"w": "Muốn", "t": 13.215, "d": 0.28}, {"w": "nói", "t": 13.495, "d": 0.16}, {"w": "câu", "t": 13.655, "d": 0.27}, {"w": "mới?", "t": 13.925, "d": 0.3}, {"w": "Máy", "t": 14.225, "d": 0.075}, {"w": "đi", "t": 14.3, "d": 0.23}, {"w": "lục", "t": 14.53, "d": 0.265}, {"w": "kho.", "t": 14.795, "d": 0.335}]}, {"text": "Cách làm này gọi là tổng hợp ghép đơn vị.", "start": 15.68, "end": 17.92, "words": [{"w": "Cách", "t": 15.68, "d": 0.105}, {"w": "làm", "t": 15.785, "d": 0.35}, {"w": "này", "t": 16.135, "d": 0.16}, {"w": "gọi", "t": 16.295, "d": 0.21}, {"w": "là", "t": 16.505, "d": 0.205}, {"w": "tổng", "t": 16.71, "d": 0.22}, {"w": "hợp", "t": 16.93, "d": 0.18}, {"w": "ghép", "t": 17.11, "d": 0.055}, {"w": "đơn", "t": 17.165, "d": 0.24}, {"w": "vị.", "t": 17.405, "d": 0.34}]}, {"text": "Năm 1996, hai nhà nghiên cứu ở Kyoto, Nhật Bản, là Andrew Hunt và Alan Black, mô tả nó trong một bài báo.", "start": 18.24, "end": 25.28, "words": [{"w": "Năm", "t": 18.24, "d": 0.305}, {"w": "1996,", "t": 18.545, "d": 1.605}, {"w": "hai", "t": 20.15, "d": 0.225}, {"w": "nhà", "t": 20.375, "d": 0.19}, {"w": "nghiên", "t": 20.565, "d": 0.06}, {"w": "cứu", "t": 20.625, "d": 0.235}, {"w": "ở", "t": 20.86, "d": 0.29}, {"w": "Kyoto,", "t": 21.15, "d": 0.415}, {"w": "Nhật", "t": 21.565, "d": 0.08}, {"w": "Bản,", "t": 21.645, "d": 0.37}, {"w": "là", "t": 22.015, "d": 0.16}, {"w": "Andrew", "t": 22.175, "d": 0.18}, {"w": "Hunt", "t": 22.355, "d": 0.35}, {"w": "và", "t": 22.705, "d": 0.17}, {"w": "Alan", "t": 22.875, "d": 0.305}, {"w": "Black,", "t": 23.18, "d": 0.33}, {"w": "mô", "t": 23.51, "d": 0.225}, {"w": "tả", "t": 23.735, "d": 0.095}, {"w": "nó", "t": 23.83, "d": 0.195}, {"w": "trong", "t": 24.025, "d": 0.215}, {"w": "một", "t": 24.24, "d": 0.17}, {"w": "bài", "t": 24.41, "d": 0.235}, {"w": "báo.", "t": 24.645, "d": 0.4}]}, {"text": "Ý tưởng của họ gói trong hai cái giá.", "start": 25.6, "end": 27.92, "words": [{"w": "Ý", "t": 25.62, "d": 0.25}, {"w": "tưởng", "t": 25.87, "d": 0.325}, {"w": "của", "t": 26.195, "d": 0.165}, {"w": "họ", "t": 26.36, "d": 0.195}, {"w": "gói", "t": 26.555, "d": 0.175}, {"w": "trong", "t": 26.73, "d": 0.43}, {"w": "hai", "t": 27.16, "d": 0.225}, {"w": "cái", "t": 27.385, "d": 0.06}, {"w": "giá.", "t": 27.445, "d": 0.475}]}, {"text": "Giá thứ nhất: mảnh này giống đến đâu với âm mình cần.", "start": 28.92, "end": 31.88, "words": [{"w": "Giá", "t": 28.92, "d": 0.125}, {"w": "thứ", "t": 29.045, "d": 0.34}, {"w": "nhất:", "t": 29.385, "d": 0.25}, {"w": "mảnh", "t": 29.635, "d": 0.335}, {"w": "này", "t": 29.97, "d": 0.06}, {"w": "giống", "t": 30.03, "d": 0.355}, {"w": "đến", "t": 30.385, "d": 0.16}, {"w": "đâu", "t": 30.545, "d": 0.17}, {"w": "với", "t": 30.715, "d": 0.3}, {"w": "âm", "t": 31.015, "d": 0.06}, {"w": "mình", "t": 31.075, "d": 0.175}, {"w": "cần.", "t": 31.25, "d": 0.43}]}, {"text": "Giá thứ hai: mảnh này nối với mảnh bên cạnh có êm không, có lộ vết cắt không.", "start": 32.2, "end": 36.04, "words": [{"w": "Giá", "t": 32.2, "d": 0.11}, {"w": "thứ", "t": 32.31, "d": 0.33}, {"w": "hai:", "t": 32.64, "d": 0.295}, {"w": "mảnh", "t": 32.935, "d": 0.06}, {"w": "này", "t": 32.995, "d": 0.145}, {"w": "nối", "t": 33.14, "d": 0.275}, {"w": "với", "t": 33.415, "d": 0.145}, {"w": "mảnh", "t": 33.56, "d": 0.135}, {"w": "bên", "t": 33.695, "d": 0.205}, {"w": "cạnh", "t": 33.9, "d": 0.165}, {"w": "có", "t": 34.065, "d": 0.175}, {"w": "êm", "t": 34.24, "d": 0.28}, {"w": "không,", "t": 34.52, "d": 0.36}, {"w": "có", "t": 34.88, "d": 0.06}, {"w": "lộ", "t": 34.94, "d": 0.195}, {"w": "vết", "t": 35.135, "d": 0.22}, {"w": "cắt", "t": 35.355, "d": 0.155}, {"w": "không.", "t": 35.51, "d": 0.32}]}, {"text": "Máy dò qua các cách ghép, rồi chọn đường có tổng giá thấp nhất.", "start": 36.36, "end": 39.56, "words": [{"w": "Máy", "t": 36.36, "d": 0.13}, {"w": "dò", "t": 36.49, "d": 0.23}, {"w": "qua", "t": 36.72, "d": 0.19}, {"w": "các", "t": 36.91, "d": 0.145}, {"w": "cách", "t": 37.055, "d": 0.365}, {"w": "ghép,", "t": 37.42, "d": 0.315}, {"w": "rồi", "t": 37.735, "d": 0.1}, {"w": "chọn", "t": 37.835, "d": 0.25}, {"w": "đường", "t": 38.085, "d": 0.135}, {"w": "có", "t": 38.22, "d": 0.28}, {"w": "tổng", "t": 38.5, "d": 0.135}, {"w": "giá", "t": 38.635, "d": 0.205}, {"w": "thấp", "t": 38.84, "d": 0.185}, {"w": "nhất.", "t": 39.025, "d": 0.315}]}, {"text": "Mình minh họa thế này.", "start": 40.56, "end": 41.68, "words": [{"w": "Mình", "t": 40.56, "d": 0.145}, {"w": "minh", "t": 40.705, "d": 0.21}, {"w": "họa", "t": 40.915, "d": 0.175}, {"w": "thế", "t": 41.09, "d": 0.06}, {"w": "này.", "t": 41.15, "d": 0.28}]}, {"text": "Để nói một chữ ngắn, máy có thể lấy phần đầu từ một câu thu buổi sáng.", "start": 42.0, "end": 45.68, "words": [{"w": "Để", "t": 42.0, "d": 0.11}, {"w": "nói", "t": 42.11, "d": 0.305}, {"w": "một", "t": 42.415, "d": 0.165}, {"w": "chữ", "t": 42.58, "d": 0.25}, {"w": "ngắn,", "t": 42.83, "d": 0.26}, {"w": "máy", "t": 43.09, "d": 0.08}, {"w": "có", "t": 43.17, "d": 0.275}, {"w": "thể", "t": 43.445, "d": 0.12}, {"w": "lấy", "t": 43.565, "d": 0.21}, {"w": "phần", "t": 43.775, "d": 0.205}, {"w": "đầu", "t": 43.98, "d": 0.2}, {"w": "từ", "t": 44.18, "d": 0.27}, {"w": "một", "t": 44.45, "d": 0.19}, {"w": "câu", "t": 44.64, "d": 0.15}, {"w": "thu", "t": 44.79, "d": 0.19}, {"w": "buổi", "t": 44.98, "d": 0.125}, {"w": "sáng.", "t": 45.105, "d": 0.325}]}, {"text": "Phần giữa lấy từ một câu khác, thu lúc trưa.", "start": 46.0, "end": 48.16, "words": [{"w": "Phần", "t": 46.0, "d": 0.17}, {"w": "giữa", "t": 46.17, "d": 0.12}, {"w": "lấy", "t": 46.29, "d": 0.195}, {"w": "từ", "t": 46.485, "d": 0.275}, {"w": "một", "t": 46.76, "d": 0.16}, {"w": "câu", "t": 46.92, "d": 0.215}, {"w": "khác,", "t": 47.135, "d": 0.285}, {"w": "thu", "t": 47.42, "d": 0.06}, {"w": "lúc", "t": 47.48, "d": 0.295}, {"w": "trưa.", "t": 47.775, "d": 0.21}]}, {"text": "Phần cuối lấy từ một câu thứ ba, thu lúc chiều muộn.", "start": 48.48, "end": 51.2, "words": [{"w": "Phần", "t": 48.54, "d": 0.165}, {"w": "cuối", "t": 48.705, "d": 0.125}, {"w": "lấy", "t": 48.83, "d": 0.275}, {"w": "từ", "t": 49.105, "d": 0.265}, {"w": "một", "t": 49.37, "d": 0.155}, {"w": "câu", "t": 49.525, "d": 0.11}, {"w": "thứ", "t": 49.635, "d": 0.305}, {"w": "ba,", "t": 49.94, "d": 0.25}, {"w": "thu", "t": 50.19, "d": 0.13}, {"w": "lúc", "t": 50.32, "d": 0.295}, {"w": "chiều", "t": 50.615, "d": 0.065}, {"w": "muộn.", "t": 50.68, "d": 0.35}]}, {"text": "Ghép lại: một chữ liền mạch.", "start": 51.52, "end": 53.04, "words": [{"w": "Ghép", "t": 51.52, "d": 0.1}, {"w": "lại:", "t": 51.62, "d": 0.39}, {"w": "một", "t": 52.01, "d": 0.08}, {"w": "chữ", "t": 52.09, "d": 0.24}, {"w": "liền", "t": 52.33, "d": 0.285}, {"w": "mạch.", "t": 52.615, "d": 0.215}]}, {"text": "Hai tác giả viết, kho càng lớn, càng nhiều mảnh với đủ cao độ, thì lời nói càng tự nhiên.", "start": 54.04, "end": 58.6, "words": [{"w": "Hai", "t": 54.04, "d": 0.245}, {"w": "tác", "t": 54.285, "d": 0.15}, {"w": "giả", "t": 54.435, "d": 0.26}, {"w": "viết,", "t": 54.695, "d": 0.195}, {"w": "kho", "t": 54.89, "d": 0.29}, {"w": "càng", "t": 55.18, "d": 0.155}, {"w": "lớn,", "t": 55.335, "d": 0.38}, {"w": "càng", "t": 55.715, "d": 0.105}, {"w": "nhiều", "t": 55.82, "d": 0.115}, {"w": "mảnh", "t": 55.935, "d": 0.325}, {"w": "với", "t": 56.26, "d": 0.23}, {"w": "đủ", "t": 56.49, "d": 0.105}, {"w": "cao", "t": 56.595, "d": 0.17}, {"w": "độ,", "t": 56.765, "d": 0.43}, {"w": "thì", "t": 57.195, "d": 0.15}, {"w": "lời", "t": 57.345, "d": 0.07}, {"w": "nói", "t": 57.415, "d": 0.25}, {"w": "càng", "t": 57.665, "d": 0.245}, {"w": "tự", "t": 57.91, "d": 0.175}, {"w": "nhiên.", "t": 58.085, "d": 0.315}]}, {"text": "Đó là lý do một kho giọng cần rất nhiều giờ thu.", "start": 58.92, "end": 61.48, "words": [{"w": "Đó", "t": 58.99, "d": 0.255}, {"w": "là", "t": 59.245, "d": 0.18}, {"w": "lý", "t": 59.425, "d": 0.18}, {"w": "do", "t": 59.605, "d": 0.18}, {"w": "một", "t": 59.785, "d": 0.06}, {"w": "kho", "t": 59.845, "d": 0.3}, {"w": "giọng", "t": 60.145, "d": 0.115}, {"w": "cần", "t": 60.26, "d": 0.25}, {"w": "rất", "t": 60.51, "d": 0.18}, {"w": "nhiều", "t": 60.69, "d": 0.06}, {"w": "giờ", "t": 60.75, "d": 0.19}, {"w": "thu.", "t": 60.94, "d": 0.325}]}, {"text": "Nhờ vậy, máy nói được những câu mà người đọc chưa từng đọc.", "start": 61.8, "end": 64.84, "words": [{"w": "Nhờ", "t": 61.8, "d": 0.285}, {"w": "vậy,", "t": 62.085, "d": 0.26}, {"w": "máy", "t": 62.345, "d": 0.08}, {"w": "nói", "t": 62.425, "d": 0.2}, {"w": "được", "t": 62.625, "d": 0.38}, {"w": "những", "t": 63.005, "d": 0.175}, {"w": "câu", "t": 63.18, "d": 0.185}, {"w": "mà", "t": 63.365, "d": 0.18}, {"w": "người", "t": 63.545, "d": 0.175}, {"w": "đọc", "t": 63.72, "d": 0.285}, {"w": "chưa", "t": 64.005, "d": 0.125}, {"w": "từng", "t": 64.13, "d": 0.23}, {"w": "đọc.", "t": 64.36, "d": 0.28}]}, {"text": "Bà Bennett có một nhận xét vui về chuyện này.", "start": 65.84, "end": 68.64, "words": [{"w": "Bà", "t": 65.84, "d": 0.375}, {"w": "Bennett", "t": 66.215, "d": 0.06}, {"w": "có", "t": 66.275, "d": 0.445}, {"w": "một", "t": 66.72, "d": 0.165}, {"w": "nhận", "t": 66.885, "d": 0.275}, {"w": "xét", "t": 67.16, "d": 0.175}, {"w": "vui", "t": 67.335, "d": 0.465}, {"w": "về", "t": 67.8, "d": 0.21}, {"w": "chuyện", "t": 68.01, "d": 0.29}, {"w": "này.", "t": 68.3, "d": 0.34}]}, {"text": "Bà kể bà rất dễ chán khi đọc hàng giờ liền.", "start": 68.96, "end": 72.0, "words": [{"w": "Bà", "t": 68.96, "d": 0.25}, {"w": "kể", "t": 69.21, "d": 0.325}, {"w": "bà", "t": 69.535, "d": 0.225}, {"w": "rất", "t": 69.76, "d": 0.33}, {"w": "dễ", "t": 70.09, "d": 0.26}, {"w": "chán", "t": 70.35, "d": 0.23}, {"w": "khi", "t": 70.58, "d": 0.335}, {"w": "đọc", "t": 70.915, "d": 0.26}, {"w": "hàng", "t": 71.175, "d": 0.26}, {"w": "giờ", "t": 71.435, "d": 0.12}, {"w": "liền.", "t": 71.555, "d": 0.45}]}, {"text": "Nên theo bà, đôi khi Siri nghe hơi có thái độ: những âm ấy có thể thu trong mười lăm phút cuối.", "start": 72.32, "end": 77.36, "words": [{"w": "Nên", "t": 72.32, "d": 0.155}, {"w": "theo", "t": 72.475, "d": 0.165}, {"w": "bà,", "t": 72.64, "d": 0.5}, {"w": "đôi", "t": 73.14, "d": 0.2}, {"w": "khi", "t": 73.34, "d": 0.06}, {"w": "Siri", "t": 73.4, "d": 0.18}, {"w": "nghe", "t": 73.58, "d": 0.24}, {"w": "hơi", "t": 73.82, "d": 0.28}, {"w": "có", "t": 74.1, "d": 0.19}, {"w": "thái", "t": 74.29, "d": 0.16}, {"w": "độ:", "t": 74.45, "d": 0.44}, {"w": "những", "t": 74.89, "d": 0.205}, {"w": "âm", "t": 75.095, "d": 0.19}, {"w": "ấy", "t": 75.285, "d": 0.065}, {"w": "có", "t": 75.35, "d": 0.245}, {"w": "thể", "t": 75.595, "d": 0.26}, {"w": "thu", "t": 75.855, "d": 0.165}, {"w": "trong", "t": 76.02, "d": 0.22}, {"w": "mười", "t": 76.24, "d": 0.19}, {"w": "lăm", "t": 76.43, "d": 0.29}, {"w": "phút", "t": 76.72, "d": 0.2}, {"w": "cuối.", "t": 76.92, "d": 0.24}]}, {"text": "Vậy mỗi mảnh âm là một khoảnh khắc thật, trong một ngày làm việc thật, của một người.", "start": 78.36, "end": 82.2, "words": [{"w": "Vậy", "t": 78.42, "d": 0.12}, {"w": "mỗi", "t": 78.54, "d": 0.16}, {"w": "mảnh", "t": 78.7, "d": 0.28}, {"w": "âm", "t": 78.98, "d": 0.08}, {"w": "là", "t": 79.06, "d": 0.25}, {"w": "một", "t": 79.31, "d": 0.2}, {"w": "khoảnh", "t": 79.51, "d": 0.155}, {"w": "khắc", "t": 79.665, "d": 0.28}, {"w": "thật,", "t": 79.945, "d": 0.135}, {"w": "trong", "t": 80.08, "d": 0.275}, {"w": "một", "t": 80.355, "d": 0.23}, {"w": "ngày", "t": 80.585, "d": 0.185}, {"w": "làm", "t": 80.77, "d": 0.115}, {"w": "việc", "t": 80.885, "d": 0.26}, {"w": "thật,", "t": 81.145, "d": 0.165}, {"w": "của", "t": 81.31, "d": 0.265}, {"w": "một", "t": 81.575, "d": 0.115}, {"w": "người.", "t": 81.69, "d": 0.325}]}, {"text": "Giờ thì bạn đã hiểu vì sao bà nghe thấy mình nói những câu chưa từng nói.", "start": 82.52, "end": 86.6, "words": [{"w": "Giờ", "t": 82.665, "d": 0.14}, {"w": "thì", "t": 82.805, "d": 0.275}, {"w": "bạn", "t": 83.08, "d": 0.35}, {"w": "đã", "t": 83.43, "d": 0.205}, {"w": "hiểu", "t": 83.635, "d": 0.24}, {"w": "vì", "t": 83.875, "d": 0.06}, {"w": "sao", "t": 83.935, "d": 0.39}, {"w": "bà", "t": 84.325, "d": 0.06}, {"w": "nghe", "t": 84.385, "d": 0.205}, {"w": "thấy", "t": 84.59, "d": 0.405}, {"w": "mình", "t": 84.995, "d": 0.055}, {"w": "nói", "t": 85.05, "d": 0.195}, {"w": "những", "t": 85.245, "d": 0.35}, {"w": "câu", "t": 85.595, "d": 0.295}, {"w": "chưa", "t": 85.89, "d": 0.2}, {"w": "từng", "t": 86.09, "d": 0.175}, {"w": "nói.", "t": 86.265, "d": 0.335}]}, {"text": "Nhưng đó mới là cái miệng.", "start": 86.92, "end": 88.04, "words": [{"w": "Nhưng", "t": 86.92, "d": 0.105}, {"w": "đó", "t": 87.025, "d": 0.185}, {"w": "mới", "t": 87.21, "d": 0.065}, {"w": "là", "t": 87.275, "d": 0.26}, {"w": "cái", "t": 87.535, "d": 0.12}, {"w": "miệng.", "t": 87.655, "d": 0.19}]}, {"text": "Còn cái đầu, ai dạy chiếc máy hiểu câu bạn hỏi?", "start": 88.36, "end": 91.08, "words": [{"w": "Còn", "t": 88.405, "d": 0.19}, {"w": "cái", "t": 88.595, "d": 0.12}, {"w": "đầu,", "t": 88.715, "d": 0.485}, {"w": "ai", "t": 89.2, "d": 0.095}, {"w": "dạy", "t": 89.295, "d": 0.295}, {"w": "chiếc", "t": 89.59, "d": 0.17}, {"w": "máy", "t": 89.76, "d": 0.125}, {"w": "hiểu", "t": 89.885, "d": 0.3}, {"w": "câu", "t": 90.185, "d": 0.19}, {"w": "bạn", "t": 90.375, "d": 0.23}, {"w": "hỏi?", "t": 90.605, "d": 0.26}]}, {"text": "Muốn biết, cuộn băng phải lùi thêm một nấc.", "start": 91.68, "end": 93.68, "words": [{"w": "Muốn", "t": 91.68, "d": 0.255}, {"w": "biết,", "t": 91.935, "d": 0.285}, {"w": "cuộn", "t": 92.22, "d": 0.06}, {"w": "băng", "t": 92.28, "d": 0.14}, {"w": "phải", "t": 92.42, "d": 0.27}, {"w": "lùi", "t": 92.69, "d": 0.16}, {"w": "thêm", "t": 92.85, "d": 0.195}, {"w": "một", "t": 93.045, "d": 0.205}, {"w": "nấc.", "t": 93.25, "d": 0.26}]}], "imgs": {"bennett": {"src": "assets/long/mim-siri-susan-bennett/img/bennett.jpg", "w": 1920, "h": 1280, "lic": "Public domain", "by": "Voice of America", "pd": true}, "bennettc": {"src": "assets/long/mim-siri-susan-bennett/img/bennettc.jpg", "w": 960, "h": 1281, "lic": "Public domain", "by": "Voice of America", "pd": true}, "jobs": {"src": "assets/long/mim-siri-susan-bennett/img/jobs.jpg", "w": 500, "h": 624, "lic": "CC BY 2.0", "by": "matt buchanan", "pd": false}, "atlanta": {"src": "assets/long/mim-siri-susan-bennett/img/atlanta.jpg", "w": 1920, "h": 840, "lic": "CC0", "by": "brandon walker", "pd": true}, "cassette": {"src": "assets/long/mim-siri-susan-bennett/img/cassette.jpg", "w": 1920, "h": 1280, "lic": "CC BY 2.0", "by": "Tim Reckmann", "pd": false}, "mic": {"src": "assets/long/mim-siri-susan-bennett/img/mic.jpg", "w": 1600, "h": 2400, "lic": "CC BY 2.0", "by": "Shixart1985", "pd": false}, "spectro": {"src": "assets/long/mim-siri-susan-bennett/img/spectro.jpg", "w": 330, "h": 172, "lic": "Public domain", "by": "Jonas.kluk", "pd": true}}, "geo": {}, "scenes": [{"type": "chapter", "no": "3", "k": "CHƯƠNG BA", "title": "KÉO CUỘN BĂNG RA\nNHỮNG MẢNH ÂM", "sub": "TỔNG HỢP GHÉP ĐƠN VỊ", "bg": "cassette", "titleAt": 0.015, "t0": 0.0, "t1": 3.68}, {"type": "broll", "vid": "v1", "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "MỘT DẢI BĂNG RẤT DÀI", "at": 3.68, "sm": true, "fx": "rise"}, 