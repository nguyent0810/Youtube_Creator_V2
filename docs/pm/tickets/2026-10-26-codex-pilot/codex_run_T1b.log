3, "d": 0.175}, {"w": "lại.", "t": 112.405, "d": 0.34}]}, {"text": "Dù vậy, nhà nghiên cứu Scott Sagan ở Đại học Stanford vẫn phê phán cách giới chức kể lại các sự cố.", "start": 113.44, "end": 119.12, "words": [{"w": "Dù", "t": 113.535, "d": 0.33}, {"w": "vậy,", "t": 113.865, "d": 0.28}, {"w": "nhà", "t": 114.145, "d": 0.33}, {"w": "nghiên", "t": 114.475, "d": 0.08}, {"w": "cứu", "t": 114.555, "d": 0.295}, {"w": "Scott", "t": 114.85, "d": 0.155}, {"w": "Sagan", "t": 115.005, "d": 0.23}, {"w": "ở", "t": 115.235, "d": 0.245}, {"w": "Đại", "t": 115.48, "d": 0.24}, {"w": "học", "t": 115.72, "d": 0.23}, {"w": "Stanford", "t": 115.95, "d": 0.395}, {"w": "vẫn", "t": 116.345, "d": 0.06}, {"w": "phê", "t": 116.405, "d": 0.26}, {"w": "phán", "t": 116.665, "d": 0.27}, {"w": "cách", "t": 116.935, "d": 0.225}, {"w": "giới", "t": 117.16, "d": 0.265}, {"w": "chức", "t": 117.425, "d": 0.13}, {"w": "kể", "t": 117.555, "d": 0.405}, {"w": "lại", "t": 117.96, "d": 0.075}, {"w": "các", "t": 118.035, "d": 0.395}, {"w": "sự", "t": 118.43, "d": 0.255}, {"w": "cố.", "t": 118.685, "d": 0.275}]}, {"text": "Họ đổ lỗi cho một con chip, hay một người nạp nhầm băng, thay vì nhìn vào cách cả hệ thống được thiết kế.", "start": 119.44, "end": 124.48, "words": [{"w": "Họ", "t": 119.44, "d": 0.1}, {"w": "đổ", "t": 119.54, "d": 0.19}, {"w": "lỗi", "t": 119.73, "d": 0.195}, {"w": "cho", "t": 119.925, "d": 0.26}, {"w": "một", "t": 120.185, "d": 0.175}, {"w": "con", "t": 120.36, "d": 0.275}, {"w": "chip,", "t": 120.635, "d": 0.165}, {"w": "hay", "t": 120.8, "d": 0.23}, {"w": "một", "t": 121.03, "d": 0.175}, {"w": "người", "t": 121.205, "d": 0.24}, {"w": "nạp", "t": 121.445, "d": 0.18}, {"w": "nhầm", "t": 121.625, "d": 0.185}, {"w": "băng,", "t": 121.81, "d": 0.37}, {"w": "thay", "t": 122.18, "d": 0.14}, {"w": "vì", "t": 122.32, "d": 0.085}, {"w": "nhìn", "t": 122.405, "d": 0.35}, {"w": "vào", "t": 122.755, "d": 0.185}, {"w": "cách", "t": 122.94, "d": 0.135}, {"w": "cả", "t": 123.075, "d": 0.205}, {"w": "hệ", "t": 123.28, "d": 0.165}, {"w": "thống", "t": 123.445, "d": 0.15}, {"w": "được", "t": 123.595, "d": 0.155}, {"w": "thiết", "t": 123.75, "d": 0.185}, {"w": "kế.", "t": 123.935, "d": 0.37}]}, {"text": "Mẩu tin thứ năm.", "start": 124.8, "end": 125.76, "words": [{"w": "Mẩu", "t": 124.865, "d": 0.205}, {"w": "tin", "t": 125.07, "d": 0.06}, {"w": "thứ", "t": 125.13, "d": 0.155}, {"w": "năm.", "t": 125.285, "d": 0.26}]}, {"text": "Nó đến từ phía Mỹ: máy cảnh báo có thể sai cả trăm lần, và thứ cứu người ta là một nguồn tin thứ hai, độc lập.", "start": 126.08, "end": 132.0, "words": [{"w": "Nó", "t": 126.08, "d": 0.255}, {"w": "đến", "t": 126.335, "d": 0.15}, {"w": "từ", "t": 126.485, "d": 0.135}, {"w": "phía", "t": 126.62, "d": 0.32}, {"w": "Mỹ:", "t": 126.94, "d": 0.14}, {"w": "máy", "t": 127.08, "d": 0.36}, {"w": "cảnh", "t": 127.44, "d": 0.18}, {"w": "báo", "t": 127.62, "d": 0.215}, {"w": "có", "t": 127.835, "d": 0.13}, {"w": "thể", "t": 127.965, "d": 0.205}, {"w": "sai", "t": 128.17, "d": 0.225}, {"w": "cả", "t": 128.395, "d": 0.14}, {"w": "trăm", "t": 128.535, "d": 0.105}, {"w": "lần,", "t": 128.64, "d": 0.485}, {"w": "và", "t": 129.125, "d": 0.06}, {"w": "thứ", "t": 129.185, "d": 0.21}, {"w": "cứu", "t": 129.395, "d": 0.18}, {"w": "người", "t": 129.575, "d": 0.18}, {"w": "ta", "t": 129.755, "d": 0.235}, {"w": "là", "t": 129.99, "d": 0.3}, {"w": "một", "t": 130.29, "d": 0.165}, {"w": "nguồn", "t": 130.455, "d": 0.225}, {"w": "tin", "t": 130.68, "d": 0.06}, {"w": "thứ", "t": 130.74, "d": 0.16}, {"w": "hai,", "t": 130.9, "d": 0.485}, {"w": "độc", "t": 131.385, "d": 0.055}, {"w": "lập.", "t": 131.44, "d": 0.37}]}, {"text": "Vậy ở Serpukhov, bạn có chờ nguồn tin thứ hai ấy, hay báo lên trước?", "start": 132.32, "end": 136.0, "words": [{"w": "Vậy", "t": 132.32, "d": 0.29}, {"w": "ở", "t": 132.61, "d": 0.16}, {"w": "Serpukhov,", "t": 132.77, "d": 0.39}, {"w": "bạn", "t": 133.16, "d": 0.21}, {"w": "có", "t": 133.37, "d": 0.065}, {"w": "chờ", "t": 133.435, "d": 0.3}, {"w