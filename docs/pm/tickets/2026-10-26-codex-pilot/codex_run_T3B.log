    {"type": "slam", "at": 20, "text": "50 / 50", "sub": "“CHƯA BAO GIỜ CHẮC TUYỆT ĐỐI” · BBC 2013"},
    {"type": "kinetic", "at": 21, "items": [{"text": "NGƯỜI KHÁC TRỰC → CÓ LẼ ĐÃ BÁO LÊN", "at": [21, "đồng"], "acc": True},
