"""Kịch bản đã duyệt (data/long/<topic>/script.md) -> "lines" của từng chNN.json (giữ nguyên mọi khoá khác: hud, bgm, scenes…).

    python motion/long/script_lines.py <topic> [--allow-repeat-line]

Quy ước script.md: "## CHnn · Tên chương"; mỗi dòng một câu; "‖" cuối dòng = nghỉ dài; "**[DIỄN Ý]**" = trích diễn ý; "[TRÍCH DỊCH]" = văn bản thật đã dịch;
"»" = phần sau là LỜI TRÍCH (đọc giọng trích, xem build_long.QUOTE_VOICE). Dòng "a: » b" tách thành 2 câu.
Dừng ở "## Ghi chú". Câu -> chuỗi, hoặc {"t", "p": nghỉ, "q": 1 (lời trích), "diy": 1}.

Cổng toàn vẹn (retro 2 mục 16): chạy factory.integrity.check trên LỜI ĐỌC của cả kịch bản TRƯỚC khi ghi chNN.json — câu lặp
nguyên văn ("Anh ta nghi ngờ." ×2 ở MIM #3) hay markup sót thì dừng, không để tới bước Bundle (sau khi đã render final).
Câu lặp CỐ Ý (điệp khúc kiểu "Từ địa ngục.") -> --allow-repeat-line; markup sót thì không có cờ bỏ qua.
"""
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
LONG_PAUSE = 1.0


def spoken_text(chs) -> str:
    """Lời sẽ đọc của cả kịch bản, mỗi câu một dòng (ranh giới câu chắc chắn, kể cả câu không có dấu chấm)."""
    return "\n".join((x if isinstance(x, str) else x["t"]) for c in chs for x in c["lines"])


# Câu lộ trình rập khuôn (retro 1 mục 14 / retro 2 mục 1: lặp ở A1, C1, D1, MIM #2 — RETENTION.md "Lời hứa lộ trình").
# Luật viết đã có; đây là chốt chặn bằng máy cho đúng cụm người xem đã nhận ra.
CLICHES = [re.compile(r"trả lời (ba|3) câu hỏi", re.I)]


def gate(chs, allow_repeat: bool = False) -> list[str]:
    """Lỗi CHẶN của factory.integrity trên toàn kịch bản (rỗng = qua). allow_repeat: câu lặp chỉ còn là cảnh báo.
    Kèm cụm lộ trình rập khuôn (CLICHES) — không có cờ bỏ qua: đổi hình thức lộ trình (RETENTION.md)."""
    if str(ROOT) not in sys.path:
        sys.path.insert(0, str(ROOT))
    from factory import integrity
    out = [f"ROADMAP_CLICHE [{c['name']}] «{t}»" for c in chs for x in c["lines"]
           for t in [x if isinstance(x, str) else x["t"]] if any(p.search(t) for p in CLICHES)]
    for f in integrity.check(spoken_text(chs)):
        if f.blocking and not (allow_repeat and f.code == "INT_REPEATED_SENTENCE"):
            where = next((c["name"] for c in chs for x in c["lines"] if f.span.strip() in (x if isinstance(x, str) else x["t"])), "?")
            out.append(f"{f.code} [{where}] «{f.span.strip()}»")
    return out


def parse(md: str):
    chs, cur = [], None
    for raw in md.split("\n"):
        s = raw.strip()
        if s.startswith("## Ghi chú"):
            break
        m = re.match(r"^## (CH\d\d) · (.+)$", s)
        if m:
            cur = {"name": m.group(1).lower(), "title": m.group(2), "lines": []}
            chs.append(cur)
            continue
        if not cur or not s or s == "---" or s.startswith("#"):
            continue
        # Nhãn có hoặc không có ** (ripper ch12 ghi "[DIỄN Ý]" trần -> lọt vào lời đọc, TTS đọc thành tiếng).
        diy = bool(re.search(r"\**\[DIỄN Ý\]\**", s))
        tr = "[TRÍCH DỊCH]" in s            # văn bản thật dịch sang tiếng Việt (nhãn TRÍCH DỊCH trên cảnh quote)
        s = re.sub(r"\**\[DIỄN Ý\]\**", "", s).replace("[TRÍCH DỊCH]", "").strip()
        pause = s.endswith("‖")
        s = s.rstrip("‖").strip()
        parts = [p.strip() for p in s.split("»")]
        out = []
        if s.startswith("HỎI:"):           # câu hỏi của người xem, đọc bằng giọng "người hỏi" (kênh có CHAN["ask"])
            out.append({"t": s[4:].strip(), "ask": 1})
        elif len(parts) == 2:
            if parts[0]:
                out.append({"t": parts[0]})
            q = parts[1][:1].upper() + parts[1][1:]
            out.append({"t": q, "q": 1, **({"diy": 1} if diy else {}), **({"tr": 1} if tr else {})})
        else:
            out.append({"t": s, **({"diy": 1} if diy else {})})
        if pause:
            out[-1]["p"] = LONG_PAUSE
        cur["lines"] += out
    for c in chs:
        x0 = c["lines"][0]
        if c["name"] != "ch00" and set(x0) == {"t"}:     # "Chương N. Tên." -> nghỉ để màn tên chương thở
            x0["p"] = 0.8
        c["lines"] = [x["t"] if set(x) == {"t"} else x for x in c["lines"]]
    return chs


if __name__ == "__main__":
    import pathlib, sys  # noqa: E401
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2]))
    from factory.console import utf8_console  # noqa: E402
    utf8_console()  # console Windows cp1252 không in được tiếng Việt (retro 2 mục 7)
    topic = sys.argv[1]
    sd = ROOT / "data" / "long" / topic
    chs = parse((sd / "script.md").read_text(encoding="utf-8"))
    bad = gate(chs, allow_repeat="--allow-repeat-line" in sys.argv)
    if bad:      # dừng TRƯỚC khi ghi chNN.json -> không có gì để TTS đọc nhầm
        raise SystemExit("integrity: kịch bản chưa qua cổng (sửa script.md rồi chạy lại):\n  " + "\n  ".join(bad)
                         + "\n(câu lặp cố ý: thêm --allow-repeat-line)")
    tot = 0
    for c in chs:
        f = sd / f"{c['name']}.json"
        d = json.loads(f.read_text(encoding="utf-8")) if f.exists() else {}
        d["title"] = c["title"]
        d["lines"] = c["lines"]
        d.setdefault("scenes", [])
        f.write_text(json.dumps(d, ensure_ascii=False, indent=1), encoding="utf-8")
        syl = sum(len((x if isinstance(x, str) else x["t"]).split()) for x in c["lines"])
        tot += syl
        print(f"{c['name']}: {len(c['lines'])} câu, {syl} âm tiết, ~{syl / 200:.1f} phút  {c['title']}")
    print(f"TỔNG {sum(len(c['lines']) for c in chs)} câu, {tot} âm tiết")

"""Soát một video dài theo luật mượn từ bộ skill shorts-studio / long-video (vietneu-tts, nhánh feat/shorts-studio; áp dụng 14/10/2026).

    python motion/long/studio_lint.py <topic> [--strict]

Đọc data/long/<topic>/chNN.json (lines + scenes, sau script_lines.py + gen_scenes.py). In cảnh báo; --strict thoát 1 khi có LỖI.

LỖI (đã từng tới tay người xem):
  - câu đọc dài hơn 35 tiếng (TTS hụt hơi, người nghe mất mạch);
  - counter đếm tới một NĂM (1500-2100) mà không đứng yên ("năm không đếm từ 0");
  - counter có from/to 1000-2100, không suffix, không khai "year" (engine chấm nghìn: 1996 -> "1.996");
  - counter có chữ số hoặc "<" trong prefix mà không đứng yên (số trung gian đọc như dữ kiện thật).
CẢNH BÁO (giữ chân):
  - cả chương ít câu ngắn (<= 6 tiếng): cần khoảng 1 câu mỗi 4-6 câu, đặt sau phán định hoặc khoảnh khắc cảm xúc;
  - liệt kê quá 3 mục trong một câu đọc (phần còn lại đưa lên màn hình);
  - 3 cảnh liền nhau cùng một loại, hoặc cả chương có ít hơn 3 loại cảnh;
  - quá 1 cảnh "tròn"/đếm (counter) liền nhau; mốc hiện phần tử cuối cách hết cảnh dưới 1,5 giây thì build_long đã báo riêng.
"""
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]


def year_counter_issues(scenes) -> list[str]:
    """Counter có số 1000-2100 mà không suffix phải khai "year": true (năm, không chấm nghìn) hoặc false (số lượng).

    26/10/2026: Short Turing đếm 1950 -> 2000 hiện "1.996". Không đoán bằng nhãn như vietneu-tts: "THÀNH VIÊN BỊ LOẠI
    MỖI NĂM" (yakuza, 2000) và "MẶT NẠ PHÒNG ĐỘC" (shanghai, 1000) là số lượng. Dùng chung cho build.py (Short)."""
    out = []
    for i, s in enumerate(scenes or []):
        if s.get("type") != "counter" or "year" in s or str(s.get("suffix") or "").strip():
            continue
        nums = [n for n in (s.get("from", 0), s["to"]) if float(n).is_integer() and 1000 <= n <= 2100]
        if nums:
            out.append(f"cảnh {i}: counter {int(nums[-1])} -- khai \"year\": true (năm, hiện 1996) hoặc false (số lượng, hiện 1.996)")
    return out


def text_of(ln) -> str:
    return ln["t"] if isinstance(ln, dict) else ln


def sentences(t: str) -> list[str]:
    return [x.strip() for x in re.split(r"(?<=[.!?…])\s+", t.replace("‖", " ")) if x.strip()]


def lint(topic: str) -> tuple[list[str], list[str]]:
    err, warn = [], []
    for p in sorted((ROOT / "data" / "long" / topic).glob("ch[0-9][0-9].json")):
        ch = json.loads(p.read_text(encoding="utf-8"))
        name, sents = p.stem, []
        for i, ln in enumerate(ch.get("lines") or []):
            for s in sentences(text_of(ln)):
                n = len(s.split())
                sents.append(n)
                if n > 35:
                    err.append(f"{name} dòng {i}: câu {n} tiếng (> 35): {s[:70]}…")
                if s.count(",") >= 4 and not re.search(r"\d", s) and n < 30:
                    warn.append(f"{name} dòng {i}: có vẻ liệt kê hơn 3 mục trong một câu: {s[:70]}…")
        if len(sents) >= 10:
            short = sum(1 for n in sents if n <= 6)
            if short * 7 < len(sents):
                warn.append(f"{name}: {short}/{len(sents)} câu ngắn (<= 6 tiếng); cần khoảng 1 câu mỗi 4-6 câu")
        types = [s["type"] for s in ch.get("scenes") or []]
        body = [t for t in types if t not in ("chapter", "brand", "endcard")]
        if len(body) >= 5 and len(set(body)) < 3:
            warn.append(f"{name}: chỉ {len(set(body))} loại cảnh ({sorted(set(body))}); cần >= 3")
        for i in range(2, len(types)):
            if types[i] == types[i - 1] == types[i - 2] and types[i] not in ("broll",):
                warn.append(f"{name} cảnh {i - 2}-{i}: ba cảnh '{types[i]}' liền nhau")
        err += [f"{name} {m}" for m in year_counter_issues(ch.get("scenes"))]
        for i, s in enumerate(ch.get("scenes") or []):
            if s["type"] != "counter":
                continue
            moving = s.get("from", 0) != s["to"]
            if moving and float(s["to"]).is_integer() and 1500 <= s["to"] <= 2100 and not s.get("suffix") and s.get("year") is not False:
                err.append(f"{name} cảnh {i}: counter đếm tới năm {int(s['to'])} (đặt from = to hoặc dùng kinetic/date)")
            if moving and re.search(r"[\d<>≈~]", str(s.get("prefix") or "")):
                err.append(f"{name} cảnh {i}: counter prefix {s['prefix']!r} mà số còn chạy")
    return err, warn


def main() -> int:
    sys.path.insert(0, str(ROOT))
    from factory.console import utf8_console
    utf8_console()  # console Windows cp1252 không in được tiếng Việt (retro 2 mục 7)
    topic = sys.argv[1]
    err, warn = lint(topic)
    out = sys.stdout
    try:
        out.reconfigure(encoding="utf-8")
    except Exception:
        pass
    for w in warn:
        print("  ! " + w)
    for e in err:
        print("  LỖI " + e)
    print(f"{topic}: {len(err)} lỗi, {len(warn)} cảnh báo (luật studio)")
    return 1 if err and "--strict" in sys.argv else 0


if __name__ == "__main__":
    sys.exit(main())

"""Cổng CHẤT LƯỢNG cho video dài, chặn trước khi render (26/10/2026, sau thử nghiệm Codex T1/T1b).

    python scripts/long_gate.py <topic> [--min-syl 1900]

`studio_lint` chỉ bắt lỗi kỹ thuật. Bài T1b (5 phút, một clip máy đánh chữ lặp 8 lần) vẫn ra "0 lỗi".
Cổng này đo những thứ review đã phải bắt bằng mắt. Ngưỡng đặt theo bài mẫu:
- Petrov: 7,6 giây/cảnh, ít nhất 7 loại cảnh/chương.
- KAL 007: 7,7 giây/cảnh, ít nhất 6 loại cảnh/chương.
Thoát 1 khi có LỖI.
"""
from __future__ import annotations

import argparse
import collections
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SYL_PER_MIN = 210                      # nhịp đọc đo trên các Long MIM (docs/pm/2026-10-23-mim-long-moi.md)
MAX_SEC_PER_SCENE = 9.0
MIN_TYPES_PER_CHAPTER = 5
MAX_SAME_CLIP = 2                      # bài 9–12 phút; bài dài hơn cho phép ~1 lần lặp mỗi 6 phút (Petrov 22 phút: 4)
MAX_SAME_IMAGE = 3
# Câu đệm thêm vào chỉ để qua tỉ lệ câu ngắn của lint (review T1, 26/10/2026)
FILLER = ["Rất chậm.", "Không có thời gian chờ.", "Mâu thuẫn là dấu hiệu tốt.", "Không hề tức thì.",
          "Đó là lợi thế lớn.", "Việc ấy rất cụ thể.", "Đó là câu hỏi khó.", "Phần còn lại mới đáng xem.",
          "Nó chỉ mở cửa.", "Họ không vô hình.", "Không chỉ nhờ ý tưởng."]
BANNED_PUBLIC = ["<", ">", "CẦN", "cần kiểm", "WebFetch", "factcheck", "data/long", "tìm kiếm", "agent"]


def text_of(line) -> str:
    return line if isinstance(line, str) else str(line.get("t", ""))


def gate(topic: str, min_syl: int) -> tuple[list[str], list[str], dict]:
    d = ROOT / "data" / "long" / topic
    od = ROOT / "output" / "long" / topic
    err, warn = [], []
    chs = sorted(d.glob("ch*.json"))
    if not chs:
        return [f"không có chNN.json trong {d}"], [], {}
    syl, dur, scenes = 0, 0.0, 0
    clips, images = collections.Counter(), collections.Counter()
    for f in chs:
        ch = json.loads(f.read_text(encoding="utf-8"))
        if not (ch.get("hud") or {}).get("t"):      # T2D: thiếu hud -> describe.py KeyError, mô tả không có danh sách chương
            err.append(f"{f.stem}: thiếu hud {{k, t}} (describe.py lấy tiêu đề chương từ đây)")
        syl +=sum(len(text_of(x).split()) for x in ch.get("lines", []))
        body = [s for s in ch.get("scenes", []) if s.get("type") not in ("chapter", "brand", "endcard")]
        scenes += len(body)
        kinds = {s["type"] for s in body}
        if len(kinds) < MIN_TYPES_PER_CHAPTER:
            err.append(f"{f.stem}: chỉ {len(kinds)} loại cảnh {sorted(kinds)}; cần >= {MIN_TYPES_PER_CHAPTER}")
        for s in body:
            if s.get("vid"):
                clips[str(s["vid"])] += 1
            for k in ("img", "photo", "src"):
                if isinstance(s.get(k), str):
                    images[s[k]] += 1
        tj = od / f.stem / "timing.json"
        dur += json.loads(tj.read_text(encoding="utf-8"))["duration"] if tj.exists() else 0.0
    # T2B render (26/10/2026): thẻ chương ghi "number" thay vì "no"/"k" -> engine in chữ "undefined" giữa màn hình;
    # gen_scenes dùng một khuôn 9 cảnh cho mọi chương -> "SÁU RĂNG CỦA MỘT KHÓA" hiện 7 lần. Lint đếm loại cảnh không thấy.
    seen = collections.Counter()
    for f in chs:
        for s in json.loads(f.read_text(encoding="utf-8")).get("scenes", []):
            if s.get("type") == "chapter":
                miss = [k for k in ("no", "k", "title") if not s.get(k)]
                if miss:
                    err.append(f"{f.stem}: thẻ chương thiếu {miss} (engine hiện 'undefined'; xem mẫu Petrov)")
                continue
            keys = ("text", "q", "label") if s.get("type") == "ledger" else ("text", "title", "q", "label")   # tiêu đề sổ cái là mô-típ (Petrov "GHẾ TRỰC"), dòng mới thì khác
            texts = [s.get(k) for k in keys if isinstance(s.get(k), str)]
            texts += [i.get("text") for i in s.get("items") or [] if isinstance(i, dict) and isinstance(i.get("text"), str)]
            for t in texts:
                if len(t) >= 8:
                    seen[t.strip().upper()] += 1
    for t, n in seen.items():
        if n > 2:
            err.append(f"chữ hiển thị lặp {n} lần: {t[:50]!r} (mỗi cảnh phải gắn với dữ kiện của chương đó)")
    if dur == 0:
        dur = syl / SYL_PER_MIN * 60
        warn.append("chưa có timing.json: thời lượng ước theo 210 âm tiết/phút")
    if syl < min_syl:
        err.append(f"lời đọc {syl} âm tiết (~{syl / SYL_PER_MIN:.1f} phút) < {min_syl}: thiếu nội dung, thêm chi tiết có nguồn, không thêm câu đệm")
    sps = dur / max(scenes, 1)
    if sps > MAX_SEC_PER_SCENE:
        err.append(f"{sps:.1f} giây/cảnh > {MAX_SEC_PER_SCENE}: cần thêm cảnh (bài mẫu ~7,6)")
    cap = max(MAX_SAME_CLIP, round(dur / 60 / 6))
    for v, n in clips.items():
        if n > cap:
            err.append(f"clip {v} dùng {n} lần (> {cap})")
    for v, n in images.items():
        if n > MAX_SAME_IMAGE:
            err.append(f"ảnh {v} dùng {n} lần (> {MAX_SAME_IMAGE})")
    script = (d / "script.md").read_text(encoding="utf-8") if (d / "script.md").exists() else ""
    fc = (d / "factcheck.md").read_text(encoding="utf-8") if (d / "factcheck.md").exists() else ""
    for x in FILLER:
        if x in script:
            err.append(f"câu đệm rỗng nghĩa: {x!r}")
    body_lines = [ln for ln in script.splitlines() if ln and not ln.startswith(("#", "**", "Quy ước", "---"))]
    missing = set()
    for ln in body_lines:
        for y in re.findall(r"\b(1[0-9]{3}|20[0-9]{2})\b", ln):           # năm phải có trong factcheck
            if y not in fc:
                missing.add(y)
    if missing:
        err.append(f"năm trong kịch bản không có trong factcheck.md: {sorted(missing)}")
    if len(re.findall(r"https?://", fc)) < 8:
        err.append("factcheck.md có ít hơn 8 URL nguồn")
    spec = json.loads((d / "spec.json").read_text(encoding="utf-8")) if (d / "spec.json").exists() else {}
    pub = json.dumps({k: v for k, v in (spec.get("youtube") or {}).items() if k != "sources_internal"}, ensure_ascii=False)
    bad = [b for b in BANNED_PUBLIC if b in pub]
    if bad:
        err.append(f"spec.youtube (công khai) chứa chuỗi cấm: {bad}")
    yt = spec.get("youtube") or {}
    # T2B (26/10/2026): spec.youtube chỉ có titles/summary/2 nguồn -> mô tả công khai trống, không hẹn giờ, không playlist
    lack = [k for k in ("publish_at", "playlist", "chapter_titles", "tags", "video_credits") if not yt.get(k)]
    if lack:
        err.append(f"spec.youtube thiếu {lack} (xem mẫu mim-ke-huy-diet-petrov)")
    if len(yt.get("sources") or []) < 8:
        err.append(f"spec.youtube.sources chỉ {len(yt.get('sources') or [])} URL công khai (< 8)")
    # Tên nước ngoài không có bảng phát âm: giọng Việt đọc thô "Welchman", "Bletchley" (T2B: 0 mục say cho ~40 tên)
    foreign = set()
    for f in chs:
        for x in json.loads(f.read_text(encoding="utf-8")).get("lines", []):
            foreign |= {w for w in re.findall(r"\b[A-Z][a-zA-Z\-]{2,}\b", text_of(x)) if w.isascii()}
    if len(foreign) >= 8 and not spec.get("say"):
        err.append(f"{len(foreign)} tên/thuật ngữ nước ngoài trong lời đọc mà spec không có bảng say")
    title = (yt.get("titles") or [spec.get("title", "")])[0]
    if len(title) > 60:
        err.append(f"tiêu đề {len(title)} ký tự > 60")
    stats = {"âm tiết": syl, "phút": round(dur / 60, 1), "cảnh": scenes, "giây/cảnh": round(sps, 1),
             "clip khác": len(clips), "ảnh khác": len(images), "URL nguồn": len(re.findall(r"https?://", fc))}
    return err, warn, stats


def main() -> int:
    sys.path.insert(0, str(ROOT))
    from factory.console import utf8_console
    utf8_console()
    ap = argparse.ArgumentParser()
    ap.add_argument("topic")
    ap.add_argument("--min-syl", type=int, default=1900)
    a = ap.parse_args()
    err, warn, stats = gate(a.topic, a.min_syl)
    print(f"{a.topic}: " + ", ".join(f"{k} {v}" for k, v in stats.items()))
    for w in warn:
        print(f"  cảnh báo: {w}")
    for e in err:
        print(f"  LỖI: {e}")
    print("ĐẠT" if not err else f"TRƯỢT ({len(err)} lỗi)")
    return 1 if err else 0


if __name__ == "__main__":
    sys.exit(main())

"""Sinh spec.json + scenes/hud/bgm của từng chNN.json cho video dài MIM "KẺ HỦY DIỆT ngoài đời thật: Stanislav Petrov, đêm 26/9/1983".

    python data/long/mim-ke-huy-diet-petrov/gen_scenes.py     # giữ nguyên "lines" + "title" (do motion/long/script_lines.py ghi)

Kịch bản + nguồn: script.md và factcheck.md. Pha 1: chỉ viết file; chưa dựng, chưa tải ảnh/clip. imgs ghi tên File: Commons, giấy phép
đã đọc qua Commons API (extmetadata LicenseShortName) ngày 23/10/2026, phải đọc lại ở pha 2 trước khi tải.
Không dùng ảnh chân dung Petrov (mọi ảnh chân dung trên Commons là CC BY-SA, MIM không nhận). Không có hình phim Kẻ Hủy Diệt: phim chỉ
được nhắc bằng lời và chữ. Clip Pexels (vid) chỉ là B-roll trung tính, chọn từ `pexels.py search` (chưa tải; pha 2 chạy `get` rồi
`motion/long/clip_sheet.py` để soát logo/chữ).
Lộ trình dạng "bạn ngồi vào ghế trực": bảng ledger "GHẾ TRỰC · BẠN ĐANG CÓ" thêm đúng một dòng ở CH01, CH02, CH03, CH04, CH06, CH07;
cảnh question "BÁO LÊN | CHƯA" ở cuối CH00–CH07 (CH05 là ghế phía Mỹ); CH08 mới kể quyết định của Petrov.
Mọi neo [dòng, "từ"] chỉ dùng chữ nằm trong lời đọc; không neo vào chữ số hay chữ có trong bảng "say".
"""
