", "t": 33.01, "d": 0.305}, {"w": "trăm", "t": 33.315, "d": 0.105}, {"w": "mười", "t": 33.42, "d": 0.28}, {"w": "tám", "t": 33.7, "d": 0.225}, {"w": "tới", "t": 33.925, "d": 0.06}, {"w": "đầu", "t": 33.985, "d": 0.32}, {"w": "tháng", "t": 34.305, "d": 0.06}, {"w": "mười", "t": 34.365, "d": 0.155}, {"w": "năm", "t": 34.52, "d": 0.325}, {"w": "nay.", "t": 34.845, "d": 0.255}]}, {"text": "Nhưng trước hết, phải có một cái mốc để so.", "start": 35.8, "end": 38.44, "words": [{"w": "Nhưng", "t": 35.9, "d": 0.16}, {"w": "trước", "t": 36.06, "d": 0.155}, {"w": "hết,", "t": 36.215, "d": 0.38}, {"w": "phải", "t": 36.595, "d": 0.125}, {"w": "có", "t": 36.72, "d": 0.22}, {"w": "một", "t": 36.94, "d": 0.31}, {"w": "cái", "t": 37.25, "d": 0.145}, {"w": "mốc", "t": 37.395, "d": 0.215}, {"w": "để", "t": 37.61, "d": 0.215}, {"w": "so.", "t": 37.825, "d": 0.285}]}, {"text": "Chọn bừa một ngày bất kỳ trong tám năm ấy, rồi nhìn năm phiên sau, hay hai mươi phiên sau.", "start": 38.76, "end": 43.64, "words": [{"w": "Chọn", "t": 38.805, "d": 0.115}, {"w": "bừa", "t": 38.92, "d": 0.365}, {"w": "một", "t": 39.285, "d": 0.215}, {"w": "ngày", "t": 39.5, "d": 0.18}, {"w": "bất", "t": 39.68, "d": 0.2}, {"w": "kỳ", "t": 39.88, "d": 0.225}, {"w": "trong", "t": 40.105, "d": 0.22}, {"w": "tám", "t": 40.325, "d": 0.14}, {"w": "năm", "t": 40.465, "d": 0.295}, {"w": "ấy,", "t": 40.76, "d": 0.15}, {"w": "rồi", "t": 40.91, "d": 0.21}, {"w": "nhìn", "t": 41.12, "d": 0.345}, {"w": "năm", "t": 41.465, "d": 0.215}, {"w": "phiên", "t": 41.68, "d": 0.245}, {"w": "sau,", "t": 41.925, "d": 0.32}, {"w": "hay", "t": 42.245, "d": 0.105}, {"w": "hai", "t": 42.35, "d": 0.275}, {"w": "mươi", "t": 42.625, "d": 0.11}, {"w": "phiên", "t": 42.735, "d": 0.19}, {"w": "sau.", "t": 42.925, "d": 0.4}]}, {"text": "Khoảng sáu trên mười lần, chỉ số cao hơn.", "start": 43.96, "end": 46.44, "words": [{"w": "Khoảng", "t": 44.06, "d": 0.26}, {"w": "sáu", "t": 44.32, "d": 0.185}, {"w": "trên", "t": 44.505, "d": 0.06}, {"w": "mười", "t