def beat2_advice(spec: dict) -> str | None:
    """KÃªnh MIM/CK mÃ  spec chÆ°a báº­t beat2 -> engine chá»¯ cÅ© (sync má» chá» lá»i, khuÃ´n láº·p): MIM #5 09/10 cÃ³ 9 Ä‘oáº¡n trá»‘ng á»Ÿ QA final,
    pháº£i báº­t beat2 rá»“i render láº¡i (retro 3 má»¥c 17). Chá»‰ nháº¯c (video cÅ© dá»±ng láº¡i giá»¯ Ä‘Ãºng hÃ¬nh cÅ©)."""
    if spec.get("channel") in ("MIM", "CK") and not spec.get("beat2"):
        return f"spec chÆ°a báº­t \"beat2\": true (kÃªnh {spec['channel']}) â€” engine chá»¯ cÅ© gÃ¢y mÃ n trá»‘ng/láº·p khuÃ´n (retro 3 má»¥c 17)"
    return None


def html_for() -> str:
    """HTML cá»§a composition; beat2 báº­t -> thÃªm beat2.css (sau beat.css) + beat2.js (sau beat.js, trÆ°á»›c casewide.js).
    beat2 táº¯t -> Ä‘Ãºng HTML cÅ© tá»«ng byte (render_key cá»§a video cÅ© khÃ´ng Ä‘á»•i)."""
    if not BEAT2["on"]:
        return HTML
    h = HTML.replace('beat.css" />\n', 'beat.css" />\n' + B2_CSS, 1).replace('beat.js"></script>\n', 'beat.js"></script>\n' + B2_JS, 1)
    assert B2_CSS in h and B2_JS in h
    return h


def run(cmd, extra_env=None, **kw):
    env = os.environ.copy()
    env["PATH"] = FF + os.pathsep + env["PATH"]
    env.update(extra_env or {})
    return subprocess.run(cmd, env=env, capture_output=True, text=True, encoding="utf-8", errors="replace", **kw)


def do_tts(topic, only=None):
    spec, chs, od = load(topic)
    tot, rows = 0.0, []
    for name, ch in chs:
        if only and name not in only:
            continue
        t = speak(ch["lines"], od, name)
        (od / name / "timing.json").write_text(json.dumps(t, ensure_ascii=False, indent=1), encoding="utf-8")
        syl = sum(len(line_text(x).split()) for x in ch["lines"])
        rows.append((name, syl, t["duration"]))
        tot += t["duration"]
    for name, syl, d in rows:
        print(f"{name}: {syl:5d} Ã¢m tiáº¿t  {d / 60:5.2f} phÃºt  ({syl / (d / 60):.0f}/phÃºt)")
    print(f"Tá»”NG: {sum(r[1] for r in rows)} Ã¢m tiáº¿t, {tot / 60:.2f} phÃºt")


