motion/hf/assets/long\mim-ai-hallucinate\ch05\data.js:1:window.CASE = {"topic": "mim-ai-hallucinate", "ch": "ch05", "dur": 65.46, "seed": 23524, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 05", "t": "ĐẾM NHỮNG TRÍCH DẪN MA"}, "acc": ["ai", "chatgpt", "varghese", "bịa", "ảo", "giác", "nguồn", "gác", "cổng", "đoán"], "lines": [{"text": "Cũng năm 2023, hai nhà nghiên cứu ở Mỹ, William Walters và Esther Wilder, nhờ ChatGPT viết tám mươi tư bài tổng quan ngắn.", "start": 0.0, "end": 7.92, "words": [{"w": "Cũng", "t": 0.09, "d": 0.265}, {"w": "năm", "t": 0.355, "d": 0.255}, {"w": "2023,", "t": 0.61, "d": 1.515}, {"w": "hai", "t": 2.125, "d": 0.18}, {"w": "nhà", "t": 2.305, "d": 0.25}, {"w": "nghiên", "t": 2.555, "d": 0.335}, {"w": "cứu", "t": 2.89, "d": 0.185}, {"w": "ở", "t": 3.075, "d": 0.06}, {"w": "Mỹ,", "t": 3.135, "d": 0.42}, {"w": "William", "t": 3.555, "d": 0.25}, {"w": "Walters", "t": 3.805, "d": 0.25}, {"w": "và", "t": 4.055, "d": 0.14}, {"w": "Esther", "t": 4.195, "d": 0.325}, {"w": "Wilder,", "t": 4.52, "d": 0.305}, {"w": "nhờ", "t": 4.825, "d": 0.255}, {"w": "ChatGPT", "t": 5.08, "d": 0.825}, {"w": "viết", "t": 5.905, "d": 0.175}, {"w": "tám", "t": 6.08, "d": 0.165}, {"w": "mươi", "t": 6.245, "d": 0.34}, {"w": "tư", "t": 6.585, "d": 0.07}, {"w": "bài", "t": 6.655, "d": 0.26}, {"w": "tổng", "t": 6.915, "d": 0.315}, {"w": "quan", "t": 7.23, "d": 0.14}, {"w": "ngắn.", "t": 7.37, "d": 0.33}]}, {"text": "Rồi họ dò từng tài liệu tham khảo trong đó, tổng cộng sáu trăm ba mươi sáu tài liệu.", "start": 8.72, "end": 13.12, "words": [{"w": "Rồi", "t": 8.82, "d": 0.2}, {"w": "họ", "t": 9.02, "d": 0.2}, {"w": "dò", "t": 9.22, "d": 0.255}, {"w": "từng", "t": 9.475, "d": 0.195}, {"w": "tài", "t": 9.67, "d": 0.245}, {"w": "liệu", "t": 9.915, "d": 0.075}, {"w": "tham", "t": 9.99, "d": 0.235}, {"w": "khảo", "t": 10.