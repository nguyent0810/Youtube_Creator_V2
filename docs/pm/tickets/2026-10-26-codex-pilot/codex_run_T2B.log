motion/hf/assets/long\mim-siri-susan-bennett\ch04\data.js:1:window.CASE = {"topic": "mim-siri-susan-bennett", "ch": "ch04", "dur": 74.54, "seed": 33062, "accent": "#f472b6", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 04", "t": "ĐÁY CUỘN BĂNG: PHÒNG THÍ NGHIỆM NĂM 2003"}, "acc": ["giọng", "mảnh", "băng", "ghép", "người", "nấc", "cắt", "thật"], "lines": [{"text": "Kim lùi về 2003.", "start": 0.0, "end": 1.68, "words": [{"w": "Kim", "t": 0.0, "d": 0.085}, {"w": "lùi", "t": 0.085, "d": 0.27}, {"w": "về", "t": 0.355, "d": 0.17}, {"w": "2003.", "t": 0.525, "d": 0.955}]}, {"text": "Đây là đáy cuộn băng.", "start": 2.48, "end": 4.08, "words": [{"w": "Đây", "t": 2.48, "d": 0.33}, {"w": "là", "t": 2.81, "d": 0.235}, {"w": "đáy", "t": 3.045, "d": 0.415}, {"w": "cuộn", "t": 3.46, "d": 0.225}, {"w": "băng.", "t": 3.685, "d": 0.395}]}, {"text": "DARPA, cơ quan nghiên cứu quốc phòng Mỹ, có chương trình PAL, tạm dịch: trợ lý cá nhân biết học.", "start": 5.08, "end": 10.04, "words": [{"w": "DARPA,", "t": 5.08, "d": 0.42}, {"w": "cơ", "t": 5.5, "d": 0.205}, {"w": "quan", "t": 5.705, "d": 0.06}, {"w": "nghiên", "t": 5.765, "d": 0.28}, {"w": "cứu", "t": 6.045, "d": 0.235}, {"w": "quốc", "t": 6.28, "d": 0.2}, {"w": "phòng", "t": 6.48, "d": 0.125}, {"w": "Mỹ,", "t": 6.605, "d": 0.47}, {"w": "có", "t": 7.075, "d": 0.075}, {"w": "chương", "t": 7.15, "d": 0.205}, {"w": "trình", "t": 7.355, "d": 0.345}, {"w": "PAL,", "t": 7.7, "d": 0.33}, {"w": "tạm", "t": 8.03, "d": 0.065}, {"w": "dịch:", "t": 8.095, "d": 0.475}, {"w": "trợ", "t": 8.57, "d": 0.12}, {"w": "lý", "t": 8.69, "d": 0.13}, {"w": "cá", "t": 8.82, "d": 0.31}, {"w": "nhân", "t": 9.13, "d": 0.15}, {"w": "biết", "t": 9.28, "d": 0.27}, {"w": "học.", "t": 9.55, "d": 0.305}]}, {"text": "Trong chương trình ấy có dự án CALO, do viện nghiên cứu SRI ở California dẫn dắt.", "start": 10.36, "end": 15.16, "words": [{"w": "Trong", "t": 10.36, "d": 0.225}, {"w": "chương", "t": 10.585, "d": 0.355}, {"w": "trình", "t": 10.94, "d": 0.155}, {"w": "ấy", "t": 11.095, "d": 0.26}, {"w": "có", "t": 11.355, "d": 0.37}, {"w": "dự", "t": 11.725, "d": 0.25}, {"w": "án", "t": 11.975, "d": 0.06}, {"w": "CALO,", "t": 12.035, "d": 0.595}, {"w": "do", "t": 12.63, "d": 0.19}, {"w": "viện", "t": 12.82, "d": 0.135}, {"w": "nghiên", "t": 12.955, "d": 0.285}, {"w": "cứu", "t": 13.24, "d": 0.25}, {"w": "SRI", "t": 13.49, "d": 0.225}, {"w": "ở", "t": 13.715, "d": 0.375}, {"w": "California", "t": 14.09, "d": 0.145}, {"w": "dẫn", "t": 14.235, "d": 0.41}, {"w": "dắt.", "t": 14.645, "d": 0.295}]}, {"text": "Theo SRI, dự án kéo dài năm năm, bắt đầu từ 2003.", "start": 15.48, "end": 19.4, "words": [{"w": "Theo", "t": 15.49, "d": 0.255}, {"w": "SRI,", "t": 15.745, "d": 0.345}, {"w": "dự", "t": 16.09, "d": 0.19}, {"w": "án", "t": 16.28, "d": 0.075}, {"w": "kéo", "t": 16.355, "d": 0.325}, {"w": "dài", "t": 16.68, "d": 0.06}, {"w": "năm", "t": 16.74, "d": 0.185}, {"w": "năm,", "t": 16.925, "d": 0.46}, {"w": "bắt", "t": 17.385, "d": 0.21}, {"w": "đầu", "t": 17.595, "d": 0.14}, {"w": "từ", "t": 17.735, "d": 0.085}, {"w": "2003.", "t": 17.82, "d": 1.4}]}, {"text": "Hơn ba trăm nhà nghiên cứu, từ hai mươi hai viện và trường, cùng tham gia.", "start": 19.72, "end": 23.32, "words": [{"w": "Hơn", "t": 19.72, "d": 0.21}, {"w": "ba", "t": 19.93, "d": 0.255}, {"w": "trăm", "t": 20.185, "d": 0.19}, {"w": "nhà", "t": 20.375, "d": 0.195}, {"w": "nghiên", "t": 20.57, "d": 0.19}, {"w": "cứu,", "t": 20.76, "d": 0.16}, {"w": "từ", "t": 20.92, "d": 0.315}, {"w": "hai", "t": 21.235, "d": 0.165}, {"w": "mươi", "t": 21.4, "d": 0.145}, {"w": "hai", "t": 21.545, "d": 0.205}, {"w": "viện", "t": 21.75, "d": 0.135}, {"w": "và", "t": 21.885, "d": 0.195}, {"w": "trường,", "t": 22.08, "d": 0.435}, {"w": "cùng", "t": 22.515, "d": 0.075}, {"w": "tham", "t": 22.59, "d": 0.24}, {"w": "gia.", "t": 22.83, "d": 0.305}]}, {"text": "Trang của SRI hình dung nó bằng một câu rất đời thường.", "start": 24.32, "end": 26.96, "words": [{"w": "Trang", "t": 24.32, "d": 0.16}, {"w": "của", "t": 24.48, "d": 0.295}, {"w": "SRI", "t": 24.775, "d": 0.055}, {"w": "hình", "t": 24.83, "d": 0.32}, {"w": "dung", "t": 25.15, "d": 0.195}, {"w": "nó", "t": 25.345, "d": 0.115}, {"w": "bằng", "t": 25.46, "d": 0.265}, {"w": "một", "t": 25.725, "d": 0.175}, {"w": "câu", "t": 25.9, "d": 0.18}, {"w": "rất", "t": 26.08, "d": 0.175}, {"w": "đời", "t": 26.255, "d": 0.1}, {"w": "thường.", "t": 26.355, "d": 0.355}]}, {"text": "Này CALO, xếp giúp tôi một phòng họp nhé?", "start": 27.28, "end": 29.84, "words": [{"w": "Này", "t": 27.395, "d": 0.205}, {"w": "CALO,", "t": 27.6, "d": 0.42}, {"w": "xếp", "t": 28.02, "d": 0.1}, {"w": "giúp", "t": 28.12, "d": 0.255}, {"w": "tôi", "t": 28.375, "d": 0.2}, {"w": "một", "t": 28.575, "d": 0.18}, {"w": "phòng", "t": 28.755, "d": 0.15}, {"w": "họp", "t": 28.905, "d": 0.225}, {"w": "nhé?", "t": 29.13, "d": 0.375}]}, {"text": "DARPA ghi rằng thành quả của PAL được dùng cho quân đội.", "start": 30.84, "end": 33.64, "words": [{"w": "DARPA", "t": 30.84, "d": 0.11}, {"w": "ghi", "t": 30.95, "d": 0.275}, {"w": "rằng", "t": 31.225, "d": 0.315}, {"w": "thành", "t": 31.54, "d": 0.105}, {"w": "quả", "t": 31.645, "d": 0.305}, {"w": "của", "t": 31.95, "d": 0.205}, {"w": "PAL", "t": 32.155, "d": 0.065}, {"w": "được", "t": 32.22, "d": 0.185}, {"w": "dùng", "t": 32.405, "d": 0.36}, {"w": "cho", "t": 32.765, "d": 0.06}, {"w": "quân", "t": 32.825, "d": 0.305}, {"w": "đội.", "t": 33.13, "d": 0.29}]}, {"text": "Và cả cho việc trò chuyện bằng giọng nói trên thiết bị cầm tay của dân thường.", "start": 33.96, "end": 37.64, "words": [{"w": "Và", "t": 33.96, "d": 0.235}, {"w": "cả", "t": 34.195, "d": 0.145}, {"w": "cho", "t": 34.34, "d": 0.16}, {"w": "việc", "t": 34.5, "d": 0.185}, {"w": "trò", "t": 34.685, "d": 0.31}, {"w": "chuyện", "t": 34.995, "d": 0.075}, {"w": "bằng", "t": 35.07, "d": 0.27}, {"w": "giọng", "t": 35.34, "d": 0.24}, {"w": "nói", "t": 35.58, "d": 0.06}, {"w": "trên", "t": 35.64, "d": 0.285}, {"w": "thiết", "t": 35.925, "d": 0.195}, {"w": "bị", "t": 36.12, "d": 0.125}, {"w": "cầm", "t": 36.245, "d": 0.205}, {"w": "tay", "t": 36.45, "d": 0.195}, {"w": "của", "t": 36.645, "d": 0.26}, {"w": "dân", "t": 36.905, "d": 0.165}, {"w": "thường.", "t": 37.07, "d": 0.315}]}, {"text": "Từ đó, năm 2007, SRI tách ra một công ty riêng, đặt tên là Siri.", "start": 37.96, "end": 43.24, "words": [{"w": "Từ", "t": 37.96, "d": 0.32}, {"w": "đó,", "t": 38.28, "d": 0.17}, {"w": "năm", "t": 38.45, "d": 0.295}, {"w": "2007,", "t": 38.745, "d": 1.47}, {"w": "SRI", "t": 40.215, "d": 0.28}, {"w": "tách", "t": 40.495, "d": 0.235}, {"w": "ra", "t": 40.73, "d": 0.15}, {"w": "một", "t": 40.88, "d": 0.405}, {"w": "công", "t": 41.285, "d": 0.06}, {"w": "ty", "t": 41.345, "d": 0.27}, {"w": "riêng,", "t": 41.615, "d": 0.49}, {"w": "đặt", "t": 42.105, "d": 0.065}, {"w": "tên", "t": 42.17, "d": 0.22}, {"w": "là", "t": 42.39, "d": 0.295}, {"w": "Siri.", "t": 42.685, "d": 0.37}]}, {"text": "Đến đây có một chi tiết đáng để ý.", "start": 44.24, "end": 46.0, "words": [{"w": "Đến", "t": 44.36, "d": 0.115}, {"w": "đây", "t": 44.475, "d": 0.135}, {"w": "có", "t": 44.61, "d": 0.25}, {"w": "một", "t": 44.86, "d": 0.07}, {"w": "chi", "t": 44.93, "d": 0.145}, {"w": "tiết", "t": 45.075, "d": 0.135}, {"w": "đáng", "t": 45.21, "d": 0.255}, {"w": "để", "t": 45.465, "d": 0.06}, {"w": "ý.", "t": 45.525, "d": 0.27}]}, {"text": "Phòng thí nghiệm này làm phần hiểu câu hỏi và làm việc giúp bạn.", "start": 46.32, "end": 49.2, "words": [{"w": "Phòng", "t": 46.32, "d": 0.1}, {"w": "thí", "t": 46.42, "d": 0.25}, {"w": "nghiệm", "t": 46.67, "d": 0.25}, {"w": "này", "t": 46.92, "d": 0.175}, {"w": "làm", "t": 47.095, "d": 0.095}, {"w": "phần", "t": 47.19, "d": 0.255}, {"w": "hiểu", "t": 47.445, "d": 0.14}, {"w": "câu", "t": 47.585, "d": 0.27}, {"w": "hỏi", "t": 47.855, "d": 0.18}, {"w": "và", "t": 48.035, "d": 0.14}, {"w": "làm", "t": 48.175, "d": 0.23}, {"w": "việc", "t": 48.405, "d": 0.07}, {"w": "giúp", "t": 48.475, "d": 0.28}, {"w": "bạn.", "t": 48.755, "d": 0.23}]}, {"text": "Không tài liệu nào mình đọc được nói nơi này thu giọng của bà Bennett.", "start": 49.52, "end": 52.96, "words": [{"w": "Không", "t": 49.52, "d": 0.11}, {"w": "tài", "t": 49.63, "d": 0.265}, {"w": "liệu", "t": 49.895, "d": 0.335}, {"w": "nào", "t": 50.23, "d": 0.19}, {"w": "mình", "t": 50.42, "d": 0.175}, {"w": "đọc", "t": 50.595, "d": 0.245}, {"w": "được", "t": 50.84, "d": 0.15}, {"w": "nói", "t": 50.99, "d": 0.285}, {"w": "nơi", "t": 51.275, "d": 0.19}, {"w": "này", "t": 51.465, "d": 0.06}, {"w": "thu", "t": 51.525, "d": 0.29}, {"w": "giọng", "t": 51.815, "d": 0.255}, {"w": "của", "t": 52.07, "d": 0.155}, {"w": "bà", "t": 52.225, "d": 0.21}, {"w": "Bennett.", "t": 52.435, "d": 0.335}]}, {"text": "Theo CNN, giọng ấy đi đường khác: một hợp đồng với ScanSoft, rồi tới Nuance.", "start": 53.28, "end": 58.16, "words": [{"w": "Theo", "t": 53.29, "d": 0.17}, {"w": "CNN,", "t": 53.46, "d": 0.635}, {"w": "giọng", "t": 54.095, "d": 0.115}, {"w": "ấy", "t": 54.21, "d": 0.225}, {"w": "đi", "t": 54.435, "d": 0.465}, {"w": "đường", "t": 54.9, "d": 0.25}, {"w": "khác:", "t": 55.15, "d": 0.205}, {"w": "một", "t": 55.355, "d": 0.305}, {"w": "hợp", "t": 55.66, "d": 0.265}, {"w": "đồng", "t": 55.925, "d": 0.385}, {"w": "với", "t": 56.31, "d": 0.255}, {"w": "ScanSoft,", "t": 56.565, "d": 0.48}, {"w": "rồi", "t": 57.045, "d": 0.31}, {"w": "tới", "t": 57.355, "d": 0.06}, {"w": "Nuance.", "t": 57.415, "d": 0.52}]}, {"text": "Vậy là có hai sợi băng.", "start": 59.16, "end": 60.68, "words": [{"w": "Vậy", "t": 59.24, "d": 0.155}, {"w": "là", "t": 59.395, "d": 0.255}, {"w": "có", "t": 59.65, "d": 0.155}, {"w": "hai", "t": 59.805, "d": 0.255}, {"w": "sợi", "t": 60.06, "d": 0.16}, {"w": "băng.", "t": 60.22, "d": 0.24}]}, {"text": "Một sợi là cái đầu, sinh ra ở phòng thí nghiệm.", "start": 61.0, "end": 63.48, "words": [{"w": "Một", "t": 61.02, 