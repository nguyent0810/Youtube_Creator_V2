motion/hf/assets/long\mim-google-maps-kal007\ch04\data.js:1:window.CASE = {"topic": "mim-google-maps-kal007", "ch": "ch04", "dur": 79.14, "seed": 28794, "accent": "#34d399", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 04", "t": "MỘT TRĂM MÉT CỐ Ý"}, "acc": ["thước", "nấc", "lệch", "GPS", "miễn", "nhoè", "chấm", "hướng"], "lines": [{"text": "Mốc năm 1988 trôi qua.", "start": 0.0, "end": 2.24, "words": [{"w": "Mốc", "t": 0.0, "d": 0.125}, {"w": "năm", "t": 0.125, "d": 0.23}, {"w": "1988", "t": 0.355, "d": 1.295}, {"w": "trôi", "t": 1.65, "d": 0.17}, {"w": "qua.", "t": 1.82, "d": 0.23}]}, {"text": "Vệ tinh GPS thế hệ thứ hai đầu tiên phải tới ngày 14 tháng 2 năm 1989 mới được phóng.", "start": 3.04, "end": 8.32, "words": [{"w": "Vệ", "t": 3.04, "d": 0.125}, {"w": "tinh", "t": 3.165, "d": 0.175}, {"w": "GPS", "t": 3.34, "d": 0.545}, {"w": "thế", "t": 3.885, "d": 0.235}, {"w": "hệ", "t": 4.12, "d": 0.165}, {"w": "thứ", "t": 4.285, "d": 0.17}, {"w": "hai", "t": 4.455, "d": 0.085}, {"w": "đầu", "t": 4.54, "d": 0.175}, {"w": "tiên", "t": 4.715, "d": 0.14}, {"w": "phải", "t": 4.855, "d": 0.205}, {"w": "tới", "t": 5.06, "d": 0.18}, {"w": "ngày", "t": 5.24, "d": 0.16}, {"w": "14", "t": 5.4, "d": 0.4}, {"w": "tháng", "t": 5.8, "d": 0.17}, {"w": "2", "t": 5.97, "d": 0.06}, {"w": "năm", "t": 6.03, "d": 0.225}, {"w": "1989", "t": 6.255, "d": 1.17}, {"w": "mới", "t": 7.425, "d": 0.08}, {"w": "được", "t": 7.505, "d": 0.315}, {"w": "phóng.", "t": 7.82, "d": 0.2}]}, {"text": "Và khi tín hiệu tới tay người dân, nó mang sẵn một lớp nhiễu.", "start": 8.64, "end": 11.52, "words": [{"w": "Và", "t": 8.64, "d": 0.25}, {"w": "khi", "t": 8.89, "d": 0.105}, {"w": "tín", "t": 8.995, "d": 0.225}, {"w": "hiệu", "t": 9.22, "d": 0.145}, {"w": "tới", "t": 9.365, "d": 0.14}, {"w": "tay", "t": 9.505, "d": 0.17}, {"w": "người", "t": 9.675, "d": 0.25}, {"w": "dân,", "t": 9.925, "d": 0.195}, {"w": "nó", "t": 10.12, "d": 0.22}, {"w": "mang", "t": 10.34, "d": 0.17}, {"w": "sẵn", "t": 10.51, "d": 0.15}, {"w": "một", "t": 10.66, "d": 0.225}, {"w": "lớp", "t": 10.885, "d": 0.2}, {"w": "nhiễu.", "t": 11.085, "d": 0.27}]}, {"text": "Phía Mỹ gọi lớp nhiễu ấy là \"khả dụng có chọn lọc\", viết tắt SA.", "start": 11.84, "end": 15.6, "words": [{"w": "Phía", "t": 11.84, "d": 0.28}, {"w": "Mỹ", "t": 12.12, "d": 0.165}, {"w": "gọi", "t": 12.285, "d": 0.195}, {"w": "lớp", "t": 12.48, "d": 0.18}, {"w": "nhiễu", "t": 12.66, "d": 0.3}, {"w": "ấy", "t": 12.96, "d": 0.13}, {"w": "là", "t": 13.09, "d": 0.185}, {"w": "\"khả", "t": 13.275, "d": 0.265}, {"w": "dụng", "t": 13.54, "d": 0.21}, {"w": "có", "t": 13.75, "d": 0.135}, {"w": "chọn", "t": 13.885, "d": 0.32}, {"w": "lọc\",", "t": 14.205, "d": 0.2}, {"w": "viết", "t": 14.405, "d": 0.34}, {"w": "tắt", "t": 14.745, "d": 0.205}, {"w": "SA.", "t": 14.95, "d": 0.455}]}, {"text": "Trang chính thức về GPS của chính phủ Mỹ mô tả: đó là sự cố ý làm suy giảm tín hiệu GPS công cộng, vì lý do an ninh quốc gia.", "start": 15.92, "end": 22.8, "words": [{"w": "Trang", "t": 15.92, "d": 0.11}, {"w": "chính", "t": 16.03, "d": 0.3}, {"w": "thức", "t": 16.33, "d": 0.21}, {"w": "về", "t": 16.54, "d": 0.055}, {"w": "GPS", "t": 16.595, "d": 0.61}, {"w": "của", "t": 17.205, "d": 0.16}, {"w": "chính", "t": 17.365, "d": 0.135}, {"w": "phủ", "t": 17.5, "d": 0.19}, {"w": "Mỹ", "t": 17.69, "d": 0.305}, {"w": "mô", "t": 17.995, "d": 0.185}, {"w": "tả:", "t": 18.18, "d": 0.2}, {"w": "đó", "t": 18.38, "d": 0.115}, {"w": "là", "t": 18.495, "d": 0.285}, {"w": "sự", "t": 18.78, "d": 0.205}, {"w": "cố", "t": 18.985, "d": 0.205}, {"w": "ý", "t": 19.19, "d": 0.14}, {"w": "làm", "t": 19.33, "d": 0.205}, {"w": "suy", "t": 19.535, "d": 0.075}, {"w": "giảm", "t": 19.61, "d": 0.175}, {"w": "tín", "t": 19.785, "d": 0.25}, {"w": "hiệu", "t": 20.035, "d": 0.165}, {"w": "GPS", "t": 20.2, "d": 0.635}, {"w": "công", "t": 20.835, "d": 0.18}, {"w": "cộng,", "t": 21.015, "d": 0.295}, {"w": "vì", "t": 21.31, "d": 0.18}, {"w": "lý", "t": 21.49, "d": 0.07}, {"w": "do", "t": 21.56, "d": 0.185}, {"w": "an", "t": 21.745, "d": 0.165}, {"w": "ninh", "t": 21.91, "d": 0.2}, {"w": "quốc", "t": 22.11, "d": 0.17}, {"w": "gia.", "t": 22.28, "d": 0.34}]}, {"text": "Nhoè cỡ nào?", "start": 23.12, "end": 24.96, "words": [{"w": "Nhoè", "t": 23.21, "d": 0.695}, {"w": "cỡ", "t": 23.905, "d": 0.3}, {"w": "nào?", "t": 24.205, "d": 0.755}]}, {"text": "Theo một tài liệu của Nhà Trắng năm 2000, máy dẫn đường trên ô tô khi ấy chỉ biết xe nằm trong phạm vi chừng một trăm mét.", "start": 25.56, "end": 31.32, "words": [{"w": "Theo", "t": 25.56, "d": 0.2}, {"w": "một", "t": 25.76, "d": 0.125}, {"w": "tài", "t": 25.885, "d": 0.185}, {"w": "liệu", "t": 26.07, "d": 0.295}, {"w": "của", "t": 26.365, "d": 0.17}, {"w": "Nhà", "t": 26.535, "d": 0.125}, {"w": "Trắng", "t": 26.66, "d": 0.16}, {"w": "năm", "t": 26.82, "d": 0.27}, {"w": "2000,", "t": 27.09, "d": 0.33}, {"w": "máy", "t": 27.42, "d": 0.29}, {"w": "dẫn", "t": 27.71, "d": 0.1}, {"w": "đường", "t": 27.81, "d": 0.25}, {"w": "trên", "t": 28.06, "d": 0.255}, {"w": "ô", "t": 28.315, "d": 0.18}, {"w": "tô", "t": 28.495, "d": 0.185}, {"w": "khi", "t": 28.68, "d": 0.085}, {"w": "ấy", "t": 28.765, "d": 0.12}, {"w": "chỉ", "t": 28.885, "d": 0.245}, {"w": "biết", "t": 29.13, "d": 0.175}, {"w": "xe", "t": 29.305, "d": 0.14}, {"w": "nằm", "t": 29.445, "d": 0.335}, {"w": "trong", "t": 29.78, "d": 0.185}, {"w": "phạm", "t": 29.965, "d": 0.185}, {"w": "vi", "t": 30.15, "d": 0.15}, {"w": "chừng", "t": 30.3, "d": 0.215}, {"w": "một", "t": 30.515, "d": 0.165}, {"w": "trăm", "t": 30.68, "d": 0.115}, {"w": "mét.", "t": 30.795, "d": 0.305}]}, {"text": "Một trăm mét: nấc thứ hai của cây thước.", "start": 32.32, "end": 34.48, "words": [{"w": "Một", "t": 32.34, "d": 0.12}, {"w": "trăm", "t": 32.46, "d": 0.35}, {"w": "mét:", "t": 32.81, "d": 0.3}, {"w": "nấc", "t": 33.11, "d": 0.075}, {"w": "thứ", "t": 33.185, "d": 0.32}, {"w": "hai", "t": 33.505, "d": 0.19}, {"w": "của", "t": 33.695, "d": 0.18}, {"w": "cây", "t": 33.875, "d": 0.13}, {"w": "thước.", "t": 34.005, "d": 0.315}]}, {"text": "Nghe thì nhỏ, so với sáu trăm cây số.", "start": 34.8, "end": 37.12, "words": [{"w": "Nghe", "t": 34.8, "d": 0.12}, {"w": "thì", "t": 34.92, "d": 0.395}, {"w": "nhỏ,", "t": 35.315, "d": 0.28}, {"w": "so", "t": 35.595, "d": 0.09}, {"w": "với", "t": 35.685, "d": 0.28}, {"w": "sáu", "t": 35.965, "d": 0.17}, {"w": "trăm", "t": 36.135, "d": 0.225}, {"w": "cây", "t": 36.36, "d": 0.21}, {"w": "số.", "t": 36.57, "d": 0.38}]}, {"text": "Nhưng hãy nghĩ tới hai đường cao tốc chạy song song.", "start": 37.44, "end": 39.84, "words": [{"w": "Nhưng", "t": 37.44, "d": 0.235}, {"w": "hãy", "t": 37.675, "d": 0.19}, {"w": "nghĩ", "t": 37.865, "d": 0.21}, {"w": "tới", "t": 38.075, "d": 0.18}, {"w": "hai", "t": 38.255, "d": 0.075}, {"w": "đường", "t": 38.33, "d": 0.245}, {"w": "cao", "t": 38.575, "d": 0.175}, {"w": "tốc", "t": 38.75, "d": 0.16}, {"w": "chạy", "t": 38.91, "d": 0.17}, {"w": "song", "t": 39.08, "d": 0.19}, {"w": "song.", "t": 39.27, "d": 0.32}]}, {"text": "Tài liệu ấy viết đúng chuyện này: máy khó biết xe đang ở trên đường nào.", "start": 40.16, "end": 43.52, "words": [{"w": "Tài", "t": 40.16, "d": 0.125}, {"w": "liệu", "t": 40.285, "d": 0.165}, {"w": "ấy", "t": 40.45, "d": 0.23}, {"w": "viết", "t": 40.68, "d": 0.3}, {"w": "đúng", "t": 40.98, "d": 0.105}, {"w": "chuyện", "t": 41.085, "d": 0.265}, {"w": "này:", "t": 41.35, "d": 0.265}, {"w": "máy", "t": 41.615, "d": 0.065}, {"w": "khó", "t": 41.68, "d": 0.225}, {"w": "biết", "t": 41.905, "d": 0.17}, {"w": "xe", "t": 42.075, "d": 0.15}, {"w": "đang", "t": 42.225, "d": 0.28}, {"w": "ở", "t": 42.505, "d": 0.16}, {"w": "trên", "t": 42.665, "d": 0.19}, {"w": "đường", "t": 42.855, "d": 0.26}, {"w": "nào.", "t": 43.115, "d": 0.22}]}, {"text": "Số đo thật còn rõ hơn.", "start": 44.52, "end": 45.88, "words": [{"w": "Số", "t": 44.52, "d": 0.13}, {"w": "đo", "t": 44.65, "d": 0.29}, {"w": "thật", "t": 44.94, "d": 0.17}, {"w": "còn", "t": 45.11, "d": 0.085}, {"w": "rõ", "t": 45.195, "d": 0.16}, {"w": "hơn.", "t": 45.355, "d": 0.31}]}, {"text": "Ở một trạm đo tại bang Kentucky, khi còn lớp nhiễu, chín mươi lăm phần trăm số điểm đo rơi trong bán kính bốn mươi lăm mét.", "start": 46.2, "end": 52.52, "words": [{"w": "Ở", "t": 46.295, "d": 0.275}, {"w": "một", "t": 46.57, "d": 0.14}, {"w": "trạm", "t": 46.71, "d": 0.27}, {"w": "đo", "t": 46.98, "d": 0.17}, {"w": "tại", "t": 47.15, "d": 0.25}, {"w": "bang", "t": 47.4, "d": 0.17}, {"w": "Kentucky,", "t": 47.57, "d": 0.405}, {"w": "khi", "t": 47.975, "d": 0.21}, {"w": "còn", "t": 48.185, "d": 0.095}, {"w": "lớp", "t": 48.28, "d": 0.145}, {"w": "nhiễu,", "t": 48.425, "d": 0.495}, {"w": "chín", "t": 48.92, "d": 0.065}, {"w": "mươi", "t": 48.985, "d": 0.375}, {"w": "lăm", "t": 49.36, "d": 0.14}, {"w": "phần", "t": 49.5, "d": 0.105}, {"w": "trăm", "t": 49.605, "d": 0.385}, {"w": "số", "t": 49.99, "d": 0.175}, {"w": "điểm", "t": 50.165, "d": 0.215}, {"w": "đo", "t": 50.38, "d": 0.165}, {"w": "rơi", "t": 50.545, "d": 0.19}, {"w": "trong", "t": 50.735, "d": 0.255}, {"w": "bán", "t": 50.99, "d": 0.25}, {"w": "kính", "t": 51.24, "d": 0.185}, {"w": "bốn", "t": 51.425, "d": 0.165}, {"w": "mươi", "t": 51.59, "d": 0.185}, {"w": "lăm", "t": 51.775, "d": 0.14}, {"w": "mét.", "t": 51.915, "d": 0.425}]}, {"text": "Trang GPS của chính phủ Mỹ ví thế này.", "start": 52.84, "end": 54.84, "words": [{"w": "Trang", "t": 52.91, "d": 0.2}, {"w": "GPS", "t": 53.11, "d": 0.32}, {"w": "của", "t": 53.43, "d": 0.18}, {"w": "chính", "t": 53.61, "d": 0.175}, {"w": "phủ", "t": 53.785, "d": 0.185}, {"w": "Mỹ", "t": 53.97, "d": 0.18}, {"w": "ví", "t": 54.15, "d": 0.145}, {"w": "thế", "t": 54.295, "d": 0.12}, {"w": "này.", "t": 54.415, "d": 0.205}]}, {"text": "Bạn chỉ biết mình đang ở dưới sân, hay trên khán đài một sân bóng bầu dục.", "start": 55.84, "end": 59.2, "words": [{"w": "Bạn", "t": 55.84, "d": 0.11}, {"w