motion/hf/assets/long\ck-b3-tra-gop-0\ch02\data.js:1:window.CASE = {"topic": "ck-b3-tra-gop-0", "ch": "ch02", "dur": 58.78, "seed": 14856, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 02", "t": "CÁI GIÁ THỨ NHẤT VÀ THỨ HAI"}, "acc": ["không", "phí", "giá", "lãi", "thẳng", "góp", "tổng"], "lines": [{"text": "Cái giá thứ nhất dễ thấy nhất.", "start": 0.0, "end": 1.6, "words": [{"w": "Cái", "t": 0.05, "d": 0.16}, {"w": "giá", "t": 0.21, "d": 0.185}, {"w": "thứ", "t": 0.395, "d": 0.06}, {"w": "nhất", "t": 0.455, "d": 0.215}, {"w": "dễ", "t": 0.67, "d": 0.08}, {"w": "thấy", "t": 0.75, "d": 0.16}, {"w": "nhất.", "t": 0.91, "d": 0.31}]}, {"text": "Trả thẳng, được giảm một triệu rưỡi. Bạn trả mười tám triệu rưỡi.", "start": 2.4, "end": 6.0, "words": [{"w": "Trả", "t": 2.46, "d": 0.17}, {"w": "thẳng,", "t": 2.63, "d": 0.385}, {"w": "được", "t": 3.015, "d": 0.265}, {"w": "giảm", "t": 3.28, "d": 0.14}, {"w": "một", "t": 3.42, "d": 0.22}, {"w": "triệu", "t": 3.64, "d": 0.24}, {"w": "rưỡi.", "t": 3.88, "d": 0.355}, {"w": "Bạn", "t": 4.235, "d": 0.11}, {"w": "trả", "t": 4.345, "d": 0.275}, {"w": "mười", "t": 4.62, "d": 0.345}, {"w": "tám", "t": 4.965, "d": 0.055}, {"w": "triệu", "t": 5.02, "d": 0.2}, {"w": "rưỡi.", "t": 5.22, "d": 0.43}]}, {"text": "Cái giá thứ hai nằm trên tấm biển trả góp.", "start": 7.0, "end": 9.32, "words": [{"w": "Cái", "t": 7.045, "d": 0.16}, {"w": "giá", "t": 7.205, "d": 0.19}, {"w": "thứ", "t": 7.395, "d": 0.17}, {"w": "hai", "t": 7.565, "d": 0.215}, {"w": "nằm", "t": 7.78, "d": 0.215}, {"w": "trên", "t": 7.995, "d": 0.205}, {"w": "tấm", "t": 8.2, "d": 0.185}, {"w": "biển", "t": 8.385, "d": 0.18}, {"w": "trả", "t": 8.565, "d": 0.07}, {"w": "góp.", "t": 8.635, "d": 0.325}]}, {"text": "Hai mươi triệu, chia mười hai tháng, lãi suất không.", "start": 9.64, "end": 12.36, "words": [{"w": "Hai", "t": 9.74, "d": 0.25}, {"w": "mươi", "t": 9.99, "d": 0.225}, {"w": "triệu,", "t": 10.215, "d": 0.17}, {"w": "chia", "t": 10.385, "d": 0.345}, {"w": "mười", "t": 10.73, "d": 0.08}, {"w": "hai", "t": 10.81, "d": 0.21}, {"w": "tháng,", "t": 11.02, "d": 0.37}, {"w": "lãi", "t": 11.39, "d": 0.235}, {"w": "suất", "t": 11.625, "d": 0.165}, {"w": "không.", "t": 11.79, "d": 0.275}]}, {"text": "Tổng cộng vẫn là hai mươi triệu. Không thêm một đồng lãi nào.", "start": 12.68, "end": 15.88, "words": [{"w": "Tổng", "t": 12.73, "d": 0.15}, {"w": "cộng", "t": 12.88, "d": 0.235}, {"w": "vẫn", "t": 13.115, "d": 0.15}, {"w": "là", "t": 13.265, "d": 0.235}, {"w": "hai", "t": 13.5, "d": 0.29}, {"w": "mươi", "t": 13.79, "d": 0.225}, {"w": "triệu.", "t": 14.015, "d": 0.235}, {"w": "Không", "t": 14.25, "d": 0.11}, {"w": "thêm", "t": 14.36, "d": 0.25}, {"w": "một", "t": 14.61, "d": 0.305}, {"w": "đồng", "t": 14.915, "d": 0.06}, {"w": "lãi", "t": 14.975, "d": 0.3}, {"w": "nào.", "t": 15.275, "d": 0.295}]}, {"text": "Nhưng hãy đặt hai cột cạnh nhau.", "start": 16.88, "end": 18.72, "words": [{"w": "Nhưng", "t": 16.985, "d": 0.245}, {"w": "hãy", "t": 17.23, "d": 0.205}, {"w": "đặt", "t": 17.435, "d": 0.06}, {"w": "hai", "t": 17.495, "d": 0.24}, {"w": "cột", "t": 17.735, "d": 0.205}, {"w": "cạnh", "t": 17.94, "d": 0.125}, {"w": "nhau.", "t": 18.065, "d": 0.33}]}, {"text": "Chọn trả góp, bạn không còn được giảm một triệu rưỡi kia nữa.", "start": 19.04, "end": 22.32, "words": [{"w": "Chọn", "t": 19.1, "d": 0.19}, {"w": "trả", "t": 19.29, "d": 0.21}, {"w": "góp,", "t": 19.5, "d": 0.38}, {"w": "bạn", "t": 19.88, "d": 0.06}, {"w": "không", "t": 19.94, "d": 0.255}, {"w": "còn", "t": 20.195, "d": 0.195}, {"w": "được", "t": 20.39, "d": 0.31}, {"w": "giảm", "t": 20.7, "d": 0.095}, {"w": "một", "t": 20.795, "d": 0.325}, {"w": "triệu", "t": 21.12, "d": 0.07}, {"w": "rưỡi", "t": 21.19, "d": 0.345}, {"w": "kia", "t": 21.535, "d": 0.075}, {"w": "nữa.", "t": 21.61, "d": 0.36}]}, {"text": "Một triệu rưỡi ấy chính là cái giá của việc được trả chậm.", "start": 22.64, "end": 25.76, "words": [{"w": "Một", "t": 22.745, "d": 0.15}, {"w": "triệu", "t": 22.895, "d": 0.255}, {"w": "rưỡi", "t": 23.15, "d": 0.18}, {"w": "ấy", "t": 23.33, "d": 0.235}, {"w": "chính", "t": 23.565, "d": 0.07}, {"w": "là", "t": 23.635, "d": 0.33}, {"w": "cái", "t": 23.965, "d": 0.21}, {"w": "giá", "t": 24.175, "d": 0.19}, {"w": "của", "t": 24.365, "d": 0.08}, {"w": "việc", "t": 24.445, "d": 0.305}, {"w": "được", "t": 24.75, "d": 0.195}, {"w": "trả", "t": 24.945, "d": 0.1}, {"w": "chậm.", "t": 25.045, "d": 0.32}]}, {"text": "Không ai gọi nó là lãi.", "start": 26.76, "end": 28.28, "words": [{"w": "Không", "t": 26.85, "d": 0.125}, {"w": "ai", "t": 26.975, "d": 0.18}, {"w": "gọi", "t": 27.155, "d": 0.115}, {"w": "nó", "t": 27.27, "d": 0.235}, {"w": "là", "t": 27.505, "d": 0.24}, {"w": "lãi.", "t": 27.745, "d": 0.195}]}, {"text": "Nhưng về mặt con số, nó làm đúng việc của tiền lãi.", "start": 28.6, "end": 31.72, "words": [{"w": "Nhưng", "t": 28.695, "d": 0.185}, {"w": "về", "t": 28.88, "d": 0.3}, {"w": "mặt", "t": 29.18, "d": 0.06}, {"w": "con", "t": 29.24, "d": 0.255}, {"w": "số,", "t": 29.495, "d": 0.39}, {"w": "nó", "t": 29.885, "d": 0.06}, {"w": "làm", "t": 29.945, "d": 0.34}, {"w": "đúng", "t": 30.285, "d": 0.1}, {"w": "việc", "t": 30.385, "d": 0.33}, {"w": "của", "t": 30.715, "d": 0.065}, {"w": "tiền", "t": 30.78, "d": 0.165}, {"w": "lãi.", "t": 30.945, "d": 0.41}]}, {"text": "Bạn trả thêm tiền, để được trả muộn hơn.", "start": 32.04, "end": 34.6, "words": [{"w": "Bạn", "t": 32.125, "d": 0.19}, {"w": "trả", "t": 32.315, "d": 0.2}, {"w": "thêm", "t": 32.515, "d": 0.225}, {"w": "tiền,", "t": 32.74, "d": 0.415}, {"w": "để", "t": 33.155, "d": 0.06}, {"w": "được", "t": 33.215, "d": 0.34}, {"w": "trả", "t": 33.555, "d": 0.07}, {"w": "muộn", "t": 33.625, "d": 0.31}, {"w": "hơn.", "t": 33.935, "d": 0.3}]}, {"text": "Báo chí từng ghi lại những trường hợp như vậy.", "start": 35.6, "end": 37.92, "words": [{"w": "Báo", "