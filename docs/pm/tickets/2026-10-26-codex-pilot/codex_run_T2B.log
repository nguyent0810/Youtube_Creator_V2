motion/hf/assets/long\mim-dich-may\ch08\data.js:1:window.CASE = {"topic": "mim-dich-may", "ch": "ch08", "dur": 69.78, "seed": 11861, "accent": "#22d3ee", "look": {"name": "amber", "vars": {"--red": "#e39a2d", "--gold": "#f2cf86", "--paper": "#f2e7cf", "--bed1": "#1d150c", "--bed2": "#0c0905", "--serif": "'Literata'", "--sans": "'Montserrat'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 08", "t": "MỘT TRIỆU CUỐN SÁCH MỖI NGÀY"}, "acc": ["dịch", "máy", "vài", "năm", "lời", "hứa", "sổ", "pen", "cũi"], "lines": [{"text": "Tháng 4 năm 2006, Google ra mắt cách dịch thống kê. Cùng hướng thống kê với bài báo của IBM.", "start": 0.0, "end": 5.68, "words": [{"w": "Tháng", "t": 0.0, "d": 0.12}, {"w": "4", "t": 0.12, "d": 0.25}, {"w": "năm", "t": 0.37, "d": 0.28}, {"w": "2006,", "t": 0.65, "d": 1.16}, {"w": "Google", "t": 1.81, "d": 0.19}, {"w": "ra", "t": 2.0, "d": 0.285}, {"w": "mắt", "t": 2.285, "d": 0.13}, {"w": "cách", "t": 2.415, "d": 0.125}, {"w": "dịch", "t": 2.54, "d": 0.205}, {"w": "thống", "t": 2.745, "d": 0.18}, {"w": "kê.", "t": 2.925, "d": 0.425}, {"w": "Cùng", "t": 3.35, "d": 0.17}, {"w": "hướng", "t": 3.52, "d": 0.06}, {"w": "thống", "t": 3.58, "d": 0.21}, {"w": "kê", "t": 3.79, "d": 0.22}, {"w": "với", "t": 4.01, "d": 0.16}, {"w": "bài", "t": 4.17, "d": 0.205}, {"w": "báo", "t": 4.375, "d": 0.14}, {"w": "của", "t": 4.515, "d": 0.355}, {"w": "IBM.", "t": 4.87, "d": 0.605}]}, {"text": "Sáu năm sau, tháng 4 năm 2012, Google công bố một con số. Theo Google, họ đã dịch được giữa sáu mươi bốn thứ tiếng.", "start": 6.48, "end": 13.2, "words": [{"w": "Sáu", "t": 6.555, "d": 0.235}, {"w": "năm", "t": 6.79, "d": 0.205}, {"w": "sau,", "t": 6.995, "d": 0.275}, {"w": "tháng", "t": 7.27, "d": 0.11}, {"w": "4", "t": 7.38, "d": 0.25}, {"w": "năm", "t": 7.63, "d": 0.14}, {"w": "2012,", "t": 7.77, "d": 1.44}, {"w": "Google", "t": 9.21, "d": 0.21}, {"w": "công", "t": 9.42, "d": 0.195}, {"w": "bố", "t": 9.615, "d": 0.19}, {"w": "một", "t": 9.805, "d": 0.205}, {"w": "con", "t": 10.01, "d": 0.17}, {"w": "số.", "t": 10.18, "d": 0.18}, {"w": "Theo", "t": 10.36, "d": 0.25}, {"w": "Google,", "t": 10.61, "d": 0.42}, {"w": "họ", "t": 11.03, "d": 0.17}, {"w": "đã", "t": 11.2, "d": 0.06}, {"w": "dịch", "t": 11.26, "d": 0.28}, {"w": "được", "t": 11.54, "d": 0.155}, {"w": "giữa", "t": 11.695, "d": 0.205}, {"w": "sáu", "t": 11.9, "d": 0.31}, {"w": "mươi", "t": 12.21, "d": 0.135}, {"w": "bốn", "t": 12.345, "d": 0.155}, {"w": "thứ", "t": 12.5, "d": 0.175}, {"w": "tiếng.", "t": 12.675, "d": 0.355}]}, {"text": "Và mỗi ngày, lượng chữ họ dịch bằng khoảng một triệu cuốn sách. Đó là con số Google tự ước tính.", "start": 13.52, "end": 18.64, "words": [{"w": "Và", "t": 13.675, "d": 0.125}, {"w": "mỗi", "t": 13.8, "d": 0.38}, {"w": "ngày,", "t": 14.18, "d": 0.29}, {"w": "lượng", "t": 14.47, "d": 0.24}, {"w": "chữ", "t": 14.71, "d": 0.14}, {"w": "họ", "t": 14.85, "d": 0.285}, {"w": "dịch", "t": 15.135, "d": 0.21}, {"w": "bằng", "t": 15.345, "d": 0.145}, {"w": "khoảng", "t": 15.49, "d": 0.17}, {"w": "một", "t": 15.66, "d": 0.225}, {"w": "triệu", "t": 15.885, "d": 0.125}, {"w": "cuốn", "t": 16.01, "d": 0.375}, {"w": "sách.", "t": 16.385, "d": 0.175}, {"w": "Đó", "t": 16.56, "d": 0.3}, {"w": "là", "t": 16.86, "d": 0.115}, {"w": "con", "t": 16.975, "d": 0.215}, {"w": "số", "t": 17.19, "d": 0.2}, {"w": "Google", "t": 17.39, "d": 0.215}, {"w": "tự", "t": 17.605, "d": 0.34}, {"w": "ước", "t": 17.945, "d": 0.235}, {"w": "tính.", "t": 18.18, "d": 0.245}]}, {"text": "Mười năm sau ngày ra mắt, tháng 4 năm 2016, Google nói thêm một lần nữa.", "start": 19.64, "end": 24.2, "words": [{"w": "Mười", "t": 19.705, "d": 0.27}, {"w": "năm", "t": 19.975, "d": 0.06}, {"w": "sau", "t": 20.035, "d": 0.27}, {"w": "ngày", "t": 20.305, "d": 0.115}, {"w": "ra", "t": 20.42, "d": 0.305}, {"w": "mắt,", "t": 20.725, "d": 0.15}, {"w": "tháng", "t": 20.875, "d": 0.325}, {"w": "4", "t": 21.2, "d": 0.085}, {"w": "năm", "t": 21.285, "d": 0.33}, {"w": "2016,", "t": 21.615, "d": 1.12}, {"w": "Google", "t": 22.735, "d": 0.325}, {"w": "nói", "t": 23.06, "d": 0.06}, {"w": "thêm", "t": 23.12, "d": 0.18}, {"w": "một", "t": 23.3, "d": 0.335}, {"w": "lần", "t": 23.635, "d": 0.125}, {"w": "nữa.", "t": 23.76, "d": 0.29}]}, {"text": "Hơn năm trăm triệu người dùng. Hơn một trăm tỷ chữ mỗi ngày. Từ hai thứ tiếng lên một trăm lẻ ba thứ tiếng.", "start": 24.52, "end": 29.88, "words": [{"w": "Hơn", "t": 24.52, "d": 0.285}, {"w": "năm", "t": 24.805, "d": 0.16}, {"w": "trăm", "t": 24.965, "d": 0.22}, {"w": "triệu", "t": 25.185, "d": 0.125}, {"w": "người", "t": 25.31, "d": 0.295}, {"w": "dùng.", "t": 25.605, "d": 0.18}, {"w": "Hơn", "t": 25.785, "d": 0.175}, {"w": "một", "t": 25.96, "d": 0.37}, {"w": "trăm", "t": 26.33, "d": 0.2}, {"w": "tỷ", "t": 26.53, "d": 0.15}, {"w": "chữ", "t": 26.68, "d": 0.17}, {"w": "mỗi", "t": 26.85, "d": 0.165}, {"w": "ngày.", "t": 27.015, "d": 0.39}, {"w": "Từ", "t": 27.405, "d": 0.205}, {"w": "hai", "t": 27.61, "d": 0.07}, {"w": "thứ", "t": 27.68, "d": 0.345}, {"w": "tiếng", "t": 28.025, "d": 0.165}, {"w": "lên", "t": 28.19, "d": 0.145}, {"w": "một", "t": 28.335, "d": 0.19}, {"w": "trăm", "t": 28.525, "d": 0.22}, {"w": "lẻ", "t": 28.745, "d": 0.135}, {"w": "ba", "t": 28.88, "d": 0.22}, {"w": "thứ", "t": 29.1, "d": 0.245}, {"w": "tiếng.", "t": 29.345, "d": 0.35}]}, {"text": "Một lời nhắc: toàn bộ những con số này là Google tự báo cáo.", "start": 30.88, "end": 33.92, "words": [{"w": "Một", "t": 30.88, "d": 0.21}, {"w": "lời", "t": 31.09, "d": 0.245}, {"w": "nhắc:", "t": 31.335, "d": 0.185}, {"w": "toàn", "t": 31.52, "d": 0.14}, {"w": "bộ", "t": 31.66, "d": 0.33}, {"w": "những", "t": 31.99, "d": 0.145}, {"w": "con", "t": 32.135, "d": 0.21}, {"w": "số", "t": 32.345, "d": 0.135}, {"w": "này", "t": 32.48, "d": 0.29}, {"w": "là", "t": 32.77, "d": 0.055}, {"w": "Google", "t": 32.825, "d": 0.325}, {"w": "tự", "t": 33.15, "d": 0.13}, {"w": "báo", "t": 33.28, "d": 0.205}, {"w": "cáo.", "t": 33.485, "d": 0.265}]}, {"text": "Không ai bên ngoài kiểm lại được.", "start": 34.24, "end": 35.52, "words": [{"w": "Không", "t": 34.24, "d": 0.075}, {"w": "ai", "t": 34.315, "d": 0.27}, {"w": "bên", "t": 34.585, "d": 0.08}, {"w": "ngoài", "t": 34.665, "d": 0.2}, {"w": "kiểm", "t": 34.865, "d": 0.15}, {"w": "lại", "t": 35.015, "d": 0.145}, {"w": "được.", "t": 35.16, "d": 0.17}]}, {"text": "Bạn nhớ phép tính nhẩm của Weaver năm 1947 chứ? Bốn triệu mục, không đáng sợ.", "start": 36.52, "end": 41.32, "words": [{"w": "Bạn", "t": 36.565, "d": 0.135}, {"w": "nhớ", "t": 36.7, "d": 0.33}, {"w": "phép", "t": 37.03, "d": 0.17}, {"w": "tính", "t": 37.2, "d": 0.22}, {"w": "nhẩm", "t": 37.42, "d": 0.135}, {"w": "của", "t": 37.555, "d": 0.19}, {"w": "Weaver", "t": 37.745, "d": 0.185}, {"w": "năm", "t": 37.93, "d": 0.095}, {"w": "1947", "t": 38.025, "d": 1.505}, {"w": "chứ?", "t": 39.53, "d": 0.18}, {"w": "Bốn", "t": 39.71, "d": 0.26}, {"w": "triệu", "t": 39.97, "d": 0.15}, {"w": "mục,", "t": 40.12, "d": 0.405}, {"w": "không", "t": 40.525, "d": 0.06}, {"w": "đáng", "t": 40.585, "d": 0.35}, {"w": "sợ.", "t": 40.935, "d": 0.245}]}, {"text": "Một triệu cuốn sách mỗi ngày đâu có nằm trong phép tính ấy.", "start": 41.64, "end": 45.24, "words": [{"w": "Một", "t": 41.68, "d": 0.135}, {"w": "triệu", "t": 41.815, "d": 0.2}, {"w": "cuốn", "t": 42.015, "d": 0.225}, {"w": "sách", "t": 42.24, "d": 0.16}, {"w": "mỗi", "t": 42.4, "d": 0.305}, {"w": "ngày", "t": 42.705, "d": 0.215}, {"w": "đâu", "t": 42.92, "d": 0.11}, {"w": "có", "t": 43.03, "d": 0.2}, {"w": "nằm", "t": 43.23, "d": 0.24}, {"w": "trong", "t": 43.47, "d": 0.225}, {"w": "phép", "t": 43.695, "d": 0.14}, {"w": "tính", "t": 43.835, "d": 0.155}, {"w": "ấy.", "t": 43.99, "d": 0.325}]}, {"text": "Còn cách dịch thì sao? Theo Google, dịch kiểu cũ cắt câu thành từng từ, từng cụm, rồi dịch chúng gần như riêng rẽ.", "start": 46.24, "end": 52.32, "words": [{"w": "Còn", "t": 46.295, "d": 0.235}, {"w": "cách", "t": 46.53, "d": 0.155}, {"w": "dịch", "t": 46.685, "d": 0.16}, {"w": "thì", "t": 46.845, "d": 0.405}, {"w": "sao?", "t": 47.25, "d": 0.275}, {"w": "Theo", "t": 47.525, "d": 0.1}, {"w": "Google,", "t": 47.625, "d": 0.345}, {"w": "dịch", "t": 47.97, "d": 0.41}, {"w": "kiểu", "t": 48.38, "d": 0.06}, {"w": "cũ", "t": 48.44, "d": 0.245}, {"w": "cắt", "t": 48.685, "d": 0.2}, {"w": "câu", "t": 48.885, "d": 0.35}, {"w": "thành", "t": 49.235, "d": 0.145}, {"w": "từng", "t": 49.38, "d": 0.205}, {"w": "từ,", "t": 49.585, "d": 0.44}, {"w": "từng", "t": 50.025, "d": 0.15}, {"w": "cụm,", "t": 50.175, "d": 0.415}, {"w": "rồi", "t": 50.59, "d": 0.18}, {"w": "dịch", "t": 50.77, "d": 0.085}, {"w": "chúng", "t": 50.855, "d": 0.325}, {"w": "gần", "t": 51.18, "d": 0.14}, {"w": "như", "t": 51.32, "d": 0.225}, {"w": "riêng", "t": 51.545, "d": 0.265}, {"w": "rẽ.", "t": 51.81, "d": 0.335}]}, {"text": "Ở chỗ khác, một ý tưởng khác đang chín.", "start": 52.64, "end": 54.8, "words": [{"w": "Ở", "t": 52.64, "d": 0.14}, {"w": "chỗ", "t": 52.78, "d": 0.165}, {"w": "khác,", "t": 52.945, "d": 0.465}, {"w": "một", "t": 53.41, "d": 0.085}, {"w": "ý", "t": 53.495, "d": 0.22}, {"w": "tưởng", "t": 53.715, "d": 0.155}, {"w": "khác", "t": 53.87, "d": 0.195}, {"w": "đang", "t": 54.065, "d": 0.32}, {"w": "chín.", "t": 54.385, "d": 0.275}]}, {"text": "Mình ghi vào sổ một dòng nữa: năm 2012, Google. Máy dịch cho cả thế giới.", "start": 55.8, "end": 61.16, "words": [{"w": "Mình", "t": 55.835, "d": 0.185}, {"w": "ghi", "t": 56.02, "d": 0.18}, {"w": "vào", "t": 56.2, "d": 0.205}, {"w": "sổ", "t": 56.405, "d": 0.265}, {"w": "một", "t": 56.67, "d": 0.14}, {"w": "dòng", "t": 56.81, "d": 0.395}, {"w": "nữa:", "t": 57.205, "d": 0.165}, {"w": "năm", "t": 57.37, "d": 0.36}, {"w": "2012,", "t": 57.73, "d": 1.355}, {"w": "Google.", "t": 59.085, "d": 0.36}, {"w": "Máy", "t": 59.445, "d": 0.135}, {"w": "dịch", "t": 59.58, "d": 0.34}, {"w": "cho", "t": 59.92, "d": 0.175}, {"w": "cả", "t": 60.095, "d": 0.22}, {"w": "thế", "t": 60.315, "d": 0.145}, {"w": "giới.", "t": 60.46, "d": 0.4}]}, {"text": "Lần này không có hạn. Chỉ có một con số.", "start": 61.48, "end": 63.96, "words": [{"w": "Lần", "t": 61.64, "d": 0.1}, {"w": "này", "t": 61.74, "d": 0.24}, {"w": "không", "t": 61.98, "d": 0.175}, {"w": "có", "t": 62.155, "d": 0.315}, {"w": "hạn.", "t": 62.47, "d": 0.3}, {"w": "Chỉ", "t": 62.77, "d": 0.06}, {"w": "có", "t": 62.83, "d": 0.175}, {"w": "một", "t": 63.005, "d": 0.275}, {"w": "con", "t": 63.28, "d": 0.22}, {"w": "số.", "t": 63.5, "d": 0.25}]}, {"text": "Và một câu hỏi: dịch kiểu cắt cụm có chạm tới cái cũi của Bar-Hillel được không?", "start": 64.28, "end": 68.28, "words": [{"w": "Và", "t": 64.28, "d": 0.165}, {"w": "một", "t": 64.445, "d": 0.14}, {"w": "câu", "t": 64.585, "d": 0.375}, {"w": "hỏi:", "t": 64.96, "d": 0.195}, {"w": "dịch", "t": 65.155, "d": 0.325}, {"w": "kiểu", "t": 65.48, "d": 0.06}, {"w": "cắt", "t": 65.54, "d": 0.335}, {"w": "cụm", "t": 65.875, "d": 0.06}, {"w": "có", "t": 65.935, "d": 0.285}, {"w": "chạm", "t": 66.22, "d": 0.205}, {"w": "tới", "t": 66.425, "d": 0.24}, {"w": "cái", "t": 66.665, "d": 0.125}, {"w": "cũi", "t": 66.79, "d": 0.145}, {"w": "của", "t": 66.935, "d": 0.215}, {"w": "Bar-Hillel", "t": 67.15, "d": 0.345}, {"w": "được", "t": 67.495, "d": 0.305}, {"w": "không?", "t": 67.8, "d": 0.305}]}], "imgs": {"ibm701": {"src": "assets/long/mim-dich-may/img/ibm701.jpg", "w": 960, "h": 1280, "lic": "CC BY 2.0", "by": "Dan", "pd": false}, "ibm701f": {"src": "assets/long/mim-dich-may/img/ibm701f.jpg", "w": 1920, "h": 1521, "lic": "Public domain", "by": "NASA", "pd": true}, "healy": {"src": "assets/long/mim-dich-may/img/healy.jpg", "w": 1811, "h": 2400, "lic": "Public domain", "by": "JStephanMease", "pd": true}, "nuremberg": {"src": "assets/long/mim-dich-may/img/nuremberg.jpg", "w": 1920, "h": 1556, "lic": "Public domain", "by": "Unknown authorUnknown author or not provided", "pd": true}, "weaver": {"src": "assets/long/mim-dich-may/img/weaver.jpg", "w": 1920, "h": 1536, "lic": "Public domain", "by": "Donald Cooksey", "pd": tr