motion/hf/assets/long\mim-ai-jobs\ch08\data.js:1:window.CASE = {"topic": "mim-ai-jobs", "ch": "ch08", "dur": 98.74, "seed": 10407, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 08", "t": "NĂM 2030 CỦA KEYNES"}, "acc": ["ai", "luddite", "keynes", "oxford", "atm", "eniac", "fortran", "hinton", "chatgpt", "nasa", "naca", "2030"], "lines": [{"text": "Nỗi sợ máy móc không chỉ sống trong các bản báo cáo.", "start": 0.0, "end": 2.72, "words": [{"w": "Nỗi", "t": 0.08, "d": 0.27}, {"w": "sợ", "t": 0.35, "d": 0.19}, {"w": "máy", "t": 0.54, "d": 0.17}, {"w": "móc", "t": 0.71, "d": 0.21}, {"w": "không", "t": 0.92, "d": 0.07}, {"w": "chỉ", "t": 0.99, "d": 0.215}, {"w": "sống", "t": 1.205, "d": 0.195}, {"w": "trong", "t": 1.4, "d": 0.185}, {"w": "các", "t": 1.585, "d": 0.14}, {"w": "bản", "t": 1.725, "d": 0.31}, {"w": "báo", "t": 2.035, "d": 0.19}, {"w": "cáo.", "t": 2.225, "d": 0.26}]}, {"text": "Năm 1936, trong phim Modern Times, Charlie Chaplin bị cuốn vào trong lòng cỗ máy.", "start": 3.52, "end": 9.2, "words": [{"w": "Năm", "t": 3.62, "d": 0.24}, {"w": "1936,", "t": 3.86, "d": 1.685}, {"w": "trong", "t": 5.545, "d": 0.425}, {"w": "phim", "t": 5.97, "d": 0.085}, {"w": "Modern", "t": 6.055, "d": 0.18}, {"w": "Times,", "t": 6.235, "d": 0.48}, {"w": "Charlie", "t": 6.715, "d": 0.225}, {"w": "Chaplin", "t": 6.94, "d": 0.28}, {"w": "bị", "t": 7.22, "d": 0.155}, {"w": "cuốn", "t": 7.375, "d": 0.285}, {"w": "vào", "t": 7.66, "d": 0.2}, {"w": "trong", "t": 7.86, "d": 0.305}, {"w": "lòng", "t": 8.165, "d": 0.13}, {"w": "cỗ", "t": 8.295, "d": 0.32}, {"w": "máy.", "t": 8.615, "d": 0.355}]}, {"text": "Năm 1962, phim hoạt hình Jetsons tưởng tượng một ông bố tương lai đi làm chỉ để bấm nút.", "start": 9.52, "end": 15.36, "words": [{"w": "Năm", "t": 9.63, "d": 0.235}, {"w": "1962,", "t": 9.865, "d": 1.495}, {"w": "phim", "t": 11.36, "d": 0.315}, {"w": "hoạt", "t": 11.675, "d": 0.26}, {"w": "hình", "t": 11.935, "d": 0.135}, {"w": "Jetsons", "t": 12.07, "d": 0.325}, {"w": "tưởng", "t": 12.395, "d": 0.21}, {"w": "tượng", "t": 12.605, "d": 0.135}, {"w": "một", "t": 12.74, "d": 0.23}, {"w": "ông", "t": 12.97, "d": 0.18}, {"w": "bố", "t": 13.15, "d": 0.305}, {"w": "tương", "t": 13.455, "d": 0.11}, {"w": "lai", "t": 13.565, "d": 0.315}, {"w": "đi", "t": 13.88, "d": 0.065}, {"w": "làm", "t": 13.945, "d": 0.36}, {"w": "chỉ", "t": 14.305, "d": 0.21}, {"w": "để", "t": 14.515, "d": 0.065}, {"w": "bấm", "t": 14.58, "d": 0.275}, {"w": "nút.", "t": 14.855, "d": 0.33}]}, {"text": "Còn năm 2016, Hollywood kể lại câu chuyện của những \"máy tính\" ở Langley, trong phim Hidden Figures.", "start": 15.68, "end": 21.76, "words": [{"w": "Còn", "t": 15.785, "d": 0.33}, {"w": "năm", "t": 16.115, "d": 0.205}, {"w": "2016,", "t": 16.32, "d": 1.555}, {"w": "Hollywood", "t": 17.875, "d": 0.055}, {"w": "kể", "t": 17.93, "d": 0.305}, {"w": "lại", "t": 18.235, "d": 0.17}, {"w": "câu", "t": 18.405, "d": 0.31}, {"w": "chuyện", "t": 18.715, "d": 0.25}, {"w": "của", "t": 18.965, "d": 0.21}, {"w": "những", "t": 19.175, "d": 0.23}, {"w": "\"máy", "t": 19.405, "d": 0.17}, {"w": "tính\"", "t": 19.575, "d": 0.385}, {"w": "ở", "t": 19.96, "d": 0.235}, {"w": "Langley,", "t": 20.195, "d": 0.275}, {"w": "trong", "t": 20.47, "d": 0.325}, {"w": "phim", "t": 20.795, "d": 0.08}, {"w": "Hidden", "t": 20.875, "d": 0.285}, {"w": "Figures.", "t": 21.16, "d": 0.375}]}, {"text": "Quay lại với Keynes. Ông hình dung: trăm năm sau, tuần làm mười lăm giờ có thể là đủ.", "start": 22.76, "end": 27.0, "words": [{"w": "Quay", "t": 22.815, "d": 0.265}, {"w": "lại", "t": 23.08, "d": 0.105}, {"w": "với", "t": 23.185, "d": 0.16}, {"w": "Keynes.", "t": 23.345, "d": 0.405}, {"w": "Ông", "t": 23.75, "d": 0.06}, {"w": "hình", "t": 23.81, "d": 0.305}, {"w": "dung:", "t": 24.115, "d": 0.305}, {"w": "trăm", "t": 24.42, "d": 0.085}, {"w": "năm", "t": 24.505, "d": 0.29}, {"w": "sau,", "t": 24.795, "d": 0.135}, {"w": "tuần", "t": 24.93, "d": 0.35}, {"w": "làm", "t": 25.28, "d": 0.13}, {"w": "mười", "t": 25.41, "d": 0.195}, {"w": "lăm", "t": 25.605, "d": 0.165}, {"w": "giờ", "t": 25.77, "d": 0.25}, {"w": "có", "t": 26.02, "d": 0.085}, {"w": "thể", "t": 26.105, "d": 0.225}, {"w": "là", "t": 26.33, "d": 0.1}, {"w": "đủ.", "t": 26.43, "d": 0.375}]}, {"text": "Mốc trăm năm ấy là năm 2030. Giờ chỉ còn bốn năm, và có lẽ bạn cũng như mình, chưa thấy tuần làm mười lăm giờ đâu cả.", "start": 27.32, "end": 34.44, "words": [{"w": "Mốc", "t": 27.405, "d": 0.155}, {"w": "trăm", "t": 27.56, "d": 0.305}, {"w": "năm", "t": 27.865, "d": 0.2}, {"w": "ấy", "t": 28.065, "d": 0.165}, {"w": "là", "t": 28.23, "d": 0.175}, {"w": "năm", "t": 28.405, "d": 0.135}, {"w": "2030.", "t": 28.54, "d": 1.26}, {"w": "Giờ", "t": 29.8, "d": 0.315}, {"w": "chỉ", "t": 30.115, "d": 0.145}, {"w": "còn", "t": 30.26, "d": 0.165}, {"w": "bốn", "t": 30.425, "d": 0.105}, {"w": "năm,", "t": 30.53, "d": 0.475}, {"w": "và", "t": 31.005, "d": 0.075}, {"w": "có", "t": 31.08, "d": 0.275}, {"w": "lẽ", "t": 31.355, "d": 0.23}, {"w": "bạn", "t": 31.585, "d": 0.145}, {"w": "cũng", "t": 31.73, "d": 0.09}, {"w": "như", "t": 31.82, "d": 0.29}, {"w": "mình,", "t": 32.11, "d": 0.335}, {"w": "chưa", "t": 32.445, "d": 0.215}, {"w": "thấy", "t": 32.66, "d": 0.06}, {"w": "tuần", "t": 32.72, "d": 0.205}, {"w": "làm", "t": 32.925, "d": 0.18}, {"w": "mười", "t": 33.105, "d": 0.165}, {"w": "lăm", "t": 33.27, "d": 0.265}, {"w": "giờ", "t": 33.535, "d": 0.265}, {"w": "đâu", "t": 33.8, "d": 0.2}, {"w": "cả.", "t": 34.0, "d": 0.25}]}, {"text": "Uỷ ban năm 1966 nói đúng một nửa: công nghệ xoá công việc, chứ không xoá lao động.", "start": 34.76, "end": 39.64, "words": [{"w": "Uỷ", "t": 34.86, "d": 0.125}, {"w": "ban", "t": 34.985, "d": 0.31}, {"w": "năm", "t": 35.295, "d": 0.06}, {"w": "1966", "t": 35.355, "d": 1.205}, {"w": "nói", "t": 36.56, "d": 0.33}, {"w": "đúng", "t": 36.89, "d": 0.065}, {"w": "một", "t": 36.955, "d": 0.295}, {"w": "nửa:", "t": 37.25, "d": 0.23}, {"w": "công", "t": 37.48, "d": 0.135}, {"w": "nghệ", "t": 37.615, "d": 0.275}, {"w": "xoá", "t": 37.89, "d": 0.15}, {"w": "công", "t": 38.04, "d": 0.17}, {"w": "việc,", "t": 38.21, "d": 0.315}, {"w": "chứ", "t": 38.525, "d": 0.085}, {"w": "không", "t": 38.61, "d": 0.195}, {"w": "xoá", "t": 38.805, "d": 0.195}, {"w": "lao", "t": 39.0, "d": 0.085}, {"w": "động.", "t": 39.085, "d": 0.36}]}, {"text": "Nửa còn lại là câu chuyện của cô tổng đài: người đứng sai chỗ, vào sai lúc, vẫn phải trả giá.", "start": 39.96, "end": 44.6, "words": [{"w": "Nửa", "t": 40.06, "d": 0.16}, {"w": "còn", "t": 40.22, "d": 0.28}, {"w": "lại", "t": 40.5, "d": 0.135}, {"w": "là", "t": 40.635, "d": 0.14}, {"w": "câu", "t": 40.775, "d": 0.165}, {"w": "chuyện", "t": 40.94, "d": 0.145}, {"w": "của", "t": 41.085, "d": 0.325}, {"w": "cô", "t": 41.41, "d": 0.205}, {"w": "tổng", "t": 41.615, "d": 0.185}, {"w": "đài:", "t": 41.8, "d": 0.135}, {"w": "người", "t": 41.935, "d": 0.345}, {"w": "đứng", "t": 42.28, "d": 0.08}, {"w": "sai", "t": 42.36, "d": 0.19}, {"w": "chỗ,", "t": 42.55, "d": 0.25}, {"w": "vào", "t": 42.8, "d": 0.225}, {"w": "sai", "t": 43.025, "d": 0.29}, {"w": "lúc,", "t": 43.315, "d": 0.27}, {"w": "vẫn", "t": 43.585, "d": 0.06}, {"w": "phải", "t": 43.645, "d": 0.31}, {"w": "trả", "t": 43.955, "d": 0.18}, {"w": "giá.", "t": 44.135, "d": 0.25}]}, {"text": "Những tấm thẻ đục lỗ của khung cửi năm 1804 đã đi một vòng rất dài: từ sợi vải, tới con số, tới ô chat trên điện thoại của bạn.", "start": 45.6, "end": 53.04, "words": [{"w": "Những", "t": 45.695, "d": 0.165}, {"w": "tấm", "t": 45.86, "d": 0.16}, {"w": "thẻ", "t": 46.02, "d": 0.3}, {"w": "đục", "t": 46.32, "d": 0.215}, {"w": "lỗ", "t": 46.535, "d": 0.19}, {"w": "của", "t": 46.725, "d": 0.16}, {"w": "khung", "t": 46.885, "d": 0.175}, {"w": "cửi", "t": 47.06, "d": 0.22}, {"w": "năm", "t": 47.28, "d": 0.18}, {"w": "1804", "t": 47.46, "d": 1.17}, {"w": "đã", "t": 48.63, "d": 0.06}, {"w": "đi", "t": 48.69, "d": 0.295}, {"w": "một", "t": 48.985, "d": 0.07}, {"w": "vòng", "t": 49.055, "d": 0.34}, {"w": "rất", "t": 49.395, "d": 0.19}, {"w": "dài:", "t": 49.585, "d": 0.135}, {"w": "từ", "t": 49.72, "d": 0.25}, {"w": "sợi", "t": 49.97, "d": 0.17}, {"w": "vải,", "t": 50.14, "d": 0.415}, {"w": "tới", "t": 50.555, "d": 0.16}, {"w": "con", "t": 50.715, "d": 0.16}, {"w": "số,", "t": 50.875, "d": 0.385}, {"w": "tới", "t": 51.26, "d": 0.16}, {"w": "ô", "t": 51.42, "d": 0.06}, {"w": "chat", "t": 51.48, "d": 0.29}, {"w": "trên", "t": 51.77, "d": 0.25}, {"w": "điện", "t": 52.02, "d": 0.085}, {"w": "thoại", "t": 52.105, "d": 0.24}, {"w": "của", "t": 52.345, "d": 0.245}, {"w": "bạn.", "t": 52.59, "d": 0.23}]}, {"text": "Và mỗi lần, lại có người nói: lần này khác.", "start": 53.36, "end": 56.0, "words": [{"w": "Và", "t": 53.44, "d": 0.28}, {"w": "mỗi", "t": 53.72, "d": 0.195}, {"w": "lần,", "t": 53.915, "d": 0.19}, {"w": "lại", "t": 54.105, "d": 0.215}, {"w": "có", "t": 54.32, "d": 0.3}, {"w": "người", "t": 54.62, "d": 0.205}, {"w": "nói:", "t": 54.825, "d": 0.255}, {"w": "lần", "t": 55.08, "d": 0.085}, {"w": "này", "t": 55.165, "d": 0.37}, {"w": "khác.", "t": 55.535, "d": 0.235}]}, {"text": "Có thể họ đúng. Có thể không.", "start": 56.32, "end": 58.16, "words": [{"w": "Có", "t": 56.38, "d": 0.13}, {"w": "thể", "t": 56.51, "d": 0.33}, {"w": "họ", "t": 56.84, "d": 0.06}, {"w": "đúng.", "t": 56.9, "d": 0.445}, {"w": "Có", "t": 57.345, "d": 0.165}, {"w": "thể", "t": 57.51, "d": 0.2}, {"w": "không.", "t": 57.71, "d": 0.265}]}, {"text": "Nhưng lần này, dữ liệu ban đầu gợi ý: AI chạm tới trước những người trẻ mới vào nghề, ở những công việc dựa vào kiến thức đã được viết thành văn bản.", "start": 58.48, "end": 65.6, "words": [{"w": "Nhưng", "t": 58.55, "d": 0.26}, {"w": "lần", "t": 58.81, "d": 0.19}, {"w": "này,", "t": 59.0, "d": 0.17}, {"w": "dữ", "t": 59.17, "d": 0.175}, {"w": "liệu", "t": 59.345, "d": 0.31}, {"w": "ban", "t": 59.655, "d": 0.12}, {"w": "đầu", "t