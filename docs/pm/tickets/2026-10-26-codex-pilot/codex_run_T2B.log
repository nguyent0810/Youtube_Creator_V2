# Tháº» chÆ°Æ¡ng (cáº£nh 0) luÃ´n báº¯t Ä‘áº§u á»Ÿ 0; cáº£nh 1 neo vÃ o cÃ¢u 0 / chá»¯ Ä‘áº§u cÃ¢u 0 -> cÅ©ng á»Ÿ ~0 -> plan() bÃ¡o "cáº£nh 0 (chapter) quÃ¡ ngáº¯n"
# giá»¯a lÃºc `html` (sau TTS, sau khi táº£i áº£nh, cÃ³ khi trong chuá»—i render). Lint TÄ¨NH (khÃ´ng cáº§n timing) cháº¡y trÆ°á»›c TTS vÃ  trÆ°á»›c html,
# bÃ¡o Má»ŒI chÆ°Æ¡ng cÃ¹ng lÃºc, nÃªu Ä‘Ãºng cáº£nh cáº§n sá»­a.
EARLY_WORDS = 2       # chá»¯ thá»© 1â€“2 cá»§a cÃ¢u 0 (â‰ˆ < 0,6 s) coi lÃ  trÃ¹ng má»‘c tháº» chÆ°Æ¡ng


def chapter_collisions(chs) -> list[str]:
    out = []
    for name, ch in chs:
        scenes, lines = ch.get("scenes") or [], ch.get("lines") or []
        if len(scenes) < 2 or scenes[0].get("type") != "chapter":
            continue
        at, bad = scenes[1].get("at"), False
        if isinstance(at, bool) or at is None:
            bad = at is None
        elif isinstance(at, int):
            bad = at == 0
        elif isinstance(at, float):
            bad = at < 0.6
        elif isinstance(at, list) and at and at[0] == 0:
            off = at[3] if len(at) > 3 else 0.0
            if len(at) < 2 or at[1] is None:
                bad = off < 0.6
            elif lines:
                ws = [norm(w) for w in line_text(lines[0]).split()]
                hits = [k for k, w in enumerate(ws) if w == norm(str(at[1]))]
                n = at[2] if len(at) > 2 else 0
                bad = n < len(hits) and hits[n] < EARLY_WORDS and off < 0.6
        if bad:
            out.append(f"{name} cáº£nh 1 ({scenes[1].get('type')}) neo at={at!r} trÃ¹ng má»‘c 0 vá»›i tháº» chÆ°Æ¡ng (cáº£nh 0) â€” neo vÃ o cÃ¢u 1, "
                       f"hoáº·c má»™t chá»¯ tá»« thá»© {EARLY_WORDS + 1} trá»Ÿ Ä‘i cá»§a cÃ¢u 0")
    return out


def scene_gate(chs) -> None:
    bad = chapter_collisions(chs)
    if bad:
        raise SystemExit("lint cáº£nh (sá»­a gen_scenes.py rá»“i cháº¡y láº¡i):\n  " + "\n  ".join(bad))


def integrity_gate(chs, allow_repeat: bool = False) -> None:
    """Cá»•ng toÃ n váº¹n TRÆ¯á»šC TTS (retro 2 má»¥c 16) â€” cÃ¹ng luáº­t vá»›i motion/long/script_lines.py, cho cáº£ chNN.json sá»­a tay."""
    import script_lines
    bad = script_lines.gate([{"name": n, "lines": c["lines"]} for n, c in chs], allow_repeat)
    if bad:
        raise SystemExit("integrity: lá»i Ä‘á»c chÆ°a qua cá»•ng, chÆ°a Ä‘á»c cÃ¢u nÃ o:\n  " + "\n  ".join(bad)
                         + "\n(cÃ¢u láº·p cá»‘ Ã½: thÃªm --allow-repeat-line)")


