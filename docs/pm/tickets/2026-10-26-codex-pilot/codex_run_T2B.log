22}, {"w": "vậy.", "t": 77.78, "d": 0.29}]}, {"text": "Luật bảo hiểm tiền gửi mới của Việt Nam cũng có một cánh cửa tương tự.", "start": 79.44, "end": 83.12, "words": [{"w": "Luật", "t": 79.54, "d": 0.11}, {"w": "bảo", "t": 79.65, "d": 0.23}, {"w": "hiểm", "t": 79.88, "d": 0.205}, {"w": "tiền", "t": 80.085, "d": 0.205}, {"w": "gửi", "t": 80.29, "d": 0.165}, {"w": "mới", "t": 80.455, "d": 0.275}, {"w": "của", "t": 80.73, "d": 0.15}, {"w": "Việt", "t": 80.88, "d": 0.125}, {"w": "Nam", "t": 81.005, "d": 0.365}, {"w": "cũng", "t": 81.37, "d": 0.105}, {"w": "có", "t": 81.475, "d": 0.22}, {"w": "một", "t": 81.695, "d": 0.26}, {"w": "cánh", "t": 81.955, "d": 0.06}, {"w": "cửa", "t": 82.015, "d": 0.17}, {"w": "tương", "t": 82.185, "d": 0.26}, {"w": "tự.", "t": 82.445, "d": 0.325}]}, {"text": "Trong trường hợp đặc biệt, Thống đốc có thể quyết định trả cao hơn hạn mức, tối đa bằng toàn bộ tiền gửi được bảo hiểm của người gửi ở nơi ấy.", "start": 83.44, "end": 90.64, "words": [{"w": "Trong", "t": 83.545, "d": 0.135}, {"w": "trường", "t": 83.68, "d": 0.32}, {"w": "hợp", "t": 84.0, "d": 0.19}, {"w": "đặc", "t": 84.19, "d": 0.235}, {"w": "biệt,", "t": 84.425, "d": 0.17}, {"w": "Thống", "t": 84.595, "d": 0.35}, {"w": "đốc", "t": 84.945, "d": 0.065}, {"w": "có", "t": 85.01, "d": 0.16}, {"w": "thể", "t": 85.17, "d": 0.195}, {"w": "quyết", "t": 85.365, "d": 0.34}, {"w": "định", "t": 85.705, "d": 0.235}, {"w": "trả", "t": 85.94, "d": 0.2}, {"w": "cao", "t": 86.14, "d": 0.2}, {"w": "hơn", "t": 86.34, "d": 0.14}, {"w": "hạn", "t": 86.48, "d": 0.26}, {"w": "mức,", "t": 86.74, "d": 0.315}, {"w": "tối", "t": 87.055, "d": 0.195}, {"w": "đa", "t": 87.25, "d": 0.185}, {"w": "bằng", "t": 87.435, "d": 0.22}, {"w": "toàn", "t": 87.655, "d": 0.06}, {"w": "bộ", "t": 87.715, "d": 0.34}, {"w": "tiền", "t": 88.055, "d": 0.06}, {"w": "gửi", "t": 88.115, "d": 0.2}, {"w": "được", "t": 88.315, "d": 0.335}, {"w": "bảo", "t": 88.65, "d": 0.06}, {"w": "hiểm", "t": 88.71, "d": 0.185}, {"w": "của", "t": 88.895, "d": 0.23}, {"w": "người", "t": 89.125, "d": 0.15}, {"w": "gửi", "t": 89.275, "d": 0.255}, {"w": "ở", "t": 89.53, "d": 0.2}, {"w": "nơi", "t": 89.73, "d": 0.32}, {"w": "ấy.", "t": 90.05, "d": 0.235}]}, {"text": "Nhưng đó là quyết định cho từng trường hợp cụ thể.", "start": 90.96, "end": 93.44, "words": [{"w": "Nhưng", "t": 91.02, "d": 0.215}, {"w": "đó", "t": 91.235, "d": 0.19}, {"w": "là", "t": 91.425, "d": 0.215}, {"w": "quyết", "t": 91.64, "d": 0.115}, {"w": "định", "t": 91.755, "d": 0.235}, {"w": "cho", "t": 91.99, "d": 0.18}, {"w": "từng", "t": 92.17, "d": 0.19}, {"w": "trường", "t": 92.36, "d": 0.06}, {"w": "hợp", "t": 92.42, "d": 0.305}, {"w": "cụ", "t": 92.725, "d": 0.185}, {"w": "thể.", "t": 92.91, "d": 0.215}]}, {"text": "Không phải một lời hứa có sẵn cho mọi lần.", "start": 93.76, "end": 96.16, "words": [{"w": "Không", "t": 93.85, "d": 0.15}, {"w": "phải", "t": 94.0, "d": 0.29}, {"w": "một", "t": 94.29, "d": 0.06}, {"w": "lời", "t": 94.35, "d": 0.175}, {"w": "hứa", "t": 94.525, "d": 0.21}, {"w": "có", "t": 94.735, "d": 0.235}, {"w": "sẵn", "t": 94.97, "d": 0.23}, {"w": "cho", "t": 95.2, "d": 0.06}, {"w": "mọi", "t": 95.26, "d": 0.245}, {"w": "lần.", "t": 95.505, "d": 0.275}]}, {"text": "Nên đây là cách mình đọc câu chuyện ở California.", "start": 97.16, "end": 100.04, "words": [{"w": "Nên", "t": 97.265, "d": 0.165}, {"w": "đây", "t": 97.43, "d": 0.355}, {"w": "là", "t": 97.785, "d": 0.16}, {"w": "cách", "t": 97.945, "d": 0.33}, {"w": "mình", "t": 98.275, "d": 0.085}, {"w": "đọc", "t": 98.36, "d": 0.375}, {"w": "câu", "t": 98.735, "d": 0.22}, {"w": "chuyện", "t": 98.955, "d": 0.235}, {"w": "ở", "t": 99.19, "d": 0.075}, {"w": "California.", "t": 99.265, "d": 0.425}]}, {"text": "Phần trong hạn mức là phần chắc chắn, viết sẵn trong luật.", "start": 100.36, "end": 103.48, "words": [{"w": "Phần", "t": 100.46, "d": 0.155}, {"w": "trong", "t": 100.615, "d": 0.295}, {"w": "hạn", "t": 100.91, "d": 0.225}, {"w": "mức", "t": 101.135, "d": 0.06}, {"w": "là", "t": 101.195, "d": 0.205}, {"w": "phần", "t": 101.4, "d": 0.33}, {"w": "chắc", "t": 101.73, "d": 0.06}, {"w": "chắn,", "t": 101.79, "d": 0.395}, {"w": "viết", "t": 102.185, "d": 0.085}, {"w": "sẵn", "t": 102.27, "d": 0.275}, {"w": "trong", "t": 102.545, "d": 0.215}, {"w": "luật.", "t": 102.76, "d": 0.315}]}, {"text": "Phần trên hạn mức là phần phụ thuộc vào một quyết định, của người khác, vào lúc khó khăn nhất.", "start": 103.8, "end": 108.6, "words": [{"w": "Phần", "t": 103.875, "d": 0.13}, {"w": "trên", "t": 104.005, "d": 0.28}, {"w": "hạn", "t": 104.285, "d": 0.265}, {"w": "mức", "t": 104.55, "d": 0.06}, {"w": "là", "t": 104.61, "d": 0.205}, {"w": "phần", "t": 104.815, "d": 0.24}, {"w": "phụ", "t": 105.055, "d": 0.185}, {"w": "thuộc", "t": 105.24, "d": 0.22}, {"w": "vào", "t": 105.46, "d": 0.295}, {"w": "một", "t": 105.755, "d": 0.06}, {"w": "quyết", "t": 105.815, "d": 0.34}, {"w": "định,", "t": 106.155, "d": 0.19}, {"w": "của", "t": 106.345, "d": 0.195}, {"w": "người", "t": 106.54, "d": 0.22}, {"w": "khác,", "t": 106.76, "d": 0.395}, {"w": "vào", "t": 107.155, "d": 0.065}, {"w": "lúc", "t": 107.22, "d": 0.375}, {"w": "khó", "t": 107.595, "d": 0.06}, {"w": "khăn", "t": 107.655, "d": 0.23}, {"w": "nhất.", "t": 107.885, "d": 0.345}]}, {"text": "Câu nói hồi tháng mười năm hai nghìn không trăm hai mươi hai giúp người dân yên tâm, và dòng người đã thưa đi.", "start": 108.92, "end": 114.36, "words": [{"w": "Câu", "t": 109.02, "d": 0.28}, {"w": "nói", "t": 109.3, "d": 0.195}, {"w": "hồi", "t": 109.495, "d": 0.06}, {"w": "tháng", "t": 109.555, "d": 0.335}, {"w": "mười", "t": 109.89, "d": 0.19}, {"w": "năm", "t": 110.08, "d": 0.205}, {"w": "hai", "t": 110.285, "d": 0.195}, {"w": "nghìn", "t": 110.48, "d": 0.18}, {"w": "không", "t": 110.66, "d": 0.06}, {"w": "trăm", "t": 110.72, "d": 0.23}, {"w": "hai", "t": 110.95, "d": 0.32}, {"w": "mươi", "t": 111.27, "d": 0.11}, {"w": "hai", "t": 111.38, "d": 0.26}, {"w": "giúp", "t": 111.64, "d": 0.22}, {"w": "người", "t": 111.86, "d": 0.06}, {"w": "dân", "t": 111.92, "d": 0.18}, {"w": "yên", "t": 112.1, "d": 0.215}, {"w": "tâm,", "t": 112.315, "d": 0.44}, {"w": "và", "t": 112.755, "d": 0.06}, {"w": "dòng", "t": 112.815, "d": 0.225}, {"w": "người", "t": 113.04, "d": 0.145}, {"w": "đã", "t": 113.185, "d": 0.255}, {"w": "thưa", "t": 113.44, "d": 0.17}, {"w": "đi.", "t": 113.61, "d": 0.375}]}, {"text": "Còn trên giấy, con số luật ghi cho mỗi người, ở mỗi nơi, vẫn là hạn mức.", "start": 114.68, "end": 118.92, "words": [{"w": "Còn", "t": 114.74, "d": 0.18}, {"w": "trên", "t": 114.92, "d": 0.23}, {"w": "giấy,", "t": 115.15, "d": 0.3}, {"w": "con", "t": 115.45, "d": 0.11}, {"w": "số", "t": 115.56, "d": 0.195}, {"w": "luật", "t": 115.755, "d": 0.295}, {"w": "ghi", "t": 116.05, "d": 0.225}, {"w": "cho", "t": 116.275, "d": 0.07}, {"w": "mỗi", "t": 116.345, "d": 0.195}, {"w": "người,", "t": 116.54, "d": 0.45}, {"w": "ở", "t": 116.99, "d": 0.065}, {"w": "mỗi", "t": 117.055, "d": 0.285}, {"w": "nơi,", "t": 117.34, "d": 0.4}, {"w": "vẫn", "t": 117.74, "d": 0.06}, {"w": "là", "t": 117.8, "d": 0.19}, {"w": "hạn", "t": 117.99, "d": 0.34}, {"w": "mức.", "t": 118.33, "d": 0.235}]}, {"text": "Vậy với một tỷ hai của chị Thu, phần chắc chắn có thể lớn tới đâu?", "start": 119.92, "end": 123.76, "words": [{"w": "Vậy", "t": 119.98, "d": 0.22}, {"w": "với", "t": 120.2, "d": 0.26}, {"w": "một", "t": 120.46, "d": 0.06}, {"w": "tỷ", "t": 120.52, "d": 0.195}, {"w": "hai", "t": 120.715, "d": 0.245}, {"w": "của", "t": 120.96, "d": 0.155}, {"w": "chị", "t": 121.115, "d": 0.195}, {"w": "Thu,", "t": 121.31, "d": 0.325}, {"w": "phần", "t": 121.635, "d": 0.165}, {"w": "chắc", "t": 121.8, "d": 0.36}, {"w": "chắn", "t": 122.16, "d": 0.06}, {"w": "có", "t": 122.22, "d": 0.26}, {"w": "thể", "t": 122.48, "d": 0.13}, {"w": "lớn", "t": 122.61, "d": 0.195}, {"w": "tới", "t": 122.805, "d": 0.23}, {"w": "đâu?", "t": 123.035, "d": 0.35}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "5", "k": "CHƯƠNG NĂM", "title": "40 TỶ ĐÔ LA\nTR