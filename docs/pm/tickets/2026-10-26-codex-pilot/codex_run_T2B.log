motion/hf/assets/long\ck-b2-lai-kep\ch02\data.js:1:window.CASE = {"topic": "ck-b2-lai-kep", "ch": "ch02", "dur": 67.5, "seed": 12703, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 02", "t": "NĂM THỨ MƯỜI BA"}, "acc": ["lãi", "kép", "lan", "minh", "lạm", "phát", "ngược"], "lines": [{"text": "Vẫn với mức lãi giả định sáu phần trăm một năm. Mỗi tháng, bạn nộp ba triệu.", "start": 0.0, "end": 4.4, "words": [{"w": "Vẫn", "t": 0.1, "d": 0.235}, {"w": "với", "t": 0.335, "d": 0.27}, {"w": "mức", "t": 0.605, "d": 0.06}, {"w": "lãi", "t": 0.665, "d": 0.295}, {"w": "giả", "t": 0.96, "d": 0.265}, {"w": "định", "t": 1.225, "d": 0.15}, {"w": "sáu", "t": 1.375, "d": 0.16}, {"w": "phần", "t": 1.535, "d": 0.185}, {"w": "trăm", "t": 1.72, "d": 0.335}, {"w": "một", "t": 2.055, "d": 0.215}, {"w": "năm.", "t": 2.27, "d": 0.295}, {"w": "Mỗi", "t": 2.565, "d": 0.065}, {"w": "tháng,", "t": 2.63, "d": 0.515}, {"w": "bạn", "t": 3.145, "d": 0.065}, {"w": "nộp", "t": 3.21, "d": 0.195}, {"w": "ba", "t": 3.405, "d": 0.205}, {"w": "triệu.", "t": 3.61, "d": 0.405}]}, {"text": "Sau mười năm, bạn đã nộp ba trăm sáu mươi triệu, và có khoảng bốn trăm chín mươi triệu.", "start": 5.2, "end": 9.92, "words": [{"w": "Sau", "t": 5.285, "d": 0.155}, {"w": "mười", "t": 5.44, "d": 0.2}, {"w": "năm,", "t": 5.64, "d": 0.435}, {"w": "bạn", "t": 6.075, "d": 0.06}, {"w": "đã", "t": 6.135, "d": 0.23}, {"w": "nộp", "t": 6.365, "d": 0.315}, {"w": "ba", "t": 6.68, "d": 0.225}, {"w": "trăm", "t": 6.905, "d": 0.06}, {"w": "sáu", "t": 6.965, "d": 0.22}, {"w": "mươi", "t": 7.185, "d": 0.27}, {"w": "triệu,", "t": 7.455, "d": 0.33}, {"w": "và", "t": 7.785, "d": 0.11}, {"w": "có", "t": 7.895, "d": 0.275}, {"w": "khoảng", "t": 8.17, "d": 0.17}, {"w": "bốn", "t": 8.34, "d": 0.255}, {"w": "trăm", "t": 8.595, "d": 0.215}, {"w": "chín", "t": 8.81, "d": 0.205}, {"w": "mươi", "t": 9.015, "d": 0.13}, {"w": "triệu.", "t": 9.145, "d": 0.4}]}, {"text": "Tiền lãi mới chiếm hơn một phần tư. Chưa có gì ghê gớm.", "start": 10.24, "end": 13.36, "words": [{"w": "Tiền", "t": 10.29, "d": 0.26}, {"w": "lãi", "t": 10.55, "d": 0.06}, {"w": "mới", "t": 10.61, "d": 0.25}, {"w": "chiếm", "t": 10.86, "d": 0.215}, {"w": "hơn", "t": 11.075, "d": 0.135}, {"w": "một", "t": 11.21, "d": 0.235}, {"w": "phần", "t": 11.445, "d": 0.195}, {"w": "tư.", "t": 11.64, "d": 0.345}, {"w": "Chưa", "t": 11.985, "d": 0.08}, {"w": "có", "t": 12.065, "d": 0.225}, {"w": "gì", "t": 12.29, "d": 0.185}, {"w": "ghê", "t": 12.475, "d": 0.34}, {"w": "gớm.", "t": 12.815, "d": 0.235}]}, {"text": "Sau hai mươi năm, bạn nộp bảy trăm hai mươi triệu, và có gần một tỷ bốn.", "start": 14.36, "end": 18.6, "words": [{"w": "Sau", "t": 14.415, "d": 0.225}, {"w": "hai", "t": 14.64, "d": 0.125}, {"w": "mươi", "t": 14.765, "d": 0.345}, {"w": "năm,", "t": 15.11, "d": 0.145}, {"w": "bạn", "t": 15.255, "d": 0.26}, {"w": "nộp", "t": 15.515, "d": 0.27}, {"w": "bảy", "t": 15.785, "d": 0.205}, {"w": "trăm", "t": 15.99, "d": 0.21}, {"w": "hai", "t": 16.2, "d": 0.25}, {"w": "mươi", "t": 16.45, "d": 0.115}, {"w": "triệu,", "t": 16.565, "d": 0.31}, {"w": "và", "t": 16.875, "d": 0.13}, {"w": "có", "t": 17.005, "d": 0.28}, {"w": "gần", "t": 17.285, "d": 0.17}, {"w": "một", "t": 17.455, "d": 0.34}, {"w": "tỷ", "t": 17.795, "d": 0.055}, {"w": "bốn.", "t": 17.85, "d": 0.39}]}, {"text": "Tiền lãi lúc này đã gần bằng tiền bạn nộp.", "start": 18.92, "end": 21.24, "words": [{"w": "Tiền", "t": 18.98, "d": 0.195}, {"w": "lãi", "t": 19.175, "d": 0.1}, {"w": "lúc", "t": 19.275, "d": 0.205}, {"w": "này", "t": 19.48, "d": 0.29}, {"w": "đã", "t": 19.77, "d": 0.17}, {"w": "gần", "t": 19.94, "d": 0.19}, {"w": "bằng", "t": 20.13, "d": 0.18}, {"w": "tiền", "t": 20.31, "d": 0.065}, {"w": "bạn", "t": 20.375, "d": 0.29}, {"w": "nộp.", "t": 20.665, "d": 0.215}]}, {"text": "Sau ba mươi năm, bạn nộp một tỷ không trăm tám mươi triệu.", "start": 22.24, "end": 25.28, "words": [{"w": "Sau", "t": 22.28, "d": 0.1}, {"w": "ba", "t": 22.38, "d": 0.28}, {"w": "mươi", "t": 22.66, "d": 0.12}, {"w": "năm,", "t": 22.78, "d": 0.405}, {"w": "bạn", "t": 23.185, "d": 0.055}, {"w": "nộp", "t": 23.24, "d": 0.345}, {"w": "một", "t": 23.585, "d": 0.185}, {"w": "tỷ", "t": 23.77, "d": 0.06}, {"w": "không", "t": 23.83, "d": 0.19}, {"w": "trăm", "t": 24.02, "d": 0.18}, {"w": "tám", "t": 24.2, "d": 0.23}, {"w": "mươi", "t": 24.43, "d": 0.27}, {"w": "triệu.", "t": 24.7, "d": 0.22}]}, {"text": "Và có khoảng ba tỷ.", "start": 25.6, "end": 27.04, "words": [{"w": "Và", "t": 25.65, "d": 0.205}, {"w": "có", "t": 25.855, "d": 0.185}, {"w": "khoảng", "t": 26.04, "d": 0.23}, {"w": "ba", "t": 26.27, "d": 0.2}, {"w": "tỷ.", "t": 26.47, "d": 0.22}]}, {"text": "Gần hai phần ba số ấy là tiền lãi, không phải tiền bạn bỏ ra.", "start": 27.36, "end": 30.96, "words": [{"w": "Gần", "t": 27.45, "d": 0.18}, {"w": "hai", "t": 27.63, "d": 0.165}, {"w": "phần", "t": 27.795, "d": 0.21}, {"w": "ba", "t": 28.005, "d": 0.255}, {"w": "số", "t": 28.26, "d": 0.11}, {"w": "ấy", "t": 28.37, "d": 0.33}, {"w": "là", "t": 28.7, "d": 0.055}, {"w": "tiền", "t": 28.755, "d": 0.305}, {"w": "lãi,", "t": 29.06, "d": 0.185}, {"w": "không", "t": 29.245, "d": 0.34}, {"w": "phải", "t": 29.585, "d": 0.21}, {"w": "tiền", "t": 29.795, "d": 0.195}, {"w": "bạn", "t": 29.99, "d": 0.135}, {"w": "bỏ", "t": 30.125, "d": 0.255}, {"w": "ra.", "t": 30.38, "d": 0.23}]}, {"text": "Và đây là con số mình hứa.", "start": 31.96, "end": 33.64, "words": [{"w": "Và", "t": 32.03, "d": 0.135}, {"w": "đây", "t": 32.165, "d": 0.28}, {"w": "là", "t": 32.445, "d": 0.06}, {"w": "con", "t": 32.505, "d": 0.19}, {"w": "số", "t": 32.695, "d": 0.165}, {"w": "mình", "t": 32.86, "d": 0.215}, {"w": "hứa.", "t": 33.075, "d": 0.265}]}, {"text": "Năm thứ mười ba.", "start": 33.96, "end": 35.16, "words": [{"w": "Năm", "t": 34.01, "d": 0.22}, {"w": "thứ", "t": 34.23, "d": 0.06}, {"w": "mười", "t": 34.29, "d": 0.27}, {"w": "ba.", "t": 34.56, "d": 0.225}]}, {"text": "Từ năm ấy, tiền lãi sinh ra trong một năm bắt đầu lớn hơn ba mươi sáu triệu bạn nộp vào trong năm.", "start": 35.48, "end": 40.52, "words": [{"w": "Từ", "t": 35.535, "d": 0.245}, {"w": "năm", "t": 35.78, "d": 0.065}, {"w": "ấy,", "t": 35.845, "d": 0.435}, {"w": "tiền", "t": 36.28, "d": 0.06}, {"w": "lãi", "t": 36.34, "d": 0.305}, {"w": "sinh", "t": 36.645, "d": 0.15}, {"w": "ra", "t": 36.795, "d": 0.17}, {"w": "trong", "t": 36.965, "d": 0.17}, {"w": "một", "t": 37.135, "d": 0.31}, {"w": "năm", "t": 37.445, "d": 0.17}, {"w": "bắt", "t": 37.615, "d": 0.165}, {"w": "đầu", "t": 37.78, "d": 0.22}, {"w": "lớn", "t": 38.0, "d": 0.065}, {"w": "hơn", "t": 38.065, "d": 0.2}, {"w": "ba", "t": 38.265, "d": 0.2}, {"w": "mươi", "t": 38.465, "d": 0.265}, {"w": "sáu", "t": 38.73, "d": 0.09}, {"w": "triệu", "t": 38.82, "d": 0.175}, {"w": "bạn", "t": 38.995, "d": 0.325}, {"w": "nộp", "t": 39.32, "d": 0.22}, {"w": "vào", "t": 39.54, "d": 0.065}, {"w": "trong", "t": 39.605, "d": 0.18}, {"w": "năm.", "t": 39.785, "d": 0.36}]}, {"text": "Nói cách khác, từ năm thứ mười ba, tiền của bạn làm việc chăm hơn cả bạn.", "start": 40.84, "end": 45.0, "words": [{"w": "Nói", "t": 40.915, "d": 0.215}, {"w": "cách", "t": 41.13, "d": 0.135}, {"w": "khác,", "t": 41.265, "d": 0.41}, {"w": "từ", "t": 41.675, "d": 0.06}, {"w": "năm", "t": 41.735, "d": 0.375}, {"w": "thứ", "t": 42.11, "d": 0.06}, {"w": "mười", "t": 42.17, "d": 0.275}, {"w": "ba,", "t": 42.445, "d": 0.375}, {"w": "tiền", "t": 42.82, "d": 0.06}, {"w": "của", "t": 42.88, "d": 0.255}, {"w": "bạn", "t": 43.135, "d": 0.26}, {"w": "làm", "t": 43.395, "d": 0.06}, {"w": "việc", "t": 43.455, "d": 0.36}, {"w": "chăm", "t": 43.815, "d": 0.06}, {"w": "hơn", "t": 43.875, "d": 0.215}, {"w": "cả", "t": 44.09, "d": 0.24}, {"w": "bạn.", "t": 44.33, "d": 0.315}]}, {"text": "Mười ba năm cơ à? Lâu thế.", "start": 46.0, "end": 47.68, "ask": 1, "words": [{"w": "Mười", "t": 46.095, "d": 0.17}, {"w": "ba", "t": 46.265, "d": 0.17}, {"w": "năm", "t": 46.435, "d": 0.18}, {"w": "cơ", "t": 46.615, "d": 0.2}, {"w": "à?", "t": 46.815, "d": 0.15}, {"w": "Lâu", "t": 46.965, "d": 0.135}, {"w": "thế.", "t": 47.1, "d": 0.34}]}, {"text": "Đúng vậy. Và đó là điều ít ai nói về lãi kép.", "start": 48.0, "end": 51.12, "words": [{"w": "Đúng", "t": 48.055, "d": 0.225}, {"w": "vậy.", "t": 48.28, "d": 0.34}, {"w": "Và", "t": 48.62, "d": 0.1}, {"w": "đó", "t": 48.72, "d": 0.255}, {"w": "là", "t": 48.975, "d": 0.315}, {"w": "điều", "t": 49.29, "d": 0.2}, {"w": "ít", "t": 49.49, "d": 0.2}, {"w": "ai", "t": 49.69, "d": 0.07}, {"w": "nói", "t": 49.76, "d": 0.345}, {"w": "về", "t": 50.105, "d": 0.125}, {"w": "lãi", "t": 50.23, "d": 0.27}, {"w": "kép.", "t": 50.5, "d": 0.265}]}, {"text": "Mười năm đầu, nó gần như vô hình. Phần lớn người ta bỏ cuộc trước khi thấy nó.", "start": 51.44, "end": 55.6, "words": [{"w": "Mười", "t": 51.505, "d": 0.21}, {"w": "năm", "t": 51.715, "d": 0.15}, {"w": "đầu,", "t": 51.865, "d": 0.355}, {"w": "nó", "t": 52.22, "d": 0.07}, {"w": "gần", "t": 52.29, "d": 0.19}, {"w": "như", "t": 52.48, "d": 0.335}, {"w": "vô", "t": 52.815, "d": 0.135}, {"w": "hình.", "t": 52.95, "d": 0.325}, {"w": "Phần", "t": 53.275, "d": 0.075}, {"w": "lớn", "t": 53.35, "d": 0.26}, {"w": "người", "t": 53.61, "d": 0.215}, {"w": "ta", "t": 53.825, "d": 0.16}, {"w": "bỏ", "t": 53.985, "d": 0.13}, {"w": "cuộc", "t": 54.115, "d": 0.24}, {"w": "trước", "t": 54.355, "d": 0.18}, {"w": "khi", "t": 54.535, "d": 0.17}, {"w": "thấy", "t": 54.705, "d": 0.165}, {"w": "nó.", "t": 54.87, "d": 0.39}]}, {"text": "Có một mẹo tính nhẩm nổi tiếng, gọi là quy tắc bảy mươi hai.", "start": 56.6, "end": 60.04, "words": [{"w": "Có", "t": 56.7, "d": 0.265}, {"w": "một", "t": 56.965, "d": 0.185}, {"w": "mẹo", "t": 57.15, "d": 0.095}, {"w": "tính", "t": 57.245, "d": 0.195}, {"w": "nhẩm", "t": 57.44, "d": 0.17}, {"w": "nổi", "t": 57.61, "d": 0.225}, {"w": "tiếng,", "t": 57.835, "d": 0.4}, {"w": "gọi", "t": 58.235, "d": 0.06}, {"w": "là", "t": 58.295, "d": 0.19}, {"w": "quy", "t": 58.485, "d": 0.255}, {"w": "tắc", "t": 58.74, "d": 0.305}, {"w": "bảy", "t": 59.045, "d": 0.06}, {"w": "mươi", "t": 59.105, "d": 0.185}, {"w": "hai.", "t": 59.29, "d": 0.38}]}, {"text": "Lấy bảy mươi hai chia cho lãi suất, ra số năm để tiền gấp đôi.", "start": 60.36, "end": 63.88, "words": [{"w": "Lấy", "t": 60.42, "d": 0.135}, {"w": "bảy", "t": 60.555, "d": 0.325}, {"w": "mươi", "t": 60.88, "d": 0.06}, {"w": "hai", "t": 60.94, "d": 0.16}, {"w": "chia", "t": 61.1, "d": 0.205}, {"w": "cho", "t": 61.305, "d": 0.33}, {"w": "lãi", "t": 61.635, "d": 0.19}, {"w": "suất,", "t": 61.825, "d": 0.23}, {"w": "ra", "t": 62.055, "d": 0.1}, {"w": "số", "t": 62.155, "d": 0.195}, {"w": "năm", "t": 62.35, "d": 0.27}, {"w": "để", "t": 62.62, "d": 0.27}, {"w": "tiền", "t": 62.89, "d": 0.06}, {"w": "gấp", "t": 62.95, "d": 0.32}, {"w": "đôi.", "t": 63.27, "d": 0.225}]}, {"text": "Sáu phần trăm, thì khoảng mười hai năm.", "start": 64.2, "end": 66.28, "words": [{"w": "Sáu", "t": 64.285, "d": 0.2}, {"w": "phần", "t": 64.485, "d": 0.175}, {"w": "trăm,", "t": 64.66, "d": 0.35}, {"w": "thì", "t": 65.01, "d": 0.06}, {"w": "khoảng", "t": 65.07, "d": 0.16}, {"w": "mười", "t": 65.23, "d": 0.16}, {"w": "hai", "t": 65.39, "d": 0.215}, {"w": "năm.", "t": 65.605, "d": 0.34}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "race", "abs": true, "unit": "TRIỆU", "xlab": "NĂM ", "xstep": 5, "dates": ["nam__00", "nam__01", "nam__02", "nam__03", "nam__04", "nam__05", "nam__06", "nam__07", "nam__08", "nam__09", "nam__10", "nam__11", "nam__12", "nam__13", "nam__14", "nam__15", "nam__16", "nam__17", "nam__18", "nam__19", "nam__20", "nam__21", "nam__22", "nam__23", "nam__24", "nam__25", "nam__26", "nam__27", "nam__28", "nam__29", "nam__30"], "title": "NỘP 3 TRIỆU MỖI THÁNG · 30 NĂM", "range": "NĂM 0 → 30 · TRIỆU ĐỒNG", "drawAt": 0.1, "until": 23.24, "series": [{"label": "TÀI KHOẢN (LÃI 6%)", "color": "#fbbf24", "vals": [0.0, 37.0, 76.3, 118.0, 162.3, 209.