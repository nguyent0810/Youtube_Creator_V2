": 0.34}, {"w": "luật,", "t": 22.52, "d": 0.31}, {"w": "một", "t": 22.83, "d": 0.07}, {"w": "nghiên", "t": 22.9, "d": 0.32}, {"w": "cứu", "t": 23.22, "d": 0.06}, {"w": "đăng", "t": 23.28, "d": 0.175}, {"w": "trên", "t": 23.455, "d": 0.275}, {"w": "Tạp", "t": 23.73, "d": 0.18}, {"w": "chí", "t": 23.91, "d": 0.16}, {"w": "Phân", "t": 24.07, "d": 0.26}, {"w": "tích", "t": 24.33, "d": 0.185}, {"w": "Pháp", "t": 24.515, "d": 0.15}, {"w": "luật", "t": 24.665, "d": 0.31}, {"w": "năm", "t": 24.975, "d": 0.06}, {"w": "2024", "t": 25.035, "d": 1.5}, {"w": "hỏi", "t": 26.535, "d": 0.06}, {"w": "các", "t": 26.595, "d": 0.2}, {"w": "mô", "t": 26.795, "d": 0.155}, {"w": "hình", "t": 26.95, "d": 0.295}, {"w": "những", "t": 27.245, "d": 0.21}, {"w": "câu", "t": 27.455, "d": 0.25}, {"w": "có", "t": 27.705, "d": 0.195}, {"w": "thể", "t": 27.9, "d": 0.195}, {"w": "kiểm", "t": 28.095, "d": 0.065}, {"w": "chứng,", "t": 28.16, "d": 0.44}, {"w": "về", "t": 28.6, "d": 0.07}, {"w": "những", "t": 28.67, "d": 0.32}, {"w": "vụ", "t": 28.99, "d": 0.12}, {"w": "án", "t": 29.11, "d": 0.16}, {"w": "liên", "t": 29.27, "d": 0.285}, {"w": "bang", "t": 29.555, "d": 0.21}, {"w": "chọn", "t": 29.765, "d": 0.145}, {"w": "ngẫu", "t": 29.91, "d": 0.18}, {"w": "nhiên.", "t": 30.09, "d": 0.3}]}, {"text": "Tỉ lệ trả lời bịa, tuỳ mô hình, từ năm mươi tám tới tám mươi tám phần trăm.", "start": 30.92, "end": 34.84, "words": [{"w": "Tỉ", "t": 31.025, "d": 0.255}, {"w": "lệ", "t": 31.28, "d": 0.06}, {"w": "trả", "t": 31.34, "d": 0.26}, {"w": "lời", "t": 31.6, "d": 0.23}, {"w": "bịa,", "t": 31.83, "d": 0.25}, {"w": "tuỳ", "t": 32.08, "d": 0.16}, {"w": "mô", "t": 32.24, "d": 0.13}, {"w": "hình,", "t": 32.37, "d": 0.405}, {"w": "từ", "t": 32.775, "d": 0.09}, {"w": "năm", "t": 32.865, "d": 0.215}, {"w": "mươi", "t": 33.08, "d": 0.24}, {"w": "tám", "t": 33.32, "d": 0.185}, {"w": "tới", "t": 33.505, "d": 0.145}, {"w": "tám", "t": 33.65, "d": 0.215}, {"w": "mươi", "t": 33.865, "d": 0.16}, {"w": "tám", "t": 34.025, "d": 0.13}, {"w": "phần", "t": 34.155, "d": 0.245}, {"w": "trăm.", "t": 34.4, "d": 0.23}]}, {"text": "Và các mô hình nhiều khi không biết lúc nào chính mình đang bịa.", "start": 35.16, "end": 38.12, "words": [{"w": "Và", "t": 35.235, "d": 0.19}, {"w": "các", "t": 35.425, "d": 0.1}, {"w": "mô", "t": 35.525, "d": 0.345}, {"w": "hình", "t": 35.87, "d": 0.18}, {"w": "nhiều", "t": 36.05, "d": 0.08}, {"w": "khi", "t": 36.13, "d": 0.16}, {"w": "không", "t": 36.29, "d": 0.205}, {"w": "biết", "t": 36.495, "d": 0.265}, {"w": "lúc", "t": 36.76, "d": 0.065}, {"w": "nào", "t": 36.825, "d": 0.33}, {"w": "chính", "t": 37.155, "d": 0.07}, {"w": "mình", "t": 37.225, "d": 0.3}, {"w": "đang", "t": 37.525, "d": 0.185}, {"w": "bịa.", "t": 37.71, "d": 0.215}]}, {"text": "Đó là những mô hình của năm 2023. Các mô hình về sau đã khá hơn, nhưng chưa hết bịa.", "start": 39.12, "end": 44.24, "words": [{"w": "Đó", "t": 39.195, "d": 0.25}, {"w": "là", "t": 39.445, "d": 0.14}, {"w": "những", "t": 39.585, "d": 0.19}, {"w": "mô", "t": 39.775, "d": 0.175}, {"w": "hình", "t": 39.95, "d": 0.085}, {"w": "của", "t": 40.035, "d": 0.13}, {"w": "năm", "t": 40.165, "d": 0.295}, {"w": "2023.", "t": 40.46, "d": 1.275}, {"w": "Các", "t": 41.735, "d": 0.165}, {"w": "mô", "t": 41.9, "d": 0.24}, {"w": "hình", "t": 42.14, "d": 0.115}, {"w": "về", "t": 42.255, "d": 0.25}, {"w": "sau", "t": 42.505, "d": 0.145}, {"w": "đã", "t": 42.65, "d": 0.065}, {"w": "khá", "t": 42.715, "d": 0.16}, {"w": "hơn,", "t": 42.875, "d": 0.43}, {"w": "nhưng", "t": 43.305, "d": 0.065}, {"w": "chưa", "t": 43.37, "d": 0.205}, {"w": "hết", "t": 43.575, "d": 0.25}, {"w": "bịa.", "t": 43.825, "d": 0.205}]}, {"text": "Nhưng hãy cảnh giác với bất kỳ ai nói \"AI sai bao nhiêu phần trăm\".", "start": 44.56, "end": 47.84, "words": [{"w": "Nhưng", "t": 44.655, "d": 0.25}, {"w": "hãy", "t": 44.905, "d": 0.18}, {"w": "cảnh", "t": 45.085, "d": 0.18}, {"w": "giác", "t": 45.265, "d": 0.065}, {"w": "với", "t": 45.33, "d": 0.29}, {"w": "bất", "t": 45.62, "d": 0.06}, {"w": "kỳ", "t": 45.68, "d": 0.3}, {"w": "ai", "t": 45.98, "d": 0.07}, {"w": "nói", "t": 46.05, "d": 0.285}, {"w": "\"AI", "t": 46.335, "d": 0.275}, {"w": "sai", "t": 46.61, "d": 0.105}, {"w": "bao", "t": 46.715, "d": 0.21}, {"w": "nhiêu", "t": 46.925, "d": 0.305}, {"w": "phần", "t": 47.23, "d": 0.14}, {"w": "trăm\".", "t": 47.37, "d": 0.25}]}, {"text": "Không có một con số chung cho mọi AI và mọi câu hỏi.", "start": 48.16, "end": 51.04, "words": [{"w": "Không", "t": 48.27, "d": 0.145}, {"w": "có", "t": 48.415, "d": 0.215}, {"w": "một", "t": 48.63, "d": 0.21}, {"w": "con", "t": 48.84, "d": 0.175}, {"w": "số", "t": 49.015, "d": 0.06}, {"w": "chung", "t": 49.075, "d": 0.23}, {"w": "cho", "t": 49.305, "d": 0.11}, {"w": "mọi", "t": 49.415, "d": 0.205}, {"w": "AI", "t": 49.62, "d": 0.265}, {"w": "và", "t": 49.885, "d": 0.29}, {"w": "mọi", "t": 50.175, "d": 0.2}, {"w": "câu", "t": 50.375, "d": 0.08}, {"w": "hỏi.", "t": 50.455, "d": 0.29}]}, {"text": "Tỉ lệ ấy đổi theo mô hình, theo ngôn ngữ, và nhất là theo câu hỏi. Điều càng hiếm thì càng dễ bị bịa.", "start": 51.36, "end": 57.04, "words": [{"w": "Tỉ", "t": 51.45, "d": 0.2}, {"w": "lệ", "t": 51.65, "d": 0.175}, {"w": "ấy", "t": 51.825, "d": 0.195}, {"w": "đổi", "t": 52.02, "d": 0.155}, {"w": "theo", "t": 52.175, "d": 0.385}, {"w": "mô", "t": 52.56, "d": 0.175}, {"w": "hình,", "t": 52.735, "d": 0.245}, {"w": "theo", "t": 52.98, "d": 0.145}, {"w": "ngôn", "t": 53.125, "d": 0.375}, {"w": "ngữ,", "t": 53.5, "d": 0.15}, {"w": "và", "t": 53.65, "d": 0.33}, {"w": "nhất", "t": 53.98, "d": 0.25}, {"w": "là", "t": 54.23, "d": 0.16}, {"w": "theo", "t": 54.39, "d": 0.155}, {"w": "câu", "t": 54.545, "d": 0.31}, {"w": "hỏi.", "t": 54.855, "d": 0.265}, {"w": "Điều", "t": 55.12, "d": 0.265}, {"w": "càng", "t": 55.385, "d": 0.135}, {"w": "hiếm", "t": 55.52, "d": 0.245}, {"w": "thì", "t": 55.765, "d": 0.125}, {"w": "càng", "t": 55.89, "d": 0.205}, {"w": "dễ", "t": 56.095, "d": 0.285}, {"w": "bị", "t": 56.38, "d": 0.1}, {"w": "bịa.", "t": 56.48, "d": 0.38}]}, {"text": "Vậy với một việc rất đời thường, như hỏi tin tức, các trợ lý AI năm 2025 làm tốt đến đâu?", "start": 58.04, "end": 63.96, "words": [{"w": "Vậy", "t": 58.125, "d": 0.22}, {"w": "với", "t": 58.345, "d": 0.23}, {"w": "một", "t": 58.575, "d": 0.19}, {"w": "việc", "t": 58.765, "d": 0.185}, {"w": "rất", "t": 58.95, "d": 0.06}, {"w": "đời", "t": 59.01, "d": 0.225}, {"w": "thường,", "t": 59.235, "d": 0.395}, {"w": "như", "t": 59.63, "d": 0.06}, {"w": "hỏi", "t": 59.69, "d": 0.275}, {"w": "tin", "t": 59.965, "d": 0.185}, {"w": "tức,", "t": 60.15, "d": 0.32}, {"w": "các", "t": 60.47, "d": 0.2}, {"w": "trợ", "t": 60.67, "d": 0.17}, {"w": "lý", "t": 60.84, "d": 0.14}, {"w": "AI", "t": 60.98, "d": 0.41}, {"w": "năm", "t": 61.39, "d": 0.165}, {"w": "2025", "t": 61.555, "d": 1.355}, {"w": "làm", "t": 62.91, "d": 0.06}, {"w": "tốt", "t": 62.97, "d": 0.26}, {"w": "đến", "t": 63.23, "d": 0.185}, {"w": "đâu?", "t": 63.415, "d": 0.3}]}], "imgs": {"sdny": {"src": "assets/long/mim-ai-hallucinate/img/sdny.jpg", "w": 1350, "h": 2400, "lic": "CC BY 2.0", "by": "Ajay Suresh from New York, NY, USA", "pd": false}, "moynihan": {"src": "assets/long/mim-ai-hallucinate/img/moynihan.jpg", "w": 1600, "h": 2400, "lic": "CC BY 4.0", "by": "83136374@N05", "pd": false}, "scantron": {"src": "assets/long/mim-ai-hallucinate/img/scantron.jpg", "w": 960, "h": 959, "lic": "CC0", "by": "Lexilovescaffeine", "pd": true}, "starliner": {"src": "assets/long/mim-ai-hallucinate/img/starliner.jpg", "w": 1920, "h": 1078, "lic": "Public domain", "by": "NASA Johnson Space Center", "pd": true}, "vatican": {"src": "assets/long/mim-ai-hallucinate/img/vatican.jpg", "w": 1920, "h": 1262, "lic": "CC0", "by": "Jebulon", "pd": true}}, "geo": {}, "scenes": [{"type": "chapter", "no": "5", "k": "CHƯƠNG NĂM", "title": "ĐẾM NHỮNG\nTRÍCH DẪN MA", "sub": "2023 — 2024", "vid": "v0", "ms": 12, "illus": "VIDEO MINH HỌA", "titleAt": 0.09, "t0": 0.0, "t1": 8.72}, {"type": "counter", "from": 0, "to": 636, 