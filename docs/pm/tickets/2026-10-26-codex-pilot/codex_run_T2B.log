motion/hf/assets/long\ck-d2-fomo\ch01\data.js:1:window.CASE = {"topic": "ck-d2-fomo", "ch": "ch01", "dur": 69.42, "seed": 8715, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHẶNG 01", "t": "NĂM 2007"}, "acc": ["vn-index", "fomo", "đỉnh", "kỷ", "lục", "tài", "khoản"], "lines": [{"text": "Thị trường chứng khoán Việt Nam mở cửa năm hai nghìn.", "start": 0.0, "end": 2.56, "words": [{"w": "Thị", "t": 0.07, "d": 0.12}, {"w": "trường", "t": 0.19, "d": 0.22}, {"w": "chứng", "t": 0.41, "d": 0.205}, {"w": "khoán", "t": 0.615, "d": 0.27}, {"w": "Việt", "t": 0.885, "d": 0.175}, {"w": "Nam", "t": 1.06, "d": 0.19}, {"w": "mở", "t": 1.25, "d": 0.195}, {"w": "cửa", "t": 1.445, "d": 0.09}, {"w": "năm", "t": 1.535, "d": 0.205}, {"w": "hai", "t": 1.74, "d": 0.205}, {"w": "nghìn.", "t": 1.945, "d": 0.275}]}, {"text": "Sáu năm sau, nó bước vào cơn sốt đầu tiên.", "start": 3.36, "end": 6.08, "words": [{"w": "Sáu", "t": 3.43, "d": 0.25}, {"w": "năm", "t": 3.68, "d": 0.205}, {"w": "sau,", "t": 3.885, "d": 0.315}, {"w": "nó", "t": 4.2, "d": 0.1}, {"w": "bước", "t": 4.3, "d": 0.39}, {"w": "vào", "t": 4.69, "d": 0.055}, {"w": "cơn", "t": 4.745, "d": 0.2}, {"w": "sốt", "t": 4.945, "d": 0.355}, {"w": "đầu", "t": 5.3, "d": 0.23}, {"w": "tiên.", "t": 5.53, "d": 0.25}]}, {"text": "Cuối năm hai nghìn không trăm lẻ sáu, VN-Index ở khoảng bảy trăm ba mươi hai điểm.", "start": 6.4, "end": 10.56, "words": [{"w": "Cuối", "t": 6.49, "d": 0.26}, {"w": "năm", "t": 6.75, "d": 0.12}, {"w": "hai", "t": 6.87, "d": 0.165}, {"w": "nghìn", "t": 7.035, "d": 0.14}, {"w": "không", "t": 7.175, "d": 0.305}, {"w": "trăm", "t": 7.48, "d": 0.12}, {"w": "lẻ", "t": 7.6, "d": 0.245}, {"w": "sáu,", "t": 7.845, "d": 0.155}, {"w": "VN-Index", "t": 8.0, "d": 0.69}, {"w": "ở", "t": 8.69, "d": 0.06}, {"w": "khoảng", "t": 8.75, "d": 0.17}, {"w": "bảy", "t": 8.92, "d": 0.23}, {"w": "trăm", "t": 9.15, "d": 0.195}, {"w": "ba", "t": 9.345, "d": 0.215}, {"w": "mươi", "t": 9.56, "d": 0.12}, {"w": "hai", "t": 9.68, "d": 0.15}, {"w": "điểm.", "t": 9.83, "d": 0.36}]}, {"text": "Rồi Tết năm ấy tới, một cái Tết mà báo chí sau này tả lại là rất rộn ràng.", "start": 10.88, "end": 15.36, "words": [{"w": "Rồi", "t": 10.95, "d": 0.19}, {"w": "Tết", "t": 11.14, "d": 0.12}, {"w": "năm", "t": 11.26, "d": 0.23}, {"w": "ấy", "t": 11.49, "d": 0.225}, {"w": "tới,", "t": 11.715, "d": 0.43}, {"w": "một", "t": 12.145, "d": 0.075}, {"w": "cái", "t": 12.22, "d": 0.255}, {"w": "Tết", "t": 12.475, "d": 0.175}, {"w": "mà", "t": 12.65, "d": 0.18}, {"w": "báo", "t": 12.83, "d": 0.195}, {"w": "chí", "t": 13.025, "d": 0.19}, {"w": "sau", "t": 13.215, "d": 0.275}, {"w": "này", "t": 13.49, "d": 0.085}, {"w": "tả", "t": 13.575, "d": 0.265}, {"w": "lại", "t": 13.84, "d": 0.3}, {"w": "là", "t": 14.14, "d": 0.21}, {"w": "rất", "t": 14.35, "d": 0.15}, {"w": "rộn", "t": 14.5, "d": 0.075}, {"w": "ràng.", "t": 14.575, "d": 0.41}]}, {"text": "Theo một bài báo tổng kết năm ấy, hầu như ai chơi chứng khoán cũng có thành tích kiếm tiền để khoe.", "start": 15.68, "end": 20.8, "words": [{"w": "Theo", "t": 15.755, "d": 0.255}, {"w": "một", "t": 16.01, "d": 0.235}, {"w": "bài", "t": 16.245, "d": 0.2}, {"w": "báo", "t": 16.445, "d": 0.205}, {"w": "tổng", "t": 16.65, "d": 0.175}, {"w": "kết", "t": 16.825, "d": 0.055}, {"w": "năm", "t": 16.88, "d": 0.2}, {"w": "ấy,", "t": 17.08, "d": 0.37}, {"w": "hầu", "t": 17.45, "d": 0.165}, {"w": "như", "t": 17.615, "d": 0.36}, {"w": "ai", "t": 17.975, "d": 0.21}, {"w": "chơi", "t": 18.185, "d": 0.2}, {"w": "chứng", "t": 18.385, "d": 0.205}, {"w": "khoán", "t": 18.59, "d": 0.055}, {"w": "cũng", "t": 18.645, "d": 0.23}, {"w": "có", "t": 18.875, "d": 0.16}, {"w": "thành", "t": 19.035, "d": 0.345}, {"w": "tích", "t": 19.38, "d": 0.185}, {"w": "kiếm", "t": 19.565, "d": 0.23}, {"w": "tiền", "t": 19.795, "d": 0.21}, {"w": "để", "t": 20.005, "d": 0.185}, {"w": "khoe.", "t": 20.19, "d": 0.26}]}, {"text": "Chỉ trong ba tháng đầu năm hai nghìn không trăm lẻ bảy, chỉ số tăng thêm hơn năm mươi lăm phần trăm.", "start": 21.8, "end": 26.6, "words": [{"w": "Chỉ", "t": 21.875, "d": 0.17}, {"w": "trong", "t": 22.045, "d": 0.215}, {"w": "ba", "t": 22.26, "d": 0.21}, {"w": "tháng", "t": 22.47, "d": 0.24}, {"w": "đầu", "t": 22.71, "d": 0.185}, {"w": "năm", "t": 22.895, "d": 0.145}, {"w": "hai", "t": 23.04, "d": 0.075}, {"w": "nghìn", "t": 23.115, "d": 0.285}, {"w": "không", "t": 23.4, "d": 0.13}, {"w": "trăm", "t": 23.53, "d": 0.31}, {"w": "lẻ", "t": 23.84, "d": 0.06}, {"w": "bảy,", "t": 23.9, "d": 0.38}, {"w": "chỉ", "t": 24.28, "d": 0.075}, {"w": "số", "t": 24.355, "d": 0.23}, {"w": "tăng", "t": 24.585, "d": 0.185}, {"w": "thêm", "t": 24.77, "d": 0.21}, {"w": "hơn", "t": 24.98, "d": 0.185}, {"w": "năm", "t": 25.165, "d": 0.3}, {"w": "mươi", "t": 25.465, "d": 0.165}, {"w": "lăm", "t": 25.63, "d": 0.21}, {"w": "phần", "t": 25.84, "d": 0.19}, {"w": "trăm.", "t": 26.03, "d": 0.225}]}, {"text": "Ngày mười hai tháng ba, VN-Index lên tới một nghìn một trăm bảy mươi điểm.", "start": 26.92, "end": 30.84, "words": [{"w": "Ngày", "t": 27.025, "d": 0.265}, {"w": "mười", "t": 27.29, "d": 0.185}, {"w": "hai", "t": 27.475, "d": 0.19}, {"w": "tháng", "t": 27.665, "d": 0.185}, {"w": "ba,", "t": 27.85, "d": 0.2}, {"w": "VN-Index", "t": 28.05, "d": 0.585}, {"w": "lên", "t": 28.635, "d": 0.19}, {"w": "tới", "t": 28.825, "d": 0.265}, {"w": "một", "t": 29.09, "d": 0.135}, {"w": "nghìn", "t": 29.225, "d": 0.16}, {"w": "một", "t": 29.385, "d": 0.25}, {"w": "trăm", "t": 29.635, "d": 0.13}, {"w": "bảy", "t": 29.765, "d": 0.205}, {"w": "mươi", "t": 29.97, "d": 0.115}, {"w": "điểm.", "t": 30.085, "d": 0.35}]}, {"text": "Số tài khoản giao dịch cũng tăng vọt: tới tháng tám năm ấy, đã hơn hai trăm nghìn tài khoản, gấp ba lần cùng kỳ năm trước.", "start": 31.16, "end": 37.8, "words": [{"w": "Số", "t": 31.26, "d": 0.175}, {"w": "tài", "t": 31.435, "d": 0.185}, {"w": "