, "t": 9.535, "d": 0.345}, {"w": "bệnh", "t": 9.88, "d": 0.055}, {"w": "cho", "t": 9.935, "d": 0.325}, {"w": "bản", "t": 10.26, "d": 0.26}, {"w": "thân", "t": 10.52, "d": 0.165}, {"w": "hoặc", "t": 10.685, "d": 0.225}, {"w": "cho", "t": 10.91, "d": 0.065}, {"w": "con.", "t": 10.975, "d": 0.435}]}, {"text": "Có người đang gánh một khoản nợ lãi rất cao, mỗi tháng lãi chồng lên lãi.", "start": 12.04, "end": 15.8, "words": [{"w": "Có", "t": 12.085, "d": 0.275}, {"w": "người", "t": 12.36, "d": 0.19}, {"w": "đang", "t": 12.55, "d": 0.175}, {"w": "gánh", "t": 12.725, "d": 0.15}, {"w": "một", "t": 12.875, "d": 0.09}, {"w": "khoản", "t": 12.965, "d": 0.305}, {"w": "nợ", "t": 13.27, "d": 0.25}, {"w": "lãi", "t": 13.52, "d": 0.19}, {"w": "rất", "t": 13.71, "d": 0.06}, {"w": "cao,", "t": 13.77, "d": 0.335}, {"w": "mỗi", "t": 14.105, "d": 0.31}, {"w": "tháng", "t": 14.415, "d": 0.06}, {"w": "lãi", "t": 14.475, "d": 0.325}, {"w": "chồng", "t": 14.8, "d": 0.06}, {"w": "lên", "t": 14.86, "d": 0.19}, {"w": "lãi.", "t": 15.05, "d": 0.37}]}, {"text": "Có người biết chắc mình sẽ không quay lại làm việc có hợp đồng nữa.", "start": 16.12, "end": 19.56, "words": [{"w": "Có", "t": 16.19, "d": 0.12}, {"w": "người", "t": 16.31, "d": 0.345}, {"w": "biết", "t": 16.655, "d": 0.195}, {"w": "chắc", "t": 16.85, "d": 0.195}, {"w": "mình", "t": 17.045, "d": 0.11}, {"w": "sẽ", "t": 17.155, "d": 0.13}, {"w": "không", "t": 17.285, "d": 0.195}, {"w": "quay", "t": 17.48, "d": 0.295}, {"w": "lại", "t": 17.775, "d": 0.235}, {"w": "làm", "t": 18.01, "d": 0.195}, {"w": "việc", "t": 18.205, "d": 0.13}, {"w": "có", "t": 18.335, "d": 0.09}, {"w": "hợp", "t": 18.425, "d": 0.295}, {"w": "đồng", "t": 18.72, "d": 0.16}, {"w": "nữa.", "t": 18.88, "d": 0.33}]}, {"text": "Với khoản nợ lãi ba mươi phần trăm một năm, hai trăm triệu dùng để trả nợ có thể đáng giá hơn nhiều so với hai trăm triệu nằm chờ.", "start": 20.56, "end": 27.12, "words": [{"w": "Với", "t": 20.62, "d": 0.215}, {"w": "khoản", "t": 20.835, "d": 0.165}, {"w": "nợ", "t": 21.0, "d": 0.185}, {"w": "lãi", "t": 21.185, "d": 0.27}, {"w": "ba", "t": 21.455, "d": 0.055}, {"w": "mươi", "t": 21.51, "d": 0.305}, {"w": "phần", "t": 21.815, "d": 0.155}, {"w": "trăm", "t": 21.97, "d": 0.295}, {"w": "một", "t": 22.265, "d": 0.06}, {"w": "năm,", "t": 22.325, "d": 0.415}, {"w": "hai", "t": 22.74, "d": 0.055}, {"w": "trăm", "t": 22.795, "d": 0.23}, {"w": "triệu", "t": 23.025, "d": 0.16}, {"w": "dùng", "t": 23.185, "d": 0.23}, {"w": "để", "t": 23.415, "d": 0.335}, {"w": "trả", "t": 23.75, "d": 0.065}, {"w": "nợ", "t": 23.815, "d": 0.325}, {"w": "có", "t": 24.14, "d": 0.165}, {"w": "thể", "t": 24.305, "d": 0.185}, {"w": "đáng", "t": 24.49, "d": 0.235}, {"w": "giá", "t": 24.725, "d": 0.195}, {"w": "hơn", "t": 24.92, "d": 0.13}, {"w": "nhiều", "t": 25.05, "d": 0.26}, {"w": "so", "t": 25.31, "d": 0.08}, {"w": "với", "t": 25.39, "d": 0.16}, {"w": "hai", "t": 25.55, "d": 0.325}, {"w": "trăm", "t": 25.875, "d": 0.19}, {"w": "triệu", "t": 26.065, "d": 0.065}, {"w": "nằm", "t": 26.13, "d": 0.345}, {"w": "chờ.", "t": 26.475, "d": 0.24}]}, {"text": "Một năm, khoản nợ ấy có thể ngốn khoảng sáu mươi triệu tiền lãi.", "start": 27.44, "end": 31.04, "words": [{"w": "Một", "t": 27.545, "d": 0.115}, {"w": "năm,", "t": 27.66, "d": 0.45}, {"w": "khoản", "t": 28.11, "d": 0.085}, {"w": "nợ", "t": 28.195, "d": 0.385}, {"w": "ấy", "t": 28.58, "d": 0.215}, {"w": "có", "t": 28.795, "d": 0.18}, {"w": "thể", "t": 28.975, "d": 0.145}, {"w": "ngốn", "t": 29.12, "d": 0.295}, {"w": "khoảng", "t": 29.415, "d": 0.065}, {"w": "sáu", "t": 29.48, "d": 0.32}, {"w": "mươi", "t": 29.8, "d": 0.245}, {"w": "triệu", "t": 30.045, "d": 0.205}, {"w": "tiền", "t": 30.25, "d": 0.06}, {"w": "lãi.", "t": 30.31, "d": 0.395}]}, {"text": "Bài toán của mỗi người không giống nhau. Rất khác nhau.", "start": 31.36, "end": 34.32, "words": [{"w": "Bài", "t": 31.415, "d": 0.22}, {"w": "toán", "t": 31.635, "d": 0.29}, {"w": "của", "t": 31.925, "d": 0.085}, {"w": "mỗi", "t": 32.01, "d": 0.225}, {"w": "người", "t": 32.235, "d": 0.185}, {"w": "không", "t": 32.42, "d": 0.225}, {"w": "giống", "t": 32.645, "d": 0.2}, {"w": "nhau.", "t": 32.845, "d": 0.36}, {"w": "Rất", "t": 33.205, "d": 0.15}, {"w": "khác", "t": 33.355, "d": 0.4}, {"w": "nhau.", "t": 33.755, "d": 0.25}]}, {"text": "Báo cáo của Bộ Lao động khi ấy cho thấy một điều đáng chú ý.", "start": 35.32, "end": 38.6, "words": [{"w": "Báo", "t": 35.415, "d": 0.155}, {"w": "cáo", "t": 35.57, "d": 0.22}, {"w": "của", "t": 35.79, "d": 0.135}, {"w": "Bộ", "t": 35.925, "d": 0.145}, {"w": "Lao", "t": 36.07, "d": 0.305}, {"w": "động", "t": 36.375, "d": 0.16}, {"w": "khi", "t": 36.535, "d": 0.105}, {"w": "ấy", "t": 36.64, "d": 0.23}, {"w": "cho", "t": 36.87, "d": 0.165}, {"w": "thấy", "t": 37.035, "d": 0.23}, {"w": "một", "t": 37.265, "d": 0.12}, {"w": "điều", "t": 37.385, "d": 0.225}, {"w": "đáng", "t": 37.61, "d": 0.19}, {"w": "chú", "t": 37.8, "d": 0.07}, {"w": "ý.", "t": 37.87, "d": 0.32}]}, {"text": "Phần lớn người nhận một lần trong giai đoạn ấy ở độ tuổi từ hai mươi tới bốn mươi.", "start": 38.92, "end": 43.32, "words": [{"w": "Phần", "t": 38.995, "d": 0.285}, {"w": "lớn", "t": 39.28, "d": 0.06}, {"w": "người", "t": 39.34, "d": 0.3}, {"w": "nhận", "t": 39.64, "d": 0.235}, {"w": "một", "t": 39.875, "d": 0.205}, {"w": "lần", "t": 40.08, "d": 0.06}, {"w": "trong", "t": 40.14, "d": 0.19}, {"w": "giai", "t": 40.33, "d": 0.295}, {"w": "đoạn", "t": 40.625, "d": 0.255}, {"w": "ấy", "t": 40.88, "d": 0.18}, {"w": "ở", "t": 41.06, "d": 0.06}, {"w": "độ", "t": 41.12, "d": 0.36}, {"w": "tuổi", "t": 41.48, "d": 0.06}, {"w": "từ", "t": 41.54, "d": 0.265}, {"w": "hai", "t": 41.805, "d": 0.18}, {"w": "mươi", "t": 41.985, "d": 0.295}, {"w": "tới", "t": 42.28, "d": 0.195}, {"w": "bốn", "t": 42.475, "d": 0.06}, {"w": "mươi.", "t": 42.535, "d": 0.385}]}, {"text": "Hai phần ba đóng chưa tới năm năm.", "start": 43.64, "end": 45.72, "words": [{"w": "Hai", "t": 43.725, "d": 0.155}, {"w": "phần", "t": 43.88, "d": 0.205}, {"w": "ba", "t": 44.085, "d": 0.25}, {"w": "đóng", "t": 44.335, "d": 0.21}, {"w": "chưa", "t": 44.545, "d": 0.185}, {"w": "tới", "t": 44.73, "d": 0.06}, {"w": "năm", "t": 44.79, "d": 0.17}, {"w": "năm.", "t": 44.96, "d": 0.365}]}, {"text": "Và khoảng một triệu ba trăm nghìn người, sau khi rút, đã quay lại đóng bảo hiểm xã hội.", "start": 46.72, "end": 51.12, "words": [{"w": "Và", "t": 46.77, "d": 0.215}, {"w": "khoảng", "t": 46.985, "d": 0.14}, {"w": "một", "t": 47.125, "d": 0.19}, {"w": "triệu", "t": 47.315, "d": 0.17}, {"w": "ba", "t": 47.485, "d": 0.2}, {"w": "trăm", "t": 47.685, "d": 0.3}, {"w": "nghìn", "t": 47.985, "d": 0.06}, {"w": "người,", "t": 48.045, "d": 0.405}, {"w": "sau", "t": 48.45, "d": 0.075}, {"w": "khi", "t": 48.525, "d": 0.24}, {"w": "rút,", "t": 48.765, "d": 0.43}, {"w": "đã", "t": 49.195, "d": 0.06}, {"w": "quay", "t": 49.255, "d": 0.215}, {"w": "lại", "t": 49.47, "d": 0.3}, {"w": "đóng", "t": 49.77, "d": 0.06}, {"w": "bảo", "t": 49.83, "d": 0.195}, {"w": "hiểm", "t": 50.025, "d": 0.2}, {"w": "xã", "t": 50.225, "d": 0.28}, {"w": "hội.", "t": 50.505, "d": 0.265}]}, {"text": "Họ quay lại với đồng hồ năm đóng bắt đầu từ số không.", "start": 51.44, "end": 54.4, "words": [{"w": "Họ", "t": 51.505, "d": 0.15}, {"w": "quay", "t": 51.655, "d": 0.285}, {"w": "lại", "t": 51.94, "d": 0.1}, {"w": "với", "t": 52.04, "d": 0.125}, {"w": "đồng", "t": 52.165, "d": 0.175}, {"w": "hồ", "t": 52.34, "d": 0.195}, {"w": "năm", "t": 52.535, "d": 0.265}, {"w": "đóng", "t": 52.8, "d": 0.205}, {"w": "bắt", "t": 53.005, "d": 0.135}, {"w": "đầu", "t": 53.14, "d": 0.28}, {"w": "từ", "t": 53.42, "d": 0.155}, {"w": "số", "t": 53.575, "d": 0.2}, {"w": "không.", "t": 53.775, "d": 0.235}]}, {"text": "Với người hai mươi lăm tuổi, đồng hồ về số không vẫn còn kịp đếm lại.", "start": 55.4, "end": 59.08, "words": [{"w": "Với", "t": 55.495, "d": 0.115}, {"w": "người", "t": 55.61, "d": 0.22}, {"w": "hai", "t": 55.83, "d": 0.245}, {"w": "mươi", "t": 56.075, "d": 0.22}, {"w": "lăm", "t": 56.295, "d": 0.22}, {"w": "tuổi,", "t": 56.515, "d": 0.15}, {"w": "đồng", "t": 56.665, "d": 0.285}, {"w": "hồ", "t": 56.95, "d": 0.24}, {"w": "về", "t": 57.19, "d": 0.19}, {"w": "số", "t": 57.38, "d": 0.17}, {"w": "không", "t": 57.55, "d": 0.06}, {"w": "vẫn", "t": 57.61, "d": 0.335}, {"w": "còn", "t": 57.945, "d": 0.06}, {"w": "kịp", "t": 58.005, "d": 0.185}, {"w": "đếm", "t": 58.19, "d": 0.155}, {"w": "lại.", "t": 58.345, "d": 0.39}]}, {"text": "Với người bốn mươi lăm tuổi, đếm lại mười lăm năm là chuyện khác hẳn.", "start": 59.4, "end": 62.92, "words": [{"w": "Với", "t": 59.5, "d": 0.25}, {"w": "người", "t": 59.75, "d": 0.155}, {"w": "bốn", "t": 59.905, "d": 0.13}, {"w": "mươi", "t": 60.035, "d": 0.235}, {"w": "lăm", "t": 60.27, "d": 0.13}, {"w": "tuổi,", "t": 60.4, "d": 0.41}, {"w": "đếm", "t": 60.81, "d": 0.06}, {"w": "lại", "t": 60.87, "d": 0.33}, {"w": "mười", "t": 61.2, "d": 0.06}, {"w": "lăm", "t": 61.26, "d": 0.275}, {"w": "năm", "t": 61.535, "d": 0.2}, {"w": "là", "t": 61.735, "d": 0.22}, {"w": "chuyện", "t": 61.955, "d": 0.185}, {"w": "khác", "t": 62.14, "d": 0.06}, {"w": "hẳn.", "t": 62.2, "d": 0.355}]}, {"text": "Nếu chờ tới sáu mươi mà vẫn chưa đủ mười lăm năm thì sao?", "start": 63.92, "end": 67.44, "ask": 1, "words": [{"w": "Nếu", "t": 64.03, "d": 0.23}, {"w": "chờ", "t": 64.26, "d": 0.29}, {"w": "tới", "t": 64.55, "d": 0.195}, {"w": "sáu", "t": 64.745, "d": 0.085}, {"w": "mươi", "t": 64.83, "d": 0.195}, {"w": "mà", "t": 65.025, "d": 0.35}, {"w": "vẫn", "t": 65.375, "d": 0.125}, {"w": "chưa", "t": 65.5, "d": 0.24}, {"w": "đủ", "t": 65.74, "d": 0.2}, {"w": "mười", "t": 65.94, "d": 0.215}, {"w": "lăm", "t": 66.155, "d": 0.175}, {"w": "năm", "t": 66.33, "d": 0.215}, {"w": "thì", "t": 66.545, "d": 0.355}, {"w": "sao?", "t": 66.9, "d": 0.26}]}, {"text": "Luật mới mở thêm vài lối.", "start": 68.04, "end": 69.72, "words": [{"w": "Luật", "t": 68.13, "d": 0.16}, {"w": "mới", "t": 68.29, "d": 0.23}, {"w": "mở", "t": 68.52, "d": 0.23}, {"w": "thêm", "t": 68.75, "d": 0.