def year_counter_issues(scenes) -> list[str]:
    """Counter cÃ³ sá»‘ 1000-2100 mÃ  khÃ´ng suffix pháº£i khai "year": true (nÄƒm, khÃ´ng cháº¥m nghÃ¬n) hoáº·c false (sá»‘ lÆ°á»£ng).

    26/10/2026: Short Turing Ä‘áº¿m 1950 -> 2000 hiá»‡n "1.996". KhÃ´ng Ä‘oÃ¡n báº±ng nhÃ£n nhÆ° vietneu-tts: "THÃ€NH VIÃŠN Bá»Š LOáº I
    Má»–I NÄ‚M" (yakuza, 2000) vÃ  "Máº¶T Náº  PHÃ’NG Äá»˜C" (shanghai, 1000) lÃ  sá»‘ lÆ°á»£ng. DÃ¹ng chung cho build.py (Short)."""
    out = []
    for i, s in enumerate(scenes or []):
        if s.get("type") != "counter" or "year" in s or str(s.get("suffix") or "").strip():
            continue
        nums = [n for n in (s.get("from", 0), s["to"]) if float(n).is_integer() and 1000 <= n <= 2100]
