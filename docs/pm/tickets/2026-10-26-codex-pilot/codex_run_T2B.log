motion/hf/assets/long\ck-b2-lai-kep\ch03\data.js:1:window.CASE = {"topic": "ck-b2-lai-kep", "ch": "ch03", "dur": 55.38, "seed": 12720, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 03", "t": "LỜI GIẢI CHO LAN VÀ MINH"}, "acc": ["lãi", "kép", "lan", "minh", "lạm", "phát", "ngược"], "lines": [{"text": "Giờ thì quay lại câu đố.", "start": 0.0, "end": 1.6, "words": [{"w": "Giờ", "t": 0.06, "d": 0.24}, {"w": "thì", "t": 0.3, "d": 0.175}, {"w": "quay", "t": 0.475, "d": 0.06}, {"w": "lại", "t": 0.535, "d": 0.345}, {"w": "câu", "t": 0.88, "d": 0.055}, {"w": "đố.", "t": 0.935, "d": 0.355}]}, {"text": "Lan nộp mười năm rồi dừng. Minh nộp hai mươi năm, số tiền gấp đôi.", "start": 2.4, "end": 6.4, "words": [{"w": "Lan", "t": 2.49, "d": 0.22}, {"w": "nộp", "t": 2.71, "d": 0.17}, {"w": "mười", "t": 2.88, "d": 0.255}, {"w": "năm", "t": 3.135, "d": 0.225}, {"w": "rồi", "t": 3.36, "d": 0.215}, {"w": "dừng.", "t": 3.575, "d": 0.34}, {"w": "Minh", "t": 3.915, "d": 0.12}, {"w": "nộp", "t": 4.035, "d": 0.29}, {"w": "hai", "t": 4.325, "d": 0.16}, {"w": "mươi", "t": 4.485, "d": 0.19}, {"w": "năm,", "t": 4.675, "d": 0.45}, {"w": "số", "t": 5.125, "d": 0.07}, {"w": "tiền", "t": 5.195, "d": 0.295}, {"w": "gấp", "t": 5.49, "d": 0.315}, {"w": "đôi.", "t": 5.805, "d": 0.25}]}, {"text": "Năm năm mươi lăm tuổi, Minh có khoảng một tỷ ba trăm tám mươi sáu triệu.", "start": 7.4, "end": 11.0, "words": [{"w": "Năm", "t": 7.455, "d": 0.11}, {"w": "năm", "t": 7.565, "d": 0.335}, {"w": "mươi", "t": 7.9, "d": 0.07}, {"w": "lăm", "t": 7.97, "d": 0.3}, {"w": "tuổi,", "t": 8.27, "d": 0.135}, {"w": "Minh", "t": 8.405, "d": 0.275}, {"w": "có", "t": 8.68, "d": 0.155}, {"w": "khoảng", "t": 8.835, "d": 0.195}, {"w": "một", "t": 9.03, "d": 0.22}, {"w": "tỷ", "t": 9.25, "d": 0.21}, {"w": "ba", "t": 9.46, "d": 0.205}, {"w": "trăm", "t": 9.665, "d": 0.19}, {"w": "tám", "t": 9.855, "d": 0.06}, {"w": "mươi", "t": 9.915, "d": 0.31}, {"w": "sáu", "t": 10.225, "d": 0.185}, {"w": "triệu.", "t": 10.41, "d": 0.22}]}, {"text": "Còn Lan?", "start": 11.32, "end": 12.12, "words": [{"w": "Còn", "t": 11.37, "d": 0.14}, {"w": "Lan?", "t": 11.51, "d": 0.255}]}, {"text": "Khoảng một tỷ sáu trăm hai mươi bảy triệu.", "start": 12.72, "end": 14.88, "words": [{"w": "Khoảng", "t": 12.825, "d": 0.13}, {"w": "một", "t": 12.955, "d": 0.245}, {"w": "tỷ", "t": 13.2, "d": 0.2}, {"w": "sáu", "t": 13.4, "d": 0.08}, {"w": "trăm", "t": 13.48, "d": 0.165}, {"w": "hai", "t": 13.645, "d": 0.19}, {"w": "mươi", "t": 13.835, "d": 0.28}, {"w": "bảy", "t": 14.115, "d": 0.2}, {"w": "triệu.", "t": 14.315, "d": 0.22}]}, {"text": "Người nộp ít hơn một nửa, lại có nhiều hơn hai trăm bốn mươi triệu.", "start": 15.88, "end": 19.48, "words": [{"w": "Người", "t": 15.97, "d": 0.275}, {"w": "nộp", "t": 16.245, "d": 0.08}, {"w": "ít", "t": 16.325, "d": 0.135}, {"w": "hơn", "t": 16.46, "d": 0.365}, {"w": "một", "t": 16.825, "d": 0.055}, {"w": "nửa,", "t": 16.88, "d": 0.425}, {"w": "lại", "t": 17.305, "d": 0.055}, {"w": "có", "t": 17.36, "d": 0.28}, {"w": "nhiều", "t": 17.64, "d": 0.15}, {"w": "hơn", "t": 17.79, "d": 0.225}, {"w": "hai", "t": 18.015, "d": 0.215}, {"w": "trăm", "t": 18.23, "d": 0.17}, {"w": "bốn", "t": 18.4, "d": 0.195}, {"w": "mươi", "t": 18.595, "d": 0.28}, {"w": "triệu.", "t": 18.875, "d": 0.23}]}, {"text": "Sao lại thế được?", "start": 19.8, "end": 20.92, "ask": 1, "words": [{"w": "Sao", "t": 19.95, "d": 0.125}, {"w": "lại", "t": 20.075, "d": 0.255}, {"w": "thế", "t": 20.33, "d": 0.06}, {"w": "được?", "t": 20.39, "d": 0.32}]}, {"text": "Vì khi Lan dừng nộp ở tuổi ba mươi lăm, cô đã có sẵn gần năm trăm triệu.", "start": 21.52, "end": 25.6, "words": [{"w": "Vì", "t": 21.62, "d": 0.205}, {"w": "khi", "t": 21.825, "d": 0.245}, {"w": "Lan", "t": 22.07, "d": 0.09}, {"w": "dừng", "t": 22.16, "d": 0.205}, {"w": "nộp", "t": 22.365, "d": 0.2}, {"w": "ở", "t": 22.565, "d": 0.185}, {"w": "tuổi", "t": 22.75, "d": 0.18}, {"w": "ba", "t": 22.93, "d": 0.165}, {"w": "mươi", "t": 23.095, "d": 0.285}, {"w": "lăm,", "t": 23.38, "d": 0.3}, {"w": "cô", "t": 23.68, "d": 0.06}, {"w": "đã", "t": 23.74, "d": 0.305}, {"w": "có", "t": 24.045, "d": 0.165}, {"w": "sẵn", "t": 24.21, "d": 0.06}, {"w": "gần", "t": 24.27, "d": 0.22}, {"w": "năm", "t": 24.49, "d": 0.3}, {"w": "trăm", "t": 24.79, "d": 0.08}, {"w": "triệu.", "t": 24.87, "d": 0.345}]}, {"text": "Và số tiền ấy có thêm hai mươi năm để lăn.", "start": 25.92, "end": 28.48, "words": [{"w": "Và", "t": 25.98, "d": 0.25}, {"w": "số", "t": 26.23, "d": 0.125}, {"w": "tiền", "t": 26.355, "d": 0.185}, {"w": "ấy", "t": 26.54, "d": 0.2}, {"w": "có", "t": 26.74, "d": 0.19}, {"w": "thêm", "t": 26.93, "d": 0.215}, {"w": "hai", "t": 27.145, "d": 0.06}, {"w": "mươi", "t": 27.205, "d": 0.27}, {"w": "năm", "t": 27.475, "d": 0.21}, {"w": "để", "t": 27.685, "d": 0.185}, {"w": "lăn.", "t": 27.87, "d": 0.215}]}, {"text": "Hai mươi năm ở mức sáu phần trăm, là hơn ba lần gấp.", "start": 28.8, "end": 31.84, "words": [{"w": "Hai", "t": 28.875, "d": 0.215}, {"w": "mươi", "t": 29.09, "d": 0.225}, {"w": "năm", "t": 29.315, "d": 0.115}, {"w": "ở", "t": 29.43, "d": 0.26}, {"w": "mức", "t": 29.69, "d": 0.175}, {"w": "sáu", "t": 29.865, "d": 0.17}, {"w": "phần", "t": 30.035, "d": 0.06}, {"w": "trăm,", "t": 30.095, "d": 0.375}, {"w": "là", "t": 30.47, "d": 0.26}, {"w": "hơn", "t": 30.73, "d": 0.18}, {"w": "ba", "t": 30.91, "d": 0.09}, {"w": "lần", "t": 31.0, "d": 0.27}, {"w": "gấp.", "t": 31.27, "d": 0.24}]}, {"text": "Còn Minh, những đồng tiền anh nộp ở năm cuối, mới chỉ kịp lăn có vài tháng.", "start": 32.84, "end": 37.32, "words": [{"w": "Còn", "t": 32.89, "d": 0.29}, {"w": "Minh,", "t": 33.18, "d": 0.295}, {"w": "những", "t": 33.475, "d": 0.1}, {"w": "đồng", "t": 33.575, "d": 0.405}, {"w": "tiền", "t": 33.98, "d": 0.06}, {"w": "anh", "t": 34.04, "d": 0.19}, {"w": "nộp", "t": 34.23, "d": 0.355}, {"w": "ở", "t": 34.585, "d": 0.19}, {"w": "năm", "t": 34.775, "d": 0.23}, {"w": "cuối,", "t": 35.005, "d": 0.38}, {"w": "mới", "t": 35.385, "d": 0.09}, {"w": "chỉ", "t": 35.475, "d": 0.31}, {"w": "kịp", "t": 35.785, "d": 0.28}, {"w": "lăn", "t": 36.065, "d": 0.225}, {"w": "có", "t": 36.29, "d": 0.07}, {"w": "vài", "t": 36.36, "d": 0.34}, {"w": "tháng.", "t": 36.7, "d": 0.285}]}, {"text": "Muốn đuổi kịp Lan, mỗi tháng Minh phải nộp khoảng ba triệu rưỡi, suốt hai mươi năm.", "start": 37.64, "end": 42.04, "words": [{"w": "Muốn", "t": 37.695, "d": 0.215}, {"w": "đuổi", "t": 37.91, "d": 0.2}, {"w": "kịp", "t": 38.11, "d": 0.175}, {"w": "Lan,", "t": 38.285, "d": 0.455}, {"w": "mỗi", "t": 38.74, "d": 0.06}, {"w": "tháng", "t": 38.8, "d": 0.27}, {"w": "Minh", "t": 39.07, "d": 0.33}, {"w": "phải", "t": 39.4, "d": 0.11}, {"w": "nộp", "t": 39.51, "d": 0.315}, {"w": "khoảng", "t": 39.825, "d": 0.06}, {"w": "ba", "t": 39.885, "d": 0.38}, {"w": "triệu", "t": 40.265, "d": 0.075}, {"w": "rưỡi,", "t": 40.34, "d": 0.48}, {"w": "suốt", "t": 40.82, "d": 0.075}, {"w": "hai", "t": 40.895, "d": 0.34}, {"w": "mươi", "t": 41.235, "d": 0.06}, {"w": "năm.", "t": 41.295, "d": 0.42}]}, {"text": "Trong phép tính này, thứ quý nhất không phải số tiền.", "start": 43.04, "end": 45.84, "words": [{"w": "Trong", "t": 43.095, "d": 0.19}, {"w": "phép", "t": 43.285, "d": 0.205}, {"w": "tính", "t": 43.49, "d": 0.275}, {"w": "này,", "t": 43.765, "d": 0.295}, {"w": "thứ", "t": 44.06, "d": 0.06}, {"w": "quý", "t": 44.12, "d": 0.195}, {"w": "nhất", "t": 44.315, "d": 0.34}, {"w": "không", "t": 44.655, "d": 0.06}, {"w": "phải", "t": 44.715, "d": 0.195}, {"w": "số", "t": 44.91, "d": 0.375}, {"w": "tiền.", "t": 45.285, "d": 0.235}]}, {"text": "Mà là mười năm đi trước.", "start": 46.16, "end": 47.6, "words": [{"w": "Mà", "t": 46.215, "d": 0.225}, {"w": "là", "t": 46.44, "d": 0.08}, {"w": "mười", "t": 46.52, "d": 0.19}, {"w": "năm", "t": 46.71, "d": 0.135}, {"w": "đi", "t": 46.845, "d": 0.235}, {"w": "trước.", "t": 47.08, "d": 0.19}]}, 