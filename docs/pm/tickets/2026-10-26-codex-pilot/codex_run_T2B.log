": [{"w": "Lấy", "t": 35.815, "d": 0.185}, {"w": "phần", "t": 36.0, "d": 0.225}, {"w": "trả", "t": 36.225, "d": 0.23}, {"w": "thêm,", "t": 36.455, "d": 0.41}, {"w": "chia", "t": 36.865, "d": 0.06}, {"w": "cho", "t": 36.925, "d": 0.245}, {"w": "số", "t": 37.17, "d": 0.205}, {"w": "tiền", "t": 37.375, "d": 0.21}, {"w": "thật", "t": 37.585, "d": 0.2}, {"w": "sự", "t": 37.785, "d": 0.215}, {"w": "vay.", "t": 38.0, "d": 0.36}]}, {"text": "Hai triệu một chia cho mười tám triệu rưỡi, ra khoảng mười một phần trăm.", "start": 39.04, "end": 42.8, "words": [{"w": "Hai", "t": 39.13, "d": 0.115}, {"w": "triệu", "t": 39.245, "d": 0.34}, {"w": "một", "t": 39.585, "d": 0.24}, {"w": "chia", "t": 39.825, "d": 0.055}, {"w": "cho", "t": 39.88, "d": 0.34}, {"w": "mười", "t": 40.22, "d": 0.225}, {"w": "tám", "t": 40.445, "d": 0.07}, {"w": "triệu", "t": 40.515, "d": 0.17}, {"w": "rưỡi,", "t": 40.685, "d": 0.41}, {"w": "ra", "t": 41.095, "d": 0.115}, {"w": "khoảng", "t": 41.21, "d": 0.245}, {"w": "mười", "t": 41.455, "d": 0.185}, {"w": "một", "t": 41.64, "d": 0.36}, {"w": "phần", "t": 42.0, "d": 0.06}, {"w": "trăm.", "t": 42.06, "d": 0.39}]}, {"text": "Rồi nhân gần gấp đôi.", "start": 43.12, "end": 44.56, "words": [{"w": "Rồi", "t": 43.23, "d": 0.245}, {"w": "nhân", "t": 43.475, "d": 0.135}, {"w": "gần", "t": 43.61, "d": 0.225}, {"w": "gấp", "t": 43.835, "d": 0.15}, {"w": "đôi.", "t": 43.985, "d": 0.24}]}, {"text": "Vì sao lại nhân đôi?", "start": 44.88, "end": 46.32, "words": [{"w": "Vì", "t": 44.94, "d": 0.255}, {"w": "sao", "t": 45.195, "d": 0.145}, {"w": "lại", "t": 45.34, "d": 0.15}, {"w": "nhân", "t": 45.49, "d": 0.245}, {"w": "đôi?", "t": 45.735, "d": 0.215}]}, {"text": "Vì bạn trả dần mỗi tháng, nên tính trung bình cả năm, bạn chỉ nợ khoảng một nửa số tiền ấy.", "start": 46.92, "end": 51.96, "words": [{"w": "Vì", "t": 46.975, "d": 0.255}, {"w": "bạn", "t": 47.23, "d": 0.08}, {"w": "trả", "t": 47.31, "d": 0.23}, {"w": "dần", "t": 47.54, "d": 0.335}, {"w": "mỗi", "t": 47.875, "d": 0.06}, {"w": "tháng,", "t": 47.935, "d": 0.375}, {"w": "nên", "t": 48.31, "d": 0.12}, {"w": "tính", "t": 48.43, "d": 0.255}, {"w": "trung", "t": 48.685, "d": 0.18}, {"w": "bình", "t": 48.865, "d": 0.355}, {"w": "cả", "t": 49.22, "d": 0.125}, {"w": "năm,", "t": 49.345, "d": 0.4}, {"w": "bạn", "t": 49.745, "d": 0.06}, {"w": "chỉ", "t": 49.805, "d": 0.195}, {"w": "nợ", "t": 50.0, "d": 0.365}, {"w": "khoảng", "t": 50.365, "d": 0.09}, {"w": "một", "t": 50.455, "d": 0.31}, {"w": "nửa", "t": 50.765, "d": 0.215}, {"w": "số", "t": 50.98, "d": 0.115}, {"w": "tiền", "t": 51.095, "d": 0.145}, {"w": "ấy.", "t": 51.24, "d": 0.39}]}, {"text": "Mười một nhân gần hai, ra khoảng hai mươi.", "start": 52.28, "end": 54.84, "words": [{"w": "Mười", "t": 52.33, "d": 0.3}, {"w": "một", "t": 52.63, "d": 0.06}, {"w": "nhân", "t": 52.69, "d": 0.23}, {"w": "gần", "t": 52.92, "d": 0.225}, {"w": "hai,", "t": 53.145, "d": 0.4}, {"w": "ra", "t": 53.545, "d": 0.09}, {"w": "khoảng", "t": 53.635, "d": 0.255}, {"w": "hai", "t": 53.89, "d": 0.245}, {"w": "mươi.", "t": 54.135, "d": 0.36}]}, {"text": "Giờ thử gỡ từng thứ ra.", "start": 55.84, "end": 57.36, "words": [{"w": "Giờ", "t": 55.91, "d": 0.18}, {"w": "thử", "t": 56.09, "d": 0.19}, {"w": "gỡ", "t": 56.28, "d": 0.215}, {"w": "từng", "t": 56.495, "d": 0.175}, {"w": "thứ", "t": 56.67, "d": 0.175}, {"w": "ra.", "t": 56.845, "d": 0.205}]}, {"text": "Nếu không có phí, chỉ mất khoản giảm giá, con số là khoảng mười lăm phần trăm.", "start": 57.68, "end": 62.08, "words": [{"w": "Nếu", "t": 57.79, "d": 0.205}, {"w": "không", "t": 57.995, "d": 0.185}, {"w": "có", "t": 58.18, "d": 0.205}, {"w": "phí,", "t": 58.385, "d": 0.42}, {"w": "chỉ", "t": 58.805, "d": 0.06}, {"w": "mất", "t": 58.865, "d": 0.335}, {"w": "khoản", "t": 59.2, "d": 0.085}, {"w": "giảm", "t": 59.285, "d": 0.245}, {"w": "giá,", "t": 59.53, "d": 0.48}, {"w": "con", "t": 60.01, "d": 0.12}, {"w": "số", "t": 60.13, "d": 0.3}, {"w": "là", "t": 60.43, "d": 0.175}, {"w": "khoảng", "t": 60.605, "d": 0.14}, {"w": "mười", "t": 60.745, "d": 0.145}, {"w": "lăm", "t": 60.89, "d": 0.34}, {"w": "phần", "t": 61.23, "d": 0.105}, {"w": "trăm.", "t": 61.335, "d": 0.39}]}, {"text": "Nếu vẫn được giảm giá, chỉ chịu phí, nó còn khoảng năm phần trăm rưỡi.", "start": 62.4, "end": 66.48, "words": [{"w": "Nếu", "t": 62.465, "d": 0.195}, {"w": "vẫn", "t": 62.66, "d": 0.26}, {"w": "được", "t": 62.92, "d": 0.3}, {"w": "giảm", "t": 63.22, "d": 0.22}, {"w": "giá,", "t": 63.44, "d": 0.225}, {"w": "chỉ", "t": 63.665, "d": 0.275}, {"w": "chịu", "t": 63.94, "d": 0.24}, {"w": "phí,", "t": 64.18, "d": 0.405}, {"w": "nó", "t": 64.585, "d": 0.055}, {"w": "còn", "t": 64.64, "d": 0.27}, {"w": "khoảng", "t": 64.91, "d": 0.23}, {"w": "năm", "t": 65.14, "d": 0.165}, {"w": "phần", "t": 65.305, "d": 0.225}, {"w": "trăm", "t": 65.53, "d": 0.185}, {"w": "rưỡi.", "t": 65.715, "d": 0.455}]}, {"text": "Còn nếu không mất giảm giá và cũng không có phí?", "start": 66.8, "end": 69.36, "words": [{"w": "Còn", "t": 66.89, "d": 0.22}, {"w": "nếu", "t": 67.11, "d": 0.1}, {"w": "không", "t": 67.21, "d": 0.31}, {"w": "mất", "t": 67.52, "d": 0.06}, {"w": "giảm", "t": 67.58, "d": 0.315}, {"w": "giá", "t": 67.895, "d": 0.185}, {"w": "và", "t": 68.08, "d": 0.185}, {"w": "cũng", "t": 68.265, "d": 0.18}, {"w": "không", "t": 68.445, "d": 0.18}, {"w": "có", "t": 68.625, "d": 0.175}, {"w": "phí?", "t": 68.8, "d": 0.24}]}, {"text": "Khi ấy, không phần trăm đúng là không phần trăm.", "start": 69.96, "end": 72.68, "words": [{"w": "Khi", "t": 70.075, "d": 0.11}, {"w": "ấy,", "t": 70.185, "d": 0.375}, {"w": "không", "t": 70.56, "d": 0.32}, {"w": "phần", "t": 70.88, "d": 0.185}, {"w": "trăm", "t": 71.065, "d": 0.215}, {"w": "đúng", "t": 71.28, "d": 0.125}, {"w": "là", "t": 71.405, "d": 0.275}, {"w": "không", "t": 71.68, "d": 0.06}, {"w": "phần", "t": 71.74, "d": 0.19}, {"w": "trăm.", "t": 71.93, "d": 0.38}]}, {"text": "Trường hợp ấy có thật, và không hiếm.", "start": 73.68, "end": 76.0, "words": [{"w": "Trường", "t": 73.755, "d": 0.295}, {"w": "hợp", "t": 74.05, "d": 0.065}, {"w": "ấy", "t": 74.115, "d": 0.245}, {"w": "có", "t": 74.36, "d": 0.185}, {"w": "thật,", "t": 74.545, "d": 0.32}, {"w": "và", "t": 74.865, "d": 0.34}, {"w": "không", "t": 75.205, "d": 0.065}, {"w": "hiếm.", "t": 75.27, "d": 0.39}]}, {"text": "Lúc đó, trả góp còn có lợi: tiền của bạn vẫn nằm trong tài khoản và sinh lãi thêm vài tháng.", "start": 76.32, "end": 81.44, "words": [{"w": "Lúc", "t": 76.385, "d": 0.125}, {"w": "đó,", "t": 76.51, "d": 0.435}, {"w": "trả", "t": 76.945, "d": 0.09}, {"w": "góp", "t": 77.035, "d": 0.38}, {"w": "còn", "t": 77.415, "d": 0.06}, {"w": "có", "t": 77.475, "d": 0.19}, {"w": "lợi:", "t": 77.665, "d": 0.43}, {"w": "tiền", "t": 78.095, "d": 0.165}, {"w": "của", "t": 78.26, "d": 0.27}, {"w": "bạn", "t": 78.53, "d": 0.24}, {"w": "vẫn", "t": 78.77, "d": 0.125}, {"w": "nằm", "t": 78.895, "d": 0.105}, {"w": "trong", "t": 79.0, "d": 0.255}, {"w": "tài", "t": 79.255, "d": 0.195}, {"w": "khoản", "t": 79.45, "d": 0.165}, {"w": "và", "t": 79.615, "d": 0.275}, {"w": "sinh", "t": 79.89, "d": 0.17}, {"w": "lãi", "t": 80.06, "d": 0.305}, {"w": "thêm", "t": 80.365, "d": 0.245}, {"w": "vài", "t": 80.61, "d": 0.185}, {"w": "tháng.", "t": 80.795, "d": 0.26}]}, {"text": "Nên con số không không phải lời nói dối. Nó chỉ chưa phải cả câu chuyện.", "start": 81.76, "end": 85.76, "words": [{"w": "Nên", "t": 81.825, "d": 0.215}, {"w": "con", "t": 82.04, "d": 0.25}, {"w": "số", "t": 82.29, "d": 0.195}, {"w": "không", "t": 82.485, "d": 0.205}, {"w": "không", "t": 82.69, "d": 0.18}, {"w": "phải", "t": 82.87, "d": 0.135}, {"w": "lời", "t": 83.005, "d": 0.265}, {"w": "nói", "t": 83.27, "d": 0.19}, {"w": "dối.", "t": 83.46, "d": 0.4}, {"w": "Nó", "t": 83.86, "d": 0.095}, {"w": "chỉ", "t": 83.955, "d": 0.24}, {"w": "chưa", "t": 84.195, "d": 0.215}, {"w": "phải", "t": 84.41, "d": 0.245}, {"w": "cả", "t": 84.655, "d": 0.2}, {"w": "câu", "t": 84.855, "d": 0.205}, {"w": "chuyện.", "t": 85.06, "d": 0.375}]}, {"text": "Và câu chuyện còn một chương mà tấm biển không bao giờ nhắc.", "start": 86.08, "end": 88.96, "words": [{"w": "Và", "t": 86.14, "d": 0.155}, {"w": "câu", "t": 86.295, "d": 0.155}, {"w": "chuyện", "t": 86.45, "d": 0.225}, {"w": "còn", "t": 86.675, "d": 0.13}, {"w": "một", "t": 86.805, "d": 0.19}, {"w": "chương", "t": 86.995, "d": 0.185}, {"w": "mà", "t": 87.18, "d": 0.245}, {"w": "tấm", "t": 87.425, "d": 0.18}, {"w": "biển", "t": 87.605, "d": 0.21}, {"w": "không", "t": 87.815, "d": 0.06}, {"w": "bao", "t": 87.875, "d": 0.295}, {"w": "giờ", "t": 88.17, "d": 0.065}, {"w": "nhắc.", "t": 88.235, "d": 0.325}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "4", "k": "CHƯƠNG BỐN", "title": "CON SỐ 0\nTƯƠNG ĐƯƠNG BAO NHIÊU?", "sub": "NHÌN NÓ NHƯ MỘT KHOẢN VAY", "vid": "v0", "illus": "VIDEO MINH HỌA", "titleAt": 0.075, "t0": 0.0, "t1": 2.96}, {"type": "myth", "mythLab": "TƯỞNG LÀ VAY", "myth": "20 TRIỆU", "truthLab": "THẬT SỰ VAY", "truth": "18,5 TRIỆU", "strikeAt": 3.995, "truthAt": 6.135, "t0": 2.96, "t1": 10.44}, {"type": "ledger", "title": "KHOẢN VAY NÀY", "srcnote": "VÍ DỤ GIẢ ĐỊNH · MÁY 20 TRIỆU, GIẢM 1,5 TRIỆU KHI TRẢ THẲNG, PHÍ 3%", "rows": [{"k": "NHẬN HÔM NAY", "v": "18,5 TRIỆU", "at": 10.49}, {"k": "TRẢ LẠI", "v": "20,6 TRIỆU · 12 THÁNG ĐỀU", "at": 11.105}], "total": {"k": "LÃI SUẤT?", "v": "…", "at": 13.72}, "t0": 10.44, "t1": 16.88}, {"type": "counter", "from": 0, "to": 20, "prefix": "≈ ", "suffix": "%", "until": 19.34, "label": "MỘT NĂM · LÃI SUẤT TƯƠNG ĐƯƠNG", "sub": {"text": "KÊNH TỰ TÍNH · VÍ DỤ GIẢ ĐỊNH · MÁY 20 TRIỆU, GIẢM 1,5 TRIỆU KHI TRẢ THẲNG, PHÍ 3%", "at": 21.8}, "t0": 16.88, "t1": 23.24, "at": 17.08}, {"type": "kinetic", "items": [{"text": "TẤM BIỂN KHÔNG SAI", "at": 23.94, "acc": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "621px", "fontSize": "104px"}}, "D": [{"kind": "bar", "style": {"top": "621px", "height": "239px"}, "at": 23.69}], "em": "KHÔNG"}, {"text": "lãi suất trong hợp đồng đúng là 0", "at": 26.44, "sm": true, "fx": "rise