 "t": 80.21, "d": 0.24}, {"w": "đa", "t": 80.45, "d": 0.185}, {"w": "bảy", "t": 80.635, "d": 0.16}, {"w": "phần", "t": 80.795, "d": 0.215}, {"w": "trăm", "t": 81.01, "d": 0.215}, {"w": "so", "t": 81.225, "d": 0.27}, {"w": "với", "t": 81.495, "d": 0.285}, {"w": "tham", "t": 81.78, "d": 0.185}, {"w": "chiếu,", "t": 81.965, "d": 0.425}, {"w": "gọi", "t": 82.39, "d": 0.06}, {"w": "là", "t": 82.45, "d": 0.18}, {"w": "giá", "t": 82.63, "d": 0.29}, {"w": "trần.", "t": 82.92, "d": 0.375}]}, {"text": "Và xuống tối đa bảy phần trăm, gọi là giá sàn.", "start": 84.0, "end": 87.04, "words": [{"w": "Và", "t": 84.06, "d": 0.265}, {"w": "xuống", "t": 84.325, "d": 0.2}, {"w": "tối", "t": 84.525, "d": 0.16}, {"w": "đa", "t": 84.685, "d": 0.16}, {"w": "bảy", "t": 84.845, "d": 0.275}, {"w": "phần", "t": 85.12, "d": 0.175}, {"w": "trăm,", "t": 85.295, "d": 0.38}, {"w": "gọi", "t": 85.675, "d": 0.12}, {"w": "là", "t": 85.795, "d": 0.4}, {"w": "giá", "t": 86.195, "d": 0.06}, {"w": "sàn.", "t": 86.255, "d": 0.405}]}, {"text": "Ví dụ, tham chiếu hai mươi nghìn đồng thì trần là hai mươi mốt nghìn bốn trăm, sàn là mười tám nghìn sáu trăm.", "start": 87.36, "end": 92.8, "words": [{"w": "Ví", "t": 87.415, "d": 0.22}, {"w": "dụ,", "t": 87.635, "d": 0.275}, {"w": "tham", "t": 87.91, "d": 0.26}, {"w": "chiếu", "t": 88.17, "d": 0.075}, {"w": "hai", "t": 88.245, "d": 0.175}, {"w": "mươi", "t": 88.42, "d": 0.245}, {"w": "nghìn", "t": 88.665, "d": 0.23}, {"w": "đồng", "t": 88.895, "d": 0.23}, {"w": "thì", "t": 89.125, "d": 0.16}, {"w": "trần", "t": 89.285, "d": 0.12}, {"w": "là", "t": 89.405, "d": 0.275}, {"w": "hai", "t": 89.68, "d": 0.12}, {"w": "mươi", "t": 89.8, "d": 0.3}, {"w": "mốt", "t": 90.1, "d": 0.23}, {"w": "nghìn", "t": 90.33, "d": 0.2}, {"w": "bốn", "t": 90.53, "d": 0.06}, {"w": "trăm,", "t": 90.59, "d": 0.385}, {"w": "sàn", "t": 90.975, "d": 0.155}, {"w": "là", "t": 91.13, "d": 0.26}, {"w": "mười", "t": 91.39, "d": 0.22}, {"w": "tám", "t": 91.61, "d": 0.125}, {"w": "nghìn", "t": 91.735, "d": 0.28}, {"w": "sáu", "t": 92.015, "d": 0.085}, {"w": "trăm.", "t": 92.1, "d": 0.36}]}, {"text": "Bảng giá thường tô giá trần màu tím, giá sàn màu xanh lơ, giá tham chiếu màu vàng.", "start": 93.12, "end": 97.68, "words": [{"w": "Bảng", "t": 93.18, "d": 0.23}, {"w": "giá", "t": 93.41, "d": 0.19}, {"w": "thường", "t": 93.6, "d": 0.205}, {"w": "tô", "t": 93.805, "d": 0.21}, {"w": "giá", "t": 94.015, "d": 0.155}, {"w": "trần", "t": 94.17, "d": 0.36}, {"w": "màu", "t": 94.53, "d": 0.06}, {"w": "tím,", "t": 94.59, "d": 0.38}, {"w": "giá", "t": 94.97, "d": 0.13}, {"w": "sàn", "t": 95.1, "d": 0.22}, {"w": "màu", "t": 95.32, "d": 0.38}, {"w": "xanh", "t": 95.7, "d": 0.06}, {"w": "lơ,", "t": 95.76, "d": 0.475}, {"w": "giá", "t": 96.235, "d": 0.06}, {"w": "tham", "t": 96.295, "d": 0.225}, {"w": "chiếu", "t": 96.52, "d": 0.195}, {"w": "màu", "t": 96.715, "d": 0.375}, {"w": "vàng.", "t": 97.09, "d": 0.25}]}, {"text": "Giữ hai chữ giá sàn trong đầu nhé. Lát nữa nó sẽ quay lại.", "start": 98.68, "end": 102.28, "words": [{"w": "Giữ", "t": 98.795, "d": 0.23}, {"w": "hai", "t": 99.025, "d": 0.165}, {"w": "chữ", "t": 99.19, "d": 0.245}, {"w": "giá", "t": 99.435, "d": 0.245}, {"w": "sàn", "t": 99.68, "d": 0.19}, {"w": "trong", "t": 99.87, "d": 0.185}, {"w": "đầu", "t": 100.055, "d": 0.175}, {"w": "nhé.", "t": 100.23, "d": 0.43}, {"w": "Lát", "t": 100.66, "d": 0.1}, {"w": "nữa", "t": 100.76, "d": 0.23}, {"w": "nó", "t": 100.99, "d": 0.16}, {"w": "sẽ", "t": 101.15, "d": 0.34}, {"w": "quay", "t": 101.49, "d": 0.13}, {"w": "lại.", "t": 101.62, "d": 0.32}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "1", "k": "CHƯƠNG MỘT", "title": "TRƯỚC CHÍN GIỜ:\nMỘT LỆNH GỒM NHỮNG GÌ", "sub": "LỆNH · LÔ · BƯỚC GIÁ · KHUNG GIÁ", "vid": "v0", "illus": "VIDEO MINH HỌA", "titleAt": 0.085, "t0": 0.0, "t1": 6.48}, {"type": "kinetic", "items": [{"text": "ỨNG DỤNG", "at": 6.54, "fx": "sync", "wt": [7.47, 7.685], "t0": 6.48}, {"text": "→ CÔNG TY CHỨNG KHOÁN", "at": 7.945, "fx": "sync", "wt