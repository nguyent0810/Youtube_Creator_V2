motion/hf/assets/long\mim-siri-susan-bennett\ch05\data.js:1:window.CASE = {"topic": "mim-siri-susan-bennett", "ch": "ch05", "dur": 84.94, "seed": 33088, "accent": "#f472b6", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 05", "t": "TUA XUÔI: TỪ 2007 TỚI 2013"}, "acc": ["giọng", "mảnh", "băng", "ghép", "người", "nấc", "cắt", "thật"], "lines": [{"text": "Kim chạy xuôi, qua 2007.", "start": 0.0, "end": 2.24, "words": [{"w": "Kim", "t": 0.0, "d": 0.195}, {"w": "chạy", "t": 0.195, "d": 0.175}, {"w": "xuôi,", "t": 0.37, "d": 0.365}, {"w": "qua", "t": 0.735, "d": 0.175}, {"w": "2007.", "t": 0.91, "d": 1.15}]}, {"text": "Theo SRI, công ty Siri gọi được hai mươi bốn triệu đô la qua hai vòng vốn.", "start": 3.04, "end": 6.88, "words": [{"w": "Theo", "t": 3.04, "d": 0.285}, {"w": "SRI,", "t": 3.325, "d": 0.32}, {"w": "công", "t": 3.645, "d": 0.18}, {"w": "ty", "t": 3.825, "d": 0.17}, {"w": "Siri", "t": 3.995, "d": 0.075}, {"w": "gọi", "t": 4.07, "d": 0.235}, {"w": "được", "t": 4.305, "d": 0.28}, {"w": "hai", "t": 4.585, "d": 0.255}, {"w": "mươi", "t": 4.84, "d": 0.16}, {"w": "bốn", "t": 5.0, "d": 0.07}, {"w": "triệu", "t": 5.07, "d": 0.235}, {"w": "đô", "t": 5.305, "d": 0.18}, {"w": "la", "t": 5.485, "d": 0.26}, {"w": "qua", "t": 5.745, "d": 0.295}, {"w": "hai", "t": 6.04, "d": 0.195}, {"w": "vòng", "t": 6.235, "d": 0.135}, {"w": "vốn.", "t": 6.37, "d": 0.31}]}, {"text": "Ngày 4 tháng 2 năm 2010, theo trang TechCrunch, ứng dụng Siri lên kho ứng dụng của iPhone.", "start": 7.2, "end": 13.12, "words": [{"w": "Ngày", "t": 7.31, "d": 0.14}, {"w": "4", "t": 7.45, "d": 0.225}, {"w": "tháng", "t": 7.675, "d": 0.395}, {"w": "2", "t": 8.07, "d": 0.1}, {"w": "năm", "t": 8.17, "d": 0.35}, {"w": "2010,", "t": 8.52, "d": 1.325}, {"w": "theo", "t": 9.845, "d": 0.175}, {"w": "trang", "t": 10.02, "d": 0.33}, {"w": "TechCrunch,", "t": 10.35, "d": 0.24}, {"w": "ứng", "t": 10.59, "d": 0.29}, {"w": "dụng", "t": 10.88, "d": 0.165}, {"w": "Siri", "t": 11.045, "d": 0.28}, {"w": "lên", "t": 11.325, "d": 0.185}, {"w": "kho", "t": 11.51, "d": 0.295}, {"w": "ứng", "t": 11.805, "d": 0.205}, {"w": "dụng", "t": 12.01, "d": 0.325}, {"w": "của", "t": 12.335, "d": 0.105}, {"w": "iPhone.", "t": 12.44, "d": 0.425}]}, {"text": "Bạn nói vào máy: tìm một nhà hàng Pháp gần đây, đặt bàn, gọi taxi.", "start": 13.44, "end": 17.04, "words": [{"w": "Bạn", "t": 13.48, "d": 0.255}, {"w": "nói", "t": 13.735, "d": 0.12}, {"w": "vào", "t": 13.855, "d": 0.29}, {"w": "máy:", "t": 14.145, "d": 0.27}, {"w": "tìm", "t": 14.415, "d": 0.135}, {"w": "một", "t": 14.55, "d": 0.19}, {"w": "nhà", "t": 14.74, "d": 0.15}, {"w": "hàng", "t": 14.89, "d": 0.17}, {"w": "Pháp", "t": 15.06, "d": 0.365}, {"w": "gần", "t": 15.425, "d": 0.145}, {"w": "đây,", "t": 15.57, "d": 0.255}, {"w": "đặt", "t": 15.825, "d": 0.3}, {"w": "bàn,", "t": 16.125, "d": 0.145}, {"w": "gọi", "t": 16.27, "d": 0.22}, {"w": "taxi.", "t": 16.49, "d": 0.37}]}, {"text": "Chưa đầy ba tháng sau, Apple mua lại công ty.", "start": 17.36, "end": 19.92, "words": [{"w": "Chưa", "t": 17.37, "d": 0.275}, {"w": "đầy", "t": 17.645, "d": 0.14}, {"w": "ba", "t": 17.785, "d": 0.225}, {"w": "tháng", "t": 18.01, "d": 0.295}, {"w": "sau,", "t": 18.305, "d": 0.225}, {"w": "Apple", "t": 18.53, "d": 0.29}, {"w": "mua", "t": 18.82, "d": 0.245}, {"w": "lại", "t": 19.065, "d": 0.055}, {"w": "công", "t": 19.12, "d": 0.295}, {"w": "ty.", "t": 19.415, "d": 0.325}]}, {"text": "Rồi đến buổi sáng ở Cupertino năm 2011.", "start": 20.24, "end": 24.0, "words": [{"w": "Rồi", "t": 20.405, "d": 0.215}, {"w": "đến", "t": 20.62, "d": 0.375}, {"w": "buổi", "t": 20.995, "d": 0.285}, {"w": "sáng", "t": 21.28, "d": 0.165}, {"w": "ở", "t": 21.445, "d": 0.18}, {"w": "Cupertino", "t": 21.625, "d": 0.19}, {"w": "năm", "t": 21.815, "d": 0.415}, {"w": "2011.", "t": 22.23, "d": 1.625}]}, {"text": "Kim chỉ năm quay về đúng chỗ ta bắt đầu.", "start": 24.32, "end": 26.24, "words": [{"w": "Kim", "t": 24.32, "d": 0.175}, {"w": "chỉ", "t": 24.495, "d": 0.185}, {"w": "năm", "t": 24.68, "d": 0.185}, {"w": "quay", "t": 24.865, "d": 0.06}, {"w": "về", "t": 24.925, "d": 0.215}, {"w": "đúng", "t": 25.14, "d": 0.14}, {"w": "chỗ", "t": 25.28, "d": 0.19}, {"w": "ta", "t": 25.47, "d": 0.17}, {"w": "bắt", "t": 25.64, "d": 0.12}, {"w": "đầu.", "t": 25.76, "d": 0.265}]}, {"text": "Lúc ấy, bà Bennett còn chưa có chiếc điện thoại đó.", "start": 27.24, "end": 30.12, "words": [{"w": "Lúc", "t": 27.295, "d": 0.115}, {"w": "ấy,", "t": 27.41, "d": 0.53}, {"w": "bà", "t": 27.94, "d": 0.055}, {"w": "Bennett", "t": 27.995, "d": 0.19}, {"w": "còn", "t": 28.185, "d": 0.39}, {"w": "chưa", "t": 28.575, "d": 0.055}, {"w": "có", "t": 28.63, "d": 0.215}, {"w": "chiếc", "t": 28.845, "d": 0.2}, {"w": "điện", "t": 29.045, "d": 0.285}, {"w": "thoại", "t": 29.33, "d": 0.16}, {"w": "đó.", "t": 29.49, "d": 0.405}]}, {"text": "Con trai bà, Cameron, biết chuyện khi xem một quảng cáo iPhone 4S trên tivi.", "start": 30.44, "end": 35.24, "words": [{"w": "Con", "t": 30.48, "d": 0.14}, {"w": "trai", "t": 30.62, "d": 0.48}, {"w": "bà,", "t": 31.1, "d": 0.29}, {"w": "Cameron,", "t": 31.39, "d": 0.425}, {"w": "biết", "t": 31.815, "d": 0.325}, {"w": "chuyện", "t": 32.14, "d": 0.24}, {"w": "khi", "t": 32.38, "d": 0.28}, {"w": "xem", "t": 32.66, "d": 0.26}, {"w": "một", "t": 32.92, "d": 0.28}, {"w": "quảng", "t": 33.2, "d": 0.06}, {"w": "cáo", "t": 33.26, "d": 0.415}, {"w": "iPhone", "t": 33.675, "d": 0.26}, {"w": "4S", "t": 33.935, "d": 0.455}, {"w": "trên", "t": 34.39, "d": 0.215}, {"w": "tivi.", "t": 34.605, "d": 0.44}]}, {"text": "Theo CNN, khi anh mua máy, giọng mẹ cất lên từ phần chỉ đường, và anh hét lên.", "start": 35.56, "end": 39.88, "words": [{"w": "Theo", "t": 35.56, "d": 0.12}, {"w": "CNN,", "t": 35.68, "d": 0.49}, {"w": "khi", "t": 36.17, "d": 0.19}, {"w": "anh", "t": 36.36, "d": 0.115}, {"w": "mua", "t": 36.475, "d": 0.13}, {"w": "máy,", "t": 36.605, "d": 0.42}, {"w": "giọng", "t": 37.025, "d": 0.285}, {"w": "mẹ", "t": 37.31, "d": 0.205}, {"w": "cất", "t": 37.515, "d": 0.11}, {"w": "lên", "t": 37.625, "d": 0.215}, {"w": "từ", "t": 37.84, "d": 0.205}, {"w": "phần", "t": 38.045, "d": 0.105}, {"w": "chỉ", "t": 38.15, "d": 0.225}, {"w": "đường,", "t": 38.375, "d": 0.385}, {"w": "và", "t": 38.76, "d": 0.295}, {"w": "anh", "t": 39.055, "d": 0.07}, {"w": "hét", "t": 39.125, "d": 0.22}, {"w": "lên.", "t": 39.345, "d": 0.36}]}, {"text": "Mẹ, thôi đi!", "start": 40.2, "end": 42.04, "words": [{"w": "Mẹ,", "t": 40.25, "d": 0.86}, {"w": "thôi", "t": 41.11, "d": 0.27}, {"w": "đi!", "t": 41.38, "d": 0.66}]}, {"text": "Còn bà, khi đổi máy và lần đầu nói chuyện với chính mình, bà kể bà hơi hoảng.", "start": 43.04, "end": 47.2, "words": [{"w": "Còn", "t": 43.09, "d": 0.1}, {"w": "bà,", "t": 43.19, "d": 0.46}, {"w": "khi", "t": 43.65, "d": 0.095}, {"w": "đổi", "t": 43.745, "d": 0.18}, {"w": "máy", "t": 43.925, "d": 0.18}, {"w": "và", "t": 44.105, "d": 0.275}, {"w": "lần", "t": 44.38, "d": 0.205}, {"w": "đầu", "t": 44.585, "d": 0.08}, {"w": "nói", "t": 44.665, "d": 0.205}, {"w": "chuyện", "t": 44.87, "d": 0.14}, {"w": "với", "t": 45.01, "d": 0.31}, {"w": "chính", "t": 45.32, "d": 0.1}, {"w": "mình,", "t": 45.42, "d": 0.4}, {"w": "bà", "t": 45.82, "d": 0.06}, {"w": "kể", "t": 45.88, "d": 0.225}, {"w": "bà", "t": 46.105, "d": 0.185}, {"w": "hơi", "t": 46.29, "d": 0.16}, {"w": "hoảng.", "t": 46.45, "d": 0.34}]}, {"text": "Kỳ quặc, nói nhẹ là vậy.", "start": 47.52, "end": 49.12, "words": [{"w": "Kỳ", "t": 47.52, "d": 0.28}, {"w": "quặc,", "t": 47.8, "d": 0.28}, {"w": "nói", "t": 48.08, "d": 0.075}, {"w": "nhẹ", "t": 48.155, "d": 0.235}, {"w": "là", "t": 48.39, "d": 0.3}, {"w": "vậy.", "t": 48.69, "d": 0.255}]}, {"text": "Nhưng bà cũng choáng ngợp vì được góp phần vào một kỳ công công nghệ.", "start": 49.44, "end": 52.56, "words": [{"w": "Nhưng", "t": 49.44, "d": 0.265}, {"w": "bà", "t": 49.705, "d": 0.15}, {"w": "cũng", "t": 49.855, "d": 0.19}, {"w": "choáng", "t": 50.045, "d": 0.22}, {"w": "ngợp", "t": 50.265, "d": 0.19}, {"w": "vì", "t": 50.455, "d": 0.085}, {"w": "được", "t": 50.54, "d": 0.225}, {"w": "góp", "t": 50.765, "d": 0.135}, {"w": "phần", "t": 50.9, "d": 0.185}, {"w": "vào", "t": 51.085, "d": 0.255}, {"w": "một", "t": 51.34, "d": 0.185}, {"w": "kỳ", "t": 51.525, "d": 0.145}, {"w": "công", "t": 51.67, "d": 0.175}, {"w": "công", "t": 51.845, "d": 0.16}, {"w": "nghệ.", "t": 52.005, "d": 0.355}]}, {"text": "Bà kể với CNN, bà chưa bao giờ quát Siri.", "start": 53.56, "end": 56.12, "words": [{"w": "Bà", "t": 53.56, "d": 0.28}, {"w": "kể", "t": 53.84, "d": 0.18}, {"w": "với", "t": 54.02, "d": 0.175}, {"w": "CNN,", "t": 54.195, "d": 0.42}, {"w": "bà", "t": 54.615, "d": 0.13}, {"w": "chưa", "t": 54.745, "d": 0.225}, {"w": "bao", "t": 54.97, "d": 0.28}, {"w": "giờ", "t": 55.25, "d": 0.195}, {"w": "quát", "t": 55.445, "d": 0.125}, {"w": "Siri.", "t": 55.57, "d": 0.375}]}, {"text": "Nghiệp xấu lắm.", "start": 56.44, "end": 57.4, "words": [{"w": "Nghiệp", "t": 56.505, "d": 0.21}, {"w": "xấu", "t": 56.715, "d": 0.06}, {"w": "lắm.", "t": 56.775, "d": 0.335}]}, {"text": "Bà còn đùa rằng mình lo không biết mỗi ngày bị người ta chửi bao nhiêu lần.", "start": 57.72, "end": 61.0, "words": [{"w": "Bà", "t": 57.72, "d": 0.115}, {"w": "còn", "t": 57.835, "d": 0.155}, {"w": "đùa", "t": 57.99, "d": 0.205}, {"w": "rằng", "t": 58.195, "d": 0.3}, {"w": "mình", "t": 58.495, "d": 0.06}, {"w": "lo", "t": 58.555, "d": 0.165}, {"w": "không", "t": 58.72, "d": 0.3}, {"w": "biết", "t": 59.02, "d": 0.12}, {"w": "mỗi", "t": 59.14, "d": 0.08}, {"w": "ngày", "t": 59.22, "d": 0.175}, {"w": "bị", "t": 59.395, "d": 0.305}, {"w": "người", "t": 59.7, "d": 0.145}, {"w": "ta", "t": 59.845, "d": 0.18}, {"w": "chửi", "t": 60.025, "d": 0.225}, {"w": "bao", "t": 60.25, "d": 0.16}, {"w": "nhiêu", "t": 60.41, "d": 0.145}, {"w": "lần.", "t": 60.555, "d": 0.255}]}, {"text": "Rồi tháng 6 năm 2013, Apple giới thiệu iOS 7.", "start": 62.0, "end": 66.24, "words": [{"w": "Rồi", "t": 62.095, "d": 0.13}, {"w": "tháng", "t": 62.225, "d": 0.375}, {"w": "6", "t": 62.6, "d": 0.11}, {"w": "năm", "t": 62.71, "d": 0.28}, {"w": "2013,", "t": 62.99, "d": 1.75}, {"w": "Apple", "t": 64.74, "d": 0.17}, {"w": "giới", "t": 64.91, "d": 0.265}, {"w": "thiệu", "t": 65.175, "d": 0.24}, {"w": "iOS", "t": 65.415, "d": 0.315}, {"w": "7.", "t": 65.73, "d": 0.285}]}, {"text": "Thông cáo viết: Siri có giọng nam và giọng nữ mới.", "start": 66.56, "end": 69.44, "words": [{"w": "Thông", "t": 66.56, "d": 0.145}, {"w": "cáo", "t": 66.705, "d": 0.395}, {"w": "viết:", "t": 67.1, "d": 0.35}, {"w": "Siri", "t": 67.45, "d": 0.155}, {"w": "có", "t": 67.605, "d": 0.105}, {"w": "giọng", "t": 67.71, "d": 0.325}, {"w": "nam", "t": 68.035, "d": 0.16}, {"w": "và", "t": 68.195, "d": 0.38}, {"w": "giọng", "t": 68.575, "d": 0.155}, {"w": "nữ", "t": 68.73, "d": 0.105}, {"w": "mới.", "t": 68.835, "d": 0.45}]}, {"text": "CNN nhận xét, thời của bà trong vai Siri ở Mỹ đang dần khép lại.", "start": 69.76, "end": 73.28, "words": [{"w": "CNN", "t": 69.76, "d": 0.185}, {"w": "nhận", "t": 69.945, "d": 0.31}, {"w": "xét,", "t": 70.255, "d": 0.325}, {"w": "thời", "t": 70.58, "d": 0.205}, {"w": "của", "t": 70.785, "d": 0.06}, {"w": "bà", "t": 70.845, "d": 0.19}, {"w": "trong", "t": 71.035, "d": 0.295}, {"w": "vai", "t": 71.33, "d": 0.145}, {"w": "Siri", "t": 71.475, "d": 0.165}, {"w": "ở", "t": 71.64, "d": 0.325}, {"w": "Mỹ", "t": 71.965, "d": 0.2}, {"w": "đang", "t": 72.165, "d": 0.205}, {"w": "dần", "t": 72.37, "d": 0.18}, {"w": "khép", "t": 72.55, "d": 0.185}, {"w": "lại.", "t": 72.735, "d": 0.335}]}, {"text": "Bà thừa nhận hơi tiếc, nhưng trong nghề này, bà đã quen với chuyện công nghệ thay đổi.", "start": 73.6, "end": 77.92, "words": [{"w": "Bà", "t": 73.6, "d": 0.115}, {"w": "thừa", "t": 73.715, "d": 0.29}, {"w": "nhận", "t": 74.005, "d": 0.22}, {"w": "hơi", "t": 74.225, "d": 0.305}, {"w": "tiếc,", "t": 74.53, "d": 0.26}, {"w": "nhưng", "t": 74.79, "d": 0.13}, {"w": "trong", "t": 74.92, "d": 0.325}, {"w": "nghề", "t": 75.245, "d": 0.13}, {"w": "này,", "t": 75.375, "d": 0.45}, {"w": "bà", "t": 75.825, "d": 0.21}, {"w": "đã", "t": 76.035, "d": 0.065}, {"w": "quen", "t": 76.1, "d": 0.35}, {"w": "với", "t": 76.45, "d": 0.175}, {"w": "chuyện", "t": 76.625, "d": 0.195}, {"w": "công", "t": 76.82, "d": 0.21}, {"w": "nghệ", "t": 77.03, "d": 0.11}, {"w": "thay", "t": 77.14, "d": 0.205}, {"w": "đổi.", "t": 77.345, "d": 0.395}]}, {"text": "Vậy giọng mới được làm thế nào?", "start": 78.92, "end": 80.44, "words": [{"w": "Vậy", "t": 79.015, "d": 0.165}, {"w": "giọng", "t": 79.18, "d": 0.125}, {"w": "mới", "t": 79.305, "d": 0.225}, {"w": "được", "t": 79.53, "d": 0.12}, {"w": "làm", "t": 79.65, "d": 0.225}, {"w": "thế", "t": 79.875, "d": 0.1}, {"w": "nào?", "t": 79.975, "d": 0.25}]}, {"text": "Và vì sao về sau, nó nghe giống người hơn nữa?", "start": 81.04, "end": 83.44, "words": [{"w": "Và", "t": 81.075, "d": 0.11}, {"w": "vì", "t": 81.185, "d": 0.175}, {"w": "sao", "t": 81.36, "d": 0.27}, {"w": "về", "t": 81.63, "d": 0.225}, {"w": "sau,", "t": 81.855, "d": 0.285}, {"w": "nó", "t": 82.14, "d": 0.06}, {"w": "nghe", "t": 82.2, "d": 0.15}, {"w": "giống", "t": 82.35, "d": 0.24}, {"w": "người", "t": 82.59, "d": 0.175}, {"w": "hơn", "t": 82.765, "d": 0.225}, {"w": "nữa?", "t": 82.99, "d": 0.245}]}], "imgs": {"bennett": {"src": "assets/long/mim-siri-susan-bennett/img/bennett.jpg", "w": 1920, "h": 1280, "lic": "Public domain", "by": "Voice of America", "pd": true}, "bennettc": {"src": "assets/long/mim-siri-susan-bennett/img/bennettc.jpg", "w": 960, "h": 1281, "lic": "Public domain", "by": "Voice of America", "pd": true}, "jobs": {"src": "assets/long/mim-siri-susan-bennett/img/jobs.jpg", "w": 500, "h": 624, "lic": "CC BY 2.0", "by": "matt buchanan", "pd": false}, "atlanta": {"src": "assets/long/mim-siri-susan-bennett/img/atlanta.jpg", "w": 1920, "h": 840, "lic": "CC0", "by": "brandon walker", "pd": true}, "cassette": {"src": "assets/lo