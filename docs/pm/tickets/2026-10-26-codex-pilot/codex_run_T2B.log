motion/hf/assets/long\ck-d1-vang-dinh\ch04\data.js:1:window.CASE = {"topic": "ck-d1-vang-dinh", "ch": "ch04", "dur": 112.7, "seed": 16356, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 04", "t": "BA KHOẢN TRẢ THÊM"}, "acc": ["sjc", "vàng", "đỉnh", "lỗ", "lãi", "chênh", "fomo", "bẫy", "vía"], "lines": [{"text": "Giả sử bạn đã tới đầu hàng. Ngoài giá vàng, bạn còn trả ba thứ ít ai nhìn thấy.", "start": 0.0, "end": 4.72, "words": [{"w": "Giả", "t": 0.055, "d": 0.24}, {"w": "sử", "t": 0.295, "d": 0.08}, {"w": "bạn", "t": 0.375, "d": 0.29}, {"w": "đã", "t": 0.665, "d": 0.185}, {"w": "tới", "t": 0.85, "d": 0.315}, {"w": "đầu", "t": 1.165, "d": 0.06}, {"w": "hàng.", "t": 1.225, "d": 0.43}, {"w": "Ngoài", "t": 1.655, "d": 0.065}, {"w": "giá", "t": 1.72, "d": 0.245}, {"w": "vàng,", "t": 1.965, "d": 0.47}, {"w": "bạn", "t": 2.435, "d": 0.06}, {"w": "còn", "t": 2.495, "d": 0.215}, {"w": "trả", "t": 2.71, "d": 0.19}, {"w": "ba", "t": 2.9, "d": 0.235}, {"w": "thứ", "t": 3.135, "d": 0.2}, {"w": "ít", "t": 3.335, "d": 0.325}, {"w": "ai", "t": 3.66, "d": 0.06}, {"w": "nhìn", "t": 3.72, "d": 0.35}, {"w": "thấy.", "t": 4.07, "d": 0.245}]}, {"text": "Thứ nhất: chênh lệch giữa giá bán và giá mua.", "start": 5.52, "end": 8.08, "words": [{"w": "Thứ", "t": 5.605, "d": 0.265}, {"w": "nhất:", "t": 5.87, "d": 0.19}, {"w": "chênh", "t": 6.06, "d": 0.235}, {"w": "lệch", "t": 6.295, "d": 0.125}, {"w": "giữa", "t": 6.42, "d": 0.3}, {"w": "giá", "t": 6.72, "d": 0.14}, {"w": "bán", "t": 6.86, "d": 0.185}, {"w": "và", "t": 7.045, "d": 0.125}, {"w": "giá", "t": 7.17, "d": 0.165}, {"w": "mua.", "t": 7.335, "d": 0.36}]}, {"text": "Ngày hai mươi chín tháng một, tiệm bán ra một trăm chín mươi mốt triệu ba trăm nghìn, nhưng mua lại chỉ một trăm tám mươi tám triệu ba trăm nghìn.", "start": 8.4, "end": 15.04, "words": [{"w": "Ngày", "t": 8.465, "d