motion/hf/assets/long\ck-b3-tra-gop-0\ch03\data.js:1:window.CASE = {"topic": "ck-b3-tra-gop-0", "ch": "ch03", "dur": 58.42, "seed": 14875, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 03", "t": "CÁI GIÁ THỨ BA: CÁC LOẠI PHÍ"}, "acc": ["không", "phí", "giá", "lãi", "thẳng", "góp", "tổng"], "lines": [{"text": "Lãi suất là số không. Nhưng phí thì chưa chắc.", "start": 0.0, "end": 2.72, "words": [{"w": "Lãi", "t": 0.05, "d": 0.27}, {"w": "suất", "t": 0.32, "d": 0.125}, {"w": "là", "t": 0.445, "d": 0.295}, {"w": "số", "t": 0.74, "d": 0.135}, {"w": "không.", "t": 0.875, "d": 0.375}, {"w": "Nhưng", "t": 1.25, "d": 0.075}, {"w": "phí", "t": 1.325, "d": 0.295}, {"w": "thì", "t": 1.62, "d": 0.225}, {"w": "chưa", "t": 1.845, "d": 0.19}, {"w": "chắc.", "t": 2.035, "d": 0.34}]}, {"text": "Theo các bài hướng dẫn tài chính và báo chí, trả góp có thể đi kèm vài loại phí.", "start": 3.52, "end": 8.0, "words": [{"w": "Theo", "t": 3.59, "d": 0.135}, {"w": "các", "t": 3.725, "d": 0.345}, {"w": "bài", "t": 4.07, "d": 0.205}, {"w": "hướng", "t": 4.275, "d": 0.06}, {"w": "dẫn", "t": 4.335, "d": 0.205}, {"w": "tài", "t": 4.54, "d": 0.18}, {"w": "chính", "t": 4.72, "d": 0.305}, {"w": "và", "t": 5.025, "d": 0.12}, {"w": "báo", "t": 5.145, "d": 0.195}, {"w": "chí,", "t": 5.34, "d": 0.445}, {"w": "trả", "t": 5.785, "d": 0.06}, {"w": "góp", "t": 5.845, "d": 0.355}, {"w": "có", "t": 6.2, "d": 0.18}, {"w": "thể", "t": 6.38, "d": 0.185}, {"w": "đi", "t": 6.565, "d": 0.175}, {"w": "kèm", "t": 6.74, "d": 0.26}, {"w": "vài", "t": 7.0, "d": 0.075}, {"w": "loại", "t": 7.075, "d": 0.305}, {"w": "phí.", "t": 7.38, "d": 0.26}]}, {"text": "Phí chuyển đổi trả góp, nếu bạn dùng thẻ tín dụng.", "start": 8.32, "end": 11.2, "words": [{"w": "Phí", "t": 8.43, "d": 0.13}, {"w": "chuyển", "t": 8.56, "d": 0.335}, {"w": "đổi", "t": 8.895, "d": 0.075}, {"w": "trả", "t": 8.97, "d": 0.17}, {"w": "góp,", "t": 9.14, "d": 0.435}, {"w": "nếu", "t": 9.575, "d": 0.06}, {"w": "bạn", "t": 9.635, "d": 0.315}, {"w": "dùng", "t": 9.95, "d": 0.11}, {"w": "thẻ", "t": 10.06, "d": 0.17}, {"w": "tín", "t": 10.23, "d": 0.24}, {"w": "dụng.", "t": 10.47, "d": 0.325}]}, {"text": "Phí hồ sơ, hoặc phí bảo hiểm khoản vay, nếu qua công ty tài chính.", "start": 11.52, "end": 15.36, "words": [{"w": "Phí", "t": 11.63, "d": 0.275}, {"w": "hồ", "t": 11.905, "d": 0.06}, {"w": "sơ,", "t": 11.965, "d": 0.39}, {"w": "hoặc", "t": 12.355, "d": 0.26}, {"w": "phí", "t": 12.615, "d": 0.22}, {"w": "bảo", "t": 12.835, "d": 0.18}, {"w": "hiểm", "t": 13.015, "d": 0.235}, {"w": "khoản", "t": 13.25, "d": 0.205}, {"w": "vay,", "t": 13.455, "d": 0.325}, {"w": "nếu", "t": 13.78, "d": 0.06}, {"w": "qua", "t": 13.84, "d": 0.24}, {"w": "công", "t": 14.08, "d": 0.18}, {"w": "ty", "t": 14.26, "d": 0.185}, {"w": "tài", "t": 14.445, "d": 0.185}, {"w": "chính.", "t": 14.63, "d": 0.4}]}, {"text": "Và có nơi thu thêm phí thu hộ mỗi tháng.", "start": 15.68, "end": 18.0, "words": [{"w": "Và", "t": 15.735, "d": 0.19}, {"w": "có", "t": 15.925, "d": 0.14}, {"w": "nơi", "t": 16.065, "d": 0.23}, {"w": "thu", "t": 16.295, "d": 0.185}, {"w": "thêm", "t": 16.48, "d": 0.24}, {"w": "phí", "t": 16.72, "d": 0.205}, {"w": "thu", "t": 16.925, "d": 0.135}, {"w": "hộ", "t": 17.06, "d": 0.135}, {"w": "mỗi", "t": 17.195, "d": 0.245}, {"w": "tháng.", "t": 17.44, "d": 0.27}]}, {"text": "Không phải chương trình nào cũng có đủ các khoản ấy.", "start": 19.0, "end": 21.56, "words": [{"w": "Không", "t": 19.085, "d": 0.155}, {"w": "phải", "t": 19.24, "d": 0.18}, {"w": "chương", "t": 19.42, "d": 0.19}, {"w": "trình", "t": 19.61, "d": 0.2}, {"w": "nào", "t": 19.81, "d": 0.265}, {"w": "cũng", "t": 20.075, "d": 0.19}, {"w": "có", "t": 20.265, "d": 0.14}, {"w": "đủ", "t": 20.405, "d": 0.23}, {"w": "các", "t": 20.635, "d": 0.185}, {"w": "khoản", "t": 20.82, "d": 0.185}, {"w": "ấy.", "t": 21.005, "d": 0.22}]}, {"text": "Có chương trình miễn hết. Có chương trình thu một, hai loại.", "start": 21.88, "end": 25.0, "words": [{"w": "Có", "t": 21.925, "d": 0.14}, {"w": "chương", "t": 22.065, "d": 0.175}, {"w": "trình", "t": 22.24, "d": 0.365}, {"w": "miễn", "t": 22.605, "d": 0.2}, {"w": "hết.", "t": 22.805, "d": 0.17}, {"w": "Có", "t": 22.975, "d": 0.18}, {"w": "chương", "t": 23.155, "d": 0.36}, {"w": "trình", "t": 23.515, "d": 0.205}, {"w": "thu", "t": 23.72, "d": 0.06}, {"w": "một,", "t": 23.78, "d": 0.435}, {"w": "hai", "t": 24.215, "d": 0.06}, {"w": "loại.", "t": 24.275, "d": 0.4}]}, {"text": "Vì thế, câu cần hỏi không phải là lãi suất bao nhiêu.", "start": 25.32, "end": 28.28, "words": [{"w": "Vì", "t": 25.37, "d": 0.16}, {"w": "thế,", "t": 25.53, "d": 0.43}, {"w": "câu", "t": 25.96, "d": 0.065}, {"w": "cần", "t": 26.025, "d": 0.225}, {"w": "hỏi", "t": 26.25, "d": 0.235}, {"w": "không", "t": 26.485, "d": 0.22}, {"w": "phải", "t": 26.705, "d": 0.2}, {"w": "là", "t": 26.905, "d": 0.125}, {"w": "lãi", "t": 27.03, "d": 0.255}, {"w": "suất", "t": 27.285, "d": 0.245}, {"w": "bao", "t": 27.53, "d": 0.06}, {"w": "nhiêu.", "t": 27.59, "d": 0.37}]}, {"text": "Câu cần hỏi là: tổng cộng tôi phải trả bao nhiêu tiền?", "start": 29.28, "end": 32.32, "words": [{"w": "Câu", "t": 29.36, "d": 0.11}, {"w": "cần", "t": 29.47, "d": 0.2}, {"w": "hỏi", "t": 29.67, "d": 0.225}, {"w": "là:", "t": 29.895, "d": 0.325}, {"w": "tổng", "t": 30.22, "d": 0.15}, {"w": "cộng", "t": 30.37, "d": 0.215}, {"w": "tôi", "t": 30.585, "d": 0.24}, {"w": "phải", "t": 30.825, "d": 0.175}, {"w": "trả", "t": 31.0, "d": 0.16}, {"w": "bao", "t": 31.16, "d": 0.195}, {"w": "nhiêu", "t": 31.355, "d": 0.37}, {"w": "tiền?", "t": 31.725, "d": 0.235}]}, {"text": "Trong ví dụ của mình, mình giả định một khoản phí chuyển đổi ba phần trăm.", "start": 32.92, "end": 36.68, "words": [{"w": "Trong", "t": 32.975, "d": 0.16}, {"w": "ví", "t": 33.135, "d": 0.31}, {"w": "dụ", "t": 33.445, "d": 0.06}, {"w": "của", "t": 33.505, "d": 0.33}, {"w": "mình,", "t": 33.835, "d": 0.19}, {"w": "mình", "t": 34.025, "d": 0.315}, {"w": "giả", "t": 34.34, "d": 0.15}, {"w": "định", "t": 34.49, "d": 0.12}, {"w": "một", "t": 34.61, "d": 0.215}, {"w": "khoản", "t": 34.825, "d": 0.235}, {"w": "phí", "t": 35.06, "d": 0.25}, {"w": "chuyển", "t": 35.31, "d": 0.08}, {"w": "đổi", "t": 35.39, "d": 0.285}, {"w": "ba", "t": 35.675, "d": 0.22}, {"w": "phần", "t": 35.895, "d": 0.06}, {"w": "trăm.", "t": 35.955, "d": 0.365}]}, {"text": "Ba phần trăm của hai mươi triệu là sáu trăm nghìn.", "start": 37.0, "end": 39.72, "words": [{"w": "Ba", "t": 37.055, "d": 0.175}, {"w": "phần", "t": 37.23, "d": 0.17}, {"w": "trăm", "t": 37.4, "d": 0.23}, {"w": "của", "t": 37.63, "d": 0.195}, {"w": "hai", "t": 37.825, "d": 0.27}, {"w": "mươi", "t": 38.095, "d": 0.25}, {"w": "triệu", "t": 38.345, "d": 0.075}, {"w": "là", "t": 38.42, "d": 0.33}, {"w": "sáu", "t": 38.75, "d": 0.2}, {"w": "trăm", "t": 38.95, "d": 0.065}, {"w": "nghìn.", "t": 39.015, "d": 0.375}]}, {"text": "Cột thứ ba vì thế cao thêm một chút.", "start": 40.72, "end": 42.88, "words": [{"w": "Cột", "t": 40.795, "d": 0.115}, {"w": "thứ", "t": 40.91, "d": 0.15}, {"w": "ba", "t": 41.06, "d": 0.315}, {"w": "vì", "t": 41.375, "d": 0.14}, {"w": "thế", "t": 41.515, "d": 0.22}, {"w": "cao", "t": 41.735, "d": 0.175}, {"w": "thêm", "t": 41.91, "d": 0.07}, {"w": "một", "t": 41.98, "d": 0.275}, {"w": "chút.", "t": 42.255, "d": 0.21}]}, {"text": "Hai mươi triệu sáu trăm nghìn.", "start": 43.2, "end": 44.72, "words": [{"w": "Hai", "t": 43.29, "d": 0.23}, {"w": "mươi", "t": 43.52, "d": 0.06}, {"w": "triệu", "t": 43.58, "d": 0.24}, {"w": "sáu", "t": 43.82, "d": 0.175}, {"w": "trăm", "t": 43.995, "d": 0.06}, {"w": "nghìn.", "t": 44.055, "d": 0.325}]}, {"text": "So với trả thẳng, bạn đang trả nhiều hơn hai triệu một trăm nghìn.", "start": 45.04, "end": 48.64, "words": [{"w": "So", "t": 45.095, "d": 0.11}, {"w": "với", "t": 45.205, "d": 0.35}, {"w": "trả", "t": 45.555, "d": 0.2}, {"w": "thẳng,", "t": 45.755, "d": 0.385}, {"w": "bạn", "t": 46.14, "d": 0.06}, {"w": "đang", "t": 46.2, "d": 0.31}, {"w": "trả", "t": 46.51, "d": 0.18}, {"w": "nhiều", "t": 46.69, "d": 0.185}, {"w": "hơn", "t": 46.875, "d": 0.245}, {"w": "hai", "t": 47.12, "d": 0.2}, {"w": "triệu", "t": 47.32, "d": 0.185}, {"w": "một", "t": 47.505, "d": 0.155}, {"w": "trăm", "t": 47.66, "d": 0.215}, {"w": "nghìn.", "t": 47.875, "d": 0.39}]}, {"text": "Và bây giờ là câu hỏi mình hứa ở đầu video.", "start": 49.64, "end": 52.28, "words": [{"w": "Và", "t": 49.69, "d": 0.175}, {"w": "bây", "t": 49.865, "d": 0.225}, {"w": "giờ", "t": 50.09, "d": 0.265}, {"w": "là", "t": 50.355, "d": 0.065}, {"w": "câu", "t": 50.42, "d": 0.155}, {"w": "hỏi", "t": 50.575, "d": 0.195}, {"w": "mình", "t": 50.77, "d": 0.235}, {"w": "hứa", "t": 51.005, "d": 0.235}, {"w": "ở", "t": 51.24, "d": 0.155}, {"w": "đầu", "t": 51.395, "d": 0.195}, {"w": "video.", "t": 51.59, "d": 0.36}]}, {"text": "Hai triệu một trăm nghìn ấy, nếu gọi đúng tên, là bao nhiêu phần trăm một năm?", "start": 52.6, "end": 56.92, "words": [{"w": "Hai", "t": 52.685, "d": 0.14}, {"w": "triệu", "t": 52.825, "d": 0.35}, {"w": "một", "t": 53.175, "d": 0.06}, {"w": "trăm", "t": 53.235, "d": 0.345}, {"w": "nghìn", "t": 53.58, "d": 0.2}, {"w": "ấy,", "t": 53.78, "d": 0.275}, {"w": "nếu", "t": 54.055, "d": 0.075}, {"w": "gọi", "t": 54.13, "d": 0.23}, {"w": "đúng", "t": 54.36, "d": 0.175}, {"w": "tên,", "t": 54.535, "d": 0.5}, {"w": "là", "t": 55.035, "d": 0.08}, {"w": "bao", "t": 55.115, "d": 0.245}, {"w": "nhiêu", "t": 55.36, "d": 0.21}, {"w": "phần", "t": 55.57, "d": 0.195}, {"w": "trăm", "t": 55.765, "d": 0.17}, {"w": "một", "t": 55.935, "d": 0.31}, {"w": "năm?", "t": 56.245, "d": 0.245}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "3", "k": "CHƯƠNG BA", "title": "CÁI GIÁ THỨ BA", "sub": "LÃI LÀ 0 · PHÍ THÌ CHƯA CHẮC", "vid": "v0", "illus": "VIDEO MINH HỌA", "titleAt": 1.25, "t0": 0.0, "t1": 3.52}, {"type": "ledger", "title": "PHÍ CÓ THỂ ĐI KÈM TRẢ GÓP", "