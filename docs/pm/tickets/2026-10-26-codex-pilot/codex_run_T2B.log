7.685, "d": 0.135}, {"w": "đánh,", "t": 7.82, "d": 0.405}, {"w": "cùng", "t": 8.225, "d": 0.12}, {"w": "trong", "t": 8.345, "d": 0.31}, {"w": "Thế", "t": 8.655, "d": 0.19}, {"w": "chiến", "t": 8.845, "d": 0.165}, {"w": "thứ", "t": 9.01, "d": 0.14}, {"w": "hai.", "t": 9.15, "d": 0.29}]}, {"text": "Hai người chơi đều viết đúng: Chicago.", "start": 10.6, "end": 12.6, "words": [{"w": "Hai", "t": 10.6, "d": 0.205}, {"w": "người", "t": 10.805, "d": 0.18}, {"w": "chơi", "t": 10.985, "d": 0.315}, {"w": "đều", "t": 11.3, "d": 0.295}, {"w": "viết", "t": 11.595, "d": 0.205}, {"w": "đúng:", "t": 11.8, "d": 0.31}, {"w": "Chicago.", "t": 12.11, "d": 0.34}]}, {"text": "Watson viết: Toronto.", "start": 12.92, "end": 14.76, "words": [{"w": "Watson", "t": 12.92, "d": 0.565}, {"w": "viết:", "t": 13.485, "d": 0.635}, {"w": "Toronto.", "t": 14.12, "d": 0.465}]}, {"text": "Kèm một chuỗi dấu hỏi.", "start": 15.08, "end": 16.12, "words": [{"w": "Kèm", "t": 15.08, "d": 0.085}, {"w": "một", "t": 15.165, "d": 0.16}, {"w": "chuỗi", "t": 15.325, "d": 0.17}, {"w": "dấu", "t": 15.495, "d": 0.155}, {"w": "hỏi.", "t": 15.65, "d": 0.205}]}, {"text": "Nhưng hãy nhìn vào những chi tiết ít người để ý.", "start": 17.12, "end": 19.2, "words": [{"w": "Nhưng", "t": 17.12, "d": 0.09}, {"w": "hãy", "t": 17.21, "d": 0.165}, {"w": "nhìn", "t": 17.375, "d": 0.23}, {"w": "vào", "t": 17.605, "d": 0.11}, {"w": "những", "t": 17.715, "d": 0.16}, {"w": "chi", "t": 17.875, "d": 0.195}, {"w": "tiết", "t": 18.07, "d": 0.185}, {"w": "ít", "t": 18.255, "d": 0.235}, {"w": "người", "t": 18.49, "d": 0.06}, {"w": "để", "t": 18.55, "d": 0.17}, {"w": "ý.", "t": 18.72, "d": 0.29}]}, {"text": "Ở câu cuối, mọi người đều phải viết câu trả lời, dù chắc hay không.", "start": 19.52, "end": 23.2, "words": [{"w": "Ở", "t": 19.61, "d": 0.275}, {"w": "câu", "t": 19.885, "d": 0.2}, {"w": "cuối,", "t": 20.085, "d": 0.27}, {"w": "mọi", "t": 20.355, "d": 0.09}, {"w": "người", "t": 20.445, "d": 0.205}, {"w": "đều", "t": 20.65, "d": 0.365}, {"w