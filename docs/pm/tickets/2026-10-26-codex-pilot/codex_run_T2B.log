motion/hf/assets/long\ck-c3-bieu-do-nen\ch05\data.js:1:window.CASE = {"topic": "ck-c3-bieu-do-nen", "ch": "ch05", "dur": 206.9, "seed": 19716, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 05", "t": "ĐIỀU CÂY NẾN KHÔNG NÓI ĐƯỢC"}, "acc": ["vn-index", "hose", "doji", "búa", "bấc", "mốc"], "lines": [{"text": "Giờ tới những lời hứa ở đầu video.", "start": 0.0, "end": 2.24, "words": [{"w": "Giờ", "t": 0.135, "d": 0.19}, {"w": "tới", "t": 0.325, "d": 0.285}, {"w": "những", "t": 0.61, "d": 0.055}, {"w": "lời", "t": 0.665, "d": 0.21}, {"w": "hứa", "t": 0.875, "d": 0.25}, {"w": "ở", "t": 1.125, "d": 0.145}, {"w": "đầu", "t": 1.27, "d": 0.25}, {"w": "video.", "t": 1.52, "d": 0.355}]}, {"text": "Sách và mạng xã hội đặt tên cho hàng chục hình dạng nến.", "start": 3.04, "end": 6.0, "words": [{"w": "Sách", "t": 3.12, "d": 0.21}, {"w": "và", "t": 3.33, "d": 0.14}, {"w": "mạng", "t": 3.47, "d": 0.275}, {"w": "xã", "t": 3.745, "d": 0.06}, {"w": "hội", "t": 3.805, "d": 0.195}, {"w": "đặt", "t": 4.0, "d": 0.23}, {"w": "tên", "t": 4.23, "d": 0.21}, {"w": "cho", "t": 4.44, "d": 0.06}, {"w": "hàng", "t": 4.5, "d": 0.295}, {"w": "chục", "t": 4.795, "d": 0.145}, {"w": "hình", "t": 4.94, "d": 0.265}, {"w": "dạng", "t": 5.205, "d": 0.105}, {"w": "nến.", "t": 5.31, "d": 0.3}]}, {"text": "Ba cái tên người mới hay gặp nhất là cây búa, doji, và ba chàng lính trắng.", "start": 6.32, "end": 10.96, "words": [{"w": "Ba", "t": 6.38, "d": 0.16}, {"w": "cái", "t": 6.54, "d": 0.185}, {"w": "tên", "t": 6.725, "d": 0.335}, {"w": "người", "t": 7.06, "d": 0.27}, {"w": "mới", "t": 7.33, "d": 0.26}, {"w": "hay", "t": 7.59, "d": 0.225}, {"w": "gặp", "t": 7.815, "d": 0.14}, {"w": "nhất", "t": 7.955, "d": 0.27}, {"w": "là", "t": 8.225, "d": 0.155}, {"w": "cây", "t": 8.38, "d": 0.33}, {"w": "búa,", "t": 8.71, "d": 0.16}, {"w": "doji,", "t": 8.87, "d": 0.525}, {"w": "và", "t": 9.395, "d": 0.11}, {"w": "ba", "t": 9.505, "d": 0.22}, {"w": "chàng", "t": 9.725, "d": 0.215}, {"w": "lính", "t": 9.94, "d": 0.38}, {"w": "trắng.", "t": 10.32, "d": 0.265}]}, {"text": "Cây búa là nến có thân nhỏ nằm trên cao, bóng dưới dài ít nhất gấp đôi thân, mọc ra sau mấy phiên giảm.", "start": 11.28, "end": 16.88, "words": [{"w": "Cây", "t": 11.35, "d": 0.11}, {"w": "búa", "t": 11.46, "d": 0.33}, {"w": "là", "t": 11.79, "d": 0.245}, {"w": "nến", "t": 12.035, "d": 0.16}, {"w": "có", "t": 12.195, "d": 0.1}, {"w": "thân", "t": 12.295, "d": 0.275}, {"w": "nhỏ", "t": 12.57, "d": 0.205}, {"w": "nằm", "t": 12.775, "d": 0.19}, {"w": "trên", "t": 12.965, "d": 0.275}, {"w": "cao,", "t": 13.24, "d": 0.155}, {"w": "bóng", "t": 13.395, "d": 0.325}, {"w": "dưới", "t": 13.72, "d": 0.245}, {"w": "dài", "t": 13.965, "d": 0.16}, {"w": "ít", "t": 14.125, "d": 0.13}, {"w": "nhất", "t": 14.255, "d": 0.195}, {"w": "gấp", "t": 14.45, "d": 0.165}, {"w": "đôi", "t": 14.615, "d": 0.22}, {"w": "thân,", "t": 14.835, "d": 0.44}, {"w": "mọc", "t": 15.275, "d": 0.215}, {"w": "ra", "t": 15.49, "d": 0.07}, {"w": "sau", "t": 15.56, "d": 0.215}, {"w": "mấy", "t": 15.775, "d": 0.315}, {"w": "phiên", "t": 16.09, "d": 0.055}, {"w": "giảm.", "t": 16.145, "d": 0.385}]}, {"text": "Người ta nói nó báo hiệu đáy.", "start": 17.2, "end": 19.12, "words": [{"w": "Người", "t": 17.295, "d": 0.165}, {"w": "ta", "t": 17.46, "d": 0.185}, {"w": "nói", "t": 17.645, "d": 0.155}, {"w": "nó", "t": 17.8, "d": 0.26}, {"w": "báo", "t": 18.06, "d": 0.255}, {"w": "hiệu", "t": 18.315, "d": 0.175}, {"w": "đáy.", "t": 18.49, "d": 0.285}]}, {"text": "Doji, như cây nến thứ Sáu, được gọi là dấu hiệu lưỡng lự, sắp đảo chiều.", "start": 19.44, "end": 23.68, "words": [{"w": "Doji,", "t": 19.56, "d": 0.385}, {"w": "như", "t": 19.945, "d": 0.055}, {"w": "cây", "t": 20.0, "d": 0.2}, {"w": "nến", "t": 20.2, "d": 0.385}, {"w": "thứ", "t": 20.585, "d": 0.155}, {"w": "Sáu,", "t": 20.74, "d": 0.38}, {"w": "được", "