def seat(n, at_old, at_new, note, total=None):
    """Báº£ng gháº¿ trá»±c: n-1 dÃ²ng cÅ© hiá»‡n ngay á»Ÿ at_old, dÃ²ng thá»© n hiá»‡n á»Ÿ at_new."""
    rows = [dict(r, at=at_old) for r in R[:n - 1]] + [dict(R[n - 1], at=at_new)]
    s = {"type": "ledger", "at": at_old, "title": "GHáº¾ TRá»°C Â· Báº N ÄANG CÃ“", "srcnote": note, "rows": rows}
    if total:
        s["total"] = total
    return s


