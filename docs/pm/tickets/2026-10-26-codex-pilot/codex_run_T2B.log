def text_of(ln) -> str:
    return ln["t"] if isinstance(ln, dict) else ln


def sentences(t: str) -> list[str]:
    return [x.strip() for x in re.split(r"(?<=[.!?â€¦])\s+", t.replace("â€–", " ")) if x.strip()]


def lint(topic: str) -> tuple[list[str], list[str]]:
    err, warn = [], []
    for p in sorted((ROOT / "data" / "long" / topic).glob("ch[0-9][0-9].json")):
        ch = json.loads(p.read_text(encoding="utf-8"))
        name, sents = p.stem, []
        for i, ln in enumerate(ch.get("lines") or []):
            for s in sentences(text_of(ln)):
                n = len(s.split())
                sents.append(n)
                if n > 35:
                    err.append(f"{name} dÃ²ng {i}: cÃ¢u {n} tiáº¿ng (> 35): {s[:70]}â€¦")
                if s.count(",") >= 4 and not re.search(r"\d", s) and n < 30:
                    warn.append(f"{name} dÃ²ng {i}: cÃ³ váº» liá»‡t kÃª hÆ¡n 3 má»¥c trong má»™t cÃ¢u: {s[:70]}â€¦")
        if len(sents) >= 10:
            short = sum(1 for n in sents if n <= 6)
            if short * 7 < len(sents):
                warn.append(f"{name}: {short}/{len(sents)} cÃ¢u ngáº¯n (<= 6 tiáº¿ng); cáº§n khoáº£ng 1 cÃ¢u má»—i 4-6 cÃ¢u")
        types = [s["type"] for s in ch.get("scenes") or []]
        body = [t for t in types if t not in ("chapter", "brand", "endcard")]
        if len(body) >= 5 and len(set(body)) < 3:
            warn.append(f"{name}: chá»‰ {len(set(body))} loáº¡i cáº£nh ({sorted(set(body))}); cáº§n >= 3")
        for i in range(2, len(types)):
            if types[i] == types[i - 1] == types[i - 2] and types[i] not in ("broll",):
                warn.append(f"{name} cáº£nh {i - 2}-{i}: ba cáº£nh '{types[i]}' liá»n nhau")
        err += [f"{name} {m}" for m in year_counter_issues(ch.get("scenes"))]
        for i, s in enumerate(ch.get("scenes") or []):
            if s["type"] != "counter":
                continue
            moving = s.get("from", 0) != s["to"]
            if moving and float(s["to"]).is_integer() and 1500 <= s["to"] <= 2100 and not s.get("suffix") and s.get("year") is not False:
                err.append(f"{name} cáº£nh {i}: counter Ä‘áº¿m tá»›i nÄƒm {int(s['to'])} (Ä‘áº·t from = to hoáº·c dÃ¹ng kinetic/date)")
            if moving and re.search(r"[\d<>â‰ˆ~]", str(s.get("prefix") or "")):
                err.append(f"{name} cáº£nh {i}: counter prefix {s['prefix']!r} mÃ  sá»‘ cÃ²n cháº¡y")
    return err, warn


def main() -> int:
    sys.path.insert(0, str(ROOT))
    from factory.console import utf8_console
    utf8_console()  # console Windows cp1252 khÃ´ng in Ä‘Æ°á»£c tiáº¿ng Viá»‡t (retro 2 má»¥c 7)
    topic = sys.argv[1]
    err, warn = lint(topic)
    out = sys.stdout
    try:
        out.reconfigure(encoding="utf-8")
    except Exception:
        pass
    for w in warn:
        print("  ! " + w)
    for e in err:
        print("  Lá»–I " + e)
    print(f"{topic}: {len(err)} lá»—i, {len(warn)} cáº£nh bÃ¡o (luáº­t studio)")
    return 1 if err and "--strict" in sys.argv else 0


if __name__ == "__main__":
    sys.exit(main())


