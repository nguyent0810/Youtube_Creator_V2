5}, {"w": "mã.", "t": 44.39, "d": 0.61}]}, {"text": "Theo kênh tự tính, cuối tháng chín, cổ phiếu đứng giữa sàn HOSE có giá khoảng mười lăm nghìn đồng.", "start": 45.6, "end": 50.64, "words": [{"w": "Theo", "t": 45.66, "d": 0.16}, {"w": "kênh", "t": 45.82, "d": 0.24}, {"w": "tự", "t": 46.06, "d": 0.19}, {"w": "tính,", "t": 46.25, "d": 0.425}, {"w": "cuối", "t": 46.675, "d": 0.24}, {"w": "tháng", "t": 46.915, "d": 0.175}, {"w": "chín,", "t": 47.09, "d": 0.36}, {"w": "cổ", "t": 47.45, "d": 0.06}, {"w": "phiếu", "t": 47.51, "d": 0.245}, {"w": "đứng", "t": 47.755, "d": 0.23}, {"w": "giữa", "t": 47.985, "d": 0.215}, {"w": "sàn", "t": 48.2, "d": 0.215}, {"w": "HOSE", "t": 48.415, "d": 0.16}, {"w": "có", "t": 48.575, "d": 0.39}, {"w": "giá", "t": 48.965, "d": 0.07}, {"w": "khoảng", "t": 49.035, "d": 0.34}, {"w": "mười", "t": 49.375, "d": 0.06}, {"w": "lăm", "t": 49.435, "d": 0.19}, {"w": "nghìn", "t": 49.625, "d": 0.24}, {"w": "đồng.", "t": 49.865, "d": 0.41}]}, {"text": "Vậy một lô khoảng một triệu rưỡi, chưa tính phí, chưa tới một phần năm thu nhập bình quân một tháng, khoảng chín triệu.", "start": 50.96, "end": 56.72, "words": [{"w": "Vậy", "t": 51.055, "d": 0.125}, {"w": "một", "t": 51.18, "d": 0.365}, {"w": "lô", "t": 51.545, "d": 0.06}, {"w": "khoảng", "t": 51.605, "d": 0.335}, {"w": "một", "t": 51.94, "d": 0.075}, {"w": "triệu", "t": 52.015, "d": 0.18}, {"w": "rưỡi,", "t": 52.195, "d": 0.355}, {"w": "chưa", "t": 52.55, "d": 0.28}, {"w": "tính", "t": 52.83, "d": 0.185}, {"w": "phí,", "t": 53.015, "d": 0.37}, {"w": "chưa", "t": 53.385, "d": 0.06}, {"w": "tới", "t": 53.445, "d": 0.25}, {"w": "một", "t": 53.695, "d": 0.315}, {"w": "phần", "t": 54.01, "d": 0.06}, {"w": "năm", "t": 54.07, "d": 0.34}, {"w": "thu", "t": 54.41, "d": 0.155}, {"w": "nhập", "t": 54.565, "d": 0.145}, {"w": "bình", "t": 54.71, "d": 0.205}, {"w": "quân", "t": 54.915, "d": 0.305}, {"w": "một", "t": 55.22, "d": 0.07}, {"w": "tháng,", "t": 55.29, "d": 0.39}, {"w": "khoảng", "t": 55.68, "d": 0.09}, {"w": "chín", "t": 55.77, "d": 0.22}, {"w": "triệu.", "t": 55.99, "d": 0.4}]}, {"text": "Giá cũng không tuỳ ý: mỗi mức giá phải đi theo bước giá.", "start": 57.72, "end": 60.92, "words": [{"w": "Giá", "t": 57.825, "d": 0.235}, {"w": "cũng", "t": 58.06, "d": 0.16}, {"w": "không", "t": 58.22, "d": 0.225}, {"w": "tuỳ", "t": 58.445, "d": 0.15}, {"w": "ý:", "t": 58.595, "d": 0.385}, {"w": "mỗi", "t": 58.98, "d": 0.06}, {"w": "mức", "t": 59.04, "d": 0.33}, {"w": "giá", "t": 59.37, "d": 0.09}, {"w": "phải", "t": 59.46, "d": 0.185}, {"w": "đi", "t": 59.645, "d": 0.335}, {"w": "theo", "t": 59.98, "d": 0.155}, {"w": "bước", "t": 60.135, "d": 0.155}, {"w": "giá.", "t": 60.29, "d": 0.32}]}, {"text": "Cổ phiếu dưới mười nghìn đồng, mỗi bước là mười đồng.", "start": 61.24, "end": 64.12, "words": [{"w": "Cổ", "t": 61.32, "d": 0.145}, {"w": "phiếu", "t": 61.465, "d": 0.27}, {"w": "dưới", "t": 61.735, "d": 0.155}, {"w": "mười", "t": 61.89, "d": 0.325}, {"w": "nghìn", "t": 62.215, "d": 0.205}, {"w": "đồng,", "t": 62.42, "d": 0.255}, {"w": "mỗi", "t": 62.675, "d": 0.095}, {"w": "bước", "t": 62.77, "d": 0.38}, {"w": "là", "t": 63.15, "d": 0.075}, {"w": "mười", "t": 63.225, "d": 0.15}, {"w": "đồng.", "t": 63.375, "d": 0.42}]}, {"text": "Từ mười nghìn tới dưới năm mươi nghìn, mỗi bước năm mươi đồng.", "start": 64.44, "end": 67.48, "words": [{"w": "Từ", "t": 64.49, "d": 0.095}, {"w": "mười", "t": 64.585, "d": 0.325}, {"w": "nghìn", "t": 64.91, "d": 0.115}, {"w": "tới", "t": 65.025, "d": 0.245}, {"w": "dưới", "t": 65.27, "d": 0.19}, {"w": "năm", "t": 65.46, "d": 0.075}, {"w": "mươi", "t": 65.535, "d": 0.14}, {"w": "nghìn,", "t": 65.675, "d": 0.36}, {"w": "mỗi", "t": 66.035, "d": 0.11}, {"w": "bước", "t": 66.145, "d": 0.335}, {"w": "năm", "t": 66.48, "d": 0.06}, {"w": "mươi", "t": 66.54, "d": 0.3}, {"w": "đồng.", "t": 66.84, "d": 0.22}]}, {"text": "Từ năm mươi nghìn trở lên, mỗi bước một trăm đồng.", "start": 67.8, "end": 70.36, "words": [{"w": "Từ", "t": 67.855, "d": 0.21}, {"w": "năm", "t":