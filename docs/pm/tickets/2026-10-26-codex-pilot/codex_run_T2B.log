 55.295, "d": 0.285}, {"w": "năm.", "t": 55.58, "d": 0.25}]}, {"text": "Không phải sáu.", "start": 56.48, "end": 57.52, "words": [{"w": "Không", "t": 56.59, "d": 0.155}, {"w": "phải", "t": 56.745, "d": 0.26}, {"w": "sáu.", "t": 57.005, "d": 0.22}]}, {"text": "Lãi kép vẫn chạy. Nhưng chậm hơn nhiều so với những bảng tính bạn hay thấy trên mạng.", "start": 57.84, "end": 62.16, "words": [{"w": "Lãi", "t": 57.905, "d": 0.23}, {"w": "kép", "t": 58.135, "d": 0.19}, {"w": "vẫn", "t": 58.325, "d": 0.185}, {"w": "chạy.", "t": 58.51, "d": 0.395}, {"w": "Nhưng", "t": 58.905, "d": 0.06}, {"w": "chậm", "t": 58.965, "d": 0.305}, {"w": "hơn", "t": 59.27, "d": 0.115}, {"w": "nhiều", "t": 59.385, "d": 0.2}, {"w": "so", "t": 59.585, "d": 0.32}, {"w": "với", "t": 59.905, "d": 0.19}, {"w": "những", "t": 60.095, "d": 0.22}, {"w": "bảng", "t": 60.315, "d": 0.105}, {"w": "tính", "t": 60.42, "d": 0.25}, {"w": "bạn", "t": 60.67, "d": 0.205}, {"w": "hay", "t": 60.875, "d": 0.13}, {"w": "thấy", "t": 61.005, "d": 0.205}, {"w": "trên", "t": 61.21, "d": 0.205}, {"w": "mạng.", "t": 61.415, "d": 0.345}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "broll", "vid": "v0", "ms": 12, "veil": 0.5, "illus": "VIDEO MINH HỌA", "kin": [{"text": "LẠM PHÁT", "at": 0.93, "acc": true, "fx": "sync", "wt": [0.93, 1.125], "t0": 0.0}, {"text": "3 tỷ của 30 năm sau ≠ 3 tỷ hôm nay", "at": 2.48, "sm": true, "fx": "rise"}], "t0": 0.0, "t1": 7.0}, {"type": "bars", "title": "GIÁ CẢ TĂNG BÌNH QUÂN MỖI NĂM (%) · VIỆT NAM", "unit": "", "items": [{"k": "2018", "v": 3.54, "lbl": "3,54", "at": 9.58}, {"k": "2019", "v": 2.79, "lbl": "2,79", "at": 9.76}, {"k": "2020", "v": 3.23, "lbl": "3,23", "at": 9.94}, {"k": "2021", "v": 1.84, "lbl": "1,84", "at": 10.12}, {"k": "2022", "v": 3.15, "lbl": "3,15", "at": 10.3}, {"k": "2023", "v": 3.25, "lbl": "3,25", "at": 10.48}, {"k": "2024", "v": 3.63, "lbl": "3,63", "at": 10.66}, {"k": "2025", "v": 3.31, "lbl": "3,31", "at": 10.84}], "label": {"k": "BÌNH QUÂN ≈ 3,1%/NĂM", "v": "NGUỒN: CỤC T