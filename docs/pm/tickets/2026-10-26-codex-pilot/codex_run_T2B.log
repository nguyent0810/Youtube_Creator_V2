    {"type": "question", "at": 10, "text": "Vậy câu trả lời\ncho hai cái nút?"},
    {"type": "slam", "at": 11, "text": "BÁO LÊN: MÁY SAI", "sub": "ÔNG BÁO ĐIỀU NGƯỢC LẠI VỚI CỖ MÁY"},
