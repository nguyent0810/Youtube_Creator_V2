motion/hf/assets/long\ck-c2-phien-giao-dich\ch01\data.js:1:window.CASE = {"topic": "ck-c2-phien-giao-dich", "ch": "ch01", "dur": 103.5, "seed": 28403, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 01", "t": "TRƯỚC CHÍN GIỜ: MỘT LỆNH GỒM NHỮNG GÌ"}, "acc": ["hose", "vn-index", "ato", "atc", "krx", "sàn", "trần", "khớp", "phí", "thuế"], "lines": [{"text": "Ở bài một, mình ví HOSE như một khu chợ có ban quản lý, và bạn nhờ công ty chứng khoán đi chợ hộ.", "start": 0.0, "end": 5.68, "words": [{"w": "Ở", "t": 0.085, "d": 0.26}, {"w": "bài", "t": 0.345, "d": 0.23}, {"w": "một,", "t": 0.575, "d": 0.16}, {"w": "mình", "t": 0.735, "d": 0.29}, {"w": "ví", "t": 1.025, "d": 0.155}, {"w": "HOSE", "t": 1.18, "d": 0.22}, {"w": "như", "t": 1.4, "d": 0.145}, {"w": "một", "t": 1.545, "d": 0.35}, {"w": "khu", "t": 1.895, "d": 0.205}, {"w": "chợ", "t": 2.1, "d": 0.22}, {"w": "có", "t": 2.32, "d": 0.13}, {"w": "ban", "t": 2.45, "d": 0.26}, {"w": "quản", "t": 2.71, "d": 0.225}, {"w": "lý,", "t": 2.935, "d": 0.325}, {"w": "và", "t": 3.26, "d": 0.105}, {"w": "bạn", "t": 3.365, "d": 0.225}, {"w": "nhờ", "t": 3.59, "d": 0.125}, {"w": "công", "t": 3.715, "d": 0.28}, {"w": "ty", "t": 3.995, "d": 0.2}, {"w": "chứng", "t": 4.195, "d": 0.18}, {"w": "khoán", "t": 4.375, "d": 0.19}, {"w": "đi", "t": 4.565, "d": 0.285}, {"w": "chợ", "t": 4.85, "d": 0.125}, {"w": "hộ.", "t": 4.975, "d": 0.355}]}, {"text": "Lệnh của bạn đi từ ứng dụng, qua công ty chứng khoán, vào hệ thống của sở giao dịch.", "start": 6.48, "end": 10.96, "words": [{"w": "Lệnh", "t": 6.54, "d": 0.185}, {"w": "của", "t": 6.725, "d": 0.26}, {"w": "bạn", "t": 6.985, "d": 0.06}, {"w": "đi", "t": 7.045, "d": 0.24}, {"w": "từ", "t": 7.285, "d": 0.185}, {"w": "ứng", "t": 7.47, "d": 0.215}, {"w": "dụng,", "t": 7.685, "d": 0.26}, {"w": "qua", "t": 7.945, "d": 0.345}, {"w": "công", "t":