motion/hf/assets/long\mim-siri-susan-bennett\ch01\data.js:1:window.CASE = {"topic": "mim-siri-susan-bennett", "ch": "ch01", "dur": 103.1, "seed": 32984, "accent": "#f472b6", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 01", "t": "NẤC THỨ NHẤT: NĂM 2011"}, "acc": ["giọng", "mảnh", "băng", "ghép", "người", "nấc", "cắt", "thật"], "lines": [{"text": "Kim chỉ năm đang dừng ở 2011.", "start": 0.0, "end": 2.24, "words": [{"w": "Kim", "t": 0.0, "d": 0.1}, {"w": "chỉ", "t": 0.1, "d": 0.26}, {"w": "năm", "t": 0.36, "d": 0.075}, {"w": "đang", "t": 0.435, "d": 0.195}, {"w": "dừng", "t": 0.63, "d": 0.235}, {"w": "ở", "t": 0.865, "d": 0.175}, {"w": "2011.", "t": 1.04, "d": 1.01}]}, {"text": "Thông cáo của Apple gọi Siri là trợ lý thông minh, giúp bạn làm việc chỉ bằng cách hỏi.", "start": 3.04, "end": 7.6, "words": [{"w": "Thông", "t": 3.095, "d": 0.3}, {"w": "cáo", "t": 3.395, "d": 0.21}, {"w": "của", "t": 3.605, "d": 0.185}, {"w": "Apple", "t": 3.79, "d": 0.2}, {"w": "gọi", "t": 3.99, "d": 0.12}, {"w": "Siri", "t": 4.11, "d": 0.325}, {"w": "là", "t": 4.435, "d": 0.075}, {"w": "trợ", "t": 4.51, "d": 0.34}, {"w": "lý", "t": 4.85, "d": 0.055}, {"w": "thông", "t": 4.905, "d": 0.305}, {"w": "minh,", "t": 5.21, "d": 0.43}, {"w": "giúp", "t": 5.64, "d": 0.2}, {"w": "bạn", "t": 5.84, "d": 0.055}, {"w": "làm", "t": 5.895, "d": 0.32}, {"w": "việc", "t": 6.215, "d": 0.24}, {"w": "chỉ", "t": 6.455, "d": 0.205}, {"w": "bằng", "t": 6.66, "d": 0.19}, {"w": "cách", "t": 6.85, "d": 0.265}, {"w": "hỏi.", "t": 7.115, "d": 0.26}]}, {"text": "Bạn hỏi cuối tuần có cần mang ô không, nó đọc dự báo thời tiết.", "start": 7.92, "end": 10.96, "words": [{"w": "Bạn", "t": 7.92, "d": 0.115}, {"w": "hỏi", "t": 8.035, "d": 0.195}, {"w": "cuối", "t": 8.23, "d": 0.14}, {"w": "tuần", "t": 8.37, "d": 0.26}, {"w": "có", "t": 8.63, "d": 0.145}, {"w": "cần", "t": 8.775, "d": 0.13}, {"w": "mang", "t": 8.905, "d": 0.225}, {"w": "ô", "t": 9.13, "d": 0.145}, {"w": "không,", "t": 9.275, "d": 0.4}, {"w": "nó", "t": 9.675, "d": 0.085}, {"w": "đọc", "t": 9.76, "d": 0.21}, {"w": "dự", "t": 9.97, "d": 0.17}, {"w": "báo", "t": 10.14, "d": 0.15}, {"w": "thời", "t": 10.29, "d": 0.2}, {"w": "tiết.", "t": 10.49, "d": 0.31}]}, {"text": "Bản đầu tiên mới nói tiếng Anh, tiếng Pháp, tiếng Đức, và còn gắn nhãn thử nghiệm.", "start": 11.28, "end": 15.2, "words": [{"w": "Bản", "t": 11.28, "d": 0.23}, {"w": "đầu", "t": 11.51, "d": 0.12}, {"w": "tiên", "t": 11.63, "d": 0.3}, {"w": "mới", "t": 11.93, "d": 0.095}, {"w": "nói", "t": 12.025, "d": 0.29}, {"w": "tiếng", "t": 12.315, "d": 0.17}, {"w": "Anh,", "t": 12.485, "d": 0.325}, {"w": "tiếng", "t": 12.81, "d": 0.19}, {"w": "Pháp,", "t": 13.0, "d": 0.245}, {"w": "tiếng", "t": 13.245, "d": 0.085}, {"w": "Đức,", "t": 13.33, "d": 0.475}, {"w": "và", "t": 13.805, "d": 0.06}, {"w": "còn", "t": 13.865, "d": 0.21}, {"w": "gắn", "t": 14.075, "d": 0.295}, {"w": "nhãn", "t": 14.37, "d": 0.06}, {"w": "thử", "t": 14.43, "d": 0.225}, {"w": "nghiệm.", "t": 14.655, "d": 0.33}]}, {"text": "Ngay hôm sau, Hội đồng quản trị Apple thông báo Steve Jobs đã qua đời.", "start": 16.2, "end": 19.8, "words": [{"w": "Ngay", "t": 16.2, "d": 0.19}, {"w": "hôm", "t": 16.39, "d": 0.32}, {"w": "sau,", "t": 16.71, "d": 0.315}, {"w": "Hội", "t": 17.025, "d": 0.055}, {"w": "đồng", "t": 17.08, "d": 0.33}, {"w": "quản", "t": 17.41, "d": 0.165}, {"w": "trị", "t": 17.575, "d": 0.31}, {"w": "Apple", "t": 17.885, "d": 0.185}, {"w": "thông", "t": 18.07, "d": 0.17}, {"w": "báo", "t": 18.24, "d": 0.29}, {"w": "Steve", "t": 18.53, "d": 0.155}, {"w": "Jobs", "t": 18.685, "d": 0.2}, {"w": "đã", "t": 18.885, "d": 0.24}, {"w": "qua", "t": 19.125, "d": 0.205}, {"w": "đời.", "t": 19.33, "d": 0.295}]}, {"text": "Mười ngày sau buổi ra mắt, chiếc điện thoại có Siri lên kệ.", "start": 20.12, "end": 22.92, "words": [{"w": "Mười", "t": 20.12, "d": 0.25}, {"w": "ngày", "t": 20.37, "d": 0.15}, {"w": "sau", "t": 20.52, "d": 0.16}, {"w": "buổi", "t": 20.68, "d": 0.26}, {"w": "ra", "t": 20.94, "d": 0.185}, {"w": "mắt,", "t": 21.125, "d": 0.135}, {"w": "chiếc", "t": 21.26, "d": 0.35}, {"w": "điện", "t": 21.61, "d": 0.055}, {"w": "thoại", "t": 21.665, "d": 0.22}, {"w": "có", "t": 21.885, "d": 0.225}, {"w": "Siri", "t": 22.11, "d": 0.15}, {"w": "lên", "t": 22.26, "d": 0.28}, {"w": "kệ.", "t": 22.54, "d": 0.22}]}, {"text": "Còn bà Bennett thì giữ kín.", "start": 23.24, "end": 24.76, "words": [{"w": "Còn", "t": 23.24, "d": 0.23}, {"w": "bà", "t": 23.47, "d": 0.1}, {"w": "Bennett", "t": 23.57, "d": 0.345}, {"w": "thì", "t": 23.915, "d": 0.055}, {"w": "giữ", "t": 23.97, "d": 0.34}, {"w": "kín.", "t": 24.31, "d": 0.235}]}, {"text": "Bà kể với CNN rằng bà không chắc mình muốn nổi tiếng, cũng không chắc mình đứng ở đâu về mặt pháp lý.", "start": 25.08, "end": 30.76, "words": [{"w": "Bà", "t": 25.08, "d": 0.255}, {"w": "kể", "t": 25.335, "d": 0.2}, {"w": "với", "t": 25.535, "d": 0.16}, {"w": "CNN", "t": 25.695, "d": 0.265}, {"w": "rằng", "t": 25.96, "d": 0.35}, {"w": "bà", "t": 26.31, "d": 0.17}, {"w": "không", "t": 26.48, "d": 0.085}, {"w": "chắc", "t": 26.565, "d": 0.26}, {"w": "mình", "t": 26.825, "d": 0.39}, {"w": "muốn", "t": 27.215, "d": 0.23}, {"w": "nổi", "t": 27.445, "d": 0.085}, {"w": "tiếng,", "t": 27.53, "d": 0.34}, {"w": "cũng", "t": 27.87, "d": 0.39}, {"w": "không", "t": 28.26, "d": 0.055}, {"w": "chắc", "t": 28.315, "d": 0.24}, {"w": "mình", "t": 28.555, "d": 0.35}, {"w": "đứng", "t": 28.905, "d": 0.195}, {"w": "ở", "t": 29.1, "d": 0.25}, {"w": "đâu", "t": 29.35, "d": 0.27}, {"w": "về", "t": 29.62, "d": 0.2}, {"w": "mặt", "t": 29.82, "d": 0.21}, {"w": "pháp", "t": 30.03, "d": 0.12}, {"w": "lý.", "t": 30.15, "d": 0.42}]}, {"text": "Nên bà im lặng gần hai năm.", "start": 31.08, "end": 32.52, "words": [{"w": "Nên", "t": 31.135, "d": 0.165}, {"w": "bà", "t": 31.3, "d": 0.145}, {"w": "im", "t": 31.445, "d": 0.125}, {"w": "lặng", "t": 31.57, "d": 0.215}, {"w": "gần", "t": 31.785, "d": 0.06}, {"w": "hai", "t": 31.845, "d": 0.145}, {"w": "năm.", "t": 31.99, "d": 0.305}]}, {"text": "Rồi tháng 9 năm 2013, trang tin công nghệ The Verge đăng một video về cách Siri có giọng nói.", "start": 32.84, "end": 38.6, "words": [{"w": "Rồi", "t": 32.97, "d": 0.115}, {"w": "tháng", "t": 33.085, "d": 0.34}, {"w": "9", "t": 33.425, "d": 0.1}, {"w": "năm", "t": 33.525, "d": 0.3}, {"w": "2013,", "t": 33.825, "d": 1.37}, {"w": "trang", "t": 35.195, "d": 0.105}, {"w": "tin", "t": 35.3, "d": 0.21}, {"w": "công", "t": 35.51, "d": 0.26}, {"w": "nghệ", "t": 35.77, "d": 0.17}, {"w": "The", "t": 35.94, "d": 0.155}, {"w": "Verge", "t": 36.095, "d": 0.34}, {"w": "đăng", "t": 36.435, "d": 0.145}, {"w": "một", "t": 36.58, "d": 0.31}, {"w": "video", "t": 36.89, "d": 0.21}, {"w": "về", "t": 37.1, "d": 0.06}, {"w": "cách", "t": 37.16, "d": 0.2}, {"w": "Siri", "t": 37.36, "d": 0.215}, {"w": "có", "t": 37.575, "d": 0.305}, {"w": "giọng", "t": 37.88, "d": 0.24}, {"w": "nói.", "t": 38.12, "d": 0.255}]}, {"text": "Nhiều người xem tưởng nữ diễn viên lồng tiếng trong video chính là Siri.", "start": 38.92, "end": 42.36, "words": [{"w": "Nhiều", "t": 38.985, "d": 0.31}, {"w": "người", "t": 39.295, "d": 0.215}, {"w": "xem", "t": 39.51, "d": 0.06}, {"w": "tưởng", "t": 39.57, "d": 0.35}, {"w": "nữ", "t": 39.92, "d": 0.17}, {"w": "diễn", "t": 40.09, "d": 0.29}, {"w": "viên", "t": 40.38, "d": 0.07}, {"w": "lồng", "t": 40.45, "d": 0.22}, {"w": "tiếng", "t": 40.67, "d": 0.18}, {"w": "trong", "t": 40.85, "d": 0.405}, {"w": "video", "t": 41.255, "d": 0.215}, {"w": "chính", "t": 41.47, "d": 0.06}, {"w": "là", "t": 41.53, "d": 0.31}, {"w": "Siri.", "t": 41.84, "d": 0.325}]}, {"text": "Người ấy vội lên tiếng: cô tuyệt đối không phải Siri.", "start": 42.68, "end": 45.32, "words": [{"w": "Người", "t": 42.68, "d": 0.285}, {"w": "ấy", "t": 42.965, "d": 0.17}, {"w": "vội", "t": 43.135, "d": 0.175}, {"w": "lên", "t": 43.31, "d": 0.26}, {"w": "tiếng:", "t": 43.57, "d": 0.23}, {"w": "cô", "t": 43.8, "d": 0.23}, {"w": "tuyệt", "t": 44.03, "d": 0.165}, {"w": "đối", "t": 44.195, "d": 0.24}, {"w": "không", "t": 44.435, "d": 0.19}, {"w": "phải", "t": 44.625, "d": 0.15}, {"w": "Siri.", "t": 44.775, "d": 0.365}]}, {"text": "Thật ra, một phóng viên CNN đã đoán ra từ mấy tháng trước.", "start": 46.32, "end": 49.6, "words": [{"w": "Thật", "t": 46.365, "d": 0.3}, {"w": "ra,", "t": 46.665, "d": 0.345}, {"w": "một", "t": 47.01, "d": 0.065}, {"w": "phóng", "t": 47.075, "d": 0.245}, {"w": "viên", "t": 47.32, "d": 0.32}, {"w": "CNN", "t": 47.64, "d": 0.065}, {"w": "đã", "t": 47.705, "d": 0.185}, {"w": "đoán", "t": 47.89, "d": 0.34}, {"w": "ra", "t": 48.23, "d": 0.21}, {"w": "từ", "t": 48.44, "d": 0.26}, {"w": "mấy", "t": 48.7, "d": 0.185}, {"w": "tháng", "t": 48.885, "d": 0.165}, {"w": "trước.", "t": 49.05, "d": 0.345}]}, {"text": "Chị đang phỏng vấn bà Bennett về những giọng nói ở sân bay Atlanta.", "start": 49.92, "end": 53.28, "words": [{"w": "Chị", "t": 49.92, "d": 0.215}, {"w": "đang", "t": 50.135, "d": 0.17}, {"w": "phỏng", "t": 50.305, "d": 0.325}, {"w": "vấn", "t": 50.63, "d": 0.135}, {"w": "bà", "t": 50.765, "d": 0.225}, {"w": "Bennett", "t": 50.99, "d": 0.125}, {"w": "về", "t": 51.115, "d": 0.355}, {"w": "những", "t": 51.47, "d": 0.25}, {"w": "giọng", "t": 51.72, "d": 0.06}, {"w": "nói", "t": 51.78, "d": 0.27}, {"w": "ở", "t": 52.05, "d": 0.19}, {"w": "sân", "t": 52.24, "d": 0.185}, {"w": "bay", "t": 52.425, "d": 0.265}, {"w": "Atlanta.", "t": 52.69, "d": 0.365}]}, {"text": "Tiện miệng, chị hỏi: bà có phải là Siri không?", "start": 53.6, "end": 56.24, "words": [{"w": "Tiện", "t": 53.64, "d": 0.11}, {"w": "miệng,", "t": 53.75, "d": 0.48}, {"w": "chị", "t": 54.23, "d": 0.06}, {"w": "hỏi:", "t": 54.29, "d": 0.515}, {"w": "bà", "t": 54.805, "d": 0.08}, {"w": "có", "t": 54.885, "d": 0.265}, {"w": "phải", "t": 55.15, "d": 0.115}, {"w": "là", "t": 55.265, "d": 0.345}, {"w": "Siri", "t": 55.61, "d": 0.235}, {"w": "không?", "t": 55.845, "d": 0.245}]}, {"text": "Theo bài báo, bà sững người.", "start": 56.84, "end": 58.28, "words": [{"w": "Theo", "t": 56.84, "d": 0.19}, {"w": "bài", "t": 57.03, "d": 0.24}, {"w": "báo,", "t": 57.27, "d": 0.22}, {"w": "bà", "t": 57.49, "d": 0.24}, {"w": "sững", "t": 57.73, "d": 0.115}, {"w": "người.", "t": 57.845, "d": 0.28}]}, {"text": "Sau vụ video kia, chính bà liên lạc lại.", "start": 59.28, "end": 61.84, "words": [{"w": "Sau", "t": 59.355, "d": 0.235}, {"w": "vụ", "t": 59.59, "d": 0.225}, {"w": "video", "t": 59.815, "d": 0.305}, {"w": "kia,", "t": 60.12, "d": 0.36}, {"w": "chính", "t": 60.48, "d": 0.215}, {"w": "bà", "t": 60.695, "d": 0.065}, {"w": "liên", "t": 60.76, "d": 0.24}, {"w": "lạc", "t": 61.0, "d": 0.26}, {"w": "lại.", "t": 61.26, "d": 0.38}]}, {"text": "Bà đã sẵn sàng kể.", "start": 62.16, "end": 63.36, "words": [{"w": "Bà", "t": 62.26, "d": 0.17}, {"w": "đã", "t": 62.43, "d": 0.185}, {"w": "sẵn", "t": 62.615, "d": 0.175}, {"w": "sàng", "t": 62.79, "d": 0.17}, {"w": "kể.", "t": 62.96, "d": 0.235}]}, {"text": "Ngày 4 tháng 10 năm 2013, tròn hai năm sau buổi ra mắt, CNN đăng câu chuyện.", "start": 63.68, "end": 68.8, "words": [{"w": "Ngày", "t": 63.74, "d": 0.165}, {"w": "4", "t": 63.905, "d": 0.225}, {"w": "tháng", "t": 64.13, "d": 0.13}, {"w": "10", "t": 64.26, "d": 0.36}, {"w": "năm", "t": 64.62, "d": 0.13}, {"w": "2013,", "t": 64.75, "d": 1.43}, {"w": "tròn", "t": 66.18, "d": 0.18}, {"w": "hai", "t": 66.36, "d": 0.235}, {"w": "năm", "t": 66.595, "d": 0.205}, {"w": "sau", "t": 66.8, "d": 0.175}, {"w": "buổi", "t": 66.975, "d": 0.265}, {"w": "ra", "t": 67.24, "d": 0.2}, {"w": "mắt,", "t": 67.44, "d": 0.21}, {"w": "CNN", "t": 67.65, "d": 0.27}, {"w": "đăng", "t": 67.92, "d": 0.265}, {"w": "câu", "t": 68.185, "d": 0.16}, {"w": "chuyện.", "t": 68.345, "d": 0.29}]}, {"text": "Bằng chứng ở đâu?", "start": 69.12, "end": 70.0, "words": [{"w": "Bằng", "t": 69.12, "d": 0.14}, {"w": "chứng", "t": 69.26, "d": 0.205}, {"w": "ở", "t": 69.465, "d": 0.125}, {"w": "đâu?", "t": 69.59, "d": 0.245}]}, {"text": "Apple vẫn từ chối bình luận.", "start": 70.6, "end": 72.04, "words": [{"w": "Apple", "t": 70.6, "d": 0.11}, {"w": "vẫn", "t": 70.71, "d": 0.255}, {"w": "từ", "t": 70.965, "d": 0.185}, {"w": "chối", "t": 71.15, "d": 0.175}, {"w": "bình", "t": 71.325, "d": 0.22}, {"w": "luận.", "t": 71.545, "d": 0.29}]}, {"text": "Nên CNN thuê một chuyên gia pháp y âm thanh, ông Ed Primeau, ba mươi năm trong nghề.", "start": 72.36, "end": 76.84, "words": [{"w": "Nên", "t": 72.42, "d": 0.3}, {"w": "CNN", "t": 72.72, "d": 0.06}, {"w": "thuê", "t": 72.78, "d": 0.37}, {"w": "một", "t": 73.15, "d": 0.06}, {"w": "chuyên", "t": 73.21, "d": 0.31}, {"w": "gia", "t": 73.52, "d": 0.17}, {"w": "pháp", "t": 73.69, "d": 0.27}, {"w": "y", "t": 73.96, "d": 0.26}, {"w": "âm", "t": 74.22, "d": 0.06}, {"w": "thanh,", "t": 74.28, "d": 0.475}, {"w": "ông", "t": 74.755, "d": 0.06}, {"w": "Ed", "t": 74.815, "d": 0.385}, {"w": "Primeau,", "t": 75.2, "d": 0.155}, {"w": "ba", "t": 75.355, "d": 0.215}, {"w": "mươi", "t": 75.57, "d": 0.36}, {"w": "năm", "t": 75.93, "d": 0.065}, {"w": "trong", "t": 75.995, "d": 0.375}, {"w": "nghề.", "t": 76.37, "d": 0.28}]}, {"text": "Ông so từng phụ âm của hai giọng, đặt cạnh nhau.", "start": 77.16, "end": 79.88, "words": [{"w": "Ông", "t": 77.215, "d": 0.16}, {"w": "so", "t": 77.375, "d": 0.18}, {"w": "từng", "t": 77.555, "d": 0.17}, {"w": "phụ", "t": 77.725, "d": 0.325}, {"w": "âm", "t": 78.05, "d": 0.185}, {"w": "của", "t": 78.235, "d": 0.21}, {"w": "hai", "t": 78.445, "d": 0.24}, {"w": "giọng,", "t": 78.685, "d": 0.215}, {"w": "đặt", "t": 78.9, "d": 0.285}, {"w": "cạnh", "t": 79.185, "d": 0.155}, {"w": "nhau.", "t": 79.34, "d": 0.31}]}, {"text": "Chỉ với giọng nói thường của bà, ông chắc chừng bảy mươi phần trăm.", "start": 80.2, "end": 83.4, "words": [{"w": "Chỉ", "t": 80.2, "d": 0.215}, {"w": "với", "t": 80.415, "d": 0.135}, {"w": "giọng", "t": 80.55, "d": 0.26}, {"w": "nói", "t": 80.81, "d": 0.215}, {"w": "thường", "t": 81.025, "d": 0.115}, {"w": "của", "t": 81.14, "d": 0.305}, {"w": "bà,", "t": 81.445, "d": 0.29}, {"w": "ông", "t": 81.735, "d": 0.07}, {"w": "chắc", "t": 81.805, "d": 0.34}, {"w": "chừng", "t": 82.145, "d": 0.085}, {"w": "bảy", "t": 82.23, "d": 0.245}, {"w": "mươi", "t": 82.475, "d": 0.165}, {"w": "phần", "t": 82.64, "d": 0.145}, {"w": "trăm.", "t": 82.785, "d": 0.365}]}, {"text": "Khi có bản bà đọc đúng những chữ Siri nói, ông kết luận.", "start": 83.72, "end": 86.84, "words": [{"w": "Khi", "t": 83.72, "d": 0.11}, {"w": "có", "t": 83.83, "d": 0.335}, {"w": "bản", "t": 84.165, "d": 0.18}, {"w": "bà", "t": 84.345, "d": 0.125}, {"w": "đọc", "t": 84.47, "d": 0.2}, {"w": "đúng", "t": 84.67, "d": 0.245}, {"w": "những", "t": 84.915, "d": 0.27}, {"w": "chữ", "t": 85.185, "d": 0.245}, {"w": "Siri", "t": 85.43, "d": 0.255}, {"w": "nói,", "t": 85.685, "d": 0.335}, {"w": "ông", "t": 86.02, "d": 0.06}, {"w": "kết", "t": 86.08, "d": 0.27}, {"w": "luận.", "t": 86.35, "d": 0.335}]}, {"text": "Chúng giống hệt nhau. Khớp một trăm phần trăm.", "start": 87.16, "end": 89.8, "words": [{"w": "Chúng", "t": 87.27, "d": 0.17}, {"w": "giống", "t": 87.44, "d": 0.35}, {"w": "hệt", "t": 87.79, "d": 0.06}, {"w": "nhau.", "t": 87.85, "d": 0.46}, {"w": "Khớp", "t": 88.31, "d": 0.205}, {"w": "một", "t": 88.515, "d": 0.215}, {"w": "trăm", "t": 88.73, "d": 0.16}, {"w": "phần", "t": 88.89, "d": 0.2}, {"w": "trăm.", "t": 89.09, "d": 0.385}]}, {"text": "Nhưng nếu đúng là bà, có một chỗ rất lạ.", "start": 90.8, "end": 92.96, "words": [{"w": "Nhưng", "t": 90.8, "d": 0.11}, {"w": "nếu", "t": 90.91, "d": 0.255}, {"w": "đúng", "t": 91.165, "d": 0.185}, {"w": "là", "t": 91.35, "d": 0.235}, {"w": "bà,", "t": 91.585, "d": 0.245}, {"w": "có", "t": 91.83, "d": 0.095}, {"w": "một", "t": 91.925, "d": 0.225}, {"w": "chỗ", "t": 92.15, "d": 0.165}, {"w": "rất", "t": 92.315, "d": 0.26}, {"w": "lạ.", "t": 92.575, "d": 0.215}]}, {"text": "Theo CNN, bà thu những bản ấy từ tám năm trước, khi chiếc điện thoại kia còn chưa ra đời.", "st