motion/hf/assets/long\ck-2026-kenh-dau-tu\ch00\data.js:1:window.CASE = {"topic": "ck-2026-kenh-dau-tu", "ch": "ch00", "dur": 74.58, "seed": 23076, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "MỞ ĐẦU", "t": "100 TRIỆU, NĂM KÊNH, MỘT NĂM"}, "acc": ["vn-index", "sjc", "bitcoin", "vàng", "tiết", "kiệm", "lạm", "phát", "thắng", "đỏ", "xanh"], "lines": [{"text": "Đầu năm hai nghìn không trăm hai mươi sáu, giả sử bạn có một trăm triệu đồng.", "start": 0.0, "end": 3.84, "words": [{"w": "Đầu", "t": 0.06, "d": 0.23}, {"w": "năm", "t": 0.29, "d": 0.155}, {"w": "hai", "t": 0.445, "d": 0.255}, {"w": "nghìn", "t": 0.7, "d": 0.14}, {"w": "không", "t": 0.84, "d": 0.2}, {"w": "trăm", "t": 1.04, "d": 0.225}, {"w": "hai", "t": 1.265, "d": 0.1}, {"w": "mươi", "t": 1.365, "d": 0.275}, {"w": "sáu,", "t": 1.64, "d": 0.145}, {"w": "giả", "t": 1.785, "d": 0.305}, {"w": "sử", "t": 2.09, "d": 0.085}, {"w": "bạn", "t": 2.175, "d": 0.28}, {"w": "có", "t": 2.455, "d": 0.085}, {"w": "một", "t": 2.54, "d": 0.295}, {"w": "trăm", "t": 2.835, "d": 0.075}, {"w": "triệu", "t": 2.91, "d": 0.18}, {"w": "đồng.", "t": 3.09, "d": 0.385}]}, {"text": "Bạn không muốn bỏ hết trứng vào một giỏ, nên chia đều cho năm kênh quen thuộc với nhiều người Việt.", "start": 4.16, "end": 8.88, "words": [{"w": "Bạn", "t": 4.215, "d": 0.215}, {"w": "không", "t": 4.43, "d": 0.095}, {"w": "muốn", "t": 4.525, "d": 0.255}, {"w": "bỏ", "t": 4.78, "d": 0.21}, {"w": "hết", "t": 4.99, "d": 0.17}, {"w": "trứng", "t": 5.16, "d": 0.24}, {"w": "vào", "t": 5.4, "d": 0.235}, {"w": "một", "t": 5.635, "d": 0.085}, {"w": "giỏ,", "t": 5.72, "d": 0.405}, {"w": "nên", "t": 6.125, "d": 0.06}, {"w": "chia", "t": 6.185, "d": 0.275}, {"w": "đều", "t": 6.46, "d": 0.155}, {"w": "cho", "t": 6.615, "d": 0.23}, {"w": "năm", "t": 6.845, "d": 0.075}, {"w": "kênh", "t": 6.92, "d": 0.275}, {"w": "quen", "