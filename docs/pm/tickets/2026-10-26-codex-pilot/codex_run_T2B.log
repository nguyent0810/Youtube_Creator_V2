.", "t": 57.75, "d": 0.23}]}, {"text": "Còn người mua có thể tự đổi ra tỷ suất trên giá mình trả.", "start": 58.68, "end": 61.72, "words": [{"w": "Còn", "t": 58.755, "d": 0.095}, {"w": "người", "t": 58.85, "d": 0.19}, {"w": "mua", "t": 59.04, "d": 0.235}, {"w": "có", "t": 59.275, "d": 0.13}, {"w": "thể", "t": 59.405, "d": 0.205}, {"w": "tự", "t": 59.61, "d": 0.135}, {"w": "đổi", "t": 59.745, "d": 0.23}, {"w": "ra", "t": 59.975, "d": 0.19}, {"w": "tỷ", "t": 60.165, "d": 0.235}, {"w": "suất", "t": 60.4, "d": 0.13}, {"w": "trên", "t": 60.53, "d": 0.255}, {"w": "giá", "t": 60.785, "d": 0.13}, {"w": "mình", "t": 60.915, "d": 0.225}, {"w": "trả.", "t": 61.14, "d": 0.21}]}, {"text": "Đó là cụm chữ thứ nhất. Và nó mới chỉ là chuyện số học.", "start": 62.04, "end": 65.56, "words": [{"w": "Đó", "t": 62.095, "d": 0.175}, {"w": "là", "t": 62.27, "d": 0.245}, {"w": "cụm", "t": 62.515, "d": 0.21}, {"w": "chữ", "t": 62.725, "d": 0.18}, {"w": "thứ", "t": 62.905, "d": 0.305}, {"w": "nhất.", "t": 63.21, "d": 0.205}, {"w": "Và", "t": 63.415, "d": 0.19}, {"w": "nó", "t": 63.605, "d": 0.17}, {"w": "mới", "t": 63.775, "d": 0.31}, {"w": "chỉ", "t": 64.085, "d": 0.225}, {"w": "là", "t": 64.31, "d": 0.075}, {"w": "chuyện", "t": 64.385, "d": 0.29}, {"w": "số", "t": 64.675, "d": 0.285}, {"w": "học.", "t": 64.96, "d": 0.26}]}, {"text": "Cụm thứ hai mới là chỗ nhiều người bất ngờ.", "start": 65.88, "end": 68.28, "words": [{"w": "Cụm", "t": 65.94, "d": 0.15}, {"w": "thứ", "t": 66.09, "d": 0.16}, {"w": "hai", "t": 66.25, "d": 0.185}, {"w": "mới", "t": 66.435, "d": 0.28}, {"w": "là", "t": 66.715, "d": 0.14}, {"w": "chỗ", "t": 66.855, "d": 0.11}, {"w": "nhiều", "t": 66.965, "d": 0.255}, {"w": "người", "t": 67.22, "d": 0.225}, {"w": "bất", "t": 67.445, "d": 0.135}, {"w": "ngờ.", "t": 67.58, "d": 0.275}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "1", "k": "CỤM CHỮ THỨ NHẤT", "title": "MƯỜI PHẦN TRĂM\nCỦA CÁI GÌ?", "sub": "CỔ TỨC BẰNG TIỀN · 10%", "vid": "v0", "illus": "VIDEO MINH