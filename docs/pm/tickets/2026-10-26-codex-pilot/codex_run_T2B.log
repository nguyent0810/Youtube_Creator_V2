motion/hf/assets/long\mim-dich-may\ch09\data.js:1:window.CASE = {"topic": "mim-dich-may", "ch": "ch09", "dur": 140.42, "seed": 11877, "accent": "#22d3ee", "look": {"name": "amber", "vars": {"--red": "#e39a2d", "--gold": "#f2cf86", "--paper": "#f2e7cf", "--bed1": "#1d150c", "--bed2": "#0c0905", "--serif": "'Literata'", "--sans": "'Montserrat'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 09", "t": "CỖ MÁY HỌC NHÌN LẠI"}, "acc": ["dịch", "máy", "vài", "năm", "lời", "hứa", "sổ", "pen", "cũi"], "lines": [{"text": "Tháng 9 năm 2014, có hai bài báo xuất hiện cách nhau chưa đầy mười ngày.", "start": 0.0, "end": 4.32, "words": [{"w": "Tháng", "t": 0.005, "d": 0.135}, {"w": "9", "t": 0.14, "d": 0.205}, {"w": "năm", "t": 0.345, "d": 0.29}, {"w": "2014,", "t": 0.635, "d": 1.175}, {"w": "có", "t": 1.81, "d": 0.175}, {"w": "hai", "t": 1.985, "d": 0.18}, {"w": "bài", "t": 2.165, "d": 0.23}, {"w": "báo", "t": 2.395, "d": 0.1}, {"w": "xuất", "t": 2.495, "d": 0.24}, {"w": "hiện", "t": 2.735, "d": 0.16}, {"w": "cách", "t": 2.895, "d": 0.25}, {"w": "nhau", "t": 3.145, "d": 0.13}, {"w": "chưa", "t": 3.275, "d": 0.08}, {"w": "đầy", "t": 3.355, "d": 0.34}, {"w": "mười", "t": 3.695, "d": 0.19}, {"w": "ngày.", "t": 3.885, "d": 0.22}]}, {"text": "Bài thứ nhất do Ilya Sutskever và các đồng nghiệp ở Google viết. Họ cho một mạng nơ-ron đọc cả câu tiếng Anh, nén nó thành một dãy số cố định.", "start": 5.12, "end": 13.44, "words": [{"w": "Bài", "t": 5.19, "d": 0.16}, {"w": "thứ", "t": 5.35, "d": 0.29}, {"w": "nhất", "t": 5.64, "d": 0.33}, {"w": "do", "t": 5.97, "d": 0.145}, {"w": "Ilya", "t": 6.115, "d": 0.36}, {"w": "Sutskever", "t": 6.475, "d": 0.14}, {"w": "và", "t": 6.615, "d": 0.125}, {"w": "các", "t": 6.74, "d": 0.415}, {"w": "đồng", "t": 7.155, "d": 0.22}, {"w": "nghiệp", "t": 7.375, "d": 0.135}, {"w": "ở", "t": 7.51, "d": 0.385}, {"w": "Google", "t": 7.895, "d": 0.055}, {"w": "viết.", "t": 7.95, "d": 0.445}, {"w": "Họ", "t": 8.395, "d": 0.355}, {"w": "cho", "t": 8.75, "d": 0.235}, {"w": "một", "t": 8.985, "d": 0.195}, {"w": "mạng", "t": 9.18, "d": 0.07}, {"w": "nơ-ron", "t": 9.25, "d": 0.52}, {"w": "đọc", "t": 9.77, "d": 0.195}, {"w": "cả", "t": 9.965, "d": 0.285}, {"w": "câu", "t": 10.25, "d": 0.385}, {"w": "tiếng", "t": 10.635, "d": 0.165}, {"w": "Anh,", "t": 10.8, "d": 0.46}, {"w": "nén", "t": 11.26, "d": 0.225}, {"w": "nó", "t": 11.485, "d": 0.115}, {"w": "thành", "t": 11.6, "d": 0.165}, {"w": "một", "t": 11.765, "d": 0.345}, {"w": "dãy", "t": 12.11, "d": 0.205}, {"w": "số", "t": 12.315, "d": 0.19}, {"w": "cố", "t": 12.505, "d": 0.295}, {"w": "định.", "t": 12.8, "d": 0.4}]}, {"text": "Rồi một mạng nơ-ron thứ hai đọc dãy số ấy, và viết ra câu tiếng Pháp.", "start": 13.76, "end": 17.2, "words": [{"w": "Rồi", "t": 13.81, "d": 0.24}, {"w": "một", "t": 14.05, "d": 0.16}, {"w": "mạng", "t": 14.21, "d": 0.155}, {"w": "nơ-ron", "t": 14.365, "d": 0.37}, {"w": "thứ", "t": 14.735, "d": 0.205}, {"w": "hai", "t": 14.94, "d": 0.17}, {"w": "đọc", "t": 15.11, "d": 0.065}, {"w": "dãy", "t": 15.175, "d": 0.19}, {"w": "số", "t": 15.365, "d": 0.245}, {"w": "ấy,", "t": 15.61, "d": 0.3}, {"w": "và", "t": 15.91, "d": 0.15}, {"w": "viết", "t": 16.06, "d": 0.07}, {"w": "ra", "t": 16.13, "d": 0.29}, {"w": "câu", "t": 16.42, "d": 0.16}, {"w": "tiếng", "t": 16.58, "d": 0.14}, {"w": "Pháp.", "t": 16.72, "d": 0.305}]}, {"text": "Điểm số đo mức giống bản dịch của người, tối đa một trăm. Với bài thi Anh sang Pháp, cách làm mới đạt ba mươi bốn phẩy tám.", "start": 18.2, "end": 24.36, "words": [{"w": "Điểm", "t": 18.2, "d": 0.18}, {"w": "số", "t": 18.38, "d": 0.265}, {"w": "đo", "t": 18.645, "d": 0.13}, {"w": "mức", "t": 18.775, "d": 0.235}, {"w": "giống", "t": 19.01, "d": 0.15}, {"w": "bản", "t": 19.16, "d": 0.125}, {"w": "dịch", "t": 19.285, "d": 0.15}, {"w": "của", "t": 19.435, "d": 0.355}, {"w": "người,", "t": 19.79, "d": 0.135}, {"w": "tối", "t": 19.925, "d": 0.345}, {"w": "đa", "t": 20.27, "d": 0.15}, {"w": "một", "t": 20.42, "d": 0.235}, {"w": "trăm.", "t": 20.655, "d": 0.245}, {"w": "Với", "t": 20.9, "d": 0.105}, {"w": "bài", "t": 21.005, "d": 0.28}, {"w": "thi", "t": 21.285, "d": 0.165}, {"w": "Anh", "t": 21.45, "d": 0.265}, {"w": "sang", "t": 21.715, "d": 0.19}, {"w": "Pháp,", "t": 21.905, "d": 0.3}, {"w": "cách", "t": 22.205, "d": 0.1}, {"w": "làm", "t": 22.305, "d": 0.18}, {"w": "mới", "t": 22.485, "d": 0.27}, {"w": "đạt", "t": 22.755, "d": 0.205}, {"w": "ba", "t": 22.96, "d": 0.185}, {"w": "mươi", "t": 23.145, "d": 0.195}, {"w": "bốn", "t": 23.34, "d": 0.105}, {"w": "phẩy", "t": 23.445, "d": 0.195}, {"w": "tám.", "t": 23.64, "d": 0.3}]}, {"text": "Hệ thống dịch theo cụm cùng bài thi đạt ba mươi ba phẩy ba.", "start": 24.68, "end": 27.72, "words": [{"w": "Hệ", "t": 24.68, "d": 0.105}, {"w": "thống", "t": 24.785, "d": 0.35}, {"w": "dịch", "t": 25.135, "d": 0.21}, {"w": "theo", "t": 25.345, "d": 0.195}, {"w": "cụm", "t": 25.54, "d": 0.135}, {"w": "cùng", "t": 25.675, "d": 0.085}, {"w": "bài", "t": 25.76, "d": 0.345}, {"w": "thi", "t": 26.105, "d": 0.14}, {"w": "đạt", "t": 26.245, "d": 0.235}, {"w": "ba", "t": 26.48, "d": 0.06}, {"w": "mươi", "t": 26.54, "d": 0.345}, {"w": "ba", "t": 26.885, "d": 0.215}, {"w": "phẩy", "t": 27.1, "d": 0.165}, {"w": "ba.", "t": 27.265, "d": 0.265}]}, {"text": "Còn một chi tiết lạ: họ đảo ngược thứ tự từ của câu nguồn, và điểm tăng rõ rệt.", "start": 28.72, "end": 32.64, "words": [{"w": "Còn", "t": 28.72, "d": 0.22}, {"w": "một", "t": 28.94, "d": 0.16}, {"w": "chi", "t": 29.1, "d": 0.11}, {"w": "tiết", "t": 29.21, "d": 0.3}, {"w": "lạ:", "t": 29.51, "d": 0.14}, {"w": "họ", "t": 29.65, "d": 0.18}, {"w": "đảo", "t": 29.83, "d": 0.34}, {"w": "ngược", "t": 30.17, "d": 0.185}, {"w": "thứ", "t": 30.355, "d": 0.18}, {"w": "tự", "t": 30.535, "d": 0.06}, {"w": "từ", "t": 30.595, "d": 0.185}, {"w": "của", "t": 30.78, "d": 0.155}, {"w": "câu", "t": 30.935, "d": 0.325}, {"w": "nguồn,", "t": 31.26, "d": 0.25}, {"w": "và", "t": 31.51, "d": 0.075}, {"w": "điểm", "t": 31.585, "d": 0.22}, {"w": "tăng", "t": 31.805, "d": 0.21}, {"w": "rõ", "t": 32.015, "d": 0.195}, {"w": "rệt.", "t": 32.21, "d": 0.28}]}, {"text": "Bài thứ hai, của Dzmitry Bahdanau, Kyunghyun Cho và Yoshua Bengio, chỉ ra cái yếu của cách làm thứ nhất.", "start": 33.64, "end": 39.48, "words": [{"w": "Bài", "t": 33.695, "d": 0.135}, {"w": "thứ", "t": 33.83, "d": 0.315}, {"w": "hai,", "t": 34.145, "d": 0.35}, {"w": "của", "t": 34.495, "d": 0.255}, {"w": "Dzmitry", "t": 34.75, "d": 0.45}, {"w": "Bahdanau,", "t": 35.2, "d": 0.205}, {"w": "Kyunghyun", "t": 35.405, "d": 0.285}, {"w": "Cho", "t": 35.69, "d": 0.2}, {"w": "và", "t": 35.89, "d": 0.345}, {"w": "Yoshua", "t": 36.235, "d": 0.23}, {"w": "Bengio,", "t": 36.465, "d": 0.315}, {"w": "chỉ", "t": 36.78, "d": 0.27}, {"w": "ra", "t": 37.05, "d": 0.445}, {"w": "cái", "t": 37.495, "d": 0.245}, {"w": "yếu", "t": 37.74, "d": 0.215}, {"w": "của", "t": 37.955, "d": 0.185}, {"w": "cách", "t": 38.14, "d": 0.135}, {"w": "làm", "t": 38.275, "d": 0.275}, {"w": "thứ", "t": 38.55, "d": 0.29}, {"w": "nhất.", "t": 38.84, "d": 0.45}]}, {"text": "Họ viết rằng ép cả câu vào một dãy số có độ dài cố định là một nút thắt cổ chai.", "start": 39.8, "end": 44.04, "words": [{"w": "Họ", "t": 39.8, "d": 0.13}, {"w": "viết", "t": 39.93, "d": 0.325}, {"w": "rằng", "t": 40.255, "d": 0.185}, {"w": "ép", "t": 40.44, "d": 0.19}, {"w": "cả", "t": 40.63, "d": 0.06}, {"w": "câu", "t": 40.69, "d": 0.15}, {"w": "vào", "t": 40.84, "d": 0.25}, {"w": "một", "t": 41.09, "d": 0.235}, {"w": "dãy", "t": 41.325, "d": 0.16}, {"w": "số", "t": 41.485, "d": 0.13}, {"w": "có", "t": 41.615, "d": 0.18}, {"w": "độ", "t": 41.795, "d": 0.24}, {"w": "dài", "t": 42.035, "d": 0.28}, {"w": "cố", "t": 42.315, "d": 0.165}, {"w": "định", "t": 42.48, "d": 0.11}, {"w": "là", "t": 42.59, "d": 0.12}, {"w": "một", "t": 42.71, "d": 0.35}, {"w": "nút", "t": 43.06, "d": 0.19}, {"w": "thắt", "t": 43.25, "d": 0.065}, {"w": "cổ", "t": 43.315, "d": 0.175}, {"w": "chai.", "t": 43.49, "d": 0.35}]}, {"