": "color", "illus": "ẢNH: VOA · 2018 · CÔNG CỘNG", "side": {"k": "SUSAN BENNETT", "h": "Chưa có\nchiếc điện thoại đó", "lines": [{"text": "Con trai: *Cameron* · theo CNN", "at": 30.48}]}, "t0": 27.24, "t1": 35.56}, {"type": "kinetic", "items": [{"text": "GIỌNG MẸ CẤT LÊN", "at": 36.26, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "104px", "left": "140px"}}, "em": "GIỌNG"}, {"text": "từ phần chỉ đường", "at": 38.15, "sm": true, "fx": "blur", "L": {"cls": "kC", "style": {"top": "407px", "fontSize": "58px", "left": "310px"}}}], "t0": 35.56, "t1": 40.2, "lay": "ladder"}, {"type": "slam", "text": "“MẸ, THÔI ĐI!”", "sub": "CAMERON BENNETT · THEO CNN", "t0": 40.2, "t1": 43.04, "at": 40.35, "fx": "outline"}, {"type": "kinetic", "items": [{"text": "LẦN ĐẦU NÓI CHUYỆN VỚI CHÍNH MÌNH", "at": 43.74, "acc": true, "fx": "flicker", "em": "CHUYỆN"}, {"text": "hơi hoảng · theo CNN", "at": 46.45, "sm": true, "fx": "rise"}], "t0": 43.04, "t1": 49.44, "lay": "stack"}, {"type": "quote", "dy": true, "text": "Choáng ngợp vì được góp phần vào một kỳ công công nghệ.", "by": "SUSAN BENNETT · THEO CNN, 2013", "lbl": "DIỄN Ý", "typeDur": 2.0, "t0": 49.44, "t1": 53.56, "at": 49.49}, {"type": "kinetic", "items": [{"text": "CHƯA BAO GIỜ QUÁT SIRI", "at": 53.96, "acc": true, "fx": "marker", "L": {"cls": "kC", "style": {"top": "770px", "fontSize": "85px"}}, "D": [{"kind": "bar", "style": {"top": "770px", "height": "90px"}, "at": 53.71}], "em": "CHƯA"}], "t0": 53.56, "t1": 56.44, "lay": "corner"}, {"type": "quote", "text": "But I never yell at her – very bad karma.", "by": "SUSAN BENNETT · CNN, 04.10.2013", "lbl": "TRÍCH DỊCH", "qline": 15, "t0": 56.44, "t1": 57.72, "at": 56.505, "typeDur": 0.911, "voiceAt": 56.44, "voiceEnd": 57.4, "radio": true}, {"type": "kinetic", "items": [{"text": "MỖI NGÀY BỊ CHỬI BAO NHIÊU LẦN?", "at": 58.12, "acc": true, "fx": "outline", "L": {"cls": "kC", "style": {"top": "250px", "fontSize": "67px", "left": "140px"}}, "em": "NHIÊU"}, {"text": "lời bà đùa · diễn ý theo CNN", "at": 57.72, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "358px", "fontSize": "58px", "left": "310px"}}}], "t0": 57.72, "t1": 62.0, "lay": "ladder"}, {"type": "source", "source": "APPLE NEWSROOM · 10.06.2013", "ref": "APPLE GIỚI THIỆU IOS 7", "snippet": "Siri [[có giọng nam và giọng nữ mới]]", "hlAt": 67.71, "seal": "DỊCH TỪ THÔNG CÁO", "sealAt": 68.835, "t0": 62.0, "t1": 69.76}, {"type": "ledger", "title": "THỜI CỦA MỘT GIỌNG NÓI", "srcnote": "CNN · 04.10.2013", "rows": [{"k": "2011", "v": "GIỌNG SIRI Ở MỸ · THEO CNN", "at": 69.76}, {"k": "IOS 7", "v": "GIỌNG MỚI · DẦN KHÉP LẠI", "at": 72.55}, {"k": "BÀ BENNETT", "v": "HƠI TIẾC · QUEN CÔNG NGHỆ ĐỔI", "at": 73.6}], "t0": 69.76, "t1": 78.92}, {"type": "question", "text": "Giọng mới được làm thế nào,\nvà vì sao nghe giống người hơn?", "t0": 78.92, "t1": 84.94}], "prog0": 0.70274, "prog1": 0.83676};
motion/hf/assets/long\ck-e3-no-the-tin-dung\ch05\data.js:1:window.CASE = {"topic": "ck-e3-no-the-tin-dung", "ch": "ch05", "dur": 86.46, "seed": 28705, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "DÒNG 04", "t": "PHÍ CHẬM TRẢ"}, "acc": ["tối", "thiểu", "lãi", "sao", "kê", "đủ", "phí"], "lines": [{"text": "Dòng cuối cùng là dòng nhỏ nhất, và nhiều người không đọc.", "start": 0.0, "end": 3.04, "words": [{"w": "Dòng", "t": 0.055, "d": 0.225}, {"w": "cuối", "t": 0.28, "d": 0.16}, {"w": "cùng", "t": 0.44, "d": 0.12}, {"w": "là", "t": 0.56, "d": 0.3}, {"w": "dòng", "t": 0.86, "d": 0.085}, {"w": "nhỏ", "t": 0.945, "d": 0.31}, {"w": "nhất,", "t": 1.255, "d": 0.335}, {"w": "và", "t": 1.59, "d": 0.065}, {"w": "nhiều", "t": 1.655, "d": 0.26}, {"w": "người", "t": 1.915, "d": 0.265}, {"w": "không", "t": 2.18, "d": 0.155}, {"w": "đọc.", "t": 2.335, "d": 0.31}]}, {"text": "Phí chậm thanh toán.", "start": 3.84, "end": 5.04, "words": [{"w": "Phí", "t": 3.94, "d": 0.125}, {"w": "chậm", "t": 4.065, "d": 0.225}, {"w": "thanh", "t": 4.29, "d": 0.2}, {"w": "toán.", "t": 4.49, "d": 0.27}]}, {"text": "Nếu tới hạn mà bạn không trả nổi cả mức tối thiểu, hai việc cùng xảy ra.", "start": 6.04, "end": 10.04, "words": [{"w": "Nếu", "t": 6.125, "d": 0.18}, {"w": "tới", "t": 6.305, "d": 0.17}, {"w": "hạn", "t": 6.475, "d": 0.15}, {"w": "mà", "t": 6.625, "d": 0.34}, {"w": "bạn", "t": 6.965, "d": 0.08}, {"w": "không", "t": 7.045, "d": 0.17}, {"w": "trả", "t": 7.215, "d": 0.37}, {"w": "nổi", "t": 7.585, "d": 0.06}, {"w": "cả", "t": 7.645, "d": 0.335}, {"w": "mức", "t": 7.98, "d": 0.06}, {"w": "tối", "t": 8.04, "d": 0.205}, {"w": "thiểu,", "t": 8.245, "d": 0.4}, {"w": "hai", "t": 8.645, "d": 0.07}, {"w": "việc", "t": 8.715, "d": 0.365}, {"w": "cùng", "t": 9.08, "d": 0.06}, {"w": "xảy", "t": 9.14, "d": 0.245}, {"w": "ra.", "t": 9.385, "d": 0.325}]}, {"text": "Một, bạn chịu phí phạt chậm trả.", "start": 10.36, "end": 12.44, "words": [{"w": "Một,", "t": 10.42, "d": 0.33}, {"w": "bạn", "t": 10.75, "d": 0.29}, {"w": "chịu", "t": 11.04, "d": 0.205}, {"w": "phí", "t": 11.245, "d": 0.205}, {"w": "phạt", "t": 11.45, "d": 0.205}, {"w": "chậm", "t": 11.655, "d": 0.06}, {"w": "trả.", "t": 11.715, "d": 0.39}]}, {"text": "Hai, khoản nợ có thể chuyển sang lãi suất quá hạn, cao hơn mức thông thường.", "start": 12.76, "end": 16.84, "words": [{"w": "Hai,", "t": 12.865, "d": 0.41}, {"w": "khoản", "t": 13.275, "d": 0.06}, {"w": "nợ", "t": 13.335, "d": 0.34}, {"w": "có", "t": 13.675, "d": 0.135}, {"w": "thể", "t": 13.81, "d": 0.15}, {"w": "chuyển", "t": 13.96, "d": 0.295}, {"w": "sang", "t": 14.255, "d": 0.225}, {"w": "lãi", "t": 14.48, "d": 0.225}, {"w": "suất", "t": 14.705, "d": 0.06}, {"w": "quá", "t": 14.765, "d": 0.35}, {"w": "hạn,", "t": 15.115, "d": 0.255}, {"w": "cao", "t": 15.37, "d": 0.105}, {"w": "hơn", "t": 15.475, "d": 0.22}, {"w": "mức", "t": 15.695, "d": 0.36}, {"w": "thông", "t": 16.055, "d": 0.205}, {"w": "thường.", "t": 16.26, "d": 0.24}]}, {"text": "Mức cụ thể tuỳ từng hợp đồng.", "start": 17.16, "end": 18.92, "words": [{"w": "Mức", "t": 17.21, "d": 0.155}, {"w": "cụ", "t": 17.365, "d": 0.185}, {"w": "thể", "t": 17.55, "d": 0.225}, {"w": "tuỳ", "t": 17.775, "d": 0.21}, {"w": "từng", "t": 17.985, "d": 0.18}, {"w": "hợp", "t": 18.165, "d": 0.13}, {"w": "đồng.", "t": 18.295, "d": 0.255}]}, {"text": "Và nếu tháng sau vẫn không trả, phí và lãi ấy được cộng vào số nợ.", "start": 19.92, "end": 23.84, "words": [{"w": "Và", "t": 19.98, "d": 0.145}, {"w": "nếu", "t": 20.125, "d": 0.22}, {"w": "tháng", "t": 20.345, "d": 0.255}, {"w": "sau", "t": 20.6, "d": 0.205}, {"w": "vẫn", "t": 20.805, "d": 0.155}, {"w": "không", "t": 20.96, "d": 0.2}, {"w": "trả,", "t": 21.16, "d": 0.425}, {"w": "phí", "t": 21.585, "d": 0.06}, {"w": "và", "t": 21.645, "d": 0.35}, {"w": "lãi", "t": 21.995, "d": 0.205}, {"w": "ấy", "t": 22.2, "d": 0.06}, {"w": "được", "t": 22.26, "d": 0.345}, {"w": "cộng", "t": 22.605, "d": 0.06}, {"w": "vào", "t": 22.665, "d": 0.23}, {"w": "số", "t": 22.895, "d": 0.26}, {"w": "nợ.", "t": 23.155, "d": 0.295}]}, {"text": "Rồi lãi tiếp tục tính trên con số mới.", "start": 24.16, "end": 26.56, "words": [{"w": "Rồi", "t": 24.29, "d": 0.28}, {"w": "lãi", "t": 24.57, "d": 0.15}, {"w": "tiếp", "t": 24.72, "d": 0.16}, {"w": "tục", "t": 24.88, "d": 0.205}, {"w": "tính", "t": 25.085, "d": 0.225}, {"w": "trên", "t": 25.31, "d": 0.21}, {"w": "con", "t": 25.52, "d": 0.235}, {"w": "số", "t": 25.755, "d": 0.055}, {"w": "mới.", "t": 25.81, "d": 0.38}]}, {"text": "Lãi mẹ đẻ lãi con.", "start": 26.88, "end": 28.32, "words": [{"w": "Lãi", "t": 26.93, "d": 0.115}, {"w": "mẹ", "t": 27.045, "d": 0.245}, {"w": "đẻ", "t": 27.29, "d": 0.225}, {"w": "lãi", "t": 27.515, "d": 0.25}, {"w": "con.", "t": 27.765, "d": 0.23}]}, {"text": "Giờ quay lại con số ở đầu video.", "start": 29.32, "end": 31.48, "words": [{"w": "Giờ", "t": 29.38, "d": 0.18}, {"w": "quay", "t": 29.56, "d": 0.295}, {"w": "lại", "t": 29.855, "d": 0.06}, {"w": "con", "t": 29.915, "d": 0.24}, {"w": "số", "t": 30.155, "d": 0.17}, {"w": "ở", "t": 30.325, "d": 0.185}, {"w": "đầu", "t": 30.51, "d": 0.215}, {"w": "video.", "t": 30.725, "d": 0.34}]}, {"text": "Ngân hàng không công bố bảng tính chi tiết, nên mình chỉ làm một phép tính ngược.", "start": 31.8, "end": 35.88, "words": [{"w": "Ngân", "t": 31.86, "d": 0.165}, {"w": "hàng", "t": 32.025, "d": 0.255}, {"w": "không", "t": 32.28, "d": 0.195}, {"w": "công", "t": 32.475, "d": 0.195}, {"w": "bố", "t": 32.67, "d": 0.155}, {"w": "bảng", "t": 32.825, "d": 0.265}, {"w": "tính", "t": 33.09, "d": 0.22}, {"w": "chi", "t": 33.31, "d": 0.2}, {"w": "tiết,", "t": 33.51, "d": 0.345}, {"w": "nên", "t": 33.855, "d": 0.08}, {"w": "mình", "t": 33.935, "d": 0.22}, {"w": "chỉ", "t": 34.155, "d": 0.26}, {"w": "làm", "t": 34.415, "d": 0.19}, {"w": "một", "t": 34.605, "d": 0.295}, {"w": "phép", "t": 34.9, "d": 0.06}, {"w": "tính", "t": 34.96, "d": 0.22}, {"w": "ngược.", "t": 35.18, "d": 0.365}]}, {"text": "Muốn tám triệu rưỡi thành tám tỷ tám sau mười một năm, khoản nợ phải lớn thêm khoảng năm phẩy bốn phần trăm mỗi tháng.", "start": 36.2, "end": 41.96, "words": [{"w": "Muốn", "t": 36.27, "d": 0.225}, {"w": "tám", "t": 36.495, "d": 0.195}, {"w": "triệu", "t": 36.69, "d": 0.215}, {"w": "rưỡi", "t": 36.905, "d": 0.205}, {"w": "thành", "t": 37.11, "d": 0.21}, {"w": "tám", "t": 37.32, "d": 0.255}, {"w": "tỷ", "t": 37.575, "d": 0.165}, {"w": "tám", "t": 37.74, "d": 0.255}, {"w": "sau", "t": 37.995, "d": 0.06}, {"w": "mười", "t": 38.055, "d": 0.255}, {"w": "một", "t": 38.31, "d": 0.195}, {"w": "năm,", "t": 38.505, "d": 0.375}, {"w": "khoản", "t": 38.88, "d": 0.08}, {"w": "nợ", "t": 38.96, "d": 0.385}, {"w": "phải", "t": 39.345, "d": 0.13}, {"w": "lớn", "t": 39.475, "d": 0.185}, {"w": "thêm", "t": 39.66, "d": 0.185}, {"w": "khoảng", "t": 39.845, "d": 0.23}, {"w": "năm", "t": 40.075, "d": 0.13}, {"w": "phẩy", "t": 40.205, "d": 0.27}, {"w": "bốn", "t": 40.475, "d": 0.125}, {"w": "phần", "t": 40.6, "d": 0.215}, {"w": "trăm", "t": 40.815, "d": 0.205}, {"w": "mỗi", "t": 41.02, "d": 0.345}, {"w": "tháng.", "t": 41.365, "d": 0.27}]}, {"text": "Tháng nào cũng vậy. Không một lần trả.", "start": 42.28, "end": 44.68, "words": [{"w": "Tháng", "t": 42.35, "d": 0.16}, {"w": "nào", "t": 42.51, "d": 0.2}, {"w": "cũng", "t": 42.71, "d": 0.365}, {"w": "vậy.", "t": 43.075, "d": 0.19}, {"w": "Không", "t": 43.265, "d": 0.18}, {"w": "một", "t": 43.445, "d": 0.395}, {"w": "lần", "t": 43.84, "d": 0.22}, {"w": "trả.", "t": 44.06, "d": 0.255}]}, {"text": "Năm phẩy bốn phần trăm một tháng, nghe có vẻ nhỏ.", "start": 45.68, "end": 48.48, "words": [{"w": "Năm", "t": 45.72, "d": 0.21}, {"w": "phẩy", "t": 45.93, "d": 0.145}, {"w": "bốn", "t": 46.075, "d": 0.22}, {"w": "phần", "t": 46.295, "d": 0.165}, {"w": "trăm", "t": 46.46, "d": 0.33}, {"w": "một", "t": 46.79, "d": 0.06}, {"w": "tháng,", "t": 46.85, "d": 0.415}, {"w": "nghe", "t": 47.265, "d": 0.06}, {"w": "có", "t": 47.325, "d": 0.27}, {"w": "vẻ", "t": 47.595, "d": 0.15}, {"w": "nhỏ.", "t": 47.745, "d": 0.385}]}, {"text": "Nhưng cộng dồn, nó khiến món nợ gấp gần đôi sau mỗi năm.", "start": 48.8, "end": 52.08, "words": [{"w": "Nhưng", "t": 48.9, "d": 0.165}, {"w": "cộng", "t": 49.065, "d": 0.22}, {"w": "dồn,", "t": 49.285, "d": 0.33}, {"w": "nó", "t": 49.615, "d": 0.11}, {"w": "khiến", "t": 49.725, "d": 0.205}, {"w": "món", "t": 49.93, "d": 0.21}, {"w": "nợ", "t": 50.14, "d": 0.35}, {"w": "gấp", "t": 50.49, "d": 0.205}, {"w": "gần", "t": 50.695, "d": 0.06}, {"w": "đôi", "t": 50.755, "d": 0.23}, {"w": "sau", "t": 50.985, "d": 0.26}, {"w": "mỗi", "t": 51.245, "d": 0.23}, {"w": "năm.", "t": 51.475, "d": 0.255}]}, {"text": "Gấp gần đôi, mười một lần liền, thành hơn một nghìn lần.", "start": 52.4, "end": 55.6, "words": [{"w": "Gấp", "t": 52.515, "d": 0.165}, {"w": "gần", "t": 52.68, "d": 0.255}, {"w": "đôi,", "t": 52.935, "d": 0.335}, {"w": "mười", "t": 53.27, "d": 0.06}, {"w": "một", "t": 53.33, "d": 0.32}, {"w": "lần", "t": 53.65, "d": 0.2}, {"w": "liền,", "t": 53.85, "d": 0.365}, {"w": "thành", "t": 54.215, "d": 0.06}, {"w": "hơn", "t": 54.275, "d": 0.215}, {"w": "một", "t": 54.49, "d": 0.32}, {"w": "nghìn", "t": 54.81, "d": 0.185}, {"w": "lần.", "t": 54.995, "d": 0.245}]}, {"text": "Đó là sức mạnh của thời gian, khi nó đứng về phía khoản nợ.", "start": 56.6, "end": 60.04, "words": [{"w": "Đó", "t": 56.705, "d": 0.265}, {"w": "là", "t": 56.97, "d": 0.2}, {"w": "sức", "t": 57.17, "d": 0.18}, {"w": "mạnh", "t": 57.35, "d": 0.1}, {"w": "của", "t": 57.45, "d": 0.185}, {"w": "thời", "t": 57.635, "d": 0.215}, {"w": "gian,", "t": 57.85, "d": 0.42}, {"w": "khi", "t": 58.27, "d": 0.06}, {"w": "nó", "t": 58.33, "d": 0.33}, {"w": "đứng", "t": 58.66, "d": 0.06}, {"w": "về", "t": 58.72, "d": 0.22}, {"w": "phía", "t": 58.94, "d": 0.18}, {"w": "khoản", "t": 59.12, "d": 0.19}, {"w": "nợ.", "t": 59.31, "d": 0.365}]}, {"text": "Một khoản nhỏ bị bỏ quên lâu, đáng sợ hơn một khoản lớn được trả dần.", "start": 60.36, "end": 64.12, "words": [{"w": "Một", "t": 60.42, "d": 0.145}, {"w": "khoản", "t": 60.565, "d": 0.32}, {"w": "nhỏ", "t": 60.885, "d": 0.08}, {"w": "bị", "t": 60.965, "d": 0.14}, {"w": "bỏ", "t": 61.105, "d": 0.25}, {"w": "quên", "t": 61.355, "d": 0.19}, {"w": "lâu,", "t": 61.545, "d": 0.42}, {"w": "đáng", "t": 61.965, "d": 0.06}, {"w": "sợ", "t": 62.025, "d": 0.27}, {"w": "hơn", "t": 62.295, "d": 0.145}, {"w": "một", "t": 62.44, "d": 0.3}, {"w": "khoản", "t": 62.74, "d": 0.06}, {"w": "lớn", "t": 62.8, "d": 0.165}, {"w": "được", "t": 62.965, "d": 0.345}, {"w": "trả", "t": 63.31, "d": 0.07}, {"w": "dần.", "t": 63.38, "d": 0.36}]}, {"text": "Vụ việc ấy còn nhiều điều hai bên chưa thống nhất, và mình không kết luận thay ai.", "start": 64.44, "end": 68.68, "words": [{"w": "Vụ", "t": 64.495, "d": 0.165}, {"w": "việc", "t": 64.66, "d": 0.165}, {"w": "ấy", "t": 64.825, "d": 0.255}, {"w": "còn", "t": 65.08, "d": 0.205}, {"w": "nhiều", "t": 65.285, "d": 0.18}, {"w": "điều", "t": 65.465, "d": 0.22}, {"w": "hai", "t": 65.685, "d": 0.17}, {"w": "bên", "t": 65.855, "d": 0.22}, {"w": "chưa", "t": 66.075, "d": 0.175}, {"w": "thống", "t": 66.25, "d": 0.315}, {"w": "nhất,", "t": 66.565, "d": 0.17}, {"w": "và", "t": 66.735, "d": 0.17}, {"w": "mình", "t": 66.905, "d": 0.375}, {"w": "không", "t": 67.28, "d": 0.2}, {"w": "kết", "t": 67.48, "d": 0.06}, {"w": "luận", "t": 67.54, "d": 0.335}, {"w": "thay", "t": 67.875, "d": 0.06}, {"w": "ai.", "t": 67.935, "d": 0.375}]}, {"text": "Nhưng con số thì dạy ta một điều rất rõ: đừng để một tờ sao kê nằm im.", "start": 69.0, "end": 73.16, "words": [{"w": "Nhưng", "t": 69.055, "d": 0.135}, {"w": "con", "t": 69.19, "d": 0.21}, {"w": "số", "t": 69.4, "d": 0.2}, {"w": "thì", "t": 69.6, "d": 0.315}, {"w": "dạy", "t": 69.915, "d": 0.06}, {"w": "ta", "t": 69.975, "d": 0.31}, {"w": "một", "t": 70.285, "d": 0.215}, {"w": "điều", "t": 70.5, "d": 0.14}, {"w": "rất", "t": 70.64, "d": 0.08}, 