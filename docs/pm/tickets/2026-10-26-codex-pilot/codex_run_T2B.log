d": 0.295}, {"w": "giao", "t": 79.82, "d": 0.09}, {"w": "dịch.", "t": 79.91, "d": 0.3}]}, {"text": "Lấy mức phí không phẩy mười lăm phần trăm mỗi chiều, một vòng mua rồi bán tốn khoảng không phẩy bốn phần trăm số tiền.", "start": 80.92, "end": 86.68, "words": [{"w": "Lấy", "t": 81.02, "d": 0.26}, {"w": "mức", "t": 81.28, "d": 0.075}, {"w": "phí", "t": 81.355, "d": 0.205}, {"w": "không", "t": 81.56, "d": 0.195}, {"w": "phẩy", "t": 81.755, "d": 0.29}, {"w": "mười", "t": 82.045, "d": 0.21}, {"w": "lăm", "t": 82.255, "d": 0.145}, {"w": "phần", "t": 82.4, "d": 0.28}, {"w": "trăm", "t": 82.68, "d": 0.085}, {"w": "mỗi", "t": 82.765, "d": 0.375}, {"w": "chiều,", "t": 83.14, "d": 0.21}, {"w": "một", "t": 83.35, "d": 0.235}, {"w": "vòng", "t": 83.585, "d": 0.11}, {"w": "mua", "t": 83.695, "d": 0.335}, {"w": "rồi", "t": 84.03, "d": 0.185}, {"w": "bán", "t": 84.215, "d": 0.25}, {"w": "tốn", "t": 84.465, "d": 0.22}, {"w": "khoảng", "t": 84.685, "d": 0.06}, {"w": "không", "t": 84.745, "d": 0.195}, {"w": "phẩy", "t": 84.94, "d": 0.23}, {"w": "bốn", "t": 85.17, "d": 0.16}, {"w": "phần", "t": 85.33, "d": 0.23}, {"w": "trăm", "t": 85.56, "d": 0.175}, {"w": "số", "t": 85.735, "d": 0.375}, {"w": "tiền.", "t": 86.11, "d": 0.24}]}, {"text": "Tài khoản năm mươi triệu, mỗi tháng xoay hết vốn hai lần, một năm trả khoảng bốn triệu tám trăm nghìn đồng phí và thuế.", "start": 87.0, "end": 93.08, "words": [{"w": "Tài", "t": 87.045, "d": 0.125}, {"w": "khoản", "t": 87.17, "d": 0.325}, {"w": "năm", "t": 87.495, "d": 0.195}, {"w": "mươi", "t": 87.69, "d": 0.295}, {"w": "triệu,", "t": 87.985, "d": 0.17}, {"w": "mỗi", "t": 88.155, "d": 0.3}, {"w": "tháng", "t": 88.455, "d": 0.28}, {"w": "xoay", "t": 88.735, "d": 0.15}, {"w": "hết", "t": 88.885, "d": 0.185}, {"w": "vốn", "t": 89.07, "d": 0.22}, {"w": "hai", "t": 89.29, "d": 0.3}, {"w": "lần,", "t": 89.59, "d": 0.215}, {"w": "một", "t": 89.805, "d": 0.17}, {"w": "năm", "t": 89.975, "d": 0.215}, {"w": "trả", "t": 90.19, "d": 0.22}, {"w": "khoảng", "t": 90.41, "d": 0.195}, {"w": "bốn", "t": 90.605, "d": 0.215}, {"w": "triệu", "t": 90.82, "d": 0.255}, {"w": "tám", "t": 91.075, "d": 0.245}, {"w": "trăm", "t": 91.32, "d": 0.195}, {"w": "nghìn", "t": 91.515, "d": 0.31}, {"w": "đồng", "t": 91.825, "d": 0.24}, {"w": "phí", "t": 92.065, "d": 0.06}, {"w": "và", "t": 92.125, "d": 0.34}, {"w": "thuế.", "t": 92.465, "d": 0.28}]}, {"text": "Gần mười phần trăm số vốn, hơn nửa tháng lương của người thu nhập chín triệu.", "start": 93.4, "end": 97.24, "words": [{"w": "Gần", "t": 93.455, "d": 0.115}, {"w": "mười", "t": 93.57, "d": 0.25}, {"w": "phần", "t": 93.82, "d": 0.16}, {"w": "trăm", "t": 93.98, "d": 0.24}, {"w": "số", "t": 94.22, "d": 0.155}, {"w": "vốn,", "t": 94.375, "d": 0.375}, {"w": "hơn", "t": 94.75, "d": 0.12}, {"w": "nửa", "t": 94.87, "d": 0.37}, {"w": "tháng", "t": 95.24, "d": 0.065}, {"w": "lương", "t": 95.305, "d": 0.16}, {"w": "của", "t": 95.465, "d": 0.29}, {"w": "người", "t": 95.755, "d": 0.13}, {"w": "thu", "t": 95.885, "d": 0.205}, {"w": "nhập", "t": 96.09, "d": 0.34}, {"w": "chín", "t": 96.43, "d": 0.06}, {"w": "triệu.", "t": 96.49, "d": 0.375}]}, {"text": "Thứ tư: vay ký quỹ, hay margin.", "start": 98.24, "end": 100.8, "words": [{"w": "Thứ", "t": 98.31, "d": 0.14}, {"w": "tư:", "t": 98.45, "d": 0.38}, {"w": "vay", "t": 98.83, "d": 0.27}, {"w": "ký", "t": 99.1, "d": 0.24}, {"w": "quỹ,", "t": 99.34, "d": 0.36}, {"w": "hay", "t": 99.7, "d": 0.275}, {"w": "margin.", "t": 99.975, "d": 0.465}]}, {"text": "Nó giống một chiếc kính lúp, phóng to cả lãi lẫn lỗ, và kính lúp này phải trả tiền thuê.", "start": 101.12, "end": 106.08, "words": [{"w": "Nó", "t": 101.23, "d": 0.185}, {"w": "giống", "t": 101.415, "d": 0.295}, {"w": "một", "t": 101.71, "d": 0.175}, {"w": "chiếc", "t": 101.885, "d": 0.18}, {"w": "kính", "t": 102.065, "d": 0.275}, {"w": "lúp,", "t": 102.34, "d": 0.165}, {"w": "phóng", "t": 102.505, "d": 0.37}, {"w": "to", "t": 102.875, "d": 0.2}, {"w": "cả", "t": 103.075, "d": 0.11}, {"w": "lãi", "t": 103.185, "d": 0.185}, {"w": "lẫn", "t": 103.37, "d": 0.165}, {"w": "lỗ,", "t": 103.535, "d": 0.48}, {"w": "và", "t": 104.015, "d": 0.06}, {"w": "kính", "t": 104.075, "d": 0.185}, {"w": "lúp", "t": 104.26, "d": 0.335}, {"w": "này", "t": 104.595, "d": 0.25}, {"w": "phải", "t": 104.845, "d": 0.2}, {"w": "trả", "t": 105.045, "d": 0.21}, {"w": "tiền", "t": 105.255, "d": 0.2}, {"w": "thuê.", "t": 105.455, "d": 0.25}]}, {"text": "Giả sử bạn có năm mươi triệu, vay thêm năm mươi triệu với lãi mười ba phẩy năm phần trăm một năm, mức phổ biến đầu năm nay.", "start": 106.4, "end": 112.8, "words": [{"w": "Giả", "t": 106.485, "d": 0.24}, {"w": "sử", "t": 106.725, "d": 0.18}, {"w": "bạn", "t": 106.905, "d": 0.215}, {"w": "có", "t": 107.12, "d": 0.175}, {"w": "năm", "t": 107.295, "d": 0.24}, {"w": "mươi", "t": 107.535, "d": 0.235}, {"w": "triệu,", "t": 107.77, "d": 0.175}, {"w": "vay", "t": 107.945, "d": 0.17}, {"w": "thêm", "t": 108.115, "d": 0.255}, {"w": "năm", "t": 108.37, "d": 0.235}, {"w": "mươi", "t": 108.605, "d": 0.215}, {"w": "triệu", "t": 108.82, "d": 0.27}, {"w": "với", "t": 109.09, "d": 0.2}, {"w": "lãi", "t": 109.29, "d": 0.06}, {"w": "mười", "t": 109.35, "d": 0.275}, {"w": "ba", "t": 109.625, "d": 0.23}, {"w": "phẩy", "t": 109.855, "d": 0.185}, {"w": "năm", "t": 110.04, "d": 0.175}, {"w": "phần", "t": 110.215, "d": 0.21}, {"w": "trăm", "t": 110.425, "d": 0.255}, {"w": "một", "t": 110.68, "d": 0.06}, {"w": "năm,", "t": 110.74, "d": 0.385}, {"w": "mức", "t": 111.125, "d": 0.155}, {"w": "phổ", "t": 111.28, "d": 0.28}, {"w": "biến", "t": 111.56, "d": 0.12}, {"w": "đầu", "t": 111.68, "d": 0.23}, {"w": "năm", "t": 111.91, "d": 0.27}, {"w": "nay.", "t": 112.18, "d": 0.265}]}, {"text": "Sáu tháng sau, cổ phiếu giảm mười phần trăm.", "start": 113.12, "end": 115.76, "words": [{"w": "Sáu", "t": 113.24, "d": 0.245}, {"w": "tháng", "t": 113.485, "d": 0.255}, {"w": "sau,", "t": 113.74, "d": 0.315}, {"w": "cổ", "t": 114.055, "d": 0.095}, {"w": "phiếu", "t": 114.15, "d": 0.215}, {"w": "giảm", "t": 114.365, "d": 0.245}, {"w": "mười", "t": 114.61, "d": 0.175}, {"w": "phần", "t": 114.785, "d": 0.205}, {"w": "trăm.", "t": 114.99, "d": 0.36}]}, {"text": "Không vay, bạn mất mười phần trăm. Có vay, bạn mất gần hai mươi bảy phần trăm vốn của mình.", "start": 116.08, "end": 120.96, "words": [{"w": "Không", "t": 116.185, "d": 0.18}, {"w": "vay,", "t": 116.365, "d": 0.32}, {"w": "bạn", "t": 116.685, "d": 0.205}, {"w": "mất", "t": 116.89, "d": 0.23}, {"w": "mười", "t": 117.12, "d": 0.16}, {"w": "phần", "t": 117.28, "d": 0.285}, {"w": "trăm.", "t": 117.565, "d": 0.23}, {"w": "Có", "t": 117.795, "d": 0.26}, {"w": "vay,", "t": 118.055, "d": 0.34}, {"w": "bạn", "t": 118.395, "d": 0.06}, {"w": "mất", "t": 118.455, "d": 0.16}, {"w": "gần", "t": 118.615, "d": 0.29}, {"w": "hai", "t": 118.905, "d": 0.245}, {"w": "mươi", "t": 119.15, "d": 0.12}, {"w": "bảy", "t": 119.27, "d": 0.155}, {"w": "phần", "t": 119.425, "d": 0.22}, {"w": "trăm", "t": 119.645, "d": 0.16}, {"w": "vốn", "t": 119.805, "d": 0.23}, {"w": "của", "t": 120.035, "d": 0.26}, {"w": "mình.", "t": 120.295, "d": 0.305}]}, {"text": "Kể cả khi cổ phiếu đứng yên suốt sáu tháng, tiền lãi vẫn lấy đi gần bảy phần trăm vốn.", "start": 121.28, "end": 126.16, "words": [{"w": "Kể", "t": 121.39, "d": 0.135}, {"w": "cả", "t": 121.525, "d": 0.335}, {"w": "khi", "t": 121.86, "d": 0.23}, {"w": "cổ", "t": 122.09, "d": 0.19}, {"w": "phiếu", "t": 122.28, "d": 0.18}, {"w": "đứng", "t": 122.46, "d": 0.265}, {"w": "yên", "t": 122.725, "d": 0.115}, {"w": "suốt", "t": 122.84, "d": 0.3}, {"w": "sáu", "t": 123.14, "d": 0.06}, {"w": "tháng,", "t": 123.2, "d": 0.37}, {"w": "tiền", "t": 123.57, "d": 0.175}, {"w": "lãi", "t": 123.745, "d": 0.35}, {"w": "vẫn", "t": 124.095, "d": 0.15}, {"w": "lấy", "t": 124.245, "d": 0.085}, {"w": "đi", "t": 124.33, "d": 0.285}, {"w": "gần", "t": 124.615, "d": 0.15}, {"w": "bảy", "t": 124.765, "d": 0.37}, {"w": "phần", "t": 125.135, "d": 0.075}, {"w": "trăm", "t": 125.21, "d": 0.17}, {"w": "vốn.", "t": 125.38, "d": 0.42}]}, {"text": "Giảm sâu hơn, bạn có thể bị bán bớt cổ phiếu để thu nợ, đúng lúc giá đang thấp.", "start": 126.48, "end": 130.96, "words": [{"w": "Giảm", "t": 126.54, "d": 0.27}, {"w": "sâu", "t": 126.81, "d": 0.145}, {"w": "hơn,", "t": 126.955, "d": 0.345}, {"w": "bạn", "t": 127.3, "d": 0.22}, {"w": "có", "t": 127.52, "d": 0.15}, {"w": "thể", "t": 127.67, "d": 0.18}, {"w": "bị", "t": 127.85, "d": 0.125}, {"w": "bán", "t": 127.975, "d": 0.23}, {"w": "bớt", "t": 128.205, "d": 0.195}, {"w": "cổ", "t": 128.4, "d": 0.215}, {"w": "phiếu", "t": 128.615, "d": 0.245}, {"w": "để", "t": 128.86, "d": 0.15}, {"w": "thu", "t": 129.01, "d": 0.115}, {"w": "nợ,", "t": 129.125, "d": 0.37}, {"w": "đúng", "t": 129.495, "d": 0.115}, {"w": "lúc", "t": 129.61, "d": 0.355}, {"w": "giá", "t": 129.965, "d": 0.115}, {"w": "đang", "t": 130.08, "d": 0.205}, {"w": "thấp.", "t": 130.285, "d": 0.315}]}, {"text": "Thứ năm: cảm xúc.", "start": 131.96, "end": 133.24, "words": [{"w": "Thứ", "t": 132.03, "d": 0.25}, {"w": "năm:", "t": 132.28, "d": 0.21}, {"w": "cảm", "t": 132.49, "d": 0.255}, {"w": "xúc.", "t": 132.745, "d": 0.215}]}, {"text": "Mua đuổi khi chỉ số lên đỉnh, bán tháo khi chỉ số rơi, mỗi lần lại cộng thêm phí, thuế và rủi ro thời điểm.", "start": 133.56, "end": 139.88, "words": [{"w": "Mua", "t": 133.66, "d": 0.145}, {"w": "đuổi", "t": 133.805, "d": 0.225}, {"w": "khi", "t": 134.03, "d": 0.215}, {"w": "chỉ", "t": 134.245, "d": 0.195}, {"w": "số", "t": 134.44, "d": 0.295}, {"w": "lên", "t": 134.735, "d": 0.29}, {"w": "đỉnh,", "t": 135.025, "d": 0.325}, {"w": "bán", "t": 135.35, "d": 0.225}, {"w": "tháo", "t": 135.575, "d": 0.065}, {"w": "khi", "t": 135.64, "d": 0.35}, {"w": "chỉ", "t": 135.99, "d": 0.205}, {"w": "số", "t": 136.195, "d": 0.23}, {"w": "rơi,", "t": 136.425, "d": 0.19}, {"w": "mỗi", "t": 136.615, "d": 0.22}, {"w": "lần", "t": 136.835, "d": 0.345}, {"w": "lại", "t": 137.18, "d": 0.1}, {"w": "cộng", "t": 137.28, "d": 0.2}, {"w": "thêm", "t": 137.48, "d": 0.205}, {"w"