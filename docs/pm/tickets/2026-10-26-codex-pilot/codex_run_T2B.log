motion/hf/assets/long\ck-c1-vnindex-dung-yen\ch05\data.js:1:window.CASE = {"topic": "ck-c1-vnindex-dung-yen", "ch": "ch05", "dur": 148.22, "seed": 31882, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 05", "t": "TÀI KHOẢN ≠ VN-INDEX"}, "acc": ["vn-index", "hose", "vic", "giỏ", "tài", "khoản", "lỗ", "trung", "vị", "phí", "thuế", "margin", "vốn", "hoá"], "lines": [{"text": "Giờ quay lại tài khoản của bạn: năm cơ chế khiến nó đi khác chỉ số.", "start": 0.0, "end": 3.92, "words": [{"w": "Giờ", "t": 0.06, "d": 0.175}, {"w": "quay", "t": 0.235, "d": 0.315}, {"w": "lại", "t": 0.55, "d": 0.06}, {"w": "tài", "t": 0.61, "d": 0.2}, {"w": "khoản", "t": 0.81, "d": 0.22}, {"w": "của", "t": 1.03, "d": 0.33}, {"w": "bạn:", "t": 1.36, "d": 0.145}, {"w": "năm", "t": 1.505, "d": 0.38}, {"w": "cơ", "t": 1.885, "d": 0.175}, {"w": "chế", "t": 2.06, "d": 0.23}, {"w": "khiến", "t": 2.29, "d": 0.07}, {"w": "nó", "t": 2.36, "d": 0.305}, {"w": "đi", "t": 2.665, "d": 0.18}, {"w": "khác", "t": 2.845, "d": 0.165}, {"w": "chỉ", "t": 3.01, "d": 0.125}, {"w": "số.", "t": 3.135, "d": 0.405}]}, {"text": "Thứ nhất: bạn không sở hữu chỉ số, bạn sở hữu vài mã.", "start": 4.72, "end": 8.08, "words": [{"w": "Thứ", "t": 4.785, "d": 0.29}, {"w": "nhất:", "t": 5.075, "d": 0.145}, {"w": "bạn", "t": 5.22, "d": 0.32}, {"w": "không", "t": 5.54, "d": 0.2}, {"w": "sở", "t": 5.74, "d": 0.155}, {"w": "hữu", "t": 5.895, "d": 0.19}, {"w": "chỉ", "t": 6.085, "d": 0.265}, {"w": "số,", "t": 6.35, "d": 0.365}, {"w": "bạn", "t": 6.715, "d": 0.06}, {"w": "sở", "t": 6.775, "d": 0.255}, {"w": "hữu", "t": 7.03, "d": 0.29}, {"w": "vài", "t": 7.32, "d": 0.065}, {"w": "mã.", "t": 7.385, "d": 0.37}]}, {"text": "Năm nay nhóm cổ phiếu giảm đông hơn hẳn, nên cầm ba, bốn mã chọn gần như ngẫu nhiên thì dễ rơi vào nhóm giảm hơn.", "start": 8.4, "end": 14.72, "words": [{"w": "Năm", "t": 8.46, "d": 0.275}, {"w": "nay", "t": 8.735, "d": 0.235}, {"w": "nhóm", "t": 8.97, "d": 0.06}, {"w": "cổ", "t": 9.03, "d": 0.18}, {"w": "phiếu", "t": 9.21, "d": 0.275}, {"w": "giảm", "t": 9.485, "d": 0.195}, {"w": "đông", "t": 9.68, "d": 0.205}, {"w": "hơn", "t": 9.885, "d": 0.345}, {"w": "hẳn,", "t": 10.23, "d": 0.225}, {"w": "nên", "t": 10.455, "d": 0.14}, {"w": "cầm", "t": 10.595, "d": 0.265}, {"w": "ba,", "t": 10.86, "d": 0.465}, {"w": "bốn", "t": 11.325, "d": 0.175}, {"w": "mã", "t": 11.5, "d": 0.065}, {"w": "chọn", "t": 11.565, "d": 0.355}, {"w": "gần", "t": 11.92, "d": 0.065}, {"w": "như", "t": 11.985, "d": 0.21}, {"w": "ngẫu", "t": 12.195, "d": 0.395}, {"w": "nhiên", "t": 12.59, "d": 0.06}, {"w": "thì", "t": 12.65, "d": 0.255}, {"w": "dễ", "t": 12.905, "d": 0.2}, {"w": "rơi", "t": 13.105, "d": 0.175}, {"w": "vào", "t": 13.28, "d": 0.23}, {"w": "nhóm", "t": 13.51, "d": 0.175}, {"w": "giảm", "t": 13.685, "d": 0.25}, {"w": "hơn.", "t": 13.935, "d": 0.38}]}, {"text": "Ngay cả các quỹ cổ phiếu, nửa đầu năm trung bình âm khoảng một phần trăm, trong khi VN-Index tăng hơn bốn phần trăm.", "start": 15.04, "end": 21.44, "words": [{"w": "Ngay", "t": 15.115, "d": 0.21}, {"w": "cả", "t": 15.325, "d": 0.31}, {"w": "các", "t": 15.635, "d": 0.215}, {"w": "quỹ", "t": 15.85, "d": 0.215}, {"w": "cổ", "t": 16.065, "d": 0.06}, {"w": "phiếu,", "t": 16.125, "d": 0.375}, {"w": "nửa", "t": 16.5, "d": 0.29}, {"w": "đầu", "t": 16.79, "d": 0.235}, {"w": "năm", "t": 17.025, "d": 0.18}, {"w": "trung", "t": 17.205, "d": 0.115}, {"w": "bình", "t": 17.32, "d": 0.255}, {"w": "âm", "t": 17.575, "d": 0.25}, {"w": "khoảng", "t": 17.825, "d": 0.295}, {"w": "một", "t": 18.12, "d": 0.065}, {"w": "phần", "t": 18.185, "d": 0.18}, {"w": "trăm,", "t": 18.365, "d": 0.375}, {"w": "trong", "t": 18.74, "d": 0.365}, {"w": "khi", "t": 19.105, "d": 0.19}, {"w": "VN-Index", "t": 19.295, "d": 0.67}, {"w": "tăng", "t": 19.965, "d": 0.06}, {"w": "hơn", "t": 20.025, "d": 0.185}, {"w": "bốn", "t": 20.21, "d