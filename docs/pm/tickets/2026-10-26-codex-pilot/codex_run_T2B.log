.9, "t0": 49.52, "t1": 59.16}, {"type": "ledger", "title": "HAI SỢI BĂNG", "srcnote": "SRI · DARPA · CNN", "rows": [{"k": "SỢI 1", "v": "CÁI ĐẦU · PHÒNG THÍ NGHIỆM", "at": 61.0}, {"k": "SỢI 2", "v": "GIỌNG NÓI · BUỒNG THU Ở ATLANTA", "at": 63.8}], "t0": 59.16, "t1": 67.24}, {"type": "slam", "text": "ĐÁY CUỘN BĂNG", "sub": "▶ GIỜ TUA XUÔI", "white": true, "t0": 67.24, "t1": 68.36, "at": 67.39, "fx": "zoom"}, {"type": "broll", "vid": "v12", "veil": 0.55, "illus": "VIDEO MINH HỌA", "kin": [{"text": "▶ TUA XUÔI", "at": 68.36, "acc": true, "fx": "outline"}, {"text": "hai sợi gặp nhau thế nào?", "at": 70.285, "sm": true, "fx": "blur"}], "t0": 68.36, "t1": 74.54}], "prog0": 0.58512, "prog1": 0.70274};
motion/hf/assets/long\mim-dich-may\ch07\data.js:1:window.CASE = {"topic": "mim-dich-may", "ch": "ch07", "dur": 119.26, "seed": 11845, "accent": "#22d3ee", "look": {"name": "amber", "vars": {"--red": "#e39a2d", "--gold": "#f2cf86", "--paper": "#f2e7cf", "--bed1": "#1d150c", "--bed2": "#0c0905", "--serif": "'Literata'", "--sans": "'Montserrat'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 07", "t": "KHI QUỐC HỘI CANADA TRỞ THÀNH THẦY GIÁO"}, "acc": ["dịch", "máy", "vài", "năm", "lời", "hứa", "sổ", "pen", "cũi"], "lines": [{"text": "Tháng 6 năm 1990, một nhóm tám nhà nghiên cứu của IBM đăng một bài báo ở tạp chí Computational Linguistics.", "start": 0.0, "end": 6.88, "words": [{"w": "Tháng", "t": 0.0, "d": 0.125}, {"w": "6", "t": 0.125, "d": 0.43}, {"w": "năm", "t": 0.555, "d": 0.155}, {"w": "1990,", "t": 0.71, "d": 1.445}, {"w": "một", "t": 2.155, "d": 0.34}, {"w": "nhóm", "t": 2.495, "d": 0.205}, {"w": "tám", "t": 2.7, "d": 0.28}, {"w": "nhà", "t": 2.98, "d": 0.06}, {"w": "nghiên", "t": 3.04, "d": 0.32}, {"w": "cứu", "t": 3.36, "d": 0.32}, {"w": "của", "t": 3.68, "d": 0.18}, {"w": "IBM", "t": 3.86, "d": 0.55}, {"w": "đăng", "t": 4.41, "d": 0.315}, {"w": "một", "t": 4.725, "d": 0.285}, {"w": "bài", "t": 5.01, "d": 0.205}, {"w": "báo", "t": 5.215, "d": 0.305}, {"w": "ở", "t": 5.52, "d": 0.075}, {"w": "tạp", "t": 5.595, "d": 0.205}, {"w": "chí", "t": 5.8, "d": 0.205}, {"w": "Computational", "t": 6.005, "d": 0.405}, {"w": "Linguistics.", "t": 6.41, "d": 0.3}]}, {"text": "Tên bài: một cách tiếp cận thống kê cho dịch máy.", "start": 7.68, "end": 10.16, "words": [{"w": "Tên", "t": 7.68, "d": 0.1}, {"w": "bài:", "t": 7.78, "d": 0.435}, {"w": "một", "t": 8.215, "d": 0.06}, {"w": "cách", "t": 8.275, "d": 0.2}, {"w": "tiếp", "t": 8.475, "d": 0.315}, {"w": "cận", "t": 8.79, "d": 0.19}, {"w": "thống", "t": 8.98, "d": 0.06}, {"w": "kê", "t": 9.04, "d": 0.2}, {"w": "cho", "t": 9.24, "d": 0.19}, {"w": "dịch", "t": 9.43, "d": 0.265}, {"w": "máy.", "t": 9.695, "d": 0.25}]}, {"text": "Mở đầu bài, họ nhắc tới Warren Weaver, người năm 1949 đã gợi ý dùng thống kê.", "start": 11.16, "end": 16.28, "words": [{"w": "Mở", "t": 11.215, "d": 0.23}, {"w": "đầu", "t": 11.445, "d": 0.245}, {"w": "bài,", "t": 11.69, "d": 0.315}, {"w": "họ", "t": 12.005, "d": 0.06}, {"w": "nhắc", "t": 12.065, "d": 0.33}, {"w": "tới", "t": 12.395, "d": 0.06}, {"w": "Warren", "t": 12.455, "d": 0.16}, {"w": "Weaver,", "t": 12.615, "d": 0.405}, {"w": "người", "t": 13.02, "d": 0.17}, {"w": "năm", "t": 13.19, "d": 0.305}, {"w": "1949", "t": 13.495, "d": 1.205}, {"w": "đã", "t": 14.7, "d": 0.235}, {"w": "gợi", "t": 14.935, "d": 0.235}, {"w": "ý", "t": 15.17, "d": 0.155}, {"w": "dùng", "t": 15.325, "d": 0.285}, {"w": "thống", "t": 15.61, "d": 0.14}, {"w": "kê.", "t": 15.75, "d": 0.335}]}, {"text": "Ý ấy bị bỏ, họ viết, vì máy quá yếu và chữ trong máy quá ít. Còn giờ, máy tính nhanh hơn năm 1950 khoảng một trăm nghìn lần.", "start": 16.6, "end": 23.88, "words": [{"w": "Ý", "t": 16.635, "d": 0.245}, {"w": "ấy", "t": 16.88, "d": 0.105}, {"w": "bị", "t": 16.985, "d": 0.295}, {"w": "bỏ,", "t": 17.28, "d": 0.285}, {"w": "họ", "t": 17.565, "d": 0.195}, {"w": "viết,", "t": 17.76, "d": 0.305}, {"w": "vì", "t": 18.065, "d": 0.125}, {"w": "máy", "t": 18.19, "d": 0.25}, {"w": "quá", "t": 18.44, "d": 0.06}, {"w": "yếu", "t": 18.5, "d": 0.325}, {"w": "và", "t": 18.825, "d": 0.19}, {"w": "chữ", "t": 19.015, "d": 0.06}, {"w": "trong", "t": 19.075, "d": 0.22}, {"w": "máy", "t": 19.295, "d": 0.13}, {"w": "quá", "t": 19.425, "d": 0.18}, {"w": "ít.", "t": 19.605, "d": 0.325}, {"w": "Còn", "t": 19.93, "d": 0.33}, {"w": "giờ,", "t": 20.26, "d": 0.25}, {"w": "máy", "t": 20.51, "d": 0.095}, {"w": "tính", "t": 20.605, "d": 0.335}, {"w": "nhanh", "t": 20.94, "d": 0.19}, {"w": "hơn", "t": 21.13, "d": 0.19}, {"w": "năm", "t": 21.32, "d": 0.11}, {"w": "1950", "t": 21.43, "d": 1.18}, {"w": "khoảng", "t": 22.61, "d": 0.22}, {"w": "một", "t": 22.83, "d": 0.185}, {"w": "trăm", "t": 23.015, "d": 0.15}, {"w": "nghìn", "t": 23.165, "d": 0.14}, {"w": "lần.", "t": 23.305, "d": 0.315}]}, {"text": "Họ cần một thứ rất đặc biệt: một văn bản có sẵn hai bản, hai thứ tiếng.", "start": 24.88, "end": 28.48, "words": [{"w": "Họ", "t": 24.88, "d": 0.095}, {"w": "cần", "t": 24.975, "d": 0.245}, {"w": "một", "t": 25.22, "d": 0.28}, {"w": "thứ", "t": 25.5, "d": 0.12}, {"w": "rất", "t": 25.62, "d": 0.24}, {"w": "đặc", "t": 25.86, "d": 0.185}, {"w": "biệt:", "t": 26.045, "d": 0.17}, {"w": "một", "t": 26.215, "d": 0.22}, {"w": "văn", "t": 26.435, "d": 0.165}, {"w": "bản", "t": 26.6, "d": 0.24}, {"w": "có", "t": 26.84, "d": 0.155}, {"w": "sẵn", "t": 26.995, "d": 0.125}, {"w": "hai", "t": 27.12, "d": 0.245}, {"w": "bản,", "t": 27.365, "d": 0.35}, {"w": "hai", "t": 27.715, "d": 0.06}, {"w": "thứ", "t": 27.775, "d": 0.305}, {"w": "tiếng.", "t": 28.08, "d": 0.215}]}, {"text": "Họ tìm thấy nó ở quốc hội Canada. Mọi lời phát biểu được ghi lại bằng cả tiếng Anh lẫn tiếng Pháp. Tên gọi là Hansard.", "start": 28.8, "end": 35.28, "words": [{"w": "Họ", "t": 28.845, "d": 0.12}, {"w": "tìm", "t": 28.965, "d": 0.32}, {"w": "thấy", "t": 29.285, "d": 0.24}, {"w": "nó", "t": 29.525, "d": 0.285}, {"w": "ở", "t": 29.81, "d": 0.25}, {"w": "quốc", "t": 30.06, "d": 0.225}, {"w": "hội", "t": 30.285, "d": 0.225}, {"w": "Canada.", "t": 30.51, "d": 0.18}, {"w": "Mọi", "t": 30.69, "d": 0.27}, {"w": "lời", "t": 30.96, "d": 0.315}, {"w": "phát", "t": 31.275, "d": 0.24}, {"w": "biểu", "t": 31.515, "d": 0.155}, {"w": "được", "t": 31.67, "d": 0.155}, {"w": "ghi", "t": 31.825, "d": 0.255}, {"w": "lại", "t": 32.08, "d": 0.29}, {"w": "bằng", "t": 32.37, "d": 0.24}, {"w": "cả", "t": 32.61, "d": 0.115}, {"w": "tiếng", "t": 32.725, "d": 0.36}, {"w": "Anh", "t": 33.085, "d": 0.07}, {"w": "lẫn", "t": 33.155, "d": 0.28}, {"w": "tiếng", "t": 33.435, "d": 0.355}, {"w": "Pháp.", "t": 33.79, "d": 0.33}, {"w": "Tên", "t": 34.12, "d": 0.07}, {"w": "gọi", "t": 34.19, "d": 0.315}, {"w": "là", "t": 34.505, "d": 0.28}, {"w": "Hansard.", "t": 34.785, "d": 0.305}]}, {"text": "Họ có khoảng một trăm triệu từ tiếng Anh. Từ đó, họ lọc ra khoảng ba triệu cặp câu Anh và Pháp, và chừng chín mươi chín phần trăm số cặp ấy khớp nhau.", "start": 35.6, "end": 42.56, "words": [{"w": "Họ", "t": 35.6, "d": 0.11}, {"w": "có", "t": 35.71, "d": 0.285}, {"w": "khoảng", "t": 35.995, "d": 0.19}, {"w": "một", "t": 36.185, "d": 0.235}, {"w": "trăm", "t": 36.42, "d": 0.065}, {"w": "triệu", "t": 36.485, "d": 0.195}, {"w": "từ", "t": 36.68, "d": 0.23}, {"w": "tiếng", "t": 36.91, "d": 0.25}, {"w": "Anh.", "t": 37.16, "d": 0.295}, {"w": "Từ", "t": 37.455, "d": 0.095}, {"w": "đó,", "t": 37.55, "d": 0.23}, {"w": "họ", "t": 37.78, "d": 0.31}, {"w": "lọc", "t": 38.09, "d": 0.085}, {"w": "ra", "t": 38.175, "d": 0.195}, {"w": "khoảng", "t": 38.37, "d": 0.23}, {"w": "ba", "t": 38.6, "d": 0.21}, {"w": "triệu", "t": 38.81, "d": 0.21}, {"w": "cặp", "t": 39.02, "d": 0.19}, {"w": "câu", "t": 39.21, "d": 0.195}, {"w": "Anh", "t": 39.405, "d": 0.115}, {"w": "và", "t": 39.52, "d": 0.23}, {"w": "Pháp,", "t": 39.75, "d": 0.34}, {"w": "và", "t": 40.09, "d": 0.185}, {"w": "chừng", "t": 40.275, "d": 0.065}, {"w": "chín", "t": 40.34, "d": 0.26}, {"w": "mươi", "t": 40.6, "d": 0.23}, {"w": "chín", "t": 40.83, "d": 0.06}, {"w": "phần", "t": 40.89, "d": 0.205}, {"w": "trăm", "t": 41.095, "d": 0.19}, {"w": "số", "t": 41.285, "d": 0.145}, {"w": "cặp", "t": 41.43, "d": 0.255}, {"w": "ấy", "t": 41.685, "d": 0.105}, {"w": "khớp", "t": 41.79, "d": 0.275}, {"w": "nhau.", "t": 42.065, "d": 0.285}]}, {"text": "Đừng dạy máy ngữ pháp. Cứ cho nó xem thật nhiều cặp câu, rồi để nó đếm: từ tiếng Pháp này hay đi cùng từ tiếng Anh nào.", "start": 43.56, "end": 50.04, "words": [{"w": "Đừng", "t": 43.685, "d": 0.285}, {"w": "dạy", "t": 43.97, "d": 0.06}, {"w": "máy", "t": 44.03, "d": 0.32}, {"w": "ngữ", "t": 44.35, "d": 0.23}, {"w": "pháp.", "t": 44.58, "d": 0.26}, {"w": "Cứ", "t": 44.84, "d": 0.15}, {"w": "cho", "t": 44.99, "d": 0.21}, {"w": "nó", "t": 45.2, "d": 0.31}, {"w": "xem", "t": 45.51, "d": 0.2}, {"w": "thật", "t": 45.71, "d": 0.16}, {"w": "nhiều", "t": 45.87, "d": 0.2}, {"w": "cặp", "t": 46.07, "d": 0.16}, {"w": "câu,", "t": 46.23, "d": 0.405}, {"w": "rồi", "t": 46.635, "d": 0.095}, {"w": "để", "t": 46.73, "d": 0.14}, {"w": "nó", "t": 46.87, "d": 0.33}, {"w": "đếm:", "t": 47.2, "d": 0.37}, {"w": "từ", "t": 47.57, "d": 0.185}, {"w": "tiếng", "t": 47.755, "d": 0.06}, {"w": "Pháp", "t": 47.815, "d": 0.255}, {"w": "này", "t": 48.07, "d": 0.3}, {"w": "hay", "t": 48.37, "d": 0.215}, {"w": "đi", "t": 48.585, "d": 0.195}, {"w": "cùng", "t": 48.78, "d": 0.06}, {"w": "từ", "t": 48.84, "d": 0.23}, {"w": "tiếng", "t": 49.07, "d": 0.185}, {"w": "Anh", "t": 49.255, "d": 0.225}, {"w": "nào.", "t": 49.48, "d": 0.355}]}, {"text": "Khi nhìn chữ hear, máy tính ra bản dịch tiếng Pháp có khả năng nhất, không phải một chữ đúng nghĩa. Mà là chữ bravo.", "start": 51.04, "end": 56.8, "words": [{"w": "Khi", "t": 51.04, "d": 0.255}, {"w": "nhìn", "t": 51.295, "d": 0.1}, {"w": "chữ", "t": 51.395, "d": 0.34}, {"w": "hear,", "t": 51.735, "d": 0.145}, {"w": "máy", "t": 51.88, "d": 0.33}, {"w": "tính", "t": 52.21, "d": 0.175}, {"w": "ra", "t": 52.385, "d": 0.185}, {"w": "bản", "t": 52.57, "d": 0.18}, {"w": "dịch", "t": 52.75, "d": 0.19}, {"w": "tiếng", "t": 52.94, "d": 0.205}, {"w": "Pháp", "t": 53.145, "d": 0.265}, {"w": "có", "t": 53.41, "d": 0.27}, {"w": "khả", "t": 53.68, "d": 0.195}, {"w": "năng", "t": 53.875, "d": 0.165}, {"w": "nhất,", "t": 54.04, "d": 0.21}, {"w": "không", "t": 54.25, "d": 0.365}, {"w": "phải", "t": 54.615, "d": 0.06}, {"w": "một", "t": 54.675, "d": 0.165}, {"w": "chữ", "t": 54.84, "d": 0.385}, {"w": "đúng", "t": 55.225, "d": 0.2}, {"w": "nghĩa.", "t": 55.425, "d": 0.21}, {"w": "Mà", "t": 55.635, "d": 0.14}, {"w": "là", "t": 55.775, "d": 0.22}, {"w": "chữ", "t": 55.995, "d": 0.25}, {"w": "bravo.", "t": 56.245, "d": 0.355}]}, {"text": "Vì sao? Vì trong quốc hội, người nói tiếng Anh tán thưởng bằng cách hô hear, hear. Còn người nói tiếng Pháp hô bravo.", "start": 57.12, "end": 63.52, "words": [{"w": "Vì", "t": 57.12, "d": 0.325}, {"w": "sao?", "t": 57.445, "d": 0.32}, {"w": "Vì", "t": 57.765, "d": 0.08}, {"w": "trong", "t": 57.845, "d": 0.29}, {"w": "quốc", "t": 58.135, "d": 0.21}, {"w": "hội,", "t": 58.345, "d": 0.52}, {"w": "người", "t": 58.865, "d": 0.06}, {"w": "nói", "t": 58.925, "d": 0.39}, {"w": "tiếng", "t": 59.315, "d": 0.105}, {"w": "Anh", "t": 59.42, "d": 0.24}, {"w": "tán", "t": 59.66, "d": 0.195}, {"w": "thưởng", "t": 59.855, "d": 0.375}, {"w": "bằng", "t": 60.23, "d": 0.115}, {"w": "cách", "t": 60.345, "d": 0.235}, {"w": "hô", "t": 60.58, "d": 0.31}, {"w": "hear,", "t": 60.89, "d": 0.405}, {"w": "hear.", "t": 61.295, "d": 0.4}, {"w": "Còn", "t": 61.695, "d": 0.11}, {"w": "người", "t": 61.805, "d": 0.25}, {"w": "nói", "t": 62.055, "d": 0.325}, {"w": "tiếng", "t": 62.38, "d": 0.155}, {"w": "Pháp", "t": 62.535, "d": 0.145}, {"w": "hô", "t": 62.68, "d": 0.25}, {"w": "bravo.", "t": 62.93, "d": 0.425}]}, {"text": "Máy học được rằng hai chữ hear sẽ thành một chữ bravo.", "start": 63.84, "end": 67.28, "words": [{"w": "Máy", "t": 63.905, "d": 0.195}, {"w": "học", "t": 64.1, "d": 0.14}, {"w": "được", "t": 64.24, "d": 0.215}, {"w": "rằng", "t": 64.455, "d": 0.06}, {"w": "hai", "t": 64.515, "d": 0.175}, {"w": "chữ", "t": 64.69, "d": 0.165}, {"w": "hear", "t": 64.855, "d": 0.325}, {"w": "sẽ", "t": 65.18, "d": 0.15}, {"w": "thành", "t": 65.33, "d": 0.16}, {"w": "một", "t": 65.49, "d": 0.205}, {"w": "chữ", "t": 65.695, "d": 0.17}, {"w": "bravo.", "t": 65.865, "d": 0.205}]}, {"text": "Một ví dụ nữa. Chữ not trong tiếng Anh, máy thấy nó đi cùng hai chữ tiếng Pháp: ne và pas.", "start": 68.28, "end": 73.24, "words": [{"w": "Một", "t": 68.33, "d": 0.145}, {"w": "ví", "t": 68.475, "d": 0.3}, {"w": "dụ", "t": 68.775, "d": 0.245}, {"w": "nữa.", "t": 69.02, "d": 0.3}, {"w": "Chữ", "t": 69.32, "d": 0.075}, {"w": "not", "t": 69.395, "d": 0.33}, {"w": "trong", "t": 69.725, "d": 0.155}, {"w": "tiếng", "t": 69.88, "d": 0.265}, {"w": "Anh,", "t": 70.145, "d": 0.325}, {"w": "máy", "t": 70.47, "d": 0.06}, {"w": "thấy", "t": 70.53, "d": 0.195}, {"w": "nó", "t": 70.725, "d": 0.33}, {"w": "đi", "t": 71.055, "d": 0.16}, {"w": "cùng", "t": 71.215, "d": 0.21}, {"w": "hai", "t": 71.425, "d": 0.18}, {"w": "chữ", "t": 71.605, "d": 0.175}, {"w": "tiếng", "t": 71.78, "d": 0.17}, {"w": "Pháp:", "t": 71.95, "d": 0.405}, {"w": "ne", "t": 72.355, "d": 0.075}, {"w": "và", "t": 72.43, "d": 0.29}, {"w": "pas.", "t": 72.72, "d": 0.33}]}, {"text": "Nó tự tìm ra cách ghép đôi từ, mà không ai bảo. Mình giữ lại cái ghép đôi này nhé.", "start": 73.56, "end": 77.72, "words": [{"w": "Nó", "t": 73.56, "d": 0.25}, {"w": "tự", "t": 73.81, "d": 0.17}, {"w": "tìm", "t": 73.98, "d": 0.085}, {"w": "ra", "t": 74.065, "d": 0.16}, {"w": "cách", "t": 74.225, "d": 0.28}, {"w": "ghép", "t": 74.505, "d": 0.19}, {"w": "đôi", "t": 74.695, "d": 0.205}, {"w": "từ,", "t": 74.9, "d": 0.26}, {"w": "mà", "t": 75.16, "d": 0.06}, {"w": "không", "t": 75.22, "d": 0.175}, {"w": "ai", "t": 75.395, "d": 0.22}, {"w": "bảo.", "t": 75.615, "d": 0.41}, {"w": "Mình", "t": 76.025, "d": 0.12}, {"w": "giữ", "t": 76.145, "d": 0.085}, {"w": "lại", "t": 76.23, "d": 0.225}, {"w": "cái", "t": 76.455, "d": 0.295}, {"w": "ghép", "t": 76.75, "d": 0.17}, {"w": "đôi", "t": 76.92, "d": 0.13}, {"w": "này", "t": 77.05, "d": 0.155}, {"w": "nhé.", "t": 77.205, "d": 0.305}]}, {"text": "Vậy kết quả ra sao?", "start": 78.72, "end": 79.92, "words": [{"w": "Vậy", "t": 78.72, "d": 0.09}, {"w": "kết", "t": 78.81, "d": 0.145}, {"w": "quả", "t": 78.955, "d": 0.21}, {"w": "ra", "t": 79.165, "d": 0.175}, {"w": "sao?", "t": 79.34, "d": 0.17}]}, {"text": "Họ cho máy dịch bảy mươi ba câu tiếng Pháp mới.", "start": 80.52, "end": 83.8, "words": [{"w": "Họ", "t": 80.57, "d": 0.155}, {"w": "cho", "t": 80.725, "d": 0.525}, {"w": "máy", "t": 81.25, "d": 0.24}, {"w": "dịch", "t": 81.49, "d": 0.125}, {"w": "bảy", "t": 81.615, "d": 0.27}, {"w": "mươi", "t": 81.885, "d": 0.315}, {"w": "ba", "t": 82.2, "d": 0.44}, {"w": "câu", "t": 82.64, "d": 0.26}, {"w": "tiếng", "t": 82.9, "d": 0.19}, {"w": "Pháp", "t": 83.09, "d": 0.145}, {"w": "mới.", "t": 83.235, "d": 0.57}]}, {"text": "Chỉ năm phần trăm giống hệt bản dịch của người. Tính cả bản dịch khác chữ nhưng đúng ý, hoặc đúng nghĩa dù lệch ý, thì được bốn mươi tám phần trăm.", "start": 84.12, "end": 91.32, "words": [{"w": "Chỉ", "t": 84.12, "d": 0.23}, {"w": "năm", "t": 84.35, "d": 0.155}, {"w": "phần", "t": 84.505, "d": 0.245}, {"w": "trăm", "t": 84.75, "d": 0.27}, {"w": "giống", "t": 85.02, "d": 0.06}, {"w": "hệt", "t": 85.08, "d": 0.34}, {"w": "bản", "t": 85.42, "d": 0.15}, {"w": "dịch", "t": 85.57, "d": 0.265}, {"w": "của", "t": 85.835, "d": 0.19}, {"w": "người.", "t": 86.025, "d": 0.24}, {"w": "Tính", "t": 86.265, "d": 0.175}, {"w": "cả", "t": 86.44, "d": 0.15}, {"w": "bản", "t": 86.59, "d": 0.295}, {"w": "dịch", "t": 86.885, "d": 0.285}, {"w": "khác", "t": 87.17, "d": 0.18}, {"w": "chữ", "t": 87.35, "d": 0.06}, {"w": "nhưng", "t": 87.41, "d": 0.28}, {"w": "đúng", "t": 87.69, "d": 0.18}, {"w": "ý,", "t": 87.87, "d": 0.45}, {"w": "hoặc", "t": 88.32, "d": 0.185}, {"w": "đúng", "t": 88.505, "d": 0.2}, {"w": "nghĩa", "t": 88.705, "d": 0.06}, {"w": "dù", "t": 88.765, "d": 0.19}, {"w": "lệch", "t": 88.955, "d": 0.24}, {"w": "ý,", "t": 89.195, "d": 0.29}, {"w": "thì", "t": 89.485, "d": 0.38}, {"w": "được", "t": 89.865, "d": 0.08}, {"w": "bốn", "t": 89.945, "d": 0.315}, {"w": "mươi", "t": 90.26, "d": 0.06}, {"w": "tám", "t": 90.32, "d": 0.305}, {"w": "phần", "t": 90.625, "d": 0.22}, {"w": "trăm.", "t": 90.845, "d": 0.28}]}, {"text": "Ba mươi bảy phần trăm là câu sai ngữ pháp.", "start": 91.64, "end": 94.44, "words": [{"w": "Ba", "t": 91.69, "d": 0.145}, {"w": "mươi", "t": 91.835, "d": 0.3}, {"w": "bảy", "t": 92.135, "d": 0.315}, {"w": "phần", "t": 92.45, "d": 0.365}, {"w": "trăm", "t": 92.815, "d": 0.19}, {"w": "là", "t": 93.005, "d": 0.245}, {"w": "câu", "t": 93.25, "d": 0.205}, {"w": "sai", "t": 93.455, "d": 0.41}, {"w": "ngữ", "t": 93.865, "d": 0.06}, {"w": "pháp.", "t": 93.925, "d": 0.515}]}, {"text": "Hơn một nửa số câu, máy dịch hỏng.", "start": 95.44, "end": 97.44, "words": [{"w": "Hơn", "t": 95.44, "d": 0.225}, {"w": "một", "t": 95.665, "d": 0.245}, {"w": "nửa", "t": 95.91, "d": 0.17}, {"w": "số", "t": 96.08, "d": 0.22}, {"w": "câu,", "t": 96.3, "d": 0.31}, {"w": "máy", "t": 96.61, "d": 0.06}, {"w": "dịch", "t": 96.67, "d": 0.285}, {"w": "hỏng.", "t": 96.955, "d": 0.275}]}, {"text": "Vậy mà bài báo ấy là một cái mốc. Vì nó cho thấy máy có thể dịch mà không ai phải viết luật ngữ pháp.", "start": 97.76, "end": 102.88, "words": [{"w": "Vậy", "t": 97.76, "d": 0.225}, {"w": "mà", "t": 97.985, "d": 0.125}, {"w": "bài", "t": 98.11, "d": 0.16}, {"w": "báo", "t": 98.27, "d": 0.32}, {"w": "ấy", "t": 98.59, "d": 0.165}, {"w": "là", "t": 98.755, "d": 0.1}, {"w": "một", "t": 98.855, "d": 0.295}, {"w": "cái", "t": 99.15, "d": 0.17}, {"w": "mốc.", "t": 99.32, "d": 0.265}, {"w": "Vì", "t": 99.585, "d": 0.09}, {"w": "nó", "t": 99.675, "d": 0.29}, {"w": "cho", "t": 99.965, "d": 0.19}, {"w": "thấy", "t": 100.155, "d": 0.165}, {"w": "máy", "t": 100.32, "d": 0.195}, {"w": "có", "t": 100.515, "d": 0.115}, {"w": "thể", "t": 100.63, "d": 0.34}, {"w": "dịch", "t": 100.97, "d": 0.115}, {"w": "mà", "t": 101.085, "d": 0.265}, {"w": "không", "t": 101.35, "d": 0.06}, {"w": "ai", "t": 101.41, "d": 0.16}, {"w": "phải", "t": 101.57, "d": 0.235}, {"w": "viết", "t": 101.805, "d": 0.205}, {"w": "luật", "t": 102.01, "d": 0.14}, {"w": "ngữ", "t": 102.15, "d": 0.195}, {"w": "pháp.", "t": 102.345, "d": 0.36}]}, {"text": "Và họ chỉ dùng khoảng một phần trăm số dữ liệu sẵn có để dạy phần dịch.", "start": 103.2, "end": 106.96, "words": [{"w": "Và", "t": 103.2, "d": 0.215}, {"w": "họ", "t": 103.415, "d": 0.175}, {"w": "chỉ", "t": 103.59, "d": 0.18}, {"w": "dùng", "t": 103.77, "d": 0.24}, {"w": "khoảng", "t": 104.01, "d": 0.21}, {"w": "một", "t": 104.22, "d": 0.185}, {"w": "phần", "t": 104.405, "d": 0.23}, {"w": "trăm", "t": 104.635, "d": 0.14}, {"w": "số", "t": 104.775, "d": 0.345}, {"w": "dữ", "t": 105.12, "d": 0.205}, {"w": "liệu", "t": 105.325, "d": 0.085}, {"w": "sẵn", "t": 105.41, "d": 0.32}, {"w": "có", "t": 105.73, "d": 0.06}, {"w": "để", "t": 105.79, "d": 0.275}, {"w": "dạy", "t": 106.065, "d": 0.245}, {"w": "phần", "t": 106.31, "d": 0.225}, {"w": "dịch.", "t": 106.535, "d": 0.255}]}, {"text": "Ghi vào sổ: năm 1990, IBM. Dữ liệu thay cho luật.", "start": 107.96, "end": 111.8, "words": [{"w": "Ghi", "t": 107.96, "d": 0.255}, {"w": "vào", "t": 108.215, "d": 0.055}, {"w": "sổ:", "t": 108.27, "d": 0.255}, {"w": "năm", "t": 108.525, "d": 0.22}, {"w": "1990,", "t": 108.745, "d": 1.27}, {"w": "IBM.", "t": 110.015, "d": 0.675}, {"w": "Dữ", "t": 110.69, "d": 0.065}, {"w": "liệu", "t": 110.755, "d": 0.135}, {"w": "thay", "t": 110.89, "d": 0.325}, {"w": "cho", "t": 111.215, "d": 0.16}, {"w": "luật.", "t": 111.375, "d": 0.245}]}, {"text": "Hạn: chưa ai hứa. Nhưng người ta nhìn thấy một lối đi.", "start": 112.12, "end": 115.0, "words": [{"w": "Hạn:", "t": 112.12, "d": 0.395}, {"w": "chưa", "t": 112.515, "d": 0.07}, {"w": "ai", "t": 112.585, "d": 0.325}, {"w": "hứa.", "t": 112.91, "d": 0.305}, {"w": "Nhưng", "t": 113.215, "d": 0.19}, {"w": "người", "t": 113.405, "d": 0.075}, {"w": "ta", "t": 113.48, "d": 0.165}, {"w": "nhìn", "t": 113.645, "d": 0.27}, {"w": "thấy", "t": 113.915, "d": 0.295}, {"w": "một", "t": 114.21, "d": 0.2}, {"w": "lối", "t": 114.41, "d": 0.105}, {"w": "đi.", "t": 114.515, "d": 0.325}]}, {"text": "Lối ấy sẽ dẫn tới một cái tên mà bạn đã biết.", "start": 115.32, "end": 118.04, "words": [{"w": "Lối", "t": 115.32, "d": 0.25}, {"w": "ấy", "t": 115.57, "d": 0.155}, {"w": "sẽ", "t": 115.725, "d": 0.29}, {"w": "dẫn", "t": 116.015, "d": 0.205}, {"w": "tới", "t": 116.22, "d": 0.2}, {"w": "một", "t": 116.42, "d": 0.205}, {"w": "cái", "t": 116.625, "d": 0.18}, {"w": "tên", "t": 116.805, "d": 0.21}, {"w": "mà", "