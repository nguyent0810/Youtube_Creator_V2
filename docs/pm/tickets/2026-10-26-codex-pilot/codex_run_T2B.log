5}, {"w": "NASA", "t": 57.035, "d": 0.33}, {"w": "không", "t": 57.365, "d": 0.115}, {"w": "hề", "t": 57.48, "d": 0.115}, {"w": "bị", "t": 57.595, "d": 0.39}, {"w": "kẹt,", "t": 57.985, "d": 0.33}, {"w": "rồi", "t": 58.315, "d": 0.165}, {"w": "nhắc", "t": 58.48, "d": 0.065}, {"w": "người", "t": 58.545, "d": 0.31}, {"w": "hỏi:", "t": 58.855, "d": 0.325}]}, {"text": "Có lẽ bạn đang nhầm với một bộ phim khoa học viễn tưởng.", "start": 59.72, "end": 62.76, "words": [{"w": "Có", "t": 59.765, "d": 0.25}, {"w": "lẽ", "t": 60.015, "d": 0.075}, {"w": "bạn", "t": 60.09, "d": 0.235}, {"w": "đang", "t": 60.325, "d": 0.125}, {"w": "nhầm", "t": 60.45, "d": 0.235}, {"w": "với", "t": 60.685, "d": 0.15}, {"w": "một", "t": 60.835, "d": 0.18}, {"w": "bộ", "t": 61.015, "d": 0.215}, {"w": "phim", "t": 61.23, "d": 0.225}, {"w": "khoa", "t": 61.455, "d": 0.06}, {"w": "học", "t": 61.515, "d": 0.34}, {"w": "viễn", "t": 61.855, "d": 0.18}, {"w": "tưởng.", "t": 62.035, "d": 0.22}]}, {"text": "Máy sai. Rồi bảo người đúng là đang nhầm.", "start": 63.08, "end": 65.24, "words": [{"w": "Máy", "t": 63.175, "d": 0.205}, {"w": "sai.", "t": 63.38, "d": 0.345}, {"w": "Rồi", "t": 63.725, "d": 0.15}, {"w": "bảo", "t": 63.875, "d": 0.07}, {"w": "người", "t": 63.945, "d": 0.27}, {"w": "đúng", "t": 64.215, "d": 0.24}, {"w": "là", "t": 64.455, "d": 0.09}, {"w": "đang", "t": 64.545, "d": 0.16}, {"w": "nhầm.", "t": 64.705, "d": 0.37}]}, {"text": "Kết quả chung: bốn mươi lăm phần trăm câu trả lời có ít nhất một lỗi đáng kể.", "start": 66.24, "end": 70.4, "words": [{"w": "Kết", "t": 66.3, "d": 0.13}, {"w": "quả", "t": 66.43, "d": 0.195}, {"w": "chung:", "t": 66.625, "d": 0.46}, {"w": "bốn", "t": 67.085, "d": 0.09}, {"w": "mươi", "t": 67.175, "d": 0.185}, {"w": "lăm", "t": 67.36, "d": 0.265}, {"w": "phần", "t": 67.625, "d": 0.135}, {"w": "trăm", "t": 67.76, "d": 0.295}, {"w": "câu", "t": 68.055, "d": 0.17}, {"w": "trả", "t": 68.225, "d": 0.145}, {"w": "lời", "t": 68.37, "d": 0.255}, {"w": "có", "t": 68.625, "d": 0.26}, {"w": "ít", "t": 68.885, "d": 0.255}, {"w": "nhất", "t": 69.14, "d": 0.175}, {"w": "một", "t": 69.315, "d": 0.215}, {"w": "lỗi", "t": 69.53, "d": 0.185}, {"w": "đáng", "t": 69.715, "d": 0.08}, {"w": "kể.", "t": 69.795, "d": 0.39}]}, {"text": "Lỗi nhiều nhất nằm ở nguồn: ba mươi mốt phần trăm có vấn đề lớn về nguồn.", "start": 70.72, "end": 74.08, "words": [{"w": "Lỗi", "t": 70.825, "d": 0.165}, {"w": "nhiều", "t": 70.99, "d": 0.2}, {"w": "nhất", "t": 71.19, "d": 0.13}, {"w": "nằm", "t": 71.32, "d": 0.2}, {"w": "ở", "t": 71.52, "d": 0.085}, {"w": "nguồn:", "t": 71.605, "d": 0.39}, {"w": "ba", "t": 71.995, "d": 0.13}, {"w": "mươi", "t": 72.125, "d": 0.06}, {"w": "mốt", "t": 72.185, "d": 0.31}, {"w": "phần", "t": 72.495, "d": 0.17}, {"w": "trăm", "t": 72.665, "d": 0.055}, {"w": "có", "t": 72.72, "d": 0.2}, {"w": "vấn", "t": 72.92, "d": 0.11}, {"w": "đề", "t": 73.03, "d": 0.3}, {"w": "lớn", "t": 73.33, "d": 0.17}, {"w": "về", "t": 73.5, "d": 0.06}, {"w": "nguồn.", "t": 73.56, "d": 0.305}]}, {"text": "Không ghi nguồn, ghi sai nguồn, hoặc dẫn một nguồn không hề nói điều mà câu trả lời gán cho nó.", "start": 74.4, "end": 78.88, "words": [{"w": "Không", "t": 74.55, "d": 0.145}, {"w": "ghi", "t": 74.695, "d": 0.205}, {"w": "nguồn,", "t": 74.9, "d": 0.36}, {"w": "ghi", "t": 75.26, "d": 0.06}, {"w": "sai", "t": 75.32, "d": 0.15}, {"w": "nguồn,", "t": 75.47, "d": 0.445}, {"w": "hoặc", "t": 75.915, "d": 0.12}, {"w": "dẫn", "t": 76.035, "d": 0.185}, {"w": "một", "t": 76.22, "d": 0.13}, {"w": "nguồn", "t": 76.35, "d": 0.14}, {"w": "không", "t": 76.49, "d": 0.27}, {"w": "hề", "t": 76.76, "d": 0.13}, {"w": "nói", "t": 76.89, "d": 0.225}, {"w": "điều", "t": 77.115, "d": 0.145}, {"w": "mà", "t": 77.26, "d": 0.21}, {"w": "câu", "t": 77.47, "d": 0.15}, {"w": "trả", "t": 77.62, "d": 0.12}, {"w": "lời", "t": 77.74, "d": 0.31}, {"w": "gán", "t": 78.05, "d": 0.2}, {"w": "cho", "t": 78.25, "d": 0.075}, {"w": "nó.", "t": 78.325, "d": 0.32}]}, {"text": "Và đây là con số mình thấy đáng nhớ nhất.", "start": 79.88, "end": 82.04, "words": [{"w": "Và", "t": 79.99, "d": 0.125}, {"w": "đây", "t": 80.115, "d": 0.285}, {"w": "là", "t": 80.4, "d": 0.15}, {"w": "con", "t": 80.55, "d": 0.065}, {"w": "số", "t": 80.615, "d": 0.29}, {"w": "mình", "t": 80.905, "d": 0.11}, {"w": "thấy", "t": 81.015, "d": 0.085}, {"w": "đáng", "t": 81.1, "d": 0.195}, {"w": "nhớ", "t": 81.295, "d": 0.145}, {"w": "nhất.", "t": 81.44, "d": 0.345}]}, {"text": "Trong hơn ba nghìn câu hỏi, các trợ lý chỉ từ chối trả lời mười bảy lần. Chưa tới một phần trăm.", "start": 82.36, "end": 86.92, "words": [{"w": "Trong", "t": 82.43, "d": 0.255}, {"w": "hơn", "t": 82.685, "d": 0.06}, {"w": "ba", "t": 82.745, "d": 0.295}, {"w": "nghìn", "t": 83.04, "d": 0.06}, {"w": "câu", "t": 83.1, "d": 0.3}, {"w": "hỏi,", "t": 83.4, "d": 0.18}, {"w": "các", "t": 83.58, "d": 0.15}, {"w": "trợ", "t": 83.73, "d": 0.16}, {"w": "lý", "t": 83.89, "d": 0.225}, {"w": "chỉ", "t": 84.115, "d": 0.18}, {"w": "từ", "t": 84.295, "d": 0.25}, {"w": "chối", "t": 84.545, "d": 0.135}, {"w": "trả", "t": 84.68, "d": 0.18}, {"w": "lời", "t": 84.86, "d": 0.21}, {"w": "mười", "t": 85.07, "d": 0.14}, {"w": "bảy", "t": 85.21, "d": 0.275}, {"w": "lần.", "t": 85.485, "d": 0.285}, {"w": "Chưa", "t": 85.77, "d": 0.1}, {"w": "tới", "t": 85.87, "d": 0.21}, {"w": "một", "t": 86.08, "d": 0.23}, {"w": "phần", "t": 86.31, "d": 0.18}, {"w": "trăm.", "t": 86.49, "d": 0.215}]}, {"text": "Báo cáo viết rằng nhiều lỗi còn nặng thêm vì sự tự tin mà các trợ lý dùng để trả lời.", "start": 87.24, "end": 91.56, "words": [{"w": "Báo", "t": 87.325, "d": 0.105}, {"w": "cáo", "t": 87.43, "d": 0.31}, {"w": "viết", "t": 87.74, "d": 0.225}, {"w": "rằng", "t": 87.965, "d": 0.19}, {"w": "nhiều", "t": 88.155, "d": 0.12}, {"w": "lỗi", "t": 88.275, "d": 0.09}, {"w": "còn", "t": 88.365, "d": 0.335}, {"w": "nặng", "t": 88.7, "d": 0.095}, {"w": "thêm", "t": 88.795, "d": 0.265}, {"w": "vì", "t": 89.06, "d": 0.22}, {"w": "sự", "t": 89.28, "d": 0.06}, {"w": "tự", "t": 89.34, "d": 0.3}, {"w": "tin", "t": 89.64, "d": 0.2}, {"w": "mà", "t": 89.84, "d": 0.19}, {"w": "các", "t": 90.03, "d": 0.19}, {"w": "trợ", "t": 90.22, "d": 0.165}, {"w": "lý", "t": 90.385, "d": 0.12}, {"w": "dùng", "t": 90.505, "d": 0.205}, {"w": "để", "t": 90.71, "d": 0.21}, {"w": "trả", "t": 90.92, "d": 0.115}, {"w": "lời.", "t": 91.035, "d": 0.345}]}, {"text": "Gần như không bao giờ có câu \"tôi không biết\". Đúng như ở kỳ thi không trừ điểm.", "start": 91.88, "end": 95.56, "words": [{"w": "Gần", "t": 91.965, "d": 0.115}, {"w": "như", "t": 92.08, "d": 0.25}, {"w": "không", "t": 92.33, "d": 0.23}, {"w": "bao", "t": 92.56, "d": 0.06}, {"w": "giờ", "t": 92.62, "d": 0.29}, {"w": "có", "t": 92.91, "d": 0.135}, {"w": "câu", "t": 93.045, "d": 0.155}, {"w": "\"tôi", "t": 93.2, "d": 0.095}, {"w": "không", "t": 93.295, "d": 0.31}, {"w": "biết\".", "t": 93.605, "d": 0.28}, {"w": "Đúng", "t": 93.885, "d": 0.06}, {"w": "như", "t": 93.945, "d": 0.135}, {"w": "ở", "t": 94.08, "d": 0.33}, {"w": "kỳ", "t": 94.41, "d": 0.06}, {"w": "thi", "t": 94.47, "d": 0.14}, {"w": "không", "t": 94.61, "d": 0.22}, {"w": "trừ", "t": 94.83, "d": 0.17}, {"w": "điểm.", "t": 95.0, "d": 0.315}]}, {"text": "Vậy bạn, người đang dùng AI mỗi ngày, nên làm gì?", "start": 96.56, "end": 99.2, "words": [{"w": "Vậy", "t": 96.665, "d": 0.135}, {"w": "bạn,", "t": 96.8, "d": 0.235}, {"w": "người", "t": 97.035, "d": 0.265}, {"w": "đang", "t": 97.3, "d": 0.18}, {"w": "dùng", "t": 97.48, "d": 0.15}, {"w": "AI", "t": 97.63, "d": 0.38}, {"w": "mỗi", "t": 98.01, "d": 0.21}, {"w": "ngày,", "t": 98.22, "d": 0.265}, {"w": "nên", "t": 98.485, "d": 0.06}, {"w": "làm", "t": 98.545, "d": 0.3}, {"w": "gì?", "t": 98.845, "d": 0.205}]}], "imgs": {"sdny": {"src": "assets/long/mim-ai-hallucinate/img/sdny.jpg", "w": 1350, "h": 2400, "lic": "CC BY 2.0", "by": "Ajay Suresh from New York, NY, USA", "pd": false}, "moynihan": {"src": "assets/long/mim-ai-hallucinate/img/moynihan.jpg", "w": 1600, "h": 2400, "lic": "CC BY 4.0", "by": "83136374@