motion/hf/assets/long\ck-e5-thue-tncn-2026\ch01\data.js:1:window.CASE = {"topic": "ck-e5-thue-tncn-2026", "ch": "ch01", "dur": 126.54, "seed": 22565, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHẶNG 01", "t": "TỪ LƯƠNG GỘP TỚI THU NHẬP TÍNH THUẾ"}, "acc": ["thuế", "giảm", "trừ", "bậc", "lương", "triệu", "nghìn"], "lines": [{"text": "Con đường bắt đầu từ con số trên hợp đồng.", "start": 0.0, "end": 2.4, "words": [{"w": "Con", "t": 0.1, "d": 0.155}, {"w": "đường", "t": 0.255, "d": 0.23}, {"w": "bắt", "t": 0.485, "d": 0.115}, {"w": "đầu", "t": 0.6, "d": 0.265}, {"w": "từ", "t": 0.865, "d": 0.17}, {"w": "con", "t": 1.035, "d": 0.23}, {"w": "số", "t": 1.265, "d": 0.18}, {"w": "trên", "t": 1.445, "d": 0.06}, {"w": "hợp", "t": 1.505, "d": 0.28}, {"w": "đồng.", "t": 1.785, "d": 0.24}]}, {"text": "Hai mươi lăm triệu, lương gộp.", "start": 3.2, "end": 4.88, "words": [{"w": "Hai", "t": 3.285, "d": 0.12}, {"w": "mươi", "t": 3.405, "d": 0.245}, {"w": "lăm", "t": 3.65, "d": 0.1}, {"w": "triệu,", "t": 3.75, "d": 0.405}, {"w": "lương", "t": 4.155, "d": 0.06}, {"w": "gộp.", "t": 4.215, "d": 0.34}]}, {"text": "Trạm đầu tiên là bảo hiểm bắt buộc.", "start": 5.88, "end": 7.88, "words": [{"w": "Trạm", "t": 5.97, "d": 0.125}, {"w": "đầu", "t": 6.095, "d": 0.26}, {"w": "tiên", "t": 6.355, "d": 0.22}, {"w": "là", "t": 6.575, "d": 0.145}, {"w": "bảo", "t": 6.72, "d": 0.215}, {"w": "hiểm", "t": 6.935, "d": 0.18}, {"w": "bắt", "t": 7.115, "d": 0.175}, {"w": "buộc.", "t": 7.29, "d": 0.215}]}, {"text": "Người lao động đóng tám phần trăm cho bảo hiểm xã hội.", "start": 8.2, "end": 11.0, "words": [{"w": "Người", "t": 8.265, "d": 0.265}, {"w": "lao", "t": 8.53, "d": 0.2}, {"w": "động", "t": 8.73, "d": 0.06}, {"w": "đóng", "t": 8.79, "d": 0.305}, {"w": "tám", "t": 9.095, "d": 0.21}, {"w": "phần", "t": 9.305, "d": 0.19}, {"w": "trăm", "t": 9.495, "d": 0.065}, {"w": "cho", "t": 9.56, "d": 0.195}, {"w": "bảo", "t": 9.755, "d": 0.315}, {"w": "hiểm", "t": 10.07, "d": 0.19}, {"w": "xã", "t": 10.26, "d": 0.13}, {"w": "hội.", "t": 10.39, "d": 0.285}]}, {"text": "Một phẩy năm phần trăm cho bảo hiểm y tế.", "start": 11.32, "end": 13.72, "words": [{"w": "Một", "t": 11.37, "d": 0.185}, {"w": "phẩy", "t": 11.555, "d": 0.21}, {"w": "năm", "t": 11.765, "d": 0.175}, {"w": "phần", "t": 11.94, "d": 0.14}, {"w": "trăm", "t": 12.08, "d": 0.26}, {"w": "cho", "t": 12.34, "d": 0.13}, {"w": "bảo", "t": 12.47, "d": 0.18}, {"w": "hiểm", "t": 12.65, "d": 0.25}, {"w": "y", "t": 12.9, "d": 0.17}, {"w": "tế.", "t": 13.07, "d": 0.25}]}, {"text": "Và một phần trăm cho bảo hiểm thất nghiệp.", "start": 14.04, "end": 16.12, "words": [{"w": "Và", "t": 14.11, "d": 0.135}, {"w": "một", "t": 14.245, "d": 0.225}, {"w": "phần", "t": 14.47, "d": 0.19}, {"w": "trăm", "t": 14.66, "d": 0.215}, {"w": "cho", "t": 14.875, "d": 0.065}, {"w": "bảo", "t": 14.94, "d": 0.28}, {"w": "hiểm", "t": 15.22, "d": 0.17}, {"w": "thất", "t": 15.39, "d": 0.175}, {"w": "nghiệp.", "t": 15.565, "d": 0.2}]}, {"text": "Cộng lại là mười phẩy năm phần trăm. Hơn một phần mười.", "start": 17.12, "end": 20.16, "words": [{"w": "Cộng", "t": 17.21, "d": 0.275}, {"w": "lại", "t": 17.485, "d": 0.055}, {"w": "là", "t": 17.54, "d": 0.335}, {"w": "mười", "t": 17.875, "d": 0.055}, {"w": "phẩy", "t": 17.93, "d": 0.325}, {"w": "năm", "t": 18.255, "d": 0.155}, {"w": "phần", "t": 18.41, "d": 0.245}, {"w": "trăm.", "t": 18.655, "d": 0.15}, {"w": "Hơn", "t": 18.805, "d": 0.185}, {"w": "một", "t": 18.99, "d": 0.365}, {"w": "phần", "t": 19.355, "d": 0.055}, {"w": "mười.", "t": 19.41, "d": 0.37}]}, {"text": "Với hai mươi lăm triệu, khoảng hai triệu sáu trăm hai mươi lăm nghìn.", "start": 20.48, "end": 23.84, "words": [{"w": "Với", "t": 20.535, "d": 0.245}, {"w": "hai", "t": 20.78, "d": 0.06}, {"w": "mươi", "t": 20.84, "d": 0.335}, {"w": "lăm", "t": 21.175, "d": 0.095}, {"w": "triệu,", "t": 21.27, "d": 0.3}, {"w": "khoảng", "t": 21.57, "d": 0.15}, {"w": "hai", "t": 21.72, "d": 0.21}, {"w": "triệu", "t": 21.93, "d": 0.205}, {"w": "sáu", "t": 22.135, "d": 0.31}, {"w": "trăm", "t": 22.445, "d": 0.16}, {"w": "hai", "t": 22.605, "d": 0.205}, {"w": "mươi", "t": 22.81, "d": 0.115}, {"w": "lăm", "t": 22.925, "d": 0.235}, {"w": "nghìn.", "t": 23.16, "d": 0.31}]}, {"text": "Phần này được trừ ra trước khi tính thuế.", "start": 24.16, "end": 26.32, "words": [{"w": "Phần", "t": 24.24, "d": 0.13}, {"w": "này", "t": 24.37, "d": 0.3}, {"w": "được", "t": 24.67, "d": 0.06}, {"w": "trừ", "t": 24.73, "d": 0.275}, {"w": "ra", "t": 25.005, "d": 0.145}, {"w": "trước", "t": 25.15, "d": 0.215}, {"w": "khi", "t": 25.365, "d": 0.16}, {"w": "tính", "t": 25.525, "d": 0.165}, {"w": "thuế.", "t": 25.69, "d": 0.255}]}, {"text": "Còn hai mươi hai triệu ba trăm bảy mươi lăm nghìn.", "start": 26.64, "end": 29.04, "words": [{"w": "Còn", "t": 26.69, "d": 0.195}, {"w": "hai", "t": 26.885, "d": 0.135}, {"w": "mươi", "t": 27.02, "d": 0.155}, {"w": "hai", "t": 27.175, "d": 0.225}, {"w": "triệu", "t": 27.4, "d": 0.085}, {"w": "ba", "t": 27.485, "d": 0.305}, {"w": "trăm", "t": 27.79, "d": 0.065}, {"w": "bảy", "t": 27.855, "d": 0.16}, {"w": "mươi", "t": 28.015, "d": 0.145}, {"w": "lăm", "t": 28.16, "d": 0.235}, {"w": "nghìn.", "t": 28.395, "d": 0.29}]}, {"text": "Trạm thứ hai mới là trạm lớn nhất: giảm trừ gia cảnh.", "start": 30.04, "end": 33.24, "words": [{"w": "Trạm", "t": 30.145, "d": 0.205}, {"w": "thứ", "t": 30.35, "d": 0.125}, {"w": "hai", "t": 30.475, "d": 0.195}, {"w": "mới", "t": 30.67, "d": 0.38}, {"w": "là", "t": 31.05, "d": 0.06}, {"w": "trạm", "t": 31.11, "d": 0.185}, {"w": "lớn", "t": 31.295, "d": 0.39}, {"w": "nhất:", "t": 31.685, "d": 0.15}, {"w": "giảm", "t": 31.835, "d": 0.205}, {"w": "trừ", "t": 32.04, "d": 0.275}, {"w": "gia", "t": 32.315, "d": 0.225}, {"w": "cảnh.", "t": 32.54, "d": 0.345}]}, {"text": "Từ năm nay, mỗi người nộp thuế được trừ mười lăm triệu rưỡi một tháng cho bản thân.", "start": 33.56, "end": 37.72, "words": [{"w": "Từ", "t": 33.655, "d": 0.23}, {"w": "năm", "t": 33.885, "d": 0.09}, {"w": "nay,", "t": 33.975, "d": 0.295}, {"w": "mỗi", "t": 34.27, "d": 0.325}, {"w": "người", "t": 34.595, "d": 0.06}, {"w": "nộp", "t": 34.655, "d": 0.32}, {"w": "thuế", "t": 34.975, "d": 0.22}, {"w": "được", "t": 35.195, "d": 0.175}, {"w": "trừ", "t": 35.37, "d": 0.07}, {"w": "mười", "t": 35.44, "d": 0.295}, {"w": "lăm", "t": 35.735, "d": 0.2}, {"w": "triệu", "t": 35.935, "d": 0.215}, {"w": "rưỡi", "t": 36.15, "d": 0.18}, {"w": "một", "t": 36.33, "d": 0.21}, {"w": "tháng", "t": 36.54, "d": 0.06}, {"w": "cho", "t": 36.6, "d": 0.215}, {"w": "bản", "t": 36.815, "d": 0.3}, {"w": "thân.", "t": 37.115, "d": 0.23}]}, {"text": "Mỗi người phụ thuộc được trừ thêm sáu triệu hai. Tăng hơn bốn phần mười.", "start": 38.04, "end": 41.8, "words": [{"w": "Mỗi", "t": 38.095, "d": 0.135}, {"w": "người", "t": 38.23, "d": 0.36}, {"w": "phụ", "t": 38.59, "d": 0.17}, {"w": "thuộc", "t": 38.76, "d": 0.18}, {"w": "được", "t": 38.94, "d": 0.22}, {"w": "trừ", "t": 39.16, "d": 0.255}, {"w": "thêm", "t": 39.415, "d": 0.195}, {"w": "sáu", "t": 39.61, "d": 0.06}, {"w": "triệu", "t": 39.67, "d": 0.18}, {"w": "hai.", "t": 39.85, "d": 0.375}, {"w": "Tăng", "t": 40.225, "d": 0.17}, {"w": "hơn", "t": 40.395, "d": 0.225}, {"w": "bốn", "t": 40.62, "d": 0.21}, {"w": "phần", "t": 40.83, "d": 0.225}, {"w": "mười.", "t": 41.055, "d": 0.37}]}, {"text": "Năm ngoái, hai con số ấy chỉ là mười một triệu, và bốn triệu bốn.", "start": 42.12, "end": 46.28, "words": [{"w": "Năm", "t": 42.185, "d": 0.12}, {"w": "ngoái,", "t": 42.305, "d": 0.48}, {"w": "hai", "t": 42.785, "d": 0.245}, {"w": "con", "t": 43.03, "d": 0.22}, {"w": "số", "t": 43.25, "d": 0.285}, {"w": "ấy", "t": 43.535, "d": 0.06}, {"w": "chỉ", "t": 43.595, "d": 0.195}, {"w": "là", "t": 43.79, "d": 0.42}, {"w": "mười", "t": 44.21, "d": 0.055}, {"w": "một", "t": 44.265, "d": 0.395}, {"w": "triệu,", "t": 44.66, "d": 0.25}, {"w": "và", "t": 44.91, "d": 0.21}, {"w": "bốn", "t": 45.12, "d": 0.175}, {"w": "triệu", "t": 45.295, "d": 0.27}, {"w": "bốn.", "t": 45.565, "d": 0.395}]}, {"text": "Người phụ thuộc là ai mới được tính?", "start": 47.28, "end": 49.28, "ask": 1, "words": [{"w": "Người", "t": 47.375, "d": 0.255}, {"w": "phụ", "t": 47.63, "d": 0.185}, {"w": "thuộc", "t": 47.815, "d": 0.22}, {"w": "là", "t": 48.035, "d": 0.21}, {"w": "ai", "t": 48.245, "d": 0.07}, {"w": "mới", "t": 48.315, "d": 0.315}, {"w": "được", "t": 48.63, "d": 0.185}, {"w": "tính?", "t": 48.815, "d": 0.26}]}, {"text": "Thường là con nhỏ, hoặc cha mẹ, vợ chồng không có thu nhập đáng kể.", "start": 49.88, "end": 53.64, "words": [{"w": "Thường", "t": 49.975, "d": 0.28}, {"w": "là", "t": 50.255, "d": 0.06}, {"w": "con", "t": 50.315, "d": 0.335}, {"w": "nhỏ,", "t": 50.65, "d": 0.215}, {"w": "hoặc", "t": 50.865, "d": 0.24}, {"w": "cha", "t": 51.105, "d": 0.08}, {"w": "mẹ,", "t": 51.185, "d": 0.46}, {"w": "vợ", "t": 51.645, "d": 0.06}, {"w": "chồng", "t": 51.705, "d": 0.225}, {"w": "không", "t": 51.93, "d": 0.23}, {"w": "có", "t": 52.16, "d": 0.2}, {"w": "thu", "t": 52.36, "d": 0.16}, {"w": "nhập", "t": 52.52, "d": 0.325}, {"w": "đáng", "t": 52.845, "d": 0.21}, {"w": "kể.", "t": 53.055, "d": 0.235}]}, {"text": "Từ năm nay, ngưỡng thu nhập của người phụ thuộc được nâng từ một triệu lên ba triệu đồng một tháng.", "start": 53.96, "end": 58.6, "words": [{"w": "Từ", "t": 54.01, "d": 0.25}, {"w": "năm", "t": 54.26, "d": 0.065}, {"w": "nay,", "t": 54.325, "d": 0.41}, {"w": "ngưỡng", "t": 54.735, "d": 0.06}, {"w": "thu", "t": 54.795, "d": 0.255}, {"w": "nhập", "t": 55.05, "d": 0.285}, {"w": "của", "t": 55.335, "d": 0.06}, {"w": "người", "t": 55.395, "d": 0.32}, {"w": "phụ", "t": 55.715, "d": 0.075}, {"w": "thuộc", "t": 55.79, "d": 0.14}, {"w": "được", "t": 55.93, "d": 0.35}, {"w": "nâng", "t": 56.28, "d": 0.06}, {"w": "từ", "t": 56.34, "d": 0.23}, {"w": "một", "t": 56.57, "d": 0.275}, {"w": "triệu", "t": 56.845, "d": 0.075}, {"w": "lên", "t": 56.92, "d": 0.31}, {"w": "ba", "t": 57.23, "d": 0.185}, {"w": "triệu", "t": 57.415, "d": 0.09}, {"w": "đồng", "t": 57.505, "d": 0.125}, {"w": "một", "t": 57.63, "d": 0.31}, {"w": "tháng.", "t": 57.94, "d": 0.27}]}, {"text": "Và phải đăng ký người phụ thuộc thì mới được trừ.", "start": 58.92, "end": 61.48, "words": [{"w": "Và", "t": 59.01, "d": 0.15}, {"w": "phải", "t": 59.16, "d": 0.21}, {"w": "đăng", "t": 59.37, "d": 0.18}, {"w": "ký", "t": 59.55, "d": 0.23}, {"w": "người", "t": 59.78, "d": 0.185}, {"w": "phụ", "t": 59.965, "d": 0.155}, {"w": "thuộc", "t": 60.12, "d": 0.22}, {"w": "thì", "t": 60.34, "d": 0.06}, {"w": "mới", "t": 60.4, "d": 0.295}, {"w": "được", "t": 60.695, "d": 0.165}, {"w": "trừ.", "t": 60.86, "d": 0.23}]}, {"text": "Không đăng ký, phần giảm trừ ấy coi như không có. Mất trắng.", "start": 61.8, "end": 65.48, "words": [{"w": "Không", "t": 61.9, "d": 0.31}, {"w": "đăng", "t": 62.21, "d": 0.055}, {"w": "ký,", "t": 62.265, "d": 0.395}, {"w": "phần", "t": 62.66, "d": 0.305}, {"w": "giảm", "t": 62.965, "d": 0.235}, {"w": "trừ", "t": 63.2, "d": 0.06}, {"w": "ấy", "t": 63.26, "d": 0.32}, {"w": "coi", "t": 63.58, "d": 0.3}, {"w": "như", "t": 63.88, "d": 0.185}, {"w": "không", "t": 64.065, "d": 0.255}, {"w": "có.", "t": 64.32, "d": 0.255}, {"w": "Mất", "t": 64.575, "d": 0.12}, {"w": "trắng.", "t": 64.695, "d": 0.455}]}, {"text": "Và có một quy định ít người để ý.", "start": 66.48, "end": 68.56, "words": [{"w": "Và", "t": 66.575, "d": 0.155}, {"w": "có", "t": 66.73, "d": 0.135}, {"w": "một", "t": 66.865, "d": 0.21}, {"w": "quy", "t": 67.075, "d": 0.245}, {"w": "định", "t": 67.32, "d": 0.075}, {"w": "ít", "t": 67.395, "d": 0.14}, {"w": "người", "t": 67.535, "d": 0.27}, {"w": "để", "t": 67.805, "d": 0.155}, {"w": "ý.", "t": 67.96, "d": 0.24}]}, {"text": "Mỗi người phụ thuộc chỉ được tính giảm trừ một lần, vào một người nộp thuế.", "start": 68.88, "end": 72.8, "words": [{"w": "Mỗi", "t": 68.945, "d": 0.115}, {"w": "người", "t": 69.06, "d": 0.385}, {"w": "phụ", "t": 69.445, "d": 0.205}, {"w": "thuộc", "t": 69.65, "d": 0.085}, {"w": "chỉ", "t": 69.735, "d": 0.28}, {"w": "được", "t": 70.015, "d": 0.235}, {"w": "tính", "t": 70.25, "d": 0.205}, {"w": "giảm", "t": 70.455, "d": 0.065}, {"w": "trừ", "t": 70.52, "d": 0.285}, {"w": "một", "t": 70.805, "d": 0.28}, {"w": "lần,", "t": 71.085, "d": 0.28}, {"w": "vào", "t": 71.365, "d": 0.075}, {"w": "một", "t": 71.44, "d": 0.335}, {"w": "người", "t": 71.775, "d": 0.195}, {"w": "nộp", "t": 71.97, "d": 0.24}, {"w": "thuế.", "t": 72.21, "d": 0.265}]}, {"text": "Con của anh Khang chỉ có thể được đăng ký cho anh, hoặc cho vợ anh, không cho cả hai.", "start": 73.12, "end": 77.92, "words": [{"w": "Con", "t": 73.17, "d": 0.19}, {"w": "của", "t": 73.36, "d": 0.115}, {"w": "anh", "t": 73.475, "d": 0.22}, {"w": "Khang", "t": 73.695, "d": 0.265}, {"w": "chỉ", "t": 73.96, "d": 0.165}, {"w": "có", "t": 74.125, "d": 0.15}, {"w": "thể", "t": 74.275, "d": 0.31}, {"w": "được", "t": 74.585, "d": 0.25}, {"w": "đăng", "t": 74.835, "d": 0.195}, {"w": "ký", "t": 75.03, "d": 0.06}, {"w": "cho", "t": 75.09, "d": 0.36}, {"w": "anh,", "t": 75.45, "d": 0.145}, {"w": "hoặc", "t": 75.595, "d": 0.245}, {"w": "cho", "t": 75.84, "d": 0.215}, {"w": "vợ", "t": 76.055, "d": 0.145}, {"w": "anh,", "t": 76.2, "d": 0.41}, {"w": "không", "t": 76.61, "d": 0.105}, {"w": "cho", "t": 76.715, "d": 0.375}, {"w": "cả", "t": 77.09, "d": 0.2}, {"w": "hai.", "t": 77.29, "d": 0.235}]}, {"text": "Giả sử vợ anh lương mười lăm triệu, thấp hơn mức phải nộp thuế, và con được đăng ký cho chị.", "start": 78.92, "end": 84.04, "words": [{"w": "Giả", "t": 78.985, "d": 0.285}, {"w": "sử", "t": 79.27, "d": 0.195}, {"w": "vợ", "t": 79.465, "d": 0.12}, {"w": "anh", "t": 79.585, "d": 0.16}, {"w": "lương", "t": 79.745, "d": 0.19}, {"w": "mười", "t": 79.935, "d": 0.36}, {"w": "lăm", "t": 80.295, "d": 0.105}, {"w": "triệu,", "t": 80.4, "d": 0.305}, {"w": "thấp", "t": 80.705, "d": 0.225}, {"w": "hơn", "t": 80.93, "d": 0.175}, {"w": "mức", "t": 81.105, "d": 0.195}, {"w": "phải", "t": 81.3, "d": 0.345}, {"w": "nộp", "t": 81.645, "d": 0.09}, {"w": "thuế,", "t": 81.735, "d": 0.44}, {"w": "và", "t": 82.175, "d": 0.08}, {"w": "con", "t": 82.255, "d": 0.265}, {"w": "được", "t": 82.52, "d": 0.27}, {"w": "đăng", "t": 82.79, "d": 0.06}, {"w": "ký", "t": 82.85, "d": 0.225}, {"w": "cho", "t": 83.075, "d": 0.205}, {"w": "chị.", "t": 83.28, "d": 0.365}]}, {"text": "Phần giảm trừ sáu triệu hai không giúp chị bớt đồng nào, vì chị vốn không phải nộp.", "start": 84.36, "end": 88.6, "words": [{"w": "Phần", "t": 84.445, "d": 0.165}, {"w": "giảm", "t": 84.61, "d": 0.22}, {"w": "trừ", "t": 84.83, "d": 0.265}, {"w": "sáu", "t": 85.095, "d": 0.18}, {"w": "triệu", "t": 85.275, "d": 0.07}, {"w": "hai", "t": 85.345, "d": 0.315}, {"w": "không", "t": 85.66, "d": 0.225}, {"w": "giúp", "t": 85.885, "d": 0.12}, {"w": "chị", "t": 86.005, "d": 0.205}, {"w": "bớt", "t": 86.21, "d": 0.205}, {"w": "đồng", "t": 86.415, "d": 0.255}, {"w": "nào,", "t": 86.67, "d": 0.345}, {"w": "vì", "t": 87.015, "d": 0.1}, {"w": "chị", "t": 87.115, "d": 0.205}, {"w": "vốn", "t": 87.32, "d": 0.215}, {"w": "không", "t": 87.535, "d": 0.175}, {"w": "phải", "t": 87.71, "d": 0.21}, {"w": "nộp.", "t": 87.92, "d": 0.335}]}, {"text": "Còn thuế của anh Khang lên khoảng ba trăm bốn mươi ba nghìn một tháng.", "start": 88.92, "end": 92.2, "words": [{"w": "Còn", "t": 88.98, "d": 0.155}, {"w": "thuế", "t": 89.135, "d": 0.24}, {"w": "của", "t": 89.375, "d": 0.135}, {"w": "anh", "t": 89.51, "d": 0.215}, {"w": "Khang", "t": 89.725, "d": 0.105}, {"w": "lên", "t": 89.83, "d": 0.285}, {"w": "khoảng", "t": 90.115, "d": 0.21}, {"w": "ba", "t": 90.325, "d": 0.18}, {"w": "trăm", "t": 90.505, "d": 0.06}, {"w": "bốn", "t": 90.565, "d": 0.255}, {"w": "mươi", "t": 90.82, "d": 0.175}, {"w": "ba", "t": 90.995, "d": 0.17}, {"w": "nghìn", "t": 91.165, "d": 0.22}, {"w": "một", "t": 91.385, "d": 0.19}, {"w": "tháng.", "t": 91.575, "d": 0.28}]}, {"text": "Mỗi năm chênh nhau khoảng ba triệu bảy.", "start": 92.52, "end": 94.52, "words": [{"w": "Mỗi", "t": 92.605, "d": 0.2}, {"w": "năm", "t": 92.805, "d": 0.175}, {"w": "chênh", "t": 92.98, "d": 0.125}, {"w": "nhau", "t": 93.105, "d": 0.3}, {"w": "khoảng", "t": 93.405, "d": 0.215}, {"w": "ba", "t": 93.62, "d": 0.185}, {"w": "triệu", "t": 93.805, "d": 0.105}, {"w": "bảy.", "t": 93.91, "d": 0.305}]}, {"text": "Cùng một đứa trẻ, cùng một gia đình. Khác nhau ở một tờ đăng ký.", "start": 95.52, "end": 99.44, "words": [{"w": "Cùng", "t": 95.64, "d": 0.27}, {"w": "một", "t": 95.91, "d": 0.19}, {"w": "đứa", "t": 96.1, "d": 0.06}, {"w": "trẻ,", "t": 96.16, "d": 0.415}, {"w": "cùng", "t": 96.575, "d": 0.14}, {"w": "một", "t": 96.715, "d": 0.265}, {"w": "gia", "t": 96.98, "d": 0.13}, {"w": "đình.", "t": 97.11, "d": 0.385}, {"w": "Khác", "t": 97.495, "d": 0.14}, {"w": "nhau", "t": 97.635, "d": 0.255}, {"w": "ở", "t": 97.89, "d": 0.23}, {"w": "một", "t": 98.12, "d": 0.31}, {"w": "tờ", "t": 98.43, "d": 0.195}, {"w": "đăng", "t": 98.625, "d": 0.19}, {"w": "ký.", "t": 98.815, "d": 0.265}]}, {"text": "Anh Khang có một người phụ thuộc.", "start": 99.76, "end": 101.6, "words": [{"w": "Anh", "t": 99.815, "d": 0.18}, {"w": "Khang", "t": 99.995, "d": 0.23}, {"w": "có", "t": 100.225, "d": 0.06}, {"w": "một", "t": 100.285, "d": 0.275}, {"w": "người", "t": 100.56, "d": 0.225}, {"w": "phụ", "t": 100.785, "d": 0.08}, {"w": "thuộc.", "t": 100.865, "d": 0.315}]}, {"text": "Mười lăm triệu rưỡi cộng sáu triệu hai, là hai mươi mốt triệu bảy.", "start": 101.92, "end": 105.36, "words": [{"w": "Mười", "t": 101.975, "d": 0.26}, {"w": "lăm", "t": 102.235, "d": 0.075}, {"w": "triệu", "t": 102.31, "d": 0.215}, {"w": "rưỡi", "t": 102.525, "d": 0.195}, {"w": "cộng", "t": 102.72, "d": 0.28}, {"w": "sáu", "t": 103.0, "d": 0.18}, {"w": "triệu", "t": 103.18, "d": 0.21}, {"w": "hai,", "t": 103.39, "d": 0.345}, {"w": "là", "t": 103.735, "d": 0.06}, {"w": "hai", "t": 103.795, "d": 0.325}, {"w": "mươi", "t": 104.12, "d": 0.13}, {"w": "mốt", "t": 104.25, "d": 0.305}, {"w": "triệu", "t": 104.555, "d": 0.11}, {"w": "bảy.", "t": 104.665, "d": 0.325}]}, {"text": "Lấy hai mươi hai triệu ba trăm bảy mươi lăm, trừ hai mươi mốt triệu bảy.", "start": 105.68, "end": 109.2, "words": [{"w": "Lấy", "t": 105.78, "d": 0.17}, {"w": "hai", "t": 105.95, "d": 0.26}, {"w": "mươi", "t": 106.21, "d": 0.175}, {"w": "hai", "t": 106.385, "d": 0.075}, {"w": "triệu", "t": 106.46, "d": 0.125}, {"w": "ba", "t": 106.585, "d": 0.18}, {"w": "trăm", "t": 106.765, "d": 0.33}, {"w": "bảy", "t": 107.095, "d": 0.06}, {"w": "mươi", "t": 107.155, "d": 0.295}, {"w": "lăm,", "t": 107.45, "d": 0.22}, {"w": "trừ", "t": 107.67, "d": 0.09}, {"w": "hai", "t": 107.76, "d": 0.225}, {"w": "mươi", "t": 107.985, "d": 0.15}, {"w": "mốt", "t": 108.135, "d": 0.31}, {"w": "triệu", "t": 108.445, "d": 0.08}, {"w": "bảy.", "t": 108.525, "d": 0.31}]}, {"text": "Còn lại sáu trăm bảy mươi lăm nghìn.", "start": 109.52, "end": 111.52, "words": [{"w": "Còn", "t": 109.595, "d": 0.195}, {"w": "lại", "t": 109.79, "d": 0.23}, {"w": "sáu", "t": 110.02, "d": 0.06}, {"w": "trăm", "t": 110.08, "d": 0.155}, {"w": "bảy", "t": 110.235, "d": 0.33}, {"w": "mươi", "t": 110.565, "d": 0.06}, {"w": "lăm", "t": 110.625, "d": 0.205}, {"w": "nghìn.", "t": 110.83, "d": 0.31}]}, {"text": "Đó là thu nhập tính thuế của anh.", "start": 112.52, "end": 114.6, "words": [{"w": "Đó", "t": 112.575, "d": 0.24}, {"w": "là", "t": 112.815, "d": 0.13}, {"w": "thu", "t": 112.945, "d": 0.29}, {"w": "nhập", "t": 113.235, "d": 0.14}, {"w": "tính", "t": 113.375, "d": 0.23}, {"w": "thuế", "t": 113.605, "d": 0.205}, {"w": "của", "t": 113.81, "d": 0.07}, {"w": "anh.", "t": 113.88, "d": 0.355}]}, {"text": "Không phải hai mươi lăm triệu.", "start": 114.92, "end": 116.44, "words": [{"w": "Không", "t": 114.975, "d": 0.18}, {"w": "phải", "t": 115.155, "d": 0.215}, {"w": "hai", "t": 115.37, "d": 0.06}, {"w": "mươi", "t": 115.43, "d": 0.28}, {"w": "lăm", "t": 115.71, "d": 0.145}, {"w": "triệu.", "t": 115.855, "d": 0.245}]}, {"text": "Chỉ h