motion/hf/assets/long\ck-a2-luong-va-lam-phat\ch03\data.js:1:window.CASE = {"topic": "ck-a2-luong-va-lam-phat", "ch": "ch03", "dur": 116.5, "seed": 33415, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 03", "t": "NHỮNG NĂM GIÁ CHẠY NHANH"}, "acc": ["lạm", "phát", "lương", "giá", "triệu", "giỏ", "thực"], "lines": [{"text": "Năm hai nghìn không trăm lẻ tám, giá cả ở Việt Nam tăng bình quân khoảng hai mươi ba phần trăm.", "start": 0.0, "end": 4.72, "words": [{"w": "Năm", "t": 0.055, "d": 0.145}, {"w": "hai", "t": 0.2, "d": 0.305}, {"w": "nghìn", "t": 0.505, "d": 0.11}, {"w": "không", "t": 0.615, "d": 0.295}, {"w": "trăm", "t": 0.91, "d": 0.105}, {"w": "lẻ", "t": 1.015, "d": 0.275}, {"w": "tám,", "t": 1.29, "d": 0.18}, {"w": "giá", "t": 1.47, "d": 0.315}, {"w": "cả", "t": 1.785, "d": 0.205}, {"w": "ở", "t": 1.99, "d": 0.195}, {"w": "Việt", "t": 2.185, "d": 0.12}, {"w": "Nam", "t": 2.305, "d": 0.265}, {"w": "tăng", "t": 2.57, "d": 0.065}, {"w": "bình", "t": 2.635, "d": 0.325}, {"w": "quân", "t": 2.96, "d": 0.06}, {"w": "khoảng", "t": 3.02, "d": 0.18}, {"w": "hai", "t": 3.2, "d": 0.27}, {"w": "mươi", "t": 3.47, "d": 0.265}, {"w": "ba", "t": 3.735, "d": 0.19}, {"w": "phần", "t": 3.925, "d": 0.06}, {"w": "trăm.", "t": 3.985, "d": 0.365}]}, {"text": "Chỉ trong một năm.", "start": 5.52, "end": 6.72, "words": [{"w": "Chỉ", "t": 5.58, "d": 0.175}, {"w": "trong", "t": 5.755, "d": 0.14}, {"w": "một", "t": 5.895, "d": 0.22}, {"w": "năm.", "t": 6.115, "d": 0.24}]}, {"text": "Một trăm nghìn của năm hai nghìn không trăm lẻ bảy, sang năm sau chỉ còn sức mua cỡ tám mươi mốt nghìn.", "start": 7.72, "end": 12.68, "words": [{"w": "Một", "t": 7.78, "d": 0.17}, {"w": "trăm", "t": 7.95, "d": 0.13}, {"w": "nghìn", "t": 8.08, "d": 0.265}, {"w": "của", "t": 8.345, "d": 0.275}, {"w": "năm", "t": 8.62, "d": 0.06}, {"w": "hai", "t": 8.68, "d": 0.255}, {"w": "nghìn", "t": 8.935, "d": 0.145}, {"w": "không", "t": 9.08, "d": 0.295}, {"w": "trăm", "t": 9.375, "d": 0.06}, {"w": "lẻ", "t": 9.435, "d": 0.325}, {"w": "bảy,", "t": 9.76, "d": 0.135}, {"w": "sang", "t": 9.895, "d": 0.245}, {"w": "năm", "t": 10.14, "d": 0.275}, {"w": "sau", "t": 10.415, "d": 0.19}, {"w": "chỉ", "t": 10.605, "d": 0.18}, {"w": "còn", "t": 10.785, "d": 0.23}, {"w": "sức", "t": 11.015, "d": 0.155}, {"w": "mua", "t": 11.17, "d": 0.225}, {"w": "cỡ", "t": 11.395, "d": 0.08}, {"w": "tám", "t": 11.475, "d": 0.21}, {"w": "mươi", "t": 11.685, "d": 0.125}, {"w": "mốt", "t": 11.81, "d": 0.34}, {"w": "nghìn.", "t": 12.15, "d": 0.23}]}, {"text": "Gần một phần năm sức mua biến mất trong mười hai tháng.", "start": 13.0, "end": 15.72, "words": [{"w": "Gần", "t": 13.07, "d": 0.25}, {"w": "một", "t": 13.32, "d": 0.12}, {"w": "phần", "t": 13.44, "d": 0.225}, {"w": "năm", "t": 13.665, "d": 0.22}, {"w": "sức", "t": 13.885, "d": 0.105}, {"w": "mua", "t": 13.99, "d": 0.18}, {"w": "biến", "t": 14.17, "d": 0.25}, {"w": "mất", "t": 14.42, "d": 0.14}, {"w": "trong", "t": 14.56, "d": 0.12}, {"w": "mười", "t": 14.68, "d": 0.27}, {"w": "hai", "t": 14.95, "d": 0.195}, {"w": "tháng.", "t": 15.145, "d": 0.255}]}, {"text": "Ba năm sau, năm hai nghìn không trăm mười một, lạm phát lại lên gần mười chín phần trăm.", "start": 16.72, "end": 21.44, "words": [{"w": "Ba", "t": 16.805, "d": 0.28}, {"w": "năm", "t": 17.085, "d": 0.165}, {"w": "sau,", "t": 17.25, "d": 0.38}, {"w": "năm", "t": 17.63, "d": 0.06}, {"w": "hai", "t": 17.69, "d": 0.245}, {"w": "nghìn", "t": 17.935, "d": 0.28}, {"w": "không", "t": 18.215, "d": 0.145}, {"w": "trăm", "t": 18.36, "d": 0.275}, {"w": "mười", "t": 18.635, "d": 0.245}, {"w": "một,", "t": 18.88, "d": 0.15}, {"w": "lạm", "t": 19.03, "d": 0.345}, {"w": "phát", "t": 19.375, "d": 0.185}, {"w": "lại", "t": 19.56, "d": 0.175}, {"w": "lên", "t": 19.735, "d": 0.295}, {"w": "gần", "t": 20.03, "d": 0.105}, {"w": "mười", "t": 20.135, "d": 0.27}, {"w": "chín", "t": 20.405, "d": 0.08}, {"w": "phần", "t": 20.485, "d": 0.195}, {"w": "trăm.", "t": 20.68, "d": 0.42}]}, {"text": "Cộng cả năm năm, từ năm hai nghìn không trăm lẻ bảy tới năm hai nghìn không trăm mười hai, cái giỏ hàng đắt lên gần gấp đôi.", "start": 21.76, "end": 28.16, "words": [{"w": "Cộng", "t": 21.855, "d": 0.185}, {"w": "cả", "t": 22.04, "d": 0.165}, {"w": "năm", "t": 22.205, "d": 0.16}, {"w": "năm,", "t": 22.365, "d": 0.47}, {"w": "từ", "t": 22.835, "d": 0.09}, {"w": "năm", "t": 22.925, "d": 0.27}, {"w": "hai", "t": 23.195, "d": 0.145}, {"w": "nghìn", "t": 23.34, "d": 0.31}, {"w": "không", "t": 23.65, "d": 0.115}, {"w": "trăm", "t": 23.765, "d": 0.285}, {"w": "lẻ", "t": 24.05, "d": 0.06}, {"w": "bảy", "t": 24.11, "d": 0.325}, {"w": "tới", "t": 24.435, "d": 0.06}, {"w": "năm", "t": 24.495, "d": 0.35}, {"w": "hai", "t": 24.845, "d": 0.11}, {"w": "nghìn", "t": 24.955, "d": 0.2}, {"w": "không", "t": 25.155, "d": 0.15}, {"w": "trăm", "t": 25.305, "d": 0.27}, {"w": "mười", "t": 25.575, "d": 0.26}, {"w": "hai,", "t": 25.835, "d": 0.16}, {"w": "cái", "t": 25.995, "d": 0.195}, {"w": "giỏ", "t": 26.19, "d": 0.21}, {"w": "hàng", "t": 26.4, "d": 0.195}, {"w": "đắt", "t": 26.595, "d": 0.355}, {"w": "lên", "t": 26.95, "d": 0.06}, {"w": "gần", "t": 27.01, "d": 0.225}, {"w": "gấp", "t": 27.235, "d": 0.325}, {"w": "đôi.", "t": 27.56, "d": 0.235}]}, {"text": "Gấp đôi, chỉ trong năm năm.", "start": 29.16, "end": 30.92, "words": [{"w": "Gấp", "t": 29.24, "d": 0.1}, {"w": "đôi,", "t": 29.34, "d": 0.375}, {"w": "chỉ", "t": 29.715, "d": 0.27}, {"w": "trong", "t": 29.985, "d": 0.055}, {"w": "năm", "t": 30.04, "d": 0.32}, {"w": "năm.", "t": 30.36, "d": 0.22}]}, {"text": "Cũng trong những năm ấy, ở một đất nước khác, chuyện đi xa hơn nhiều.", "start": 31.92, "end": 35.52, "words": [{"w": "Cũng", "t": 32.005, "d": 0.155}, {"w": "trong", "t": 32.16, "d": 0.26}, {"w": "những", "t": 32.42, "d": 0.225}, {"w": "năm", "t": 32.645, "d": 0.06}, {"w": "ấy,", "t": 32.705, "d": 0.33}, {"w": "ở", "t": 33.035, "d": 0.12}, {"w": "một", "t": 33.155, "d": 0.24}, {"w": "đất", "t": 33.395, "d": 0.16}, {"w": "nước", "t": 33.555, "d": 0.195}, {"w": "khác,", "t": 33.75, "d": 0.325}, {"w": "chuyện", "t": 34.075, "d": 0.16}, {"w": "đi", "t": 34.235, "d": 0.32}, {"w": "xa", "t": 34.555, "d": 0.06}, {"w": "hơn", "t": 34.615, "d": 0.155}, {"w": "nhiều.", "t": 34.77, "d": 0.385}]}, {"text": "Giữa tháng mười một năm hai nghìn không trăm lẻ tám, ở Zimbabwe, giá cả tăng nhanh tới mức con số lạm phát hằng tháng có hàng tỷ phần trăm.", "start": 35.84, "end": 42.88, "words": [{"w": "Giữa", "t": 35.975, "d": 0.175}, {"w": "tháng", "t": 36.15, "d": 0.145}, {"w": "mười", "t": 36.295, "d": 0.375}, {"w": "một", "t": 36.67, "d": 0.205}, {"w": "năm", "t": 36.875, "d": 0.205}, {"w": "hai", "t": 37.08, "d": 0.2}, {"w": "nghìn", "t": 37.28, "d": 0.06}, {"w": "không", "t": 37.34, "d": 0.35}, {"w": "trăm", "t": 37.69, "d": 0.175}, {"w": "lẻ", "t": 37.865, "d": 0.22}, {"w": "tám,", "t": 38.085, "d": 0.165}, {"w": "ở", "t": 38.25, "d": 0.21}, {"w": "Zimbabwe,", "t": 38.46, "d": 0.32}, {"w": "giá", "t": 38.78, "d": 0.385}, {"w": "cả", "t": 39.165, "d": 0.06}, {"w": "tăng", "t": 39.225, "d": 0.235}, {"w": "nhanh", "t": 39.46, "d": 0.25}, {"w": "tới", "t": 39.71, "d": 0.09}, {"w": "mức", "t": 39.8, "d": 0.305}, {"w": "con", "t": 40.105, "d": 0.285}, {"w": "số", "t": 40.39, "d": 0.2}, {"w": "lạm", "t": 40.59, "d": 0.06}, {"w": "phát", "t": 40.65, "d": 0.35}, {"w": "hằng", "t": 41.0, "d": 0.13}, {"w": "tháng", "t": 41.13, "d": 0.22}, {"w": "có", "t": 41.35, "d": 0.24}, {"w": "hàng", "t": 41.59, "d": 0.14}, {"w": "tỷ", "t": 41.73, "d": 0.21}, {"w": "phần", "t": 41.94, "d": 0.18}, {"w": "trăm.", "t": 42.12, "d": 0.35}]}, {"text": "Tháng một năm sau, nước này phát hành tờ tiền mệnh giá một trăm nghìn tỷ đô la Zimbabwe.", "start": 43.2, "end": 47.92, "words": [{"w": "Tháng", "t": 43.26, "d": 0.3}, {"w": "một", "t": 43.56, "d": 0.215}, {"w": "năm", "t": 43.775, "d": 0.105}, {"w": "sau,", "t": 43.88, "d": 0.415}, {"w": "nước", "t": 44.295, "d": 0.06}, {"w": "này", "t": 44.355, "d": 0.215}, {"w": "phát", "t": 44.57, "d": 0.28}, {"w": "hành", "t": 44.85, "d": 0.145}, {"w": "tờ", "t": 44.995, "d": 0.4}, {"w": "tiền", "t": 45.395, "d": 0.195}, {"w": "mệnh", "t": 45.59, "d": 0.125}, {"w": "giá", "t": 45.715, "d": 0.135}, {"w": "một", "t": 45.85, "d": 0.295}, {"w": "trăm", "t": 46.145, "d": 0.155}, {"w": "nghìn", "t": 46.3, "d": 0.265}, {"w": "tỷ", "t": 46.565, "d": 0.15}, {"w": "đô", "t": 46.715, "d": 0.3}, {"w": "la", "t": 47.015, "d": 0.3}, {"w": "Zimbabwe.", "t": 47.315, "d": 0.255}]}, {"text": "Ở đỉnh của cơn lạm phát ấy, một tờ tiền như thế không đủ trả một vé xe buýt.", "start": 48.24, "end": 52.48, "words": [{"w": "Ở", "t": 48.335, "d": 0.12}, {"w": "đỉnh", "t": 48.455, "d": 0.21}, {"w": "của", "t": 48.665, "d": 0.145}, {"w": "cơn", "t": 48.81, "d": 0.33}, {"w": "lạm", "t": 49.14, "d": 0.09}, {"w": "phát", "t": 49.23, "d": 0.145}, {"w": "ấy,", "t": 49.375, "d": 0.45}, {"w": "một", "t": 49.825, "d": 0.06}, {"w": "tờ", "t": 49.885, "d": 0.23}, {"w": "tiền", "t": 50.115, "d": 0.185}, {"w": "như", "t": 50.3, "d": 0.12}, {"w": "thế", "t": 50.42, "d": 0.2}, {"w": "không", "t": 50.62, "d": 0.195}, {"w": "đủ", "t": 50.815, "d": 0.33}, {"w": "trả", "t": 51.145, "d": 0.06}, {"w": "một", "t": 51.205, "d": 0.315}, {"w": "vé", "t": 51.52, "d": 0.085}, {"w": "xe", "t": 51.605, "d": 0.23}, {"w": "buýt.", "t": 51.835, "d": 0.28}]}, {"text": "Tới tháng tư năm hai nghìn không trăm lẻ chín, Zimbabwe ngừng in đồng tiền của mình.", "start": 52.8, "end": 57.04, "words": [{"w": "Tới", "t": 52.855, "d": 0.15}, {"w": "tháng", "t": 53.005, "d": 0.23}, {"w": "tư", "t": 53.235, "d": 0.33}, {"w": "năm", "t": 53.565, "d": 0.225}, {"w": "hai", "t": 53.79, "d": 0.06}, {"w": "nghìn", "t": 53.85, "d": 0.205}, {"w": "không", "t": 54.055, "d": 0.255}, {"w": "trăm", "t": 54.31, "d": 0.325}, {"w": "lẻ", "t": 54.635, "d": 0.11}, {"w": "chín,", "t": 54.745, "d": 0.255}, {"w": "Zimbabwe", "t": 55.0, "d": 0.28}, {"w": "ngừng", "t": 55.28, "d": 0.185}, {"w": "in", "t": 55.465, "d": 0.24}, {"w": "đồng", "t": 55.705, "d": 0.21}, {"w": "tiền", "t": 55.915, "d": 0.24}, {"w": "của", "t": 56.155, "d": 0.2}, {"w": "mình.", "t": 56.355, "d": 0.355}]}, {"text": "Đó là trường hợp cực đoan, hiếm có trên thế giới.", "start": 58.04, "end": 60.92, "words": [{"w": "Đó", "t": 58.11, "d": 0.185}, {"w": "là", "t": 58.295, "d": 0.165}, {"w": "trường", "t": 58.46, "d": 0.34}, {"w": "hợp", "t": 58.8, "d": 0.07}, {"w": "cực", "t": 58.87, "d": 0.16}, {"w": "đoan,", "t": 59.03, "d": 0.44}, {"w": "hiếm", "t": 59.47, "d": 0.085}, {"w": "có", "t": 59.555, "d": 0.225}, {"w": "trên", "t": 59.78, "d": 0.18}, {"w": "thế", "t": 59.96, "d": 0.2}, {"w": "giới.", "t": 60.16, "d": 0.42}]}, {"text": "Việt Nam những năm gần đây cách rất xa kịch bản ấy.", "start": 61.24, "end": 63.96, "words": [{"w": "Việt", "t": 61.29, "d": 0.1}, {"w": "Nam", "t": 61.39, "d": 0.34}, {"w": "những", "t": 61.73, "d": 0.18}, {"w": "năm", "t": 61.91, "d": 0.125}, {"w": "gần", "t": 62.035, "d": 0.185}, {"w": "đây", "t": 62.22, "d": 0.2}, {"w": "cách", "t": 62.42, "d": 0.125}, {"w": "rất", "t": 62.545, "d": 0.275}, {"w": "xa", "t": 62.82, "d": 0.14}, {"w": "kịch", "t": 62.96, "d": 0.16}, {"w": "bản", "t": 63.12, "d": 0.24}, {"w": "ấy.", "t": 63.36, "d": 0.22}]}, {"text": "Còn xa hơn nữa thì sao?", "start": 64.96, "end": 66.56, "ask": 1, "words": [{"w": "Còn", "t": 65.115, "d": 0.25}, {"w": "xa", "t": 65.365, "d": 0.09}, {"w": "hơn", "t": 65.455, "d": 0.145}, {"w": "nữa", "t": 65.6, "d": 0.3}, {"w": "thì", "t": 65.9, "d": 0.09}, {"w": "sao?", "t": 65.99, "d": 0.37}]}, {"text": "Từ năm một nghìn chín trăm chín mươi sáu tới năm hai nghìn không trăm hai mươi lăm, giá cả bình quân tăng khoảng bốn phẩy sáu lần.", "start": 67.16, "end": 73.32, "words": [{"w": "Từ", "t": 67.27, "d": 0.25}, {"w": "năm", "t": 67.52, "d": 0.195}, {"w": "một", "t": 67.715, "d": 0.225}, {"w": "nghìn", "t": 67.94, "d": 0.085}, {"w": "chín", "t": 68.025, "d": 0.135}, {"w": "trăm", "t": 68.16, "d": 0.205}, {"w": "chín", "t": 68.365, "d": 0.32}, {"w": "mươi", "t": 68.685, "d": 0.23}, {"w": "sáu", "t": 68.915, "d": 0.065}, {"w": "tới", "t": 68.98, "d": 0.32}, {"w": "năm", "t": 69.3, "d": 0.12}, {"w": "hai", "t": 69.42, "d": 0.235}, {"w": "nghìn", "t": 69.655, "d": 0.1}, {"w": "không", "t": 69.755, "d": 0.175}, {"w": "trăm", "t": 69.93, "d": 0.25}, {"w": "hai", "t": 70.18, "d": 0.29}, {"w": "mươi", "t": 70.47, "d": 0.12}, {"w": "lăm,", "t": 70.59, "d": 0.35}, {"w": "giá", "t": 70.94, "d": 0.155}, {"w": "cả", "t": 71.095, "d": 0.21}, {"w": "bình", "t": 71.305, "d": 0.255}, {"w": "quân", "t": 71.56, "d": 0.195}, {"w": "tăng", "t": 71.755, "d": 0.075}, {"w": "khoảng", "t": 71.83, "d": 0.25}, {"w": "bốn", "t": 72.08, "d": 0.26}, {"w": "phẩy", "t": 72.34, "d": 0.065}, {"w": "sáu", "t": 72.405, "d": 0.23}, {"w": "lần.", "t": 72.635, "d": 0.32}]}, {"text": "Một trăm nghìn năm ấy, tương đương khoảng bốn trăm sáu mươi nghìn bây giờ.", "start": 73.64, "end": 77.24, "words": [{"w": "Một", "t": 73.71, "d": 0.16}, {"w": "trăm", "t": 73.87, "d": 0.135}, {"w": "nghìn", "t": 74.005, "d": 0.325}, {"w": "năm", "t": 74.33, "d": 0.095}, {"w": "ấy,", "t": 74.425, "d": 0.35}, {"w": "tương", "t": 74.775, "d": 0.12}, {"w": "đương", "t": 74.895, "d": 0.365}, {"w": "khoảng", "t": 75.26, "d": 0.065}, {"w": "bốn", "t": 75.325, "d": 0.24}, {"w": "trăm", "t": 75.565, "d": 0.17}, {"w": "sáu", "t": 75.735, "d": 0.27}, {"w": "mươi", "t": 76.005, "d": 0.095}, {"w": "nghìn", "t": 76.1, "d": 0.315}, {"w": "bây", "t": 76.415, "d": 0.195}, {"w": "giờ.", "t": 76.61, "d": 0.23}]}, {"text": "Nhiều người lớn tuổi hay nói: ngày xưa vài chục nghìn đã là nhiều.", "start": 77.56, "end": 80.84, "words": [{"w": "Nhiều", "t": 77.615, "d": 0.17}, {"w": "người", "t": 77.785, "d": 0.29}, {"w": "lớn", "t": 78.075, "d": 0.075}, {"w": "tuổi", "t": 78.15, "d": 0.195}, {"w": "hay", "t": 78.345, "d": 0.175}, {"w": "nói:", "t": 78.52, "d": 0.335}, {"w": "ngày", "t": 78.855, "d": 0.115}, {"w": "xưa", "t": 78.97, "d": 0.33}, {"w": "vài", "t": 79.3, "d": 0.165}, {"w": "chục", "t": 79.465, "d": 0.155}, {"w": "nghìn", "t": 79.62, "d": 0.135}, {"w": "đã", "t": 79.755, "d": 0.255}, {"w": "là", "t": 80.01, "d": 0.1}, {"w": "nhiều.", "t": 80.11, "d": 0.39}]}, {"text": "Họ nói đúng.", "start": 81.16, "end": 82.04, "words": [{"w": "Họ", "t": 81.22, "d": 0.1}, {"w": "nói", "t": 81.32, "d": 0.25}, {"w": "đúng.", "t": 81.57, "d": 0.195}]}, {"text": "So với những năm ấy, mức ba, bốn phần trăm của những năm gần đây là hiền.", "start": 83.04, "end": 87.2, "words": [{"w": "So", "t": 83.1, "d": 0.21}, {"w": "với", "t": 83.31, "d": 0.265}, {"w": "những", "t": 83.575, "d": 0.215}, {"w": "năm", "t": 83.79, "d": 0.06}, {"w": "ấy,", "t": 83.85, "d": 0.405}, {"w": "mức", "t": 84.255, "d": 0.235}, {"w": "ba,", "t": 84.49, "d": 0.355}, {"w": "bốn", "t": 84.845, "d": 0.105}, {"w": "phần", "t": 84.95, "d": 0.29}, {"w": "trăm", "t": 85.24, "d": 0.185}, {"w": "của", "t": 85.425, "d": 0.23}, {"w": "những", "t": 85.655, "d": 0.06}, {"w": "năm", "t": 85.715, "d": 0.19}, {"w": "gần", "t": 85.905, "d": 0.265}, {"w": "đây", "t": 86.17, "d": 0.18}, {"w": "là", "t": 86.35, "d": 0.315}, {"w": "hiền.", "t": 86.665, "d": 0.24}]}, {"text": "Nhưng hiền không có nghĩa là không có.", "start": 87.52, "end": 89.52, "words": [{"w": "Nhưng", "t": 87.585, "d": 0.2}, {"w": "hiền", "t": 87.785, "d": 0.205}, {"w": "không", "t": 87.99, "d": 0.17}, {"w": "có", "t": 88.16, "d": 0.255}, {"w": "nghĩa", "t": 88.415, "d": 0.095}, {"w": "là", "t": 88.51, "d": 0.22}, {"w": "không", "t": 88.73, "d": 0.23}, {"w": "có.", "t": 88.96, "d": 0.25}]}, {"text": "Ba phần trăm mỗi năm, sau khoảng hai mươi ba năm, sức mua của một đồng chỉ còn một nửa.", "start": 89.84, "end": 94.56, "words": [{"w": "Ba", "t": 89.94, "d": 0.19}, {"w": "phần", "t": 90.13, "d": 0.15}, {"w": "trăm", "t": 90.28, "d": 0.28}, {"w": "mỗi", "t": 90.56, "d": 0.24}, {"w": "năm,", "t": 90.8, "d": 0.245}, {"w": "sau", "t": 91.045, "d": 0.265}, {"w": "khoảng", "t": 91.31, "d": 0.195}, {"w": "hai", "t": 91.505, "d": 0.06}, {"w": "mươi", "t": 91.565, "d": 0.275}, {"w": "ba", "t": 91.84, "d": 0.15}, {"w": "năm,", "t": 91.99, "d": 0.41}, {"w": "sức", "t": 92.4, "d": 0.06}, {"w": "mua", "t": 92.46, "d": 0.23}, {"w": "của", "t": 92.69, "d": 0.26}, {"w": "một", "t": 92.95, "d": 0.105}, {"w": "đồng", "t": 93.055, "d": 0.185}, {"w": "chỉ", "t": 93.24, "d": 0.19}, {"w": "còn", "t": 93.43, "d": 0.175}, {"w": "một", "t": 93.605, "d": 0.35}, {"w": "nửa.", "t": 93.955, "d": 0.24}]}, {"text": "Có một quy tắc nhẩm nhanh cho chuyện này.", "start": 95.56, "end": 97.72, "words": [{"w": "Có", "t": 95.615, "d": 0.255}, {"w": "một", "t": 95.87, "d": 0.075}, {"w": "quy", "t": 95.945, "d": 0.2}, {"w": "tắc", "t": 96.145, "d": 0.155}, {"w": "nhẩm", "t": 96.3, "d": 0.29}, {"w": "nhanh", "t": 96.59, "d": 0.185}, {"w": "cho", "t": 96.775, "d": 0.18}, {"w": "chuyện", "t": 96.955, "d": 0.07}, {"w": "này.", "t": 97.025, "d": 0.325}]}, {"text": "Lấy bảy mươi chia cho mức lạm phát, ra số năm để sức mua còn một nửa.", "start": 98.04, "end": 102.12, "words": [{"w": "Lấy", "t": 98.09, "d": 0.165}, {"w": "bảy", "t": 98.255, "d": 0.16}, {"w": "mươi", "t": 98.415, "d": 0.215}, {"w": "chia", "t": 98.63, "d": 0.205}, {"w": "cho", "t": 98.835, "d": 0.285}, {"w": "mức", "t": 99.12, "d": 0.27}, {"w": "lạm", "t": 99.39, "d": 0.06}, {"w": "phát,", "t": 99.45, "d": 0.33}, {"w": "ra", "t": 99.78, "d": 0.165}, {"w": "số", "t": 99.945, "d": 0.29}, {"w": "năm", "t": 100.235, "d": 0.29}, {"w": "để", "t": 100.525, "d": 0.115}, {"w": "sức", "t": 100.64, "d": 0.29}, {"w": "mua", "t": 100.93, "d": 0.205}, {"w": "còn", "t": 101.135, "d": 0.06}, {"w": "một", "t": 101.195, "d": 0.33}, {"w": "nửa.", "t": 101.525, "d": 0.255}]}, {"text": "Ba phần trăm, khoảng hai mươi ba năm.", "start": 102.44, "end": 104.6, "words": [{"w": "Ba", "t": 102.51, "d": 0.21}, {"w": "phần", "t": 102.72, "d": 0.17}, {"w": "trăm,", "t": 102.89, "d": 0.365}, {"w": "khoảng", "t": 103.255, "d": 0.06}, {"w": "hai", "t": 103.315, "d": 0.275}, {"w": "mươi", "t": 103.59, "d": 0.225}, {"w": "ba", "t": 103.815, "d": 0.06}, {"w": "năm.", "t": 103.875, "d": 0.345}]}, {"text": "Bốn phẩy năm phần trăm như năm nay, chưa tới mười sáu năm.", "start": 104.92, "end": 108.2, "words": [{"w": "Bốn", "t": 104.98, "d": 0.25}, {"w": "phẩy", "t": 105.23, "d": 0.155}, {"w": "năm", "t": 105.385, "d": 0.22}, {"w": "phần", "t": 105.605, "d": 0.15}, {"w": "trăm", "t": 105.755, "d": 0.14}, {"w": "như", "t": 105.895, "d": 0.36}, {"w": "năm", "t": 106.255, "d": 0.16}, {"w": "nay,", "t": 106.415, "d": 0.255}, {"w": "chưa", "t": 106.67, "d": 0.145}, {"w": "tới", "t": 106.815, "d": 0.21}, {"w": "mười", "t": 107.025, "d": 0.36}, {"w": "sáu", "t": 107.385, "d": 0.085}, {"w": "năm.", "t": 107.47, "d": 0.36}]}, {"text": "Nhưng có một điều mà mọi con số bình quân ấy không kể.", "start": 109.2, "end": 112.16, "words": [{"w": "Nhưng", "t": 109.255, "d": 0.17}, {"w": "có", "t": 109.425, "d": 0.255}, {"w": "một", "t": 109.68, "d": 0.21}, {"w": "điều", "t": 109.89, "d": 0.175}, {"w": "mà", "t": 110.065, "d": 0.19}, {"w": "mọi", "t": 110.255, "d": 0.08}, {"w": "con", "t": 110.335, "d": 0.25}, {"w": "số", "t": 110.585, "d": 0.12}, {"w": "bình", "t": 110.705, "d": 0.245}, {"w": "quân", "t": 110.95, "d": 0.23}, {"w": "ấy", "t": 111.18, "d": 0.2}, {"w": "không", "t": 111.38, "d": 0.06}, {"w": "kể.", "t": 111.44, "d": 0.345}]}, {"text": "Lạm phát của bạn chưa chắc là lạm phát của cả nước.", "start": 112.48, "end": 115.28, "words": [{"w": "Lạm", "t": 112.565, "d": 0.21}, {"w": "phát", "t": 112.775, "d": 0.195}, {"w": "của", "t": 112.97, "d": 0.115}, {"w": "bạn", "t": 113.085, "d": 0.24}, {"w": "chưa", "t": 113.325, "d": 0.18}, {"w": "chắc", "t": 113.505, "d": 0.16}, {"w": "là", "t": 113.665, "d": 0.265}, {"w": "lạm", "t": 113.93, "d": 0.185}, {"w": "phát", "t": 114.115, "d": 0.185}, {"w": "của", "t": 114.3, "d": 0.065}, {"w": "cả", "t": 114.365, "d": 0.185}, {"w": "nước.", "t": 114.55, "d": 0.34}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "3", "k": "CHƯƠNG BA", "title": "NHỮNG NĂM\nGIÁ CHẠY NHANH", "sub": "2008 · 2011 · ZIMBABWE", "vid": "v0", "illus": "VIDEO MINH HỌA", "titleAt": 0.055, "t0": 0.0, "t1": 5.52}, {"type": "counter", "from": 0, "to": 23.1, "suffix": "%", "label": "LẠM PHÁT BÌNH QUÂN NĂM 2008", "sub": {"text": "100 NGHÌN NĂM 2007 → SỨC MUA ≈ 81 NGHÌN", "at": 7.72}, "t0": 5.52, "t1": 16.72, "at": 5.72, "until": 7.52}, {"type": "bars", "title": "LẠM PHÁT BÌNH QUÂN NĂM (%)", "unit": "WORLD BANK WDI", "items": [{"k": "2008", "v": 23.12, "lbl": "23,1", "at": 16.805, "acc": true}, {"k": "2009", "v": 6.72, "lbl": "6,7", "at": 17.63}, {"k": "2010", "v": 9.21, "lbl": "9,2", "at": 17.69}, {"k": "2011", "v": 18.68, "lbl": "18,7", "at": 19.03, "acc": true}, {"k": "2012", "v": 9.09, "lbl": "9,1", "at": 21.76}], "t0": 16.72, "t1": 29.16}, {"type": "slam", "text": "GẤP ĐÔI TRONG 5 NĂM", "sub": "GIỎ HÀNG 2007 → 2012 · ×1,86", "t0": 29.16, "t1": 31.92, "at": 29.31, "fx": "slice"}, {"type": "timeline", "title": "ZIMBABWE", "items": [{"year": "11/2008", "text": "lạm phát mỗi tháng hàng tỷ phần trăm", "at": 35.84}, {"year": "01/2009", "text": "tờ 100 nghìn tỷ đô la Zimbabwe", "at": 43.2}, {"year": "04/2009", "text": "ngừng in đồng tiền của mình", "at": 52.8}], "label": {"k": "NGUỒN: WIKIPEDIA (HYPERINFLATION IN ZIMBABWE) · DẪN BBC 16/01/2009", "v": "", "at": 31.92}, "t0": 31.92, "t1": 58.04}, {"type": "kinetic", "items": [{"text": "TRƯỜNG HỢP CỰC ĐOAN", "at": 58.04, "sm": true, "fx": "flicker", "L": {"cls": "kC", "style": {"top": "729px", "fontSize": "50px"}}, "D": [{"kind": "bar", "style": {"top": "729px", "height": "131px"}, "at": 57.79}]}, {"text": "VIỆT NAM GẦN ĐÂY CÁCH RẤT XA", "at": 58.44, "acc": true, "fx": "glitch", "L": {"cls": "kC", "style": {"top": "794px", "fontSize": "66px"}}, "em": "VIỆT"}], "t0": 58.04, "t1": 64.96, "lay": "corner"}, {"type": "counter", "from": 0, "to": 4.6, "suffix": " LẦN", "label": "GIÁ CẢ BÌNH QUÂN · 1996 → 2025", "sub": {"text": "100 NGHÌN NĂM 1996 ≈ 460 NGHÌN BÂY GIỜ", "at": 73.64}, "t0": 64.96, "t1": 77.56, "at": 65.16, "until": 66.96}, {"type": "kinetic", "items": [{"text": "“NGÀY XƯA VÀI CHỤC NGHÌN ĐÃ LÀ NHIỀU”", "at": 77.56, "sm": true, "fx": "rise", "L": {"style": {"top": "304px", "fontSize": "60px"}}, "D": [{"kind": "rule", "style": {"top": "639px"}, "at": 78.06}]}, {"text": "HỌ NÓI ĐÚNG", "at": 77.96, "acc": true, "fx": "outline", "L": {"style": {"top": "411px", "fontSize": "207px"}}}], "t0": 77.56, "t1": 83.04, "lay": "hero"}, {"type": "myth", "mythLab": "3–4%/NĂM", "myth": "HIỀN", "truthLab": "NHƯNG", "truth": "HIỀN ≠ KHÔNG CÓ", "strikeAt": 87.585, "truthAt": 87.99, "t0": 83.04, "t1": 95.56}, {"type": "ledger", "title": "QUY TẮC 70 · SỨC MUA CÒN MỘT NỬA SAU…", "srcnote": "70 ÷ LẠM PHÁT (%) ≈ SỐ NĂM", "rows": [{"k": "LẠM PHÁT 3%/NĂM", "v": "≈ 23 NĂM", "at": 102.44}, {"k": "LẠM PHÁT 4,5%/NĂM", "v": "< 16 NĂM", "at": 104.92}], "t0": 95.56, "t1": 109.2}, {"type": "question", "text": "Lạm phát của bạn có phải\nlạm phát của cả nước?", "t0": 109.2, "t1": 116.5}], "prog0": 0.38804, "prog1": 0.54574};
motion/hf/assets/long\mim-flappy-bird\ch01\data.js:1:window.CASE = {"topic": "mim-flappy-bird", "ch": "ch01", "dur": 55.18, "seed": 17063, "accent": "#22d3ee", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "lab", "brand": "MIND IN THE MACHINE", "autoTr": true, "hud": {"k": "CHƯƠNG 01", "t": "HAI, BA NGÀY"}, "acc": ["flappy", "bird", "gỡ", "giờ", "đô", "ngủ", "nghiện"], "lines": [{"text": "Người đăng dòng tweet ấy là Nguyễn Hà Đông.", "start": 0.0, "end": 2.48, "words": [{"w": "Người", "t": 0.0, "d": 0.275}, {"w": "đăng", "t": 0.275, "d": 0.225}, {"w": "dòng", "t": 0.5, "d": 0.155}, {"w": "tweet", "t": 0.655, "d": 0.33}, {"w": "ấy", "t": 0.985, "d": 0.275}, {"w": "là", "t": 1.26, "d": 0.185}, {"w": "Nguyễn", "t": 1.445, "d": 0.47}, {"w": "Hà", "t": 1.915, "d": 0.205}, {"w": "Đông.", "t": 2.12, "d": 0.36}]}, {"text": "Anh lớn lên ở Vạn Phúc, gần Hà Nội, và tự viết game từ năm mười sáu tuổi.", "start": 3.28, "end": 7.36, "words": [{"w": "Anh", "t": 3.335, "d": 0.105}, {"w": "lớn", "t": 3.44, "d": 0.26}, {"w": "lên", "t": 3.7, "d": 0.18}, {"w": "ở", "t": 3.88, "d": 0.305}, {"w": "Vạn", "t": 4.185, "d": 0.06}, {"w": "Phúc,", "t": 4.245, "d": 0.345}, {"w": "gần", "t": 4.59, "d": 0.25}, {"w": "Hà", "t": 4.84, "d": 0.105}, {"w": "Nội,", "t": 4.945, "d": 0.435}, {"w": "và", "t": 5.38, "d": 0.125}, {"w": "tự", "t": 5.505, "d": 0.235}, {"w": "viết", "t": 5.74, "d": 0.165}, {"w": "game", "t": 5.905, "d": 0.13}, {"w": "từ", "t": 6.035, "d": 0.28}, {"w": "năm", "t": 6.315, "d": 0.115}, {"w": "mười", "t": 6.43, "d": 0.305}, {"w": "sáu", "t": 6.735, "d": 0.06}, {"w": "tuổi.", "t": 6.795, "d": 0.36}]}, {"text": "Năm 2012, anh vẽ một chú chim nhỏ cho một trò chơi khác.", "start": 8.36, "end": 12.12, "words": [{"w": "Năm", "t": 8.36, "d": 0.105}, {"w": "2012,", "t": 8.465, "d": 1.335}, {"w": "anh", "t": 9.8, "d": 0.08}, {"w": "vẽ", "t": 9.88, "d": 0.235}, {"w": "một", "t": 10.115, "d": 0.195}, {"w": "chú", "t": 10.31, "d": 0.175}, {"w": "chim", "t": 10.485, "d": 0.165}, {"w": "nhỏ", "t": 10.65, "d": 0.165}, {"w": "cho", "t": 10.815, "d": 0.35}, {"w": "một", "t": 11.165, "d": 0.175}, {"w": "trò", "t": 11.34, "d": 0.1}, {"w": "chơi", "t": 11.44, "d": 0.17}, {"w": "khác.", "t": 11.61, "d": 0.33}]}, {"text": "Trò chơi ấy bị bỏ dở. Chú chim nằm lại trong máy.", "start": 12.44, "end": 15.32, "words": [{"w": "Trò", "t": 12.485, "d": 0.15}, {"w": "chơi", "t": 12.635, "d": 0.33}, {"w": "ấy", "t": 12.965, "d": 0.06}, {"w": "bị", "t": 13.025, "d": 0.34}, {"w": "bỏ", "t": 13.365, "d": 0.2}, {"w": "dở.", "t": 13.565, "d": 0.265}, {"w": "Chú", "t": 13.83, "d": 0.13}, {"w": "chim", "t": 13.96, "d": 0.25}, {"w": "nằm", "t": 14.21, "d": 0.16}, {"w": "lại", "t": 14.37, "d": 0.21}, {"w": "trong", "t": 14.58, "d": 0.17}, {"w": "máy.", "t": 14.75, "d": 0.37}]}, {"text": "Tới năm 2013, anh làm một trò mới.", "start": 16.32, "end": 19.2, "words": [{"w": "Tới", "t": 16.375, "d": 0.265}, {"w": "năm", "t": 16.64, "d": 0.06}, {"w": "2013,", "t": 16.7, "d": 1.285}, {"w": "anh", "t": 17.985, "d": 0.185}, {"w": "làm", "t": 18.17, "d": 0.265}, {"w": "một", "t": 18.435, "d": 0.175}, {"w": "trò", "t": 18.61, "d": 0.165}, {"w": "mới.", "t": 18.775, "d": 0.265}]}, {"text": "Ý tưởng đến từ một việc rất quen. Tâng quả bóng bàn trên mặt vợt, cố giữ cho nó đừng rơi.", "start": 19.52, "end": 24.4, "words": [{"w": "Ý", "t": 19.52, "d": 0.11}, {"w": "tưởng", "t": 19.63, "d": 0.38}, {"w": "đến", "t": 20.01, "d": 0.055}, {"w": "từ", "t": 20.065, "d": 0.345}, {"w": "một", "t": 20.41, "d": 0.19}, {"w": "việc", "t": 20.6, "d": 0.215}, {"w": "rất", "t": 20.815, "d": 0.055}, {"w": "quen.", "t": 20.87, "d": 0.485}, {"w": "Tâng", "t": 21.355, "d": 0.08}, {"w": "quả", "t": 21.435, "d": 0.17}, {"w": "bóng", "t": 21.605, "d": 0.255}, {"w": "bàn", "t": 21.86, "d": 0.18}, {"w": "trên", "t": 22.04, "d": 0.17}, {"w": "mặt", "t": 22.21, "d": 0.21}, {"w": "vợt,", "t": 22.42, "d": 0.48}, {"w": "cố", "t": 22.9, "d": 0.15}, {"w": "giữ", "t": 23.05, "d": 0.08}, {"w": "cho", "t": 23.13, "d": 0.335}, {"w": "nó", "t": 23.465, "d": 0.135}, {"w": "đừng", "t": 23.6, "d": 0.32}, {"w": "rơi.", "t": 23.92, "d": 0.24}]}, {"text": "Anh làm xong trong khoảng hai, ba ngày.", "start": 24.72, "end": 26.64, "words": [{"w": "Anh", "t": 24.83, "d": 0.25}, {"w": "làm", "t": 25.08, "d": 0.175}, {"w": "xong", "t": 25.255, "d": 0.145}, {"w": "trong", "t": 25.4, "d": 0.16}, {"w": "khoảng", "t": 25.56, "d": 0.225}, {"w": "hai,", "t": 25.785, "d": 0.23}, {"w": "ba", "t": 26.015, "d": 0.075}, {"w": "ngày.", "t": 26.09, "d": 0.365}]}, {"text": "Có một chi tiết thú vị.", "start": 27.64, "end": 29.0, "words": [{"w": "Có", "t": 27.64, "d": 0.24}, {"w": "một", "t": 27.88, "d": 0.055}, {"w": "chi", "t": 27.935, "d": 0.2}, {"w": "tiết", "t": 28.135, "d": 0.225}, {"w": "thú", "t": 28.36, "d": 0.07}, {"w": "vị.", "t": 28.43, "d": 0.34}]}, {"text": "Bản đầu tiên dễ hơn nhiều. Chính anh chơi thử, và thấy chán.", "start": 29.32, "end": 32.68, "words": [{"w": "Bản", "t": 29.32, "d": 0.115}, {"w": "đầu", "t": 29.435, "d": 0.22}, {"w": "tiên", "t": 29.655, "d": 0.245}, {"w": "dễ", "t": 29.9, "d": 0.285}, {"w": "hơn", "t": 30.185, "d": 0.28}, {"w": "nhiều.", "t": 30.465, "d": 0.275}, {"w": "Chính", "t": 30.74, "d": 0.085}, {"w": "anh", "t": 30.825, "d": 0.305}, {"w": "chơi", "t": 31.13, "d": 0.155}, {"w": "thử,", "t": 31.285, "d": 0.435}, {"w": "và", "t": 31.72, "d": 0.24}, {"w": "thấy", "t": 31.96, "d": 0.205}, {"w": "chán.", "t": 32.165, "d": 0.28}]}, {"text": "Thế là anh chỉnh cho nó khó lên.", "start": 33.0, "end": 35.64, "words": [{"w": "Thế", "t": 33.0, "d": 0.38}, {"w": "là", "t": 33.38, "d": 0.225}, {"w": "anh", "t": 33.605, "d": 0.255}, {"w": "chỉnh", "t": 33.86, "d": 0.5}, {"w": "cho", "t": 34.36, "d": 0.29}, {"w": "nó", "t": 34.65, "d": 0.19}, {"w": "khó", "t": 34.84, "d": 0.17}, {"w": "lên.", "t": 35.01, "d": 0.63}]}, {"text": "Ngày 24 tháng 5 năm 2013, trò chơi lên kho ứng dụng.", "start": 36.64, "end": 40.16, "words": [{"w": "Ngày", "t": 36.67, "d": 0.23}, {"w": "24", "t": 36.9, "d": 0.415}, {"w": "tháng", "t": 37.315, "d": 0.125}, {"w": "5", "t": 37.44, "d": 0.215}, {"w": "năm", "t": 37.655, "d": 0.22}, {"w": "2013,", "t": 37.875, "d": 0.995}, {"w": "trò", "t": 38.87, "d": 0.1}, {"w": "chơi", "t": 38.97, "d": 0.2}, {"w": "lên", "t": 39.17, "d": 0.225}, {"w": "kho", "t": 39.395, "d": 0.175}, {"w": "ứng", "t": 39.57, "d": 0.19}, {"w": "dụng.", "t": 39.76, "d": 0.195}]}, {"text": "Cách chơi chỉ có một động tác. Chạm vào màn hình để chú chim vỗ cánh, lách qua khe giữa những chiếc ống.", "start": 40.48, "end": 45.44, "words": [{"w": "Cách", "t": 40.48, "d": 0.115}, {"w": "chơi", "t": 40.595, "d": 0.27}, {"w": "chỉ", "t": 40.865, "d": 0.155}, {"w": "có", "t": 41.02, "d": 0.305}, {"w": "một", "t": 41.325, "d": 0.18}, {"w": "động", "t": 41.505, "d": 0.22}, {"w": "tác.", "t": 41.725, "d": 0.28}, {"w": "Chạm", "t": 42.005, "d": 0.135}, {"w": "vào", "t": 42.14, "d": 0.265}, {"w": "màn", "t": 42.405, "d": 0.115}, {"w": "hình", "t": 42.52, "d": 0.13}, {"w": "để", "t": 42.65, "d": 0.345}, {"w": "chú", "t": 42.995, "d": 0.15}, {"w": "chim", "t": 43.145, "d": 0.215}, {"w": "vỗ", "t": 43.36, "d": 0.165}, {"w": "cánh,", "t": 43.525, "d": 0.345}, {"w": "lách", "t": 43.87, "d": 0.065}, {"w": "qua", "t": 43.935, "d": 0.275}, {"w": "khe", "t": 44.21, "d": 0.205}, {"w": "giữa", "t": 44.415, "d": 0.235}, {"w": "những", "t": 44.65, "d": 0.145}, {"w": "chiếc", "t": 44.795, "d": 0.22}, {"w": "ống.", "t": 45.015, "d": 0.255}]}, {"text": "Chạm vào ống là hết ván.", "start": 45.76, "end": 47.76, "words": [{"w": "Chạm", "t": 45.76, "d": 0.36}, {"w": "vào", "t": 46.12, "d": 0.32}, {"w": "ống", "t": 46.44, "d": 0.34}, {"w": "là", "t": 46.78, "d": 0.3}, {"w": "hết", "t": 47.08, "d": 0.07}, {"w": "ván.", "t": 47.15, "d": 0.58}]}, {"text": "Rồi gần như không có gì xảy ra.", "start": 48.76, "end": 51.32, "words": [{"w": "Rồi", "t": 48.765, "d": 0.315}, {"w": "gần", "t": 49.08, "d": 0.32}, {"w": "như", "t": 49.4, "d": 0.31}, {"w": "không", "t": 49.71, "d": 0.16}, {"w": "có", "t": 49.87, "d": 0.505}, {"w": "gì", "t": 50.375, "d": 0.22}, {"w": "xảy", "t": 50.595, "d": 0.115}, {"w": "ra.", "t": 50.71, "d": 0.61}]}, {"text": "Suốt nhiều tháng, hầu như chẳng ai biết tới nó.", "start": 51.64, "end": 53.96, "words": [{"w": "Suốt", "t": 51.675, "d": 0.105}, {"w": "nhiều", "t": 51.78, "d": 0.2}, {"w": "tháng,", "t": 51.98, "d": 0.345}, {"w": "hầu", "t": 52.325, "d": 0.245}, {"w": "như", "t": 52.57, "d": 0.075}, {"w": "chẳng", "t": 52.645, "d": 0.325}, {"w": "ai", "t": 52.97, "d": 0.125}, {"w": "biết", "t": 53.095, "d": 0.17}, {"w": "tới", "t": 53.265, "d": 0.175}, {"w": "nó.", "t": 53.44, "d": 0.355}]}], "imgs": {}, "geo": {}, "scenes": [{"type": "chapter", "no": "1", "k": "CHƯƠNG MỘT", "title": "HAI, BA NGÀY", "sub": "NGUYỄN HÀ ĐÔNG · VẠN PHÚC, HÀ NỘI", "vid": "v0", "illus": "VIDEO MINH HỌA · HÀ NỘI", "titleAt": 0.0, "t0": 0.0, "t1": 8.36}, {"type": "timeline", "items": [{"year": "16 tuổi", "text": "tự viết game", "at": 5.505}, {"year": "2012", "text": "vẽ *một chú chim* cho trò chơi khác", "at": 8.36}, {"year": "—", "text": "trò ấy *bị bỏ dở*", "at": 12.44}, {"year": "2013", "text": "làm *một trò mới*", "at": 16.32}], "t0": 8.36, "t1": 19.52}, {"type": "kinetic", "items": [{"text": "Ý TƯỞNG", "at": 19.52, "sm": true, "fx": "rise", "L": {"cls": "kC", "style": {"top": "607px", "fontSize": "50px"}}, "D": [{"kind": "bar", "style": {"top": "607px", "height": "253px"}, "at": 19.27}]}, {"text": "TÂNG QUẢ BÓNG BÀN", "at": 19.92, "acc": true, "fx": "marker", "L": {"cls": "kC", "style": {"top": "672px", "fontSize": "110px"}}, "em": "TÂNG"}, {"text": "cố giữ cho nó đừng rơi", "at": 22.9, "sm": true, "fx": "blur", "L": {"cls": "kC", "style": {"top": "815px", "fontSize": "50px"}}}], "t0": 19.52, "t1": 24.72, "lay": "corner"}, {"type": "counter", "from": 0, "to": 3, "suffix": " NGÀY", "until": 26.015, "label": "LÀM XONG TRONG KHOẢNG 2–3 NGÀY", "sub": {"text": "THEO LỜI TÁC GIẢ", "at": 24.72}, "t0": 24.72, "t1": 27.64, "at": 24.919999999999998}, {"type": "ledger", "title": "MỘT CHI TIẾT THÚ VỊ", "rows": [{"k": "BẢN ĐẦU", "v": "DỄ HƠN NHIỀU → TÁC GIẢ THẤY CHÁN", "at": 29.32}], "total": {"k": "NÊN", "v": "CHỈNH CHO KHÓ LÊN", "at": 33.0}, "t0": 27.64, "t1": 36.64}, {"type": "date", "day": "LÊN KHO ỨNG DỤNG", "date": "24.05.2013", "t0": 36.64, "t1": 40.48, "dayAt": 36.79, "groupAt": [37.04, 37.339999999999996, 37.64]}, {"type": "flap", "crashAt": 47.08, "label": {"k": "MỘT ĐỘNG TÁC: CHẠM", "v": "HÌNH MINH HOẠ DO KÊNH TỰ VẼ · KHÔNG PHẢI HÌNH CỦA TRÒ CHƠI", "at": 42.005}, "t0": 40.48, "t1": 48.76}, {"type": "broll", "vid": "v7", "veil": 0.5, "illus": "VIDEO MINH HỌA", "kin": [{"text": "GẦN NHƯ KHÔNG CÓ GÌ XẢY RA", "at": 48.76, "fx": "slice", "em": "KHÔNG"}, {"text": "NHIỀU THÁNG KHÔNG AI BIẾT TỚI", "at": 51.64, "acc": true, "fx": "outline", "em": "NHIỀU"}], "t0": 48.76, "t1": 55.18}], "prog0": 0.12945, "prog1": 0.2734};
motion/hf/assets/long\ck-c5-co-tuc\ch01\data.js:1:window.CASE = {"topic": "ck-c5-co-tuc", "ch": "ch01", "dur": 69.5, "seed": 11254, "accent": "#fbbf24", "look": {"name": "classic", "vars": {"--serif": "'Playfair Display'", "--sans": "'Be Vietnam Pro'"}}, "theme": "chart", "brand": "BIỂU ĐỒ BIẾT NÓI", "autoTr": false, "hud": {"k": "CHƯƠNG 01", "t": "MƯỜI PHẦN TRĂM CỦA CÁI GÌ?"}, "acc": ["cổ", "tức", "mệnh", "giá", "bánh", "quyền", "thuế"], "lines": [{"text": "Cụm chữ đầu tiên: cổ tức bằng tiền, mười phần trăm.", "start": 0.0, "end": 3.12, "words": [{"w": "Cụm", "t": 0.055, "d": 0.185}, {"w": "chữ", "t": 0.24, "d": 0.335}, {"w": "đầu", "t": 0.575, "d": 0.065}, {"w": "tiên:", "t": 0.64, "d": 0.39}, {"w": "cổ", "t": 1.03, "d": 0.245}, {"w": "tức", "t": 1.275, "d": 0.16}, {"w": "bằng", "t": 1.435, "d": 0.275}, {"w": "tiền,", "t": 1.71, "d": 0.365}, {"w": "mười", "t": 2.075, "d": 0.085}, {"w": "phần", "t": 2.16, "d": 0.245}, {"w": "trăm.", "t": 2.405, "d": 0.415}]}, {"text": "Mười phần trăm ấy không tính trên số tiền bạn bỏ ra mua cổ phiếu.", "start": 3.92, "end": 7.52, "words": [{"w": "Mười", "t": 4.025, "d": 0.18}, {"w": "phần", "t": 4.205, "d": 0.15}, {"w": "trăm", "t": 4.355, "d": 0.205}, {"w": "ấy", "t": 4.56, "d": 0.195}, {"w": "không", "t": 4.755, "d": 0.235}, {"w": "tính", "t": 4.99, "d": 0.2}, {"w": "trên", "t": 5.19, "d": 0.245}, {"w": "số", "t": 5.435, "d": 0.16}, {"w": "tiền", "t": 5.595, "d": 0.2}, {"w": "bạn", "t": 5.795, "d": 0.14}, {"w": "bỏ", "t": 5.935, "d": 0.355}, {"w": "ra", "t": 6.29, "d": 0.08}, {"w": "mua", "t": 6.37, "d": 0.295}, {"w": "cổ", "t": 6.665, "d": 0.195}, {"w": "phiếu.", "t": 6.86, "d": 0.265}]}, {"text": "Nó tính trên mệnh giá.", "start": 8.52, "end": 10.12, "words": [{"w": "Nó", "t": 8.63, "d": 0.225}, {"w": "tính", "t": 8.855, "d": 0.23}, {"w": "trên", "t": 9.085, "d": 0.155}, {"w": "mệnh", "t": 9.24, "d": 0.315}, {"w": "giá.", "t": 9.555, "d": 0.245}]}, {"text": "Mệnh giá là một con số in sẵn cho mỗi cổ phiếu, thường là mười nghìn đồng.", "start": 10.44, "end": 14.36, "words": [{"w": "Mệnh", "t": 10.505, "d": 0.22}, {"w": "giá", "t": 10.725, "d": 0.145}, {"w": "là", "t": 10.87, "d": 0.295}, {"w": "một", "t": 11.165, "d": 0.06}, {"w": "con", "t": 11.225, "d": 0.22}, {"w": "số", "t": 11.445, "d": 0.135}, {"w": "in", "t": 11.58, "d": 0.25}, {"w": "sẵn", "t": 11.83, "d": 0.185}, {"w": "cho", "t": 12.015, "d": 0.31}, {"w": "mỗi", "t": 12.325, "d": 0.06}, {"w": "cổ", "t": 12.385, "d": 0.2}, {"w": "phiếu,", "t": 12.585, "d": 0.435}, {"w": "thường", "t": 13.02, "d": 0.06}, {"w": "là", "t": 13.08, "d": 0.305}, {"w": "mười", "t": 13.385, "d": 0.06}, {"w": "nghìn", "t": 13.445, "d": 0.205}, {"w": "đồng.", "t": 13.65, "d": 0.37}]}, {"text": "Nó gần như không liên quan gì tới giá bạn mua trên sàn.", "start": 14.68, "end": 17.64, "words": [{"w": "Nó", "t": 14.735, "d": 0.185}, {"w": "gần", "t": 14.92, "d": 0.15}, {"w": "như", "t": 15.07, "d": 0.235}, {"w": "không", "t": 15.305, "d": 0.255}, {"w": "liên", "t": 15.56, "d": 0.06}, {"w": "quan", "t": 15.62, "d": 0.25}, {"w": "gì", "t": 15.87, "d": 0.195}, {"w": "tới", "t": 16.065, "d": 0.22}, {"w": "giá", "t": 16.285, "d": 0.15}, {"w": "bạn", "t": 16.435, "d": 0.14}, {"w": "mua", "t": 16.575, "d": 0.265}, {"w": "trên", "t": 16.84, "d": 0.06}, {"w": "sàn.", "t": 16.9, "d": 0.38}]}, {"text": "Giá trên sàn lên hay xuống mỗi ngày, mệnh giá vẫn đứng yên.", "start": 17.96, "end": 21.4, "words": [{"w": "Giá", "t": 18.06, "d": 0.23}, {"w": "trên", "t": 18.29, "d": 0.255}, {"w": "sàn", "t": 18.545, "d": 0.12}, {"w": "lên", "t": 18.665, "d": 0.28}, {"w": "hay", "t": 18.945, "d": 0.235}, {"w": "xuống", "t": 19.18, "d": 0.23}, {"w": "mỗi", "t": 19.41, "d": 0.065}, {"w": "ngày,", "t": 19.475, "d": 0.38}, {"w": "mệnh", "t": 19.855, "d": 0.135}, {"w": "giá", "t": 19.99, "d": 0.315}, {"w": "vẫn", "t": 20.305, "d": 0.195}, {"w": "đứng", "t": 20.5, "d": 0.185}, {"w": "yên.", "t": 20.685, "d": 0.37}]}, {"text": "Vậy cổ tức mười phần trăm, là một nghìn đồng cho mỗi cổ phiếu.", "start": 22.4, "end": 25.84, "words": [{"w": "Vậy", "t": 22.45, "d": 0.195}, {"w": "cổ", "t": 22.645, "d": 0.21}, {"w": "tức", "t": 22.855, "d": 0.12}, {"w": "mười", "t": 22.975, "d": 0.245}, {"w": "phần", "t": 23.22, "d": 0.205}, {"w": "trăm,", "t": 23.425, "d": 0.4}, {"w": "là", "t": 23.825, "d": 0.06}, {"w": "một", "t": 23.885, "d": 0.33}, {"w": "nghìn", "t": 24.215, "d": 0.245}, {"w": "đồng", "t": 24.46, "d": 0.205}, {"w": "cho", "t": 24.665, "d": 0.065}, {"w": "mỗi", "t": 24.73, "d": 0.3}, {"w": "cổ", "t": 25.03, "d": 0.215}, {"w": "phiếu.", "t": 25.245, "d": 0.26}]}, {"text": "Với cổ phiếu ví dụ giá bốn mươi nghìn, một nghìn đồng chỉ bằng hai phẩy năm phần trăm số tiền bạn bỏ ra.", "start": 26.16, "end": 31.6, "words": [{"w": "Với", "t": 26.225, "d": 0.165}, {"w": "cổ", "t": 26.39, "d": 0.195}, {"w": "phiếu", "t": 26.585, "d": 0.265}, {"w": "ví", "t": 26.85, "d": 0.17}, {"w": "dụ", "t": 27.02, "d": 0.23}, {"w": "giá", "t": 27.25, "d": 0.155}, {"w": "bốn", "t": 27.405, "d": 0.215}, {"w": "mươi", "t": 27.62, "d": 0.26}, {"w": "nghìn,", "t": 27.88, "d": 0.255}, {"w": "một", "t": 28.135, "d": 0.11}, {"w": "nghìn", "t": 28.245, "d": 0.2}, {"w": "đồng", "t": 28.445, "d": 0.215}, {"w": "chỉ", "t": 28.66, "d": 0.195}, {"w": "bằng", "t": 28.855, "d": 0.205}, {"w": "hai", "t": 29.06, "d": 0.21}, {"w": "phẩy", "t": 29.27, "d": 0.21}, {"w": "năm", "t": 29.48, "d": 0.335}, {"w": "phần", "t": 29.815, "d": 0.06}, {"w": "trăm", "t": 29.875, "d": 0.185}, {"w": "số", "t": 30.06, "d": 0.35}, {"w": "tiền", "t": 30.41, "d": 0.2}, {"w": "bạn", "t": 30.61, "d": 0.14}, {"w": "bỏ", "t": 30.75, "d": 0.26}, {"w": "ra.", "t": 31.01, "d": 0.235}]}, {"text": "Tức là con số mười phần trăm trên thông báo, với người mua giá bốn mươi nghìn, chỉ còn hai phẩy năm?", "start": 31.92, "end": 37.52, "ask": 1, "words": [{"w": "Tức", "t": 32.01, "d": 0.12}, {"w": "là", "t": 32.13, "d": 0.385}, {"w": "con", "t": 32.515, "d": 0.185}, {"w": "số", "t": 32.7, "d": 0.095}, {"w": "mười", "t": 32.795, "d": 0.22}, {"w": "phần", "t": 33.015, "d": 0.295}, {"w": "trăm", "t": 33.31, "d": 0.185}, {"w": "trên", "t": 33.495, "d": 0.215}, {"w": "thông", "t": 33.71, "d": 0.195}, {"w": "báo,", "t": 33.905, "d": 0.545}, {"w": "với", "t": 34.45, "d": 0.06}, {"w": "người", "t": 34.51, "d": 0.2}, {"w": "mua", "t": 34.71, "d": 0.32}, {"w": "giá", "t": 35.03, "d": 0.3}, {"w": "bốn", "t": 35.33, "d": 0.155}, {"w": "mươi", "t": 35.485, "d": 0.155}, {"w": "nghìn,", "t": 35.64, "d": 0.495}, {"w": "chỉ", "t": 36.135, "d": 0.215}, {"w": "còn", "t": 36.35, "d": 0.095}, {"w": "hai", "t": 36.445, "d": 0.185}, {"w": "phẩy", "t": 36.63, "d": 0.375}, {"w": "năm?", "t": 37.005, "d": 0.28}]}, {"text": "Đúng vậy.", "start": 38.12, "end": 38.92, "words": [{"w": "Đúng", "t": 38.235, "d": 0.2}, {"w": "vậy.", "t": 38.435, "d": 0.16}]}, {"text": "Con số hai phẩy năm ấy có tên riêng, là tỷ suất cổ tức: cổ tức chia cho giá cổ phiếu.", "start": 39.92, "end": 44.88, "words": [{"w": "Con", "t": 39.975, "d": 0.2}, {"w": "số", "t": 40.175, "d": 0.175}, {"w": "hai", "t": 40.35, "d": 0.19}, {"w": "phẩy", "t": 40.54, "d": 0.32}, {"w": "năm", "t": 40.86, "d": 0.2}, {"w": "ấy", "t": 41.06, "d": 0.2}, {"w": "có", "t": 41.26, "d": 0.2}, {"w": "tên", "t": 41.46, "d": 0.2}, {"w": "riêng,", "t": 41.66, "d": 0.165}, {"w": "là", "t": 41.825, "d": 0.345}, {"w": "tỷ", "t": 42.17, "d": 0.205}, {"w": "suất", "t": 42.375, "d": 0.145}, {"w": "cổ", "t": 42.52, "d": 0.2}, {"w": "tức:", "t": 42.72, "d": 0.21}, {"w": "cổ", "t": 42.93, "d": 0.36}, {"w": "tức", "t": 43.29, "d": 0.15}, {"w": "chia", "t": 43.44, "d": 0.235}, {"w": "cho", "t": 43.675, "d": 0.205}, {"w": "giá", "t": 43.88, "d": 0.21}, {"w": "cổ", "t": 44.09, "d": 0.195}, {"w": "phiếu.", "t": 44.285, "d": 0.25}]}, {"text": "Cùng một nghìn đồng cổ tức, nếu giá cổ phiếu là hai mươi nghìn, tỷ suất là năm phần trăm.", "start": 45.2, "end": 49.92, "words": [{"w": "Cùng", "t": 45.285, "d": 0.24}, {"w": "một", "t": 45.525, "d": 0.23}, {"w": "nghìn", "t": 45.755, "d": 0.195}, {"w": "đồ