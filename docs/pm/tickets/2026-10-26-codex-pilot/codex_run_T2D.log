        kinds = {s["type"] for s in body}
        if len(kinds) < MIN_TYPES_PER_CHAPTER:
            err.append(f"{f.stem}: chá»‰ {len(kinds)} loáº¡i cáº£nh {sorted(kinds)}; cáº§n >= {MIN_TYPES_PER_CHAPTER}")
        for s in body:
            if s.get("vid"):
                clips[str(s["vid"])] += 1
            for k in ("img", "photo", "src"):
                if isinstance(s.get(k), str):
                    images[s[k]] += 1
        tj = od / f.stem / "timing.json"
        dur += json.loads(tj.read_text(encoding="utf-8"))["duration"] if tj.exists() else 0.0
    # T2B render (26/10/2026): tháº» chÆ°Æ¡ng ghi "number" thay vÃ¬ "no"/"k" -> engine in chá»¯ "undefined" giá»¯a mÃ n hÃ¬nh;
    # gen_scenes dÃ¹ng má»™t khuÃ´n 9 cáº£nh cho má»i chÆ°Æ¡ng -> "SÃU RÄ‚NG Cá»¦A Má»˜T KHÃ“A" hiá»‡n 7 láº§n. Lint Ä‘áº¿m loáº¡i cáº£nh khÃ´ng tháº¥y.
    seen = collections.Counter()
    for f in chs:
        for s in json.loads(f.read_text(encoding="utf-8")).get("scenes", []):
            if s.get("type") == "chapter":
                miss = [k for k in ("no", "k", "title") if not s.get(k)]
                if miss:
                    err.append(f"{f.stem}: tháº» chÆ°Æ¡ng thiáº¿u {miss} (engine hiá»‡n 'undefined'; xem máº«u Petrov)")
                continue
            keys = ("text", "q", "label") if s.get("type") == "ledger" else ("text", "title", "q", "label")   # tiÃªu Ä‘á» sá»• cÃ¡i lÃ  mÃ´-tÃ­p (Petrov "GHáº¾ TRá»°C"), dÃ²ng má»›i thÃ¬ khÃ¡c
            texts = [s.get(k) for k in keys if isinstance(s.get(k), str)]
            texts += [i.get("text") for i in s.get("items") or [] if isinstance(i, dict) and isinstance(i.get("text"), str)]
            for t in texts:
                if len(t) >= 8:
                    seen[t.strip().upper()] += 1
    for t, n in seen.items():
        if n > 2:
            err.append(f"chá»¯ hiá»ƒn thá»‹ láº·p {n} láº§n: {t[:50]!r} (má»—i cáº£nh pháº£i gáº¯n vá»›i dá»¯ kiá»‡n cá»§a chÆ°Æ¡ng Ä‘Ã³)")
    if dur == 0:
        dur = syl / SYL_PER_MIN * 60
        warn.append("chÆ°a cÃ³ timing.json: thá»i lÆ°á»£ng Æ°á»›c theo 210 Ã¢m tiáº¿t/phÃºt")
    if syl < min_syl:
        err.append(f"lá»i Ä‘á»c {syl} Ã¢m tiáº¿t (~{syl / SYL_PER_MIN:.1f} phÃºt) < {min_syl}: thiáº¿u ná»™i dung, thÃªm chi tiáº¿t cÃ³ nguá»“n, khÃ´ng thÃªm cÃ¢u Ä‘á»‡m")
    sps = dur / max(scenes, 1)
    if sps > MAX_SEC_PER_SCENE:
        err.append(f"{sps:.1f} giÃ¢y/cáº£nh > {MAX_SEC_PER_SCENE}: cáº§n thÃªm cáº£nh (bÃ i máº«u ~7,6)")
    cap = max(MAX_SAME_CLIP, round(dur / 60 / 6))
    for v, n in clips.items():
        if n > cap:
            err.append(f"clip {v} dÃ¹ng {n} láº§n (> {cap})")
    for v, n in images.items():
        if n > MAX_SAME_IMAGE:
            err.append(f"áº£nh {v} dÃ¹ng {n} láº§n (> {MAX_SAME_IMAGE})")
    script = (d / "script.md").read_text(encoding="utf-8") if (d / "script.md").exists() else ""
    fc = (d / "factcheck.md").read_text(encoding="utf-8") if (d / "factcheck.md").exists() else ""
    for x in FILLER:
        if x in script:
            err.append(f"cÃ¢u Ä‘á»‡m rá»—ng nghÄ©a: {x!r}")
    body_lines = [ln for ln in script.splitlines() if ln and not ln.startswith(("#", "**", "Quy Æ°á»›c", "---"))]
    missing = set()
    for ln in body_lines:
        for y in re.findall(r"\b(1[0-9]{3}|20[0-9]{2})\b", ln):           # nÄƒm pháº£i cÃ³ trong factcheck
            if y not in fc:
                missing.add(y)
    if missing:
        err.append(f"nÄƒm trong ká»‹ch báº£n khÃ´ng cÃ³ trong factcheck.md: {sorted(missing)}")
    if len(re.findall(r"https?://", fc)) < 8:
        err.append("factcheck.md cÃ³ Ã­t hÆ¡n 8 URL nguá»“n")
    spec = json.loads((d / "spec.json").read_text(encoding="utf-8")) if (d / "spec.json").exists() else {}
    pub = json.dumps({k: v for k, v in (spec.get("youtube") or {}).items() if k != "sources_internal"}, ensure_ascii=False)
    bad = [b for b in BANNED_PUBLIC if b in pub]
    if bad:
        err.append(f"spec.youtube (cÃ´ng khai) chá»©a chuá»—i cáº¥m: {bad}")
    yt = spec.get("youtube") or {}
    # T2B (26/10/2026): spec.youtube chá»‰ cÃ³ titles/summary/2 nguá»“n -> mÃ´ táº£ cÃ´ng khai trá»‘ng, khÃ´ng háº¹n giá», khÃ´ng playlist
    lack = [k for k in ("publish_at", "playlist", "chapter_titles", "tags", "video_credits") if not yt.get(k)]
    if lack:
        err.append(f"spec.youtube thiáº¿u {lack} (xem máº«u mim-ke-huy-diet-petrov)")
    if len(yt.get("sources") or []) < 8:
        err.append(f"spec.youtube.sources chá»‰ {len(yt.get('sources') or [])} URL cÃ´ng khai (< 8)")
    # TÃªn nÆ°á»›c ngoÃ i khÃ´ng cÃ³ báº£ng phÃ¡t Ã¢m: giá»ng Viá»‡t Ä‘á»c thÃ´ "Welchman", "Bletchley" (T2B: 0 má»¥c say cho ~40 tÃªn)
    foreign = set()
    for f in chs:
        for x in json.loads(f.read_text(encoding="utf-8")).get("lines", []):
            foreign |= {w for w in re.findall(r"\b[A-Z][a-zA-Z\-]{2,}\b", text_of(x)) if w.isascii()}
    if len(foreign) >= 8 and not spec.get("say"):
        err.append(f"{len(foreign)} tÃªn/thuáº­t ngá»¯ nÆ°á»›c ngoÃ i trong lá»i Ä‘á»c mÃ  spec khÃ´ng cÃ³ báº£ng say")
    title = (yt.get("titles") or [spec.get("title", "")])[0]
    if len(title) > 60:
        err.append(f"tiÃªu Ä‘á» {len(title)} kÃ½ tá»± > 60")
    stats = {"Ã¢m tiáº¿t": syl, "phÃºt": round(dur / 60, 1), "cáº£nh": scenes, "giÃ¢y/cáº£nh": round(sps, 1),
             "clip khÃ¡c": len(clips), "áº£nh khÃ¡c": len(images), "URL nguá»“n": len(re.findall(r"https?://", fc))}
    return err, warn, stats


def main() -> int:
    sys.path.insert(0, str(ROOT))
    from factory.console import utf8_console
    utf8_console()
    ap = argparse.ArgumentParser()
    ap.add_argument("topic")
    ap.add_argument("--min-syl", type=int, default=1900)
    a = ap.parse_args()
    err, warn, stats = gate(a.topic, a.min_syl)
    print(f"{a.topic}: " + ", ".join(f"{k} {v}" for k, v in stats.items()))
    for w in warn:
        print(f"  cáº£nh bÃ¡o: {w}")
    for e in err:
        print(f"  Lá»–I: {e}")
    print("Äáº T" if not err else f"TRÆ¯á»¢T ({len(err)} lá»—i)")
    return 1 if err else 0


if __name__ == "__main__":
    sys.exit(main())

